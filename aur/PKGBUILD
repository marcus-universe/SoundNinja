# Maintainer: Marcus Universe <contact at marcus-universe dot de>

pkgname=soundninja-bin
pkgver=0.8.0
pkgrel=1
pkgdesc="Open-source cross-platform soundboard desktop app"
arch=('x86_64' 'aarch64' 'armv7h')
url="https://github.com/marcus-universe/SoundNinja"
license=('GPL-3.0-only')
depends=(
    'webkit2gtk-4.1'
    'gtk3'
    'libayatana-appindicator'
    'alsa-lib'
    'libpipewire'
    'libpulse'
    'hicolor-icon-theme'
)
provides=('soundninja')
conflicts=('soundninja')
options=('!strip' '!debug')
# Keep the placeholder in git. CI (prepare-aur.sh) fills the real fingerprint
# from the GPG_FINGERPRINT secret only in the published AUR PKGBUILD.
validpgpkeys=('0000000000000000000000000000000000000000')

source_x86_64=(
    "${pkgname}-${pkgver}-x86_64.deb::https://github.com/marcus-universe/SoundNinja/releases/download/v${pkgver}/soundninja-linux-amd64.deb"
)
source_aarch64=(
    "${pkgname}-${pkgver}-aarch64.deb::https://github.com/marcus-universe/SoundNinja/releases/download/v${pkgver}/soundninja-linux-arm64.deb"
)
source_armv7h=(
    "${pkgname}-${pkgver}-armv7h.deb::https://github.com/marcus-universe/SoundNinja/releases/download/v${pkgver}/soundninja-linux-armhf.deb"
)
sha256sums_x86_64=('SKIP')
sha256sums_aarch64=('SKIP')
sha256sums_armv7h=('SKIP')

package() {
    local _deb="${srcdir}/${pkgname}-${pkgver}-${CARCH}.deb"
    local _data
    _data="$(bsdtar -tf "$_deb" | grep '^data\.tar' | head -n1)"
    bsdtar -xOf "$_deb" "$_data" | bsdtar -x -C "${pkgdir}"

    install -d "${pkgdir}/usr/share/licenses/${pkgname}"
    local _found=0
    local _cand
    while IFS= read -r -d '' _cand; do
        install -Dm644 "$_cand" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
        _found=1
        break
    done < <(find "${pkgdir}/usr/share" -type f \( -iname 'LICENSE*' -o -iname 'COPYING*' \) -print0 2>/dev/null)
    if [[ "$_found" -eq 0 ]]; then
        printf '%s\n' "GPL-3.0-only: see ${url}/blob/v${pkgver}/LICENSE" \
            > "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
    fi
}
