63,1064,1071,1080,1087,1093],{},[38,1065,1066,1067,469],{},"Installe ",[227,1068,230],{"href":1069,"rel":1070},"https:\u002F\u002Fbitfocus.io\u002Fcompanion",[248],[38,1072,1073,1074,1079],{},"Télécharge le module SoundNinja depuis le dossier officiel : ",[227,1075,1078],{"href":1076,"rel":1077},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Ftree\u002Fmain\u002Fcompanion-module-soundninja",[248],"companion-module-soundninja",". Il n’y a pas encore de paquet Companion Store — ce dossier est le téléchargement.",[38,1081,1082,1083,1086],{},"Dans Companion, ouvre ",[18,1084,1085],{},"Developer → Modules",", ou dépose le dossier dans le chemin des modules custom de Companion.",[38,1088,1089,1090,469],{},"Dans le dossier du module, lance ",[141,1091,1092],{},"npm install",[38,1094,1095,1096,1099],{},"Ajoute une connexion ",[18,1097,1098],{},"Sound Ninja",". Colle l’IP du PC, le port, et le token si tu en as défini un.",[23,1101,1103],{"id":1102},"actions","Actions",[35,1105,1106,1112,1118],{},[38,1107,1108,1111],{},[18,1109,1110],{},"Trigger Sound"," — choisis dans le menu déroulant live, ou tape un ID de son de 8 caractères (les variables Companion marchent)",[38,1113,1114,1117],{},[18,1115,1116],{},"Stop Sound"," — arrête un son en lecture par ID",[38,1119,1120,1123],{},[18,1121,1122],{},"Stop All"," — arrête tous les sons en lecture",[14,1125,1126],{},"Copie un ID de son dans SoundNinja depuis le menu contextuel du bouton ou la puce d’ID de la sélection multiple.",[23,1128,1130],{"id":1129},"feedbacks-et-variables","Feedbacks et variables",[35,1132,1133,1139,1151,1157],{},[38,1134,1135,1138],{},[18,1136,1137],{},"Sound Playing"," — vrai tant que cet ID de son est actif (utilise-le pour la couleur du bouton)",[38,1140,1141,1144,1145,144,1148],{},[141,1142,1143],{},"$(soundninja:connected)"," — ",[141,1146,1147],{},"true",[141,1149,1150],{},"false",[38,1152,1153,1156],{},[141,1154,1155],{},"$(soundninja:playing_count)"," — combien de sons jouent",[38,1158,1159,1162],{},[141,1160,1161],{},"$(soundninja:last_triggered)"," — dernier ID de son déclenché",[23,1164,1166],{"id":1165},"api-http-avancé","API HTTP (avancé)",[14,1168,1169,1170],{},"Chemin de base : ",[141,1171,1172],{},"\u002Fapi\u002Fv1",[35,1174,1175,1181,1187,1193,1203,1209,1217],{},[38,1176,1177,1180],{},[141,1178,1179],{},"GET \u002Finfo"," — nom de l’app, version, protocole, si un token est requis",[38,1182,1183,1186],{},[141,1184,1185],{},"GET \u002Fsounds"," — liste des sons (id, name, tabs, active)",[38,1188,1189,1192],{},[141,1190,1191],{},"GET \u002Fstate"," — sons plus IDs actuellement en lecture",[38,1194,1195,1198,1199,1202],{},[141,1196,1197],{},"POST \u002Ftrigger"," avec ",[141,1200,1201],{},"{ \"id\" }"," — jouer un son",[38,1204,1205,1208],{},[141,1206,1207],{},"GET \u002Ftrigger\u002F:id"," — jouer (facile à tester dans un navigateur)",[38,1210,1211,1198,1214,1216],{},[141,1212,1213],{},"POST \u002Fstop",[141,1215,1201],{}," optionnel — arrêter un son ou tous",[38,1218,1219,1222],{},[141,1220,1221],{},"GET \u002Fws"," — état en direct ; envoyer des commandes trigger\u002Fstop en entrée",{"title":150,"searchDepth":151,"depth":151,"links":1224},[1225,1226,1227,1228,1229],{"id":1025,"depth":151,"text":1026},{"id":1061,"depth":151,"text":230},{"id":1102,"depth":151,"text":1103},{"id":1129,"depth":151,"text":1130},{"id":1165,"depth":151,"text":1166},"Déclencher SoundNinja depuis Bitfocus Companion sur le réseau local.",{},7,"\u002Fremote-control",{"title":1014,"description":1230},"remote-control","UirFfFFa1OtKqtZy-JaH5bjcCg1r2bpyTh0kMJoIAF4",{"id":1238,"title":1239,"body":1240,"description":1328,"extension":158,"meta":1329,"navigation":160,"order":1330,"path":1331,"seo":1332,"stem":1244,"__hash__":1333},"content_fr\u002Fsupport.md","Support",{"type":7,"value":1241,"toc":1321},[1242,1245,1248,1252,1255,1262,1270,1274,1281,1283,1296,1300,1311,1315],[10,1243,1239],{"id":1244},"support",[14,1246,1247],{},"SoundNinja est un projet communauta