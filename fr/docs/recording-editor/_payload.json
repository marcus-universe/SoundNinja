,501,502,513,516],{},[38,503,504,505,508,509,512],{},"Ouvre ",[18,506,507],{},"Fichier → Importer des fichiers audio",", ou utilise ",[18,510,511],{},"Importer"," dans la barre de navigation.",[38,514,515],{},"Choisis un ou plusieurs fichiers audio.",[38,517,518],{},"Les sons arrivent dans l’onglet actuel.",[23,520,522],{"id":521},"importer-des-dossiers","Importer des dossiers",[94,524,525,534,537],{},[38,526,504,527,530,531,533],{},[18,528,529],{},"Fichier → Importer des dossiers"," (ou ",[18,532,522],{}," dans la barre de navigation).",[38,535,536],{},"Ajoute un ou plusieurs dossiers. Glisse pour les réordonner avant l’import.",[38,538,539,540],{},"Choisis comment ils arrivent :\n",[35,541,542,548],{},[38,543,544,547],{},[18,545,546],{},"Importer comme onglets"," — chaque dossier devient son propre onglet",[38,549,550,553],{},[18,551,552],{},"Importer dans l’onglet actuel"," — chaque fichier va dans l’onglet actif",[23,555,557],{"id":556},"enregistrer-un-clip","Enregistrer un clip",[14,559,560,561,565,566,568,569,76,571,110],{},"Ouvre le ",[227,562,564],{"href":563},"\u002Fdocs\u002Frecording-editor","Record Editor"," depuis le bouton ",[18,567,20],{}," dans la barre du lecteur. Capture, coupe, puis ",[18,570,106],{},[18,572,109],{},[23,574,576],{"id":575},"importer-un-soundboard","Importer un soundboard",[14,578,579,582,583,586,587,590],{},[18,580,581],{},"Fichier → Importer un soundboard"," charge un pack partagé. Les packs sont un ",[141,584,585],{},".zip"," qui contient ",[141,588,589],{},"project.sninja"," plus les fichiers audio. Après l’import, ouvre le projet et joue.",[14,592,593],{},"Tu peux aussi garder plusieurs projets (profils). Utilise le sélecteur de projet pour changer de board.",[23,595,597],{"id":596},"relier-les-fichiers-manquants","Relier les fichiers manquants",[14,599,600,601,604],{},"Si des fichiers audio bougent sur le disque, SoundNinja affiche ",[18,602,603],{},"Fichiers audio manquants",". Choisis un dossier à parcourir et relie les clips.",[23,606,608],{"id":607},"suite","Suite",[14,610,611,612,469],{},"Organise onglets, groupes et raccourcis dans ",[227,613,614],{"href":273},"Organiser les sons",{"title":150,"searchDepth":151,"depth":151,"links":616},[617,618,619,620,621,622],{"id":498,"depth":151,"text":499},{"id":521,"depth":151,"text":522},{"id":556,"depth":151,"text":557},{"id":575,"depth":151,"text":576},{"id":596,"depth":151,"text":597},{"id":607,"depth":151,"text":608},"Importe de l’audio, des dossiers, des enregistrements et des soundboards partagés.",{},3,"\u002Fadding-sounds",{"title":268,"description":623},"adding-sounds","WxjyAOY51Jh80jxw4Xvj7Ko_IY_wVuHJST0KFUWSZ9k",{"id":631,"title":614,"body":632,"description":778,"extension":158,"meta":779,"navigation":160,"order":780,"path":781,"seo":782,"stem":783,"__hash__":784},"content_fr\u002Forganizing-sounds.md",{"type":7,"value":633,"toc":769},[634,637,640,644,671,678,682,685,699,706,710,716,720,731,735,738,742,745,751,757,761],[10,635,614],{"id":636},"organiser-les-sons",[14,638,639],{},"SoundNinja est conçu pour les grandes bibliothèques. Utilise les onglets, les groupes, la recherche et les raccourcis pour que le clip dont tu as besoin soit à un clic (ou une touche) près.",[23,641,643],{"id":642},"onglets","Onglets",[35,645,646,653,660],{},[38,647,648,649,652],{},"Ajoute un onglet avec ",[18,650,651],{},"Ajouter un onglet",". Donne-lui une couleur pour scanner la barre vite.",[38,654,655,656,659],{},"La vue ",[18,657,658],{},"Tous"," montre chaque son à travers les onglets.",[38,661,662,663,666,667,670],{},"Un son peut appartenir à ",[18,664,665],{},"un ou plusieurs onglets",". Clic droit sur un son et utilise ",[18,668,669],{},"Déplacer vers l’onglet"," pour l’assigner.",[14,672,673,674,677],{},"Les transitions d’onglets sont dans ",[18,675,676],{},"Paramètres → Général"," : Slide, Fade, Boutons un par un, ou Aucune.",[23,679,681],{"id":680},"groupes","Groupes",[14,683,684],{},"Depuis la v0.5.3, les séparateurs peuvent devenir des groupes nommés :",[35,686,687,690,693,696],{},[38,688,689],{},"Ajouter, renommer ou supprimer un groupe depuis le menu contextuel",[38,691,692],{},"Glisser l’en-tête du groupe — les enfants suivent",[38,694,695],{},"Déposer des sons dans un groupe ou les en sortir",[38,697,698],{},"Régler la couleur de bordure, la couleur du nom et l’alignement des boutons (ou utiliser le défaut de l’onglet)",[14,700,701,702,705],{},"Tu peux toujours ajouter un ",[18,703,704],{},"Séparateur"," simple si tu as seulement besoin d’une coupure visuelle.",[23,707,709],{"id":708},"recherche","Recherche",[14,711,712,713,715],{},"Utilise le champ ",[18,714,709],{}," dans la barre de navigation. Les résultats se mettent à jour pendant que tu tapes.",[23,717,719],{"id":718},"réordonner","Réordonner",[14,721,722,723,726,727,730],{},"Active le glisser-déposer dans ",[18,724,725],{},"Paramètres → Comportement"," (",[18,728,729],{},"Autoriser le réordonnancement","). Puis glisse sons et groupes en place.",[23,732,734],{"id":733},"édition-groupée","Édition groupée",[14,736,737],{},"Sélectionne plusieurs sons, puis change la couleur, déplace-les vers un onglet ou supprime-les en une étape.",[23,739,741],{"id":740},"raccourcis-et-ids-de-son","Raccourcis et IDs de son",[14,743,744],{},"Chaque son a un ID de 8 caractères. Copie-le depuis le menu contextuel du bouton ou la puce d’ID de la sélection multiple.",[14,746,504,747,750],{},[18,748,749],{},"Paramètres → Raccourcis"," pour lier une touche à un ID de son. Les raccourcis globaux sont optionnels.",[14,752,753,754,756],{},"Le même ID est ce que ",[227,755,230],{"href":229}," utilise pour déclencher un clip.",[23,758,760],{"id":759},"gifs-et-couleurs","GIFs et couleurs",[14,762,763,764,768],{},"Clic droit sur un son pour régler des couleurs par bouton ou un fond GIF \u002F image. C’est séparé du ",[227,765,767],{"href":766},"\u002Fdocs\u002Ftheme-editor","Theme Creator",", qui habille tout le board.",{"title":150,"searchDepth":151,"depth":151,"links":770},[771,772,773,774,775,776,777],{"id":642,"depth":151,"text":643},{"id":680,"depth":151,"text":681},{"id":708,"depth":151,"text":709},{"id":718,"depth":151,"text":719},{"id":733,"depth":151,"text":734},{"id":740,"depth":151,"text":741},{"id":759,"depth":151,"text":760},"Onglets, groupes, recherche, édition groupée et raccourcis.",{},4,"\u002Forganizing-sounds",{"title":614,"description":778},"organizing-sounds","s3oaYG46DStsSAtCx2-Sgrn_LoxScaKkOmEWwKlXmKQ",{"id":786,"title":787,"body":788,"description":912,"extension":158,"meta":913,"navigation":160,"order":914,"path":915,"seo":916,"stem":917,"__hash__":918},"content_fr\u002Ftheme-editor.md","Éditeur de thème",{"type":7,"value":789,"toc":906},[790,793,799,803,829,832,836,850,854,880,883,887,892],[10,791,787],{"id":792},"éditeur-de-thème",[14,794,795,796,469],{},"Le Theme Creator est l’éditeur visuel complet de ton board. Ouvre-le depuis ",[18,797,798],{},"Paramètres → Général → Theme Creator",[23,800,802],{"id":801},"trois-onglets","Trois onglets",[94,804,805,818,824],{},[38,806,807,810,811,144,814,817],{},[18,808,809],{},"Général"," — nom du thème, couleurs partagées et import de polices (",[141,812,813],{},".ttf",[141,815,816],{},".otf",")",[38,819,820,823],{},[18,821,822],{},"Boutons"," — couleurs, typo, disposition et overlay GIF des boutons de son",[38,825,826,828],{},[18,827,643],{}," — couleurs, typo et épaisseur de bordure de la barre d’onglets",[14,830,831],{},"Un aperçu en direct montre onglets et boutons pendant que tu édites.",[23,833,835],{"id":834},"ce-que-tu-peux-changer","Ce que tu peux changer",[35,837,838,841,844,847],{},[38,839,840],{},"Couleurs primaire et d’accent, fonds, couleurs des boutons, couleurs des onglets",[38,842,843],{},"Famille et taille de police des boutons et des onglets",[38,845,846],{},"Largeur, rayon, bordure, écarts et padding des boutons",[38,848,849],{},"Opacité de l’overlay GIF (normal et survol)",[23,851,853],{"id":852},"enregistrer-et-partager","Enregistrer et partager"