 la liste",[38,1162,1163,1164,1081],{},"Éditer les variables CSS en direct (",[18,1165,1166],{},"CSS personnalisé",[38,1168,1169],{},"Importer un fichier de thème dans le dossier Themes",{"title":154,"searchDepth":155,"depth":155,"links":1171},[1172,1173,1174,1175],{"id":1065,"depth":155,"text":1066},{"id":1098,"depth":155,"text":1099},{"id":1116,"depth":155,"text":1117},{"id":1149,"depth":155,"text":1150},"Concevoir couleurs, polices, boutons et onglets dans le Theme Creator.",{},5,"\u002Ftheme-editor",{"title":1051,"description":1176},"theme-editor","wkR6rxJNnSmcJeJxDdslCOIyK7-9BblSMG_tJA6IwRY",{"id":4,"title":5,"body":1184,"description":161,"extension":162,"meta":1276,"navigation":164,"order":165,"path":166,"seo":1277,"stem":168,"__hash__":169},{"type":7,"value":1185,"toc":1270},[1186,1188,1192,1194,1198,1212,1214,1216,1234,1236,1248,1250,1258,1264],[10,1187,5],{"id":12},[14,1189,16,1190,21],{},[18,1191,20],{},[23,1193,26],{"id":25},[14,1195,29,1196,33],{},[18,1197,32],{},[35,1199,1200,1204,1208],{},[38,1201,1202,43],{},[18,1203,42],{},[38,1205,1206,49],{},[18,1207,48],{},[38,1209,1210,55],{},[18,1211,54],{},[14,1213,58],{},[23,1215,62],{"id":61},[35,1217,1218,1220,1222,1228,1230,1232],{},[38,1219,67],{},[38,1221,70],{},[38,1223,1224,76,1226],{},[18,1225,75],{},[18,1227,79],{},[38,1229,82],{},[38,1231,85],{},[38,1233,88],{},[23,1235,92],{"id":91},[94,1237,1238,1240,1242],{},[38,1239,98],{},[38,1241,101],{},[38,1243,1244,76,1246,110],{},[18,1245,106],{},[18,1247,109],{},[23,1249,114],{"id":113},[14,1251,117,1252,121,1254,125,1256,129],{},[18,1253,120],{},[18,1255,124],{},[18,1257,128],{},[14,1259,132,1260,136,1262,140],{},[18,1261,135],{},[18,1263,139],{},[14,1265,143,1266,148,1268,152],{},[145,1267,147],{},[145,1269,151],{},{"title":154,"searchDepth":155,"depth":155,"links":1271},[1272,1273,1274,1275],{"id":25,"depth":155,"text":26},{"id":61,"depth":155,"text":62},{"id":91,"depth":155,"text":92},{"id":113,"depth":155,"text":114},{},{"title":5,"description":161},{"id":1279,"title":1280,"body":1281,"description":1493,"extension":162,"meta":1494,"navigation":164,"order":1495,"path":1496,"seo":1497,"stem":1498,"__hash__":1499},"content_fr\u002Fremote-control.md","Contrôle à distance",{"type":7,"value":1282,"toc":1486},[1283,1286,1289,1293,1322,1325,1328,1363,1367,1387,1390,1394,1426,1430,1436],[10,1284,1280],{"id":1285},"contrôle-à-distance",[14,1287,1288],{},"SoundNinja peut écouter sur ton réseau local pour que Bitfocus Companion (ou n’importe quel client HTTP\u002FWebSocket) joue et arrête des sons.",[23,1290,1292],{"id":1291},"activer-le-serveur-distant","Activer le serveur distant",[94,1294,1295,1300,1306,1312],{},[38,1296,520,1297,485],{},[18,1298,1299],{},"Paramètres → Distant",[38,1301,1302,1303,485],{},"Active le serveur distant. Le port par défaut est ",[18,1304,1305],{},"7331",[38,1307,1308,1309,485],{},"Optionnel : définis un token. Les clients doivent l’envoyer comme Bearer token ou ",[145,1310,1311],{},"?token=",[38,1313,1314,1315,1318,1319,485],{},"Copie l’URL ",[145,1316,1317],{},"http:\u002F\u002FIP:PORT",", ou copie l’IP système depuis ",[18,1320,1321],{},"Paramètres → À propos",[14,1323,1324],{},"Windows peut afficher une invite pare-feu la première fois que le serveur démarre. Autorise l’accès au réseau privé.",[23,1326,243],{"id":1327},"bitfocus-companion",[94,1329,1330,1337,1346,1356],{},[38,1331,1332,1333,485],{},"Installe ",[240,1334,243],{"href":1335,"rel":1336},"https:\u002F\u002Fbitfocus.io\u002Fcompanion",[261],[38,1338,1339,1340,1345],{},"Télécharge ",[240,1341,1344],{"href":1342,"rel":1343},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002Fcompanion-module-soundninja\u002Freleases\u002Flatest",[261],"SoundNinja-Companion.tgz",". Il n’y a pas encore de paquet Companion Store.",[38,1347,1348,1349,1352,1353,485],{},"Dans Companion : ",[18,1350,1351],{},"Modules → Load module package"," et choisis le ",[145,1354,1355],{},".tgz",[38,1357,1358,1359,1362],{},"Ajoute une connexion ",[18,1360,1361],{},"Sound Ninja",". Colle l’IP du PC, le port, et le token si tu en as défini un.",[23,1364,1366],{"id":1365},"actions","Actions",[35,1368,1369,1375,1381],{},[38,1370,1371,1374],{},[18,1372,1373],{},"Trigger Sound"," — choisis dans le menu déroulant live, ou tape un ID de son de 8 caractères (les variables Companion marchent)",[38,1376,1377,1380],{},[18,1378,1379],{},"Stop Sound"," — arrête un son en lecture par ID",[38,1382,1383,1386],{},[18,1384,1385],{},"Stop All"," — arrête tous les sons en lecture",[14,1388,1389],{},"Copie un ID de son dans SoundNinja depuis le menu contextuel du bouton ou la puce d’ID de la sélection multiple.",[23,1391,1393],{"id":1392},"feedbacks-et-variables","Feedbacks et variables",[35,1395,1396,1402,1414,1420],{},[38,1397,1398,1401],{},[18,1399,1400],{},"Sound Playing"," — vrai tant que cet ID de son est actif (utilise-le pour la couleur du bouton)",[38,1403,1404,1407,1408,148,1411],{},[145,1405,1406],{},"$(soundninja:connected)"," — ",[145,1409,1410],{},"true",[145,1412,1413],{},"false",[38,1415,1416,1419],{},[145,1417,1418],{},"$(soundninja:playing_count)"," — combien de sons jouent",[38,1421,1422,1425],{},[145,1423,1424],{},"$(soundninja:last_triggered)"," — dernier ID de son déclenché",[23,1427,1429],{"id":1428},"api-http-avancé","API HTTP (avancé)",[14,1431,1432,1433],{},"Chemin de base : ",[145,1434,1435],{},"\u002Fapi\u002Fv1",[35,1437,1438,1444,1450,1456,1466,1472,1480],{},[38,1439,1440,1443],{},[145,1441,1442],{},"GET \u002Finfo"," — nom de l’app, version, protocole, si un token est requis",[38,1445,1446,1449],{},[145,1447,1448],{},"GET \u002Fsounds"," — liste des sons (id, name, tabs, active)",[38,1451,1452,1455],{},[145,1453,1454],{},"GET \u002Fstate"," — sons plus IDs actuellement en lecture",[38,1457,1458,1461,1462,1465],{},[145,1459,1460],{},"POST \u002Ftrigger"," avec ",[145,1463,1464],{},"{ \"id\" }"," — jouer un son",[38,1467,1468,1471],{},[145,1469,1470],{},"GET \u002Ftrigger\u002F:id"," — jouer (facile à tester dans un navigateur)",[38,1473,1474,1461,1477,1479],{},[145,1475,1476],{},"POST \u002Fstop",[145,1478,1464],{}," optionnel — arrêter un son ou tous",[38,1481,1482,1485],{},[145,1483,1484],{},"GET \u002Fws"," — état en direct ; envoyer des commandes trigger\u002Fstop en entrée",{"title":154,"searchDepth":155,"depth":155,"links":1487},[1488,1489,1490,1491,1492],{"id":1291,"depth":155,"text":1292},{"id":1327,"depth":155,"text":243},{"id":1365,"depth":155,"text":1366},{"id":1392,"depth":155,"text":1393},{"id":1428,"depth":155,"text":1429},"Déclencher SoundNinja depuis Bitfocus Companion sur le réseau local.",{},7,"\u002Fremote-control",{"title":1280,"description":1493},"remote-control","K_OaPi35SE1UyZR55pVcFsepHwNI1gVItIGw8Wc63e8",{"id":1501,"title":1502,"body":1503,"description":1591,"extension":162,"meta":1592,"navigation":164,"order":1593,"path":1594,"seo":1595,"stem":1507,"__hash__":1596},"content_fr\u002Fsupport.md","Support",{"type":7,"value":1504,"toc":1584},[1505,1508,1511,1515,1518,1525,1533,1537,1544,1546,1559,1563,1574,1578],[10,1506,1502],{"id":1507},"support",[14,1509,1510],{},"SoundNinja est un projet communautaire en bêta précoce. Le plus rapide pour obtenir de l’aide, c’est GitHub.",[23,1512,1514],{"id":1513},"signaler-un-bug-ou-poser-une-question","Signaler un bug ou poser une question",[14,1516,1517],{},"Ouvre une issue sur GitHub :",[14,1519,1520],{},[240,1521,1524],{"href":1522,"rel":1523},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fissues",[261],"github.com\u002Fmarcus-universe\u002FSoundNinja\u002Fissues",[14,1526,1527,1528,76,1530,1532],{},"Indique ton OS, la version de SoundNinja (",[18,1529,419],{},[18,1531,1321],{},"), et les étapes pour reproduire.",[23,1534,1536],{"id":1535},"e-mail","E-mail",[14,1538,1539,1540],{},"Contact du mainteneur : ",[240,1541,1543],{"href":1542},"mailto:contact@marcus-universe.de","contact@marcus-universe.de",[23,1545,413],{"id":412},[14,1547,1548,1549,1551,1552,1554,1555,485],{},"Dans l’app, utilis