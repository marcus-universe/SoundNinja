[{"data":1,"prerenderedAt":1334},["ShallowReactive",2],{"docs-page-fr-\u002Frecording-editor":3,"docs-nav-fr":166},{"id":4,"title":5,"body":6,"description":157,"extension":158,"meta":159,"navigation":160,"order":161,"path":162,"seo":163,"stem":164,"__hash__":165},"content_fr\u002Frecording-editor.md","Éditeur d’enregistrement",{"type":7,"value":8,"toc":149},"minimark",[9,13,22,27,34,56,59,63,89,93,111,115,130,137],[10,11,5],"h1",{"id":12},"éditeur-denregistrement",[14,15,16,17,21],"p",{},"Enregistre un clip dans SoundNinja, coupe-le, puis importe-le sur un onglet. Ouvre l’éditeur avec le bouton ",[18,19,20],"strong",{},"Enregistrer"," dans la barre du lecteur.",[23,24,26],"h2",{"id":25},"choisir-une-entrée","Choisir une entrée",[14,28,29,30,33],{},"Dans ",[18,31,32],{},"Paramètres → Audio"," :",[35,36,37,44,50],"ul",{},[38,39,40,43],"li",{},[18,41,42],{},"Périphériques d’entrée"," — microphone",[38,45,46,49],{},[18,47,48],{},"Périphériques de sortie (audio PC)"," — loopback de ce que le PC joue",[38,51,52,55],{},[18,53,54],{},"Volume d’entrée"," — gain de capture de 0 % à 200 %",[14,57,58],{},"Le bouton Enregistrer utilise le périphérique choisi ici.",[23,60,62],{"id":61},"éditer-la-prise","Éditer la prise",[35,64,65,68,71,80,83,86],{},[38,66,67],{},"Enregistrer et arrêter",[38,69,70],{},"Surveiller le vu-mètre d’entrée",[38,72,73,76,77],{},[18,74,75],{},"Normaliser"," ou ",[18,78,79],{},"Réduction de bruit",[38,81,82],{},"Couper tout le clip, couper à une sélection, ou supprimer une sélection",[38,84,85],{},"Annuler \u002F rétablir",[38,87,88],{},"Zoomer et dézoomer",[23,90,92],{"id":91},"préparer-et-importer","Préparer et importer",[94,95,96,99,102],"ol",{},[38,97,98],{},"Ajoute la sélection ou la piste complète à la liste de staging.",[38,100,101],{},"La liste commence vide : enregistre, édite, puis ajoute un clip.",[38,103,104,76,107,110],{},[18,105,106],{},"Importer la sélection",[18,108,109],{},"Tout importer"," dans l’onglet actuel ou un onglet que tu choisis.",[23,112,114],{"id":113},"séparation-de-stems-optionnel","Séparation de stems (optionnel)",[14,116,117,118,121,122,125,126,129],{},"Le Record Editor peut garder les ",[18,119,120],{},"voix"," ou la ",[18,123,124],{},"musique"," avec BS-RoFormer. Le modèle fait environ 158 MB et n’est ",[18,127,128],{},"pas"," inclus avec l’app.",[14,131,132,133,136],{},"Télécharge-le depuis ",[18,134,135],{},"Paramètres → Séparation de stems",", ou accepte l’invite au premier lancement. L’installateur Windows peut aussi proposer de télécharger le modèle au premier démarrage.",[14,138,139,140,144,145,148],{},"Les builds source avec stems ont besoin d’un flag extra (",[141,142,143],"code",{},"tauri:serve:stems"," \u002F ",[141,146,147],{},"tauri:build:stems",").",{"title":150,"searchDepth":151,"depth":151,"links":152},"",2,[153,154,155,156],{"id":25,"depth":151,"text":26},{"id":61,"depth":151,"text":62},{"id":91,"depth":151,"text":92},{"id":113,"depth":151,"text":114},"Capturer le micro ou l’audio du PC, éditer le clip et le poser sur ton board.","md",{},true,6,"\u002Frecording-editor",{"title":5,"description":157},"recording-editor","MWbhVAhKI305ElNft_a0mfkruHVKHJfxEOAZ0Ri6WEg",[167,288,486,630,785,919,1012,1237],{"id":168,"title":169,"body":170,"description":281,"extension":158,"meta":282,"navigation":160,"order":283,"path":284,"seo":285,"stem":286,"__hash__":287},"content_fr\u002Foverview.md","Aperçu",{"type":7,"value":171,"toc":275},[172,175,178,181,184,188,202,206,237,241,251,255],[10,173,169],{"id":174},"aperçu",[14,176,177],{},"SoundNinja est un soundboard open source pour le live streaming, les discussions entre amis et l’enregistrement de podcasts. Il est construit avec Tauri v2 et Nuxt 4 pour rester léger en RAM et sur le disque.",[14,179,180],{},"Le but est simple : garder une énorme bibliothèque de sons facile à parcourir, puis jouer le bon clip en quelques millisecondes. L’interface marche aussi comme tableau de bord en VR.",[14,182,183],{},"SoundNinja est encore en développement précoce. Les fonctions marchent, mais toutes les plateformes ne sont pas entièrement testées.",[23,185,187],{"id":186},"pour-qui","Pour qui",[35,189,190,193,196,199],{},[38,191,192],{},"Les streameurs qui ont besoin de cues sonores instantanés",[38,194,195],{},"Les amis qui veulent un board partagé pour le vocal",[38,197,198],{},"Les podcasteurs qui enregistrent des clips et les posent sur un board",[38,200,201],{},"Quiconque veut un soundboard personnalisable et local-first",[23,203,205],{"id":204},"ce-que-tu-peux-faire","Ce que tu peux faire",[35,207,208,211,214,217,220,223,231,234],{},[38,209,210],{},"Construire un soundboard à partir de tes propres fichiers audio",[38,212,213],{},"Organiser les sons dans des onglets colorés, des groupes et la recherche",[38,215,216],{},"Concevoir le look avec le Theme Creator",[38,218,219],{},"Enregistrer l’audio du PC ou un micro dans le Record Editor",[38,221,222],{},"Assigner des raccourcis à des sons individuels",[38,224,225,226],{},"Déclencher des sons depuis ",[227,228,230],"a",{"href":229},"\u002Fdocs\u002Fremote-control","Bitfocus Companion",[38,232,233],{},"Importer et exporter un soundboard complet pour le partager",[38,235,236],{},"Utiliser des GIF ou des images sur les boutons de son",[23,238,240],{"id":239},"licence","Licence",[14,242,243,244,250],{},"SoundNinja est un logiciel libre sous ",[227,245,249],{"href":246,"rel":247},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fblob\u002Fmain\u002FLICENSE",[248],"nofollow","GPL-3.0",". Forke-le, modifie-le, partage-le.",[23,252,254],{"id":253},"prochaines-étapes","Prochaines étapes",[94,256,257,263,269],{},[38,258,259],{},[227,260,262],{"href":261},"\u002Fdocs\u002Finstallation","Installer SoundNinja",[38,264,265],{},[227,266,268],{"href":267},"\u002Fdocs\u002Fadding-sounds","Ajouter des sons",[38,270,271],{},[227,272,274],{"href":273},"\u002Fdocs\u002Forganizing-sounds","Organiser ton board",{"title":150,"searchDepth":151,"depth":151,"links":276},[277,278,279,280],{"id":186,"depth":151,"text":187},{"id":204,"depth":151,"text":205},{"id":239,"depth":151,"text":240},{"id":253,"depth":151,"text":254},"Ce qu’est SoundNinja et ce que tu peux en faire.",{},1,"\u002Foverview",{"title":169,"description":281},"overview","ZY8wtO0KcJ2GGKh9NDik0dGVB6QXrk3FQ-5mCb0D4-8",{"id":289,"title":290,"body":291,"description":481,"extension":158,"meta":482,"navigation":160,"order":151,"path":483,"seo":484,"stem":295,"__hash__":485},"content_fr\u002Finstallation.md","Installation",{"type":7,"value":292,"toc":474},[293,296,310,314,331,334,338,352,355,359,383,394,398,405,409,424,454,470],[10,294,290],{"id":295},"installation",[14,297,298,299,303,304,309],{},"Récupère un build sur la ",[227,300,302],{"href":301},"\u002Fdownload","page Télécharger"," ou sur ",[227,305,308],{"href":306,"rel":307},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Freleases\u002Flatest",[248],"GitHub Releases",". SoundNinja est en développement précoce — traite les builds comme des bêtas.",[23,311,313],{"id":312},"windows","Windows",[35,315,316,325,328],{},[38,317,318,76,321,324],{},[18,319,320],{},"Installateur (.exe)",[18,322,323],{},"MSI (.msi)"," pour Windows 64 bits",[38,326,327],{},"Cible de la landing page : Windows 10 et plus",[38,329,330],{},"Le README de l’app mentionne aussi Windows 8 et supérieur",[14,332,333],{},"Lance l’installateur, puis ouvre SoundNinja depuis le menu Démarrer.",[23,335,337],{"id":336},"macos","macOS",[35,339,340,346,349],{},[38,341,342,345],{},[18,343,344],{},".dmg universel"," pour Apple Silicon et Intel",[38,347,348],{},"Cible de la landing page : macOS 10.14 et plus",[38,350,351],{},"Le README de l’app mentionne macOS 10.15 et supérieur",[14,353,354],{},"Ouvre l’image disque et glisse SoundNinja dans Applications.",[23,356,358],{"id":357},"linux","Linux",[35,360,361,367,373,380],{},[38,362,363,366],{},[18,364,365],{},"Debian (.deb)"," pour Ubuntu \u002F Debian",[38,368,369,372],{},[18,3