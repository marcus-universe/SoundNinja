274,1275],{},"tauri:serve:stems",[38,1277,1278],{},"tauri:build:stems",").",{"title":139,"searchDepth":140,"depth":140,"links":1281},[1282,1283,1284,1285],{"id":1162,"depth":140,"text":1163},{"id":1195,"depth":140,"text":1196},{"id":1224,"depth":140,"text":1225},{"id":1242,"depth":140,"text":1243},"Capturer le micro ou l’audio du PC, éditer le clip et le poser sur ton board.",{},6,"\u002Frecording-editor",{"title":1148,"description":1286},"recording-editor","ZMpimB13mAmCTr4lHYb896wJ8oA5QijFuonM7e0rJU8",{"id":1294,"title":1295,"body":1296,"description":1508,"extension":147,"meta":1509,"navigation":149,"order":1510,"path":1511,"seo":1512,"stem":1513,"__hash__":1514},"content_fr\u002Fremote-control.md","Contrôle à distance",{"type":7,"value":1297,"toc":1501},[1298,1301,1304,1308,1337,1340,1343,1378,1382,1402,1405,1409,1441,1445,1451],[10,1299,1295],{"id":1300},"contrôle-à-distance",[14,1302,1303],{},"SoundNinja peut écouter sur ton réseau local pour que Bitfocus Companion (ou n’importe quel client HTTP\u002FWebSocket) joue et arrête des sons.",[23,1305,1307],{"id":1306},"activer-le-serveur-distant","Activer le serveur distant",[28,1309,1310,1315,1321,1327],{},[31,1311,526,1312,21],{},[18,1313,1314],{},"Paramètres → Distant",[31,1316,1317,1318,21],{},"Active le serveur distant. Le port par défaut est ",[18,1319,1320],{},"7331",[31,1322,1323,1324,21],{},"Optionnel : définis un token. Les clients doivent l’envoyer comme Bearer token ou ",[38,1325,1326],{},"?token=",[31,1328,1329,1330,1333,1334,21],{},"Copie l’URL ",[38,1331,1332],{},"http:\u002F\u002FIP:PORT",", ou copie l’IP système depuis ",[18,1335,1336],{},"Paramètres → À propos",[14,1338,1339],{},"Windows peut afficher une invite pare-feu la première fois que le serveur démarre. Autorise l’accès au réseau privé.",[23,1341,228],{"id":1342},"bitfocus-companion",[28,1344,1345,1352,1361,1371],{},[31,1346,1347,1348,21],{},"Installe ",[225,1349,228],{"href":1350,"rel":1351},"https:\u002F\u002Fbitfocus.io\u002Fcompanion",[2