[{"data":1,"prerenderedAt":1591},["ShallowReactive",2],{"docs-page-fr-\u002Ftheme-editor":3,"docs-nav-fr":155},{"id":4,"title":5,"body":6,"description":146,"extension":147,"meta":148,"navigation":149,"order":150,"path":151,"seo":152,"stem":153,"__hash__":154},"content_fr\u002Ftheme-editor.md","Éditeur de thème",{"type":7,"value":8,"toc":138},"minimark",[9,13,22,27,58,61,65,80,84,110,113,117,124],[10,11,5],"h1",{"id":12},"éditeur-de-thème",[14,15,16,17,21],"p",{},"Le Theme Creator est l’éditeur visuel complet de ton board. Ouvre-le depuis ",[18,19,20],"strong",{},"Paramètres → Général → Theme Creator",".",[23,24,26],"h2",{"id":25},"trois-onglets","Trois onglets",[28,29,30,46,52],"ol",{},[31,32,33,36,37,41,42,45],"li",{},[18,34,35],{},"Général"," — nom du thème, couleurs partagées et import de polices (",[38,39,40],"code",{},".ttf"," \u002F ",[38,43,44],{},".otf",")",[31,47,48,51],{},[18,49,50],{},"Boutons"," — couleurs, typo, disposition et overlay GIF des boutons de son",[31,53,54,57],{},[18,55,56],{},"Onglets"," — couleurs, typo et épaisseur de bordure de la barre d’onglets",[14,59,60],{},"Un aperçu en direct montre onglets et boutons pendant que tu édites.",[23,62,64],{"id":63},"ce-que-tu-peux-changer","Ce que tu peux changer",[66,67,68,71,74,77],"ul",{},[31,69,70],{},"Couleurs primaire et d’accent, fonds, couleurs des boutons, couleurs des onglets",[31,72,73],{},"Famille et taille de police des boutons et des onglets",[31,75,76],{},"Largeur, rayon, bordure, écarts et padding des boutons",[31,78,79],{},"Opacité de l’overlay GIF (normal et survol)",[23,81,83],{"id":82},"enregistrer-et-partager","Enregistrer et partager",[66,85,86,92,98,104],{},[31,87,88,91],{},[18,89,90],{},"Exporter .css"," — écrire un fichier de thème à sauvegarder ou envoyer à un ami",[31,93,94,97],{},[18,95,96],{},"Ajouter aux thèmes"," — enregistrer le fichier dans ton dossier Themes et l’appliquer",[31,99,100,103],{},[18,101,102],{},"Importer .css"," — charger un preset intégré ou un thème enregistré",[31,105,106,109],{},[18,107,108],{},"Réinitialiser"," — revenir aux défauts SoundNinja",[14,111,112],{},"Si tu fermes la fenêtre avec des changements non enregistrés, SoundNinja te demande d’enregistrer d’abord.",[23,114,116],{"id":115},"sans-léditeur-complet","Sans l’éditeur complet",[14,118,119,120,123],{},"Dans ",[18,121,122],{},"Paramètres → Général"," tu peux toujours :",[66,125,126,129,135],{},[31,127,128],{},"Choisir un thème dans la liste",[31,130,131,132,45],{},"Éditer les variables CSS en direct (",[18,133,134],{},"CSS personnalisé",[31,136,137],{},"Importer un fichier de thème dans le dossier Themes",{"title":139,"searchDepth":140,"depth":140,"links":141},"",2,[142,143,144,145],{"id":25,"depth":140,"text":26},{"id":63,"depth":140,"text":64},{"id":82,"depth":140,"text":83},{"id":115,"depth":140,"text":116},"Concevoir couleurs, polices, boutons et onglets dans le Theme Creator.","md",{},true,5,"\u002Ftheme-editor",{"title":5,"description":146},"theme-editor","wkR6rxJNnSmcJeJxDdslCOIyK7-9BblSMG_tJA6IwRY",[156,286,487,635,1036,1125,1272,1494],{"id":157,"title":158,"body":159,"description":279,"extension":147,"meta":280,"navigation":149,"order":281,"path":282,"seo":283,"stem":284,"__hash__":285},"content_fr\u002Foverview.md","Aperçu",{"type":7,"value":160,"toc":273},[161,164,167,170,173,177,191,195,235,239,249,253],[10,162,158],{"id":163},"aperçu",[14,165,166],{},"SoundNinja est un soundboard open source pour le live streaming, les discussions entre amis et l’enregistrement de podcasts. Il est construit avec Tauri v2 et Nuxt 4 pour rester léger en RAM et sur le disque.",[14,168,169],{},"Le but est simple : garder une énorme bibliothèque de sons facile à parcourir, puis jouer le bon clip en quelques millisecondes. L’interface marche aussi comme tableau de bord en VR.",[14,171,172],{},"SoundNinja est encore en développement précoce. Les fonctions marchent, mais toutes les plateformes ne sont pas entièrement testées.",[23,174,176],{"id":175},"pour-qui","Pour qui",[66,178,179,182,185,188],{},[31,180,181],{},"Les streameurs qui ont besoin de cues sonores instantanés",[31,183,184],{},"Les amis qui veulent un board partagé pour le vocal",[31,186,187],{},"Les podcasteurs qui enregistrent des clips et les posent sur un board",[31,189,190],{},"Quiconque veut un soundboard personnalisable et local-first",[23,192,194],{"id":193},"ce-que-tu-peux-faire","Ce que tu peux faire",[66,196,197,200,203,206,209,212,215,218,221,229,232],{},[31,198,199],{},"Construire un soundboard à partir de tes propres fichiers audio",[31,201,202],{},"Organiser les sons dans des onglets colorés, des groupes, des tags et la recherche",[31,204,205],{},"Filtrer par tags (OU) et trier par nom, date, durée ou taille",[31,207,208],{},"Sélection multiple avec rectangle ou plage Maj, puis couleur, déplacement ou suppression en lot",[31,210,211],{},"Régler le volume par son depuis le menu contextuel",[31,213,214],{},"Concevoir le look avec le Theme Creator",[31,216,217],{},"Enregistrer l’audio du PC ou un micro dans le Record Editor",[31,219,220],{},"Assigner des raccourcis à des sons individuels",[31,222,223,224],{},"Déclencher des sons depuis ",[225,226,228],"a",{"href":227},"\u002Fdocs\u002Fremote-control","Bitfocus Companion",[31,230,231],{},"Importer et exporter un soundboard complet pour le partager",[31,233,234],{},"Utiliser des GIF ou des images sur les boutons — bibliothèque de dossiers locale ou KLIPY",[23,236,238],{"id":237},"licence","Licence",[14,240,241,242,248],{},"SoundNinja est un logiciel libre sous ",[225,243,247],{"href":244,"rel":245},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fblob\u002Fmain\u002FLICENSE",[246],"nofollow","GPL-3.0",". Forke-le, modifie-le, partage-le.",[23,250,252],{"id":251},"prochaines-étapes","Prochaines étapes",[28,254,255,261,267],{},[31,256,257],{},[225,258,260],{"href":259},"\u002Fdocs\u002Finstallation","Installer SoundNinja",[31,262,263],{},[225,264,266],{"href":265},"\u002Fdocs\u002Fadding-sounds","Ajouter des sons",[31,268,269],{},[225,270,272],{"href":271},"\u002Fdocs\u002Forganizing-sounds","Organiser ton board",{"title":139,"searchDepth":140,"depth":140,"links":274},[275,276,277,278],{"id":175,"depth":140,"text":176},{"id":193,"depth":140,"text":194},{"id":237,"depth":140,"text":238},{"id":251,"depth":140,"text":252},"Ce qu’est SoundNinja et ce que tu peux en faire.",{},1,"\u002Foverview",{"title":158,"description":279},"overview","nBakDXsUbMnm0zyn8m6jAooziqocGWiZV3EwAtrg0xk",{"id":287,"title":288,"body":289,"description":482,"extension":147,"meta":483,"navigation":149,"order":140,"path":484,"seo":485,"stem":293,"__hash__":486},"content_fr\u002Finstallation.md","Installation",{"type":7,"value":290,"toc":475},[291,294,308,312,333,336,340,354,357,361,385,396,400,407,411,426,456,471],[10,292,288],{"id":293},"installation",[14,295,296,297,301,302,307],{},"Récupère un build sur la ",[225,298,300],{"href":299},"\u002Fdownload","page Télécharger"," ou sur ",[225,303,306],{"href":304,"rel":305},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Freleases\u002Flatest",[246],"GitHub Releases",". SoundNinja est en développement précoce — traite les builds comme des bêtas.",[23,309,311],{"id":310},"windows","Windows",[66,313,314,324,327,330],{},[31,315,316,319,320,323],{},[18,317,318],{},"Installateur (.exe)"," ou ",[18,321,322],{},"MSI (.msi)"," pour Windows 64 bits",[31,325,326],{},"Cible de la landing page : Windows 10 et plus",[31,328,329],{},"Le README de l’app mentionne aussi Windows 8 et supérieur",[31,331,332],{},"L’installateur NSIS est sombre. Choisis une langue à l’installation — SoundNinja la retient au prochain lancement.",[14,334,335],{},"Lance l’installateur, puis ouvre SoundNinja depuis le menu Démarrer.",[23,337,339],{"id":338},"macos","macOS",[66,341,342,348,351],{},[31,343,344,347],{},[18,345,346],{},".dmg universel"," pour Apple Silicon et Intel",[31,349,350],{},"Cible de la landing page : macOS 10.14 et plus",