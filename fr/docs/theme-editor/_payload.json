[{"data":1,"prerenderedAt":1612},["ShallowReactive",2],{"docs-page-fr-\u002Ftheme-editor":3,"docs-nav-fr":155},{"id":4,"title":5,"body":6,"description":146,"extension":147,"meta":148,"navigation":149,"order":150,"path":151,"seo":152,"stem":153,"__hash__":154},"content_fr\u002Ftheme-editor.md","Éditeur de thème",{"type":7,"value":8,"toc":138},"minimark",[9,13,22,27,58,61,65,80,84,110,113,117,124],[10,11,5],"h1",{"id":12},"éditeur-de-thème",[14,15,16,17,21],"p",{},"Le Theme Creator est l’éditeur visuel complet de ton board. Ouvre-le depuis ",[18,19,20],"strong",{},"Paramètres → Général → Theme Creator",".",[23,24,26],"h2",{"id":25},"trois-onglets","Trois onglets",[28,29,30,46,52],"ol",{},[31,32,33,36,37,41,42,45],"li",{},[18,34,35],{},"Général"," — nom du thème, couleurs partagées et import de polices (",[38,39,40],"code",{},".ttf"," \u002F ",[38,43,44],{},".otf",")",[31,47,48,51],{},[18,49,50],{},"Boutons"," — couleurs, typo, disposition et overlay GIF des boutons de son",[31,53,54,57],{},[18,55,56],{},"Onglets"," — couleurs, typo et épaisseur de bordure de la barre d’onglets",[14,59,60],{},"Un aperçu en direct montre onglets et boutons pendant que tu édites.",[23,62,64],{"id":63},"ce-que-tu-peux-changer","Ce que tu peux changer",[66,67,68,71,74,77],"ul",{},[31,69,70],{},"Couleurs primaire et d’accent, fonds, couleurs des boutons, couleurs des onglets",[31,72,73],{},"Famille et taille de police des boutons et des onglets",[31,75,76],{},"Largeur, rayon, bordure, écarts et padding des boutons",[31,78,79],{},"Opacité de l’overlay GIF (normal et survol)",[23,81,83],{"id":82},"enregistrer-et-partager","Enregistrer et partager",[66,85,86,92,98,104],{},[31,87,88,91],{},[18,89,90],{},"Exporter .css"," — écrire un fichier de thème à sauvegarder ou envoyer à un ami",[31,93,94,97],{},[18,95,96],{},"Ajouter aux thèmes"," — enregistrer le fichier dans ton dossier Themes et l’appliquer",[31,99,100,103],{},[18,101,102],{},"Importer .css"," — charger un preset intégré ou un thème enregistré",[31,105,106,109],{},[18,107,108],{},"Réinitialiser"," — revenir aux défauts SoundNinja",[14,111,112],{},"Si tu fermes la fenêtre avec des changements non enregistrés, SoundNinja te demande d’enregistrer d’abord.",[23,114,116],{"id":115},"sans-léditeur-complet","Sans l’éditeur complet",[14,118,119,120,123],{},"Dans ",[18,121,122],{},"Paramètres → Général"," tu peux toujours :",[66,125,126,129,135],{},[31,127,128],{},"Choisir un thème dans la liste",[31,130,131,132,45],{},"Éditer les variables CSS en direct (",[18,133,134],{},"CSS personnalisé",[31,136,137],{},"Importer un fichier de thème dans le dossier Themes",{"title":139,"searchDepth":140,"depth":140,"links":141},"",2,[142,143,144,145],{"id":25,"depth":140,"text":26},{"id":63,"depth":140,"text":64},{"id":82,"depth":140,"text":83},{"id":115,"depth":140,"text":116},"Concevoir couleurs, polices, boutons et onglets dans le Theme Creator.","md",{},true,5,"\u002Ftheme-editor",{"title":5,"description":146},"theme-editor","wkR6rxJNnSmcJeJxDdslCOIyK7-9BblSMG_tJA6IwRY",[156,286,508,656,1057,1146,1293,1515],{"id":157,"title":158,"body":159,"description":279,"extension":147,"meta":280,"navigation":149,"order":281,"path":282,"seo":283,"stem":284,"__hash__":285},"content_fr\u002Foverview.md","Aperçu",{"type":7,"value":160,"toc":273},[161,164,167,170,173,177,191,195,235,239,249,253],[10,162,158],{"id":163},"aperçu",[14,165,166],{},"SoundNinja est un soundboard open source pour le live streaming, les discussions entre amis et l’enregistrement de podcasts. Il est construit avec Tauri v2 et Nuxt 4 pour rester léger en RAM et sur le disque.",[14,168,169],{},"Le but est simple : garder une énorme bibliothèque de sons facile à parcourir, puis jouer le bon clip en quelques millisecondes. L’interface marche aussi comme tableau de bord en VR.",[14,171,172],{},"SoundNinja est encore en développement précoce. Les fonctions marchent, mais toutes les plateformes ne sont pas entièrement testées.",[23,174,176],{"id":175},"pour-qui","Pour qui",[66,178,179,182,185,188],{},[31,180,181],{},"Les streameurs qui ont besoin de cues sonores instantanés",[31,183,184],{},"Les amis qui veulent un board partagé pour le vocal",[31,186,187],{},"Les podcasteurs qui enregistrent des clips et les posent sur un board",[31,189,190],{},"Quiconque veut un soundboard personnalisable et local-first",[23,192,194],{"id":193},"ce-que-tu-peux-faire","Ce que tu peux faire",[66,196,197,200,203,206,209,212,215,218,221,229,232],{},[31,198,199],{},"Construire un soundboard à partir de tes propres fichiers audio",[31,201,202],{},"Organiser les sons dans des onglets colorés, des groupes, des tags et la recherche",[31,204,205],{},"Filtrer par tags (OU) et trier par nom, date, durée ou taille",[31,207,208],{},"Sélection multiple avec rectangle ou plage Maj, puis couleur, déplacement ou suppression en lot",[31,210,211],{},"Régler le volume par son depuis le menu contextuel",[31,213,214],{},"Concevoir le look avec le Theme Creator",[31,216,217],{},"Enregistrer l’audio du PC ou un micro dans le Record Editor",[31,219,220],{},"Assigner des raccourcis à des sons individuels",[31,222,223,224],{},"Déclencher des sons depuis ",[225,226,228],"a",{"href":227},"\u002Fdocs\u002Fremote-control","Bitfocus Companion",[31,230,231],{},"Importer et exporter un soundboard complet pour le partager",[31,233,234],{},"Utiliser des GIF ou des images sur les boutons — bibliothèque de dossiers locale ou KLIPY",[23,236,238],{"id":237},"licence","Licence",[14,240,241,242,248],{},"SoundNinja est un logiciel libre sous ",[225,243,247],{"href":244,"rel":245},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fblob\u002Fmain\u002FLICENSE",[246],"nofollow","GPL-3.0",". Forke-le, modifie-le, partage-le.",[23,250,252],{"id":251},"prochaines-étapes","Prochaines étapes",[28,254,255,261,267],{},[31,256,257],{},[225,258,260],{"href":259},"\u002Fdocs\u002Finstallation","Installer SoundNinja",[31,262,263],{},[225,264,266],{"href":265},"\u002Fdocs\u002Fadding-sounds","Ajouter des sons",[31,268,269],{},[225,270,272],{"href":271},"\u002Fdocs\u002Forganizing-sounds","Organiser ton board",{"title":139,"searchDepth":140,"depth":140,"links":274},[275,276,277,278],{"id":175,"depth":140,"text":176},{"id":193,"depth":140,"text":194},{"id":237,"depth":140,"text":238},{"id":251,"depth":140,"text":252},"Ce qu’est SoundNinja et ce que tu peux en faire.",{},1,"\u002Foverview",{"title":158,"description":279},"overview","nBakDXsUbMnm0zyn8m6jAooziqocGWiZV3EwAtrg0xk",{"id":287,"title":288,"body":289,"description":503,"extension":147,"meta":504,"navigation":149,"order":140,"path":505,"seo":506,"stem":293,"__hash__":507},"content_fr\u002Finstallation.md","Installation",{"type":7,"value":290,"toc":496},[291,294,308,312,333,336,340,354,357,361,385,396,400,407,411,426,456,471,492],[10,292,288],{"id":293},"installation",[14,295,296,297,301,302,307],{},"Récupère un build sur la ",[225,298,300],{"href":299},"\u002Fdownload","page Télécharger"," ou sur ",[225,303,306],{"href":304,"rel":305},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Freleases\u002Flatest",[246],"GitHub Releases",". SoundNinja est en développement précoce — traite les builds comme des bêtas.",[23,309,311],{"id":310},"windows","Windows",[66,313,314,324,327,330],{},[31,315,316,319,320,323],{},[18,317,318],{},"Installateur (.exe)"," ou ",[18,321,322],{},"MSI (.msi)"," pour Windows 64 bits",[31,325,326],{},"Cible de la landing page : Windows 10 et plus",[31,328,329],{},"Le README de l’app mentionne aussi Windows 8 et supérieur",[31,331,332],{},"L’installateur NSIS est sombre. Choisis une langue à l’installation — SoundNinja la retient au prochain lancement.",[14,334,335],{},"Lance l’installateur, puis ouvre SoundNinja depuis le menu Démarrer.",[23,337,339],{"id":338},"macos","macOS",[66,341,342,348,351],{},[31,343,344,347],{},[18,345,346],{},".dmg universel"," pour Apple Silicon et Intel",[31,349,350],{},"Cible de la landing page : macOS 10.14 et plus",[31,352,353],{},"Le README de l’app mentionne macOS 10.15 et supérieur",[14,355,356],{},"Ouvre l’image disque et glisse SoundNinja dans Applications.",[23,358,360],{"id":359},"linux","Linux",[66,362,363,369,375,382],{},[31,364,365,368],{},[18,366,367],{},"Debian (.deb)"," pour Ubuntu \u002F Debian",[31,370,371,374],{},[18,372,373],{},"AppImage"," pour les autres distros",[31,376,377,378,381],{},"Après publication d’une release, les utilisateurs Arch peuvent installer ",[38,379,380],{},"soundninja-bin"," depuis l’AUR",[31,383,384],{},"Testé sur Ubuntu 20.04",[14,386,387,388,391,392,395],{},"Les builds desktop ont besoin des paquets WebKit et GTK. Sous Debian\u002FUbuntu, ça veut souvent dire ",[38,389,390],{},"libwebkit2gtk",", ",[38,393,394],{},"libgtk-3-0"," et une bibliothèque app-indicator.",[23,397,399],{"id":398},"mises-à-jour","Mises à jour",[14,401,402,403,406],{},"Dans l’app, ouvre ",[18,404,405],{},"Aide → Rechercher les mises à jour",". Tu peux aussi laisser SoundNinja vérifier au démarrage dans les Paramètres.",[23,408,410],{"id":409},"compiler-depuis-les-sources","Compiler depuis les sources",[14,412,413,414,419,420,425],{},"Besoin d’un build custom ? Clone ",[225,415,418],{"href":416,"rel":417},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja",[246],"le repo",", installe les ",[225,421,424],{"href":422,"rel":423},"https:\u002F\u002Fv2.tauri.app\u002Fstart\u002Fprerequisites\u002F",[246],"prérequis Tauri",", puis :",[427,428,432],"pre",{"className":429,"code":430,"language":431,"meta":139,"style":139},"language-bash shiki shiki-themes github-light github-dark","bun install\nbun run tauri:serve\n","bash",[38,433,434,446],{"__ignoreMap":139},[435,436,438,442],"span",{"class":437,"line":281},"line",[435,439,441],{"class":440},"sScJk","bun",[435,443,445],{"class":444},"sZZnC"," install\n",[435,447,448,450,453],{"class":437,"line":140},[435,449,441],{"class":440},[435,451,452],{"class":444}," run",[435,454,455],{"class":444}," tauri:serve\n",[14,457,458,391,461,319,464,467,468,21],{},[38,459,460],{},"npm",[38,462,463],{},"pnpm",[38,465,466],{},"deno"," marchent aussi. Build de production : ",[38,469,470],{},"bun run tauri:build",[14,472,473,476,477,482,483,486,487,21],{},[18,474,475],{},"Windows uniquement :"," chaque compile Windows inclut ASIO via le ",[225,478,481],{"href":479,"rel":480},"https:\u002F\u002Fwww.steinberg.net\u002Fasiosdk",[246],"Steinberg ASIO SDK",". Lance ",[38,484,485],{},"bun run setup:asio"," une fois (SDK pas dans git). Linux et macOS utilisent PipeWire \u002F Core Audio — ignore cette étape. Détails : ",[225,488,491],{"href":489,"rel":490},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fblob\u002Fmain\u002Fdocs\u002Fbuild-from-source.md",[246],"build-from-source.md",[493,494,495],"style",{},"html pre.shiki code .sScJk, html code.shiki .sScJk{--shiki-default:#6F42C1;--shiki-dark:#B392F0}html pre.shiki code .sZZnC, html code.shiki .sZZnC{--shiki-default:#032F62;--shiki-dark:#9ECBFF}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html.dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}",{"title":139,"searchDepth":140,"depth":140,"links":497},[498,499,500,501,502],{"id":310,"depth":140,"text":311},{"id":338,"depth":140,"text":339},{"id":359,"depth":140,"text":360},{"id":398,"depth":140,"text":399},{"id":409,"depth":140,"text":410},"Installe SoundNinja sur Windows, macOS ou Linux.",{},"\u002Finstallation",{"title":288,"description":503},"FOJJDNBAT_xV14QaxG490DTpeNiFpVDRFz_XEdyJKJE",{"id":509,"title":266,"body":510,"description":649,"extension":147,"meta":650,"navigation":149,"order":651,"path":652,"seo":653,"stem":654,"__hash__":655},"content_fr\u002Fadding-sounds.md",{"type":7,"value":511,"toc":641},[512,515,518,522,541,545,576,580,599,603,617,620,624,631,635],[10,513,266],{"id":514},"ajouter-des-sons",[14,516,517],{},"Un board reste vide tant que tu n’ajoutes pas de clips. SoundNinja peut importer des fichiers, des dossiers entiers, un enregistrement ou un pack de soundboard partagé.",[23,519,521],{"id":520},"importer-des-fichiers-audio","Importer des fichiers audio",[28,523,524,535,538],{},[31,525,526,527,530,531,534],{},"Ouvre ",[18,528,529],{},"Fichier → Importer des fichiers audio",", ou utilise ",[18,532,533],{},"Importer"," dans la barre de navigation.",[31,536,537],{},"Choisis un ou plusieurs fichiers audio.",[31,539,540],{},"Les sons arrivent dans l’onglet actuel.",[23,542,544],{"id":543},"importer-des-dossiers","Importer des dossiers",[28,546,547,556,559],{},[31,548,526,549,552,553,555],{},[18,550,551],{},"Fichier → Importer des dossiers"," (ou ",[18,554,544],{}," dans la barre de navigation).",[31,557,558],{},"Ajoute un ou plusieurs dossiers. Glisse pour les réordonner avant l’import.",[31,560,561,562],{},"Choisis comment ils arrivent :\n",[66,563,564,570],{},[31,565,566,569],{},[18,567,568],{},"Importer comme onglets"," — chaque dossier devient son propre onglet",[31,571,572,575],{},[18,573,574],{},"Importer dans l’onglet actuel"," — chaque fichier va dans l’onglet actif",[23,577,579],{"id":578},"enregistrer-un-clip","Enregistrer un clip",[14,581,582,583,587,588,591,592,319,595,598],{},"Ouvre le ",[225,584,586],{"href":585},"\u002Fdocs\u002Frecording-editor","Record Editor"," depuis le bouton ",[18,589,590],{},"Enregistrer"," dans la barre du lecteur. Capture, coupe, puis ",[18,593,594],{},"Importer la sélection",[18,596,597],{},"Tout importer"," dans l’onglet actuel ou un onglet que tu choisis.",[23,600,602],{"id":601},"importer-un-soundboard","Importer un soundboard",[14,604,605,608,609,612,613,616],{},[18,606,607],{},"Fichier → Importer un soundboard"," charge un pack partagé. Les packs sont un ",[38,610,611],{},".zip"," qui contient ",[38,614,615],{},"project.sninja"," plus les fichiers audio. Après l’import, ouvre le projet et joue.",[14,618,619],{},"Tu peux aussi garder plusieurs projets (profils). Utilise le sélecteur de projet pour changer de board.",[23,621,623],{"id":622},"relier-les-fichiers-manquants","Relier les fichiers manquants",[14,625,626,627,630],{},"Si des fichiers audio bougent sur le disque, SoundNinja affiche ",[18,628,629],{},"Fichiers audio manquants",". Choisis un dossier à parcourir et relie les clips.",[23,632,634],{"id":633},"suite","Suite",[14,636,637,638,21],{},"Organise onglets, tags, filtres et raccourcis dans ",[225,639,640],{"href":271},"Organiser les sons",{"title":139,"searchDepth":140,"depth":140,"links":642},[643,644,645,646,647,648],{"id":520,"depth":140,"text":521},{"id":543,"depth":140,"text":544},{"id":578,"depth":140,"text":579},{"id":601,"depth":140,"text":602},{"id":622,"depth":140,"text":623},{"id":633,"depth":140,"text":634},"Importe de l’audio, des dossiers, des enregistrements et des soundboards partagés.",{},3,"\u002Fadding-sounds",{"title":266,"description":649},"adding-sounds","4l04_lLfE4dqOPh8H0Rav69GnvCVi_PKTEgAepysTeI",{"id":657,"title":640,"body":658,"description":1050,"extension":147,"meta":1051,"navigation":149,"order":1052,"path":1053,"seo":1054,"stem":1055,"__hash__":1056},"content_fr\u002Forganizing-sounds.md",{"type":7,"value":659,"toc":1035},[660,663,670,673,700,706,710,713,727,734,740,744,754,759,791,795,801,805,838,844,848,851,877,880,884,897,901,907,928,944,951,955,966,969,973,980,990,996,1000,1008,1015,1032],[10,661,640],{"id":662},"organiser-les-sons",[14,664,665,666,669],{},"SoundNinja est conçu pour les grandes bibliothèques. ",[18,667,668],{},"Tags et filtres",", onglets, recherche, sélection multiple et raccourcis — le clip dont tu as besoin est à un clic (ou une touche) près.",[23,671,56],{"id":672},"onglets",[66,674,675,682,689],{},[31,676,677,678,681],{},"Ajoute un onglet avec ",[18,679,680],{},"Ajouter un onglet",". Donne-lui une couleur pour scanner la barre vite.",[31,683,684,685,688],{},"La vue ",[18,686,687],{},"Tous"," montre chaque son à travers les onglets.",[31,690,691,692,695,696,699],{},"Un son peut appartenir à ",[18,693,694],{},"un ou plusieurs onglets",". Clic droit sur un son et utilise ",[18,697,698],{},"Déplacer vers l’onglet"," pour l’assigner.",[14,701,702,703,705],{},"Les transitions d’onglets sont dans ",[18,704,122],{}," : Slide, Fade, Boutons un par un, ou Aucune.",[23,707,709],{"id":708},"groupes","Groupes",[14,711,712],{},"Depuis la v0.5.3, les séparateurs peuvent devenir des groupes nommés :",[66,714,715,718,721,724],{},[31,716,717],{},"Ajouter, renommer ou supprimer un groupe depuis le menu contextuel",[31,719,720],{},"Glisser l’en-tête du groupe — les enfants suivent",[31,722,723],{},"Déposer des sons dans un groupe ou les en sortir",[31,725,726],{},"Régler la couleur de bordure, la couleur du nom et l’alignement des boutons (ou utiliser le défaut de l’onglet)",[14,728,729,730,733],{},"Tu peux toujours ajouter un ",[18,731,732],{},"Séparateur"," simple si tu as seulement besoin d’une coupure visuelle.",[14,735,736,737,21],{},"Clic droit sur l’espace vide du board pour ",[18,738,739],{},"Ajouter un groupe",[23,741,743],{"id":742},"tags-filtres","Tags \u002F Filtres",[14,745,746,747,750,751,753],{},"Les tags traversent les onglets. Le panneau ",[18,748,749],{},"Filtre"," (barre latérale ",[18,752,749],{},") sert à les créer et à filtrer le board.",[755,756,758],"h3",{"id":757},"créer-et-modifier-des-tags","Créer et modifier des tags",[28,760,761,766,777,784],{},[31,762,526,763,765],{},[18,764,749],{}," dans la barre latérale.",[31,767,768,769,772,773,776],{},"Sous ",[18,770,771],{},"Tags",", utilise ",[18,774,775],{},"Ajouter un tag"," — nom et couleur.",[31,778,779,780,783],{},"Renomme, recolore ou ",[18,781,782],{},"Supprimer le tag"," dans la même liste.",[31,785,786,787,790],{},"Si tu vois ",[18,788,789],{},"Aucun tag pour l’instant",", crée-en un ici avant d’assigner.",[755,792,794],{"id":793},"assigner-des-tags-aux-sons","Assigner des tags aux sons",[14,796,797,798,800],{},"Clic droit sur un son → ",[18,799,771],{}," (cases à cocher). Un son peut avoir plusieurs tags. S’il n’y en a encore aucun, le menu pointe vers le panneau filtre.",[755,802,804],{"id":803},"filtrer-le-board","Filtrer le board",[66,806,807,813,824,835],{},[31,808,809,810,21],{},"Active les tags dans le panneau Filtre, ou comme ",[18,811,812],{},"puces sous la barre de recherche",[31,814,815,816,819,820,823],{},"Le match est ",[18,817,818],{},"OU"," : un son reste visible s’il a ",[18,821,822],{},"n’importe quel"," tag sélectionné.",[31,825,826,827,830,831,834],{},"Le champ ",[18,828,829],{},"Recherche"," combine en ",[18,832,833],{},"ET"," avec le filtre de tags actif (saisie + tags ensemble).",[31,836,837],{},"Désactive les puces (ou vide le filtre) pour revoir tout l’onglet.",[14,839,840,841,21],{},"Les noms de tags colorés peuvent apparaître sur les boutons. Active-les dans ",[18,842,843],{},"Paramètres → Comportement → Afficher les badges de tags",[23,845,847],{"id":846},"tri","Tri",[14,849,850],{},"Ouvre le panneau filtre et choisis un mode :",[66,852,853,859],{},[31,854,855,858],{},[18,856,857],{},"Défini par l’utilisateur"," — ton ordre d’onglet, groupes visibles",[31,860,861,391,864,391,867,319,870,873,874],{},[18,862,863],{},"Nom",[18,865,866],{},"Date d’ajout",[18,868,869],{},"Durée de lecture",[18,871,872],{},"Taille de fichier"," — liste plate triée ; ",[18,875,876],{},"les groupes sont masqués",[14,878,879],{},"Le tri par durée peut préchauffer les métadonnées de durée la première fois.",[23,881,883],{"id":882},"réordonner","Réordonner",[14,885,886,887,890,891,894,895,21],{},"Active le glisser-déposer dans ",[18,888,889],{},"Paramètres → Comportement"," (",[18,892,893],{},"Autoriser le réordonnancement","). Puis glisse sons et groupes en place. Le réordonnancement s’applique en tri ",[18,896,857],{},[23,898,900],{"id":899},"sélection-multiple","Sélection multiple",[14,902,903,904,906],{},"Active ",[18,905,900],{}," dans la barre de navigation, puis :",[66,908,909,912,918,925],{},[31,910,911],{},"Clique pour basculer un son",[31,913,914,917],{},[18,915,916],{},"Maj+clic"," pour une plage depuis le dernier ancrage",[31,919,920,921,924],{},"Trace un ",[18,922,923],{},"rectangle"," sur l’espace vide du board",[31,926,927],{},"Clique le board vide (ou à l’extérieur) pour vider la sélection",[14,929,930,931,391,934,391,937,940,941,21],{},"Une barre groupée affiche le compte, plus ",[18,932,933],{},"Couleur",[18,935,936],{},"Déplacer vers l’onglet…",[18,938,939],{},"Supprimer"," et ",[18,942,943],{},"Terminé",[14,945,946,947,950],{},"En sélection multiple, chaque bouton montre une ",[18,948,949],{},"puce d’ID de 8 caractères",". Clic droit sur la puce pour la copier.",[23,952,954],{"id":953},"volume-par-son","Volume par son",[14,956,957,958,961,962,965],{},"Clic droit → ",[18,959,960],{},"Volume",". Glisse le curseur de 0 % à 100 %. ",[18,963,964],{},"Double-clic"," le remet à 100 %.",[14,967,968],{},"Ça se cumule avec le volume de sortie principal dans les Paramètres.",[23,970,972],{"id":971},"raccourcis-et-ids-de-son","Raccourcis et IDs de son",[14,974,975,976,979],{},"Chaque son a un ID de 8 caractères. Copie-le depuis le menu contextuel du bouton (",[18,977,978],{},"Copier l’ID",") ou la puce d’ID de la sélection multiple.",[14,981,526,982,985,986,989],{},[18,983,984],{},"Paramètres → Raccourcis"," pour lier une touche à un ID de son. Les raccourcis globaux sont optionnels. ",[18,987,988],{},"Assigner un raccourci"," dans le menu contextuel y saute avec l’ID déjà rempli.",[14,991,992,993,995],{},"Le même ID est ce que ",[225,994,228],{"href":227}," utilise pour déclencher un clip.",[23,997,999],{"id":998},"images-de-fond-et-couleurs","Images de fond et couleurs",[14,1001,1002,1003,1007],{},"Clic droit sur un son pour régler des couleurs par bouton ou une image de fond. C’est séparé du ",[225,1004,1006],{"href":1005},"\u002Fdocs\u002Ftheme-editor","Theme Creator",", qui habille tout le board.",[14,1009,1010,1011,1014],{},"Le sélecteur est une boîte ",[18,1012,1013],{},"Image de fond"," (PNG, JPEG, GIF, WebP) :",[66,1016,1017,1023],{},[31,1018,1019,1022],{},[18,1020,1021],{},"Fichiers locaux"," — ajouter des dossiers, choisir un fichier, chercher par nom, prévisualiser la grille, retirer un dossier de la bibliothèque",[31,1024,1025,1028,1029,1031],{},[18,1026,1027],{},"KLIPY"," — chercher des GIF en ligne. Mets ta propre clé API dans ",[18,1030,889],{},". La clé n’est pas stockée dans les fichiers projet.",[14,1033,1034],{},"Après le choix, recadre et décale l’image sur le bouton.",{"title":139,"searchDepth":140,"depth":140,"links":1036},[1037,1038,1039,1044,1045,1046,1047,1048,1049],{"id":672,"depth":140,"text":56},{"id":708,"depth":140,"text":709},{"id":742,"depth":140,"text":743,"children":1040},[1041,1042,1043],{"id":757,"depth":651,"text":758},{"id":793,"depth":651,"text":794},{"id":803,"depth":651,"text":804},{"id":846,"depth":140,"text":847},{"id":882,"depth":140,"text":883},{"id":899,"depth":140,"text":900},{"id":953,"depth":140,"text":954},{"id":971,"depth":140,"text":972},{"id":998,"depth":140,"text":999},"Tags, filtres, onglets, groupes, tri, sélection multiple, volume et raccourcis.",{},4,"\u002Forganizing-sounds",{"title":640,"description":1050},"organizing-sounds","3ZEh-vX7bLxxdpr56sVGIToyf64-wDiiegH_atr9lbk",{"id":4,"title":5,"bod