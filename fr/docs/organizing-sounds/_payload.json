[{"data":1,"prerenderedAt":1790},["ShallowReactive",2],{"docs-page-fr-\u002Forganizing-sounds":3,"docs-nav-fr":438},{"id":4,"title":5,"body":6,"description":429,"extension":430,"meta":431,"navigation":432,"order":433,"path":434,"seo":435,"stem":436,"__hash__":437},"content_fr\u002Forganizing-sounds.md","Organiser les sons",{"type":7,"value":8,"toc":411},"minimark",[9,13,22,27,56,63,67,70,84,91,98,102,112,117,151,155,161,165,198,204,208,211,239,242,246,259,263,269,290,306,313,317,328,331,335,342,352,361,365,373,380,408],[10,11,5],"h1",{"id":12},"organiser-les-sons",[14,15,16,17,21],"p",{},"SoundNinja est conçu pour les grandes bibliothèques. ",[18,19,20],"strong",{},"Tags et filtres",", onglets, recherche, sélection multiple et raccourcis — le clip dont tu as besoin est à un clic (ou une touche) près.",[23,24,26],"h2",{"id":25},"onglets","Onglets",[28,29,30,38,45],"ul",{},[31,32,33,34,37],"li",{},"Ajoute un onglet avec ",[18,35,36],{},"Ajouter un onglet",". Donne-lui une couleur pour scanner la barre vite.",[31,39,40,41,44],{},"La vue ",[18,42,43],{},"Tous"," montre chaque son à travers les onglets.",[31,46,47,48,51,52,55],{},"Un son peut appartenir à ",[18,49,50],{},"un ou plusieurs onglets",". Clic droit sur un son et utilise ",[18,53,54],{},"Déplacer vers l’onglet"," pour l’assigner.",[14,57,58,59,62],{},"Les transitions d’onglets sont dans ",[18,60,61],{},"Paramètres → Général"," : Slide, Fade, Boutons un par un, ou Aucune.",[23,64,66],{"id":65},"groupes","Groupes",[14,68,69],{},"Depuis la v0.5.3, les séparateurs peuvent devenir des groupes nommés :",[28,71,72,75,78,81],{},[31,73,74],{},"Ajouter, renommer ou supprimer un groupe depuis le menu contextuel",[31,76,77],{},"Glisser l’en-tête du groupe — les enfants suivent",[31,79,80],{},"Déposer des sons dans un groupe ou les en sortir",[31,82,83],{},"Régler la couleur de bordure, la couleur du nom et l’alignement des boutons (ou utiliser le défaut de l’onglet)",[14,85,86,87,90],{},"Tu peux toujours ajouter un ",[18,88,89],{},"Séparateur"," simple si tu as seulement besoin d’une coupure visuelle.",[14,92,93,94,97],{},"Clic droit sur l’espace vide du board pour ",[18,95,96],{},"Ajouter un groupe",".",[23,99,101],{"id":100},"tags-filtres","Tags \u002F Filtres",[14,103,104,105,108,109,111],{},"Les tags traversent les onglets. Le panneau ",[18,106,107],{},"Filtre"," (barre latérale ",[18,110,107],{},") sert à les créer et à filtrer le board.",[113,114,116],"h3",{"id":115},"créer-et-modifier-des-tags","Créer et modifier des tags",[118,119,120,126,137,144],"ol",{},[31,121,122,123,125],{},"Ouvre ",[18,124,107],{}," dans la barre latérale.",[31,127,128,129,132,133,136],{},"Sous ",[18,130,131],{},"Tags",", utilise ",[18,134,135],{},"Ajouter un tag"," — nom et couleur.",[31,138,139,140,143],{},"Renomme, recolore ou ",[18,141,142],{},"Supprimer le tag"," dans la même liste.",[31,145,146,147,150],{},"Si tu vois ",[18,148,149],{},"Aucun tag pour l’instant",", crée-en un ici avant d’assigner.",[113,152,154],{"id":153},"assigner-des-tags-aux-sons","Assigner des tags aux sons",[14,156,157,158,160],{},"Clic droit sur un son → ",[18,159,131],{}," (cases à cocher). Un son peut avoir plusieurs tags. S’il n’y en a encore aucun, le menu pointe vers le panneau filtre.",[113,162,164],{"id":163},"filtrer-le-board","Filtrer le board",[28,166,167,173,184,195],{},[31,168,169,170,97],{},"Active les tags dans le panneau Filtre, ou comme ",[18,171,172],{},"puces sous la barre de recherche",[31,174,175,176,179,180,183],{},"Le match est ",[18,177,178],{},"OU"," : un son reste visible s’il a ",[18,181,182],{},"n’importe quel"," tag sélectionné.",[31,185,186,187,190,191,194],{},"Le champ ",[18,188,189],{},"Recherche"," combine en ",[18,192,193],{},"ET"," avec le filtre de tags actif (saisie + tags ensemble).",[31,196,197],{},"Désactive les puces (ou vide le filtre) pour revoir tout l’onglet.",[14,199,200,201,97],{},"Les noms de tags colorés peuvent apparaître sur les boutons. Active-les dans ",[18,202,203],{},"Paramètres → Comportement → Afficher les badges de tags",[23,205,207],{"id":206},"tri","Tri",[14,209,210],{},"Ouvre le panneau filtre et choisis un mode :",[28,212,213,219],{},[31,214,215,218],{},[18,216,217],{},"Défini par l’utilisateur"," — ton ordre d’onglet, groupes visibles",[31,220,221,224,225,224,228,231,232,235,236],{},[18,222,223],{},"Nom",", ",[18,226,227],{},"Date d’ajout",[18,229,230],{},"Durée de lecture"," ou ",[18,233,234],{},"Taille de fichier"," — liste plate triée ; ",[18,237,238],{},"les groupes sont masqués",[14,240,241],{},"Le tri par durée peut préchauffer les métadonnées de durée la première fois.",[23,243,245],{"id":244},"réordonner","Réordonner",[14,247,248,249,252,253,256,257,97],{},"Active le glisser-déposer dans ",[18,250,251],{},"Paramètres → Comportement"," (",[18,254,255],{},"Autoriser le réordonnancement","). Puis glisse sons et groupes en place. Le réordonnancement s’applique en tri ",[18,258,217],{},[23,260,262],{"id":261},"sélection-multiple","Sélection multiple",[14,264,265,266,268],{},"Active ",[18,267,262],{}," dans la barre de navigation, puis :",[28,270,271,274,280,287],{},[31,272,273],{},"Clique pour basculer un son",[31,275,276,279],{},[18,277,278],{},"Maj+clic"," pour une plage depuis le dernier ancrage",[31,281,282,283,286],{},"Trace un ",[18,284,285],{},"rectangle"," sur l’espace vide du board",[31,288,289],{},"Clique le board vide (ou à l’extérieur) pour vider la sélection",[14,291,292,293,224,296,224,299,302,303,97],{},"Une barre groupée affiche le compte, plus ",[18,294,295],{},"Couleur",[18,297,298],{},"Déplacer vers l’onglet…",[18,300,301],{},"Supprimer"," et ",[18,304,305],{},"Terminé",[14,307,308,309,312],{},"En sélection multiple, chaque bouton montre une ",[18,310,311],{},"puce d’ID de 8 caractères",". Clic droit sur la puce pour la copier.",[23,314,316],{"id":315},"volume-par-son","Volume par son",[14,318,319,320,323,324,327],{},"Clic droit → ",[18,321,322],{},"Volume",". Glisse le curseur de 0 % à 100 %. ",[18,325,326],{},"Double-clic"," le remet à 100 %.",[14,329,330],{},"Ça se cumule avec le volume de sortie principal dans les Paramètres.",[23,332,334],{"id":333},"raccourcis-et-ids-de-son","Raccourcis et IDs de son",[14,336,337,338,341],{},"Chaque son a un ID de 8 caractères. Copie-le depuis le menu contextuel du bouton (",[18,339,340],{},"Copier l’ID",") ou la puce d’ID de la sélection multiple.",[14,343,122,344,347,348,351],{},[18,345,346],{},"Paramètres → Raccourcis"," pour lier une touche à un ID de son. Les raccourcis globaux sont optionnels. ",[18,349,350],{},"Assigner un raccourci"," dans le menu contextuel y saute avec l’ID déjà rempli.",[14,353,354,355,360],{},"Le même ID est ce que ",[356,357,359],"a",{"href":358},"\u002Fdocs\u002Fremote-control","Bitfocus Companion"," utilise pour déclencher un clip.",[23,362,364],{"id":363},"images-de-fond-et-couleurs","Images de fond et couleurs",[14,366,367,368,372],{},"Clic droit sur un son pour régler des couleurs par bouton ou une image de fond. C’est séparé du ",[356,369,371],{"href":370},"\u002Fdocs\u002Ftheme-editor","Theme Creator",", qui habille tout le board.",[14,374,375,376,379],{},"Le sélecteur est une boîte ",[18,377,378],{},"Image de fond"," (PNG, JPEG, GIF, WebP) :",[28,381,382,388,399],{},[31,383,384,387],{},[18,385,386],{},"Fichiers locaux"," — ajouter des dossiers, choisir un fichier, chercher par nom, prévisualiser la grille, retirer un dossier de la bibliothèque",[31,389,390,393,394,97],{},[18,391,392],{},"GifSnap"," — chercher des GIF en ligne sans clé API. La première visite demande d’accepter les requêtes GifSnap ; les résultats sont mis en cache pour limiter le trafic. Voir ",[356,395,392],{"href":396,"rel":397},"https:\u002F\u002Fgifsnap.com",[398],"nofollow",[31,400,401,404,405,407],{},[18,402,403],{},"KLIPY"," — chercher des GIF en ligne. Mets ta propre clé API dans ",[18,406,251],{},". La clé n’est pas stockée dans les fichiers projet.",[14,409,410],{},"Après le choix, recadre et décale l’image sur le bouton.",{"title":412,"searchDepth":413,"depth":413,"links":414},"",2,[415,416,417,423,424,425,426,427,428],{"id":25,"depth":413,"text":26},{"id":65,"depth":413,"text":66},{"id":100,"depth":413,"text":101,"children":418},[419,421,422],{"id":115,"depth":420,"text":116},3,{"id":153,"depth":420,"text":154},{"id":163,"depth":420,"text":164},{"id":206,"depth":413,"text":207},{"id":244,"depth":413,"text":245},{"id":261,"depth":413,"text":262},{"id":315,"depth":413,"text":316},{"id":333,"depth":413,"text":334},{"id":363,"depth":413,"text":364},"Tags, filtres, onglets, groupes, tri, sélection multiple, volume et raccourcis.","md",{},true,4,"\u002Forganizing-sounds",{"title":5,"description":429},"organizing-sounds","hUCpYJChaKAM-1r7m_753kBLwJSvaE3h-IPyQN67wAY",[439,565,786,931,1188,1324,1471,1693],{"id":440,"title":441,"body":442,"description":558,"extension":430,"meta":559,"navigation":432,"order":560,"path":561,"seo":562,"stem":563,"__hash__":564},"content_fr\u002Foverview.md","Aperçu",{"type":7,"value":443,"toc":552},[444,447,450,453,456,460,474,478,515,519,528,532],[10,445,441],{"id":446},"aperçu",[14,448,449],{},"SoundNinja est un soundboard open source pour le live streaming, les discussions entre amis et l’enregistrement de podcasts. Il est construit avec Tauri v2 et Nuxt 4 pour rester léger en RAM et sur le disque.",[14,451,452],{},"Le but est simple : garder une énorme bibliothèque de sons facile à parcourir, puis jouer le bon clip en quelques millisecondes. L’interface marche aussi comme tableau de bord en VR.",[14,454,455],{},"SoundNinja est encore en développement précoce. Les fonctions marchent, mais toutes les plateformes ne sont pas entièrement testées.",[23,457,459],{"id":458},"pour-qui","Pour qui",[28,461,462,465,468,471],{},[31,463,464],{},"Les streameurs qui ont besoin de cues sonores instantanés",[31,466,467],{},"Les amis qui veulent un board partagé pour le vocal",[31,469,470],{},"Les podcasteurs qui enregistrent des clips et les posent sur un board",[31,472,473],{},"Quiconque veut un soundboard personnalisable et local-first",[23,475,477],{"id":476},"ce-que-tu-peux-faire","Ce que tu peux faire",[28,479,480,483,486,489,492,495,498,501,504,509,512],{},[31,481,482],{},"Construire un soundboard à partir de tes propres fichiers audio",[31,484,485],{},"Organiser les sons dans des onglets colorés, des groupes, des tags et la recherche",[31,487,488],{},"Filtrer par tags (OU) et trier par nom, date, durée ou taille",[31,490,491],{},"Sélection multiple avec rectangle ou plage Maj, puis couleur, déplacement ou suppression en lot",[31,493,494],{},"Régler le volume par son depuis le menu contextuel",[31,496,497],{},"Concevoir le look avec le Theme Creator",[31,499,500],{},"Enregistrer l’audio du PC ou un micro dans le Record Editor",[31,502,503],{},"Assigner des raccourcis à des sons individuels",[31,505,506,507],{},"Déclencher des sons depuis ",[356,508,359],{"href":358},[31,510,511],{},"Importer et exporter un soundboard complet pour le partager",[31,513,514],{},"Utiliser des GIF ou des images sur les boutons — bibliothèque de dossiers locale, GifSnap ou KLIPY",[23,516,518],{"id":517},"licence","Licence",[14,520,521,522,527],{},"SoundNinja est un logiciel libre sous ",[356,523,526],{"href":524,"rel":525},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fblob\u002Fmain\u002FLICENSE",[398],"GPL-3.0",". Forke-le, modifie-le, partage-le.",[23,529,531],{"id":530},"prochaines-étapes","Prochaines étapes",[118,533,534,540,546],{},[31,535,536],{},[356,537,539],{"href":538},"\u002Fdocs\u002Finstallation","Installer SoundNinja",[31,541,542],{},[356,543,545],{"href":544},"\u002Fdocs\u002Fadding-sounds","Ajouter des sons",[31,547,548],{},[356,549,551],{"href":550},"\u002Fdocs\u002Forganizing-sounds","Organiser ton board",{"title":412,"searchDepth":413,"depth":413,"links":553},[554,555,556,557],{"id":458,"depth":413,"text":459},{"id":476,"depth":413,"text":477},{"id":517,"depth":413,"text":518},{"id":530,"depth":413,"text":531},"Ce qu’est SoundNinja et ce que tu peux en faire.",{},1,"\u002Foverview",{"title":441,"description":558},"overview","iefPYZgnT849nIe2RlNwJvyVbEUn8-T9CgtILbqYFPI",{"id":566,"title":567,"body":568,"description":781,"extension":430,"meta":782,"navigation":432,"order":413,"path":783,"seo":784,"stem":572,"__hash__":785},"content_fr\u002Finstallation.md","Installation",{"type":7,"value":569,"toc":774},[570,573,587,591,611,614,618,632,635,639,664,674,678,685,689,704,734,749,770],[10,571,567],{"id":572},"installation",[14,574,575,576,580,581,586],{},"Récupère un build sur la ",[356,577,579],{"href":578},"\u002Fdownload","page Télécharger"," ou sur ",[356,582,585],{"href":583,"rel":584},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Freleases\u002Flatest",[398],"GitHub Releases",". SoundNinja est en développement précoce — traite les builds comme des bêtas.",[23,588,590],{"id":589},"windows","Windows",[28,592,593,602,605,608],{},[31,594,595,231,598,601],{},[18,596,597],{},"Installateur (.exe)",[18,599,600],{},"MSI (.msi)"," pour Windows 64 bits",[31,603,604],{},"Cible de la landing page : Windows 10 et plus",[31,606,607],{},"Le README de l’app mentionne aussi Windows 8 et supérieur",[31,609,610],{},"L’installateur NSIS est sombre. Choisis une langue à l’installation — SoundNinja la retient au prochain lancement.",[14,612,613],{},"Lance l’installateur, puis ouvre SoundNinja depuis le menu Démarrer.",[23,615,617],{"id":616},"macos","macOS",[28,619,620,626,629],{},[31,621,622,625],{},[18,623,624],{},".dmg universel"," pour Apple Silicon et Intel",[31,627,628],{},"Cible de la landing page : macOS 10.14 et plus",[31,630,631],{},"Le README de l’app mentionne macOS 10.15 et supérieur",[14,633,634],{},"Ouvre l’image disque et glisse SoundNinja dans Applications.",[23,636,638],{"id":637},"linux","Linux",[28,640,641,647,653,661],{},[31,642,643,646],{},[18,644,645],{},"Debian (.deb)"," pour Ubuntu \u002F Debian",[31,648,649,652],{},[18,650,651],{},"AppImage"," pour les autres distros",[31,654,655,656,660],{},"Après publication d’une release, les utilisateurs Arch peuvent installer ",[657,658,659],"code",{},"soundninja-bin"," depuis l’AUR",[31,662,663],{},"Testé sur Ubuntu 20.04",[14,665,666,667,224,670,673],{},"Les builds desktop ont besoin des paquets WebKit et GTK. Sous Debian\u002FUbuntu, ça veut souvent dire ",[657,668,669],{},"libwebkit2gtk",[657,671,672],{},"libgtk-3-0"," et une bibliothèque app-indicator.",[23,675,677],{"id":676},"mises-à-jour","Mises à jour",[14,679,680,681,684],{},"Dans l’app, ouvre ",[18,682,683],{},"Aide → Rechercher les mises à jour",". Tu peux aussi laisser SoundNinja vérifier au démarrage dans les Paramètres.",[23,686,688],{"id":687},"compiler-depuis-les-sources","Compiler depuis les sources",[14,690,691,692,697,698,703],{},"Besoin d’un build custom ? Clone ",[356,693,696],{"href":694,"rel":695},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja",[398],"le repo",", installe les ",[356,699,702],{"href":700,"rel":701},"https:\u002F\u002Fv2.tauri.app\u002Fstart\u002Fprerequisites\u002F",[398],"prérequis Tauri",", puis :",[705,706,710],"pre",{"className":707,"code":708,"language":709,"meta":412,"style":412},"language-bash shiki shiki-themes github-light github-dark","bun install\nbun run tauri:serve\n","bash",[657,711,712,724],{"__ignoreMap":412},[713,714,716,720],"span",{"class":715,"line":560},"line",[713,717,719],{"class":718},"sScJk","bun",[713,721,723],{"class":722},"sZZnC"," install\n",[713,725,726,728,731],{"class":715,"line":413},[713,727,719],{"class":718},[713,729,730],{"class":722}," run",[713,732,733],{"class":722}," tauri:serve\n",[14,735,736,224,739,231,742,745,746,97],{},[657,737,738],{},"npm",[657,740,741],{},"pnpm",[657,743,744],{},"deno"," marchent aussi. Build de production : ",[657,747,748],{},"bun run tauri:build",[14,750,751,754,755,760,761,764,765,97],{},[18,752,753],{},"Windows uniquement :"," chaque compile Windows inclut ASIO via le ",[356,756,759],{"href":757,"rel":758},"https:\u002F\u002Fwww.steinberg.net\u002Fasiosdk",[398],"Steinberg ASIO SDK",". Lance ",[657,762,763],{},"bun run setup:asio"," une fois (SDK pas dans git). Linux et macOS utilisent PipeWire \u002F Core Audio — ignore cette étape. Détails : ",[356,766,769],{"href":767,"rel":768},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fblob\u002Fmain\u002Fdocs\u002Fbuild-from-source.md",[398],"build-from-source.md",[771,772,773],"style",{},"html pre.shiki code .sScJk, html code.shiki .sScJk{--shiki-default:#6F42C1;--shiki-dark:#B392F0}html pre.shiki code .sZZnC, html code.shiki .sZZnC{--shiki-default:#032F62;--shiki-dark:#9ECBFF}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html.dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}",{"title":412,"searchDepth":413,"depth":413,"links":775},[776,777,778,779,780],{"id":589,"depth":413,"text":590},{"id":616,"depth":413,"text":617},{"id":637,"depth":413,"text":638},{"id":676,"depth":413,"text":677},{"id":687,"depth":413,"text":688},"Installe SoundNinja sur Windows, macOS ou Linux.",{},"\u002Finstallation",{"title":567,"description":781},"FOJJDNBAT_xV14QaxG490DTpeNiFpVDRFz_XEdyJKJE",{"id":787,"title":545,"body":788,"description":925,"extension":430,"meta":926,"navigation":432,"order":420,"path":927,"seo":928,"stem":929,"__hash__":930},"content_fr\u002Fadding-sounds.md",{"type":7,"value":789,"toc":917},[790,793,796,800,818,822,853,857,876,880,894,897,901,908,912],[10,791,545],{"id":792},"ajouter-des-sons",[14,794,795],{},"Un board reste vide tant que tu n’ajoutes pas de clips. SoundNinja peut importer des fichiers, des dossiers entiers, un enregistrement ou un pack de soundboard partagé.",[23,797,799],{"id":798},"importer-des-fichiers-audio","Importer des fichiers audio",[118,801,802,812,815],{},[31,803,122,804,807,808,811],{},[18,805,806],{},"Fichier → Importer des fichiers audio",", ou utilise ",[18,809,810],{},"Importer"," dans la barre de navigation.",[31,813,814],{},"Choisis un ou plusieurs fichiers audio.",[31,816,817],{},"Les sons arrivent dans l’onglet actuel.",[23,819,821],{"id":820},"importer-des-dossiers","Importer des dossiers",[118,823,824,833,836],{},[31,825,122,826,829,830,832],{},[18,827,828],{},"Fichier → Importer des dossiers"," (ou ",[18,831,821],{}," dans la barre de navigation).",[31,834,835],{},"Ajoute un ou plusieurs dossiers. Glisse pour les réordonner avant l’import.",[31,837,838,839],{},"Choisis comment ils arrivent :\n",[28,840,841,847],{},[31,842,843,846],{},[18,844,845],{},"Importer comme onglets"," — chaque dossier devient son propre onglet",[31,848,849,852],{},[18,850,851],{},"Importer dans l’onglet actuel"," — chaque fichier va dans l’onglet actif",[23,854,856],{"id":855},"enregistrer-un-clip","Enregistrer un clip",[14,858,859,860,864,865,868,869,231,872,875],{},"Ouvre le ",[356,861,863],{"href":862},"\u002Fdocs\u002Frecording-editor","Record Editor"," depuis le bouton ",[18,866,867],{},"Enregistrer"," dans la barre du lecteur. Capture, coupe, puis ",[18,870,871],{},"Importer la sélection",[18,873,874],{},"Tout importer"," dans l’onglet actuel ou un onglet que tu choisis.",[23,877,879],{"id":878},"importer-un-soundboard","Importer un soundboard",[14,881,882,885,886,889,890,893],{},[18,883,884],{},"Fichier → Importer un soundboard"," charge un pack partagé. Les packs sont un ",[657,887,888],{},".zip"," qui contient ",[657,891,892],{},"project.sninja"," plus les fichiers audio. Après l’import, ouvre le projet et joue.",[14,895,896],{},"Tu peux aussi garder plusieurs projets (profils). Utilise le sélecteur de projet pour changer de board.",[23,898,900],{"id":899},"relier-les-fichiers-manquants","Relier les fichiers manquants",[14,902,903,904,907],{},"Si des fichiers audio bougent sur le disque, SoundNinja affiche ",[18,905,906],{},"Fichiers audio manquants",". Choisis un dossier à parcourir et relie les clips.",[23,909,911],{"id":910},"suite","Suite",[14,913,914,915,97],{},"Organise onglets, tags, filtres et raccourcis dans ",[356,916,5],{"href":550},{"title":412,"searchDepth":413,"depth":413,"links":918},[919,920,921,922,923,924],{"id":798,"depth":413,"text":799},{"id":820,"depth":413,"text":821},{"id":855,"depth":413,"text":856},{"id":878,"depth":413,"text":879},{"id":899,"depth":413,"text":900},{"id":910,"depth":413,"text":911},"Importe de l’audio, des dossiers, des enregistrements et des soundboards partagés.",{},"\u002Fadding-sounds",{"title":545,"description":925},"adding-sounds","4l04_lLfE4dqOPh8H0Rav69GnvCVi_PKTEgAepysTeI",{"id":4,"title":5,"body":932,"description":429,"extension":430,"meta":1186,"navigation":432,"order":433,"path":434,"seo":1187,"stem":436,"__hash__":437},{"type":7,"value":933,"toc":1171},[934,936,940,942,958,962,964,966,976,980,984,986,992,994,1014,1016,1020,1022,1042,1046,1048,1050,1068,1070,1072,1080,1082,1086,1100,1110,1114,1116,1122,1124,1126,1130,1136,1140,1142,1146,1150,1169],[10,935,5],{"id":12},[14,937,16,938,21],{},[18,939,20],{},[23,941,26],{"id":25},[28,943,944,948,952],{},[31,945,33,946,37],{},[18,947,36],{},[31,949,40,950,44],{},[18,951,43],{},[31,953,47,954,51,956,55],{},[18,955,50],{},[18,957,54],{},[14,959,58,960,62],{},[18,961,61],{},[23,963,66],