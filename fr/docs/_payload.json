[{"data":1,"prerenderedAt":1314},["ShallowReactive",2],{"docs-page-fr-\u002Foverview":3,"docs-nav-fr":135},{"id":4,"title":5,"body":6,"description":126,"extension":127,"meta":128,"navigation":129,"order":130,"path":131,"seo":132,"stem":133,"__hash__":134},"content_fr\u002Foverview.md","Aperçu",{"type":7,"value":8,"toc":118},"minimark",[9,13,17,20,23,28,44,48,79,83,93,97],[10,11,5],"h1",{"id":12},"aperçu",[14,15,16],"p",{},"SoundNinja est un soundboard open source pour le live streaming, les discussions entre amis et l’enregistrement de podcasts. Il est construit avec Tauri v2 et Nuxt 4 pour rester léger en RAM et sur le disque.",[14,18,19],{},"Le but est simple : garder une énorme bibliothèque de sons facile à parcourir, puis jouer le bon clip en quelques millisecondes. L’interface marche aussi comme tableau de bord en VR.",[14,21,22],{},"SoundNinja est encore en développement précoce. Les fonctions marchent, mais toutes les plateformes ne sont pas entièrement testées.",[24,25,27],"h2",{"id":26},"pour-qui","Pour qui",[29,30,31,35,38,41],"ul",{},[32,33,34],"li",{},"Les streameurs qui ont besoin de cues sonores instantanés",[32,36,37],{},"Les amis qui veulent un board partagé pour le vocal",[32,39,40],{},"Les podcasteurs qui enregistrent des clips et les posent sur un board",[32,42,43],{},"Quiconque veut un soundboard personnalisable et local-first",[24,45,47],{"id":46},"ce-que-tu-peux-faire","Ce que tu peux faire",[29,49,50,53,56,59,62,65,73,76],{},[32,51,52],{},"Construire un soundboard à partir de tes propres fichiers audio",[32,54,55],{},"Organiser les sons dans des onglets colorés, des groupes et la recherche",[32,57,58],{},"Concevoir le look avec le Theme Creator",[32,60,61],{},"Enregistrer l’audio du PC ou un micro dans le Record Editor",[32,63,64],{},"Assigner des raccourcis à des sons individuels",[32,66,67,68],{},"Déclencher des sons depuis ",[69,70,72],"a",{"href":71},"\u002Fdocs\u002Fremote-control","Bitfocus Companion",[32,74,75],{},"Importer et exporter un soundboard complet pour le partager",[32,77,78],{},"Utiliser des GIF ou des images sur les boutons de son",[24,80,82],{"id":81},"licence","Licence",[14,84,85,86,92],{},"SoundNinja est un logiciel libre sous ",[69,87,91],{"href":88,"rel":89},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fblob\u002Fmain\u002FLICENSE",[90],"nofollow","GPL-3.0",". Forke-le, modifie-le, partage-le.",[24,94,96],{"id":95},"prochaines-étapes","Prochaines étapes",[98,99,100,106,112],"ol",{},[32,101,102],{},[69,103,105],{"href":104},"\u002Fdocs\u002Finstallation","Installer SoundNinja",[32,107,108],{},[69,109,111],{"href":110},"\u002Fdocs\u002Fadding-sounds","Ajouter des sons",[32,113,114],{},[69,115,117],{"href":116},"\u002Fdocs\u002Forganizing-sounds","Organiser ton board",{"title":119,"searchDepth":120,"depth":120,"links":121},"",2,[122,123,124,125],{"id":26,"depth":120,"text":27},{"id":46,"depth":120,"text":47},{"id":81,"depth":120,"text":82},{"id":95,"depth":120,"text":96},"Ce qu’est SoundNinja et ce que tu peux en faire.","md",{},true,1,"\u002Foverview",{"title":5,"description":126},"overview","ZY8wtO0KcJ2GGKh9NDik0dGVB6QXrk3FQ-5mCb0D4-8",[136,212,413,561,716,852,995,1217],{"id":4,"title":5,"body":137,"description":126,"extension":127,"meta":210,"navigation":129,"order":130,"path":131,"seo":211,"stem":133,"__hash__":134},{"type":7,"value":138,"toc":204},[139,141,143,145,147,149,159,161,181,183,188,190],[10,140,5],{"id":12},[14,142,16],{},[14,144,19],{},[14,146,22],{},[24,148,27],{"id":26},[29,150,151,153,155,157],{},[32,152,34],{},[32,154,37],{},[32,156,40],{},[32,158,43],{},[24,160,47],{"id":46},[29,162,163,165,167,169,171,173,177,179],{},[32,164,52],{},[32,166,55],{},[32,168,58],{},[32,170,61],{},[32,172,64],{},[32,174,67,175],{},[69,176,72],{"href":71},[32,178,75],{},[32,180,78],{},[24,182,82],{"id":81},[14,184,85,185,92],{},[69,186,91],{"href":88,"rel":187},[90],[24,189,96],{"id":95},[98,191,192,196,200],{},[32,193,194],{},[69,195,105],{"href":104},[32,197,198],{},[69,199,111],{"href":110},[32,201,202],{},[69,203,117],{"href":116},{"title":119,"searchDepth":120,"depth":120,"links":205},[206,207,208,209],{"id":26,"depth":120,"text":27},{"id":46,"depth":120,"text":47},{"id":81,"depth":120,"text":82},{"id":95,"depth":120,"text":96},{},{"title":5,"description":126},{"id":213,"title":214,"body":215,"description":408,"extension":127,"meta":409,"navigation":129,"order":120,"path":410,"seo":411,"stem":219,"__hash__":412},"content_fr\u002Finstallation.md","Installation",{"type":7,"value":216,"toc":401},[217,220,234,238,257,260,264,278,281,285,310,321,325,332,336,351,381,397],[10,218,214],{"id":219},"installation",[14,221,222,223,227,228,233],{},"Récupère un build sur la ",[69,224,226],{"href":225},"\u002Fdownload","page Télécharger"," ou sur ",[69,229,232],{"href":230,"rel":231},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Freleases\u002Flatest",[90],"GitHub Releases",". SoundNinja est en développement précoce — traite les builds comme des bêtas.",[24,235,237],{"id":236},"windows","Windows",[29,239,240,251,254],{},[32,241,242,246,247,250],{},[243,244,245],"strong",{},"Installateur (.exe)"," ou ",[243,248,249],{},"MSI (.msi)"," pour Windows 64 bits",[32,252,253],{},"Cible de la landing page : Windows 10 et plus",[32,255,256],{},"Le README de l’app mentionne aussi Windows 8 et supérieur",[14,258,259],{},"Lance l’installateur, puis ouvre SoundNinja depuis le menu Démarrer.",[24,261,263],{"id":262},"macos","macOS",[29,265,266,272,275],{},[32,267,268,271],{},[243,269,270],{},".dmg universel"," pour Apple Silicon et Intel",[32,273,274],{},"Cible de la landing page : macOS 10.14 et plus",[32,276,277],{},"Le README de l’app mentionne macOS 10.15 et supérieur",[14,279,280],{},"Ouvre l’image disque et glisse SoundNinja dans Applications.",[24,282,284],{"id":283},"linux","Linux",[29,286,287,293,299,307],{},[32,288,289,292],{},[243,290,291],{},"Debian (.deb)"," pour Ubuntu \u002F Debian",[32,294,295,298],{},[243,296,297],{},"AppImage"," pour les autres distros",[32,300,301,302,306],{},"Après publication d’une release, les utilisateurs Arch peuvent installer ",[303,304,305],"code",{},"soundninja-bin"," depuis l’AUR",[32,308,309],{},"Testé sur Ubuntu 20.04",[14,311,312,313,316,317,320],{},"Les builds desktop ont besoin des paquets WebKit et GTK. Sous Debian\u002FUbuntu, ça veut souvent dire ",[303,314,315],{},"libwebkit2gtk",", ",[303,318,319],{},"libgtk-3-0"," et une bibliothèque app-indicator.",[24,322,324],{"id":323},"mises-à-jour","Mises à jour",[14,326,327,328,331],{},"Dans l’app, ouvre ",[243,329,330],{},"Aide → Rechercher les mises à jour",". Tu peux aussi laisser SoundNinja vérifier au démarrage dans les Paramètres.",[24,333,335],{"id":334},"compiler-depuis-les-sources","Compiler depuis les sources",[14,337,338,339,344,345,350],{},"Besoin d’un build custom ? Clone ",[69,340,343],{"href":341,"rel":342},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja",[90],"le repo",", installe les ",[69,346,349],{"href":347,"rel":348},"https:\u002F\u002Fv2.tauri.app\u002Fstart\u002Fprerequisites\u002F",[90],"prérequis Tauri",", puis :",[352,353,357],"pre",{"className":354,"code":355,"language":356,"meta":119,"style":119},"language-bash shiki shiki-themes github-light github-dark","bun install\nbun run tauri:serve\n","bash",[303,358,359,371],{"__ignoreMap":119},[360,361,363,367],"span",{"class":362,"line":130},"line",[360,364,366],{"class":365},"sScJk","bun",[360,368,370],{"class":369},"sZZnC"," install\n",[360,372,373,375,378],{"class":362,"line":120},[360,374,366],{"class":365},[360,376,377],{"class":369}," run",[360,379,380],{"class":369}," tauri:serve\n",[14,382,383,316,386,246,389,392,393,396],{},[303,384,385],{},"npm",[303,387,388],{},"pnpm",[303,390,391],{},"deno"," marchent aussi. Build de production : ",[303,394,395],{},"bun run tauri:build",".",[398,399,400],"style",{},"html pre.shiki code .sScJk, html code.shiki .sScJk{--shiki-default:#6F42C1;--shiki-dark:#B392F0}html pre.shiki code .sZZnC, html code.shiki .sZZnC{--shiki-default:#032F62;--shiki-dark:#9ECBFF}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html.dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}",{"title":119,"searchDepth":120,"depth":120,"links":402},[403,404,405,406,407],{"id":236,"depth":120,"text":237},{"id":262,"depth":120,"text":263},{"id":283,"depth":120,"text":284},{"id":323,"depth":120,"text":324},{"id":334,"depth":120,"text":335},"Installe SoundNinja sur Windows, macOS ou Linux.",{},"\u002Finstallation",{"title":214,"description":408},"pbEgfObzQ57hJHQ_Y3qGhgX0zLihiW_l6ZrgNA2lCO8",{"id":414,"title":111,"body":415,"description":554,"extension":127,"meta":555,"navigation":129,"order":556,"path":557,"seo":558,"stem":559,"__hash__":560},"content_fr\u002Fadding-sounds.md",{"type":7,"value":416,"toc":546},[417,420,423,427,446,450,481,485,504,508,522,525,529,536,540],[10,418,111],{"id":419},"ajouter-des-sons",[14,421,422],{},"Un board reste vide tant que tu n’ajoutes pas de clips. SoundNinja peut importer des fichiers, des dossiers entiers, un enregistrement ou un pack de soundboard partagé.",[24,424,426],{"id":425},"importer-des-fichiers-audio","Importer des fichiers audio",[98,428,429,440,443],{},[32,430,431,432,435,436,439],{},"Ouvre ",[243,433,434],{},"Fichier → Importer des fichiers audio",", ou utilise ",[243,437,438],{},"Importer"," dans la barre de navigation.",[32,441,442],{},"Choisis un ou plusieurs fichiers audio.",[32,444,445],{},"Les sons arrivent dans l’onglet actuel.",[24,447,449],{"id":448},"importer-des-dossiers","Importer des dossiers",[98,451,452,461,464],{},[32,453,431,454,457,458,460],{},[243,455,456],{},"Fichier → Importer des dossiers"," (ou ",[243,459,449],{}," dans la barre de navigation).",[32,462,463],{},"Ajoute un ou plusieurs dossiers. Glisse pour les réordonner avant l’import.",[32,465,466,467],{},"Choisis comment ils arrivent :\n",[29,468,469,475],{},[32,470,471,474],{},[243,472,473],{},"Importer comme onglets"," — chaque dossier devient son propre onglet",[32,476,477,480],{},[243,478,479],{},"Importer dans l’onglet actuel"," — chaque fichier va dans l’onglet actif",[24,482,484],{"id":483},"enregistrer-un-clip","Enregistrer un clip",[14,486,487,488,492,493,496,497,246,500,503],{},"Ouvre le ",[69,489,491],{"href":490},"\u002Fdocs\u002Frecording-editor","Record Editor"," depuis le bouton ",[243,494,495],{},"Enregistrer"," dans la barre du lecteur. Capture, coupe, puis ",[243,498,499],{},"Importer la sélection",[243,501,502],{},"Tout importer"," dans l’onglet actuel ou un onglet que tu choisis.",[24,505,507],{"id":506},"importer-un-soundboard","Importer un soundboard",[14,509,510,513,514,517,518,521],{},[243,511,512],{},"Fichier → Importer un soundboard"," charge un pack partagé. Les packs sont un ",[303,515,516],{},".zip"," qui contient ",[303,519,520],{},"project.sninja"," plus les fichiers audio. Après l’import, ouvre le projet et joue.",[14,523,524],{},"Tu peux aussi garder plusieurs projets (profils). Utilise le sélecteur de projet pour changer de board.",[24,526,528],{"id":527},"relier-les-fichiers-manquants","Relier les fichiers manquants",[14,530,531,532,535],{},"Si des fichiers audio bougent sur le disque, SoundNinja affiche ",[243,533,534],{},"Fichiers audio manquants",". Choisis un dossier à parcourir et relie les clips.",[24,537,539],{"id":538},"suite","Suite",[14,541,542,543,396],{},"Organise onglets, groupes et raccourcis dans ",[69,544,545],{"href":116},"Organiser les sons",{"title":119,"searchDepth":120,"depth":120,"links":547},[548,549,550,551,552,553],{"id":425,"depth":120,"text":426},{"id":448,"depth":120,"text":449},{"id":483,"depth":120,"text":484},{"id":506,"depth":120,"text":507},{"id":527,"depth":120,"text":528},{"id":538,"depth":120,"text":539},"Importe de l’audio, des dossiers, des enregistrements et des soundboards partagés.",{},3,"\u002Fadding-sounds",{"title":111,"description":554},"adding-sounds","WxjyAOY51Jh80jxw4Xvj7Ko_IY_wVuHJST0KFUWSZ9k",{"id":562,"title":545,"body":563,"description":709,"extension":127,"meta":710,"navigation":129,"order":711,"path":712,"seo":713,"stem":714,"__hash__":715},"content_fr\u002Forganizing-sounds.md",{"type":7,"value":564,"toc":700},[565,568,571,575,602,609,613,616,630,637,641,647,651,662,666,669,673,676,682,688,692],[10,566,545],{"id":567},"organiser-les-sons",[14,569,570],{},"SoundNinja est conçu pour les grandes bibliothèques. Utilise les onglets, les groupes, la recherche et les raccourcis pour que le clip dont tu as besoin soit à un clic (ou une touche) près.",[24,572,574],{"id":573},"onglets","Onglets",[29,576,577,584,591],{},[32,578,579,580,583],{},"Ajoute un onglet avec ",[243,581,582],{},"Ajouter un onglet",". Donne-lui une couleur pour scanner la barre vite.",[32,585,586,587,590],{},"La vue ",[243,588,589],{},"Tous"," montre chaque son à travers les onglets.",[32,592,593,594,597,598,601],{},"Un son peut appartenir à ",[243,595,596],{},"un ou plusieurs onglets",". Clic droit sur un son et utilise ",[243,599,600],{},"Déplacer vers l’onglet"," pour l’assigner.",[14,603,604,605,608],{},"Les transitions d’onglets sont dans ",[243,606,607],{},"Paramètres → Général"," : Slide, Fade, Boutons un par un, ou Aucune.",[24,610,612],{"id":611},"groupes","Groupes",[14,614,615],{},"Depuis la v0.5.3, les séparateurs peuvent devenir des groupes nommés :",[29,617,618,621,624,627],{},[32,619,620],{},"Ajouter, renommer ou supprimer un groupe depuis le menu contextuel",[32,622,623],{},"Glisser l’en-tête du groupe — les enfants suivent",[32,625,626],{},"Déposer des sons dans un groupe ou les en sortir",[32,628,629],{},"Régler la couleur de bordure, la couleur du nom et l’alignement des boutons (ou utiliser le défaut de l’onglet)",[14,631,632,633,636],{},"Tu peux toujours ajouter un ",[243,634,635],{},"Séparateur"," simple si tu as seulement besoin d’une coupure visuelle.",[24,638,640],{"id":639},"recherche","Recherche",[14,642,643,644,646],{},"Utilise le champ ",[243,645,640],{}," dans la barre de navigation. Les résultats se mettent à jour pendant que tu tapes.",[24,648,650],{"id":649},"réordonner","Réordonner",[14,652,653,654,657,658,661],{},"Active le glisser-déposer dans ",[243,655,656],{},"Paramètres → Comportement"," (",[243,659,660],{},"Autoriser le réordonnancement","). Puis glisse sons et groupes en place.",[24,663,665],{"id":664},"édition-groupée","Édition groupée",[14,667,668],{},"Sélectionne plusieurs sons, puis change la couleur, déplace-les vers un onglet ou supprime-les en une étape.",[24,670,672],{"id":671},"raccourcis-et-ids-de-son","Raccourcis et IDs de son",[14,674,675],{},"Chaque son a un ID de 8 caractères. Copie-le depuis le menu contextuel du bouton ou la puce d’ID de la sélection multiple.",[14,677,431,678,681],{},[243,679,680],{},"Paramètres → Raccourcis"," pour lier une touche à un ID de son. Les raccourcis globaux sont optionnels.",[14,683,684,685,687],{},"Le même ID est ce que ",[69,686,72],{"href":71}," utilise pour déclencher un clip.",[24,689,691],{"id":690},"gifs-et-couleurs","GIFs et couleurs",[14,693,694,695,699],{},"Clic droit sur un son pour régler des couleurs par bouton ou un fond GIF \u002F image. C’est séparé du ",[69,696,698],{"href":697},"\u002Fdocs\u002Ftheme-editor","Theme Creator",", qui habille tout le board.",{"title":119,"searchDepth":120,"depth":120,"links":701},[702,703,704,705,706,707,708],{"id":573,"depth":120,"text":574},{"id":611,"depth":120,"text":612},{"id":639,"depth":120,"text":640},{"id":649,"depth":120,"text":650},{"id":664,"depth":120,"text":665},{"id":671,"depth":120,"text":672},{"id":690,"depth":120,"text":691},"Onglets, groupes, recherche, édition groupée et raccourcis.",{},4,"\u002Forganizing-sounds",{"title":545,"description":709},"organizing-sounds","s3oaYG46DStsSAtCx2-Sgrn_LoxScaKkOmEWwKlXmKQ",{"id":717,"title":718,"body":719,"description":845,"extension":127,"meta":846,"navigation":129,"order":847,"path":848,"seo":849,"stem":850,"__hash__":851},"content_fr\u002Ftheme-editor.md","Éditeur de thème",{"type":7,"value":720,"toc":839},[721,724,730,734,761,764,768,782,786,812,815,819,825],[10,722,718],{"id":723},"éditeur-de-thème",[14,725,726,727,396],{},"Le Theme Creator est l’éditeur visuel complet de ton board. Ouvre-le depuis ",[243,728,729],{},"Paramètres → Général → Theme Creator",[24,731,733],{"id":732},"trois-onglets","Trois onglets",[98,735,736,750,756],{},[32,737,738,741,742,745,746,749],{},[243,739,740],{},"Général"," — nom du thème, couleurs partagées et import de polices (",[303,743,744],{},".ttf"," \u002F ",[303,747,748],{},".otf",")",[32,751,752,755],{},[243,753,754],{},"Boutons"," — couleurs, typo, disposition et overlay GIF des boutons de son",[32,757,758,760],{},[243,759,574],{}," — couleurs, typo et épaisseur de bordure de la barre d’onglets",[14,762,763],{},"Un aperçu en direct montre onglets et boutons pendant que tu édites.",[24,765,767],{"id":766},"ce-que-tu-peux-changer","Ce que tu peux changer",[29,769,770,773,776,779],{},[32,771,772],{},"Couleurs primaire et d’accent, fonds, couleurs des boutons, couleurs des onglets",[32,774,775],{},"Famille et taille de police des boutons et des onglets",[32,777,778],{},"Largeur, rayon, bordure, écarts et padding des boutons",[32,780,781],{},"Opacité de l’overlay GIF (normal et survol)",[24,783,785],{"id":784},"enregistrer-et-partager","Enregistrer et partager",[29,787,788,794,800,806],{},[32,789,790,793],{},[243,791,792],{},"Exporter .css"," — écrire un fichier de thème à sauvegarder ou envoyer à un ami",[32,795,796,799],{},[243,797,798],{},"Ajouter aux thèmes"," — enregistrer le fichier dans ton dossier Themes et l’appliquer",[32,801,802,805],{},[243,803,804],{},"Importer .css"," — charger un preset intégré ou un thème enregistré",[32,807,808,811],{},[243,809,810],{},"Réinitialiser"," — revenir aux défauts SoundNinja",[14,813,814],{},"Si tu fermes la fenêtre avec des changements non enregistrés, SoundNinja te demande d’enregistrer d’abord.",[24,816,818],{"id":817},"sans-léditeur-complet","Sans l’éditeur complet",[14,820,821,822,824],{},"Dans ",[243,823,607],{}," tu peux toujours :",[29,826,827,830,836],{},[32,828,829],{},"Choisir un thème dans la liste",[32,831,832,833,749],{},"Éditer les variables CSS en direct (",[243,834,835],{},"CSS personnalisé",[32,837,838],{},"Importer un fichier de thème dans le dossier Themes",{"title":119,"searchDepth":120,"depth":120,"links":840},[841,842,843,844],{"id":732,"depth":120,"text":733},{"id":766,"depth":120,"text":767},{"id":784,"depth":120,"text":785},{"id":817,"depth":120,"text":818},"Concevoir couleurs, polices, boutons et onglets dans le Theme Creator.",{},5,"\u002Ftheme-editor",{"title":718,"description":845},"theme-editor","wkR6rxJNnSmcJeJxDdslCOIyK7-9BblSMG_tJA6IwRY",{"id":853,"title":854,"body":855,"description":988,"extension":127,"meta":989,"navigation":129,"order":990,"path":991,"seo":992,"stem":993,"__hash__":994},"content_fr\u002Frecording-editor.md","Éditeur d’enregistrement",{"type":7,"value":856,"toc":982},[857,860,866,870,876,896,899,903,928,932,946,950,965,972],[10,858,854],{"id":859},"éditeur-denregistrement",[14,861,862,863,865],{},"Enregistre un clip dans SoundNinja, coupe-le, puis importe-le sur un onglet. Ouvre l’