[{"data":1,"prerenderedAt":1605},["ShallowReactive",2],{"docs-page-fr-\u002Foverview":3,"docs-nav-fr":144},{"id":4,"title":5,"body":6,"description":135,"extension":136,"meta":137,"navigation":138,"order":139,"path":140,"seo":141,"stem":142,"__hash__":143},"content_fr\u002Foverview.md","Aperçu",{"type":7,"value":8,"toc":127},"minimark",[9,13,17,20,23,28,44,48,88,92,102,106],[10,11,5],"h1",{"id":12},"aperçu",[14,15,16],"p",{},"SoundNinja est un soundboard open source pour le live streaming, les discussions entre amis et l’enregistrement de podcasts. Il est construit avec Tauri v2 et Nuxt 4 pour rester léger en RAM et sur le disque.",[14,18,19],{},"Le but est simple : garder une énorme bibliothèque de sons facile à parcourir, puis jouer le bon clip en quelques millisecondes. L’interface marche aussi comme tableau de bord en VR.",[14,21,22],{},"SoundNinja est encore en développement précoce. Les fonctions marchent, mais toutes les plateformes ne sont pas entièrement testées.",[24,25,27],"h2",{"id":26},"pour-qui","Pour qui",[29,30,31,35,38,41],"ul",{},[32,33,34],"li",{},"Les streameurs qui ont besoin de cues sonores instantanés",[32,36,37],{},"Les amis qui veulent un board partagé pour le vocal",[32,39,40],{},"Les podcasteurs qui enregistrent des clips et les posent sur un board",[32,42,43],{},"Quiconque veut un soundboard personnalisable et local-first",[24,45,47],{"id":46},"ce-que-tu-peux-faire","Ce que tu peux faire",[29,49,50,53,56,59,62,65,68,71,74,82,85],{},[32,51,52],{},"Construire un soundboard à partir de tes propres fichiers audio",[32,54,55],{},"Organiser les sons dans des onglets colorés, des groupes, des tags et la recherche",[32,57,58],{},"Filtrer par tags (OU) et trier par nom, date, durée ou taille",[32,60,61],{},"Sélection multiple avec rectangle ou plage Maj, puis couleur, déplacement ou suppression en lot",[32,63,64],{},"Régler le volume par son depuis le menu contextuel",[32,66,67],{},"Concevoir le look avec le Theme Creator",[32,69,70],{},"Enregistrer l’audio du PC ou un micro dans le Record Editor",[32,72,73],{},"Assigner des raccourcis à des sons individuels",[32,75,76,77],{},"Déclencher des sons depuis ",[78,79,81],"a",{"href":80},"\u002Fdocs\u002Fremote-control","Bitfocus Companion",[32,83,84],{},"Importer et exporter un soundboard complet pour le partager",[32,86,87],{},"Utiliser des GIF ou des images sur les boutons — bibliothèque de dossiers locale ou KLIPY",[24,89,91],{"id":90},"licence","Licence",[14,93,94,95,101],{},"SoundNinja est un logiciel libre sous ",[78,96,100],{"href":97,"rel":98},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fblob\u002Fmain\u002FLICENSE",[99],"nofollow","GPL-3.0",". Forke-le, modifie-le, partage-le.",[24,103,105],{"id":104},"prochaines-étapes","Prochaines étapes",[107,108,109,115,121],"ol",{},[32,110,111],{},[78,112,114],{"href":113},"\u002Fdocs\u002Finstallation","Installer SoundNinja",[32,116,117],{},[78,118,120],{"href":119},"\u002Fdocs\u002Fadding-sounds","Ajouter des sons",[32,122,123],{},[78,124,126],{"href":125},"\u002Fdocs\u002Forganizing-sounds","Organiser ton board",{"title":128,"searchDepth":129,"depth":129,"links":130},"",2,[131,132,133,134],{"id":26,"depth":129,"text":27},{"id":46,"depth":129,"text":47},{"id":90,"depth":129,"text":91},{"id":104,"depth":129,"text":105},"Ce qu’est SoundNinja et ce que tu peux en faire.","md",{},true,1,"\u002Foverview",{"title":5,"description":135},"overview","nBakDXsUbMnm0zyn8m6jAooziqocGWiZV3EwAtrg0xk",[145,227,452,600,1003,1139,1286,1508],{"id":4,"title":5,"body":146,"description":135,"extension":136,"meta":225,"navigation":138,"order":139,"path":140,"seo":226,"stem":142,"__hash__":143},{"type":7,"value":147,"toc":219},[148,150,152,154,156,158,168,170,196,198,203,205],[10,149,5],{"id":12},[14,151,16],{},[14,153,19],{},[14,155,22],{},[24,157,27],{"id":26},[29,159,160,162,164,166],{},[32,161,34],{},[32,163,37],{},[32,165,40],{},[32,167,43],{},[24,169,47],{"id":46},[29,171,172,174,176,178,180,182,184,186,188,192,194],{},[32,173,52],{},[32,175,55],{},[32,177,58],{},[32,179,61],{},[32,181,64],{},[32,183,67],{},[32,185,70],{},[32,187,73],{},[32,189,76,190],{},[78,191,81],{"href":80},[32,193,84],{},[32,195,87],{},[24,197,91],{"id":90},[14,199,94,200,101],{},[78,201,100],{"href":97,"rel":202},[99],[24,204,105],{"id":104},[107,206,207,211,215],{},[32,208,209],{},[78,210,114],{"href":113},[32,212,213],{},[78,214,120],{"href":119},[32,216,217],{},[78,218,126],{"href":125},{"title":128,"searchDepth":129,"depth":129,"links":220},[221,222,223,224],{"id":26,"depth":129,"text":27},{"id":46,"depth":129,"text":47},{"id":90,"depth":129,"text":91},{"id":104,"depth":129,"text":105},{},{"title":5,"description":135},{"id":228,"title":229,"body":230,"description":447,"extension":136,"meta":448,"navigation":138,"order":129,"path":449,"seo":450,"stem":234,"__hash__":451},"content_fr\u002Finstallation.md","Installation",{"type":7,"value":231,"toc":440},[232,235,249,253,275,278,282,296,299,303,328,339,343,350,354,369,399,415,436],[10,233,229],{"id":234},"installation",[14,236,237,238,242,243,248],{},"Récupère un build sur la ",[78,239,241],{"href":240},"\u002Fdownload","page Télécharger"," ou sur ",[78,244,247],{"href":245,"rel":246},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Freleases\u002Flatest",[99],"GitHub Releases",". SoundNinja est en développement précoce — traite les builds comme des bêtas.",[24,250,252],{"id":251},"windows","Windows",[29,254,255,266,269,272],{},[32,256,257,261,262,265],{},[258,259,260],"strong",{},"Installateur (.exe)"," ou ",[258,263,264],{},"MSI (.msi)"," pour Windows 64 bits",[32,267,268],{},"Cible de la landing page : Windows 10 et plus",[32,270,271],{},"Le README de l’app mentionne aussi Windows 8 et supérieur",[32,273,274],{},"L’installateur NSIS est sombre. Choisis une langue à l’installation — SoundNinja la retient au prochain lancement.",[14,276,277],{},"Lance l’installateur, puis ouvre SoundNinja depuis le menu Démarrer.",[24,279,281],{"id":280},"macos","macOS",[29,283,284,290,293],{},[32,285,286,289],{},[258,287,288],{},".dmg universel"," pour Apple Silicon et Intel",[32,291,292],{},"Cible de la landing page : macOS 10.14 et plus",[32,294,295],{},"Le README de l’app mentionne macOS 10.15 et supérieur",[14,297,298],{},"Ouvre l’image disque et glisse SoundNinja dans Applications.",[24,300,302],{"id":301},"linux","Linux",[29,304,305,311,317,325],{},[32,306,307,310],{},[258,308,309],{},"Debian (.deb)"," pour Ubuntu \u002F Debian",[32,312,313,316],{},[258,314,315],{},"AppImage"," pour les autres distros",[32,318,319,320,324],{},"Après publication d’une release, les utilisateurs Arch peuvent installer ",[321,322,323],"code",{},"soundninja-bin"," depuis l’AUR",[32,326,327],{},"Testé sur Ubuntu 20.04",[14,329,330,331,334,335,338],{},"Les builds desktop ont besoin des paquets WebKit et GTK. Sous Debian\u002FUbuntu, ça veut souvent dire ",[321,332,333],{},"libwebkit2gtk",", ",[321,336,337],{},"libgtk-3-0"," et une bibliothèque app-indicator.",[24,340,342],{"id":341},"mises-à-jour","Mises à jour",[14,344,345,346,349],{},"Dans l’app, ouvre ",[258,347,348],{},"Aide → Rechercher les mises à jour",". Tu peux aussi laisser SoundNinja vérifier au démarrage dans les Paramètres.",[24,351,353],{"id":352},"compiler-depuis-les-sources","Compiler depuis les sources",[14,355,356,357,362,363,368],{},"Besoin d’un build custom ? Clone ",[78,358,361],{"href":359,"rel":360},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja",[99],"le repo",", installe les ",[78,364,367],{"href":365,"rel":366},"https:\u002F\u002Fv2.tauri.app\u002Fstart\u002Fprerequisites\u002F",[99],"prérequis Tauri",", puis :",[370,371,375],"pre",{"className":372,"code":373,"language":374,"meta":128,"style":128},"language-bash shiki shiki-themes github-light github-dark","bun install\nbun run tauri:serve\n","bash",[321,376,377,389],{"__ignoreMap":128},[378,379,381,385],"span",{"class":380,"line":139},"line",[378,382,384],{"class":383},"sScJk","bun",[378,386,388],{"class":387},"sZZnC"," install\n",[378,390,391,393,396],{"class":380,"line":129},[378,392,384],{"class":383},[378,394,395],{"class":387}," run",[378,397,398],{"class":387}," tauri:serve\n",[14,400,401,334,404,261,407,410,411,414],{},[321,402,403],{},"npm",[321,405,406],{},"pnpm",[321,408,409],{},"deno"," marchent aussi. Build de production : ",[321,412,413],{},"bun run tauri:build",".",[14,416,417,420,421,426,427,430,431,414],{},[258,418,419],{},"Windows uniquement :"," chaque compile Windows inclut ASIO via le ",[78,422,425],{"href":423,"rel":424},"https:\u002F\u002Fwww.steinberg.net\u002Fasiosdk",[99],"Steinberg ASIO SDK",". Lance ",[321,428,429],{},"bun run setup:asio"," une fois (SDK pas dans git). Linux et macOS utilisent PipeWire \u002F Core Audio — ignore cette étape. Détails : ",[78,432,435],{"href":433,"rel":434},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fblob\u002Fmain\u002Fdocs\u002Fbuild-from-source.md",[99],"build-from-source.md",[437,438,439],"style",{},"html pre.shiki code .sScJk, html code.shiki .sScJk{--shiki-default:#6F42C1;--shiki-dark:#B392F0}html pre.shiki code .sZZnC, html code.shiki .sZZnC{--shiki-default:#032F62;--shiki-dark:#9ECBFF}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html.dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}",{"title":128,"searchDepth":129,"depth":129,"links":441},[442,443,444,445,446],{"id":251,"depth":129,"text":252},{"id":280,"depth":129,"text":281},{"id":301,"depth":129,"text":302},{"id":341,"depth":129,"text":342},{"id":352,"depth":129,"text":353},"Installe SoundNinja sur Windows, macOS ou Linux.",{},"\u002Finstallation",{"title":229,"description":447},"FOJJDNBAT_xV14QaxG490DTpeNiFpVDRFz_XEdyJKJE",{"id":453,"title":120,"body":454,"description":593,"extension":136,"meta":594,"navigation":138,"order":595,"path":596,"seo":597,"stem":598,"__hash__":599},"content_fr\u002Fadding-sounds.md",{"type":7,"value":455,"toc":585},[456,459,462,466,485,489,520,524,543,547,561,564,568,575,579],[10,457,120],{"id":458},"ajouter-des-sons",[14,460,461],{},"Un board reste vide tant que tu n’ajoutes pas de clips. SoundNinja peut importer des fichiers, des dossiers entiers, un enregistrement ou un pack de soundboard partagé.",[24,463,465],{"id":464},"importer-des-fichiers-audio","Importer des fichiers audio",[107,467,468,479,482],{},[32,469,470,471,474,475,478],{},"Ouvre ",[258,472,473],{},"Fichier → Importer des fichiers audio",", ou utilise ",[258,476,477],{},"Importer"," dans la barre de navigation.",[32,480,481],{},"Choisis un ou plusieurs fichiers audio.",[32,483,484],{},"Les sons arrivent dans l’onglet actuel.",[24,486,488],{"id":487},"importer-des-dossiers","Importer des dossiers",[107,490,491,500,503],{},[32,492,470,493,496,497,499],{},[258,494,495],{},"Fichier → Importer des dossiers"," (ou ",[258,498,488],{}," dans la barre de navigation).",[32,501,502],{},"Ajoute un ou plusieurs dossiers. Glisse pour les réordonner avant l’import.",[32,504,505,506],{},"Choisis comment ils arrivent :\n",[29,507,508,514],{},[32,509,510,513],{},[258,511,512],{},"Importer comme onglets"," — chaque dossier devient son propre onglet",[32,515,516,519],{},[258,517,518],{},"Importer dans l’onglet actuel"," — chaque fichier va dans l’onglet actif",[24,521,523],{"id":522},"enregistrer-un-clip","Enregistrer un clip",[14,525,526,527,531,532,535,536,261,539,542],{},"Ouvre le ",[78,528,530],{"href":529},"\u002Fdocs\u002Frecording-editor","Record Editor"," depuis le bouton ",[258,533,534],{},"Enregistrer"," dans la barre du lecteur. Capture, coupe, puis ",[258,537,538],{},"Importer la sélection",[258,540,541],{},"Tout importer"," dans l’onglet actuel ou un onglet que tu choisis.",[24,544,546],{"id":545},"importer-un-soundboard","Importer un soundboard",[14,548,549,552,553,556,557,560],{},[258,550,551],{},"Fichier → Importer un soundboard"," charge un pack partagé. Les packs sont un ",[321,554,555],{},".zip"," qui contient ",[321,558,559],{},"project.sninja"," plus les fichiers audio. Après l’import, ouvre le projet et joue.",[14,562,563],{},"Tu peux aussi garder plusieurs projets (profils). Utilise le sélecteur de projet pour changer de board.",[24,565,567],{"id":566},"relier-les-fichiers-manquants","Relier les fichiers manquants",[14,569,570,571,574],{},"Si des fichiers audio bougent sur le disque, SoundNinja affiche ",[258,572,573],{},"Fichiers audio manquants",". Choisis un dossier à parcourir et relie les clips.",[24,576,578],{"id":577},"suite","Suite",[14,580,581,582,414],{},"Organise onglets, tags, filtres et raccourcis dans ",[78,583,584],{"href":125},"Organiser les sons",{"title":128,"searchDepth":129,"depth":129,"links":586},[587,588,589,590,591,592],{"id":464,"depth":129,"text":465},{"id":487,"depth":129,"text":488},{"id":522,"depth":129,"text":523},{"id":545,"depth":129,"text":546},{"id":566,"depth":129,"text":567},{"id":577,"depth":129,"text":578},"Importe de l’audio, des dossiers, des enregistrements et des soundboards partagés.",{},3,"\u002Fadding-sounds",{"title":120,"description":593},"adding-sounds","4l04_lLfE4dqOPh8H0Rav69GnvCVi_PKTEgAepysTeI",{"id":601,"title":584,"body":602,"description":996,"extension":136,"meta":997,"navigation":138,"order":998,"path":999,"seo":1000,"stem":1001,"__hash__":1002},"content_fr\u002Forganizing-sounds.md",{"type":7,"value":603,"toc":981},[604,607,614,618,645,652,656,659,673,680,686,690,700,705,737,741,747,751,784,790,794,797,823,826,830,843,847,853,874,890,897,901,912,915,919,926,936,942,946,954,961,978],[10,605,584],{"id":606},"organiser-les-sons",[14,608,609,610,613],{},"SoundNinja est conçu pour les grandes bibliothèques. ",[258,611,612],{},"Tags et filtres",", onglets, recherche, sélection multiple et raccourcis — le clip dont tu as besoin est à un clic (ou une touche) près.",[24,615,617],{"id":616},"onglets","Onglets",[29,619,620,627,634],{},[32,621,622,623,626],{},"Ajoute un onglet avec ",[258,624,625],{},"Ajouter un onglet",". Donne-lui une couleur pour scanner la barre vite.",[32,628,629,630,633],{},"La vue ",[258,631,632],{},"Tous"," montre chaque son à travers les onglets.",[32,635,636,637,640,641,644],{},"Un son peut appartenir à ",[258,638,639],{},"un ou plusieurs onglets",". Clic droit sur un son et utilise ",[258,642,643],{},"Déplacer vers l’onglet"," pour l’assigner.",[14,646,647,648,651],{},"Les transitions d’onglets sont dans ",[258,649,650],{},"Paramètres → Général"," : Slide, Fade, Boutons un par un, ou Aucune.",[24,653,655],{"id":654},"groupes","Groupes",[14,657,658],{},"Depuis la v0.5.3, les séparateurs peuvent devenir des groupes nommés :",[29,660,661,664,667,670],{},[32,662,663],{},"Ajouter, renommer ou supprimer un groupe depuis le menu contextuel",[32,665,666],{},"Glisser l’en-tête du groupe — les enfants suivent",[32,668,669],{},"Déposer des sons dans un groupe ou les en sortir",[32,671,672],{},"Régler la couleur de bordure, la couleur du nom et l’alignement des boutons (ou utiliser le défaut de l’onglet)",[14,674,675,676,679],{},"Tu peux toujours ajouter un ",[258,677,678],{},"Séparateur"," simple si tu as seulement besoin d’une coupure visuelle.",[14,681,682,683,414],{},"Clic droit sur l’espace vide du board pour ",[258,684,685],{},"Ajouter un groupe",[24,687,689],{"id":688},"tags-filtres","Tags \u002F Filtres",[14,691,692,693,696,697,699],{},"Les tags traversent les onglets. Le panneau ",[258,694,695],{},"Filtre"," (barre latérale ",[258,698,695],{},") sert à les créer et à filtrer le board.",[701,702,704],"h3",{"id":703},"créer-et-modifier-des-tags","Créer et modifier des tags",[107,706,707,712,723,730],{},[32,708,470,709,711],{},[258,710,695],{}," dans la barre latérale.",[32,713,714,715,718,719,722],{},"Sous ",[258,716,717],{},"Tags",", utilise ",[258,720,721],{},"Ajouter un tag"," — nom et couleur.",[32,724,725,726,729],{},"Renomme, recolore ou ",[258,727,728],{},"Supprimer le tag"," dans la même liste.",[32,731,732,733,736],{},"Si tu vois ",[258,734,735],{},"Aucun tag pour l’instant",", crée-en un ici avant d’assigner.",[701,738,740],{"id":739},"assigner-des-tags-aux-sons","Assigner des tags aux sons",[14,742,743,744,746],{},"Clic droit sur un son → ",[258,745,717],{}," (cases à cocher). Un son peut avoir plusieurs tags. S’il n’y en a encore aucun, le menu pointe vers le panneau filtre.",[701,748,750],{"id":749},"filtrer-le-board","Filtrer le board",[29,752,753,759,770,781],{},[32,754,755,756,414],{},"Active les tags dans le panneau Filtre, ou comme ",[258,757,758],{},"puces sous la barre de recherche",[32,760,761,762,765,766,769],{},"Le match est ",[258,763,764],{},"OU"," : un son reste visible s’il a ",[258,767,768],{},"n’importe quel"," tag sélectionné.",[32,771,772,773,776,777,780],{},"Le champ ",[258,774,775],{},"Recherche"," combine en ",[258,778,779],{},"ET"," avec le filtre de tags actif (saisie + tags ensemble).",[32,782,783],{},"Désactive les puces (ou vide le filtre) pour revoir tout l’onglet.",[14,785,786,787,414],{},"Les noms de tags colorés peuvent apparaître sur les boutons. Active-les dans ",[258,788,789],{},"Paramètres → Comportement → Afficher les badges de tags",[24,791,793],{"id":792},"tri","Tri",[14,795,796],{},"Ouvre le panneau filtre et choisis un mode :",[29,798,799,805],{},[32,800,801,804],{},[258,802,803],{},"Défini par l’utilisateur"," — ton ordre d’onglet, groupes visibles",[32,806,807,334,810,334,813,261,816,819,820],{},[258,808,809],{},"Nom",[258,811,812],{},"Date d’ajout",[258,814,815],{},"Durée de lecture",[258,817,818],{},"Taille de fichier"," — liste plate triée ; ",[258,821,822],{},"les groupes sont masqués",[14,824,825],{},"Le tri par durée peut préchauffer les métadonnées de durée la première fois.",[24,827,829],{"id":828},"réordonner","Réordonner",[14,831,832,833,836,837,840,841,414],{},"Active le glisser-déposer dans ",[258,834,835],{},"Paramètres → Comportement"," (",[258,838,839],{},"Autoriser le réordonnancement","). Puis glisse sons et groupes en place. Le réordonnancement s’applique en tri ",[258,842,803],{},[24,844,846],{"id":845},"sélection-multiple","Sélection multiple",[14,848,849,850,852],{},"Active ",[258,851,846],{}," dans la barre de navigation, puis :",[29,854,855,858,864,871],{},[32,856,857],{},"Clique pour basculer un son",[32,859,860,863],{},[258,861,862],{},"Maj+clic"," pour une plage depuis le dernier ancrage",[32,865,866,867,870],{},"Trace un ",[258,868,869],{},"rectangle"," sur l’espace vide du board",[32,872,873],{},"Clique le board vide (ou à l’extérieur) pour vider la sélection",[14,875,876,877,334,880,334,883,886,887,414],{},"Une barre groupée affiche le compte, plus ",[258,878,879],{},"Couleur",[258,881,882],{},"Déplacer vers l’onglet…",[258,884,885],{},"Supprimer"," et ",[258,888,889],{},"Terminé",[14,891,892,893,896],{},"En sélection multiple, chaque bouton montre une ",[258,894,895],{},"puce d’ID de 8 caractères",". Clic droit sur la puce pour la copier.",[24,898,900],{"id":899},"volume-par-son","Volume par son",[14,902,903,904,907,908,911],{},"Clic droit → ",[258,905,906],{},"Volume",". Glisse le curseur de 0 % à 100 %. ",[258,909,910],{},"Double-clic"," le remet à 100 %.",[14,913,914],{},"Ça se cumule avec le volume de sortie principal dans les Paramètres.",[24,916,918],{"id":917},"raccourcis-et-ids-de-son","Raccourcis et IDs de son",[14,920,921,922,925],{},"Chaque son a un ID de 8 caractères. Copie-le depuis le menu contextuel du bouton (",[258,923,924],{},"Copier l’ID",") ou la puce d’ID de la sélection multiple.",[14,927,470,928,931,932,935],{},[258,929,930],{},"Paramètres → Raccourcis"," pour lier une touche à un ID de son. Les raccourcis globaux sont optionnels. ",[258,933,934],{},"Assigner un raccourci"," dans le menu contextuel y saute avec l’ID déjà rempli.",[14,937,938,939,941],{},"Le même ID est ce que ",[78,940,81],{"href":80}," utilise pour déclencher un clip.",[24,943,945],{"id":944},"images-de-fond-et-couleurs","Images de fond et couleurs",[14,947,948,949,953],{},"Clic droit sur un son pour régler des couleurs par bouton ou une image de fond. C’est séparé du ",[78,950,952],{"href":951},"\u002Fdocs\u002Ftheme-editor","Theme Creator",", qui habille tout le board.",[14,955,956,957,960],{},"Le sélecteur est une boîte ",[258,958,959],{},"Image de fond"," (PNG, JPEG, GIF, WebP) :",[29,962,963,969],{},[32,964,965,968],{},[258,966,967],{},"Fichiers locaux"," — ajouter des dossiers, choisir un fichier, chercher par nom, prévisualiser la grille, retirer un dossier de la bibliothèque",[32,970,971,974,975,977],{},[258,972,973],{},"KLIPY"," — chercher des GIF en ligne. Mets ta propre clé API dans ",[258,976,835],{},". La clé n’est pas stockée dans les fichiers projet.",[14,979,980],{},"Après le choix, recadre et décale l’image sur le bouton.",{"title":128,"searchDepth":129,"depth":129,"links":982},[983,984,985,990,991,992,993,994,995],{"id":616,"depth":129,"text":617},{"id":654,"depth":129,"text":655},{"id":688,"depth":129,"text":689,"children":986},[987,988,989],{"id":703,"depth":595,"text":704},{"id":739,"depth":595,"text":740},{"id":749,"depth":595,"text":750},{"id":792,"depth":129,"text":793},{"id":828,"depth":129,"text":829},{"id":845,"depth":129,"text":846},{"id":899,"depth":129,"text":900},{"id":917,"depth":129,"text":918},{"id":944,"depth":129,"text":945},"Tags, filtres, onglets, groupes, tri, sélection multiple, volume et raccourcis.",{},4,"\u002Forganizing-sounds",{"title":584,"description":996},"organizing-sounds","3ZEh-vX7bLxxdpr56sVGIToyf64-wDiiegH_atr9lbk",{"id":1004,"title":1005,"body":1006,"description":1132,"extension":136,"meta":1133,"navigation":138,"order":1134,"path":1135,"seo":1136,"stem":1137,"__hash__":1138},"content_fr\u002Ftheme-editor.md","Éditeur de thème",{"type":7,"value":1007,"toc":1126},[1008,1011,1017,1021,1048,1051,1055,1069,1073,1099,1102,1106,1112],[10,1009,1005],{"id":1010},"éditeur-de-thème",[14,1012,1013,1014,414],{},"Le Theme Creator est l’éditeur visuel complet de ton board. Ouvre-le depuis ",[258,1015,1016],{},"Paramètres → Général → Theme Creator",[24,1018,1020],{"id":1019},"trois-onglets","Trois onglets",[107,1022,1023,1037,1043],{},[32,1024,1025,1028,1029,1032,1033,1036],{},[258,1026,1027],{},"Général"," — nom du thème, couleurs partagées et import de polices (",[321,1030,1031],{},".ttf"," \u002F ",[321,1034,1035],{},".otf",")",[32,1038,1039,1042],{},[258,1040,1041],{},"Boutons"," — couleurs, typo, disposition et overlay GIF des boutons de son",[32,1044,1045,1047],{},[258,1046,617],{}," — couleurs, typo et épaisseur de bordure de la barre d’onglets",[14,1049,1050],{},"Un aperçu en direct montre onglets et boutons pendant que tu édites.",[24,1052,1054],{"id":1053},"ce-que-tu-peux-changer","Ce que tu peux changer",[29,1056,1057,1060,1063,1066],{},[32,1058,1059],{},"Couleurs primaire et d’accent, fonds, couleurs des boutons, couleurs des onglets",[32,1061,1062],{},"Famille et taille de police des boutons et des onglets",[32,1064,1065],{},"Largeur, rayon, bordure, écarts et padding des boutons",[32,1067,1068],{},"Opacité de l’overlay GIF (normal et survol)",[24,1070,1072],{"id":1071},"enregistrer-et-partager","Enregistrer et partager",[29,1074,1075,1081,1087,1093],{},[32,1076,1077,1080],{},[258,1078,1079],{},"Exporter .css"," — écrire un fichier de thèm