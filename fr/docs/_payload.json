[{"data":1,"prerenderedAt":1584},["ShallowReactive",2],{"docs-page-fr-\u002Foverview":3,"docs-nav-fr":144},{"id":4,"title":5,"body":6,"description":135,"extension":136,"meta":137,"navigation":138,"order":139,"path":140,"seo":141,"stem":142,"__hash__":143},"content_fr\u002Foverview.md","Aperçu",{"type":7,"value":8,"toc":127},"minimark",[9,13,17,20,23,28,44,48,88,92,102,106],[10,11,5],"h1",{"id":12},"aperçu",[14,15,16],"p",{},"SoundNinja est un soundboard open source pour le live streaming, les discussions entre amis et l’enregistrement de podcasts. Il est construit avec Tauri v2 et Nuxt 4 pour rester léger en RAM et sur le disque.",[14,18,19],{},"Le but est simple : garder une énorme bibliothèque de sons facile à parcourir, puis jouer le bon clip en quelques millisecondes. L’interface marche aussi comme tableau de bord en VR.",[14,21,22],{},"SoundNinja est encore en développement précoce. Les fonctions marchent, mais toutes les plateformes ne sont pas entièrement testées.",[24,25,27],"h2",{"id":26},"pour-qui","Pour qui",[29,30,31,35,38,41],"ul",{},[32,33,34],"li",{},"Les streameurs qui ont besoin de cues sonores instantanés",[32,36,37],{},"Les amis qui veulent un board partagé pour le vocal",[32,39,40],{},"Les podcasteurs qui enregistrent des clips et les posent sur un board",[32,42,43],{},"Quiconque veut un soundboard personnalisable et local-first",[24,45,47],{"id":46},"ce-que-tu-peux-faire","Ce que tu peux faire",[29,49,50,53,56,59,62,65,68,71,74,82,85],{},[32,51,52],{},"Construire un soundboard à partir de tes propres fichiers audio",[32,54,55],{},"Organiser les sons dans des onglets colorés, des groupes, des tags et la recherche",[32,57,58],{},"Filtrer par tags (OU) et trier par nom, date, durée ou taille",[32,60,61],{},"Sélection multiple avec rectangle ou plage Maj, puis couleur, déplacement ou suppression en lot",[32,63,64],{},"Régler le volume par son depuis le menu contextuel",[32,66,67],{},"Concevoir le look avec le Theme Creator",[32,69,70],{},"Enregistrer l’audio du PC ou un micro dans le Record Editor",[32,72,73],{},"Assigner des raccourcis à des sons individuels",[32,75,76,77],{},"Déclencher des sons depuis ",[78,79,81],"a",{"href":80},"\u002Fdocs\u002Fremote-control","Bitfocus Companion",[32,83,84],{},"Importer et exporter un soundboard complet pour le partager",[32,86,87],{},"Utiliser des GIF ou des images sur les boutons — bibliothèque de dossiers locale ou KLIPY",[24,89,91],{"id":90},"licence","Licence",[14,93,94,95,101],{},"SoundNinja est un logiciel libre sous ",[78,96,100],{"href":97,"rel":98},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fblob\u002Fmain\u002FLICENSE",[99],"nofollow","GPL-3.0",". Forke-le, modifie-le, partage-le.",[24,103,105],{"id":104},"prochaines-étapes","Prochaines étapes",[107,108,109,115,121],"ol",{},[32,110,111],{},[78,112,114],{"href":113},"\u002Fdocs\u002Finstallation","Installer SoundNinja",[32,116,117],{},[78,118,120],{"href":119},"\u002Fdocs\u002Fadding-sounds","Ajouter des sons",[32,122,123],{},[78,124,126],{"href":125},"\u002Fdocs\u002Forganizing-sounds","Organiser ton board",{"title":128,"searchDepth":129,"depth":129,"links":130},"",2,[131,132,133,134],{"id":26,"depth":129,"text":27},{"id":46,"depth":129,"text":47},{"id":90,"depth":129,"text":91},{"id":104,"depth":129,"text":105},"Ce qu’est SoundNinja et ce que tu peux en faire.","md",{},true,1,"\u002Foverview",{"title":5,"description":135},"overview","nBakDXsUbMnm0zyn8m6jAooziqocGWiZV3EwAtrg0xk",[145,227,431,579,982,1118,1265,1487],{"id":4,"title":5,"body":146,"description":135,"extension":136,"meta":225,"navigation":138,"order":139,"path":140,"seo":226,"stem":142,"__hash__":143},{"type":7,"value":147,"toc":219},[148,150,152,154,156,158,168,170,196,198,203,205],[10,149,5],{"id":12},[14,151,16],{},[14,153,19],{},[14,155,22],{},[24,157,27],{"id":26},[29,159,160,162,164,166],{},[32,161,34],{},[32,163,37],{},[32,165,40],{},[32,167,43],{},[24,169,47],{"id":46},[29,171,172,174,176,178,180,182,184,186,188,192,194],{},[32,173,52],{},[32,175,55],{},[32,177,58],{},[32,179,61],{},[32,181,64],{},[32,183,67],{},[32,185,70],{},[32,187,73],{},[32,189,76,190],{},[78,191,81],{"href":80},[32,193,84],{},[32,195,87],{},[24,197,91],{"id":90},[14,199,94,200,101],{},[78,201,100],{"href":97,"rel":202},[99],[24,204,105],{"id":104},[107,206,207,211,215],{},[32,208,209],{},[78,210,114],{"href":113},[32,212,213],{},[78,214,120],{"href":119},[32,216,217],{},[78,218,126],{"href":125},{"title":128,"searchDepth":129,"depth":129,"links":220},[221,222,223,224],{"id":26,"depth":129,"text":27},{"id":46,"depth":129,"text":47},{"id":90,"depth":129,"text":91},{"id":104,"depth":129,"text":105},{},{"title":5,"description":135},{"id":228,"title":229,"body":230,"description":426,"extension":136,"meta":427,"navigation":138,"order":129,"path":428,"seo":429,"stem":234,"__hash__":430},"content_fr\u002Finstallation.md","Installation",{"type":7,"value":231,"toc":419},[232,235,249,253,275,278,282,296,299,303,328,339,343,350,354,369,399,415],[10,233,229],{"id":234},"installation",[14,236,237,238,242,243,248],{},"Récupère un build sur la ",[78,239,241],{"href":240},"\u002Fdownload","page Télécharger"," ou sur ",[78,244,247],{"href":245,"rel":246},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Freleases\u002Flatest",[99],"GitHub Releases",". SoundNinja est en développement précoce — traite les builds comme des bêtas.",[24,250,252],{"id":251},"windows","Windows",[29,254,255,266,269,272],{},[32,256,257,261,262,265],{},[258,259,260],"strong",{},"Installateur (.exe)"," ou ",[258,263,264],{},"MSI (.msi)"," pour Windows 64 bits",[32,267,268],{},"Cible de la landing page : Windows 10 et plus",[32,270,271],{},"Le README de l’app mentionne aussi Windows 8 et supérieur",[32,273,274],{},"L’installateur NSIS est sombre. Choisis une langue à l’installation — SoundNinja la retient au prochain lancement.",[14,276,277],{},"Lance l’installateur, puis ouvre SoundNinja depuis le menu Démarrer.",[24,279,281],{"id":280},"macos","macOS",[29,283,284,290,293],{},[32,285,286,289],{},[258,287,288],{},".dmg universel"," pour Apple Silicon et Intel",[32,291,292],{},"Cible de la landing page : macOS 10.14 et plus",[32,294,295],{},"Le README de l’app mentionne macOS 10.15 et supérieur",[14,297,298],{},"Ouvre l’image disque et glisse SoundNinja dans Applications.",[24,300,302],{"id":301},"linux","Linux",[29,304,305,311,317,325],{},[32,306,307,310],{},[258,308,309],{},"Debian (.deb)"," pour Ubuntu \u002F Debian",[32,312,313,316],{},[258,314,315],{},"AppImage"," pour les autres distros",[32,318,319,320,324],{},"Après publication d’une release, les utilisateurs Arch peuvent installer ",[321,322,323],"code",{},"soundninja-bin"," depuis l’AUR",[32,326,327],{},"Testé sur Ubuntu 20.04",[14,329,330,331,334,335,338],{},"Les builds desktop ont besoin des paquets WebKit et GTK. Sous Debian\u002FUbuntu, ça veut souvent dire ",[321,332,333],{},"libwebkit2gtk",", ",[321,336,337],{},"libgtk-3-0"," et une bibliothèque app-indicator.",[24,340,342],{"id":341},"mises-à-jour","Mises à jour",[14,344,345,346,349],{},"Dans l’app, ouvre ",[258,347,348],{},"Aide → Rechercher les mises à jour",". Tu peux aussi laisser SoundNinja vérifier au démarrage dans les Paramètres.",[24,351,353],{"id":352},"compiler-depuis-les-sources","Compiler depuis les sources",[14,355,356,357,362,363,368],{},"Besoin d’un build custom ? Clone ",[78,358,361],{"href":359,"rel":360},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja",[99],"le repo",", installe les ",[78,364,367],{"href":365,"rel":366},"https:\u002F\u002Fv2.tauri.app\u002Fstart\u002Fprerequisites\u002F",[99],"prérequis Tauri",", puis :",[370,371,375],"pre",{"className":372,"code":373,"language":374,"meta":128,"style":128},"language-bash shiki shiki-themes github-light github-dark","bun install\nbun run tauri:serve\n","bash",[321,376,377,389],{"__ignoreMap":128},[378,379,381,385],"span",{"class":380,"line":139},"line",[378,382,384],{"class":383},"sScJk","bun",[378,386,388],{"class":387},"sZZnC"," install\n",[378,390,391,393,396],{"class":380,"line":129},[378,392,384],{"class":383},[378,394,395],{"class":387}," run",[378,397,398],{"class":387}," tauri:serve\n",[14,400,401,334,404,261,407,410,411,414],{},[321,402,403],{},"npm",[321,405,406],{},"pnpm",[321,408,409],{},"deno"," marchent aussi. Build de production : ",[321,412,413],{},"bun run tauri:build",".",[416,417,418],"style",{},"html pre.shiki code .sScJk, html code.shiki .sScJk{--shiki-default:#6F42C1;--shiki-dark:#B392F0}html pre.shiki code .sZZnC, html code.shiki .sZZnC{--shiki-default:#032F62;--shiki-dark:#9ECBFF}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html.dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}",{"title":128,"searchDepth":129,"depth":129,"links":420},[421,422,423,424,425],{"id":251,"depth":129,"text":252},{"id":280,"depth":129,"text":281},{"id":301,"depth":129,"text":302},{"id":341,"depth":129,"text":342},{"id":352,"depth":129,"text":353},"Installe SoundNinja sur Windows, macOS ou Linux.",{},"\u002Finstallation",{"title":229,"description":426},"KTRzJIiac667PnTSFZcw05sR0h0nrXsbeGEp_g_9MRw",{"id":432,"title":120,"body":433,"description":572,"extension":136,"meta":573,"navigation":138,"order":574,"path":575,"seo":576,"stem":577,"__hash__":578},"content_fr\u002Fadding-sounds.md",{"type":7,"value":434,"toc":564},[435,438,441,445,464,468,499,503,522,526,540,543,547,554,558],[10,436,120],{"id":437},"ajouter-des-sons",[14,439,440],{},"Un board reste vide tant que tu n’ajoutes pas de clips. SoundNinja peut importer des fichiers, des dossiers entiers, un enregistrement ou un pack de soundboard partagé.",[24,442,444],{"id":443},"importer-des-fichiers-audio","Importer des fichiers audio",[107,446,447,458,461],{},[32,448,449,450,453,454,457],{},"Ouvre ",[258,451,452],{},"Fichier → Importer des fichiers audio",", ou utilise ",[258,455,456],{},"Importer"," dans la barre de navigation.",[32,459,460],{},"Choisis un ou plusieurs fichiers audio.",[32,462,463],{},"Les sons arrivent dans l’onglet actuel.",[24,465,467],{"id":466},"importer-des-dossiers","Importer des dossiers",[107,469,470,479,482],{},[32,471,449,472,475,476,478],{},[258,473,474],{},"Fichier → Importer des dossiers"," (ou ",[258,477,467],{}," dans la barre de navigation).",[32,480,481],{},"Ajoute un ou plusieurs dossiers. Glisse pour les réordonner avant l’import.",[32,483,484,485],{},"Choisis comment ils arrivent :\n",[29,486,487,493],{},[32,488,489,492],{},[258,490,491],{},"Importer comme onglets"," — chaque dossier devient son propre onglet",[32,494,495,498],{},[258,496,497],{},"Importer dans l’onglet actuel"," — chaque fichier va dans l’onglet actif",[24,500,502],{"id":501},"enregistrer-un-clip","Enregistrer un clip",[14,504,505,506,510,511,514,515,261,518,521],{},"Ouvre le ",[78,507,509],{"href":508},"\u002Fdocs\u002Frecording-editor","Record Editor"," depuis le bouton ",[258,512,513],{},"Enregistrer"," dans la barre du lecteur. Capture, coupe, puis ",[258,516,517],{},"Importer la sélection",[258,519,520],{},"Tout importer"," dans l’onglet actuel ou un onglet que tu choisis.",[24,523,525],{"id":524},"importer-un-soundboard","Importer un soundboard",[14,527,528,531,532,535,536,539],{},[258,529,530],{},"Fichier → Importer un soundboard"," charge un pack partagé. Les packs sont un ",[321,533,534],{},".zip"," qui contient ",[321,537,538],{},"project.sninja"," plus les fichiers audio. Après l’import, ouvre le projet et joue.",[14,541,542],{},"Tu peux aussi garder plusieurs projets (profils). Utilise le sélecteur de projet pour changer de board.",[24,544,546],{"id":545},"relier-les-fichiers-manquants","Relier les fichiers manquants",[14,548,549,550,553],{},"Si des fichiers audio bougent sur le disque, SoundNinja affiche ",[258,551,552],{},"Fichiers audio manquants",". Choisis un dossier à parcourir et relie les clips.",[24,555,557],{"id":556},"suite","Suite",[14,559,560,561,414],{},"Organise onglets, tags, filtres et raccourcis dans ",[78,562,563],{"href":125},"Organiser les sons",{"title":128,"searchDepth":129,"depth":129,"links":565},[566,567,568,569,570,571],{"id":443,"depth":129,"text":444},{"id":466,"depth":129,"text":467},{"id":501,"depth":129,"text":502},{"id":524,"depth":129,"text":525},{"id":545,"depth":129,"text":546},{"id":556,"depth":129,"text":557},"Importe de l’audio, des dossiers, des enregistrements et des soundboards partagés.",{},3,"\u002Fadding-sounds",{"title":120,"description":572},"adding-sounds","4l04_lLfE4dqOPh8H0Rav69GnvCVi_PKTEgAepysTeI",{"id":580,"title":563,"body":581,"description":975,"extension":136,"meta":976,"navigation":138,"order":977,"path":978,"seo":979,"stem":980,"__hash__":981},"content_fr\u002Forganizing-sounds.md",{"type":7,"value":582,"toc":960},[583,586,593,597,624,631,635,638,652,659,665,669,679,684,716,720,726,730,763,769,773,776,802,805,809,822,826,832,853,869,876,880,891,894,898,905,915,921,925,933,940,957],[10,584,563],{"id":585},"organiser-les-sons",[14,587,588,589,592],{},"SoundNinja est conçu pour les grandes bibliothèques. ",[258,590,591],{},"Tags et filtres",", onglets, recherche, sélection multiple et raccourcis — le clip dont tu as besoin est à un clic (ou une touche) près.",[24,594,596],{"id":595},"onglets","Onglets",[29,598,599,606,613],{},[32,600,601,602,605],{},"Ajoute un onglet avec ",[258,603,604],{},"Ajouter un onglet",". Donne-lui une couleur pour scanner la barre vite.",[32,607,608,609,612],{},"La vue ",[258,610,611],{},"Tous"," montre chaque son à travers les onglets.",[32,614,615,616,619,620,623],{},"Un son peut appartenir à ",[258,617,618],{},"un ou plusieurs onglets",". Clic droit sur un son et utilise ",[258,621,622],{},"Déplacer vers l’onglet"," pour l’assigner.",[14,625,626,627,630],{},"Les transitions d’onglets sont dans ",[258,628,629],{},"Paramètres → Général"," : Slide, Fade, Boutons un par un, ou Aucune.",[24,632,634],{"id":633},"groupes","Groupes",[14,636,637],{},"Depuis la v0.5.3, les séparateurs peuvent devenir des groupes nommés :",[29,639,640,643,646,649],{},[32,641,642],{},"Ajouter, renommer ou supprimer un groupe depuis le menu contextuel",[32,644,645],{},"Glisser l’en-tête du groupe — les enfants suivent",[32,647,648],{},"Déposer des sons dans un groupe ou les en sortir",[32,650,651],{},"Régler la couleur de bordure, la couleur du nom et l’alignement des boutons (ou utiliser le défaut de l’onglet)",[14,653,654,655,658],{},"Tu peux toujours ajouter un ",[258,656,657],{},"Séparateur"," simple si tu as seulement besoin d’une coupure visuelle.",[14,660,661,662,414],{},"Clic droit sur l’espace vide du board pour ",[258,663,664],{},"Ajouter un groupe",[24,666,668],{"id":667},"tags-filtres","Tags \u002F Filtres",[14,670,671,672,675,676,678],{},"Les tags traversent les onglets. Le panneau ",[258,673,674],{},"Filtre"," (barre latérale ",[258,677,674],{},") sert à les créer et à filtrer le board.",[680,681,683],"h3",{"id":682},"créer-et-modifier-des-tags","Créer et modifier des tags",[107,685,686,691,702,709],{},[32,687,449,688,690],{},[258,689,674],{}," dans la barre latérale.",[32,692,693,694,697,698,701],{},"Sous ",[258,695,696],{},"Tags",", utilise ",[258,699,700],{},"Ajouter un tag"," — nom et couleur.",[32,703,704,705,708],{},"Renomme, recolore ou ",[258,706,707],{},"Supprimer le tag"," dans la même liste.",[32,710,711,712,715],{},"Si tu vois ",[258,713,714],{},"Aucun tag pour l’instant",", crée-en un ici avant d’assigner.",[680,717,719],{"id":718},"assigner-des-tags-aux-sons","Assigner des tags aux sons",[14,721,722,723,725],{},"Clic droit sur un son → ",[258,724,696],{}," (cases à cocher). Un son peut avoir plusieurs tags. S’il n’y en a encore aucun, le menu pointe vers le panneau filtre.",[680,727,729],{"id":728},"filtrer-le-board","Filtrer le board",[29,731,732,738,749,760],{},[32,733,734,735,414],{},"Active les tags dans le panneau Filtre, ou comme ",[258,736,737],{},"puces sous la barre de recherche",[32,739,740,741,744,745,748],{},"Le match est ",[258,742,743],{},"OU"," : un son reste visible s’il a ",[258,746,747],{},"n’importe quel"," tag sélectionné.",[32,750,751,752,755,756,759],{},"Le champ ",[258,753,754],{},"Recherche"," combine en ",[258,757,758],{},"ET"," avec le filtre de tags actif (saisie + tags ensemble).",[32,761,762],{},"Désactive les puces (ou vide le filtre) pour revoir tout l’onglet.",[14,764,765,766,414],{},"Les noms de tags colorés peuvent apparaître sur les boutons. Active-les dans ",[258,767,768],{},"Paramètres → Comportement → Afficher les badges de tags",[24,770,772],{"id":771},"tri","Tri",[14,774,775],{},"Ouvre le panneau filtre et choisis un mode :",[29,777,778,784],{},[32,779,780,783],{},[258,781,782],{},"Défini par l’utilisateur"," — ton ordre d’onglet, groupes visibles",[32,785,786,334,789,334,792,261,795,798,799],{},[258,787,788],{},"Nom",[258,790,791],{},"Date d’ajout",[258,793,794],{},"Durée de lecture",[258,796,797],{},"Taille de fichier"," — liste plate triée ; ",[258,800,801],{},"les groupes sont masqués",[14,803,804],{},"Le tri par durée peut préchauffer les métadonnées de durée la première fois.",[24,806,808],{"id":807},"réordonner","Réordonner",[14,810,811,812,815,816,819,820,414],{},"Active le glisser-déposer dans ",[258,813,814],{},"Paramètres → Comportement"," (",[258,817,818],{},"Autoriser le réordonnancement","). Puis glisse sons et groupes en place. Le réordonnancement s’applique en tri ",[258,821,782],{},[24,823,825],{"id":824},"sélection-multiple","Sélection multiple",[14,827,828,829,831],{},"Active ",[258,830,825],{}," dans la barre de navigation, puis :",[29,833,834,837,843,850],{},[32,835,836],{},"Clique pour basculer un son",[32,838,839,842],{},[258,840,841],{},"Maj+clic"," pour une plage depuis le dernier ancrage",[32,844,845,846,849],{},"Trace un ",[258,847,848],{},"rectangle"," sur l’espace vide du board",[32,851,852],{},"Clique le board vide (ou à l’extérieur) pour vider la sélection",[14,854,855,856,334,859,334,862,865,866,414],{},"Une barre groupée affiche le compte, plus ",[258,857,858],{},"Couleur",[258,860,861],{},"Déplacer vers l’onglet…",[258,863,864],{},"Supprimer"," et ",[258,867,868],{},"Terminé",[14,870,871,872,875],{},"En sélection multiple, chaque bouton montre une ",[258,873,874],{},"puce d’ID de 8 caractères",". Clic droit sur la puce pour la copier.",[24,877,879],{"id":878},"volume-par-son","Volume par son",[14,881,882,883,886,887,890],{},"Clic droit → ",[258,884,885],{},"Volume",". Glisse le curseur de 0 % à 100 %. ",[258,888,889],{},"Double-clic"," le remet à 100 %.",[14,892,893],{},"Ça se cumule avec le volume de sortie principal dans les Paramètres.",[24,895,897],{"id":896},"raccourcis-et-ids-de-son","Raccourcis et IDs de son",[14,899,900,901,904],{},"Chaque son a un ID de 8 caractères. Copie-le depuis le menu contextuel du bouton (",[258,902,903],{},"Copier l’ID",") ou la puce d’ID de la sélection multiple.",[14,906,449,907,910,911,914],{},[258,908,909],{},"Paramètres → Raccourcis"," pour lier une touche à un ID de son. Les raccourcis globaux sont optionnels. ",[258,912,913],{},"Assigner un raccourci"," dans le menu contextuel y saute avec l’ID déjà rempli.",[14,916,917,918,920],{},"Le même ID est ce que ",[78,919,81],{"href":80}," utilise pour déclencher un clip.",[24,922,924],{"id":923},"images-de-fond-et-couleurs","Images de fond et couleurs",[14,926,927,928,932],{},"Clic droit sur un son pour régler des couleurs par bouton ou une image de fond. C’est séparé du ",[78,929,931],{"href":930},"\u002Fdocs\u002Ftheme-editor","Theme Creator",", qui habille tout le board.",[14,934,935,936,939],{},"Le sélecteur est une boîte ",[258,937,938],{},"Image de fond"," (PNG, JPEG, GIF, WebP) :",[29,941,942,948],{},[32,943,944,947],{},[258,945,946],{},"Fichiers locaux"," — ajouter des dossiers, choisir un fichier, chercher par nom, prévisualiser la grille, retirer un dossier de la bibliothèque",[32,949,950,953,954,956],{},[258,951,952],{},"KLIPY"," — chercher des GIF en ligne. Mets ta propre clé API dans ",[258,955,814],{},". La clé n’est pas stockée dans les fichiers projet.",[14,958,959],{},"Après le choix, recadre et décale l’image sur le bouton.",{"title":128,"searchDepth":129,"depth":129,"links":961},[962,963,964,969,970,971,972,973,974],{"id":595,"depth":129,"text":596},{"id":633,"depth":129,"text":634},{"id":667,"depth":129,"text":668,"children":965},[966,967,968],{"id":682,"depth":574,"text":683},{"id":718,"depth":574,"text":719},{"id":728,"depth":574,"text":729},{"id":771,"depth":129,"text":772},{"id":807,"depth":129,"text":808},{"id":824,"depth":129,"text":825},{"id":878,"depth":129,"text":879},{"id":896,"depth":129,"text":897},{"id":923,"depth":129,"text":924},"Tags, filtres, onglets, groupes, tri, sélection multiple, volume et raccourcis.",{},4,"\u002Forganizing-sounds",{"title":563,"description":975},"organizing-sounds","3ZEh-vX7bLxxdpr56sVGIToyf64-wDiiegH_atr9lbk",{"id":983,"title":984,"body":985,"description":1111,"extension":136,"meta":1112,"navigation":138,"order":1113,"path":1114,"seo":1115,"stem":1116,"__hash__":1117},"content_fr\u002Ftheme-editor.md","Éditeur de thème",{"type":7,"value":986,"toc":1105},[987,990,996,1000,1027,1030,1034,1048,1052,1078,1081,1085,1091],[10,988,984],{"id":989},"éditeur-de-thème",[14,99