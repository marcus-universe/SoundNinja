58,1160,1161],{},"Paramètres → Audio"," :",[29,1164,1165,1171,1177],{},[32,1166,1167,1170],{},[258,1168,1169],{},"Périphériques d’entrée"," — microphone",[32,1172,1173,1176],{},[258,1174,1175],{},"Périphériques de sortie (audio PC)"," — loopback de ce que le PC joue",[32,1178,1179,1182],{},[258,1180,1181],{},"Volume d’entrée"," — gain de capture de 0 % à 200 %",[14,1184,1185],{},"Le bouton Enregistrer utilise le périphérique choisi ici.",[24,1187,1189],{"id":1188},"éditer-la-prise","Éditer la prise",[29,1191,1192,1195,1198,1206,1209,1212],{},[32,1193,1194],{},"Enregistrer et arrêter",[32,1196,1197],{},"Surveiller le vu-mètre d’entrée",[32,1199,1200,261,1203],{},[258,1201,1202],{},"Normaliser",[258,1204,1205],{},"Réduction de bruit",[32,1207,1208],{},"Couper tout le clip, couper à une sélection, ou supprimer une sélection",[32,1210,1211],{},"Annuler \u002F rétablir",[32,1213,1214],{},"Zoomer et dézoomer",[24,1216,1218],{"id":1217},"préparer-et-importer","Préparer et importer",[107,1220,1221,1224,1227],{},[32,1222,1223],{},"Ajoute la sélection ou la piste complète à la liste de staging.",[32,1225,1226],{},"La liste commence vide : enregistre, édite, puis ajoute un clip.",[32,1228,1229,261,1231,542],{},[258,1230,538],{},[258,1232,541],{},[24,1234,1236],{"id":1235},"séparation-de-stems-optionnel","Séparation de stems (optionnel)",[14,1238,1239,1240,1243,1244,1247,1248,1251],{},"Les builds officiels Windows, macOS et Linux livrent la fonction ",[258,1241,1242],{},"stems",". Le Record Editor peut garder les ",[258,1245,1246],{},"voix"," ou la ",[258,1249,1250],{},"musique"," avec BS-RoFormer.",[14,1253,1254,1255,1258,1259,1262],{},"Le modèle fait environ 158 MB et n’est ",[258,1256,1257],{},"pas"," inclus dans l’installateur. Télécharge-le depuis ",[258,1260,1261],{},"Paramètres → Séparation de stems",", ou accepte l’invite au premier lancement. L’installateur Windows peut aussi proposer de télécharger le modèle au premier démarrage.",[14,1264,1265,1266,1032,1269,1272],{},"Les builds source custom ont besoin d’un flag extra (",[321,1267,1268],{},"tauri:serve:stems",[321,1270,1271],{},"tauri:build:stems",").",{"title":128,"searchDepth":129,"depth":129,"links":1274},[1275,1276,1277,1278],{"id":1155,"depth":129,"text":1156},{"id":1188,"depth":129,"text":1189},{"id":1217,"depth":129,"text":1218},{"id":1235,"depth":129,"text":1236},"Capturer le micro ou l’audio du PC, éditer le clip et le poser sur ton board.",{},6,"\u002Frecording-editor",{"title":1141,"description":1279},"recording-editor","ZMpimB13mAmCTr4lHYb896wJ8oA5QijFuonM7e0rJU8",{"id":1287,"title":1288,"body":1289,"description":1501,"extension":136,"meta":1502,"navigation":138,"order":1503,"path":1504,"seo":1505,"stem":1506,"__hash__":1507},"content_fr\u002Fremote-control.md","Contrôle à distance",{"type":7,"value":1290,"toc":1494},[1291,1294,1297,1301,1330,1333,1336,1371,1375,1395,1398,1402,1434,1438,1444],[10,1292,1288],{"id":1293},"contrôle-à-distance",[14,1295,1296],{},"SoundNinja peut écouter sur ton réseau local pour que Bitfocus Companion (ou n’importe quel client HTTP\u002FWebSocket) joue et arrête des sons.",[24,1298,1300],{"id":1299},"activer-le-serveur-distant","Activer le serveur distant",[107,1302,1303,1308,1314,1320],{},[32,1304,470,1305,414],{},[258,1306,1307],{},"Paramètres → Distant",[32,1309,1310,1311,414],{},"Active le serveur distant. Le port par défaut est ",[258,1312,1313],{},"7331",[32,1315,1316,1317,414],{},"Optionnel : définis un token. Les clients doivent l’envoyer comme Bearer token ou ",[321,1318,1319],{},"?token=",[32,1321,1322,1323,1326,1327,414],{},"Copie l’URL ",[321,1324,1325],{},"http:\u002F\u002FIP:PORT",", ou copie l’IP système depuis ",[258,1328,1329],{},"Paramètres → À propos",[14,1331,1332],{},"Windows peut afficher une invite pare-feu la première fois que le serveur démarre. Autorise l’accès au réseau privé.",[24,1334,81],{"id":1335},"bitfocus-companion",[107,1337,1338,1345,1354,1364],{},[32,1339,1340,1341,414],{},"Installe ",[78,1342,81],{