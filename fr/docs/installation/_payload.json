1178,1128,1179,1182],{},[42,1180,1181],{},"Paramètres → Audio"," :",[36,1184,1185,1191,1197],{},[39,1186,1187,1190],{},[42,1188,1189],{},"Périphériques d’entrée"," — microphone",[39,1192,1193,1196],{},[42,1194,1195],{},"Périphériques de sortie (audio PC)"," — loopback de ce que le PC joue",[39,1198,1199,1202],{},[42,1200,1201],{},"Volume d’entrée"," — gain de capture de 0 % à 200 %",[14,1204,1205],{},"Le bouton Enregistrer utilise le périphérique choisi ici.",[31,1207,1209],{"id":1208},"éditer-la-prise","Éditer la prise",[36,1211,1212,1215,1218,1226,1229,1232],{},[39,1213,1214],{},"Enregistrer et arrêter",[39,1216,1217],{},"Surveiller le vu-mètre d’entrée",[39,1219,1220,45,1223],{},[42,1221,1222],{},"Normaliser",[42,1224,1225],{},"Réduction de bruit",[39,1227,1228],{},"Couper tout le clip, couper à une sélection, ou supprimer une sélection",[39,1230,1231],{},"Annuler \u002F rétablir",[39,1233,1234],{},"Zoomer et dézoomer",[31,1236,1238],{"id":1237},"préparer-et-importer","Préparer et importer",[317,1240,1241,1244,1247],{},[39,1242,1243],{},"Ajoute la sélection ou la piste complète à la liste de staging.",[39,1245,1246],{},"La liste commence vide : enregistre, édite, puis ajoute un clip.",[39,1248,1249,45,1251,562],{},[42,1250,558],{},[42,1252,561],{},[31,1254,1256],{"id":1255},"séparation-de-stems-optionnel","Séparation de stems (optionnel)",[14,1258,1259,1260,1263,1264,1267,1268,1271],{},"Les builds officiels Windows, macOS et Linux livrent la fonction ",[42,1261,1262],{},"stems",". Le Record Editor peut garder les ",[42,1265,1266],{},"voix"," ou la ",[42,1269,1270],{},"musique"," avec BS-RoFormer.",[14,1273,1274,1275,1278,1279,1282],{},"Le modèle fait environ 158 MB et n’est ",[42,1276,1277],{},"pas"," inclus dans l’installateur. Télécharge-le depuis ",[42,1280,1281],{},"Paramètres → Séparation de stems",", ou accepte l’invite au premier lancement. L’installateur Windows peut aussi proposer de télécharger le modèle au premier démarrage.",[14,1284,1285,1286,1052,1289,1292],{},"Les builds source custom ont besoin d’un flag extra (",[105,1287,1288],{},"tauri:serve:stems",[105,1290,1291],{},"tauri:build:stems",").",{"title":159,"searchDepth":177,"depth":177,"links":1294},[1295,1296,1297,1298],{"id":1175,"depth":177,"text":1176},{"id":1208,"depth":177,"text":1209},{"id":1237,"depth":177,"text":1238},{"id":1255,"depth":177,"text":1256},"Capturer le micro ou l’audio du PC, éditer le clip et le poser sur ton board.",{},6,"\u002Frecording-editor",{"title":1161,"description":1299},"recording-editor","ZMpimB13mAmCTr4lHYb896wJ8oA5QijFuonM7e0rJU8",{"id":1307,"title":1308,"body":1309,"description":1521,"extension":214,"meta":1522,"navigation":216,"order":1523,"path":1524,"seo":1525,"stem":1526,"__hash__":1527},"content_fr\u002Fremote-control.md","Contrôle à distance",{"type":7,"value":1310,"toc":1514},[1311,1314,1317,1321,1350,1353,1356,1391,1395,1415,1418,1422,1454,1458,1464],[10,1312,1308],{"id":1313},"contrôle-à-distance",[14,1315,1316],{},"SoundNinja peut écouter sur ton réseau local pour que Bitfocus Companion (ou n’importe quel client HTTP\u002FWebSocket) joue et arrête des sons.",[31,1318,1320],{"id":1319},"activer-le-serveur-distant","Activer le serveur distant",[317,1322,1323,1328,1334,1340],{},[39,1324,490,1325,201],{},[42,1326,1327],{},"Paramètres → Distant",[39,1329,1330,1331,201],{},"Active le serveur distant. Le port par défaut est ",[42,1332,1333],{},"7331",[39,1335,1336,1337,201],{},"Optionnel : définis un token. Les clients doivent l’envoyer comme Bearer token ou ",[105,1338,1339],{},"?token=",[39,1341,1342,1343,1346,1347,201],{},"Copie l’URL ",[105,1344,1345],{},"http:\u002F\u002FIP:PORT",", ou copie l’IP système depuis ",[42,1348,1349],{},"Paramètres → À propos",[14,1351,1352],{},"Windows peut afficher une invite pare-feu la première fois que le serveur démarre. Autorise l’accès au réseau privé.",[31,1354,292],{"id":1355},"bitfocus-companion",[317,1357,1358,1365,1374,1384],{},[39,1359,1360,1361,201],{},"Installe ",[18,1