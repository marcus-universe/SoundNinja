[{"data":1,"prerenderedAt":1668},["ShallowReactive",2],{"docs-page-fr-\u002Finstallation":3,"docs-nav-fr":241},{"id":4,"title":5,"body":6,"description":234,"extension":235,"meta":236,"navigation":237,"order":177,"path":238,"seo":239,"stem":12,"__hash__":240},"content_fr\u002Finstallation.md","Installation",{"type":7,"value":8,"toc":227},"minimark",[9,13,30,35,59,62,66,80,83,87,112,123,127,134,138,153,186,202,223],[10,11,5],"h1",{"id":12},"installation",[14,15,16,17,22,23,29],"p",{},"Récupère un build sur la ",[18,19,21],"a",{"href":20},"\u002Fdownload","page Télécharger"," ou sur ",[18,24,28],{"href":25,"rel":26},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Freleases\u002Flatest",[27],"nofollow","GitHub Releases",". SoundNinja est en développement précoce — traite les builds comme des bêtas.",[31,32,34],"h2",{"id":33},"windows","Windows",[36,37,38,50,53,56],"ul",{},[39,40,41,45,46,49],"li",{},[42,43,44],"strong",{},"Installateur (.exe)"," ou ",[42,47,48],{},"MSI (.msi)"," pour Windows 64 bits",[39,51,52],{},"Cible de la landing page : Windows 10 et plus",[39,54,55],{},"Le README de l’app mentionne aussi Windows 8 et supérieur",[39,57,58],{},"L’installateur NSIS est sombre. Choisis une langue à l’installation — SoundNinja la retient au prochain lancement.",[14,60,61],{},"Lance l’installateur, puis ouvre SoundNinja depuis le menu Démarrer.",[31,63,65],{"id":64},"macos","macOS",[36,67,68,74,77],{},[39,69,70,73],{},[42,71,72],{},".dmg universel"," pour Apple Silicon et Intel",[39,75,76],{},"Cible de la landing page : macOS 10.14 et plus",[39,78,79],{},"Le README de l’app mentionne macOS 10.15 et supérieur",[14,81,82],{},"Ouvre l’image disque et glisse SoundNinja dans Applications.",[31,84,86],{"id":85},"linux","Linux",[36,88,89,95,101,109],{},[39,90,91,94],{},[42,92,93],{},"Debian (.deb)"," pour Ubuntu \u002F Debian",[39,96,97,100],{},[42,98,99],{},"AppImage"," pour les autres distros",[39,102,103,104,108],{},"Après publication d’une release, les utilisateurs Arch peuvent installer ",[105,106,107],"code",{},"soundninja-bin"," depuis l’AUR",[39,110,111],{},"Testé sur Ubuntu 20.04",[14,113,114,115,118,119,122],{},"Les builds desktop ont besoin des paquets WebKit et GTK. Sous Debian\u002FUbuntu, ça veut souvent dire ",[105,116,117],{},"libwebkit2gtk",", ",[105,120,121],{},"libgtk-3-0"," et une bibliothèque app-indicator.",[31,124,126],{"id":125},"mises-à-jour","Mises à jour",[14,128,129,130,133],{},"Dans l’app, ouvre ",[42,131,132],{},"Aide → Rechercher les mises à jour",". Tu peux aussi laisser SoundNinja vérifier au démarrage dans les Paramètres.",[31,135,137],{"id":136},"compiler-depuis-les-sources","Compiler depuis les sources",[14,139,140,141,146,147,152],{},"Besoin d’un build custom ? Clone ",[18,142,145],{"href":143,"rel":144},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja",[27],"le repo",", installe les ",[18,148,151],{"href":149,"rel":150},"https:\u002F\u002Fv2.tauri.app\u002Fstart\u002Fprerequisites\u002F",[27],"prérequis Tauri",", puis :",[154,155,160],"pre",{"className":156,"code":157,"language":158,"meta":159,"style":159},"language-bash shiki shiki-themes github-light github-dark","bun install\nbun run tauri:serve\n","bash","",[105,161,162,175],{"__ignoreMap":159},[163,164,167,171],"span",{"class":165,"line":166},"line",1,[163,168,170],{"class":169},"sScJk","bun",[163,172,174],{"class":173},"sZZnC"," install\n",[163,176,178,180,183],{"class":165,"line":177},2,[163,179,170],{"class":169},[163,181,182],{"class":173}," run",[163,184,185],{"class":173}," tauri:serve\n",[14,187,188,118,191,45,194,197,198,201],{},[105,189,190],{},"npm",[105,192,193],{},"pnpm",[105,195,196],{},"deno"," marchent aussi. Build de production : ",[105,199,200],{},"bun run tauri:build",".",[14,203,204,207,208,213,214,217,218,201],{},[42,205,206],{},"Windows uniquement :"," chaque compile Windows inclut ASIO via le ",[18,209,212],{"href":210,"rel":211},"https:\u002F\u002Fwww.steinberg.net\u002Fasiosdk",[27],"Steinberg ASIO SDK",". Lance ",[105,215,216],{},"bun run setup:asio"," une fois (SDK pas dans git). Linux et macOS utilisent PipeWire \u002F Core Audio — ignore cette étape. Détails : ",[18,219,222],{"href":220,"rel":221},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fblob\u002Fmain\u002Fdocs\u002Fbuild-from-source.md",[27],"build-from-source.md",[224,225,226],"style",{},"html pre.shiki code .sScJk, html code.shiki .sScJk{--shiki-default:#6F42C1;--shiki-dark:#B392F0}html pre.shiki code .sZZnC, html code.shiki .sZZnC{--shiki-default:#032F62;--shiki-dark:#9ECBFF}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html.dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}",{"title":159,"searchDepth":177,"depth":177,"links":228},[229,230,231,232,233],{"id":33,"depth":177,"text":34},{"id":64,"depth":177,"text":65},{"id":85,"depth":177,"text":86},{"id":125,"depth":177,"text":126},{"id":136,"depth":177,"text":137},"Installe SoundNinja sur Windows, macOS ou Linux.","md",{},true,"\u002Finstallation",{"title":5,"description":234},"FOJJDNBAT_xV14QaxG490DTpeNiFpVDRFz_XEdyJKJE",[242,370,505,653,1066,1202,1349,1571],{"id":243,"title":244,"body":245,"description":364,"extension":235,"meta":365,"navigation":237,"order":166,"path":366,"seo":367,"stem":368,"__hash__":369},"content_fr\u002Foverview.md","Aperçu",{"type":7,"value":246,"toc":358},[247,250,253,256,259,263,277,281,320,324,333,337],[10,248,244],{"id":249},"aperçu",[14,251,252],{},"SoundNinja est un soundboard open source pour le live streaming, les discussions entre amis et l’enregistrement de podcasts. Il est construit avec Tauri v2 et Nuxt 4 pour rester léger en RAM et sur le disque.",[14,254,255],{},"Le but est simple : garder une énorme bibliothèque de sons facile à parcourir, puis jouer le bon clip en quelques millisecondes. L’interface marche aussi comme tableau de bord en VR.",[14,257,258],{},"SoundNinja est encore en développement précoce. Les fonctions marchent, mais toutes les plateformes ne sont pas entièrement testées.",[31,260,262],{"id":261},"pour-qui","Pour qui",[36,264,265,268,271,274],{},[39,266,267],{},"Les streameurs qui ont besoin de cues sonores instantanés",[39,269,270],{},"Les amis qui veulent un board partagé pour le vocal",[39,272,273],{},"Les podcasteurs qui enregistrent des clips et les posent sur un board",[39,275,276],{},"Quiconque veut un soundboard personnalisable et local-first",[31,278,280],{"id":279},"ce-que-tu-peux-faire","Ce que tu peux faire",[36,282,283,286,289,292,295,298,301,304,307,314,317],{},[39,284,285],{},"Construire un soundboard à partir de tes propres fichiers audio",[39,287,288],{},"Organiser les sons dans des onglets colorés, des groupes, des tags et la recherche",[39,290,291],{},"Filtrer par tags (OU) et trier par nom, date, durée ou taille",[39,293,294],{},"Sélection multiple avec rectangle ou plage Maj, puis couleur, déplacement ou suppression en lot",[39,296,297],{},"Régler le volume par son depuis le menu contextuel",[39,299,300],{},"Concevoir le look avec le Theme Creator",[39,302,303],{},"Enregistrer l’audio du PC ou un micro dans le Record Editor",[39,305,306],{},"Assigner des raccourcis à des sons individuels",[39,308,309,310],{},"Déclencher des sons depuis ",[18,311,313],{"href":312},"\u002Fdocs\u002Fremote-control","Bitfocus Companion",[39,315,316],{},"Importer et exporter un soundboard complet pour le partager",[39,318,319],{},"Utiliser des GIF ou des images sur les boutons — bibliothèque de dossiers locale, GifSnap ou KLIPY",[31,321,323],{"id":322},"licence","Licence",[14,325,326,327,332],{},"SoundNinja est un logiciel libre sous ",[18,328,331],{"href":329,"rel":330},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fblob\u002Fmain\u002FLICENSE",[27],"GPL-3.0",". Forke-le, modifie-le, partage-le.",[31,334,336],{"id":335},"prochaines-étapes","Prochaines étapes",[338,339,340,346,352],"ol",{},[39,341,342],{},[18,343,345],{"href":344},"\u002Fdocs\u002Finstallation","Installer SoundNinja",[39,347,348],{},[18,349,351],{"href":350},"\u002Fdocs\u002Fadding-sounds","Ajouter des sons",[39,353,354],{},[18,355,357],{"href":356},"\u002Fdocs\u002Forganizing-sounds","Organiser ton board",{"title":159,"searchDepth":177,"depth":177,"links":359},[360,361,362,363],{"id":261,"depth":177,"text":262},{"id":279,"depth":177,"text":280},{"id":322,"depth":177,"text":323},{"id":335,"depth":177,"text":336},"Ce qu’est SoundNinja et ce que tu peux en faire.",{},"\u002Foverview",{"title":244,"description":364},"overview","iefPYZgnT849nIe2RlNwJvyVbEUn8-T9CgtILbqYFPI",{"id":4,"title":5,"body":371,"description":234,"extension":235,"meta":503,"navigation":237,"order":177,"path":238,"seo":504,"stem":12,"__hash__":240},{"type":7,"value":372,"toc":496},[373,375,382,384,398,400,402,412,414,416,432,438,440,444,446,454,472,482,494],[10,374,5],{"id":12},[14,376,16,377,22,379,29],{},[18,378,21],{"href":20},[18,380,28],{"href":25,"rel":381},[27],[31,383,34],{"id":33},[36,385,386,392,394,396],{},[39,387,388,45,390,49],{},[42,389,44],{},[42,391,48],{},[39,393,52],{},[39,395,55],{},[39,397,58],{},[14,399,61],{},[31,401,65],{"id":64},[36,403,404,408,410],{},[39,405,406,73],{},[42,407,72],{},[39,409,76],{},[39,