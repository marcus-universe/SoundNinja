[{"data":1,"prerenderedAt":1625},["ShallowReactive",2],{"docs-page-fr-\u002Finstallation":3,"docs-nav-fr":220},{"id":4,"title":5,"body":6,"description":213,"extension":214,"meta":215,"navigation":216,"order":177,"path":217,"seo":218,"stem":12,"__hash__":219},"content_fr\u002Finstallation.md","Installation",{"type":7,"value":8,"toc":206},"minimark",[9,13,30,35,59,62,66,80,83,87,112,123,127,134,138,153,186,202],[10,11,5],"h1",{"id":12},"installation",[14,15,16,17,22,23,29],"p",{},"Récupère un build sur la ",[18,19,21],"a",{"href":20},"\u002Fdownload","page Télécharger"," ou sur ",[18,24,28],{"href":25,"rel":26},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Freleases\u002Flatest",[27],"nofollow","GitHub Releases",". SoundNinja est en développement précoce — traite les builds comme des bêtas.",[31,32,34],"h2",{"id":33},"windows","Windows",[36,37,38,50,53,56],"ul",{},[39,40,41,45,46,49],"li",{},[42,43,44],"strong",{},"Installateur (.exe)"," ou ",[42,47,48],{},"MSI (.msi)"," pour Windows 64 bits",[39,51,52],{},"Cible de la landing page : Windows 10 et plus",[39,54,55],{},"Le README de l’app mentionne aussi Windows 8 et supérieur",[39,57,58],{},"L’installateur NSIS est sombre. Choisis une langue à l’installation — SoundNinja la retient au prochain lancement.",[14,60,61],{},"Lance l’installateur, puis ouvre SoundNinja depuis le menu Démarrer.",[31,63,65],{"id":64},"macos","macOS",[36,67,68,74,77],{},[39,69,70,73],{},[42,71,72],{},".dmg universel"," pour Apple Silicon et Intel",[39,75,76],{},"Cible de la landing page : macOS 10.14 et plus",[39,78,79],{},"Le README de l’app mentionne macOS 10.15 et supérieur",[14,81,82],{},"Ouvre l’image disque et glisse SoundNinja dans Applications.",[31,84,86],{"id":85},"linux","Linux",[36,88,89,95,101,109],{},[39,90,91,94],{},[42,92,93],{},"Debian (.deb)"," pour Ubuntu \u002F Debian",[39,96,97,100],{},[42,98,99],{},"AppImage"," pour les autres distros",[39,102,103,104,108],{},"Après publication d’une release, les utilisateurs Arch peuvent installer ",[105,106,107],"code",{},"soundninja-bin"," depuis l’AUR",[39,110,111],{},"Testé sur Ubuntu 20.04",[14,113,114,115,118,119,122],{},"Les builds desktop ont besoin des paquets WebKit et GTK. Sous Debian\u002FUbuntu, ça veut souvent dire ",[105,116,117],{},"libwebkit2gtk",", ",[105,120,121],{},"libgtk-3-0"," et une bibliothèque app-indicator.",[31,124,126],{"id":125},"mises-à-jour","Mises à jour",[14,128,129,130,133],{},"Dans l’app, ouvre ",[42,131,132],{},"Aide → Rechercher les mises à jour",". Tu peux aussi laisser SoundNinja vérifier au démarrage dans les Paramètres.",[31,135,137],{"id":136},"compiler-depuis-les-sources","Compiler depuis les sources",[14,139,140,141,146,147,152],{},"Besoin d’un build custom ? Clone ",[18,142,145],{"href":143,"rel":144},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja",[27],"le repo",", installe les ",[18,148,151],{"href":149,"rel":150},"https:\u002F\u002Fv2.tauri.app\u002Fstart\u002Fprerequisites\u002F",[27],"prérequis Tauri",", puis :",[154,155,160],"pre",{"className":156,"code":157,"language":158,"meta":159,"style":159},"language-bash shiki shiki-themes github-light github-dark","bun install\nbun run tauri:serve\n","bash","",[105,161,162,175],{"__ignoreMap":159},[163,164,167,171],"span",{"class":165,"line":166},"line",1,[163,168,170],{"class":169},"sScJk","bun",[163,172,174],{"class":173},"sZZnC"," install\n",[163,176,178,180,183],{"class":165,"line":177},2,[163,179,170],{"class":169},[163,181,182],{"class":173}," run",[163,184,185],{"class":173}," tauri:serve\n",[14,187,188,118,191,45,194,197,198,201],{},[105,189,190],{},"npm",[105,192,193],{},"pnpm",[105,195,196],{},"deno"," marchent aussi. Build de production : ",[105,199,200],{},"bun run tauri:build",".",[203,204,205],"style",{},"html pre.shiki code .sScJk, html code.shiki .sScJk{--shiki-default:#6F42C1;--shiki-dark:#B392F0}html pre.shiki code .sZZnC, html code.shiki .sZZnC{--shiki-default:#032F62;--shiki-dark:#9ECBFF}html 