[{"data":1,"prerenderedAt":1329},["ShallowReactive",2],{"docs-page-fr-\u002Fadding-sounds":3,"docs-nav-fr":169},{"id":4,"title":5,"body":6,"description":160,"extension":161,"meta":162,"navigation":163,"order":164,"path":165,"seo":166,"stem":167,"__hash__":168},"content_fr\u002Fadding-sounds.md","Ajouter des sons",{"type":7,"value":8,"toc":150},"minimark",[9,13,17,22,44,48,80,84,105,109,124,127,131,138,142],[10,11,5],"h1",{"id":12},"ajouter-des-sons",[14,15,16],"p",{},"Un board reste vide tant que tu n’ajoutes pas de clips. SoundNinja peut importer des fichiers, des dossiers entiers, un enregistrement ou un pack de soundboard partagé.",[18,19,21],"h2",{"id":20},"importer-des-fichiers-audio","Importer des fichiers audio",[23,24,25,38,41],"ol",{},[26,27,28,29,33,34,37],"li",{},"Ouvre ",[30,31,32],"strong",{},"Fichier → Importer des fichiers audio",", ou utilise ",[30,35,36],{},"Importer"," dans la barre de navigation.",[26,39,40],{},"Choisis un ou plusieurs fichiers audio.",[26,42,43],{},"Les sons arrivent dans l’onglet actuel.",[18,45,47],{"id":46},"importer-des-dossiers","Importer des dossiers",[23,49,50,59,62],{},[26,51,28,52,55,56,58],{},[30,53,54],{},"Fichier → Importer des dossiers"," (ou ",[30,57,47],{}," dans la barre de navigation).",[26,60,61],{},"Ajoute un ou plusieurs dossiers. Glisse pour les réordonner avant l’import.",[26,63,64,65],{},"Choisis comment ils arrivent :\n",[66,67,68,74],"ul",{},[26,69,70,73],{},[30,71,72],{},"Importer comme onglets"," — chaque dossier devient son propre onglet",[26,75,76,79],{},[30,77,78],{},"Importer dans l’onglet actuel"," — chaque fichier va dans l’onglet actif",[18,81,83],{"id":82},"enregistrer-un-clip","Enregistrer un clip",[14,85,86,87,92,93,96,97,100,101,104],{},"Ouvre le ",[88,89,91],"a",{"href":90},"\u002Fdocs\u002Frecording-editor","Record Editor"," depuis le bouton ",[30,94,95],{},"Enregistrer"," dans la barre du lecteur. Capture, coupe, puis ",[30,98,99],{},"Importer la sélection"," ou ",[30,102,103],{},"Tout importer"," dans l’onglet actuel ou un onglet que tu choisis.",[18,106,108],{"id":107},"importer-un-soundboard","Importer un soundboard",[14,110,111,114,115,119,120,123],{},[30,112,113],{},"Fichier → Importer un soundboard"," charge un pack partagé. Les packs sont un ",[116,117,118],"code",{},".zip"," qui contient ",[116,121,122],{},"project.sninja"," plus les fichiers audio. Après l’import, ouvre le projet et joue.",[14,125,126],{},"Tu peux aussi garder plusieurs projets (profils). Utilise le sélecteur de projet pour changer de board.",[18,128,130],{"id":129},"relier-les-fichiers-manquants","Relier les fichiers manquants",[14,132,133,134,137],{},"Si des fichiers audio bougent sur le disque, SoundNinja affiche ",[30,135,136],{},"Fichiers audio manquants",". Choisis un dossier à parcourir et relie les clips.",[18,139,141],{"id":140},"suite","Suite",[14,143,144,145,149],{},"Organise onglets, groupes et raccourcis dans ",[88,146,148],{"href":147},"\u002Fdocs\u002Forganizing-sounds","Organiser les sons",".",{"title":151,"searchDepth":152,"depth":152,"links":153},"",2,[154,155,156,157,158,159],{"id":20,"depth":152,"text":21},{"id":46,"depth":152,"text":47},{"id":82,"depth":152,"text":83},{"id":107,"depth":152,"text":108},{"id":129,"depth":152,"text":130},{"id":140,"depth":152,"text":141},"Importe de l’audio, des dossiers, des enregistrements et des soundboards partagés.","md",{},true,3,"\u002Fadding-sounds",{"title":5,"description":160},"adding-sounds","WxjyAOY51Jh80jxw4Xvj7Ko_IY_wVuHJST0KFUWSZ9k",[170,288,485,576,731,867,1010,1232],{"id":171,"title":172,"body":173,"description":281,"extension":161,"meta":282,"navigation":163,"order":283,"path":284,"seo":285,"stem":286,"__hash__":287},"content_fr\u002Foverview.md","Aperçu",{"type":7,"value":174,"toc":275},[175,178,181,184,187,191,205,209,239,243,253,257],[10,176,172],{"id":177},"aperçu",[14,179,180],{},"SoundNinja est un soundboard open source pour le live streaming, les discussions entre amis et l’enregistrement de podcasts. Il est construit avec Tauri v2 et Nuxt 4 pour rester léger en RAM et sur le disque.",[14,182,183],{},"Le but est simple : garder une énorme bibliothèque de sons facile à parcourir, puis jouer le bon clip en quelques millisecondes. L’interface marche aussi comme tableau de bord en VR.",[14,185,186],{},"SoundNinja est encore en développement précoce. Les fonctions marchent, mais toutes les plateformes ne sont pas entièrement testées.",[18,188,190],{"id":189},"pour-qui","Pour qui",[66,192,193,196,199,202],{},[26,194,195],{},"Les streameurs qui ont besoin de cues sonores instantanés",[26,197,198],{},"Les amis qui veulent un board partagé pour le vocal",[26,200,201],{},"Les podcasteurs qui enregistrent des clips et les posent sur un board",[26,203,204],{},"Quiconque veut un soundboard personnalisable et local-first",[18,206,208],{"id":207},"ce-que-tu-peux-faire","Ce que tu peux faire",[66,210,211,214,217,220,223,226,233,236],{},[26,212,213],{},"Construire un soundboard à partir de tes propres fichiers audio",[26,215,216],{},"Organiser les sons dans des onglets colorés, des groupes et la recherche",[26,218,219],{},"Concevoir le look avec le Theme Creator",[26,221,222],{},"Enregistrer l’audio du PC ou un micro dans le Record Editor",[26,224,225],{},"Assigner des raccourcis à des sons individuels",[26,227,228,229],{},"Déclencher des sons depuis ",[88,230,232],{"href":231},"\u002Fdocs\u002Fremote-control","Bitfocus Companion",[26,234,235],{},"Importer et exporter un soundboard complet pour le partager",[26,237,238],{},"Utiliser des GIF ou des images sur les boutons de son",[18,240,242],{"id":241},"licence","Licence",[14,244,245,246,252],{},"SoundNinja est un logiciel libre sous ",[88,247,251],{"href":248,"rel":249},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fblob\u002Fmain\u002FLICENSE",[250],"nofollow","GPL-3.0",". Forke-le, modifie-le, partage-le.",[18,254,256],{"id":255},"prochaines-étapes","Prochaines étapes",[23,258,259,265,270],{},[26,260,261],{},[88,262,264],{"href":263},"\u002Fdocs\u002Finstallation","Installer SoundNinja",[26,266,267],{},[88,268,5],{"href":269},"\u002Fdocs\u002Fadding-sounds",[26,271,272],{},[88,273,274],{"href":147},"Organiser ton board",{"title":151,"searchDepth":152,"depth":152,"links":276},[277,278,279,280],{"id":189,"depth":152,"text":190},{"id":207,"depth":152,"text":208},{"id":241,"depth":152,"text":242},{"id":255,"depth":152,"text":256},"Ce qu’est SoundNinja et ce que tu peux en faire.",{},1,"\u002Foverview",{"title":172,"description":281},"overview","ZY8wtO0KcJ2GGKh9NDik0dGVB6QXrk3FQ-5mCb0D4-8",{"id":289,"title":290,"body":291,"description":480,"extension":161,"meta":481,"navigation":163,"order":152,"path":482,"seo":483,"stem":295,"__hash__":484},"content_fr\u002Finstallation.md","Installation",{"type":7,"value":292,"toc":473},[293,296,310,314,331,334,338,352,355,359,383,394,398,405,409,424,454,469],[10,294,290],{"id":295},"installation",[14,297,298,299,303,304,309],{},"Récupère un build sur la ",[88,300,302],{"href":301},"\u002Fdownload","page Télécharger"," ou sur ",[88,305,308],{"href":306,"rel":307},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Freleases\u002Flatest",[250],"GitHub Releases",". SoundNinja est en développement précoce — traite les builds comme des bêtas.",[18,311,313],{"id":312},"windows","Windows",[66,315,316,325,328],{},[26,317,318,100,321,324],{},[30,319,320],{},"Installateur (.exe)",[30,322,323],{},"MSI (.msi)"," pour Windows 64 bits",[26,326,327],{},"Cible de la landing page : Windows 10 et plus",[26,329,330],{},"Le README de l’app mentionne aussi Windows 8 et supérieur",[14,332,333],{},"Lance l’installateur, puis ouvre SoundNinja depuis le menu Démarrer.",[18,335,337],{"id":336},"macos","macOS",[66,339,340,346,349],{},[26,341,342,345],{},[30,343,344],{},".dmg universel"," pour Apple Silicon et Intel",[26,347,348],{},"Cible de la landing page : macOS 10.14 et plus",[26,350,351],{},"Le README de l’app mentionne macOS 10.15 et supérieur",[14,353,354],{},"Ouvre l’image disque et glisse SoundNinja dans Applications.",[18,356,358],{"id":357},"linux","Linux",[66,360,361,367,373,380],{},[26,362,363,366],{},[30,364,365],{},"Debian (.deb)"," pour Ubuntu \u002F Debian",[26,368,369,372],{},[30,370,371],{},"AppImage"," pour les autres distros",[26,374,375,376,379],{},"Après publication d’une release, les utilisateurs Arch peuvent installer ",[116,377,378],{},"soundninja-bin"," depuis l’AUR",[26,381,382],{},"Testé sur Ubuntu 20.04",[14,384,385,386,389,390,393],{},"Les builds desktop ont besoin des paquets WebKit et GTK. Sous Debian\u002FUbuntu, ça veut souvent dire ",[116,387,388],{},"libwebkit2gtk",", ",[116,391,392],{},"libgtk-3-0"," et une bibliothèque app-indicator.",[18,395,397],{"id":396},"mises-à-jour","Mises à jour",[14,399,400,401,404],{},"Dans l’app, ouvre ",[30,402,403],{},"Aide → Rechercher les mises à jour",". Tu peux aussi laisser SoundNinja vérifier au démarrage dans les Paramètres.",[18,406,408],{"id":407},"compiler-depuis-les-sources","Compiler depuis les sources",[14,410,411,412,417,418,423],{},"Besoin d’un build custom ? Clone ",[88,413,416],{"href":414,"rel":415},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja",[250],"le repo",", installe les ",[88,419,422],{"href":420,"rel":421},"https:\u002F\u002Fv2.tauri.app\u002Fstart\u002Fprerequisites\u002F",[250],"prérequis Tauri",", puis :",[425,426,430],"pre",{"className":427,"code":428,"language":429,"meta":151,"style":151},"language-bash shiki shiki-themes github-light github-dark","bun install\nbun run tauri:serve\n","bash",[116,431,432,444],{"__ignoreMap":151},[433,434,436,440],"span",{"class":435,"line":283},"line",[433,437,439],{"class":438},"sScJk","bun",[433,441,443],{"class":442},"sZZnC"," install\n",[433,445,446,448,451],{"class":435,"line":152},[433,447,439],{"class":438},[433,449,450],{"class":442}," run",[433,452,453],{"class":442}," tauri:serve\n",[14,455,456,389,459,100,462,465,466,149],{},[116,457,45