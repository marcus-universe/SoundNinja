dows, macOS ou Linux.",{},"\u002Finstallation",{"title":299,"description":492},"KTRzJIiac667PnTSFZcw05sR0h0nrXsbeGEp_g_9MRw",{"id":4,"title":5,"body":498,"description":160,"extension":161,"meta":586,"navigation":163,"order":164,"path":165,"seo":587,"stem":167,"__hash__":168},{"type":7,"value":499,"toc":578},[500,502,504,506,518,520,542,544,554,556,564,566,568,572,574],[10,501,5],{"id":12},[14,503,16],{},[18,505,21],{"id":20},[23,507,508,514,516],{},[26,509,28,510,33,512,37],{},[30,511,32],{},[30,513,36],{},[26,515,40],{},[26,517,43],{},[18,519,47],{"id":46},[23,521,522,528,530],{},[26,523,28,524,55,526,58],{},[30,525,54],{},[30,527,47],{},[26,529,61],{},[26,531,64,532],{},[66,533,534,538],{},[26,535,536,73],{},[30,537,72],{},[26,539,540,79],{},[30,541,78],{},[18,543,83],{"id":82},[14,545,86,546,92,548,96,550,100,552,104],{},[88,547,91],{"href":90},[30,549,95],{},[30,551,99],{},[30,553,103],{},[18,555,108],{"id":107},[14,557,558,114,560,119,562,123],{},[30,559,113],{},[116,561,118],{},[116,563,122],{},[14,565,126],{},[18,567,130],{"id":129},[14,569,133,570,137],{},[30,571,136],{},[18,573,141],{"id":140},[14,575,144,576,149],{},[88,577,148],{"href":147},{"title":151,"searchDepth":152,"depth":152,"links":579},[580,581,582,583,584,585],{"id":20,"depth":152,"text":21},{"id":46,"depth":152,"text":47},{"id":82,"depth":152,"text":83},{"id":107,"depth":152,"text":108},{"id":129,"depth":152,"text":130},{"id":140,"depth":152,"text":141},{},{"title":5,"description":160},{"id":589,"title":148,"body":590,"description":984,"extension":161,"meta":985,"navigation":163,"order":986,"path":987,"seo":988,"stem":989,"__hash__":990},"content_fr\u002Forganizing-sounds.md",{"type":7,"value":591,"toc":969},[592,595,602,606,633,640,644,647,661,668,674,678,688,693,725,729,735,739,772,778,782,785,811,814,818,831,835,841,862,878,885,889,900,903,907,914,924,930,934,942,949,966],[10,593,148],{"id":594},"organiser-les-sons",[14,596,597,598,601],{},"SoundNinja est conçu pour les grandes bibliothèques. ",[30,599,600],{},"Tags et filtres",", onglets, recherche, sélection multiple et raccourcis — le clip dont tu as besoin est à un clic (ou une touche) près.",[18,603,605],{"id":604},"onglets","Onglets",[66,607,608,615,622],{},[26,609,610,611,614],{},"Ajoute un onglet avec ",[30,612,613],{},"Ajouter un onglet",". Donne-lui une couleur pour scanner la barre vite.",[26,616,617,618,621],{},"La vue ",[30,619,620],{},"Tous"," montre chaque son à travers les onglets.",[26,623,624,625,628,629,632],{},"Un son peut appartenir à ",[30,626,627],{},"un ou plusieurs onglets",". Clic droit sur un son et utilise ",[30,630,631],{},"Déplacer vers l’onglet"," pour l’assigner.",[14,634,635,636,639],{},"Les transitions d’onglets sont dans ",[30,637,638],{},"Paramètres → Général"," : Slide, Fade, Boutons un par un, ou Aucune.",[18,641,643],{"id":642},"groupes","Groupes",[14,645,646],{},"Depuis la v0.5.3, les séparateurs peuvent devenir des groupes nommés :",[66,648,649,652,655,658],{},[26,650,651],{},"Ajouter, renommer ou supprimer un groupe depuis le menu contextuel",[26,653,654],{},"Glisser l’en-tête du groupe — les enfants suivent",[26,656,657],{},"Déposer des sons dans un groupe ou les en sortir",[26,659,660],{},"Régler la couleur de bordure, la couleur du nom et l’alignement des boutons (ou utiliser le défaut de l’onglet)",[14,662,663,664,667],{},"Tu peux toujours ajouter un ",[30,665,666],{},"Séparateur"," simple si tu as seulement besoin d’une coupure visuelle.",[14,669,670,671,149],{},"Clic droit sur l’espace vide du board pour ",[30,672,673],{},"Ajouter un groupe",[18,675,677],{"id":676},"tags-filtres","Tags \u002F Filtres",[14,679,680,681,684,685,687],{},"Les tags traversent les onglets. Le panneau ",[30,682,683],{},"Filtre"," (barre latérale ",[30,686,683],{},") sert à les créer et à filtrer le board.",[689,690,692],"h3",{"id":691},"créer-et-modifier-des-tags","Créer et modifier des tags",[23,694,695,700,711,718],{},[26,696,28,697,699],{},[30,698,683],{}," dans la barre latérale.",[26,701,702,703,706,707,710],{},"Sous ",[30,704,705],{},"Tags",", utilise ",[30,708,709],{},"Ajouter un tag"," — nom et couleur.",[26,712,713,714,717],{},"Renomme, recolore ou ",[30,715,716],{},"Supprimer le tag"," dans la même liste.",[26,719,720,721,724],{},"Si tu vois ",[30,722,723],{},"Aucun tag pour l’instant",", crée-en un ici avant d’assigner.",[689,726,728],{"id":727},"assigner-des-tags-aux-sons","Assigner des tags aux sons",[14,730,731,732,734],{},"Clic droit sur un son → ",[30,733,705],{}," (cases à cocher). Un son peut avoir plusieurs tags. S’il n’y en a encore aucun, le menu pointe vers le panneau filtre.",[689,736,738],{"id":737},"filtrer-le-board","Filtrer le board",[66,740,741,747,758,769],{},[26,742,743,744,149],{},"Active les tags dans le panneau Filtre, ou comme ",[30,745,746],{},"puces sous la barre de recherche",[26,748,749,750,753,754,757],{},"Le match est ",[30,751,752],{},"OU"," : un son reste visible s’il a ",[30,755,756],{},"n’importe quel"," tag sélectionné.",[26,759,760,761,764,765,768],{},"Le champ ",[30,762,763],{},"Recherche"," combine en ",[30,766,767],{},"ET"," avec le filtre de tags actif (saisie + tags ensemble).",[26,770,771],{},"Désactive les puces (ou vide le filtre) pour revoir tout l’onglet.",[14,773,774,775,149],{},"Les noms de tags colorés peuvent apparaître sur les boutons. Active-les dans ",[30,776,777],{},"Paramètres → Comportement → Afficher les badges de tags",[18,779,781],{"id":780},"tri","Tri",[14,783,784],{},"Ouvre le panneau filtre et choisis un mode :",[66,786,787,793],{},[26,788,789,792],{},[30,790,791],{},"Défini par l’utilisateur"," — ton ordre d’onglet, groupes visibles",[26,794,795,401,798,401,801,100,804,807,808],{},[30,796,797],{},"Nom",[30,799,800],{},"Date d’ajout",[30,802,803],{},"Durée de lecture",[30,805,806],{},"Taille de fichier"," — liste plate triée ; ",[30,809,810],{},"les groupes sont masqués",[14,812,813],{},"Le tri par durée peut préchauffer les métadonnées de durée la première fois.",[18,815,817],{"id":816},"réordonner","Réordonner",[14,819,820,821,824,825,828,829,149],{},"Active le glisser-déposer dans ",[30,822,823],{},"Paramètres → Comportement"," (",[30,826,827],{},"Autoriser le réordonnancement","). Puis glisse sons et groupes en place. Le réordonnancement s’applique en tri ",[30,830,791],{},[18,832,834],{"id":833},"sélection-multiple","Sélection multiple",[14,836,837,838,840],{},"Active ",[30,839,834],{}," dans la barre de navigation, puis :",[66,842,843,846,852,859],{},[26,844,845],{},"Clique pour basculer un son",[26,847,848,851],{},[30,849,850],{},"Maj+clic"," pour une plage depuis le dernier ancrage",[26,853,854,855,858],{},"Trace un ",[30,856,857],{},"rectangle"," sur l’espace vide du board",[26,860,861],{},"Clique le board vide (ou à l’extérieur) pour vider la sélection",[14,863,864,865,401,868,401,871,874,875,149],{},"Une barre groupée affiche le compte, plus ",[30,866,867],{},"Couleur",[30,869,870],{},"Déplacer vers l’onglet…",[30,872,873],{},"Supprimer"," et ",[30,876,877],{},"Terminé",[14,879,880,881,884],{},"En sélection multiple, chaque bouton montre une ",[30,882,883],{},"puce d’ID de 8 caractères",". Clic droit sur la puce pour la copier.",[18,886,888],{"id":887},"volume-par-son","Volume par son",[14,890,891,892,895,896,899],{},"Clic droit → ",[30,893,894],{},"Volume",". Glisse le curseur de 0 % à 100 %. ",[30,897,898],{},"Double-clic"," le remet à 100 %.",[14,901,902],{},"Ça se cumule avec le volume de sortie principal dans les Paramètres.",[18,904,906],{"id":905},"raccourcis-et-ids-de-son","Raccourcis et IDs de son",[14,908,909,910,913],{},"Chaque son a un ID de 8 caractères. Copie-le depuis le menu contextuel du bouton (",[30,911,912],{},"Copier l’ID",") ou la puce d’ID de la sélection multiple.",[14,915,28,916,919,920,923],{},[30,917,918],{},"Paramètres → Raccourcis"," pour lier une touche à un ID de son. Les raccourcis globaux sont optionnels. ",[30,921,922],{},"Assigner un raccourci"," dans le menu contextuel y saute avec l’ID déjà rempli.",[14,925,926,927,929],{},"Le même ID est ce que ",[88,928,241],{"href":240}," utilise pour déclencher un clip.",[18,931,933],{"id":932},"images-de-fond-et-couleurs","Images de fond et couleurs",[14,935,936,937,941],{},"Clic droit sur un son pour régler des couleurs par bouton ou une image de fond. C’est séparé du ",[88,938,940],{"href":939},"\u002Fdocs\u002Ftheme-editor","Theme Creator",", qui habille tout le board.",[14,943,944,945,948],{},"Le sélecteur est une boîte ",[30,946,947],{},"Image de fond"," (PNG, JPEG, GIF, WebP) :",[66,950,951,957],{},[26,952,953,956],{},[30,954,955],{},"Fichiers locaux"," — ajouter des dossiers, choisir un fichier, chercher par nom, prévisualiser la grille, retirer un dossier de la bibliothèque",[26,958,959,962,963,965],{},[30,960,961],{},"KLIPY"," — chercher des GIF en ligne. Mets ta propre clé API dans ",[30,964,823],{},". La clé n’est pas stockée dans les fichiers projet.",[14,967,968],{},"Après le choix, recadre et décale l’image sur le bouton.",{"title":151,"searchDepth":152,"depth":152,"links":970},[971,972,973,978,979,980,981,982,983],{"id":604,"depth":152,"text":605},{"id":642,"depth":152,"text":643},{"id":676,"depth":152,"text":677,"children":974},[975,976,977],{"id":691,"depth":164,"text":692},{"id":727,"depth":164,"text":728},{"id":737,"depth":164,"text":738},{"id":780,"depth":152,"text":781},{"id":816,"depth":152,"text":817},{"id":833,"depth":152,"text":834},{"id":887,"depth":152,"text":888},{"id":905,"depth":152,"text":906},{"id":932,"depth":152,"text":933},"Tags, filtres, onglets, groupes, tri, sélection multiple, volume et raccourcis.",{},4,"\u002Forganizing-sounds",{"title":148,"description":984},"organizing-sounds","3ZEh-vX7bLxxdpr56sVGIToyf64-wDiiegH_atr9lbk",{"id":992,"title":993,"body":994,"description":1120,"extension":161,"meta":1121,"navigation":163,"order":1122,"path":1123,"seo":1124,"stem":1125,"__hash__":1126},"content_fr\u002Ftheme-editor.md","Éditeur de thème",{"type":7,"value":995,"toc":11