98,33,500,37],{},[30,499,32],{},[30,501,36],{},[26,503,40],{},[26,505,43],{},[18,507,47],{"id":46},[23,509,510,516,518],{},[26,511,28,512,55,514,58],{},[30,513,54],{},[30,515,47],{},[26,517,61],{},[26,519,64,520],{},[66,521,522,526],{},[26,523,524,73],{},[30,525,72],{},[26,527,528,79],{},[30,529,78],{},[18,531,83],{"id":82},[14,533,86,534,92,536,96,538,100,540,104],{},[88,535,91],{"href":90},[30,537,95],{},[30,539,99],{},[30,541,103],{},[18,543,108],{"id":107},[14,545,546,114,548,119,550,123],{},[30,547,113],{},[116,549,118],{},[116,551,122],{},[14,553,126],{},[18,555,130],{"id":129},[14,557,133,558,137],{},[30,559,136],{},[18,561,141],{"id":140},[14,563,144,564,149],{},[88,565,148],{"href":147},{"title":151,"searchDepth":152,"depth":152,"links":567},[568,569,570,571,572,573],{"id":20,"depth":152,"text":21},{"id":46,"depth":152,"text":47},{"id":82,"depth":152,"text":83},{"id":107,"depth":152,"text":108},{"id":129,"depth":152,"text":130},{"id":140,"depth":152,"text":141},{},{"title":5,"description":160},{"id":577,"title":148,"body":578,"description":724,"extension":161,"meta":725,"navigation":163,"order":726,"path":727,"seo":728,"stem":729,"__hash__":730},"content_fr\u002Forganizing-sounds.md",{"type":7,"value":579,"toc":715},[580,583,586,590,617,624,628,631,645,652,656,662,666,677,681,684,688,691,697,703,707],[10,581,148],{"id":582},"organiser-les-sons",[14,584,585],{},"SoundNinja est conçu pour les grandes bibliothèques. Utilise les onglets, les groupes, la recherche et les raccourcis pour que le clip dont tu as besoin soit à un clic (ou une touche) près.",[18,587,589],{"id":588},"onglets","Onglets",[66,591,592,599,606],{},[26,593,594,595,598],{},"Ajoute un onglet avec ",[30,596,597],{},"Ajouter un onglet",". Donne-lui une couleur pour scanner la barre vite.",[26,600,601,602,605],{},"La vue ",[30,603,604],{},"Tous"," montre chaque son à travers les onglets.",[26,607,608,609,612,613,616],{},"Un son peut appartenir à ",[30,610,611],{},"un ou plusieurs onglets",". Clic droit sur un son et utilise ",[30,614,615],{},"Déplacer vers l’onglet"," pour l’assigner.",[14,618,619,620,623],{},"Les transitions d’onglets sont dans ",[30,621,622],{},"Paramètres → Général"," : Slide, Fade, Boutons un par un, ou Aucune.",[18,625,627],{"id":626},"groupes","Groupes",[14,629,630],{},"Depuis la v0.5.3, les séparateurs peuvent devenir des groupes nommés :",[66,632,633,636,639,642],{},[26,634,635],{},"Ajouter, renommer ou supprimer un groupe depuis le menu contextuel",[26,637,638],{},"Glisser l’en-tête du groupe — les enfants suivent",[26,640,641],{},"Déposer des sons dans un groupe ou les en sortir",[26,643,644],{},"Régler la couleur de bordure, la couleur du nom et l’alignement des boutons (ou utiliser le défaut de l’onglet)",[14,646,647,648,651],{},"Tu peux toujours ajouter un ",[30,649,650],{},"Séparateur"," simple si tu as seulement besoin d’une coupure visuelle.",[18,653,655],{"id":654},"recherche","Recherche",[14,657,658,659,661],{},"Utilise le champ ",[30,660,655],{}," dans la barre de navigation. Les résultats se mettent à jour pendant que tu tapes.",[18,663,665],{"id":664},"réordonner","Réordonner",[14,667,668,669,672,673,676],{},"Active le glisser-déposer dans ",[30,670,671],{},"Paramètres → Comportement"," (",[30,674,675],{},"Autoriser le réordonnancement","). Puis glisse sons et groupes en place.",[18,678,680],{"id":679},"édition-groupée","Édition groupée",[14,682,683],{},"Sélectionne plusieurs sons, puis change la couleur, déplace-les vers un onglet ou supprime-les en une étape.",[18,685,687],{"id":686},"raccourcis-et-ids-de-son","Raccourcis et IDs de son",[14,689,690],{},"Chaque son a un ID de 8 caractères. Copie-le depuis le menu contextuel du bouton ou la puce d’ID de la sélection multiple.",[14,692,28,693,696],{},[30,694,695],{},"Paramètres → Raccourcis"," pour lier une touche à un ID de son. Les raccourcis globaux sont optionnels.",[14,698,699,700,702],{},"Le même ID est ce que ",[88,701,232],{"href":231}," utilise pour déclencher un clip.",[18,704,706],{"id":705},"gifs-et-couleurs","GIFs et couleurs",[14,708,709,710,714],{},"Clic droit sur un son pour régler des couleurs par bouton ou un fond GIF \u002F image. C’est séparé du ",[88,711,713],{"href":712},"\u002Fdocs\u002Ftheme-editor","Theme Creator",", qui habille tout le board.",{"title":151,"searchDepth":152,"depth":152,"links":716},[717,718,719,720,721,722,723],{"id":588,"depth":152,"text":589},{"id":626,"depth":152,"text":627},{"id":654,"depth":152,"text":655},{"id":664,"depth":152,"text":665},{"id":679,"depth":152,"text":680},{"id":686,"depth":152,"text":687},{"id":705,"depth":152,"text":706},"Onglets, groupes, recherche, édition groupée et raccourcis.",{},4,"\u002Forganizing-sounds",{"title":148,"description":724},"organizing-sounds","s3oaYG46DStsSAtCx2-Sgrn_LoxScaKkOmEWwKlXmKQ",{"id":732,"title":733,"body":734,"description":860,"extension":161,"meta":861,"navigation":163,"order":862,"path":863,"seo":864,"stem":865,"__hash__":866},"content_fr\u002Ftheme-editor.md","Éditeur de thème",{"type":7,"value":735,"toc":854},[736,739,745,749,776,779,783,797,801,827,830,834,840],[10,737,733],{"id":738},"éditeur-de-thème",[14,740,741,742,149],{},"Le Theme Creator est l’éditeur visuel complet de ton board. Ouvre-le depuis ",[30,743,744],{},"Paramètres → Général → Theme Creator",[18,746,748],{"id":747},"trois-onglets","Trois onglets",[23,750,751,765,771],{},[26,752,753,756,757,760,761,764],{},[30,754,755],{},"Général"," — nom du thème, couleurs partagées et import de polices (",[116,758,759],{},".ttf"," \u002F ",[116,762,763],{},".otf",")",[26,766,767,770],{},[30,768,769],{},"Boutons"," — couleurs, typo, disposition et overlay GIF des boutons de son",[26,772,773,775],{},[30,774,589],{}," — couleurs, typo et épaisseur de bordure de la barre d’onglets",[14,777,778],{},"Un aperçu en direct montre onglets et boutons pendant que tu édites.",[18,780,782],{"id":781},"ce-que-tu-peux-changer","Ce que tu peux changer",[66,784,785,788,791,794],{},[26,786,787],