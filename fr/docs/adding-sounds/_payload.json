129,"depth":152,"text":130},{"id":140,"depth":152,"text":141},{},{"title":5,"description":160},{"id":610,"title":148,"body":611,"description":1015,"extension":161,"meta":1016,"navigation":163,"order":1017,"path":1018,"seo":1019,"stem":1020,"__hash__":1021},"content_fr\u002Forganizing-sounds.md",{"type":7,"value":612,"toc":1000},[613,616,623,627,654,661,665,668,682,689,695,699,709,714,746,750,756,760,793,799,803,806,832,835,839,852,856,862,883,899,906,910,921,924,928,935,945,951,955,963,970,997],[10,614,148],{"id":615},"organiser-les-sons",[14,617,618,619,622],{},"SoundNinja est conçu pour les grandes bibliothèques. ",[30,620,621],{},"Tags et filtres",", onglets, recherche, sélection multiple et raccourcis — le clip dont tu as besoin est à un clic (ou une touche) près.",[18,624,626],{"id":625},"onglets","Onglets",[66,628,629,636,643],{},[26,630,631,632,635],{},"Ajoute un onglet avec ",[30,633,634],{},"Ajouter un onglet",". Donne-lui une couleur pour scanner la barre vite.",[26,637,638,639,642],{},"La vue ",[30,640,641],{},"Tous"," montre chaque son à travers les onglets.",[26,644,645,646,649,650,653],{},"Un son peut appartenir à ",[30,647,648],{},"un ou plusieurs onglets",". Clic droit sur un son et utilise ",[30,651,652],{},"Déplacer vers l’onglet"," pour l’assigner.",[14,655,656,657,660],{},"Les transitions d’onglets sont dans ",[30,658,659],{},"Paramètres → Général"," : Slide, Fade, Boutons un par un, ou Aucune.",[18,662,664],{"id":663},"groupes","Groupes",[14,666,667],{},"Depuis la v0.5.3, les séparateurs peuvent devenir des groupes nommés :",[66,669,670,673,676,679],{},[26,671,672],{},"Ajouter, renommer ou supprimer un groupe depuis le menu contextuel",[26,674,675],{},"Glisser l’en-tête du groupe — les enfants suivent",[26,677,678],{},"Déposer des sons dans un groupe ou les en sortir",[26,680,681],{},"Régler la couleur de bordure, la couleur du nom et l’alignement des boutons (ou utiliser le défaut de l’onglet)",[14,683,684,685,688],{},"Tu peux toujours ajouter un ",[30,686,687],{},"Séparateur"," simple si tu as seulement besoin d’une coupure visuelle.",[14,690,691,692,149],{},"Clic droit sur l’espace vide du board pour ",[30,693,694],{},"Ajouter un groupe",[18,696,698],{"id":697},"tags-filtres","Tags \u002F Filtres",[14,700,701,702,705,706,708],{},"Les tags traversent les onglets. Le panneau ",[30,703,704],{},"Filtre"," (barre latérale ",[30,707,704],{},") sert à les créer et à filtrer le board.",[710,711,713],"h3",{"id":712},"créer-et-modifier-des-tags","Créer et modifier des tags",[23,715,716,721,732,739],{},[26,717,28,718,720],{},[30,719,704],{}," dans la barre latérale.",[26,722,723,724,727,728,731],{},"Sous ",[30,725,726],{},"Tags",", utilise ",[30,729,730],{},"Ajouter un tag"," — nom et couleur.",[26,733,734,735,738],{},"Renomme, recolore ou ",[30,736,737],{},"Supprimer le tag"," dans la même liste.",[26,740,741,742,745],{},"Si tu vois ",[30,743,744],{},"Aucun tag pour l’instant",", crée-en un ici avant d’assigner.",[710,747,749],{"id":748},"assigner-des-tags-aux-sons","Assigner des tags aux sons",[14,751,752,753,755],{},"Clic droit sur un son → ",[30,754,726],{}," (cases à cocher). Un son peut avoir plusieurs tags. S’il n’y en a encore aucun, le menu pointe vers le panneau filtre.",[710,757,759],{"id":758},"filtrer-le-board","Filtrer le board",[66,761,762,768,779,790],{},[26,763,764,765,149],{},"Active les tags dans le panneau Filtre, ou comme ",[30,766,767],{},"puces sous la barre de recherche",[26,769,770,771,774,775,778],{},"Le match est ",[30,772,773],{},"OU"," : un son reste visible s’il a ",[30,776,777],{},"n’importe quel"," tag sélectionné.",[26,780,781,782,785,786,789],{},"Le champ ",[30,783,784],{},"Recherche"," combine en ",[30,787,788],{},"ET"," avec le filtre de tags actif (saisie + tags ensemble).",[26,791,792],{},"Désactive les puces (ou vide le filtre) pour revoir tout l’onglet.",[14,794,795,796,149],{},"Les noms de tags colorés peuvent apparaître sur les boutons. Active-les dans ",[30,797,798],{},"Paramètres → Comportement → Afficher les badges de tags",[18,800,802],{"id":801},"tri","Tri",[14,804,805],{},"Ouvre le panneau filtre et choisis un mode :",[66,807,808,814],{},[26,809,810,813],{},[30,811,812],{},"Défini par l’utilisateur"," — ton ordre d’onglet, groupes visibles",[26,815,816,401,819,401,822,100,825,828,829],{},[30,817,818],{},"Nom",[30,820,821],{},"Date d’ajout",[30,823,824],{},"Durée de lecture",[30,826,827],{},"Taille de fichier"," — liste plate triée ; ",[30,830,831],{},"les groupes sont masqués",[14,833,834],{},"Le tri par durée peut préchauffer les métadonnées de durée la première fois.",[18,836,838],{"id":837},"réordonner","Réordonner",[14,840,841,842,845,846,849,850,149],{},"Active le glisser-déposer dans ",[30,843,844],{},"Paramètres → Comportement"," (",[30,847,848],{},"Autoriser le réordonnancement","). Puis glisse sons et groupes en place. Le réordonnancement s’applique en tri ",[30,851,812],{},[18,853,855],{"id":854},"sélection-multiple","Sélection multiple",[14,857,858,859,861],{},"Active ",[30,860,855],{}," dans la barre de navigation, puis :",[66,863,864,867,873,880],{},[26,865,866],{},"Clique pour basculer un son",[26,868,869,872],{},[30,870,871],{},"Maj+clic"," pour une plage depuis le dernier ancrage",[26,874,875,876,879],{},"Trace un ",[30,877,878],{},"rectangle"," sur l’espace vide du board",[26,881,882],{},"Clique le board vide (ou à l’extérieur) pour vider la sélection",[14,884,885,886,401,889,401,892,895,896,149],{},"Une barre groupée affiche le compte, plus ",[30,887,888],{},"Couleur",[30,890,891],{},"Déplacer vers l’onglet…",[30,893,894],{},"Supprimer"," et ",[30,897,898],{},"Terminé",[14,900,901,902,905],{},"En sélection multiple, chaque bouton montre une ",[30,903,904],{},"puce d’ID de 8 caractères",". Clic droit sur la puce pour la copier.",[18,907,909],{"id":908},"volume-par-son","Volume par son",[14,911,912,913,916,917,920],{},"Clic droit → ",[30,914,915],{},"Volume",". Glisse le curseur de 0 % à 100 %. ",[30,918,919],{}