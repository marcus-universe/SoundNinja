91,1093],{"id":1092},"sans-léditeur-complet","Sans l’éditeur complet",[14,1095,1096,1097,1099],{},"Dans ",[30,1098,638],{}," tu peux toujours :",[66,1101,1102,1105,1111],{},[26,1103,1104],{},"Choisir un thème dans la liste",[26,1106,1107,1108,1024],{},"Éditer les variables CSS en direct (",[30,1109,1110],{},"CSS personnalisé",[26,1112,1113],{},"Importer un fichier de thème dans le dossier Themes",{"title":151,"searchDepth":152,"depth":152,"links":1115},[1116,1117,1118,1119],{"id":1007,"depth":152,"text":1008},{"id":1041,"depth":152,"text":1042},{"id":1059,"depth":152,"text":1060},{"id":1092,"depth":152,"text":1093},"Concevoir couleurs, polices, boutons et onglets dans le Theme Creator.",{},5,"\u002Ftheme-editor",{"title":993,"description":1120},"theme-editor","wkR6rxJNnSmcJeJxDdslCOIyK7-9BblSMG_tJA6IwRY",{"id":1128,"title":1129,"body":1130,"description":1267,"extension":161,"meta":1268,"navigation":163,"order":1269,"path":1270,"seo":1271,"stem":1272,"__hash__":1273},"content_fr\u002Frecording-editor.md","Éditeur d’enregistrement",{"type":7,"value":1131,"toc":1261},[1132,1135,1141,1145,1151,1171,1174,1178,1203,1207,1221,1225,1240,1251],[10,1133,1129],{"id":1134},"éditeur-denregistrement",[14,1136,1137,1138,1140],{},"Enregistre un clip dans SoundNinja, coupe-le, puis importe-le sur un onglet. Ouvre l’éditeur avec le bouton ",[30,1139,95],{}," dans la barre du lecteur.",[18,1142,1144],{"id":1143},"choisir-une-entrée","Choisir une entrée",[14,1146,1096,1147,1150],{},[30,1148,1149],{},"Paramètres → Audio"," :",[66,1152,1153,1159,1165],{},[26,1154,1155,1158],{},[30,1156,1157],{},"Périphériques d’entrée"," — microphone",[26,1160,1161,1164],{},[30,1162,1163],{},"Périphériques de sortie (audio PC)"," — loopback de ce que le PC joue",[26,1166,1167,1170],{},[30,1168,1169],{},"Volume d’entrée"," — gain de capture de 0 % à 200 %",[14,1172,1173],{},"Le bouton Enregistrer utilise le périphérique choisi ici.",[18,1175,1177],{"id":1176},"éditer-la-prise","Éditer la prise",[66,1179,1180,1183,1186,1194,1197,1200],{},[26,1181,1182],{},"Enregistrer et arrêter",[26,1184,1185],{},"Surveiller le vu-mètre d’entrée",[26,1187,1188,100,1191],{},[30,1189,1190],{},"Normaliser",[30,1192,1193],{},"Réduction de bruit",[26,1195,1196],{},"Couper tout le clip, couper à une sélection, ou supprimer une sélection",[26,1198,1199],{},"Annuler \u002F rétablir",[26,1201,1202],{},"Zoomer et dézoomer",[18,1204,1206],{"id":1205},"préparer-et-importer","Préparer et importer",[23,1208,1209,1212,1215],{},[26,1210,1211],{},"Ajoute la sélection ou la piste complète à la liste de staging.",[26,1213,1214],{},"La liste commence vide : enregistre, édite, puis ajoute un clip.",[26,1216,1217,100,1219,104],{},[30,1218,99],{},[30,1220,103],{},[18,1222,1224],{"id":1223},"séparation-de-stems-optionnel","Séparation de stems (optionnel)",[14,1226,1227,1228,1231,1232,1235,1236,1239],{},"Les builds officiels Windows, macOS et Linux livrent la fonction ",[30,1229,1230],{},"stems",". Le Record Editor peut garder les ",[30,1233,1234],{},"voix"," ou la ",[30,1237,1238],{},"musique"," avec BS-RoFormer.",[14,1241,1242,1243,1246,1247,1250],{},"Le modèle fait environ 158 MB et n’est ",[30,1244,1245],{},"pas"," inclus dans l’installateur. Télécharge-le depuis ",[30,1248,1249],{},"Paramètres → Séparation de stems",", ou accepte l’invite au premier lancement. L’installateur Windows peut aussi proposer de télécharger le modèle au premier démarrage.",[14,1252,1253,1254,1020,1257,1260],{},"Les builds source custom ont besoin d’un flag extra (",[116,1255,1256],{},"tauri:serve:stems",[116,1258,1259],{},"tauri:build:stems",").",{"title":151,"searchDepth":152,"depth":152,"links":1262},[1263,1264,1265,1266],{"id":1143,"depth":152,"text":1144},{"id":1176,"depth":152,"text":1177},{"id":1205,"depth":152,"text":1206},{"id":1223,"depth":152,"text":1224},"Capturer le micro ou l’audio du PC, éditer le clip et le poser sur ton board.",{},6,"\u002Frecording-editor",{"title":1129,"description":1267},"recording-editor","ZMpimB13mAmCTr4lHYb896wJ8oA5QijFuonM7e0rJU8",{"id":1275,"title":1276,"body":1277,"description":1489,"extension":161,"meta":1490,"navigation":163,"order":1491,"path":1492,"seo":1493,"stem":1494,"__hash__":1495},"content_fr\u002Fremote-control.md","Contrôle à distance",{"type":7,"value":1278,"toc":1482},[1279,1282,1285,1289,1318,1321,1324,1359,1363,1383,1386,1390,1422,1426,1432],[10,1280,1276],{"id":1281},"contrôle-à-distance",[14,1283,1284],{},"SoundNinja peut écouter sur ton réseau local pour que Bitfocus Companion (ou n’importe quel client HTTP\u002FWebSocket) joue et arrête des sons.",[18,1286,1288],{"id":1287},"activer-le-serveur-distant","Activer le serveur distant",[23,1290,1291,1296,1302,1308],{},[26,1292,28,1293,149],{},[30,1294,1295],{},"Paramètres → Distant",[26,1297,1298,1299,149],{},"Active le serveur distant. Le port par défaut est ",[30,1300,1301],{},"7331",[26,1303,1304,1305,149],{},"Optionnel : définis un token. Les clients doivent l’envoyer comme Bearer token ou ",[116,1306,1307],{},"?token=",[26,1309,1310,1311,1314,1315,149],{},"Copie l’URL ",[116,1312,1313],{},"http:\u002F\u002FIP:PORT",", ou copie l’IP système depuis ",[30,1316,1317],{},"Paramètres → À propos",[14,1319,1320],{},"Windows peut afficher une invite pare-feu la première fois que le serveur démarre. Autorise l’accès au réseau privé.",[18,1322,241],{"id":1323},"bitfocus-companion",[23,1325,1326,1333,1342,1352],{},[26,1327,1328,1329,149],{},"Installe ",[88,1330,241],{"href":1331,"rel":1332},"https:\u002F\u002Fbitfocus.io\u002Fcompanion",[259],[26,1334,1335,1336,1341],{},"Télécharge ",[88,1337,1340],{"href":1338,"rel":1339},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Freleases\u002Flatest\u002Fdownload\u002FSoundNinja-Companion.tgz",[259],"SoundNinja-Companion.tgz",". Il n’y a pas encore de paquet Companion Store.",[26,1343,1344,1345,1348,1349,149],{},"Dans Companion : ",[30,1346,1347],{},"Modules → Load module package"," et choisis le ",[116,1350,1351],{},".tgz",[26,1353,1354,1355,1358],{},"Ajoute une connexion ",[30,1356,1357],{},"Sound Ninja",". Colle l’IP du PC, le port, et le token si tu en as défini un.",[18,1360,1362],{"id":1361},"actions","Actions",[66,1364,1365,1371,1377],{},[26,1366,1367,1370],{},[30,1368,1369],{},"Trigger Sound"," — choisis dans le menu déroulant live, ou tape un ID de son de 8 caractères (les variables Companion marchent)",[26,1372,1373,1376],{},[30,1374,1375],{},"Stop Sound"," — arrête un son en lecture par ID",[26,1378,1379,1382],{},[30,1380,1381],{},"Stop All"," — arrête tous les sons en lecture",[14,1384,1385],{},"Copie un ID de son dans SoundNinja depuis le menu contextuel du bouton ou la puce d’ID de la sélection multiple.",[18,1387,1389],{"id":1388},"feedbacks-et-variables","Feedbacks et variables",[66,1391,1392,1398,1410,1416],{},[26,1393,1394,1397],{},[30,1395,1396],{},"Sound Playing"," — vrai tant que cet ID de son est actif (utilise-le pour la couleur du bouton)",[26,1399,1400,1403,1404,1020,1407],{},[116,1401,1402],{},"$(soundninja:connected)"," — ",[116,1405,1406],{},"true",[116,1408,1409],{},"false",[26,1411,1412,1415],{},[116,1413,1414],{},"$(soundninja:playing_count)"," — combien de sons jouent",[26,1417,1418,1421],{},[116,1419,1420],{},"$(soundninja:last_triggered)"," — dernier ID de son déclenché",[18,1423,1425],{"id":1424},"api-http-avancé","API HTTP (avancé)",[14,1427,1428,1429],{},"Chemin de base : ",[116,1430,1431],{},"\u002Fapi\u002Fv1",[66,1433,1434,1440,1446,1452,1462,1468,1476],{},[26,1435,1436,1439],{},[116,1437,1438],{},"GET \u002Finfo"," — nom de l’app, version, protocole, si un token est requis",[26,1441,1442,1445],{},[116,1443,1444],{},"GET \u002Fsounds"," — liste des sons (id, name, tabs, active)",[26,1447,1448,1451],{},[116,1449,1450],{},"GET \u002Fstate"," — sons plus IDs actuellement en lecture",[26,1453,1454,1457,1458,1461],{},[116,1455,1456],{},"POST \u002Ftrigger"," avec ",[116,1459,1460],{},"{ \"id\" }"," — jouer un son",[26,1463,1464,1467],{},[116,1465,14