6,597],{},"Importer"," dans la barre de navigation.",[26,600,601],{},"Choisis un ou plusieurs fichiers audio.",[26,603,604],{},"Les sons arrivent dans l’onglet actuel.",[18,606,608],{"id":607},"importer-des-dossiers","Importer des dossiers",[23,610,611,620,623],{},[26,612,28,613,616,617,619],{},[30,614,615],{},"Fichier → Importer des dossiers"," (ou ",[30,618,608],{}," dans la barre de navigation).",[26,621,622],{},"Ajoute un ou plusieurs dossiers. Glisse pour les réordonner avant l’import.",[26,624,625,626],{},"Choisis comment ils arrivent :\n",[106,627,628,634],{},[26,629,630,633],{},[30,631,632],{},"Importer comme onglets"," — chaque dossier devient son propre onglet",[26,635,636,639],{},[30,637,638],{},"Importer dans l’onglet actuel"," — chaque fichier va dans l’onglet actif",[18,641,643],{"id":642},"enregistrer-un-clip","Enregistrer un clip",[14,645,646,647,651,652,655,656,405,659,662],{},"Ouvre le ",[70,648,650],{"href":649},"\u002Fdocs\u002Frecording-editor","Record Editor"," depuis le bouton ",[30,653,654],{},"Enregistrer"," dans la barre du lecteur. Capture, coupe, puis ",[30,657,658],{},"Importer la sélection",[30,660,661],{},"Tout importer"," dans l’onglet actuel ou un onglet que tu choisis.",[18,664,666],{"id":665},"importer-un-soundboard","Importer un soundboard",[14,668,669,672,673,676,677,680],{},[30,670,671],{},"Fichier → Importer un soundboard"," charge un pack partagé. Les packs sont un ",[44,674,675],{},".zip"," qui contient ",[44,678,679],{},"project.sninja"," plus les fichiers audio. Après l’import, ouvre le projet et joue.",[14,682,683],{},"Tu peux aussi garder plusieurs projets (profils). Utilise le sélecteur de projet pour changer de board.",[18,685,687],{"id":686},"relier-les-fichiers-manquants","Relier les fichiers manquants",[14,689,690,691,694],{},"Si des fichiers audio bougent sur le disque, SoundNinja affiche ",[30,692,693],{},"Fichiers audio manquants",". Choisis un dossier à parcourir et relie les clips.",[18,696,698],{"id":697},"suite","Suite",[14,700,701,702,33],{},"Organise onglets, tags, filtres et raccourcis dans ",[70,703,704],{"href":357},"Organiser les sons",{"title":227,"searchDepth":228,"depth":228,"links":706},[707,708,709,710,711,712],{"id":585,"depth":228,"text":586},{"id":607,"depth":228,"text":608},{"id":642,"depth":228,"text":643},{"id":665,"depth":228,"text":666},{"id":686,"depth":228,"text":687},{"id":697,"depth":228,"text":698},"Importe de l’audio, des dossiers, des enregistrements et des soundboards partagés.",{},3,"\u002Fadding-sounds",{"title":352,"description":713},"adding-sounds","4l04_lLfE4dqOPh8H0Rav69GnvCVi_PKTEgAepysTeI",{"id":721,"title":704,"body":722,"description":1116,"extension":236,"meta":1117,"navigation":238,"order":1118,"path":1119,"seo":1120,"stem":1121,"__hash__":1122},"content_fr\u002Forganizing-sounds.md",{"type":7,"value":723,"toc":1101},[724,727,734,738,765,772,776,779,793,800,806,810,820,825,857,861,867,871,904,910,914,917,943,946,950,963,967,973,994,1010,1017,1021,1032,1035,1039,1046,1056,1062,1066,1074,1081,1098],[10,725,704],{"id":726},"organiser-les-sons",[14,728,729,730,733],{},"SoundNinja est conçu pour les grandes bibliothèques. ",[30,731,732],{},"Tags et filtres",", onglets, recherche, sélection multiple et raccourcis — le clip dont tu as besoin est à un clic (ou une touche) près.",[18,735,737],{"id":736},"onglets","Onglets",[106,739,740,747,754],{},[26,741,742,743,746],{},"Ajoute un onglet avec ",[30,744,745],{},"Ajouter un onglet",". Donne-lui une couleur pour scanner la barre vite.",[26,748,749,750,753],{},"La vue ",[30,751,752],{},"Tous"," montre chaque son à travers les onglets.",[26,755,756,757,760,761,764],{},"Un son peut appartenir à ",[30,758,759],{},"un ou plusieurs onglets",". Clic droit sur un son et utilise ",[30,762,763],{},"Déplacer vers l’onglet"," pour l’assigner.",[14,766,767,768,771],{},"Les transitions d’onglets sont dans ",[30,769,770],{},"Paramètres → Général"," : Slide, Fade, Boutons un par un, ou Aucune.",[18,773,775],{"id":774},"groupes","Groupes",[14,777,778],{},"Depuis la v0.5.3, les séparateurs peuvent devenir des groupes nommés :",[106,780,781,784,787,790],{},[26,782,783],{},"Ajouter, renommer ou supprimer un groupe depuis le menu contextuel",[26,785,786],{},"Glisser l’en-tête du groupe — les enfants suivent",[26,788,789],{},"Déposer des sons dans un groupe ou les en sortir",[26,791,792],{},"Régler la couleur de bordure, la couleur du nom et l’alignement des boutons (ou utiliser le défaut de l’onglet)",[14,794,795,796,799],{},"Tu peux toujours ajouter un ",[30,797,798],{},"Séparateur"," simple si tu as seulement besoin d’une coupure visuelle.",[14,801,802,803,33],{},"Clic droit sur l’espace vide du board pour ",[30,804,805],{},"Ajouter un groupe",[18,807,809],{"id":808},"tags-filtres","Tags \u002F Filtres",[14,811,812,813,816,817,819],{},"Les tags traversent les onglets. Le panneau ",[30,814,815],{},"Filtre"," (barre latérale ",[30,818,815],{},") sert à les créer et à filtrer le board.",[821,822,824],"h3",{"id":823},"créer-et-modifier-des-tags","Créer et modifier des tags",[23,826,827,832,843,850],{},[26,828,28,829,831],{},[30,830,815],{}," dans la barre latérale.",[26,833,834,835,838,839,842],{},"Sous ",[30,836,837],{},"Tags",", utilise ",[30,840,841],{},"Ajouter un tag"," — nom et couleur.",[26,844,845,846,849],{},"Renomme, recolore ou ",[30,847,848],{},"Supprimer le tag"," dans la même liste.",[26,851,852,853,856],{},"Si tu vois ",[30,854,855],{},"Aucun tag pour l’instant",", crée-en un ici avant d’assigner.",[821,858,860],{"id":859},"assigner-des-tags-aux-sons","Assigner des tags aux sons",[14,862,863,864,866],{},"Clic droit sur un son → ",[30,865,837],{}," (cases à cocher). Un son peut avoir plusieurs tags. S’il n’y en a encore aucun, le menu pointe vers le panneau filtre.",[821,868,870],{"id":869},"filtrer-le-board","Filtrer le board",[106,872,873,879,890,901],{},[26,874,875,876,33],{},"Active les tags dans le panneau Filtre, ou comme ",[30,877,878],{},"puces sous la barre de recherche",[26,880,881,882,885,886,889],{},"Le match est ",[30,883,884],{},"OU"," : un son reste visible s’il a ",[30,887,888],{},"n’importe quel"," tag sélectionné.",[26,891,892,893,896,897,900],{},"Le champ ",[30,894,895],{},"Recherche"," combine en ",[30,898,899],{},"ET"," avec le filtre de tags actif (saisie + tags ensemble).",[26,902,903],{},"Désactive les puces (ou vide le filtre) pour revoir tout l’onglet.",[14,905,906,907,33],{},"Les noms de tags colorés peuvent apparaître sur les boutons. Active-les dans ",[30,908,909],{},"Paramètres → Comportement → Afficher les badges de tags",[18,911,913],{"id":912},"tri","Tri",[14,915,916],{},"Ouvre le panneau filtre et choisis un mode :",[106,918,919,925],{},[26,920,921,924],{},[30,922,923],{},"Défini par l’utilisateur"," — ton ordre d’onglet, groupes visibles",[26,926,927,477,930,477,933,405,936,939,940],{},[30,928,929],{},"Nom",[30,931,932],{},"Date d’ajout",[30,934,935],{},"Durée de lecture",[30,937,938],{},"Taille de fichier"," — liste plate triée ; ",[30,941,942],{},"les groupes sont masqués",[14,944,945],{},"Le tri par durée peut préchauffer les métadonnées de durée la première fois.",[18,947,949],{"id":948},"réordonner","Réordonner",[14,951,952,953,956,957,960,961,33],{},"Active le glisser-déposer dans ",[30,954,955],{},"Paramètres → Comportement"," (",[30,958,959],{},"Autoriser le réordonnancement","). Puis glisse sons et groupes en place. Le réordonnancement s’applique en tri ",[30,962,923],{},[18,964,966],{"id":965},"sélection-multiple","Sélection multiple",[14,968,969,970,972],{},"Active ",[30,971,966],{}," dans la barre de navigation, puis :",[106,974,975,978,984,991],{},[26,976,977],{},"Clique pour basculer un son",[26,979,980,983],{},[30,981,982],{},"Maj+clic"," pour une plage depuis le dernier ancrage",[26,985,986,987,990],{},"Trace un ",[30,988,989],{},"rectangle"," sur l’espace vide du board",[26,992,993],{},"Clique le board vide (ou à l’extérieur) pour vider la sélection",[14,995,996,997,477,1000,477,1003,1006,1007,33],{},"Une barre groupée affiche le compte, plus ",[30,998,999],{},"Couleur",[30,1001,1002],{},"Déplacer vers l’onglet…",[30,1004,1005],{},"Supprimer"," et ",[30,1008,1009],{},"Terminé",[14,1011,1012,1013,1016],{},"En sélection multiple, chaque bouton montre une ",[30,1014,1015],{},"puce d’ID de 8 caractères",". Clic droit sur la puce pour la copier.",[18,1018,1020],{"id":1019},"volume-par-son","Volume par son",[14,1022,1023,1024,1027,1028,1031],{},"Clic droit → ",[30,1025,1026],{},"Volume",". Glisse le curseur de 0 % à 100 %. ",[30,1029,1030],{},"Double-clic"," le remet à 100 %.",[14,1033,1034],{},"Ça se cumule avec le volume de sortie principal dans les Paramètres.",[18,1036,1038],{"id":1037},"raccourcis-et-ids-de-son","Raccourcis et IDs de son",[14,1040,1041,1042,1045],{},"Chaque son a un ID de 8 caractères. Copie-le depuis le menu contextuel du bouton (",[30,1043,1044],{},"Copier l’ID",") ou la puce d’ID de la sélection multiple.",[14,1047,28,1048,1051,1052,1055],{},[30,1049,1050],{},"Paramètres → Raccourcis"," pour lier une touche à un ID de son. Les raccourcis globaux sont optionnels. ",[30,1053,1054],{},"Assigner un raccourci"," dans le menu contextuel y saute avec l’ID déjà rempli.",[14,1057,1058,1059,1061],{},"Le même ID est ce que ",[70,1060,63],{"href":315}," utilise pour déclencher un clip.",[18,1063,1065],{"id":1064},"images-de-fond-et-couleurs","Images de fond et couleurs",[14,1067,1068,1069,1073],{},"Clic droit sur un son pour régler des couleurs par bouton ou une image de fond. C’est séparé du ",[70,1070,1072],{"href":1071},"\u002Fdocs\u002Ftheme-editor","Theme Creator",", qui habille tout le board.",[14,1075,1076,1077,1080],{},"Le sélecteur est une boîte ",[30,1078,1079],{},"Image de fond"," (PNG, JPEG, GIF, WebP) :",[106,1082,1083,1089],{},[26,1084,1085,1088],{},[30,1086,1087],{},"Fichiers locaux"," — ajouter des dossiers, choisir un fichier, chercher par nom, prévisualiser la grille, retirer un dossier de la bibliothèque",[26,1090,1091,1094,1095,1097],{},[30,1092,1093],{},"KLIPY"," — chercher des GIF en ligne. Mets ta propre clé API dans ",[30,1096,955],{},". La clé n’est pas stockée dans les fichiers projet.",[14,1099,1100],{},"Après le choix, recadre et décale l’image sur le bouton.",{"title":227,"searchDepth":228,"depth":228,"links":1102},[1103,1104,1105,1110,1111,1112,1113,1114,1115],{"id":736,"depth":228,"text":737},{"id":774,"depth":228,"text":775},{"id":808,"depth":228,"text":809,"children":1106},[1107,1108,1109],{"id":823,"depth":715,"text":824},{"id":859,"depth":715,"text":860},{"id":869,"depth":715,"text":870},{"id":912,"depth":228,"text":913},{"id":948,"depth":228,"text":949},{"id":965,"depth":228,"text":966},{"id":1019,"depth":228,"text":1020},{"id":1037,"depth":228,"text":1038},{"id":1064,"depth":228,"text":1065},"Tags, filtres, onglets, groupes, tri, sélection multiple, volume et raccourcis.",{},4,"\u002Forganizing-sounds",{"title":704,"description":1116},"organizing-sounds","3ZEh-vX7bLxxdpr56sVGIToyf64-wDiiegH_atr9lbk",{"id":1124,"title":1125,"body":1126,"description":1251,"extension":236,"meta":1252,"navigation":238,"order":1253,"path":1254,"seo":1255,"stem":1256,"__hash__":1257},"content_fr\u002Ftheme-editor.md","Éditeur de thème",{"type":7,"value":1127,"toc":1245},[1128,1131,1137,1141,1167,1170,1174,1188,1192,1218,1221,1225,1231],[10,1129,1125],{"id":1130},"éditeur-de-thème",[14,1132,1133,1134,33],{},"Le Theme Creator est l’éditeur visuel complet de ton board. Ouvre-le depuis ",[30,1135,1136],{},"Paramètres → Général → Theme Creator",[18,1138,1140],{"id":1139},"trois-onglets","Trois onglets",[23,1142,1143,1156,1162],{},[26,1144,1145,1148,1149,150,1152,1155],{},[30,1146,1147],{},"Général"," — nom du thème, couleurs partagées et import de polices (",[44,1150,1151],{},".ttf",[44,1153,1154],{},".otf",")",[26,1157,1158,1161],{},[30,1159,1160],{},"Boutons"," — couleurs, typo, disposition et overlay GIF des boutons de son",[26,1163,1164,1166],{},[30,1165,737],{}," — couleurs, typo et épaisseur de bordure de la barre d’onglets",[14,1168,1169],{},"Un aperçu en direct montre onglets et boutons pendant que tu édites.",[18,1171,1173],{"id":1172},"ce-que-tu-peux-changer","Ce que tu peux changer",[106,1175,1176,1179,1182,1185],{},[26,1177,1178],{},"Couleurs primaire et d’accent, fonds, couleurs des boutons, couleurs des onglets",[26,1180,1181],{},"Famille et taille de police des boutons et des onglets",[26,1183,1184],{},"Largeur, rayon, bordure, écarts et padding des boutons",[26,1186,1187],{},"Opacité de l’overlay GIF (normal et survol)",[18,1189,1191],{"id":1190},"enregistrer-et-partager","Enregistrer et partager",[106,1193,1194,1200,1206,1212],{},[26,1195,1196,1199],{},[30,1197,1198],{},"Exporter .css"," — écrire un fichier de thème à sauvegarder ou envoyer à un ami",[26,1201,1202,1205],{},[30,1203,1204],{},"Ajouter aux thèmes"," — enregistrer le fichier dans ton dossier Themes et l’appliquer",[26,1207,1208,1211],{},[30,1209,1210],{},"Importer .css"," — charger un preset intégré ou un thème enregistré",[26,1213,1214,1217],{},[30,1215,1216],{},"Réinitialiser"," — revenir aux défauts SoundNinja",[14,1219,1220],{},"Si tu fermes la fenêtre avec des changements non enregistrés, SoundNinja te demande d’enregistrer d’abord.",[18,1222,1224],{"id":1223},"sans-léditeur-complet","Sans l’éditeur complet",[14,1226,1227,1228,1230],{},"Dans ",[30,1229,770],{}," tu peux toujours :",[106,1232,1233,1236,1242],{},[26,1234,1235],{},"Choisir un thème dans la liste",[26,1237,1238,1239,1155],{},"Éditer les variables CSS en direct (",[30,1240,1241],{},"CSS personnalisé",[26,1243,1244],{},"Importer un fichier de thème dans le dossier Themes",{"title":227,"searchDepth":228,"depth":228,"links":1246},[1247,1248,1249,1250],{"id":1139,"depth":228,"text":1140},{"id":1172,"depth":228,"text":1173},{"id":1190,"depth":228,"text":1191},{"id":1223,"depth":228,"text":1224},"Concevoir couleurs, polices, boutons et onglets dans le Theme Creator.",{},5,"\u002Ftheme-editor",{"title