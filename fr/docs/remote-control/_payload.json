[{"data":1,"prerenderedAt":1384},["ShallowReactive",2],{"docs-page-fr-\u002Fremote-control":3,"docs-nav-fr":244},{"id":4,"title":5,"body":6,"description":235,"extension":236,"meta":237,"navigation":238,"order":239,"path":240,"seo":241,"stem":242,"__hash__":243},"content_fr\u002Fremote-control.md","Contrôle à distance",{"type":7,"value":8,"toc":226},"minimark",[9,13,17,22,57,60,64,101,105,126,129,133,166,170,176],[10,11,5],"h1",{"id":12},"contrôle-à-distance",[14,15,16],"p",{},"SoundNinja peut écouter sur ton réseau local pour que Bitfocus Companion (ou n’importe quel client HTTP\u002FWebSocket) joue et arrête des sons.",[18,19,21],"h2",{"id":20},"activer-le-serveur-distant","Activer le serveur distant",[23,24,25,34,40,47],"ol",{},[26,27,28,29,33],"li",{},"Ouvre ",[30,31,32],"strong",{},"Paramètres → Distant",".",[26,35,36,37,33],{},"Active le serveur distant. Le port par défaut est ",[30,38,39],{},"7331",[26,41,42,43,33],{},"Optionnel : définis un token. Les clients doivent l’envoyer comme Bearer token ou ",[44,45,46],"code",{},"?token=",[26,48,49,50,53,54,33],{},"Copie l’URL ",[44,51,52],{},"http:\u002F\u002FIP:PORT",", ou copie l’IP système depuis ",[30,55,56],{},"Paramètres → À propos",[14,58,59],{},"Windows peut afficher une invite pare-feu la première fois que le serveur démarre. Autorise l’accès au réseau privé.",[18,61,63],{"id":62},"bitfocus-companion","Bitfocus Companion",[23,65,66,75,84,94],{},[26,67,68,69,33],{},"Installe ",[70,71,63],"a",{"href":72,"rel":73},"https:\u002F\u002Fbitfocus.io\u002Fcompanion",[74],"nofollow",[26,76,77,78,83],{},"Télécharge ",[70,79,82],{"href":80,"rel":81},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Freleases\u002Flatest\u002Fdownload\u002Fcompanion-module-soundninja.tgz",[74],"companion-module-soundninja.tgz",". Il n’y a pas encore de paquet Companion Store.",[26,85,86,87,90,91,33],{},"Dans Companion : ",[30,88,89],{},"Modules → Load module package"," et choisis le ",[44,92,93],{},".tgz",[26,95,96,97,100],{},"Ajoute une connexion ",[30,98,99],{},"Sound Ninja",". Colle l’IP du PC, le port, et le token si tu en as défini un.",[18,102,104],{"id":103},"actions","Actions",[106,107,108,114,120],"ul",{},[26,109,110,113],{},[30,111,112],{},"Trigger Sound"," — choisis dans le menu déroulant live, ou tape un ID de son de 8 caractères (les variables Companion marchent)",[26,115,116,119],{},[30,117,118],{},"Stop Sound"," — arrête un son en lecture par ID",[26,121,122,125],{},[30,123,124],{},"Stop All"," — arrête tous les sons en lecture",[14,127,128],{},"Copie un ID de son dans SoundNinja depuis le menu contextuel du bouton ou la puce d’ID de la sélection multiple.",[18,130,132],{"id":131},"feedbacks-et-variables","Feedbacks et variables",[106,134,135,141,154,160],{},[26,136,137,140],{},[30,138,139],{},"Sound Playing"," — vrai tant que cet ID de son est actif (utilise-le pour la couleur du bouton)",[26,142,143,146,147,150,151],{},[44,144,145],{},"$(soundninja:connected)"," — ",[44,148,149],{},"true"," \u002F ",[44,152,153],{},"false",[26,155,156,159],{},[44,157,158],{},"$(soundninja:playing_count)"," — combien de sons jouent",[26,161,162,165],{},[44,163,164],{},"$(soundninja:last_triggered)"," — dernier ID de son déclenché",[18,167,169],{"id":168},"api-http-avancé","API HTTP (avancé)",[14,171,172,173],{},"Chemin de base : ",[44,174,175],{},"\u002Fapi\u002Fv1",[106,177,178,184,190,196,206,212,220],{},[26,179,180,183],{},[44,181,182],{},"GET \u002Finfo"," — nom de l’app, version, protocole, si un token est requis",[26,185,186,189],{},[44,187,188],{},"GET \u002Fsounds"," — liste des sons (id, name, tabs, active)",[26,191,192,195],{},[44,193,194],{},"GET \u002Fstate"," — sons plus IDs actuellement en lecture",[26,197,198,201,202,205],{},[44,199,200],{},"POST \u002Ftrigger"," avec ",[44,203,204],{},"{ \"id\" }"," — jouer un son",[26,207,208,211],{},[44,209,210],{},"GET \u002Ftrigger\u002F:id"," — jouer (facile à tester dans un navigateur)",[26,213,214,201,217,219],{},[44,215,216],{},"POST \u002Fstop",[44,218,204],{}," optionnel — arrêter un son ou tous",[26,221,222,225],{},[44,223,224],{},"GET \u002Fws"," — état en direct ; envoyer des commandes trigger\u002Fstop en entrée",{"title":227,"searchDepth":228,"depth":228,"links":229},"",2,[230,231,232,233,234],{"id":20,"depth":228,"text":21},{"id":62,"depth":228,"text":63},{"id":103,"depth":228,"text":104},{"id":131,"depth":228,"text":132},{"id":168,"depth":228,"text":169},"Déclencher SoundNinja depuis Bitfocus Companion sur le réseau local.","md",{},true,7,"\u002Fremote-control",{"title":5,"description":235},"remote-control","x2ATKsQSw6vK7Q_I6hdw3nGtfQ1h8TqY_dF37ClQR9o",[245,363,561,708,863,998,1141,1287],{"id":246,"title":247,"body":248,"description":356,"extension":236,"meta":357,"navigation":238,"order":358,"path":359,"seo":360,"stem":361,"__hash__":362},"content_fr\u002Foverview.md","Aperçu",{"type":7,"value":249,"toc":350},[250,253,256,259,262,266,280,284,313,317,326,330],[10,251,247],{"id":252},"aperçu",[14,254,255],{},"SoundNinja est un soundboard open source pour le live streaming, les discussions entre amis et l’enregistrement de podcasts. Il est construit avec Tauri v2 et Nuxt 4 pour rester léger en RAM et sur le disque.",[14,257,258],{},"Le but est simple : garder une énorme bibliothèque de sons facile à parcourir, puis jouer le bon clip en quelques millisecondes. L’interface marche aussi comme tableau de bord en VR.",[14,260,261],{},"SoundNinja est encore en développement précoce. Les fonctions marchent, mais toutes les plateformes ne sont pas entièrement testées.",[18,263,265],{"id":264},"pour-qui","Pour qui",[106,267,268,271,274,277],{},[26,269,270],{},"Les streameurs qui ont besoin de cues sonores instantanés",[26,272,273],{},"Les amis qui veulent un board partagé pour le vocal",[26,275,276],{},"Les podcasteurs qui enregistrent des clips et les posent sur un board",[26,278,279],{},"Quiconque veut un soundboard personnalisable et local-first",[18,281,283],{"id":282},"ce-que-tu-peux-faire","Ce que tu peux faire",[106,285,286,289,292,295,298,301,307,310],{},[26,287,288],{},"Construire un soundboard à partir de tes propres fichiers audio",[26,290,291],{},"Organiser les sons dans des onglets colorés, des groupes et la recherche",[26,293,294],{},"Concevoir le look avec le Theme Creator",[26,296,297],{},"Enregistrer l’audio du PC ou un micro dans le Record Editor",[26,299,300],{},"Assigner des raccourcis à des sons individuels",[26,302,303,304],{},"Déclencher des sons depuis ",[70,305,63],{"href":306},"\u002Fdocs\u002Fremote-control",[26,308,309],{},"Importer et exporter un soundboard complet pour le partager",[26,311,312],{},"Utiliser des GIF ou des images sur les boutons de son",[18,314,316],{"id":315},"licence","Licence",[14,318,319,320,325],{},"SoundNinja est un logiciel libre sous ",[70,321,324],{"href":322,"rel":323},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fblob\u002Fmain\u002FLICENSE",[74],"GPL-3.0",". Forke-le, modifie-le, partage-le.",[18,327,329],{"id":328},"prochaines-étapes","Prochaines étapes",[23,331,332,338,344],{},[26,333,334],{},[70,335,337],{"href":336},"\u002Fdocs\u002Finstallation","Installer SoundNinja",[26,339,340],{},[70,341,343],{"href":342},"\u002Fdocs\u002Fadding-sounds","Ajouter des sons",[26,345,346],{},[70,347,349],{"href":348},"\u002Fdocs\u002Forganizing-sounds","Organiser ton board",{"title":227,"searchDepth":228,"depth":228,"links":351},[352,353,354,355],{"id":264,"depth":228,"text":265},{"id":282,"depth":228,"text":283},{"id":315,"depth":228,"text":316},{"id":328,"depth":228,"text":329},"Ce qu’est SoundNinja et ce que tu peux en faire.",{},1,"\u002Foverview",{"title":247,"description":356},"overview","ZY8wtO0KcJ2GGKh9NDik0dGVB6QXrk3FQ-5mCb0D4-8",{"id":364,"title":365,"body":366,"description":556,"extension":236,"meta":557,"navigation":238,"order":228,"path":558,"seo":559,"stem":370,"__hash__":560},"content_fr\u002Finstallation.md","Installation",{"type":7,"value":367,"toc":549},[368,371,385,389,407,410,414,428,431,435,459,470,474,481,485,500,530,545],[10,369,365],{"id":370},"installation",[14,372,373,374,378,379,384],{},"Récupère un build sur la ",[70,375,377],{"href":376},"\u002Fdownload","page Télécharger"," ou sur ",[70,380,383],{"href":381,"rel":382},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Freleases\u002Flatest",[74],"GitHub Releases",". SoundNinja est en développement précoce — traite les builds comme des bêtas.",[18,386,388],{"id":387},"windows","Windows",[106,390,391,401,404],{},[26,392,393,396,397,400],{},[30,394,395],{},"Installateur (.exe)"," ou ",[30,398,399],{},"MSI (.msi)"," pour Windows 64 bits",[26,402,403],{},"Cible de la landing page : Windows 10 et plus",[26,405,406],{},"Le README de l’app mentionne aussi Windows 8 et supérieur",[14,408,409],{},"Lance l’installateur, puis ouvre SoundNinja depuis le menu Démarrer.",[18,411,413],{"id":412},"macos","macOS",[106,415,416,422,425],{},[26,417,418,421],{},[30,419,420],{},".dmg universel"," pour Apple Silicon et Intel",[26,423,424],{},"Cible de la landing page : macOS 10.14 et plus",[26,426,427],{},"Le README de l’app mentionne macOS 10.15 et supérieur",[14,429,430],{},"Ouvre l’image disque et glisse SoundNinja dans Applications.",[18,432,434],{"id":433},"linux","Linux",[106,436,437,443,449,456],{},[26,438,439,442],{},[30,440,441],{},"Debian (.deb)"," pour Ubuntu \u002F Debian",[26,444,445,448],{},[30,446,447],{},"AppImage"," pour les autres distros",[26,450,451,452,455],{},"Après publication d’une release, les utilisateurs Arch peuvent installer ",[44,453,454],{},"soundninja-bin"," depuis l’AUR",[26,457,458],{},"Testé sur Ubuntu 20.04",[14,460,461,462,465,466,469],{},"Les builds desktop ont besoin des paquets WebKit et GTK. Sous Debian\u002FUbuntu, ça veut souvent dire ",[44,463,464],{},"libwebkit2gtk",", ",[44,467,468],{},"libgtk-3-0"," et une bibliothèque app-indicator.",[18,471,473],{"id":472},"mises-à-jour","Mises à jour",[14,475,476,477,480],{},"Dans l’app, ouvre ",[30,478,479],{},"Aide → Rechercher les mises à jour",". Tu peux aussi laisser SoundNinja vérifier au démarrage dans les Paramètres.",[18,482,484],{"id":483},"compiler-depuis-les-sources","Compiler depuis les sources",[14,486,487,488,493,494,499],{},"Besoin d’un build custom ? Clone ",[70,489,492],{"href":490,"rel":491},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja",[74],"le repo",", installe les ",[70,495,498],{"href":496,"rel":497},"https:\u002F\u002Fv2.tauri.app\u002Fstart\u002Fprerequisites\u002F",[74],"prérequis Tauri",", puis :",[501,502,506],"pre",{"className":503,"code":504,"language":505,"meta":227,"style":227},"language-bash shiki shiki-themes github-light github-dark","bun install\nbun run tauri:serve\n","bash",[44,507,508,520],{"__ignoreMap":227},[509,510,512,516],"span",{"class":511,"line":358},"line",[509,513,515],{"class":514},"sScJk","bun",[509,517,519],{"class":518},"sZZnC"," install\n",[509,521,522,524,527],{"class":511,"line":228},[509,523,515],{"class":514},[509,525,526],{"class":518}," run",[509,528,529],{"class":518}," tauri:serve\n",[14,531,532,465,535,396,538,541,542,33],{},[44,533,534],{},"npm",[44,536,537],{},"pnpm",[44,539,540],{},"deno"," marchent aussi. Build de production : ",[44,543,544],{},"bun run tauri:build",[546,547,548],"style",{},"html pre.shiki code .sScJk, html code.shiki .sScJk{--shiki-default:#6F42C1;--shiki-dark:#B392F0}html pre.shiki code .sZZnC, html code.shiki .sZZnC{--shiki-default:#032F62;--shiki-dark:#9ECBFF}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html.dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}",{"title":227,"searchDepth":228,"depth":228,"links":550},[551,552,553,554,555],{"id":387,"depth":228,"text":388},{"id":412,"depth":228,"text":413},{"id":433,"depth":228,"text":434},{"id":472,"depth":228,"text":473},{"id":483,"depth":228,"text":484},"Installe SoundNinja sur Windows, macOS ou Linux.",{},"\u002Finstallation",{"title":365,"description":556},"pbEgfObzQ57hJHQ_Y3qGhgX0zLihiW_l6ZrgNA2lCO8",{"id":562,"title":343,"body":563,"description":701,"extension":236,"meta":702,"navigation":238,"order":703,"path":704,"seo":705,"stem":706,"__hash__":707},"content_fr\u002Fadding-sounds.md",{"type":7,"value":564,"toc":693},[565,568,571,575,593,597,628,632,651,655,669,672,676,683,687],[10,566,343],{"id":567},"ajouter-des-sons",[14,569,570],{},"Un board reste vide tant que tu n’ajoutes pas de clips. SoundNinja peut importer des fichiers, des dossiers entiers, un enregistrement ou un pack de soundboard partagé.",[18,572,574],{"id":573},"importer-des-fichiers-audio","Importer des fichiers audio",[23,576,577,587,590],{},[26,578,28,579,582,583,586],{},[30,580,581],{},"Fichier → Importer des fichiers audio",", ou utilise ",[30,584,585],{},"Importer"," dans la barre de navigation.",[26,588,589],{},"Choisis un ou plusieurs fichiers audio.",[26,591,592],{},"Les sons arrivent dans l’onglet actuel.",[18,594,596],{"id":595},"importer-des-dossiers","Importer des dossiers",[23,598,599,608,611],{},[26,600,28,601,604,605,607],{},[30,602,603],{},"Fichier → Importer des dossiers"," (ou ",[30,606,596],{}," dans la barre de navigation).",[26,609,610],{},"Ajoute un ou plusieurs dossiers. Glisse pour les réordonner avant l’import.",[26,612,613,614],{},"Choisis comment ils arrivent :\n",[106,615,616,622],{},[26,617,618,621],{},[30,619,620],{},"Importer comme onglets"," — chaque dossier devient son propre onglet",[26,623,624,627],{},[30,625,626],{},"Importer dans l’onglet actuel"," — chaque fichier va dans l’onglet actif",[18,629,631],{"id":630},"enregistrer-un-clip","Enregistrer un clip",[14,633,634,635,639,640,643,644,396,647,650],{},"Ouvre le ",[70,636,638],{"href":637},"\u002Fdocs\u002Frecording-editor","Record Editor"," depuis le bouton ",[30,641,642],{},"Enregistrer"," dans la barre du lecteur. Capture, coupe, puis ",[30,645,646],{},"Importer la sélection",[30,648,649],{},"Tout importer"," dans l’onglet actuel ou un onglet que tu choisis.",[18,652,654],{"id":653},"importer-un-soundboard","Importer un soundboard",[14,656,657,660,661,664,665,668],{},[30,658,659],{},"Fichier → Importer un soundboard"," charge un pack partagé. Les packs sont un ",[44,662,663],{},".zip"," qui contient ",[44,666,667],{},"project.sninja"," plus les fichiers audio. Après l’import, ouvre le projet et joue.",[14,670,671],{},"Tu peux aussi garder plusieurs projets (profils). Utilise le sélecteur de projet pour changer de board.",[18,673,675],{"id":674},"relier-les-fichiers-manquants","Relier les fichiers manquants",[14,677,678,679,682],{},"Si des fichiers audio bougent sur le disque, SoundNinja affiche ",[30,680,681],{},"Fichiers audio manquants",". Choisis un dossier à parcourir et relie les clips.",[18,684,686],{"id":685},"suite","Suite",[14,688,689,690,33],{},"Organise onglets, groupes et raccourcis dans ",[70,691,692],{"href":348},"Organiser les sons",{"title":227,"searchDepth":228,"depth":228,"links":694},[695,696,697,698,699,700],{"id":573,"depth":228,"text":574},{"id":595,"depth":228,"text":596},{"id":630,"depth":228,"text":631},{"id":653,"depth":228,"text":654},{"id":674,"depth":228,"text":675},{"id":685,"depth":228,"text":686},"Importe de l’audio, des dossiers, des enregistrements et des soundboards partagés.",{},3,"\u002Fadding-sounds",{"title":343,"description":701},"adding-sounds","WxjyAOY51Jh80jxw4Xvj7Ko_IY_wVuHJST0KFUWSZ9k",{"id":709,"title":692,"body":710,"description":856,"extension":236,"meta":857,"navigation":238,"order":858,"path":859,"seo":860,"stem":861,"__hash__":862},"content_fr\u002Forganizing-sounds.md",{"type":7,"value":711,"toc":847},[712,715,718,722,749,756,760,763,777,784,788,794,798,809,813,816,820,823,829,835,839],[10,713,692],{"id":714},"organiser-les-sons",[14,716,717],{},"SoundNinja est conçu pour les grandes bibliothèques. Utilise les onglets, les groupes, la recherche et les raccourcis pour que le clip dont tu as besoin soit à un clic (ou une touche) près.",[18,719,721],{"id":720},"onglets","Onglets",[106,723,724,731,738],{},[26,725,726,727,730],{},"Ajoute un onglet avec ",[30,728,729],{},"Ajouter un onglet",". Donne-lui une couleur pour scanner la barre vite.",[26,732,733,734,737],{},"La vue ",[30,735,736],{},"Tous"," montre chaque son à travers les onglets.",[26,739,740,741,744,745,748],{},"Un son peut appartenir à ",[30,742,743],{},"un ou plusieurs onglets",". Clic droit sur un son et utilise ",[30,746,747],{},"Déplacer vers l’onglet"," pour l’assigner.",[14,750,751,752,755],{},"Les transitions d’onglets sont dans ",[30,753,754],{},"Paramètres → Général"," : Slide, Fade, Boutons un par un, ou Aucune.",[18,757,759],{"id":758},"groupes","Groupes",[14,761,762],{},"Depuis la v0.5.3, les séparateurs peuvent devenir des groupes nommés :",[106,764,765,768,771,774],{},[26,766,767],{},"Ajouter, renommer ou supprimer un groupe depuis le menu contextuel",[26,769,770],{},"Glisser l’en-tête du groupe — les enfants suivent",[26,772,773],{},"Déposer des sons dans un groupe ou les en sortir",[26,775,776],{},"Régler la couleur de bordure, la couleur du nom et l’alignement des boutons (ou utiliser le défaut de l’onglet)",[14,778,779,780,783],{},"Tu peux toujours ajouter un ",[30,781,782],{},"Séparateur"," simple si tu as seulement besoin d’une coupure visuelle.",[18,785,787],{"id":786},"recherche","Recherche",[14,789,790,791,793],{},"Utilise le champ ",[30,792,787],{}," dans la barre de navigation. Les résultats se mettent à jour pendant que tu tapes.",[18,795,797],{"id":796},"réordonner","Réordonner",[14,799,800,801,804,805,808],{},"Active le glisser-déposer dans ",[30,802,803],{},"Paramètres → Comportement"," (",[30,806,807],{},"Autoriser le réordonnancement","). Puis glisse sons et groupes en place.",[18,810,812],{"id":811},"édition-groupée","Édition groupée",[14,814,815],{},"Sélectionne plusieurs sons, puis change la couleur, déplace-les vers un onglet ou supprime-les en une étape.",[18,817,819],{"id":818},"raccourcis-et-ids-de-son","Raccourcis et IDs de son",[14,821,822],{},"Chaque son a un ID de 8 caractères. Copie-le depuis le menu contextuel du bouton ou la puce d’ID de la sélection multiple.",[14,824,28,825,828],{},[30,826,827],{},"Paramètres → Raccourcis"," pour lier une touche à un ID de son. Les raccourcis globaux sont optionnels.",[14,830,831,832,834],{},"Le même ID est ce que ",[70,833,63],{"href":306}," utilise pour déclencher un clip.",[18,836,838],{"id":837},"gifs-et-couleurs","GIFs et couleurs",[14,840,841,842,846],{},"Clic droit sur un son pour régler des couleurs par bouton ou un fond GIF \u002F image. C’est séparé du ",[70,843,845],{"href":844},"\u002Fdocs\u002Ftheme-editor","Theme Creator",", qui habille tout le board.",{"title":227,"searchDepth":228,"depth":228,"links":848},[849,850,851,852,853,854,855],{"id":720,"depth":228,"text":721},{"id":758,"depth":228,"text":759},{"id":786,"depth":228,"text":787},{"id":796,"depth":228,"text":797},{"id":811,"depth":228,"text":812},{"id":818,"depth":228,"text":819},{"id":837,"depth":228,"text":838},"Onglets, groupes, recherche, édition groupée et raccourcis.",{},4,"\u002Forganizing-sounds",{"title":692,"description":856},"organizing-sounds","s3oaYG46DStsSAtCx2-Sgrn_LoxScaKkOmEWwKlXmKQ",{"id":864,"title":865