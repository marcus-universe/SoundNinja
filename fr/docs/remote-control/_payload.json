[{"data":1,"prerenderedAt":1669},["ShallowReactive",2],{"docs-page-fr-\u002Fremote-control":3,"docs-nav-fr":244},{"id":4,"title":5,"body":6,"description":235,"extension":236,"meta":237,"navigation":238,"order":239,"path":240,"seo":241,"stem":242,"__hash__":243},"content_fr\u002Fremote-control.md","Contrôle à distance",{"type":7,"value":8,"toc":226},"minimark",[9,13,17,22,57,60,64,101,105,126,129,133,166,170,176],[10,11,5],"h1",{"id":12},"contrôle-à-distance",[14,15,16],"p",{},"SoundNinja peut écouter sur ton réseau local pour que Bitfocus Companion (ou n’importe quel client HTTP\u002FWebSocket) joue et arrête des sons.",[18,19,21],"h2",{"id":20},"activer-le-serveur-distant","Activer le serveur distant",[23,24,25,34,40,47],"ol",{},[26,27,28,29,33],"li",{},"Ouvre ",[30,31,32],"strong",{},"Paramètres → Distant",".",[26,35,36,37,33],{},"Active le serveur distant. Le port par défaut est ",[30,38,39],{},"7331",[26,41,42,43,33],{},"Optionnel : définis un token. Les clients doivent l’envoyer comme Bearer token ou ",[44,45,46],"code",{},"?token=",[26,48,49,50,53,54,33],{},"Copie l’URL ",[44,51,52],{},"http:\u002F\u002FIP:PORT",", ou copie l’IP système depuis ",[30,55,56],{},"Paramètres → À propos",[14,58,59],{},"Windows peut afficher une invite pare-feu la première fois que le serveur démarre. Autorise l’accès au réseau privé.",[18,61,63],{"id":62},"bitfocus-companion","Bitfocus Companion",[23,65,66,75,84,94],{},[26,67,68,69,33],{},"Installe ",[70,71,63],"a",{"href":72,"rel":73},"https:\u002F\u002Fbitfocus.io\u002Fcompanion",[74],"nofollow",[26,76,77,78,83],{},"Télécharge ",[70,79,82],{"href":80,"rel":81},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002Fcompanion-module-soundninja\u002Freleases\u002Flatest",[74],"SoundNinja-Companion.tgz",". Il n’y a pas encore de paquet Companion Store.",[26,85,86,87,90,91,33],{},"Dans Companion : ",[30,88,89],{},"Modules → Load module package"," et choisis le ",[44,92,93],{},".tgz",[26,95,96,97,100],{},"Ajoute une connexion ",[30,98,99],{},"Sound Ninja",". Colle l’IP du PC, le port, et le token si tu en as défini un.",[18,102,104],{"id":103},"actions","Actions",[106,107,108,114,120],"ul",{},[26,109,110,113],{},[30,111,112],{},"Trigger Sound"," — choisis dans le menu déroulant live, ou tape un ID de son de 8 caractères (les variables Companion marchent)",[26,115,116,119],{},[30,117,118],{},"Stop Sound"," — arrête un son en lecture par ID",[26,121,122,125],{},[30,123,124],{},"Stop All"," — arrête tous les sons en lecture",[14,127,128],{},"Copie un ID de son dans SoundNinja depuis le menu contextuel du bouton ou la puce d’ID de la sélection multiple.",[18,130,132],{"id":131},"feedbacks-et-variables","Feedbacks et variables",[106,134,135,141,154,160],{},[26,136,137,140],{},[30,138,139],{},"Sound Playing"," — vrai tant que cet ID de son est actif (utilise-le pour la couleur du bouton)",[26,142,143,146,147,150,151],{},[44,144,145],{},"$(soundninja:connected)"," — ",[44,148,149],{},"true"," \u002F ",[44,152,153],{},"false",[26,155,156,159],{},[44,157,158],{},"$(soundninja:playing_count)"," — combien de sons jouent",[26,161,162,165],{},[44,163,164],{},"$(soundninja:last_triggered)"," — dernier ID de son déclenché",[18,167,169],{"id":168},"api-http-avancé","API HTTP (avancé)",[14,171,172,173],{},"Chemin de base : ",[44,174,175],{},"\u002Fapi\u002Fv1",[106,177,178,184,190,196,206,212,220],{},[26,179,180,183],{},[44,181,182],{},"GET \u002Finfo"," — nom de l’app, version, protocole, si un token est requis",[26,185,186,189],{},[44,187,188],{},"GET \u002Fsounds"," — liste des sons (id, name, tabs, active)",[26,191,192,195],{},[44,193,194],{},"GET \u002Fstate"," — sons plus IDs actuellement en lecture",[26,197,198,201,202,205],{},[44,199,200],{},"POST \u002Ftrigger"," avec ",[44,203,204],{},"{ \"id\" }"," — jouer un son",[26,207,208,211],{},[44,209,210],{},"GET \u002Ftrigger\u002F:id"," — jouer (facile à tester dans un navigateur)",[26,213,214,201,217,219],{},[44,215,216],{},"POST \u002Fstop",[44,218,204],{}," optionnel — arrêter un son ou tous",[26,221,222,225],{},[44,223,224],{},"GET \u002Fws"," — état en direct ; envoyer des commandes trigger\u002Fstop en entrée",{"title":227,"searchDepth":228,"depth":228,"links":229},"",2,[230,231,232,233,234],{"id":20,"depth":228,"text":21},{"id":62,"depth":228,"text":63},{"id":103,"depth":228,"text":104},{"id":131,"depth":228,"text":132},{"id":168,"depth":228,"text":169},"Déclencher SoundNinja depuis Bitfocus Companion sur le réseau local.","md",{},true,7,"\u002Fremote-control",{"title":5,"description":235},"remote-control","K_OaPi35SE1UyZR55pVcFsepHwNI1gVItIGw8Wc63e8",[245,372,594,741,1144,1279,1426,1572],{"id":246,"title":247,"body":248,"description":365,"extension":236,"meta":366,"navigation":238,"order":367,"path":368,"seo":369,"stem":370,"__hash__":371},"content_fr\u002Foverview.md","Aperçu",{"type":7,"value":249,"toc":359},[250,253,256,259,262,266,280,284,322,326,335,339],[10,251,247],{"id":252},"aperçu",[14,254,255],{},"SoundNinja est un soundboard open source pour le live streaming, les discussions entre amis et l’enregistrement de podcasts. Il est construit avec Tauri v2 et Nuxt 4 pour rester léger en RAM et sur le disque.",[14,257,258],{},"Le but est simple : garder une énorme bibliothèque de sons facile à parcourir, puis jouer le bon clip en quelques millisecondes. L’interface marche aussi comme tableau de bord en VR.",[14,260,261],{},"SoundNinja est encore en développement précoce. Les fonctions marchent, mais toutes les plateformes ne sont pas entièrement testées.",[18,263,265],{"id":264},"pour-qui","Pour qui",[106,267,268,271,274,277],{},[26,269,270],{},"Les streameurs qui ont besoin de cues sonores instantanés",[26,272,273],{},"Les amis qui veulent un board partagé pour le vocal",[26,275,276],{},"Les podcasteurs qui enregistrent des clips et les posent sur un board",[26,278,279],{},"Quiconque veut un soundboard personnalisable et local-first",[18,281,283],{"id":282},"ce-que-tu-peux-faire","Ce que tu peux faire",[106,285,286,289,292,295,298,301,304,307,310,316,319],{},[26,287,288],{},"Construire un soundboard à partir de tes propres fichiers audio",[26,290,291],{},"Organiser les sons dans des onglets colorés, des groupes, des tags et la recherche",[26,293,294],{},"Filtrer par tags (OU) et trier par nom, date, durée ou taille",[26,296,297],{},"Sélection multiple avec rectangle ou plage Maj, puis couleur, déplacement ou suppression en lot",[26,299,300],{},"Régler le volume par son depuis le menu contextuel",[26,302,303],{},"Concevoir le look avec le Theme Creator",[26,305,306],{},"Enregistrer l’audio du PC ou un micro dans le Record Editor",[26,308,309],{},"Assigner des raccourcis à des sons individuels",[26,311,312,313],{},"Déclencher des sons depuis ",[70,314,63],{"href":315},"\u002Fdocs\u002Fremote-control",[26,317,318],{},"Importer et exporter un soundboard complet pour le partager",[26,320,321],{},"Utiliser des GIF ou des images sur les boutons — bibliothèque de dossiers locale ou KLIPY",[18,323,325],{"id":324},"licence","Licence",[14,327,328,329,334],{},"SoundNinja est un logiciel libre sous ",[70,330,333],{"href":331,"rel":332},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fblob\u002Fmain\u002FLICENSE",[74],"GPL-3.0",". Forke-le, modifie-le, partage-le.",[18,336,338],{"id":337},"prochaines-étapes","Prochaines étapes",[23,340,341,347,353],{},[26,342,343],{},[70,344,346],{"href":345},"\u002Fdocs\u002Finstallation","Installer SoundNinja",[26,348,349],{},[70,350,352],{"href":351},"\u002Fdocs\u002Fadding-sounds","Ajouter des sons",[26,354,355],{},[70,356,358],{"href":357},"\u002Fdocs\u002Forganizing-sounds","Organiser ton board",{"title":227,"searchDepth":228,"depth":228,"links":360},[361,362,363,364],{"id":264,"depth":228,"text":265},{"id":282,"depth":228,"text":283},{"id":324,"depth":228,"text":325},{"id":337,"depth":228,"text":338},"Ce qu’est SoundNinja et ce que tu peux en faire.",{},1,"\u002Foverview",{"title":247,"description":365},"overview","nBakDXsUbMnm0zyn8m6jAooziqocGWiZV3EwAtrg0xk",{"id":373,"title":374,"body":375,"description":589,"extension":236,"meta":590,"navigation":238,"order":228,"path":591,"seo":592,"stem":379,"__hash__":593},"content_fr\u002Finstallation.md","Installation",{"type":7,"value":376,"toc":582},[377,380,394,398,419,422,426,440,443,447,471,482,486,493,497,512,542,557,578],[10,378,374],{"id":379},"installation",[14,381,382,383,387,388,393],{},"Récupère un build sur la ",[70,384,386],{"href":385},"\u002Fdownload","page Télécharger"," ou sur ",[70,389,392],{"href":390,"rel":391},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Freleases\u002Flatest",[74],"GitHub Releases",". SoundNinja est en développement précoce — traite les builds comme des bêtas.",[18,395,397],{"id":396},"windows","Windows",[106,399,400,410,413,416],{},[26,401,402,405,406,409],{},[30,403,404],{},"Installateur (.exe)"," ou ",[30,407,408],{},"MSI (.msi)"," pour Windows 64 bits",[26,411,412],{},"Cible de la landing page : Windows 10 et plus",[26,414,415],{},"Le README de l’app mentionne aussi Windows 8 et supérieur",[26,417,418],{},"L’installateur NSIS est sombre. Choisis une langue à l’installation — SoundNinja la retient au prochain lancement.",[14,420,421],{},"Lance l’installateur, puis ouvre SoundNinja depuis le menu Démarrer.",[18,423,425],{"id":424},"macos","macOS",[106,427,428,434,437],{},[26,429,430,433],{},[30,431,432],{},".dmg universel"," pour Apple Silicon et Intel",[26,435,436],{},"Cible de la landing page : macOS 10.14 et plus",[26,438,439],{},"Le README de l’app mentionne macOS 10.15 et supérieur",[14,441,442],{},"Ouvre l’image disque et glisse SoundNinja dans Applications.",[18,444,446],{"id":445},"linux","Linux",[106,448,449,455,461,468],{},[26,450,451,454],{},[30,452,453],{},"Debian (.deb)"," pour Ubuntu \u002F Debian",[26,456,457,460],{},[30,458,459],{},"AppImage"," pour les autres distros",[26,462,463,464,467],{},"Après publication d’une release, les utilisateurs Arch peuvent installer ",[44,465,466],{},"soundninja-bin"," depuis l’AUR",[26,469,470],{},"Testé sur Ubuntu 20.04",[14,472,473,474,477,478,481],{},"Les builds desktop ont besoin des paquets WebKit et GTK. Sous Debian\u002FUbuntu, ça veut souvent dire ",[44,475,476],{},"libwebkit2gtk",", ",[44,479,480],{},"libgtk-3-0"," et une bibliothèque app-indicator.",[18,483,485],{"id":484},"mises-à-jour","Mises à jour",[14,487,488,489,492],{},"Dans l’app, ouvre ",[30,490,491],{},"Aide → Rechercher les mises à jour",". Tu peux aussi laisser SoundNinja vérifier au démarrage dans les Paramètres.",[18,494,496],{"id":495},"compiler-depuis-les-sources","Compiler depuis les sources",[14,498,499,500,505,506,511],{},"Besoin d’un build custom ? Clone ",[70,501,504],{"href":502,"rel":503},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja",[74],"le repo",", installe les ",[70,507,510],{"href":508,"rel":509},"https:\u002F\u002Fv2.tauri.app\u002Fstart\u002Fprerequisites\u002F",[74],"prérequis Tauri",", puis :",[513,514,518],"pre",{"className":515,"code":516,"language":517,"meta":227,"style":227},"language-bash shiki shiki-themes github-light github-dark","bun install\nbun run tauri:serve\n","bash",[44,519,520,532],{"__ignoreMap":227},[521,522,524,528],"span",{"class":523,"line":367},"line",[521,525,527],{"class":526},"sScJk","bun",[521,529,531],{"class":530},"sZZnC"," install\n",[521,533,534,536,539],{"class":523,"line":228},[521,535,527],{"class":526},[521,537,538],{"class":530}," run",[521,540,541],{"class":530}," tauri:serve\n",[14,543,544,477,547,405,550,553,554,33],{},[44,545,546],{},"npm",[44,548,549],{},"pnpm",[44,551,552],{},"deno"," marchent aussi. Build de production : ",[44,555,556],{},"bun run tauri:build",[14,558,559,562,563,568,569,572,573,33],{},[30,560,561],{},"Windows uniquement :"," chaque compile Windows inclut ASIO via le ",[70,564,567],{"href":565,"rel":566},"https:\u002F\u002Fwww.steinberg.net\u002Fasiosdk",[74],"Steinberg ASIO SDK",". Lance ",[44,570,571],{},"bun run setup:asio"," une fois (SDK pas dans git). Linux et macOS utilisent PipeWire \u002F Core Audio — ignore cette étape. Détails : ",[70,574,577],{"href":575,"rel":576},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fblob\u002Fmain\u002Fdocs\u002Fbuild-from-source.md",[74],"build-from-source.md",[579,580,581],"style",{},"html pre.shiki code .sScJk, html code.shiki .sScJk{--shiki-default:#6F42C1;--shiki-dark:#B392F0}html pre.shiki code .sZZnC, html code.shiki .sZZnC{--shiki-default:#032F62;--shiki-dark:#9ECBFF}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html.dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}",{"title":227,"searchDepth":228,"depth":228,"links":583},[584,585,586,587,588],{"id":396,"depth":228,"text":397},{"id":424,"depth":228,"text":425},{"id":445,"depth":228,"text":446},{"id":484,"depth":228,"text":485},{"id":495,"depth":228,"text":496},"Installe SoundNinja sur Windows, macOS ou Linux.",{},"\u002Finstallation",{"title":374,"description":589},"FOJJDNBAT_xV14QaxG490DTpeNiFpVDRFz_XEdyJKJE",{"id":595,"title":352,"body":596,"description":734,"extension":236,"meta":735,"navigation":238,"order":736,"path":737,"seo":738,"stem":739,"__hash__":740},"content_fr\u002Fadding-sounds.md",{"type":7,"value":597,"toc":726},[598,601,604,608,626,630,661,665,684,688,702,705,709,716,720],[10,599,352],{"id":600},"ajouter-des-sons",[14,602,603],{},"Un board reste vide tant que tu n’ajoutes pas de clips. SoundNinja peut importer des fichiers, des dossiers entiers, un enregistrement ou un pack de soundboard partagé.",[18,605,607],{"id":606},"importer-des-fichiers-audio","Importer des fichiers audio",[23,609,610,620,623],{},[26,611,28,612,615,616,619],{},[30,613,614],{},"Fichier → Importer des fichiers audio",", ou utilise ",[30,617,618],{},"Importer"," dans la barre de navigation.",[26,621,622],{},"Choisis un ou plusieurs fichiers audio.",[26,624,625],{},"Les sons arrivent dans l’onglet actuel.",[18,627,629],{"id":628},"importer-des-dossiers","Importer des dossiers",[23,631,632,641,644],{},[26,633,28,634,637,638,640],{},[30,635,636],{},"Fichier → Importer des dossiers"," (ou ",[30,639,629],{}," dans la barre de navigation).",[26,642,643],{},"Ajoute un ou plusieurs dossiers. Glisse pour les réordonner avant l’import.",[26,645,646,647],{},"Choisis comment ils arrivent :\n",[106,648,649,655],{},[26,650,651,654],{},[30,652,653],{},"Importer comme onglets"," — chaque dossier devient son propre onglet",[26,656,657,660],{},[30,658,659],{},"Importer dans l’onglet actuel"," — chaque fichier va dans l’onglet actif",[18,662,664],{"id":663},"enregistrer-un-clip","Enregistrer un clip",[14,666,667,668,672,673,676,677,405,680,683],{},"Ouvre le ",[70,669,671],{"href":670},"\u002Fdocs\u002Frecording-editor","Record Editor"," depuis le bouton ",[30,674,675],{},"Enregistrer"," dans la barre du lecteur. Capture, coupe, puis ",[30,678,679],{},"Importer la sélection",[30,681,682],{},"Tout importer"," dans l’onglet actuel ou un onglet que tu choisis.",[18,685,687],{"id":686},"importer-un-soundboard","Importer un soundboard",[14,689,690,693,694,697,698,701],{},[30,691,692],{},"Fichier → Importer un soundboard"," charge un pack partagé. Les packs sont un ",[44,695,696],{},".zip"," qui contient ",[44,699,700],{},"project.sninja"," plus les fichiers audio. Après l’import, ouvre le projet et joue.",[14,703,704],{},"Tu peux aussi garder plusieurs projets (profils). Utilise le sélecteur de projet pour changer de board.",[18,706,708],{"id":707},"relier-les-fichiers-manquants","Relier les fichiers manquants",[14,710,711,712,715],{},"Si des fichiers audio bougent sur le disque, SoundNinja affiche ",[30,713,714],{},"Fichiers audio manquants",". Choisis un dossier à parcourir et relie les clips.",[18,717,719],{"id":718},"suite","Suite",[14,721,722,723,33],{},"Organise onglets, tags, filtres et raccourcis dans ",[70,724,725],{"href":357},"Organiser les sons",{"title":227,"searchDepth":228,"depth":228,"links":727},[728,729,730,731,732,733],{"id":606,"depth":228,"text":607},{"id":628,"depth":228,"text":629},{"id":663,"depth":228,"text":664},{"id":686,"depth":228,"text":687},{"id":707,"depth":228,"text":708},{"id":718,"depth":228,"text":719},"Importe de l’audio, des dossiers, des enregistrements et des soundboards partagés.",{},3,"\u002Fadding-sounds",{"title":352,"description":734},"adding-sounds","4l04_lLfE4dqOPh8H0Rav69GnvCVi_PKTEgAepysTeI",{"id":742,"title":725,"body":743,"description":1137,"extension":236,"meta":1138,"navigation":238,"order":1139,"path":1140,"seo":1141,"stem":1142,"__hash__":1143},"content_fr\u002Forganizing-sounds.md",{"type":7,"value":744,"toc":1122},[745,748,755,759,786,793,797,800,814,821,827,831,841,846,878,882,888,892,925,931,935,938,964,967,971,984,988,994,1015,1031,1038,1042,1053,1056,1060,1067,1077,1083,1087,1095,1102,1119],[10,746,725],{"id":747},"organiser-les-sons",[14,749,750,751,754],{},"SoundNinja est conçu pour les grandes bibliothèques. ",[30,752,753],{},"Tags et filtres",", onglets, recherche, sélection multiple et raccourcis — le clip dont tu as besoin est à un clic (ou une touche) près.",[18,756,758],{"id":757},"onglets","Onglets",[106,760,761,768,775],{},[26,762,763,764,767],{},"Ajoute un onglet avec ",[30,765,766],{},"Ajouter un onglet",". Donne-lui une couleur pour scanner la barre vite.",[26,769,770,771,774],{},"La vue ",[30,772,773],{},"Tous"," montre chaque son à travers les onglets.",[26,776,777,778,781,782,785],{},"Un son peut appartenir à ",[30,779,780],{},"un ou plusieurs onglets",". Clic droit sur un son et utilise ",[30,783,784],{},"Déplacer vers l’onglet"," pour l’assigner.",[14,787,788,789,792],{},"Les transitions d’onglets sont dans ",[30,790,791],{},"Paramètres → Général"," : Slide, Fade, Boutons un par un, ou Aucune.",[18,794,796],{"id":795},"groupes","Groupes",[14,798,799],{},"Depuis la v0.5.3, les séparateurs peuvent devenir des groupes nommés :",[106,801,802,805,808,811],{},[26,803,804],{},"Ajouter, renommer ou supprimer un groupe depuis le menu contextuel",[26,806,807],{},"Glisser l’en-tête du groupe — les enfants suivent",[26,809,810],{},"Déposer des sons dans un groupe ou les en sortir",[26,812,813],{},"Régler la couleur de bordure, la couleur du nom et l’alignement des boutons (ou utiliser le défaut de l’onglet)",[14,815,816,817,820],{},"Tu peux toujours ajouter un ",[30,818,819],{},"Séparateur"," simple si tu as seulement besoin d’une coupure visuelle.",[14,822,823,824,33],{},"Clic droit sur l’espace vide du board pour ",[30,825,826],{},"Ajouter un groupe",[18,828,830],{"id":829},"tags-filtres","Tags \u002F Filtres",[14,832,833,834,837,838,840],{},"Les tags traversent les onglets. Le panneau ",[30,835,836],{},"Filtre"," (barre latérale ",[30,839,836],{},") sert à les créer et à filtrer le board.",[842,843,845],"h3",{"id":844},"créer-et-modifier-des-tags","Créer et modifier des tags",[23,847,848,853,864,871],{},[26,849,28,850,852],{},[30,851,836],{}," dans la barre latérale.",[26,854,855,856,859,860,863],{},"Sous ",[30,857,858],{},"Tags",", utilise ",[30,861,862],{},"Ajouter un tag"," — nom et couleur.",[26,865,866,867,870],{},"Renomme, recolore ou ",[30,868,869],{},"Supprimer le tag"," dans la même liste.",[26,872,873,874,877],{},"Si tu vois ",[30,875,876],{},"Aucun tag pour l’instant",", crée-en un ici avant d’assigner.",[842,879,881],{"id":880},"assigner-des-tags-aux-sons","Assigner des tags aux sons",[14,883,884,885,887],{},"Clic droit sur un son → ",[30,886,858],{}," (cases à cocher). Un son peut avoir plusieurs tags. S’il n’y en a encore aucun, le menu pointe vers le panneau filtre.",[842,889,891],{"id":890},"filtrer-le-board","Filtrer le board",[106,893,894,900,911,922],{},[26,895,896,897,33],{},"Active les tags dans le panneau Filtre, ou comme ",[30,898,899],{},"puces sous la barre de recherche",[26,901,902,903,906,907,910],{},"Le match est ",[30,904,905],{},"OU"," : un son reste visible s’il a ",[30,908,909],{},"n’importe quel"," tag sélectionné.",[26,912,913,914,917,918,921],{},"Le champ ",[30,915,916],{},"Recherche"," combine en ",[30,919,920],{},"ET"," avec le filtre de tags actif (saisie + tags ensemble).",[26,923,924],{},"Désactive les puces (ou vide le filtre) pour revoir tout l’onglet.",[14,926,927,928,33],{},"Les noms de tags colorés peuvent apparaître sur les boutons. Active-les dans ",[30,929,930],{},"Paramètres → Comportement → Afficher les badges de tags",[18,932,934],{"id":933},"tri","Tri",[14,936,937],{},"Ouvre le panneau filtre et choisis un mode :",[106,939,940,946],{},[26,941,942,945],{},[30,943,944],{},"Défini par l’utilisateur"," — ton ordre d’onglet, groupes visibles",[26,947,948,477,951,477,954,405,957,960,961],{},[30,949,950],{},"Nom",[30,952,953],{},"Date d’ajout",[30,955,956],{},"Durée de lecture",[30,958,959],{},"Taille de fichier"," — liste plate triée ; ",[30,962,963],{},"les groupes sont masqués",[14,965,966],{},"Le tri par durée peut préchauffer les métadonnées de durée la première fois.",[18,968,970],{"id":969},"réordonner","Réordonner",[14,972,973,974,977,978,981,982,33],{},"Active le glisser-déposer dans ",[30,975,976],{},"Paramètres → Comportement"," (",[30,979,980],{},"Autoriser le réordonnancement","). Puis glisse sons et groupes en place. Le réordonnancement s’applique en tri ",[30,983,944],{},[18,985,987],{"id":986},"sélection-multiple","Sélection multiple",[14,989,990,991,993],{},"Active ",[30,992,987],{}," dans la barre de navigation, puis :",[106,995,996,999,1005,1012],{},[26,997,998],{},"Clique pour basculer un son",[26,1000,1001,1004],{},[30,1002,1003],{},"Maj+clic"," pour une plage depuis le dernier ancrage",[26,1006,1007,1008,1011],{},"Trace un ",[30,1009,1010],{},"rectangle"," sur l’espace vide du board",[26,1013,1014],{},"Clique le board vide (ou à l’extérieur) pour vider la sélection",[14,1016,1017,1018,477,1021,477,1024,1027,1028,33],{},"Une barre groupée affiche le compte, plus ",[30,1019,1020],{},"Couleur",[30,1022,1023],{},"Déplacer vers l’onglet…",[30,1025,1026],{},"Supprimer"," et ",[30,1029,1030],{},"Terminé",[14,1032,1033,1034,1037],{},"En sélection multiple, chaque bouton montre une ",[30,1035,1036],{},"puce d’ID de 8 caractères",". Clic droit sur la puce pour la copier.",[18,1039,1041],{"id":1040},"volume-par-son","Volume par son",[14,1043,1044,1045,1048,1049,1052],{},"Clic droit → ",[30,1046,1047],{},"Volume",". Glisse le curseur de 0 % à 100 %. ",[30,1050,1051],{},"Double-clic"," le remet à 100 %.",[14,1054,1055],{},"Ça se cumule avec le volume de sortie principal dans les Paramètres.",[18,1057,1059],{"id":1058},"raccourcis-et-ids-de-son","Raccourcis et IDs de son",[14,1061,1062,1063,1066],{},"Chaque son a un ID de 8 caractères. Copie-le depuis le menu contextuel du bouton (",[30,1064,1065],{},"Copier l’ID",") ou la puce d’ID de la sélection multiple.",[14,1068,28,1069,1072,1073,1076],{},[30,1070,1071],{},"Paramètres → Raccourcis"," pour lier une touche à un ID de son. Les raccourcis globaux sont optionnels. ",[30,1074,1075],{},"Assigner un raccourci"," dans le menu contextuel y saute avec l’ID déjà rempli.",[14,1078,1079,1080,1082],{},"Le même ID est ce que ",[70,1081,63],{"href":315}," utilise pour déclencher un clip.",[18,1084,1086],{"id":1085},"images-de-fond-et-couleurs","Images de fond et couleurs",[14,1088,1089,1090,1094],{},"Clic droit sur un son pour régler des couleurs par bouton ou une image de fond. C’est séparé du ",[70,1091,1093],{"href":1092},"\u002Fdocs\u002Ftheme-editor","Theme Creator",", qui habille tout le board.",[14,1096,1097,1098,1101],{},"Le sélecteur est une boîte ",[30,1099,1100],{},"Image de fond"," (PNG, JPEG, GIF, WebP) :",[106,1103,1104,1110],{},[26,1105,1106,1109],{},[30,1107,1108],{},"Fichiers locaux"," — ajouter des dossiers, choisir un fichier, chercher par nom, prévisualiser la grille, retirer un dossier de la bibliothèque",[26,1111,1112,1115,1116,1118],{},[30,1113,1114],{},"KLIPY"," — chercher des GIF en ligne. Mets ta propre clé API dans ",[30,1117,976],{},". La clé n’est pas stockée dans les fichiers projet.",[14,1120,1121],{},"Après le choix, recadre et décale l’image sur le bouton.",{"title":227,"searchDepth":228,"depth":228,"links":1123},[1124,1125,1126,1131,1132,1133,1134,1135,1136],{"id":757,"depth":228,"text":758},{"id":795,"depth":228,"text":796},{"id":829,"depth":228,"text":830,"children":1127},[1128,1129,1130],{"id":844,"depth":736,"text":845},{"id":880,"depth":736,"text":881},{"id":890,"depth":736,"text":891},{"id":933,"depth":228,"text":934},{"id":969,"depth":228,"text":970},{"id":986,"depth":228,"text":987},{"id":1040,"depth":228,"text":1041},{"id":1058,"depth":228,"text":1059},{"id":1085,"depth":228,"text":1086},"Tags, filtres, onglets, groupes, tri, sélection multiple, volume et raccourcis.",{},4,"\u002Forganizing-sounds",{"title":725,"description":1137},"organizing-sounds","3ZEh-vX7bLxxdpr56sVGIToyf64-wDiiegH_atr9lbk",{"id":1145,"title":1146,"body":1147,"description":1272,"extension":236,"meta":1273,"navigation":238,"order":1274,"path":1275,"seo":1276,"stem":1277,"__hash__":1278},"content_fr\u002Ftheme-editor.md","Éditeur de thème",{"type":7,"value":1148,"toc":1266},[1149,1152,1158,1162,1188,1191,1195,1209,1213,1239,1242,1246,1252],[10,1150,1146],{"id":1151},"éditeur-de-thème",[14,1153,1154,1155,33],{},"Le Theme Creator est l’éditeur visuel complet de ton board. Ouvre-le depuis ",[30,1156,1157],{},"Paramètres → Général → Theme Creator",[18,1159,1161],{"id":1160},"trois-onglets","Trois onglets",[23,1163,1164,1177,1183],{},[26,1165,1166,1169,1170,150,1173,1176],{},[30,1167,1168],{},"Général"," — nom du thème, couleurs partagées et import de polices (",[44,1171,1172],{},".ttf",[44,1174,1175],{},".otf",")",[26,1178,1179,1182],{},[30,1180,1181],{},"Boutons"," — couleurs, typo, disposition et overlay GIF des boutons de son",[26,1184,1185,1187],{},[30,1186,758],{}," — couleurs, typo et épaisseur de bordure de la barre d’onglets",[14,1189,1190],{},"Un aperçu en direct montre onglets et boutons pendant que tu édites.",[18,1192,1194],{"id":1193},"ce-que-tu-peux-changer","Ce que tu peux changer",[106,1196,1197,1200,1203,1206],{},[26,1198,1199],{},"Couleurs primaire et d’accent, fonds, couleurs des boutons, couleurs des onglets",[26,1201,1202],{},"Famille et taille de police des boutons et des onglets",[26,1204,1205],{},"Largeur, rayon, bordure, écarts et padding des boutons",[26,1207,1208],{},"Opacité de l’overlay GIF (normal et survol)",[18,1210,1212],{"id":1211},"enregistrer-et-partager","Enregistrer et partager",[106,1214,1215,1221,1227,1233],{},[26,1216,1217,1220],{},[30,1218,1219],{},"Exporter .css"," — écrire un fichier de thème à sauvegarder ou envoyer à un ami",[26,1222,1223,1226],{},[30,1224,1225],{},"Ajouter aux thèmes"," — enregistrer le fichier dans ton dossier Themes et l’appliquer",[26,1228,1229,1232],{},[30,1230,1231],{},"Importer .css"," — charger un preset intégré ou un thème enregistré",[26,1234,1235,1238],{},[30,1236,1237],{},"Réinitialiser"," — revenir aux défauts SoundNinja",[14,1240,1241],{},"Si tu fermes la fenêtre avec des changements non enregistrés, SoundNinja te demande d’enregistrer d’abord.",[18,1243,1245],{"id":1244},"sans-léditeur-complet","Sans l’éditeur complet",[14,1247,1248,1249,1251],{},"Dans ",[30,1250,791],{}," tu peux toujours :",[106,1253,1254,1257,1263],{},[26,1255,1256],{},"Choisir un thème dans la liste",[26,1258,1259,1260,1176],{},"Éditer les variables CSS en direct (",[30,1261,1262],{},"CSS personnalisé",[26,1264,1265],{},"Importer un fichier de thème dans le dossier Themes",{"title":227,"searchDepth":228,"depth":228,"links":1267},[1268,1269,1270,1271],{"id":1160,"depth":228,"text":1161},{"id":1193,"depth":228,"text":1194},{"id":1211,"depth":228,"text":1212},{"id":1244,"depth":228,"text":1245},"Concevoir couleurs, polices, boutons et onglets dans le Theme Creator.",{},5,"\u002Ftheme-editor",{"title":1146,"description":1272},"theme-editor","wkR6rxJNnSmcJeJxDdslCOIyK7-9BblSMG_tJA6IwRY",{"id":1280,"title":1281,"body":1282,"description":1419,"extension":236,"meta":1420,"navigation":238,"order":1421,"path":1422,"seo":1423,"stem":1424,"__hash__":1425},"content_fr\u002Frecording-editor.md","Éditeur d’enregistrement",{"type":7,"value":1283,"toc":1413},[1284,1287,1293,1297,1303,1323,1326,1330,1355,1359,1373,1377,1392,1403],[10,1285,1281],{"id":1286},"éditeur-denregistrement",[14,1288,1289,1290,1292],{},"Enregistre un clip dans SoundNinja, coupe-le, puis importe-le sur un onglet. Ouvre l’éditeur avec le bouton ",[30,1291,675],{}," dans la barre du lecteur.",[18,1294,1296],{"id":1295},"choisir-une-entrée","Choisir une entrée",[14,1298,1248,1299,1302],{},[30,1300,1301],{},"Paramètres → Audio"," :",[106,1304,1305,1311,1317],{},[26,1306,1307,1310],{},[30,1308,1309],{},"Périphériques d’entrée"," — microphone",[26,1312,1313,1316],{},[30,1314,1315],{},"Périphériques de sortie (audio PC)"," — loopback de ce que le PC joue",[26,1318,1319,1322],{},[30,1320,1321],{},"Volume d’entrée"," — gain de capture de 0 % à 200 %",[14,1324,1325],{},"Le bouton Enregistrer utilise le périphérique choisi ici.",[18,1327,1329],{"id":1328},"éditer-la-prise","Éditer la prise",[106,1331,1332,1335,1338,1346,1349,1352],{},[26,1333,1334],{},"Enregistrer et arrêter",[26,1336,1337],{},"Surveiller le vu-mètre d’entrée",[26,1