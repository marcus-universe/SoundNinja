[{"data":1,"prerenderedAt":1389},["ShallowReactive",2],{"docs-page-fr-\u002Fremote-control":3,"docs-nav-fr":247},{"id":4,"title":5,"body":6,"description":238,"extension":239,"meta":240,"navigation":241,"order":242,"path":243,"seo":244,"stem":245,"__hash__":246},"content_fr\u002Fremote-control.md","Contrôle à distance",{"type":7,"value":8,"toc":229},"minimark",[9,13,17,22,57,60,64,104,108,129,132,136,169,173,179],[10,11,5],"h1",{"id":12},"contrôle-à-distance",[14,15,16],"p",{},"SoundNinja peut écouter sur ton réseau local pour que Bitfocus Companion (ou n’importe quel client HTTP\u002FWebSocket) joue et arrête des sons.",[18,19,21],"h2",{"id":20},"activer-le-serveur-distant","Activer le serveur distant",[23,24,25,34,40,47],"ol",{},[26,27,28,29,33],"li",{},"Ouvre ",[30,31,32],"strong",{},"Paramètres → Distant",".",[26,35,36,37,33],{},"Active le serveur distant. Le port par défaut est ",[30,38,39],{},"7331",[26,41,42,43,33],{},"Optionnel : définis un token. Les clients doivent l’envoyer comme Bearer token ou ",[44,45,46],"code",{},"?token=",[26,48,49,50,53,54,33],{},"Copie l’URL ",[44,51,52],{},"http:\u002F\u002FIP:PORT",", ou copie l’IP système depuis ",[30,55,56],{},"Paramètres → À propos",[14,58,59],{},"Windows peut afficher une invite pare-feu la première fois que le serveur démarre. Autorise l’accès au réseau privé.",[18,61,63],{"id":62},"bitfocus-companion","Bitfocus Companion",[23,65,66,75,84,91,97],{},[26,67,68,69,33],{},"Installe ",[70,71,63],"a",{"href":72,"rel":73},"https:\u002F\u002Fbitfocus.io\u002Fcompanion",[74],"nofollow",[26,76,77,78,83],{},"Télécharge le module SoundNinja depuis le dossier officiel : ",[70,79,82],{"href":80,"rel":81},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Ftree\u002Fmain\u002Fcompanion-module-soundninja",[74],"companion-module-soundninja",". Il n’y a pas encore de paquet Companion Store — ce dossier est le téléchargement.",[26,85,86,87,90],{},"Dans Companion, ouvre ",[30,88,89],{},"Developer → Modules",", ou dépose le dossier dans le chemin des modules custom de Companion.",[26,92,93,94,33],{},"Dans le dossier du module, lance ",[44,95,96],{},"npm install",[26,98,99,100,103],{},"Ajoute une connexion ",[30,101,102],{},"Sound Ninja",". Colle l’IP du PC, le port, et le token si tu en as défini un.",[18,105,107],{"id":106},"actions","Actions",[109,110,111,117,123],"ul",{},[26,112,113,116],{},[30,114,115],{},"Trigger Sound"," — choisis dans le menu déroulant live, ou tape un ID de son de 8 caractères (les variables Companion marchent)",[26,118,119,122],{},[30,120,121],{},"Stop Sound"," — arrête un son en lecture par ID",[26,124,125,128],{},[30,126,127],{},"Stop All"," — arrête tous les sons en lecture",[14,130,131],{},"Copie un ID de son dans SoundNinja depuis le menu contextuel du bouton ou la puce d’ID de la sélection multiple.",[18,133,135],{"id":134},"feedbacks-et-variables","Feedbacks et variables",[109,137,138,144,157,163],{},[26,139,140,143],{},[30,141,142],{},"Sound Playing"," — vrai tant que cet ID de son est actif (utilise-le pour la couleur du bouton)",[26,145,146,149,150,153,154],{},[44,147,148],{},"$(soundninja:connected)"," — ",[44,151,152],{},"true"," \u002F ",[44,155,156],{},"false",[26,158,159,162],{},[44,160,161],{},"$(soundninja:playing_count)"," — combien de sons jouent",[26,164,165,168],{},[44,166,167],{},"$(soundninja:last_triggered)"," — dernier ID de son déclenché",[18,170,172],{"id":171},"api-http-avancé","API HTTP (avancé)",[14,174,175,176],{},"Chemin de base : ",[44,177,178],{},"\u002Fapi\u002Fv1",[109,180,181,187,193,199,209,215,223],{},[26,182,183,186],{},[44,184,185],{},"GET \u002Finfo"," — nom de l’app, version, protocole, si un token est requis",[26,188,189,192],{},[44,190,191],{},"GET \u002Fsounds"," — liste des sons (id, name, tabs, active)",[26,194,195,198],{},[44,196,197],{},"GET \u002Fstate"," — sons plus IDs actuellement en lecture",[26,200,201,204,205,208],{},[44,202,203],{},"POST \u002Ftrigger"," avec ",[44,206,207],{},"{ \"id\" }"," — jouer un son",[26,210,211,214],{},[44,212,213],{},"GET \u002Ftrigger\u002F:id"," — jouer (facile à tester dans un navigateur)",[26,216,217,204,220,222],{},[44,218,219],{},"POST \u002Fstop",[44,221,207],{}," optionnel — arrêter un son ou tous",[26,224,225,228],{},[44,226,227],{},"GET \u002Fws"," — état en direct ; envoyer des commandes trigger\u002Fstop en entrée",{"title":230,"searchDepth":231,"depth":231,"links":232},"",2,[233,234,235,236,237],{"id":20,"depth":231,"text":21},{"id":62,"depth":231,"text":63},{"id":106,"depth":231,"text":107},{"id":134,"depth":231,"text":135},{"id":171,"depth":231,"text":172},"Déclencher SoundNinja depuis Bitfocus Companion sur le réseau local.","md",{},true,7,"\u002Fremote-control",{"title":5,"description":238},"remote-control","UirFfFFa1OtKqtZy-JaH5bjcCg1r2bpyTh0kMJoIAF4",[248,366,564,711,866,1001,1144,1292],{"id":249,"title":250,"body":251,"description":359,"extension":239,"meta":360,"navigation":241,"order":361,"path":362,"seo":363,"stem":364,"__hash__":365},"content_fr\u002Foverview.md","Aperçu",{"type":7,"value":252,"toc":353},[253,256,259,262,265,269,283,287,316,320,329,333],[10,254,250],{"id":255},"aperçu",[14,257,258],{},"SoundNinja est un soundboard open source pour le live streaming, les discussions entre amis et l’enregistrement de podcasts. Il est construit avec Tauri v2 et Nuxt 4 pour rester léger en RAM et sur le disque.",[14,260,261],{},"Le but est simple : garder une énorme bibliothèque de sons facile à parcourir, puis jouer le bon clip en quelques millisecondes. L’interface marche aussi comme tableau de bord en VR.",[14,263,264],{},"SoundNinja est encore en développement précoce. Les fonctions marchent, mais toutes les plateformes ne sont pas entièrement testées.",[18,266,268],{"id":267},"pour-qui","Pour qui",[109,270,271,274,277,280],{},[26,272,273],{},"Les streameurs qui ont besoin de cues sonores instantanés",[26,275,276],{},"Les amis qui veulent un board partagé pour le vocal",[26,278,279],{},"Les podcasteurs qui enregistrent des clips et les posent sur un board",[26,281,282],{},"Quiconque veut un soundboard personnalisable et local-first",[18,284,286],{"id":285},"ce-que-tu-peux-faire","Ce que tu peux faire",[109,288,289,292,295,298,301,304,310,313],{},[26,290,291],{},"Construire un soundboard à partir de tes propres fichiers audio",[26,293,294],{},"Organiser les sons dans des onglets colorés, des groupes et la recherche",[26,296,297],{},"Concevoir le look avec le Theme Creator",[26,299,300],{},"Enregistrer l’audio du PC ou un micro dans le Record Editor",[26,302,303],{},"Assigner des raccourcis à des sons individuels",[26,305,306,307],{},"Déclencher des sons depuis ",[70,308,63],{"href":309},"\u002Fdocs\u002Fremote-control",[26,311,312],{},"Importer et exporter un soundboard complet pour le partager",[26,314,315],{},"Utiliser des GIF ou des images sur les boutons de son",[18,317,319],{"id":318},"licence","Licence",[14,321,322,323,328],{},"SoundNinja est un logiciel libre sous ",[70,324,327],{"href":325,"rel":326},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fblob\u002Fmain\u002FLICENSE",[74],"GPL-3.0",". Forke-le, modifie-le, partage-le.",[18,330,332],{"id":331},"prochaines-étapes","Prochaines étapes",[23,334,335,341,347],{},[26,336,337],{},[70,338,340],{"href":339},"\u002Fdocs\u002Finstallation","Installer SoundNinja",[26,342,343],{},[70,344,346],{"href":345},"\u002Fdocs\u002Fadding-sounds","Ajouter des sons",[26,348,349],{},[70,350,352],{"href":351},"\u002Fdocs\u002Forganizing-sounds","Organiser ton board",{"title":230,"searchDepth":231,"depth":231,"links":354},[355,356,357,358],{"id":267,"depth":231,"text":268},{"id":285,"depth":231,"text":286},{"id":318,"depth":231,"text":319},{"id":331,"depth":231,"text":332},"Ce qu’est SoundNinja et ce que tu peux en faire.",{},1,"\u002Foverview",{"title":250,"description":359},"overview","ZY8wtO0KcJ2GGKh9NDik0dGVB6QXrk3FQ-5mCb0D4-8",{"id":367,"title":368,"body":369,"description":559,"extension":239,"meta":560,"navigation":241,"order":231,"path":561,"seo":562,"stem":373,"__hash__":563},"content_fr\u002Finstallation.md","Installation",{"type":7,"value":370,"toc":552},[371,374,388,392,410,413,417,431,434,438,462,473,477,484,488,503,533,548],[10,372,368],{"id":373},"installation",[14,375,376,377,381,382,387],{},"Récupère un build sur la ",[70,378,380],{"href":379},"\u002Fdownload","page Télécharger"," ou sur ",[70,383,386],{"href":384,"rel":385},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Freleases\u002Flatest",[74],"GitHub Releases",". SoundNinja est en développement précoce — traite les builds comme des bêtas.",[18,389,391],{"id":390},"windows","Windows",[109,393,394,404,407],{},[26,395,396,399,400,403],{},[30,397,398],{},"Installateur (.exe)"," ou ",[30,401,402],{},"MSI (.msi)"," pour Windows 64 bits",[26,405,406],{},"Cible de la landing page : Windows 10 et plus",[26,408,409],{},"Le README de l’app mentionne aussi Windows 8 et supérieur",[14,411,412],{},"Lance l’installateur, puis ouvre SoundNinja depuis le menu Démarrer.",[18,414,416],{"id":415},"macos","macOS",[109,418,419,425,428],{},[26,420,421,424],{},[30,422,423],{},".dmg universel"," pour Apple Silicon et Intel",[26,426,427],{},"Cible de la landing page : macOS 10.14 et plus",[26,429,430],{},"Le README de l’app mentionne macOS 10.15 et supérieur",[14,432,433],{},"Ouvre l’image disque et glisse SoundNinja dans Applications.",[18,435,437],{"id":436},"linux","Linux",[109,439,440,446,452,459],{},[26,441,442,445],{},[30,443,444],{},"Debian (.deb)"," pour Ubuntu \u002F Debian",[26,447,448,451],{},[30,449,450],{},"AppImage"," pour les autres distros",[26,453,454,455,458],{},"Après publication d’une release, les utilisateurs Arch peuvent installer ",[44,456,457],{},"soundninja-bin"," depuis l’AUR",[26,460,461],{},"Testé sur Ubuntu 20.04",[14,463,464,465,468,469,472],{},"Les builds desktop ont besoin des paquets WebKit et GTK. Sous Debian\u002FUbuntu, ça veut souvent dire ",[44,466,467],{},"libwebkit2gtk",", ",[44,470,471],{},"libgtk-3-0"," et une bibliothèque app-indicator.",[18,474,476],{"id":475},"mises-à-jour","Mises à jour",[14,478,479,480,483],{},"Dans l’app, ouvre ",[30,481,482],{},"Aide → Rechercher les mises à jour",". Tu peux aussi laisser SoundNinja vérifier au démarrage dans les Paramètres.",[18,485,487],{"id":486},"compiler-depuis-les-sources","Compiler depuis les sources",[14,489,490,491,496,497,502],{},"Besoin d’un build custom ? Clone ",[70,492,495],{"href":493,"rel":494},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja",[74],"le repo",", installe les ",[70,498,501],{"href":499,"rel":500},"https:\u002F\u002Fv2.tauri.app\u002Fstart\u002Fprerequisites\u002F",[74],"prérequis Tauri",", puis :",[504,505,509],"pre",{"className":506,"code":507,"language":508,"meta":230,"style":230},"language-bash shiki shiki-themes github-light github-dark","bun install\nbun run tauri:serve\n","bash",[44,510,511,523],{"__ignoreMap":230},[512,513,515,519],"span",{"class":514,"line":361},"line",[512,516,518],{"class":517},"sScJk","bun",[512,520,522],{"class":521},"sZZnC"," install\n",[512,524,525,527,530],{"class":514,"line":231},[512,526,518],{"class":517},[512,528,529],{"class":521}," run",[512,531,532],{"class":521}," tauri:serve\n",[14,534,535,468,538,399,541,544,545,33],{},[44,536,537],{},"npm",[44,539,540],{},"pnpm",[44,542,543],{},"deno"," marchent aussi. Build de production : ",[44,546,547],{},"bun run tauri:build",[549,550,551],"style",{},"html pre.shiki code .sScJk, html code.shiki .sScJk{--shiki-default:#6F42C1;--shiki-dark:#B392F0}html pre.shiki code .sZZnC, html code.shiki .sZZnC{--shiki-default:#032F62;--shiki-dark:#9ECBFF}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html.dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}",{"title":230,"searchDepth":231,"depth":231,"links":553},[554,555,556,557,558],{"id":390,"depth":231,"text":391},{"id":415,"depth":231,"text":416},{"id":436,"depth":231,"text":437},{"id":475,"depth":231,"text":476},{"id":486,"depth":231,"text":487},"Installe SoundNinja sur Windows, macOS ou Linux.",{},"\u002Finstallation",{"title":368,"description":559},"pbEgfObzQ57hJHQ_Y3qGhgX0zLihiW_l6ZrgNA2lCO8",{"id":565,"title":346,"body":566,"description":704,"extension":239,"meta":705,"navigation":241,"order":706,"path":707,"seo":708,"stem":709,"__hash__":710},"content_fr\u002Fadding-sounds.md",{"type":7,"value":567,"toc":696},[568,571,574,578,596,600,631,635,654,658,672,675,679,686,690],[10,569,346],{"id":570},"ajouter-des-sons",[14,572,573],{},"Un board reste vide tant que tu n’ajoutes pas de clips. SoundNinja peut importer des fichiers, des dossiers entiers, un enregistrement ou un pack de soundboard partagé.",[18,575,577],{"id":576},"importer-des-fichiers-audio","Importer des fichiers audio",[23,579,580,590,593],{},[26,581,28,582,585,586,589],{},[30,583,584],{},"Fichier → Importer des fichiers audio",", ou utilise ",[30,587,588],{},"Importer"," dans la barre de navigation.",[26,591,592],{},"Choisis un ou plusieurs fichiers audio.",[26,594,595],{},"Les sons arrivent dans l’onglet actuel.",[18,597,599],{"id":598},"importer-des-dossiers","Importer des dossiers",[23,601,602,611,614],{},[26,603,28,604,607,608,610],{},[30,605,606],{},"Fichier → Importer des dossiers"," (ou ",[30,609,599],{}," dans la barre de navigation).",[26,612,613],{},"Ajoute un ou plusieurs dossiers. Glisse pour les réordonner avant l’import.",[26,615,616,617],{},"Choisis comment ils arrivent :\n",[109,618,619,625],{},[26,620,621,624],{},[30,622,623],{},"Importer comme onglets"," — chaque dossier devient son propre onglet",[26,626,627,630],{},[30,628,629],{},"Importer dans l’onglet actuel"," — chaque fichier va dans l’onglet actif",[18,632,634],{"id":633},"enregistrer-un-clip","Enregistrer un clip",[14,636,637,638,642,643,646,647,399,650,653],{},"Ouvre le ",[70,639,641],{"href":640},"\u002Fdocs\u002Frecording-editor","Record Editor"," depuis le bouton ",[30,644,645],{},"Enregistrer"," dans la barre du lecteur. Capture, coupe, puis ",[30,648,649],{},"Importer la sélection",[30,651,652],{},"Tout importer"," dans l’onglet actuel ou un onglet que tu choisis.",[18,655,657],{"id":656},"importer-un-soundboard","Importer un soundboard",[14,659,660,663,664,667,668,671],{},[30,661,662],{},"Fichier → Importer un soundboard"," charge un pack partagé. Les packs sont un ",[44,665,666],{},".zip"," qui contient ",[44,669,670],{},"project.sninja"," plus les fichiers audio. Après l’import, ouvre le projet et joue.",[14,673,674],{},"Tu peux aussi garder plusieurs projets (profils). Utilise le sélecteur de projet pour changer de board.",[18,676,678],{"id":677},"relier-les-fichiers-manquants","Relier les fichiers manquants",[14,680,681,682,685],{},"Si des fichiers audio bougent sur le disque, SoundNinja affiche ",[30,683,684],{},"Fichiers audio manquants",". Choisis un dossier à parcourir et relie les clips.",[18,687,689],{"id":688},"suite","Suite",[14,691,692,693,33],{},"Organise onglets, groupes et raccourcis dans ",[70,694,695],{"href":351},"Organiser les sons",{"title":230,"searchDepth":231,"depth":231,"links":697},[698,699,700,701,702,703],{"id":576,"depth":231,"text":577},{"id":598,"depth":231,"text":599},{"id":633,"depth":231,"text":634},{"id":656,"depth":231,"text":657},{"id":677,"depth":231,"text":678},{"id":688,"depth":231,"text":689},"Importe de l’audio, des dossiers, des enregistrements et des soundboards partagés.",{},3,"\u002Fadding-sounds",{"title":346,"description":704},"adding-sounds","WxjyAOY51Jh80jxw4Xvj7Ko_IY_wVuHJST0KFUWSZ9k",{"id":712,"title":695,"body":713,"description":859,"extension":239,"meta":860,"navigation":241,"order":861,"path":862,"seo":863,"stem":864,"__hash__":865},"content_fr\u002Forganizing-sounds.md",{"type":7,"value":714,"toc":850},[715,718,721,725,752,759,763,766,780,787,791,797,801,812,816,819,823,826,832,838,842],[10,716,695],{"id":717},"organiser-les-sons",[14,719,720],{},"SoundNinja est conçu pour les grandes bibliothèques. Utilise les onglets, les groupes, la recherche et les raccourcis pour que le clip dont tu as besoin soit à un clic (ou une touche) près.",[18,722,724],{"id":723},"onglets","Onglets",[109,726,727,734,741],{},[26,728,729,730,733],{},"Ajoute un onglet avec ",[30,731,732],{},"Ajouter un onglet",". Donne-lui une couleur pour scanner la barre vite.",[26,735,736,737,740],{},"La vue ",[30,738,739],{},"Tous"," montre chaque son à travers les onglets.",[26,742,743,744,747,748,751],{},"Un son peut appartenir à ",[30,745,746],{},"un ou plusieurs onglets",". Clic droit sur un son et utilise ",[30,749,750],{},"Déplacer vers l’onglet"," pour l’assigner.",[14,753,754,755,758],{},"Les transitions d’onglets sont dans ",[30,756,757],{},"Paramètres → Général"," : Slide, Fade, Boutons un par un, ou Aucune.",[18,760,762],{"id":761},"groupes","Groupes",[14,764,765],{},"Depuis la v0.5.3, les séparateurs peuvent devenir des groupes nommés :",[109,767,768,771,774,777],{},[26,769,770],{},"Ajouter, renommer ou supprimer un groupe depuis le menu contextuel",[26,772,773],{},"Glisser l’en-tête du groupe — les enfants suivent",[26,775,776],{},"Déposer des sons dans un groupe ou les en sortir",[26,778,779],{},"Régler la couleur de bordure, la couleur du nom et l’alignement des boutons (ou utiliser le défaut de l’onglet)",[14,781,782,783,786],{},"Tu peux toujours ajouter un ",[30,784,785],{},"Séparateur"," simple si tu as seulement besoin d’une coupure visuelle.",[18,788,790],{"id":789},"recherche","Recherche",[14,792,793,794,796],{},"Utilise le champ ",[30,795,790],{}," dans la barre de navigation. Les résultats se mettent à jour pendant que tu tapes.",[18,798,800],{"id":799},"réordonner","Réordonner",[14,802,803,804,807,808,811],{},"Active le glisser-déposer dans ",[30,805,806],{},"Paramètres → Comportement"," (",[30,809,810],{},"Autoriser le réordonnancement","). Puis glisse sons et groupes en place.",[18,813,815],{"id":814},"édition-groupée","Édition groupée",[14,817,818],{},"Sélectionne plusieurs sons, puis change la couleur, déplace-les vers un onglet ou supprime-les en une étape.",[18,820,822],{"id":821},"raccourcis-et-ids-de-son","Raccourcis et IDs de son",[14,824,825],{},"Chaque son a un ID de 8 caractères. Copie-le depuis le menu contextuel du bouton ou la puce d’ID de la sélection multiple.",[14,827,28,828,831],{},[30,829,830],{},"Paramètres → Raccourcis"," pour lier une touche à un ID de son. Les raccourcis globaux sont optionnels.",[14,833,834,835,837],{},"Le même ID est ce que ",[70,836,63],{"href":309}," utilise pour déclencher un clip.",[18,839,841],{"id":840},"gifs-et-couleurs","GIFs et couleurs",[14,843,844,845,849],{},"Clic droit sur un son pour régler des couleurs par bouton ou un fond GIF \u002F image. C’est séparé du ",[70,846,848],{"href":847},"\u002Fdocs\u002Ftheme-editor","Theme Creator",", qui habille tout le board.",{"title":230,"searchDepth":231,"depth":231,"links":851},[852,853,854,855,856,857,858],{"id":723,"depth":231,"text":724},{"id":761,"depth":231,"text":762},{"id":789,"depth":231,"text":790},{"id":799,"depth":231,"text":800},{"id":814,"depth":231,"text":815},{"id":821,"depth":231,"text":822},{"id":840,"depth":231,"text":841},"Onglets, groupes, recherche, édition groupée et raccourcis.",{},4,"\u002Forganizing-sounds",{"title":695,"description":859},"organizing-sounds","s3oaYG46DStsSAtCx2-Sgrn_LoxScaKkOmEWwKlXmKQ",{"id":867,"title":868,"body":869,"description":994,"extension":239,"meta":995,"navigation":241,"order":996,"path":997,"seo":998,"stem":999,"__hash__":1000},"content_fr\u002Ftheme-editor.md","Éditeur de thème",{"type":7,"value":870,"toc":988},[871,874,880,884,910,913,917,931,935,961,964,968,974],[10,872,868],{"id":873},"éditeur-de-thème",[14,875,876,877,33],{},"Le Theme Creator est l’éditeur visuel complet de ton board. Ouvre-le depuis ",[30,878,879],{},"Paramètres → Général → Theme Creator",[18,881,883],{"id":882},"trois-onglets","Trois onglets",[23,885,886,899,905],{},[26,887,888,891,892,153,895,898],{},[30,889,890],{},"Général"," — nom du thème, couleurs partagées et import de polices (",[44,893,894],{},".ttf",[44,896,897],{},".otf",")",[26,900,901,904],{},[30,902,903],{},"Boutons"," — couleurs, typo, disposition et overlay GIF des boutons de son",[26,906,907,909],{},[30,908,724],{}," — couleurs, typo et épaisseur de bordure de la barre d’onglets",[14,911,912],{},"Un aperçu en direct montre onglets et boutons pendant que tu édites.",[18,914,916],{"id":915},"ce-que-tu-peux-changer","Ce que tu peux changer",[109,918,919,922,925,928],{},[26,920,921],{},"Couleurs primaire et d’accent, fonds, couleurs des boutons, couleurs des onglets",[26,923,924],{},"Famille et taille de police des boutons et des onglets",[26,926,927],{},"Largeur, rayon, bordure, écarts et padding des boutons",[26,929,930],{},"Opacité de l’overlay GIF (normal et survol)",[18,932,934],{"id":933},"enregistrer-et-partager","Enregistrer et partager",[109,936,937,943,949,955],{},[26,938,939,942],{},[30,940,941],{},"Exporter .css"," — écrire un fichier de thème à sauvegarder ou envoyer à un ami",[26,944,945,948],{},[30,946,947],{},"Ajouter aux thèmes"," — enregistrer le fichier dans ton dossier Themes et l’appliquer",[26,950,951,954],{},[30,952,953],{},"Importer .css"," — charger un preset intégré ou un thème enregistré",[26,956,957,960],{},[30,958,959],{},"Réinitialiser"," — revenir aux défauts SoundNinja",[14,962,963],{},"Si tu fermes la fenêtre avec des changements non enregistrés, SoundNinja te demande d’enregistrer d’abord.",[18,965,967],{"id":966},"sans-léditeur-complet","Sans l’éditeur complet",[14,969,970,971,973],{},"Dans ",[30,972,757],{}," tu peux toujours :",[109,975,976,979,985],{},[26,977,978],{},"Choisir un thème dans la liste",[26,980,981,982,898],{},"Éditer les variables CSS en direct (",[30,983,984],{},"CSS personnalisé",[26,986,987],{},"Importer un fichier de thème dans le dossier Themes",{"title":230,"searchDepth":231,"depth":231,"links":989},[990,991,992,993],{"id":882,"depth":231,"text":883},{"id":915,"depth":231,"text":916},{"id":933,"depth":231,"text":934},{"id":966,"depth":231,"text":967},"Concevoir couleurs, polices, boutons et onglets dans le Theme Creator.",{},5,"\u002Ftheme-editor",{"title":868,"description":994},"theme-editor","wkR6rxJNnSmcJeJxDdslCOIyK7-9BblSMG_tJA6IwRY",{"id":1002,"title":1003,"body":1004,"description":1137,"extension":239,"meta":1138,"navigation":241,"order":1139,"path":1140,"seo":1141,"stem":1142,"__hash__":1143},"content_fr\u002Frecording-editor.md","Éditeur d’enregistrement",{"type":7,"value":1005,"toc":1131},[1006,1009,1015,1019,1025,1045,1048,1052,1077,1081,1095,1099,1114,1121],[10,1007,1003],{"id":1008},"éditeur-denregistrement",[14,1010,1011,1012,1014],{},"Enregistre un clip dans SoundNinja, coupe-le, puis importe-le sur un onglet. Ouvre l’éditeur avec le bouton ",[30,1013,645],{}," dans la barre du lecteur.",[18,1016,1018],{"id":1017},"choisir-une-entrée","Choisir une entrée",[14,1020,970,1021,1024],{},[30,1022,1023],{},"Paramètres → Audio"," :",[109,1026,1027,1033,1039],{},[26,1028,1029,1032],{},[30,1030,1031],{},"Périphériques d’entrée"," — microphone",[26,1034,1035,1038],{},[30,1036,1037],{},"Périphériques de sortie (audio PC)"," — loopback de ce que le PC joue",[26,1040,1041,1044],{},[30,1042,1043],{},"Volume d’entrée"," — gain de capture de 0 % à 200 %",[14,1046,1047],{},"Le bouton Enregistrer utilise le périphérique choisi ici.",[18,1049,1051],{"id":1050},"éditer-la-prise","Éditer la prise",[109,1053,1054,1057,1060,1068,1071,1074],{},[26,1055,1056],{},"Enregistrer et arrêter",[26,1058,1059],{},"Surveiller le vu-mètre d’entrée",[26,1061,1062,399,1065],{},[30,1063,1064],{},"Normaliser",[30,1066,1067],{},"Réduction de bruit",[26,1069,1070],{},"Couper tout le clip, couper à une sélection, ou supprimer une sélection",[26,1072,1073],{},"Annuler \u002F rétablir",[26,1075,1076],{},"Zoomer et dézoomer",[18,1078,1080],{"id":1079},"préparer-et-importer","Préparer et importer",[23,1082,1083,1086,1089],{},[26,1084,1085],{},"Ajoute la sélection ou la piste complète à la liste de staging.",[26,1087,1088],{},"La liste commence vide : enregistre, édite, puis ajoute un clip.",[26,1090,1091,399,1093,653],{},[30,1092,649],{},[30,1094,652],{},[18,1096,1098],{"id":1097},"séparation-de-stems-optionnel","Séparation de stems (optionnel)",[14,1100,1101,1102,1105,1106,1109,1110,1113],{},"Le Record Editor peut garder les ",[30,1103,1104],{},"voix"," ou la ",[30,1107,1108],{},"musique"," avec BS-RoFormer. Le modèle fait environ 158 MB et n’est ",[30,1111,1112],{},"pas"," inclus avec l’app.",[14,1115,1116,1117,1120],{},"Télécharge-le depuis ",[30,1118,1119],{},"Paramètres → Séparation de stems",", ou accepte l’invite au premier lancement. L’installateur Windows peut aussi proposer de télécharger le modèle au premier démarrage.",[14,1122,1123,1124,153,1127,1130],{},"Les builds source avec stems ont besoin d’un flag extra (",[44,1125,1126],{},"tauri:serve:stems",[44,1128,1129],{},"tauri:build:stems",").",{"title":230,"searchDepth":231,"depth":231,"links":1132},[1133,1134,1135,1136],{"id":1017,"depth":231,"text":1018},{"id":1050,"depth":231,"text":1051},{"id":1079,"depth":231,"text":1080},{"id":1097,"depth":231,"text":1098},"Capturer le micro ou l’au