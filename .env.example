# Local backup of release/AUR secrets. Copy to .env and fill in.
# Never commit .env. Push to GitHub with: ./scripts/setup-secrets.ps1 -Push
# Workflows do not read this file; CI uses GitHub Actions secrets of the same names.

# GPG release signing (AppImage, .asc, SHA256SUMS, pacman .sig)
GPG_PRIVATE_KEY=
GPG_PASSPHRASE=
GPG_FINGERPRINT=
GPG_PUBLIC_KEY=
GPG_REVOCATION_CERT=

# Tauri updater (minisign) — already used by CI. Copy from your existing local key;
# GitHub secrets cannot be read back.
TAURI_SIGNING_PRIVATE_KEY=
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=

# AUR deploy (https://aur.archlinux.org/register)
AUR_USERNAME=
AUR_EMAIL=contact@marcus-universe.de
AUR_SSH_PRIVATE_KEY=
AUR_SSH_PUBLIC_KEY=
