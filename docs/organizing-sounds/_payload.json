[{"data":1,"prerenderedAt":1752},["ShallowReactive",2],{"docs-page-en-\u002Forganizing-sounds":3,"docs-nav-en":427},{"id":4,"title":5,"body":6,"description":419,"extension":420,"meta":421,"navigation":422,"order":423,"path":424,"seo":425,"stem":12,"__hash__":426},"content_en\u002Forganizing-sounds.md","Organizing Sounds",{"type":7,"value":8,"toc":401},"minimark",[9,13,22,27,56,63,67,70,84,91,98,102,112,117,151,155,161,165,198,204,208,211,240,243,247,261,265,271,292,308,315,319,329,332,336,343,353,362,366,374,381,398],[10,11,5],"h1",{"id":12},"organizing-sounds",[14,15,16,17,21],"p",{},"SoundNinja is built for large libraries. Use ",[18,19,20],"strong",{},"tags and filters",", tabs, search, multi-select, and hotkeys so the clip you need is one click (or one key) away.",[23,24,26],"h2",{"id":25},"tabs","Tabs",[28,29,30,38,45],"ul",{},[31,32,33,34,37],"li",{},"Add a tab with ",[18,35,36],{},"Add tab",". Give it a color so you can scan the bar fast.",[31,39,40,41,44],{},"The ",[18,42,43],{},"All"," view shows every sound across tabs.",[31,46,47,48,51,52,55],{},"A sound can belong to ",[18,49,50],{},"one or more tabs",". Right-click a sound and use ",[18,53,54],{},"Move to tab"," to assign it.",[14,57,58,59,62],{},"Tab transitions live in ",[18,60,61],{},"Settings → Main",": Slide, Fade, Buttons one by one, or None.",[23,64,66],{"id":65},"groups","Groups",[14,68,69],{},"Since v0.5.3, separators can become named groups:",[28,71,72,75,78,81],{},[31,73,74],{},"Add, rename, or remove a group from the context menu",[31,76,77],{},"Drag the group header — children move with it",[31,79,80],{},"Drop sounds in or out of a group",[31,82,83],{},"Set group border color, name color, and button alignment (or use the tab default)",[14,85,86,87,90],{},"You can still add a plain ",[18,88,89],{},"Separator"," if you only need a visual break.",[14,92,93,94,97],{},"Right-click empty board space to ",[18,95,96],{},"Add Group",".",[23,99,101],{"id":100},"tags-filters","Tags \u002F Filters",[14,103,104,105,108,109,111],{},"Tags cut across tabs. The slide-out ",[18,106,107],{},"Filter"," panel (sidebar ",[18,110,107],{},") is where you create them and turn them into a board filter.",[113,114,116],"h3",{"id":115},"create-and-edit-tags","Create and edit tags",[118,119,120,126,137,144],"ol",{},[31,121,122,123,125],{},"Open ",[18,124,107],{}," in the sidebar.",[31,127,128,129,132,133,136],{},"Under ",[18,130,131],{},"Tags",", use ",[18,134,135],{},"Add tag"," — give it a name and a color.",[31,138,139,140,143],{},"Rename, recolor, or ",[18,141,142],{},"Delete tag"," from the same list.",[31,145,146,147,150],{},"If you see ",[18,148,149],{},"No tags yet",", add one here before you assign anything.",[113,152,154],{"id":153},"assign-tags-to-sounds","Assign tags to sounds",[14,156,157,158,160],{},"Right-click a sound → ",[18,159,131],{}," (checkboxes). A sound can have several tags. If none exist yet, the menu tells you to open the filter panel.",[113,162,164],{"id":163},"filter-the-board","Filter the board",[28,166,167,173,184,195],{},[31,168,169,170,97],{},"Toggle tags in the Filter panel, or as ",[18,171,172],{},"chips under the search bar",[31,174,175,176,179,180,183],{},"Matching is ",[18,177,178],{},"OR",": a sound stays visible if it has ",[18,181,182],{},"any"," selected tag.",[31,185,186,187,190,191,194],{},"The navbar ",[18,188,189],{},"Search"," field ",[18,192,193],{},"ANDs"," with the active tag filter (type + tags together).",[31,196,197],{},"Turn chips off (or clear the filter) to show the full tab again.",[14,199,200,201,97],{},"Colored tag names can appear on buttons. Toggle them in ",[18,202,203],{},"Settings → Behavior → Show tag badges",[23,205,207],{"id":206},"sort","Sort",[14,209,210],{},"Open the filter panel and pick a sort mode:",[28,212,213,219],{},[31,214,215,218],{},[18,216,217],{},"User defined"," — your tab order, with groups visible",[31,220,221,224,225,224,228,231,232,235,236,239],{},[18,222,223],{},"Name",", ",[18,226,227],{},"Added time",[18,229,230],{},"Play time",", or ",[18,233,234],{},"File size"," — a flat sorted list; ",[18,237,238],{},"groups are hidden"," in these modes",[14,241,242],{},"Duration sort may warm duration metadata the first time you use it.",[23,244,246],{"id":245},"reorder","Reorder",[14,248,249,250,253,254,257,258,260],{},"Turn on drag-and-drop in ",[18,251,252],{},"Settings → Behavior"," (",[18,255,256],{},"Allow reorder","). Then drag sounds and groups into place. Reorder applies in ",[18,259,217],{}," sort.",[23,262,264],{"id":263},"multi-select","Multi-select",[14,266,267,268,270],{},"Turn on ",[18,269,264],{}," in the navbar, then:",[28,272,273,276,282,289],{},[31,274,275],{},"Click a sound to toggle it",[31,277,278,281],{},[18,279,280],{},"Shift+click"," to select a range from the last anchor",[31,283,284,285,288],{},"Drag a ",[18,286,287],{},"marquee"," on empty board space",[31,290,291],{},"Click empty board (or outside) to clear the selection",[14,293,294,295,224,298,224,301,304,305,97],{},"A bulk bar appears with the count, plus ",[18,296,297],{},"Color",[18,299,300],{},"Move to tab…",[18,302,303],{},"Delete",", and ",[18,306,307],{},"Done",[14,309,310,311,314],{},"In multi-select, each button shows an ",[18,312,313],{},"8-character ID chip",". Right-click the chip to copy it.",[23,316,318],{"id":317},"per-sound-volume","Per-sound volume",[14,320,157,321,324,325,328],{},[18,322,323],{},"Volume",". Drag the slider from 0% to 100%. ",[18,326,327],{},"Double-click"," the slider to reset to 100%.",[14,330,331],{},"This stacks with the master output volume in Settings.",[23,333,335],{"id":334},"hotkeys-and-sound-ids","Hotkeys and sound IDs",[14,337,338,339,342],{},"Every sound has an 8-character ID. Copy it from the button context menu (",[18,340,341],{},"Copy ID",") or the multi-select ID chip.",[14,344,122,345,348,349,352],{},[18,346,347],{},"Settings → Hotkeys"," to bind a key to a sound ID. Global hotkeys are optional. ",[18,350,351],{},"Assign hotkey"," on the context menu jumps there with the ID prefilled.",[14,354,355,356,361],{},"The same ID is what ",[357,358,360],"a",{"href":359},"\u002Fdocs\u002Fremote-control","Bitfocus Companion"," uses to trigger a clip.",[23,363,365],{"id":364},"background-images-and-colors","Background images and colors",[14,367,368,369,373],{},"Right-click a sound to set per-button colors or a background image. That is separate from the ",[357,370,372],{"href":371},"\u002Fdocs\u002Ftheme-editor","Theme Creator",", which styles the whole board.",[14,375,376,377,380],{},"The picker is a ",[18,378,379],{},"Background image"," dialog (PNG, JPEG, GIF, WebP):",[28,382,383,389],{},[31,384,385,388],{},[18,386,387],{},"Local files"," — add folders, pick a single file, search filenames, preview the grid, or remove a folder from the library",[31,390,391,394,395,397],{},[18,392,393],{},"KLIPY"," — search online GIFs. Set your own API key in ",[18,396,252],{},". The key is not stored in project files.",[14,399,400],{},"After you pick an image, pan and crop it on the button.",{"title":402,"searchDepth":403,"depth":403,"links":404},"",2,[405,406,407,413,414,415,416,417,418],{"id":25,"depth":403,"text":26},{"id":65,"depth":403,"text":66},{"id":100,"depth":403,"text":101,"children":408},[409,411,412],{"id":115,"depth":410,"text":116},3,{"id":153,"depth":410,"text":154},{"id":163,"depth":410,"text":164},{"id":206,"depth":403,"text":207},{"id":245,"depth":403,"text":246},{"id":263,"depth":403,"text":264},{"id":317,"depth":403,"text":318},{"id":334,"depth":403,"text":335},{"id":364,"depth":403,"text":365},"Tags, filters, tabs, groups, sort, multi-select, volume, and hotkeys.","md",{},true,4,"\u002Forganizing-sounds",{"title":5,"description":419},"DaYqySVuX1kgdTnJw6h1GP_lGyj4zdFP2uKKbBEbVwQ",[428,554,755,901,1151,1286,1432,1654],{"id":429,"title":430,"body":431,"description":548,"extension":420,"meta":549,"navigation":422,"order":550,"path":551,"seo":552,"stem":435,"__hash__":553},"content_en\u002Foverview.md","Overview",{"type":7,"value":432,"toc":542},[433,436,439,442,445,449,463,467,504,508,518,522],[10,434,430],{"id":435},"overview",[14,437,438],{},"SoundNinja is an open-source soundboard for live streaming, chatting with friends, and podcast recording. It is built with Tauri v2 and Nuxt 4 so it stays light on RAM and disk.",[14,440,441],{},"The goal is simple: keep a huge sound library easy to scan, then play the right clip in milliseconds. The UI also works well as a dashboard in VR.",[14,443,444],{},"SoundNinja is still in early development. Features work, but not every platform is fully tested.",[23,446,448],{"id":447},"who-it-is-for","Who it is for",[28,450,451,454,457,460],{},[31,452,453],{},"Streamers who need instant sound cues",[31,455,456],{},"Friends who want a shared board for voice chat",[31,458,459],{},"Podcasters who record clips and drop them onto a board",[31,461,462],{},"Anyone who wants a customizable, local-first soundboard",[23,464,466],{"id":465},"what-you-can-do","What you can do",[28,468,469,472,475,478,481,484,487,490,493,498,501],{},[31,470,471],{},"Build a soundboard from your own audio files",[31,473,474],{},"Organize sounds in colored tabs, groups, tags, and search",[31,476,477],{},"Filter by tags (OR) and sort by name, date, duration, or size",[31,479,480],{},"Multi-select with marquee or Shift-range, then bulk color, move, or delete",[31,482,483],{},"Set per-sound volume from the context menu",[31,485,486],{},"Design the look with the Theme Creator",[31,488,489],{},"Record PC audio or a microphone in the Record Editor",[31,491,492],{},"Assign hotkeys to individual sounds",[31,494,495,496],{},"Trigger sounds from ",[357,497,360],{"href":359},[31,499,500],{},"Import and export a full soundboard to share with others",[31,502,503],{},"Use GIFs or images on sound buttons — from a local folder library or KLIPY",[23,505,507],{"id":506},"license","License",[14,509,510,511,517],{},"SoundNinja is free software under ",[357,512,516],{"href":513,"rel":514},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fblob\u002Fmain\u002FLICENSE",[515],"nofollow","GPL-3.0",". Fork it, change it, share it.",[23,519,521],{"id":520},"next-steps","Next steps",[118,523,524,530,536],{},[31,525,526],{},[357,527,529],{"href":528},"\u002Fdocs\u002Finstallation","Install SoundNinja",[31,531,532],{},[357,533,535],{"href":534},"\u002Fdocs\u002Fadding-sounds","Add sounds",[31,537,538],{},[357,539,541],{"href":540},"\u002Fdocs\u002Forganizing-sounds","Organize your board",{"title":402,"searchDepth":403,"depth":403,"links":543},[544,545,546,547],{"id":447,"depth":403,"text":448},{"id":465,"depth":403,"text":466},{"id":506,"depth":403,"text":507},{"id":520,"depth":403,"text":521},"What SoundNinja is and what you can do with it.",{},1,"\u002Foverview",{"title":430,"description":548},"Dax9ydiOOeEz5F1IxWfEljWZynntK7dPp52JZ3q2G58",{"id":555,"title":556,"body":557,"description":750,"extension":420,"meta":751,"navigation":422,"order":403,"path":752,"seo":753,"stem":561,"__hash__":754},"content_en\u002Finstallation.md","Installation",{"type":7,"value":558,"toc":743},[559,562,576,580,601,604,608,622,625,629,654,664,668,675,679,694,724,739],[10,560,556],{"id":561},"installation",[14,563,564,565,569,570,575],{},"Grab a build from the ",[357,566,568],{"href":567},"\u002Fdownload","Download page"," or from ",[357,571,574],{"href":572,"rel":573},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Freleases\u002Flatest",[515],"GitHub Releases",". SoundNinja is in early development, so treat builds as beta.",[23,577,579],{"id":578},"windows","Windows",[28,581,582,592,595,598],{},[31,583,584,587,588,591],{},[18,585,586],{},"Installer (.exe)"," or ",[18,589,590],{},"MSI (.msi)"," for 64-bit Windows",[31,593,594],{},"Landing page target: Windows 10 and newer",[31,596,597],{},"The app README also lists Windows 8 and above",[31,599,600],{},"The NSIS installer uses a dark theme. Pick a language during setup — SoundNinja remembers it on the next launch.",[14,602,603],{},"Run the installer, then launch SoundNinja from the Start menu.",[23,605,607],{"id":606},"macos","macOS",[28,609,610,616,619],{},[31,611,612,615],{},[18,613,614],{},"Universal .dmg"," for Apple Silicon and Intel",[31,617,618],{},"Landing page target: macOS 10.14 and newer",[31,620,621],{},"The app README lists macOS 10.15 and above",[14,623,624],{},"Open the disk image and drag SoundNinja to Applications.",[23,626,628],{"id":627},"linux","Linux",[28,630,631,637,643,651],{},[31,632,633,636],{},[18,634,635],{},"Debian (.deb)"," for Ubuntu \u002F Debian",[31,638,639,642],{},[18,640,641],{},"AppImage"," for other distros",[31,644,645,646,650],{},"After a release is published, Arch users can install ",[647,648,649],"code",{},"soundninja-bin"," from the AUR",[31,652,653],{},"Tested on Ubuntu 20.04",[14,655,656,657,224,660,663],{},"Desktop builds need WebKit and GTK packages. On Debian\u002FUbuntu that usually means ",[647,658,659],{},"libwebkit2gtk",[647,661,662],{},"libgtk-3-0",", and an app-indicator library.",[23,665,667],{"id":666},"updates","Updates",[14,669,670,671,674],{},"In the app, open ",[18,672,673],{},"Help → Check for Updates",". You can also let SoundNinja check on startup in Settings.",[23,676,678],{"id":677},"build-from-source","Build from source",[14,680,681,682,687,688,693],{},"Need a custom build? Clone ",[357,683,686],{"href":684,"rel":685},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja",[515],"the repo",", install ",[357,689,692],{"href":690,"rel":691},"https:\u002F\u002Fv2.tauri.app\u002Fstart\u002Fprerequisites\u002F",[515],"Tauri prerequisites",", then:",[695,696,700],"pre",{"className":697,"code":698,"language":699,"meta":402,"style":402},"language-bash shiki shiki-themes github-light github-dark","bun install\nbun run tauri:serve\n","bash",[647,701,702,714],{"__ignoreMap":402},[703,704,706,710],"span",{"class":705,"line":550},"line",[703,707,709],{"class":708},"sScJk","bun",[703,711,713],{"class":712},"sZZnC"," install\n",[703,715,716,718,721],{"class":705,"line":403},[703,717,709],{"class":708},[703,719,720],{"class":712}," run",[703,722,723],{"class":712}," tauri:serve\n",[14,725,726,224,729,231,732,735,736,97],{},[647,727,728],{},"npm",[647,730,731],{},"pnpm",[647,733,734],{},"deno"," work too. Production build: ",[647,737,738],{},"bun run tauri:build",[740,741,742],"style",{},"html pre.shiki code .sScJk, html code.shiki .sScJk{--shiki-default:#6F42C1;--shiki-dark:#B392F0}html pre.shiki code .sZZnC, html code.shiki .sZZnC{--shiki-default:#032F62;--shiki-dark:#9ECBFF}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html.dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}",{"title":402,"searchDepth":403,"depth":403,"links":744},[745,746,747,748,749],{"id":578,"depth":403,"text":579},{"id":606,"depth":403,"text":607},{"id":627,"depth":403,"text":628},{"id":666,"depth":403,"text":667},{"id":677,"depth":403,"text":678},"Install SoundNinja on Windows, macOS, or Linux.",{},"\u002Finstallation",{"title":556,"description":750},"7viacDB8R6wsHmYhw6wWPv9XZF7nR_yMjR5-EjD4OjQ",{"id":756,"title":757,"body":758,"description":896,"extension":420,"meta":897,"navigation":422,"order":410,"path":898,"seo":899,"stem":762,"__hash__":900},"content_en\u002Fadding-sounds.md","Adding Sounds",{"type":7,"value":759,"toc":888},[760,763,766,770,788,792,824,828,847,851,865,868,872,879,883],[10,761,757],{"id":762},"adding-sounds",[14,764,765],{},"A board is empty until you add clips. SoundNinja can import files, whole folders, a recording, or a shared soundboard pack.",[23,767,769],{"id":768},"import-audio-files","Import audio files",[118,771,772,782,785],{},[31,773,122,774,777,778,781],{},[18,775,776],{},"File → Import Audio Files",", or use ",[18,779,780],{},"Import"," in the navbar.",[31,783,784],{},"Pick one or more audio files.",[31,786,787],{},"Sounds land in the current tab.",[23,789,791],{"id":790},"import-folders","Import folders",[118,793,794,804,807],{},[31,795,122,796,799,800,803],{},[18,797,798],{},"File → Import Folders"," (or ",[18,801,802],{},"Import Folders"," in the navbar).",[31,805,806],{},"Add one or more folders. Drag to reorder them before you import.",[31,808,809,810],{},"Choose how they land:\n",[28,811,812,818],{},[31,813,814,817],{},[18,815,816],{},"Import as Tabs"," — each folder becomes its own tab",[31,819,820,823],{},[18,821,822],{},"Import to current Tab"," — every file goes into the active tab",[23,825,827],{"id":826},"record-a-clip","Record a clip",[14,829,830,831,835,836,839,840,587,843,846],{},"Open the ",[357,832,834],{"href":833},"\u002Fdocs\u002Frecording-editor","Record Editor"," from the ",[18,837,838],{},"Record"," button in the player bar. Capture, trim, then ",[18,841,842],{},"Import selected",[18,844,845],{},"Import all"," into the current tab or a tab you pick.",[23,848,850],{"id":849},"import-a-soundboard","Import a soundboard",[14,852,853,856,857,860,861,864],{},[18,854,855],{},"File → Import Soundboard"," loads a shared pack. Packs are a ",[647,858,859],{},".zip"," that contains ",[647,862,863],{},"project.sninja"," plus the sound files. After import, open the project and play.",[14,866,867],{},"You can also keep several projects (profiles). Use the project selector to switch boards.",[23,869,871],{"id":870},"relink-missing-files","Relink missing files",[14,873,874,875,878],{},"If audio files move on disk, SoundNinja shows a ",[18,876,877],{},"Missing sound files"," dialog. Pick a folder to search and relink the clips.",[23,880,882],{"id":881},"next","Next",[14,884,885,886,97],{},"Organize tabs, tags, filters, and hotkeys in ",[357,887,5],{"href":540},{"title":402,"searchDepth":403,"depth":403,"links":889},[890,891,892,893,894,895],{"id":768,"depth":403,"text":769},{"id":790,"depth":403,"text":791},{"id":826,"depth":403,"text":827},{"id":849,"depth":403,"text":850},{"id":870,"depth":403,"text":871},{"id":881,"depth":403,"text":882},"Import audio, folders, recordings, and shared soundboards.",{},"\u002Fadding-sounds",{"title":757,"description":896},"SBUvL_H4633CrDyNUKazqKwru4aq1hhgoH4_o99rBsE",{"id":4,"title":5,"body":902,"description":419,"extension":420,"meta":1149,"navigation":422,"order":423,"path":424,"seo":1150,"stem":12,"__hash__":426},{"type":7,"value":903,"toc":1134},[904,906,910,912,928,932,934,936,946,950,954,956,962,964,984,986,990,992,1012,1016,1018,1020,1038,1040,1042,1050,1052,1056,1070,1080,1084,1086,1092,1094,1096,1100,1106,1110,1112,1116,1120,1132],[10,905,5],{"id":12},[14,907,16,908,21],{},[18,909,20],{},[23,911,26],{"id":25},[28,913,914,918,922],{},[31,915,33,916,37],{},[18,917,36],{},[31,919,40,920,44],{},[18,921,43],{},[31,923,47,924,51,926,55],{},[18,925,50],{},[18,927,54],{},[14,929,58,930,62],{},[18,931,61],{},[23,933,66],{"id":65},[14,935,69],{},[28,937,938,940,942,944],{},[31,939,74],{},[31,941,77],{},[31,943,80],{},[31,945,83],{},[14,947,86,948,90],{},[18,949,89],{},[14,951,93,952,97],{},[18,953,96],{},[23,955,101],{"id":100},[14,957,104,958,108,960,111],{},[18,959,107],{},[18,961,107],{},[113,963,116],{"id":115},[118,965,966,970,976,980],{},[31,967,122,968,125],{},[18,969,107],{},[31,971,128,972,132,974,136],{},[18,973,131],{},[18,97