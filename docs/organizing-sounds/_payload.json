[{"data":1,"prerenderedAt":1331},["ShallowReactive",2],{"docs-page-en-\u002Forganizing-sounds":3,"docs-nav-en":173},{"id":4,"title":5,"body":6,"description":165,"extension":166,"meta":167,"navigation":168,"order":169,"path":170,"seo":171,"stem":12,"__hash__":172},"content_en\u002Forganizing-sounds.md","Organizing Sounds",{"type":7,"value":8,"toc":154},"minimark",[9,13,17,22,52,59,63,66,80,87,91,97,101,112,116,119,123,126,133,142,146],[10,11,5],"h1",{"id":12},"organizing-sounds",[14,15,16],"p",{},"SoundNinja is built for large libraries. Use tabs, groups, search, and hotkeys so the clip you need is one click (or one key) away.",[18,19,21],"h2",{"id":20},"tabs","Tabs",[23,24,25,34,41],"ul",{},[26,27,28,29,33],"li",{},"Add a tab with ",[30,31,32],"strong",{},"Add tab",". Give it a color so you can scan the bar fast.",[26,35,36,37,40],{},"The ",[30,38,39],{},"All"," view shows every sound across tabs.",[26,42,43,44,47,48,51],{},"A sound can belong to ",[30,45,46],{},"one or more tabs",". Right-click a sound and use ",[30,49,50],{},"Move to tab"," to assign it.",[14,53,54,55,58],{},"Tab transitions live in ",[30,56,57],{},"Settings → Main",": Slide, Fade, Buttons one by one, or None.",[18,60,62],{"id":61},"groups","Groups",[14,64,65],{},"Since v0.5.3, separators can become named groups:",[23,67,68,71,74,77],{},[26,69,70],{},"Add, rename, or remove a group from the context menu",[26,72,73],{},"Drag the group header — children move with it",[26,75,76],{},"Drop sounds in or out of a group",[26,78,79],{},"Set group border color, name color, and button alignment (or use the tab default)",[14,81,82,83,86],{},"You can still add a plain ",[30,84,85],{},"Separator"," if you only need a visual break.",[18,88,90],{"id":89},"search","Search",[14,92,93,94,96],{},"Use the ",[30,95,90],{}," field in the navbar. Results update as you type.",[18,98,100],{"id":99},"reorder","Reorder",[14,102,103,104,107,108,111],{},"Turn on drag-and-drop in ",[30,105,106],{},"Settings → Behavior"," (",[30,109,110],{},"Allow reorder","). Then drag sounds and groups into place.",[18,113,115],{"id":114},"bulk-edit","Bulk edit",[14,117,118],{},"Multi-select sounds, then change color, move them to a tab, or delete them in one step.",[18,120,122],{"id":121},"hotkeys-and-sound-ids","Hotkeys and sound IDs",[14,124,125],{},"Every sound has an 8-character ID. Copy it from the button context menu or the multi-select ID chip.",[14,127,128,129,132],{},"Open ",[30,130,131],{},"Settings → Hotkeys"," to bind a key to a sound ID. Global hotkeys are optional.",[14,134,135,136,141],{},"The same ID is what ",[137,138,140],"a",{"href":139},"\u002Fdocs\u002Fremote-control","Bitfocus Companion"," uses to trigger a clip.",[18,143,145],{"id":144},"gifs-and-colors","GIFs and colors",[14,147,148,149,153],{},"Right-click a sound to set per-button colors or a GIF \u002F image background. That is separate from the ",[137,150,152],{"href":151},"\u002Fdocs\u002Ftheme-editor","Theme Creator",", which styles the whole board.",{"title":155,"searchDepth":156,"depth":156,"links":157},"",2,[158,159,160,161,162,163,164],{"id":20,"depth":156,"text":21},{"id":61,"depth":156,"text":62},{"id":89,"depth":156,"text":90},{"id":99,"depth":156,"text":100},{"id":114,"depth":156,"text":115},{"id":121,"depth":156,"text":122},{"id":144,"depth":156,"text":145},"Tabs, groups, search, bulk edit, and hotkeys.","md",{},true,4,"\u002Forganizing-sounds",{"title":5,"description":165},"Q4gLPzceZdOi3j6gqMTmPuTzf4qua7p2dfLn2shjKT4",[174,292,493,640,734,869,1011,1233],{"id":175,"title":176,"body":177,"description":286,"extension":166,"meta":287,"navigation":168,"order":288,"path":289,"seo":290,"stem":181,"__hash__":291},"content_en\u002Foverview.md","Overview",{"type":7,"value":178,"toc":280},[179,182,185,188,191,195,209,213,241,245,255,259],[10,180,176],{"id":181},"overview",[14,183,184],{},"SoundNinja is an open-source soundboard for live streaming, chatting with friends, and podcast recording. It is built with Tauri v2 and Nuxt 4 so it stays light on RAM and disk.",[14,186,187],{},"The goal is simple: keep a huge sound library easy to scan, then play the right clip in milliseconds. The UI also works well as a dashboard in VR.",[14,189,190],{},"SoundNinja is still in early development. Features work, but not every platform is fully tested.",[18,192,194],{"id":193},"who-it-is-for","Who it is for",[23,196,197,200,203,206],{},[26,198,199],{},"Streamers who need instant sound cues",[26,201,202],{},"Friends who want a shared board for voice chat",[26,204,205],{},"Podcasters who record clips and drop them onto a board",[26,207,208],{},"Anyone who wants a customizable, local-first soundboard",[18,210,212],{"id":211},"what-you-can-do","What you can do",[23,214,215,218,221,224,227,230,235,238],{},[26,216,217],{},"Build a soundboard from your own audio files",[26,219,220],{},"Organize sounds in colored tabs, groups, and search",[26,222,223],{},"Design the look with the Theme Creator",[26,225,226],{},"Record PC audio or a microphone in the Record Editor",[26,228,229],{},"Assign hotkeys to individual sounds",[26,231,232,233],{},"Trigger sounds from ",[137,234,140],{"href":139},[26,236,237],{},"Import and export a full soundboard to share with others",[26,239,240],{},"Use GIFs or images on sound buttons",[18,242,244],{"id":243},"license","License",[14,246,247,248,254],{},"SoundNinja is free software under ",[137,249,253],{"href":250,"rel":251},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fblob\u002Fmain\u002FLICENSE",[252],"nofollow","GPL-3.0",". Fork it, change it, share it.",[18,256,258],{"id":257},"next-steps","Next steps",[260,261,262,268,274],"ol",{},[26,263,264],{},[137,265,267],{"href":266},"\u002Fdocs\u002Finstallation","Install SoundNinja",[26,269,270],{},[137,271,273],{"href":272},"\u002Fdocs\u002Fadding-sounds","Add sounds",[26,275,276],{},[137,277,279],{"href":278},"\u002Fdocs\u002Forganizing-sounds","Organize your board",{"title":155,"searchDepth":156,"depth":156,"links":281},[282,283,284,285],{"id":193,"depth":156,"text":194},{"id":211,"depth":156,"text":212},{"id":243,"depth":156,"text":244},{"id":257,"depth":156,"text":258},"What SoundNinja is and what you can do with it.",{},1,"\u002Foverview",{"title":176,"description":286},"cOxJIh0ybRdZsyS1INxo9O3CTipyV8220IKpyfnYFJA",{"id":293,"title":294,"body":295,"description":488,"extension":166,"meta":489,"navigation":168,"order":156,"path":490,"seo":491,"stem":299,"__hash__":492},"content_en\u002Finstallation.md","Installation",{"type":7,"value":296,"toc":481},[297,300,314,318,336,339,343,357,360,364,389,400,404,411,415,430,460,477],[10,298,294],{"id":299},"installation",[14,301,302,303,307,308,313],{},"Grab a build from the ",[137,304,306],{"href":305},"\u002Fdownload","Download page"," or from ",[137,309,312],{"href":310,"rel":311},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Freleases\u002Flatest",[252],"GitHub Releases",". SoundNinja is in early development, so treat builds as beta.",[18,315,317],{"id":316},"windows","Windows",[23,319,320,330,333],{},[26,321,322,325,326,329],{},[30,323,324],{},"Installer (.exe)"," or ",[30,327,328],{},"MSI (.msi)"," for 64-bit Windows",[26,331,332],{},"Landing page target: Windows 10 and newer",[26,334,335],{},"The app README also lists Windows 8 and above",[14,337,338],{},"Run the installer, then launch SoundNinja from the Start menu.",[18,340,342],{"id":341},"macos","macOS",[23,344,345,351,354],{},[26,346,347,350],{},[30,348,349],{},"Universal .dmg"," for Apple Silicon and Intel",[26,352,353],{},"Landing page target: macOS 10.14 and newer",[26,355,356],{},"The app README lists macOS 10.15 and above",[14,358,359],{},"Open the disk image and drag SoundNinja to Applications.",[18,361,363],{"id":362},"linux","Linux",[23,365,366,372,378,386],{},[26,367,368,371],{},[30,369,370],{},"Debian (.deb)"," for Ubuntu \u002F Debian",[26,373,374,377],{},[30,375,376],{},"AppImage"," for other distros",[26,379,380,381,385],{},"After a release is published, Arch users can install ",[382,383,384],"code",{},"soundninja-bin"," from the AUR",[26,387,388],{},"Tested on Ubuntu 20.04",[14,390,391,392,395,396,399],{},"Desktop builds need WebKit and GTK packages. On Debian\u002FUbuntu that usually means ",[382,393,394],{},"libwebkit2gtk",", ",[382,397,398],{},"libgtk-3-0",", and an app-indicator library.",[18,401,403],{"id":402},"updates","Updates",[14,405,406,407,410],{},"In the app, open ",[30,408,409],{},"Help → Check for Updates",". You can also let SoundNinja check on startup in Settings.",[18,412,414],{"id":413},"build-from-source","Build from source",[14,416,417,418,423,424,429],{},"Need a custom build? Clone ",[137,419,422],{"href":420,"rel":421},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja",[252],"the repo",", install ",[137,425,428],{"href":426,"rel":427},"https:\u002F\u002Fv2.tauri.app\u002Fstart\u002Fprerequisites\u002F",[252],"Tauri prerequisites",", then:",[431,432,436],"pre",{"className":433,"code":434,"language":435,"meta":155,"style":155},"language-bash shiki shiki-themes github-light github-dark","bun install\nbun run tauri:serve\n","bash",[382,437,438,450],{"__ignoreMap":155},[439,440,442,446],"span",{"class":441,"line":288},"line",[439,443,445],{"class":444},"sScJk","bun",[439,447,449],{"class":448},"sZZnC"," install\n",[439,451,452,454,457],{"class":441,"line":156},[439,453,445],{"class":444},[439,455,456],{"class":448}," run",[439,458,459],{"class":448}," tauri:serve\n",[14,461,462,395,465,468,469,472,473,476],{},[382,463,464],{},"npm",[382,466,467],{},"pnpm",", or ",[382,470,471],{},"deno"," work too. Production build: ",[382,474,475],{},"bun run tauri:build",".",[478,479,480],"style",{},"html pre.shiki code .sScJk, html code.shiki .sScJk{--shiki-default:#6F42C1;--shiki-dark:#B392F0}html pre.shiki code .sZZnC, html code.shiki .sZZnC{--shiki-default:#032F62;--shiki-dark:#9ECBFF}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html.dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}",{"title":155,"searchDepth":156,"depth":156,"links":482},[483,484,485,486,487],{"id":316,"depth":156,"text":317},{"id":341,"depth":156,"text":342},{"id":362,"depth":156,"text":363},{"id":402,"depth":156,"text":403},{"id":413,"depth":156,"text":414},"Install SoundNinja on Windows, macOS, or Linux.",{},"\u002Finstallation",{"title":294,"description":488},"i4XnnjkhxVb30IICErH1K_cBbAQ7GmnD52FYRYjh50k",{"id":494,"title":495,"body":496,"description":634,"extension":166,"meta":635,"navigation":168,"order":636,"path":637,"seo":638,"stem":500,"__hash__":639},"content_en\u002Fadding-sounds.md","Adding Sounds",{"type":7,"value":497,"toc":626},[498,501,504,508,526,530,562,566,585,589,603,606,610,617,621],[10,499,495],{"id":500},"adding-sounds",[14,502,503],{},"A board is empty until you add clips. SoundNinja can import files, whole folders, a recording, or a shared soundboard pack.",[18,505,507],{"id":506},"import-audio-files","Import audio files",[260,509,510,520,523],{},[26,511,128,512,515,516,519],{},[30,513,514],{},"File → Import Audio Files",", or use ",[30,517,518],{},"Import"," in the navbar.",[26,521,522],{},"Pick one or more audio files.",[26,524,525],{},"Sounds land in the current tab.",[18,527,529],{"id":528},"import-folders","Import folders",[260,531,532,542,545],{},[26,533,128,534,537,538,541],{},[30,535,536],{},"File → Import Folders"," (or ",[30,539,540],{},"Import Folders"," in the navbar).",[26,543,544],{},"Add one or more folders. Drag to reorder them before you import.",[26,546,547,548],{},"Choose how they land:\n",[23,549,550,556],{},[26,551,552,555],{},[30,553,554],{},"Import as Tabs"," — each folder becomes its own tab",[26,557,558,561],{},[30,559,560],{},"Import to current Tab"," — every file goes into the active tab",[18,563,565],{"id":564},"record-a-clip","Record a clip",[14,567,568,569,573,574,577,578,325,581,584],{},"Open the ",[137,570,572],{"href":571},"\u002Fdocs\u002Frecording-editor","Record Editor"," from the ",[30,575,576],{},"Record"," button in the player bar. Capture, trim, then ",[30,579,580],{},"Import selected",[30,582,583],{},"Import all"," into the current tab or a tab you pick.",[18,586,588],{"id":587},"import-a-soundboard","Import a soundboard",[14,590,591,594,595,598,599,602],{},[30,592,593],{},"File → Import Soundboard"," loads a shared pack. Packs are a ",[382,596,597],{},".zip"," that contains ",[382,600,601],{},"project.sninja"," plus the sound files. After import, open the project and play.",[14,604,605],{},"You can also keep several projects (profiles). Use the project selector to switch boards.",[18,607,609],{"id":608},"relink-missing-files","Relink missing files",[14,611,612,613,616],{},"If audio files move on disk, SoundNinja shows a ",[30,614,615],{},"Missing sound files"," dialog. Pick a folder to search and relink the clips.",[18,618,620],{"id":619},"next","Next",[14,622,623,624,476],{},"Organize tabs, groups, and hotkeys in ",[137,625,5],{"href":278},{"title":155,"searchDepth":156,"depth":156,"links":627},[628,629,630,631,632,633],{"id":506,"depth":156,"text":507},{"id":528,"depth":156,"text":529},{"id":564,"depth":156,"text":565},{"id":587,"depth":156,"text":588},{"id":608,"depth":156,"text":609},{"id":619,"depth":156,"text":620},"Import audio, folders, recordings, and shared soundboards.",{},3,"\u002Fadding-sounds",{"title":495,"description":634},"qcK88xpbquf2dRogb67sx4O0tzuIof13-X3Yyn9680o",{"id":4,"title":5,"body":641,"description":165,"extension":166,"meta":732,"navigation":168,"order":169,"path":170,"seo":733,"stem":12,"__hash__":172},{"type":7,"value":642,"toc":723},[643,645,647,649,665,669,671,673,683,687,689,693,695,701,703,705,707,709,713,717,719],[10,644,5],{"id":12},[14,646,16],{},[18,648,21],{"id":20},[23,650,651,655,659],{},[26,652,28,653,33],{},[30,654,32],{},[26,656,36,657,40],{},[30,658,39],{},[26,660,43,661,47,663,51],{},[30,662,46],{},[30,664,50],{},[14,666,54,667,58],{},[30,668,57],{},[18,670,62],{"id":61},[14,672,65],{},[23,674,675,677,679,681],{},[26,676,70],{},[26,678,73],{},[26,680,76],{},[26,682,79],{},[14,684,82,685,86],{},[30,686,85],{},[18,688,90],{"id":89},[14,690,93,691,96],{},[30,692,90],{},[18,694,100],{"id":99},[14,696,103,697,107,699,111],{},[30,698,106],{},[30,700,110],{},[18,702,115],{"id":114},[14,704,118],{},[18,706,122],{"id":121},[14,708,125],{},[14,710,128,711,132],{},[30,712,131],{},[14,714,135,715,141],{},[137,716,140],{"href":139},[18,718,145],{"id":144},[14,720,148,721,153],{},[137,722,152],{"href":151},{"title":155,"searchDepth":156,"depth":156,"links":724},[725,726,727,728,729,730,731],{"id":20,"depth":156,"text":21},{"id":61,"depth":156,"text":62},{"id":89,"depth":156,"text":90},{"id":99,"depth":156,"text":100},{"id":114,"depth":156,"text":115},{"id":121,"depth":156,"text":122},{"id":144,"depth":156,"text":145},{},{"title":5,"description":165},{"id":735,"title":736,"body":737,"description":863,"extension":166,"meta":864,"navigation":168,"order":865,"path":866,"seo":867,"stem":741,"__hash__":868},"content_en\u002Ftheme-editor.md","Theme Editor",{"type":7,"value":738,"toc":857},[739,742,748,752,779,782,786,800,804,830,833,837,843],[10,740,736],{"id":741},"theme-editor",[14,743,744,745,476],{},"