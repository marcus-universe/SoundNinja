750,"depth":156,"text":751},{"id":784,"depth":156,"text":785},{"id":802,"depth":156,"text":803},{"id":835,"depth":156,"text":836},"Design colors, fonts, buttons, and tabs in the Theme Creator.",{},5,"\u002Ftheme-editor",{"title":736,"description":863},"zpMjxENa49aUipEX7TBxcqrbaZNweyJ019KsLAMJeoc",{"id":870,"title":871,"body":872,"description":1005,"extension":166,"meta":1006,"navigation":168,"order":1007,"path":1008,"seo":1009,"stem":876,"__hash__":1010},"content_en\u002Frecording-editor.md","Recording Editor",{"type":7,"value":873,"toc":999},[874,877,883,887,893,913,916,920,945,949,964,968,982,989],[10,875,871],{"id":876},"recording-editor",[14,878,879,880,882],{},"Record a clip inside SoundNinja, trim it, then import it onto a tab. Open the editor with the ",[30,881,576],{}," button in the player bar.",[18,884,886],{"id":885},"choose-an-input","Choose an input",[14,888,839,889,892],{},[30,890,891],{},"Settings → Audio",":",[23,894,895,901,907],{},[26,896,897,900],{},[30,898,899],{},"Input Devices"," — microphone",[26,902,903,906],{},[30,904,905],{},"Output Devices (PC Audio)"," — loopback of what your PC is playing",[26,908,909,912],{},[30,910,911],{},"Input volume"," — capture gain from 0% to 200%",[14,914,915],{},"The Record button uses the device you pick here.",[18,917,919],{"id":918},"edit-the-take","Edit the take",[23,921,922,925,928,936,939,942],{},[26,923,924],{},"Record and stop",[26,926,927],{},"Watch the input level meter",[26,929,930,325,933],{},[30,931,932],{},"Normalize",[30,934,935],{},"Noise Cancelation",[26,937,938],{},"Trim the whole clip, trim to a selection, or delete a selection",[26,940,941],{},"Undo \u002F redo",[26,943,944],{},"Zoom in and out",[18,946,948],{"id":947},"stage-and-import","Stage and import",[260,950,951,954,957],{},[26,952,953],{},"Add the selection or the full track to the staging list.",[26,955,956],{},"The list starts empty: record, edit, then add a clip.",[26,958,959,325,961,963],{},[30,960,580],{},[30,962,583],{}," into 