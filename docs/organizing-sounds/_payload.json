22],{"id":1421},"stem-separation-optional","Stem separation (optional)",[14,1424,1425,1426,1429,1430,597,1433,1436],{},"Official Windows, macOS, and Linux release builds ship the ",[18,1427,1428],{},"stems"," feature. The Record Editor can keep ",[18,1431,1432],{},"vocals",[18,1434,1435],{},"music"," using BS-RoFormer.",[14,1438,1439,1440,1443,1444,1447],{},"The model is about 158 MB and is ",[18,1441,1442],{},"not"," bundled with the installer. Download it from ",[18,1445,1446],{},"Settings → Stem Separation",", or accept the first-run prompt. The Windows installer can also offer to download the model on first launch.",[14,1449,1450,1451,1218,1454,1457],{},"Custom source builds need an extra flag (",[657,1452,1453],{},"tauri:serve:stems",[657,1455,1456],{},"tauri:build:stems",").",{"title":413,"searchDepth":414,"depth":414,"links":1459},[1460,1461,1462,1463],{"id":1340,"depth":414,"text":1341},{"id":1373,"depth":414,"text":1374},{"id":1402,"depth":414,"text":1403},{"id":1421,"depth":414,"text":1422},"Capture mic or PC audio, edit the clip, and drop it on your board.",{},6,"\u002Frecording-editor",{"title":1326,"description":1464},"WLz7ozLeboeLKawRkz53eUj5KSVCj4xkPMhYg5P_MIo",{"id":1471,"title":1472,"body":1473,"description":1686,"extension":431,"meta":1687,"navigation":433,"order":1688,"path":1689,"seo":1690,"stem":1477,"__hash__":1691},"content_en\u002Fremote-control.md","Remote Control",{"type":7,"value":1474,"toc":1679},[1475,1478,1481,1485,1514,1517,1520,1555,1559,1579,1582,1586,1618,1622,1628],[10,1476,1472],{"id":1477},"remote-control",[14,1479,1480],{},"SoundNinja can listen on your local network so Bitfocus Companion (or any HTTP\u002FWebSocket client) can play and stop sounds.",[23,1482,1484],{"id":1483},"enable-the-remote-server","Enable the remote server",[118,1486,1487,1492,1498,1504],{},[31,1488,122,1489,97],{},[18,1490,1491],{},"Settings → Remote",[31,1493,1494,1495,97],{},"Enable the remote server. Default port is ",[18,1496,1497],{},"7331",[31,1499,