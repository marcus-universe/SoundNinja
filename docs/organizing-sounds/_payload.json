":403,"text":1384},"Capture mic or PC audio, edit the clip, and drop it on your board.",{},6,"\u002Frecording-editor",{"title":1288,"description":1426},"WLz7ozLeboeLKawRkz53eUj5KSVCj4xkPMhYg5P_MIo",{"id":1433,"title":1434,"body":1435,"description":1648,"extension":420,"meta":1649,"navigation":422,"order":1650,"path":1651,"seo":1652,"stem":1439,"__hash__":1653},"content_en\u002Fremote-control.md","Remote Control",{"type":7,"value":1436,"toc":1641},[1437,1440,1443,1447,1476,1479,1482,1517,1521,1541,1544,1548,1580,1584,1590],[10,1438,1434],{"id":1439},"remote-control",[14,1441,1442],{},"SoundNinja can listen on your local network so Bitfocus Companion (or any HTTP\u002FWebSocket client) can play and stop sounds.",[23,1444,1446],{"id":1445},"enable-the-remote-server","Enable the remote server",[118,1448,1449,1454,1460,1466],{},[31,1450,122,1451,97],{},[18,1452,1453],{},"Settings → Remote",[31,1455,1456,1457,97],{},"Enable the remote server. Default port is ",[18,1458,1459],{},"7331",[31,1461,1462,1463,97],{},"Optional: set a token. Clients must send it as a Bearer token or ",[647,1464,1465],{},"?token=",[31,1467,1468,1469,1472,1473,97],{},"Copy the ",[647,1470,1471],{},"http:\u002F\u002FIP:PORT"," URL, or copy the system IP from ",[18,1474,1475],{},"Settings → About",[14,1477,1478],{},"Windows may show a firewall prompt the first time the server starts. Allow private-network access.",[23,1480,360],{"id":1481},"bitfocus-companion",[118,1483,1484,1491,1500,1510],{},[31,1485,1486,1487,97],{},"Install ",[357,1488,360],{"href":1489,"rel":1490},"https:\u002F\u002Fbitfocus.io\u002Fcompanion",[515],[31,1492,1493,1494,1499],{},"Download ",[357,1495,1498],{"href":1496,"rel":1497},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002Fcompanion-module-soundninja\u002Freleases\u002Flatest",[515],"SoundNinja-Companion.tgz",". There is no Companion Store package yet.",[31,1501,1502,1503,1506,1507,97],{},"In Companion: ",[18,1504,1505],{},"Modules → Load module package"," and pick th