[{"data":1,"prerenderedAt":1587},["ShallowReactive",2],{"docs-page-en-\u002Fsupport":3,"docs-nav-en":124},{"id":4,"title":5,"body":6,"description":116,"extension":117,"meta":118,"navigation":119,"order":120,"path":121,"seo":122,"stem":12,"__hash__":123},"content_en\u002Fsupport.md","Support",{"type":7,"value":8,"toc":107},"minimark",[9,13,17,22,25,34,46,50,57,61,78,82,96,100],[10,11,5],"h1",{"id":12},"support",[14,15,16],"p",{},"SoundNinja is a community project in early beta. The fastest way to get help is GitHub.",[18,19,21],"h2",{"id":20},"report-a-bug-or-ask-a-question","Report a bug or ask a question",[14,23,24],{},"Open an issue on GitHub:",[14,26,27],{},[28,29,33],"a",{"href":30,"rel":31},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fissues",[32],"nofollow","github.com\u002Fmarcus-universe\u002FSoundNinja\u002Fissues",[14,35,36,37,41,42,45],{},"Include your OS, SoundNinja version (",[38,39,40],"strong",{},"Help → Check for Updates"," or ",[38,43,44],{},"Settings → About","), and steps to reproduce.",[18,47,49],{"id":48},"email","Email",[14,51,52,53],{},"Maintainer contact: ",[28,54,56],{"href":55},"mailto:contact@marcus-universe.de","contact@marcus-universe.de",[18,58,60],{"id":59},"updates","Updates",[14,62,63,64,66,67,71,72,77],{},"In the app, use ",[38,65,40],{},". New builds also appear on the ",[28,68,70],{"href":69},"\u002Fdownload","Download page"," and on ",[28,73,76],{"href":74,"rel":75},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Freleases",[32],"GitHub Releases",".",[18,79,81],{"id":80},"contribute","Contribute",[14,83,84,85,90,91,77],{},"Pull requests are welcome. The app repo is ",[28,86,89],{"href":87,"rel":88},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja",[32],"github.com\u002Fmarcus-universe\u002FSoundNinja",". The project is licensed under ",[28,92,95],{"href":93,"rel":94},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fblob\u002Fmain\u002FLICENSE",[32],"GPL-3.0",[18,97,99],{"id":98},"legal","Legal",[14,101,102,103,77],{},"Imprint and contact details: ",[28,104,106],{"href":105},"\u002Fimpressum","Impressum",{"title":108,"searchDepth":109,"depth":109,"links":110},"",2,[111,112,113,114,115],{"id":20,"depth":109,"text":21},{"id":48,"depth":109,"text":49},{"id":59,"depth":109,"text":60},{"id":80,"depth":109,"text":81},{"id":98,"depth":109,"text":99},"Where to get help and report bugs.","md",{},true,8,"\u002Fsupport",{"title":5,"description":116},"jRExoghmWgAfTmnmgqLhtQedAnIjqFIbv0_OahYrhTc",[125,253,469,618,1021,1156,1302,1523],{"id":126,"title":127,"body":128,"description":247,"extension":117,"meta":248,"navigation":119,"order":249,"path":250,"seo":251,"stem":132,"__hash__":252},"content_en\u002Foverview.md","Overview",{"type":7,"value":129,"toc":241},[130,133,136,139,142,146,162,166,205,209,216,220],[10,131,127],{"id":132},"overview",[14,134,135],{},"SoundNinja is an open-source soundboard for live streaming, chatting with friends, and podcast recording. It is built with Tauri v2 and Nuxt 4 so it stays light on RAM and disk.",[14,137,138],{},"The goal is simple: keep a huge sound library easy to scan, then play the right clip in milliseconds. The UI also works well as a dashboard in VR.",[14,140,141],{},"SoundNinja is still in early development. Features work, but not every platform is fully tested.",[18,143,145],{"id":144},"who-it-is-for","Who it is for",[147,148,149,153,156,159],"ul",{},[150,151,152],"li",{},"Streamers who need instant sound cues",[150,154,155],{},"Friends who want a shared board for voice chat",[150,157,158],{},"Podcasters who record clips and drop them onto a board",[150,160,161],{},"Anyone who wants a customizable, local-first soundboard",[18,163,165],{"id":164},"what-you-can-do","What you can do",[147,167,168,171,174,177,180,183,186,189,192,199,202],{},[150,169,170],{},"Build a soundboard from your own audio files",[150,172,173],{},"Organize sounds in colored tabs, groups, tags, and search",[150,175,176],{},"Filter by tags (OR) and sort by name, date, duration, or size",[150,178,179],{},"Multi-select with marquee or Shift-range, then bulk color, move, or delete",[150,181,182],{},"Set per-sound volume from the context menu",[150,184,185],{},"Design the look with the Theme Creator",[150,187,188],{},"Record PC audio or a microphone in the Record Editor",[150,190,191],{},"Assign hotkeys to individual sounds",[150,193,194,195],{},"Trigger sounds from ",[28,196,198],{"href":197},"\u002Fdocs\u002Fremote-control","Bitfocus Companion",[150,200,201],{},"Import and export a full soundboard to share with others",[150,203,204],{},"Use GIFs or images on sound buttons — from a local folder library or KLIPY",[18,206,208],{"id":207},"license","License",[14,210,211,212,215],{},"SoundNinja is free software under ",[28,213,95],{"href":93,"rel":214},[32],". Fork it, change it, share it.",[18,217,219],{"id":218},"next-steps","Next steps",[221,222,223,229,235],"ol",{},[150,224,225],{},[28,226,228],{"href":227},"\u002Fdocs\u002Finstallation","Install SoundNinja",[150,230,231],{},[28,232,234],{"href":233},"\u002Fdocs\u002Fadding-sounds","Add sounds",[150,236,237],{},[28,238,240],{"href":239},"\u002Fdocs\u002Forganizing-sounds","Organize your board",{"title":108,"searchDepth":109,"depth":109,"links":242},[243,244,245,246],{"id":144,"depth":109,"text":145},{"id":164,"depth":109,"text":165},{"id":207,"depth":109,"text":208},{"id":218,"depth":109,"text":219},"What SoundNinja is and what you can do with it.",{},1,"\u002Foverview",{"title":127,"description":247},"Dax9ydiOOeEz5F1IxWfEljWZynntK7dPp52JZ3q2G58",{"id":254,"title":255,"body":256,"description":464,"extension":117,"meta":465,"navigation":119,"order":109,"path":466,"seo":467,"stem":260,"__hash__":468},"content_en\u002Finstallation.md","Installation",{"type":7,"value":257,"toc":457},[258,261,272,276,296,299,303,317,320,324,349,360,362,368,372,386,416,432,453],[10,259,255],{"id":260},"installation",[14,262,263,264,266,267,271],{},"Grab a build from the ",[28,265,70],{"href":69}," or from ",[28,268,76],{"href":269,"rel":270},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Freleases\u002Flatest",[32],". SoundNinja is in early development, so treat builds as beta.",[18,273,275],{"id":274},"windows","Windows",[147,277,278,287,290,293],{},[150,279,280,41,283,286],{},[38,281,282],{},"Installer (.exe)",[38,284,285],{},"MSI (.msi)"," for 64-bit Windows",[150,288,289],{},"Landing page target: Windows 10 and newer",[150,291,292],{},"The app README also lists Windows 8 and above",[150,294,295],{},"The NSIS installer uses a dark theme. Pick a language during setup — SoundNinja remembers it on the next launch.",[14,297,298],{},"Run the installer, then launch SoundNinja from the Start menu.",[18,300,302],{"id":301},"macos","macOS",[147,304,305,311,314],{},[150,306,307,310],{},[38,308,309],{},"Universal .dmg"," for Apple Silicon and Intel",[150,312,313],{},"Landing page target: macOS 10.14 and newer",[150,315,316],{},"The app README lists macOS 10.15 and above",[14,318,319],{},"Open the disk image and drag SoundNinja to Applications.",[18,321,323],{"id":322},"linux","Linux",[147,325,326,332,338,346],{},[150,327,328,331],{},[38,329,330],{},"Debian (.deb)"," for Ubuntu \u002F Debian",[150,333,334,337],{},[38,335,336],{},"AppImage"," for other distros",[150,339,340,341,345],{},"After a release is published, Arch users can install ",[342,343,344],"code",{},"soundninja-bin"," from the AUR",[150,347,348],{},"Tested on Ubuntu 20.04",[14,350,351,352,355,356,359],{},"Desktop builds need WebKit and GTK packages. On Debian\u002FUbuntu that usually means ",[342,353,354],{},"libwebkit2gtk",", ",[342,357,358],{},"libgtk-3-0",", and an app-indicator library.",[18,361,60],{"id":59},[14,363,364,365,367],{},"In the app, open ",[38,366,40],{},". You can also let SoundNinja check on startup in Settings.",[18,369,371],{"id":370},"build-from-source","Build from source",[14,373,374,375,379,380,385],{},"Need a custom build? Clone ",[28,376,378],{"href":87,"rel":377},[32],"the repo",", install ",[28,381,384],{"href":382,"rel":383},"https:\u002F\u002Fv2.tauri.app\u002Fstart\u002Fprerequisites\u002F",[32],"Tauri prerequisites",", then:",[387,388,392],"pre",{"className":389,"code":390,"language":391,"meta":108,"style":108},"language-bash shiki shiki-themes github-light github-dark","bun install\nbun run tauri:serve\n","bash",[342,393,394,406],{"__ignoreMap":108},[395,396,398,402],"span",{"class":397,"line":249},"line",[395,399,401],{"class":400},"sScJk","bun",[395,403,405],{"class":404},"sZZnC"," install\n",[395,407,408,410,413],{"class":397,"line":109},[395,409,401],{"class":400},[395,411,412],{"class":404}," run",[395,414,415],{"class":404}," tauri:serve\n",[14,417,418,355,421,424,425,428,429,77],{},[342,419,420],{},"npm",[342,422,423],{},"pnpm",", or ",[342,426,427],{},"deno"," work too. Production build: ",[342,430,431],{},"bun run tauri:build",[14,433,434,437,438,443,444,447,448,77],{},[38,435,436],{},"Windows only:"," every Windows compile includes ASIO via the ",[28,439,442],{"href":440,"rel":441},"https:\u002F\u002Fwww.steinberg.net\u002Fasiosdk",[32],"Steinberg ASIO SDK",". Run ",[342,445,446],{},"bun run setup:asio"," once (SDK is not in git). Linux and macOS use PipeWire \u002F Core Audio — skip that step. Full notes: ",[28,449,452],{"href":450,"rel":451},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fblob\u002Fmain\u002Fdocs\u002Fbuild-from-source.md",[32],"build-from-source.md",[454,455,456],"style",{},"html pre.shiki code .sScJk, html code.shiki .sScJk{--shiki-default:#6F42C1;--shiki-dark:#B392F0}html pre.shiki code .sZZnC, html code.shiki .sZZnC{--shiki-default:#032F62;--shiki-dark:#9ECBFF}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html.dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}",{"title":108,"searchDepth":109,"depth":109,"links":458},[459,460,461,462,463],{"id":274,"depth":109,"text":275},{"id":301,"depth":109,"text":302},{"id":322,"depth":109,"text":323},{"id":59,"depth":109,"text":60},{"id":370,"depth":109,"text":371},"Install SoundNinja on Windows, macOS, or Linux.",{},"\u002Finstallation",{"title":255,"description":464},"outLmMLibzOL_84ZfoLBrmphO4wVu0zaTr0u_DS4GUg",{"id":470,"title":471,"body":472,"description":612,"extension":117,"meta":613,"navigation":119,"order":614,"path":615,"seo":616,"stem":476,"__hash__":617},"content_en\u002Fadding-sounds.md","Adding Sounds",{"type":7,"value":473,"toc":604},[474,477,480,484,503,507,539,543,562,566,580,583,587,594,598],[10,475,471],{"id":476},"adding-sounds",[14,478,479],{},"A board is empty until you add clips. SoundNinja can import files, whole folders, a recording, or a shared soundboard pack.",[18,481,483],{"id":482},"import-audio-files","Import audio files",[221,485,486,497,500],{},[150,487,488,489,492,493,496],{},"Open ",[38,490,491],{},"File → Import Audio Files",", or use ",[38,494,495],{},"Import"," in the navbar.",[150,498,499],{},"Pick one or more audio files.",[150,501,502],{},"Sounds land in the current tab.",[18,504,506],{"id":505},"import-folders","Import folders",[221,508,509,519,522],{},[150,510,488,511,514,515,518],{},[38,512,513],{},"File → Import Folders"," (or ",[38,516,517],{},"Import Folders"," in the navbar).",[150,520,521],{},"Add one or more folders. Drag to reorder them before you import.",[150,523,524,525],{},"Choose how they land:\n",[147,526,527,533],{},[150,528,529,532],{},[38,530,531],{},"Import as Tabs"," — each folder becomes its own tab",[150,534,535,538],{},[38,536,537],{},"Import to current Tab"," — every file goes into the active tab",[18,540,542],{"id":541},"record-a-clip","Record a clip",[14,544,545,546,550,551,554,555,41,558,561],{},"Open the ",[28,547,549],{"href":548},"\u002Fdocs\u002Frecording-editor","Record Editor"," from the ",[38,552,553],{},"Record"," button in the player bar. Capture, trim, then ",[38,556,557],{},"Import selected",[38,559,560],{},"Import all"," into the current tab or a tab you pick.",[18,563,565],{"id":564},"import-a-soundboard","Import a soundboard",[14,567,568,571,572,575,576,579],{},[38,569,570],{},"File → Import Soundboard"," loads a shared pack. Packs are a ",[342,573,574],{},".zip"," that contains ",[342,577,578],{},"project.sninja"," plus the sound files. After import, open the project and play.",[14,581,582],{},"You can also keep several projects (profiles). Use the project selector to switch boards.",[18,584,586],{"id":585},"relink-missing-files","Relink missing files",[14,588,589,590,593],{},"If audio files move on disk, SoundNinja shows a ",[38,591,592],{},"Missing sound files"," dialog. Pick a folder to search and relink the clips.",[18,595,597],{"id":596},"next","Next",[14,599,600,601,77],{},"Organize tabs, tags, filters, and hotkeys in ",[28,602,603],{"href":239},"Organizing Sounds",{"title":108,"searchDepth":109,"depth":109,"links":605},[606,607,608,609,610,611],{"id":482,"depth":109,"text":483},{"id":505,"depth":109,"text":506},{"id":541,"depth":109,"text":542},{"id":564,"depth":109,"text":565},{"id":585,"depth":109,"text":586},{"id":596,"depth":109,"text":597},"Import audio, folders, recordings, and shared soundboards.",{},3,"\u002Fadding-sounds",{"title":471,"description":612},"SBUvL_H4633CrDyNUKazqKwru4aq1hhgoH4_o99rBsE",{"id":619,"title":603,"body":620,"description":1015,"extension":117,"meta":1016,"navigation":119,"order":1017,"path":1018,"seo":1019,"stem":624,"__hash__":1020},"content_en\u002Forganizing-sounds.md",{"type":7,"value":621,"toc":1000},[622,625,632,636,663,670,674,677,691,698,704,708,718,723,755,759,765,769,802,808,812,815,842,845,849,863,867,873,894,910,917,921,931,934,938,945,955,961,965,973,980,997],[10,623,603],{"id":624},"organizing-sounds",[14,626,627,628,631],{},"SoundNinja is built for large libraries. Use ",[38,629,630],{},"tags and filters",", tabs, search, multi-select, and hotkeys so the clip you need is one click (or one key) away.",[18,633,635],{"id":634},"tabs","Tabs",[147,637,638,645,652],{},[150,639,640,641,644],{},"Add a tab with ",[38,642,643],{},"Add tab",". Give it a color so you can scan the bar fast.",[150,646,647,648,651],{},"The ",[38,649,650],{},"All"," view shows every sound across tabs.",[150,653,654,655,658,659,662],{},"A sound can belong to ",[38,656,657],{},"one or more tabs",". Right-click a sound and use ",[38,660,661],{},"Move to tab"," to assign it.",[14,664,665,666,669],{},"Tab transitions live in ",[38,667,668],{},"Settings → Main",": Slide, Fade, Buttons one by one, or None.",[18,671,673],{"id":672},"groups","Groups",[14,675,676],{},"Since v0.5.3, separators can become named groups:",[147,678,679,682,685,688],{},[150,680,681],{},"Add, rename, or remove a group from the context menu",[150,683,684],{},"Drag the group header — children move with it",[150,686,687],{},"Drop sounds in or out of a group",[150,689,690],{},"Set group border color, name color, and button alignment (or use the tab default)",[14,692,693,694,697],{},"You can still add a plain ",[38,695,696],{},"Separator"," if you only need a visual break.",[14,699,700,701,77],{},"Right-click empty board space to ",[38,702,703],{},"Add Group",[18,705,707],{"id":706},"tags-filters","Tags \u002F Filters",[14,709,710,711,714,715,717],{},"Tags cut across tabs. The slide-out ",[38,712,713],{},"Filter"," panel (sidebar ",[38,716,713],{},") is where you create them and turn them into a board filter.",[719,720,722],"h3",{"id":721},"create-and-edit-tags","Create and edit tags",[221,724,725,730,741,748],{},[150,726,488,727,729],{},[38,728,713],{}," in the sidebar.",[150,731,732,733,736,737,740],{},"Under ",[38,734,735],{},"Tags",", use ",[38,738,739],{},"Add tag"," — give it a name and a color.",[150,742,743,744,747],{},"Rename, recolor, or ",[38,745,746],{},"Delete tag"," from the same list.",[150,749,750,751,754],{},"If you see ",[38,752,753],{},"No tags yet",", add one here before you assign anything.",[719,756,758],{"id":757},"assign-tags-to-sounds","Assign tags to sounds",[14,760,761,762,764],{},"Right-click a sound → ",[38,763,735],{}," (checkboxes). A sound can have several tags. If none exist yet, the menu tells you to open the filter panel.",[719,766,768],{"id":767},"filter-the-board","Filter the board",[147,770,771,777,788,799],{},[150,772,773,774,77],{},"Toggle tags in the Filter panel, or as ",[38,775,776],{},"chips under the search bar",[150,778,779,780,783,784,787],{},"Matching is ",[38,781,782],{},"OR",": a sound stays visible if it has ",[38,785,786],{},"any"," selected tag.",[150,789,790,791,794,795,798],{},"The navbar ",[38,792,793],{},"Search"," field ",[38,796,797],{},"ANDs"," with the active tag filter (type + tags together).",[150,800,801],{},"Turn chips off (or clear the filter) to show the full tab again.",[14,803,804,805,77],{},"Colored tag names can appear on buttons. Toggle them in ",[38,806,807],{},"Settings → Behavior → Show tag badges",[18,809,811],{"id":810},"sort","Sort",[14,813,814],{},"Open the filter panel and pick a sort mode:",[147,816,817,823],{},[150,818,819,822],{},[38,820,821],{},"User defined"," — your tab order, with groups visible",[150,824,825,355,828,355,831,424,834,837,838,841],{},[38,826,827],{},"Name",[38,829,830],{},"Added time",[38,832,833],{},"Play time",[38,835,836],{},"File size"," — a flat sorted list; ",[38,839,840],{},"groups are hidden"," in these modes",[14,843,844],{},"Duration sort may warm duration metadata the first time you use it.",[18,846,848],{"id":847},"reorder","Reorder",[14,850,851,852,855,856,859,860,862],{},"Turn on drag-and-drop in ",[38,853,854],{},"Settings → Behavior"," (",[38,857,858],{},"Allow reorder","). Then drag sounds and groups into place. Reorder applies in ",[38,861,821],{}," sort.",[18,864,866],{"id":865},"multi-select","Multi-select",[14,868,869,870,872],{},"Turn on ",[38,871,866],{}," in the navbar, then:",[147,874,875,878,884,891],{},[150,876,877],{},"Click a sound to toggle it",[150,879,880,883],{},[38,881,882],{},"Shift+click"," to select a range from the last anchor",[150,885,886,887,890],{},"Drag a ",[38,888,889],{},"marquee"," on empty board space",[150,892,893],{},"Click empty board (or outside) to clear the selection",[14,895,896,897,355,900,355,903,906,907,77],{},"A bulk bar appears with the count, plus ",[38,898,899],{},"Color",[38,901,902],{},"Move to tab…",[38,904,905],{},"Delete",", and ",[38,908,909],{},"Done",[14,911,912,913,916],{},"In multi-select, each button shows an ",[38,914,915],{},"8-character ID chip",". Right-click the chip to copy it.",[18,918,920],{"id":919},"per-sound-volume","Per-sound volume",[14,922,761,923,926,927,930],{},[38,924,925],{},"Volume",". Drag the slider from 0% to 100%. ",[38,928,929],{},"Double-click"," the slider to reset to 100%.",[14,932,933],{},"This stacks with the master output volume in Settings.",[18,935,937],{"id":936},"hotkeys-and-sound-ids","Hotkeys and sound IDs",[14,939,940,941,944],{},"Every sound has an 8-character ID. Copy it from the button context menu (",[38,942,943],{},"Copy ID",") or the multi-select ID chip.",[14,946,488,947,950,951,954],{},[38,948,949],{},"Settings → Hotkeys"," to bind a key to a sound ID. Global hotkeys are optional. ",[38,952,953],{},"Assign hotkey"," on the context menu jumps there with the ID prefilled.",[14,956,957,958,960],{},"The same ID is what ",[28,959,198],{"href":197}," uses to trigger a clip.",[18,962,964],{"id":963},"background-images-and-colors","Background images and colors",[14,966,967,968,972],{},"Right-click a sound to set per-button colors or a background image. That is separate from the ",[28,969,971],{"href":970},"\u002Fdocs\u002Ftheme-editor","Theme Creator",", which styles the whole board.",[14,974,975,976,979],{},"The picker is a ",[38,977,978],{},"Background image"," dialog (PNG, JPEG, GIF, WebP):",[147,981,982,988],{},[150,983,984,987],{},[38,985,986],{},"Local files"," — add folders, pick a single file, search filenames, preview the grid, or remove a folder from the library",[150,989,990,993,994,996],{},[38,991,992],{},"KLIPY"," — search online GIFs. Set your own API key in ",[38,995,854],{},". The key is not stored in project files.",[14,998,999],{},"After you pick an image, pan and crop it on the button.",{"title":108,"searchDepth":109,"depth":109,"links":1001},[1002,1003,1004,1009,1010,1011,1012,1013,1014],{"id":634,"depth":109,"text":635},{"id":672,"depth":109,"text":673},{"id":706,"depth":109,"text":707,"children":1005},[1006,1007,1008],{"id":721,"depth":614,"text":722},{"id":757,"depth":614,"text":758},{"id":767,"depth":614,"text":768},{"id":810,"depth":109,"text":811},{"id":847,"depth":109,"text":848},{"id":865,"depth":109,"text":866},{"id":919,"depth":109,"text":920},{"id":936,"depth":109,"text":937},{"id":963,"depth":109,"text":964},"Tags, filters, tabs, groups, sort, multi-select, volume, and hotkeys.",{},4,"\u002Forganizing-sounds",{"title":603,"description":1015},"DaYqySVuX1kgdTnJw6h1GP_lGyj4zdFP2uKKbBEbVwQ",{"id":1022,"title":1023,"body":1024,"description":1150,"extension":117,"meta":1151,"navigation":119,"order":1152,"path":1153,"seo":1154,"stem":1028,"__hash__":1155},"content_en\u002Ftheme-editor.md","Theme Editor",{"type":7,"value":1025,"toc":1144},[1026,1029,1035,1039,1066,1069,1073,1087,1091,1117,1120,1124,1130],[10,1027,1023],{"id":1028},"theme-editor",[14,1030,1031,1032,77],{},"The Theme Creator is the full visual editor for your board. Open it from ",[38,1033,1034],{},"Settings → Main → Theme Creator",[18,1036,1038],{"id":1037},"three-tabs","Three tabs",[221,1040,1041,1055,1061],{},[150,1042,1043,1046,1047,1050,1051,1054],{},[38,1044,1045],{},"General"," — theme name, shared colors, and font uploads (",[342,1048,1049],{},".ttf"," \u002F ",[342,1052,1053],{},".otf",")",[150,1056,1057,1060],{},[38,1058,1059],{},"Buttons"," — sound button colors, type, layout, and GIF overlay",[150,1062,1063,1065],{},[38,1064,635],{}," — tab bar colors, type, and border thickness",[14,1067,1068],{},"A live preview shows tabs and buttons as you edit.",[18,1070,1072],{"id":1071},"what-you-can-change","What you can change",[147,1074,1075,1078,1081,1084],{},[150,1076,1077],{},"Primary and accent colors, backgrounds, button colors, tab colors",[150,1079,1080],{},"Button and tab font family and size",[150,1082,1083],{},"Button width, radius, border width, gaps, and padding",[150,1085,1086],{},"GIF overlay opacity (normal and hover)",[18,1088,1090],{"id":1089},"save-and-share","Save and share",[147,1092,1093,1099,1105,1111],{},[150,1094,1095,1098],{},[38,1096,1097],{},"Export .css"," — write a theme file you can back up or send to a friend",[150,1100,1101,1104],{},[38,1102,1103],{},"Add to Themes"," — save the file into your Themes folder and apply it",[150,1106,1107,1110],{},[38,1108,1109],{},"Import .css"," — load a built-in preset or a saved theme",[150,1112,1113,1116],{},[38,1114,1115],{},"Reset"," — return to SoundNinja defaults",[14,1118,1119],{},"If you close the window with unsaved changes, SoundNinja asks you to save first.",[18,1121,1123],{"id":1122},"without-the-full-editor","Without the full editor",[14,1125,1126,1127,1129],{},"In ",[38,1128,668],{}," you can still:",[147,1131,1132,1135,1141],{},[150,1133,1134],{},"Pick a theme from the list",[150,1136,1137,1138,1054],{},"Edit CSS variables live (",[38,1139,1140],{},"Custom CSS",[150,1142,1143],{},"Import a theme file into the Themes folder",{"title":108,"searchDepth":109,"depth":109,"links":1145},[1146,1147,1148,1149],{"id":1037,"depth":109,"text":1038},{"id":1071,"depth":109,"text":1072},{"id":1089,"depth":109,"text":1090},{"id":1122,"depth":109,"text":1123},"Design colors, fonts, buttons, and tabs in the Theme Creator.",{},5,"\u002Ftheme-editor",{"title":1023,"description":1150},"zpMjxENa49aUipEX7TBxcqrbaZNweyJ019KsLAMJeoc",{"id":1157,"title":1158,"body":1159,"description":1296,"extension":117,"meta":1297,"navigation":119,"order":1298,"path":1299,"seo":1300,"stem":1163,"__hash__":1301},"content_en\u002Frecording-editor.md","Recording Editor",{"type":7,"value":1160,"toc":1290},[1161,1164,1170,1174,1180,1200,1203,1207,1232,1236,1251,1255,1269,1280],[10,1162,1158],{"id":1163},"recording-editor",[14,1165,1166,1167,1169],{},"Record a clip inside SoundNinja, trim it, then import it onto a tab. Open the editor with the ",[38,1168,553],{}," button in the player bar.",[18,1171,1173],{"id":1172},"choose-an-input","Choose an input",[14,1175,1126,1176,1179],{},[38,1177,1178],{},"Settings → Audio",":",[147,1181,1182,1188,1194],{},[150,1183,1184,1187],{},[38,1185,1186],{},"Input Devices"," — microphone",[150,1189,1190,1193],{},[38,1191,1192],{},"Output Devices (PC Audio)"," — loopback of what your PC is playing",[150,1195,1196,1199],{},[38,1197,1198],{},"Input volume"," — capture gain from 0% to 200%",[14,1201,1202],{},"The Record button uses the device you pick here.",[18,1204,1206],{"id":1205},"edit-the-take","Edit the take",[147,1208,1209,1212,1215,1223,1226,1229],{},[150,1210,1211],{},"Record and stop",[150,1213,1214],{},"Watch the input level meter",[150,1216,1217,41,1220],{},[38,1218,1219],{},"Normalize",[38,1221,1222],{},"Noise Cancelation",[150,1224,1225],{},"Trim the whole clip, trim to a selection, or delete a selection",[150,1227,1228],{},"Undo \u002F redo",[150,1230,1231],{},"Zoom in and out",[18,1233,1235],{"id":1234},"stage-and-import","Stage and import",[221,1237,1238,1241,1244],{},[150,1239,1240],{},"Add the selection or the full track to the staging list.",[150,1242,1243],{},"The list starts empty: record, edit, then add a clip.",[150,1245,1246,41,1248,1250],{},[38,1247,557],{},[38,1249,560],{}," into the current tab or a tab you choose.",[18,1252,1254],{"id":1253},"stem-separation-optional","Stem separation (optional)",[14,1256,1257,1258,1261,1262,41,1265,1268],{},"Official Windows, macOS, and Linux release builds ship the ",[38,1259,1260],{},"stems"," feature. The Record Editor can keep ",[38,1263,1264],{},"vocals",[38,1266,1267],{},"music"," using BS-RoFormer.",[14,1270,1271,1272,1275,1276,1279],{},"The model is about 158 MB and is ",[38,1273,1274],{},"not"," bundled with the installer. Download it from ",[38,1277,1278],{},"Settings → Stem Separation",", or accept the first-run prompt. The Windows installer can also offer to download the model on first launch.",[14,1281,1282,1283,1050,1286,1289],{},"Custom source builds need an extra flag (",[342,1284,1285],{},"tauri:serve:stems",[342,1287,1288],{},"tauri:build:stems",").",{"title":108,"searchDepth":109,"depth":109,"links":1291},[1292,1293,1294,1295],{"id":1172,"depth":109,"text":1173},{"id":1205,"depth":109,"text":1206},{"id":1234,"depth":109,"text":1235},{"id":1253,"depth":109,"text":1254},"Capture mic or PC audio, edit the clip, and drop it on your board.",{},6,"\u002Frecording-editor",{"title":1158,"description":1296},"WLz7ozLeboeLKawRkz53eUj5KSVCj4xkPMhYg5P_MIo",{"id":1303,"title":1304,"body":1305,"description":1517,"extension":117,"meta":1518,"navigation":119,"order":1519,"path":1520,"seo":1521,"stem":1309,"__hash__":1522},"content_en\u002Fremote-control.md","Remote Control",{"type":7,"value":1306,"toc":1510},[1307,1310,1313,1317,1345,1348,1351,1386,1390,1410,1413,1417,1449,1453,1459],[10,1308,1304],{"id":1309},"remote-control",[14,1311,1312],{},"SoundNinja can listen on your local network so Bitfocus Companion (or any HTTP\u002FWebSocket client) can play and stop sounds.",[18,1314,1316],{"id":1315},"enable-the-remote-server","Enable the remote server",[221,1318,1319,1324,1330,1336],{},[150,1320,488,1321,77],{},[38,1322,1323],{},"Settings → Remote",[150,1325,1326,1327,77],{},"Enable the remote server. Default port is ",[38,1328,1329],{},"7331",[150,1331,1332,1333,77],{},"Optional: set a token. Clients must send it as a Bearer token or ",[342,1334,1335],{},"?token=",[150,1337,1338,1339,1342,1343,77],{},"Copy the ",[342,1340,1341],{},"http:\u002F\u002FIP:PORT"," URL, or copy the system IP from ",[38,1344,44],{},[14,1346,1347],{},"Windows may show a firewall prompt the first time the server starts. Allow private-network access.",[18,1349,198],{"id":1350},"bitfocus-companion",[221,1352,1353,1360,1369,1379],{},[150,1354,1355,1356,77],{},"Install ",[28,1357,198],{"href":1358,"rel":1359},"https:\u002F\u002Fbitfocus.io\u002Fcompanion",[32],[150,1361,1362,1363,1368],{},"Download ",[28,1364,1367],{"href":1365,"rel":1366},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002Fcompanion-module-soundninja\u002Freleases\u002Flatest",[32],"SoundNinja-Companion.tgz",". There is no Companion Store package yet.",[150,1370,1371,1372,1375,1376,77],{},"In Companion: ",[38,1373,1374],{},"Modules → Load module package"," and pick the ",[342,1377,1378],{},".tgz",[150,1380,1381,1382,1385],{},"Add a ",[38,1383,1384],{},"Sound Ninja"," connection. Paste the PC IP, port, and token if you set one.",[18,1387,1389],{"id":1388},"actions","Actions",[147,1391,1392,1398,1404],{},[150,1393,1394,1397],{},[38,1395,1396],{},"Trigger Sound"," — pick from the live dropdown, or type an 8-character sound ID (Companion variables work)",[150,1399,1400,1403],{},[38,1401,1402],{},"Stop Sound"," — stop one playing sound by ID",[150,1405,1406,1409],{},[38,1407,1408],{},"Stop All"," — stop every playing sound",[14,1411,1412],{},"Copy a sound ID in SoundNinja from the button context menu or the multi-select ID chip.",[18,1414,1416],{"id":1415},"feedbacks-and-variables","Feedbacks and variables",[147,1418,1419,1425,1437,1443],{},[150,1420,1421,1424],{},[38,1422,1423],{},"Sound Playing"," — true while that sound ID is active (use it for button color)",[150,1426,1427,1430,1431,1050,1434],{},[342,1428,1429],{},"$(soundninja:connected)"," — ",[342,1432,1433],{},"true",[342,1435,1436],{},"false",[150,1438,1439,1442],{},[342,1440,1441],{},"$(soundninja:playing_count)"," — how many sounds are playing",[150,1444,1445,1448],{},[342,1446,1447],{},"$(soundninja:last_triggered)"," — last triggered sound ID",[18,1450,1452],{"id":1451},"http-api-advanced","HTTP API (advanced)",[14,1454,1455,1456],{},"Base path: ",[342,1457,1458],{},"\u002Fapi\u002Fv1",[147,1460,1461,1467,1473,1479,1489,1495,1504],{},[150,1462,1463,1466],{},[342,1464,1465],{},"GET \u002Finfo"," — app name, version, protocol, whether a token is required",[150,1468,1469,1472],{},[342,1470,1471],{},"GET \u002Fsounds"," — sound list (id, name, tabs, active)",[150,1474,1475,1478],{},[342,1476,1477],{},"GET \u002Fstate"," — sounds plus currently playing IDs",[150,1480,1481,1484,1485,1488],{},[342,1482,1483],{},"POST \u002Ftrigger"," with ",[342,1486,1487],{},"{ \"id\" }"," — play a sound",[150,1490,1491,1494],{},[342,1492,1493],{},"GET \u002Ftrigger\u002F:id"," — play (easy to test in a browser)",[150,1496,1497,1500,1501,1503],{},[342,1498,1499],{},"POST \u002Fstop"," with optional ",[342,1502,1487],{}," — stop one sound or all",[150,1505,1506,1509],{},[342,1507,1508],{},"GET \u002Fws"," — live state; send trigger\u002Fstop commands inbound",{"title":108,"searchDepth":109,"depth":109,"links":1511},[1512,1513,1514,1515,1516],{"id":1315,"depth":109,"text":1316},{"id":1350,"depth":109,"text":198},{"id":1388,"depth":109,"text":1389},{"id":1415,"depth":109,"text":1416},{"id":1451,"depth":109,"text":1452},"Trigger SoundNinja from Bitfocus Companion over the loca