[{"data":1,"prerenderedAt":1301},["ShallowReactive",2],{"docs-page-en-\u002Fsupport":3,"docs-nav-en":124},{"id":4,"title":5,"body":6,"description":116,"extension":117,"meta":118,"navigation":119,"order":120,"path":121,"seo":122,"stem":12,"__hash__":123},"content_en\u002Fsupport.md","Support",{"type":7,"value":8,"toc":107},"minimark",[9,13,17,22,25,34,46,50,57,61,78,82,96,100],[10,11,5],"h1",{"id":12},"support",[14,15,16],"p",{},"SoundNinja is a community project in early beta. The fastest way to get help is GitHub.",[18,19,21],"h2",{"id":20},"report-a-bug-or-ask-a-question","Report a bug or ask a question",[14,23,24],{},"Open an issue on GitHub:",[14,26,27],{},[28,29,33],"a",{"href":30,"rel":31},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fissues",[32],"nofollow","github.com\u002Fmarcus-universe\u002FSoundNinja\u002Fissues",[14,35,36,37,41,42,45],{},"Include your OS, SoundNinja version (",[38,39,40],"strong",{},"Help → Check for Updates"," or ",[38,43,44],{},"Settings → About","), and steps to reproduce.",[18,47,49],{"id":48},"email","Email",[14,51,52,53],{},"Maintainer contact: ",[28,54,56],{"href":55},"mailto:contact@marcus-universe.de","contact@marcus-universe.de",[18,58,60],{"id":59},"updates","Updates",[14,62,63,64,66,67,71,72,77],{},"In the app, use ",[38,65,40],{},". New builds also appear on the ",[28,68,70],{"href":69},"\u002Fdownload","Download page"," and on ",[28,73,76],{"href":74,"rel":75},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Freleases",[32],"GitHub Releases",".",[18,79,81],{"id":80},"contribute","Contribute",[14,83,84,85,90,91,77],{},"Pull requests are welcome. The app repo is ",[28,86,89],{"href":87,"rel":88},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja",[32],"github.com\u002Fmarcus-universe\u002FSoundNinja",". The project is licensed under ",[28,92,95],{"href":93,"rel":94},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fblob\u002Fmain\u002FLICENSE",[32],"GPL-3.0",[18,97,99],{"id":98},"legal","Legal",[14,101,102,103,77],{},"Imprint and contact details: ",[28,104,106],{"href":105},"\u002Fimpressum","Impressum",{"title":108,"searchDepth":109,"depth":109,"links":110},"",2,[111,112,113,114,115],{"id":20,"depth":109,"text":21},{"id":48,"depth":109,"text":49},{"id":59,"depth":109,"text":60},{"id":80,"depth":109,"text":81},{"id":98,"depth":109,"text":99},"Where to get help and report bugs.","md",{},true,8,"\u002Fsupport",{"title":5,"description":116},"jRExoghmWgAfTmnmgqLhtQedAnIjqFIbv0_OahYrhTc",[125,244,436,585,739,874,1016,1237],{"id":126,"title":127,"body":128,"description":238,"extension":117,"meta":239,"navigation":119,"order":240,"path":241,"seo":242,"stem":132,"__hash__":243},"content_en\u002Foverview.md","Overview",{"type":7,"value":129,"toc":232},[130,133,136,139,142,146,162,166,196,200,207,211],[10,131,127],{"id":132},"overview",[14,134,135],{},"SoundNinja is an open-source soundboard for live streaming, chatting with friends, and podcast recording. It is built with Tauri v2 and Nuxt 4 so it stays light on RAM and disk.",[14,137,138],{},"The goal is simple: keep a huge sound library easy to scan, then play the right clip in milliseconds. The UI also works well as a dashboard in VR.",[14,140,141],{},"SoundNinja is still in early development. Features work, but not every platform is fully tested.",[18,143,145],{"id":144},"who-it-is-for","Who it is for",[147,148,149,153,156,159],"ul",{},[150,151,152],"li",{},"Streamers who need instant sound cues",[150,154,155],{},"Friends who want a shared board for voice chat",[150,157,158],{},"Podcasters who record clips and drop them onto a board",[150,160,161],{},"Anyone who wants a customizable, local-first soundboard",[18,163,165],{"id":164},"what-you-can-do","What you can do",[147,167,168,171,174,177,180,183,190,193],{},[150,169,170],{},"Build a soundboard from your own audio files",[150,172,173],{},"Organize sounds in colored tabs, groups, and search",[150,175,176],{},"Design the look with the Theme Creator",[150,178,179],{},"Record PC audio or a microphone in the Record Editor",[150,181,182],{},"Assign hotkeys to individual sounds",[150,184,185,186],{},"Trigger sounds from ",[28,187,189],{"href":188},"\u002Fdocs\u002Fremote-control","Bitfocus Companion",[150,191,192],{},"Import and export a full soundboard to share with others",[150,194,195],{},"Use GIFs or images on sound buttons",[18,197,199],{"id":198},"license","License",[14,201,202,203,206],{},"SoundNinja is free software under ",[28,204,95],{"href":93,"rel":205},[32],". Fork it, change it, share it.",[18,208,210],{"id":209},"next-steps","Next steps",[212,213,214,220,226],"ol",{},[150,215,216],{},[28,217,219],{"href":218},"\u002Fdocs\u002Finstallation","Install SoundNinja",[150,221,222],{},[28,223,225],{"href":224},"\u002Fdocs\u002Fadding-sounds","Add sounds",[150,227,228],{},[28,229,231],{"href":230},"\u002Fdocs\u002Forganizing-sounds","Organize your board",{"title":108,"searchDepth":109,"depth":109,"links":233},[234,235,236,237],{"id":144,"depth":109,"text":145},{"id":164,"depth":109,"text":165},{"id":198,"depth":109,"text":199},{"id":209,"depth":109,"text":210},"What SoundNinja is and what you can do with it.",{},1,"\u002Foverview",{"title":127,"description":238},"cOxJIh0ybRdZsyS1INxo9O3CTipyV8220IKpyfnYFJA",{"id":245,"title":246,"body":247,"description":431,"extension":117,"meta":432,"navigation":119,"order":109,"path":433,"seo":434,"stem":251,"__hash__":435},"content_en\u002Finstallation.md","Installation",{"type":7,"value":248,"toc":424},[249,252,263,267,284,287,291,305,308,312,337,348,350,356,360,374,404,420],[10,250,246],{"id":251},"installation",[14,253,254,255,257,258,262],{},"Grab a build from the ",[28,256,70],{"href":69}," or from ",[28,259,76],{"href":260,"rel":261},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Freleases\u002Flatest",[32],". SoundNinja is in early development, so treat builds as beta.",[18,264,266],{"id":265},"windows","Windows",[147,268,269,278,281],{},[150,270,271,41,274,277],{},[38,272,273],{},"Installer (.exe)",[38,275,276],{},"MSI (.msi)"," for 64-bit Windows",[150,279,280],{},"Landing page target: Windows 10 and newer",[150,282,283],{},"The app README also lists Windows 8 and above",[14,285,286],{},"Run the installer, then launch SoundNinja from the Start menu.",[18,288,290],{"id":289},"macos","macOS",[147,292,293,299,302],{},[150,294,295,298],{},[38,296,297],{},"Universal .dmg"," for Apple Silicon and Intel",[150,300,301],{},"Landing page target: macOS 10.14 and newer",[150,303,304],{},"The app README lists macOS 10.15 and above",[14,306,307],{},"Open the disk image and drag SoundNinja to Applications.",[18,309,311],{"id":310},"linux","Linux",[147,313,314,320,326,334],{},[150,315,316,319],{},[38,317,318],{},"Debian (.deb)"," for Ubuntu \u002F Debian",[150,321,322,325],{},[38,323,324],{},"AppImage"," for other distros",[150,327,328,329,333],{},"After a release is published, Arch users can install ",[330,331,332],"code",{},"soundninja-bin"," from the AUR",[150,335,336],{},"Tested on Ubuntu 20.04",[14,338,339,340,343,344,347],{},"Desktop builds need WebKit and GTK packages. On Debian\u002FUbuntu that usually means ",[330,341,342],{},"libwebkit2gtk",", ",[330,345,346],{},"libgtk-3-0",", and an app-indicator library.",[18,349,60],{"id":59},[14,351,352,353,355],{},"In the app, open ",[38,354,40],{},". You can also let SoundNinja check on startup in Settings.",[18,357,359],{"id":358},"build-from-source","Build from source",[14,361,362,363,367,368,373],{},"Need a custom build? Clone ",[28,364,366],{"href":87,"rel":365},[32],"the repo",", install ",[28,369,372],{"href":370,"rel":371},"https:\u002F\u002Fv2.tauri.app\u002Fstart\u002Fprerequisites\u002F",[32],"Tauri prerequisites",", then:",[375,376,380],"pre",{"className":377,"code":378,"language":379,"meta":108,"style":108},"language-bash shiki shiki-themes github-light github-dark","bun install\nbun run tauri:serve\n","bash",[330,381,382,394],{"__ignoreMap":108},[383,384,386,390],"span",{"class":385,"line":240},"line",[383,387,389],{"class":388},"sScJk","bun",[383,391,393],{"class":392},"sZZnC"," install\n",[383,395,396,398,401],{"class":385,"line":109},[383,397,389],{"class":388},[383,399,400],{"class":392}," run",[383,402,403],{"class":392}," tauri:serve\n",[14,405,406,343,409,412,413,416,417,77],{},[330,407,408],{},"npm",[330,410,411],{},"pnpm",", or ",[330,414,415],{},"deno"," work too. Production build: ",[330,418,419],{},"bun run tauri:build",[421,422,423],"style",{},"html pre.shiki code .sScJk, html code.shiki .sScJk{--shiki-default:#6F42C1;--shiki-dark:#B392F0}html pre.shiki code .sZZnC, html code.shiki .sZZnC{--shiki-default:#032F62;--shiki-dark:#9ECBFF}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html.dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}",{"title":108,"searchDepth":109,"depth":109,"links":425},[426,427,428,429,430],{"id":265,"depth":109,"text":266},{"id":289,"depth":109,"text":290},{"id":310,"depth":109,"text":311},{"id":59,"depth":109,"text":60},{"id":358,"depth":109,"text":359},"Install SoundNinja on Windows, macOS, or Linux.",{},"\u002Finstallation",{"title":246,"description":431},"i4XnnjkhxVb30IICErH1K_cBbAQ7GmnD52FYRYjh50k",{"id":437,"title":438,"body":439,"description":579,"extension":117,"meta":580,"navigation":119,"order":581,"path":582,"seo":583,"stem":443,"__hash__":584},"content_en\u002Fadding-sounds.md","Adding Sounds",{"type":7,"value":440,"toc":571},[441,444,447,451,470,474,506,510,529,533,547,550,554,561,565],[10,442,438],{"id":443},"adding-sounds",[14,445,446],{},"A board is empty until you add clips. SoundNinja can import files, whole folders, a recording, or a shared soundboard pack.",[18,448,450],{"id":449},"import-audio-files","Import audio files",[212,452,453,464,467],{},[150,454,455,456,459,460,463],{},"Open ",[38,457,458],{},"File → Import Audio Files",", or use ",[38,461,462],{},"Import"," in the navbar.",[150,465,466],{},"Pick one or more audio files.",[150,468,469],{},"Sounds land in the current tab.",[18,471,473],{"id":472},"import-folders","Import folders",[212,475,476,486,489],{},[150,477,455,478,481,482,485],{},[38,479,480],{},"File → Import Folders"," (or ",[38,483,484],{},"Import Folders"," in the navbar).",[150,487,488],{},"Add one or more folders. Drag to reorder them before you import.",[150,490,491,492],{},"Choose how they land:\n",[147,493,494,500],{},[150,495,496,499],{},[38,497,498],{},"Import as Tabs"," — each folder becomes its own tab",[150,501,502,505],{},[38,503,504],{},"Import to current Tab"," — every file goes into the active tab",[18,507,509],{"id":508},"record-a-clip","Record a clip",[14,511,512,513,517,518,521,522,41,525,528],{},"Open the ",[28,514,516],{"href":515},"\u002Fdocs\u002Frecording-editor","Record Editor"," from the ",[38,519,520],{},"Record"," button in the player bar. Capture, trim, then ",[38,523,524],{},"Import selected",[38,526,527],{},"Import all"," into the current tab or a tab you pick.",[18,530,532],{"id":531},"import-a-soundboard","Import a soundboard",[14,534,535,538,539,542,543,546],{},[38,536,537],{},"File → Import Soundboard"," loads a shared pack. Packs are a ",[330,540,541],{},".zip"," that contains ",[330,544,545],{},"project.sninja"," plus the sound files. After import, open the project and play.",[14,548,549],{},"You can also keep several projects (profiles). Use the project selector to switch boards.",[18,551,553],{"id":552},"relink-missing-files","Relink missing files",[14,555,556,557,560],{},"If audio files move on disk, SoundNinja shows a ",[38,558,559],{},"Missing sound files"," dialog. Pick a folder to search and relink the clips.",[18,562,564],{"id":563},"next","Next",[14,566,567,568,77],{},"Organize tabs, groups, and hotkeys in ",[28,569,570],{"href":230},"Organizing Sounds",{"title":108,"searchDepth":109,"depth":109,"links":572},[573,574,575,576,577,578],{"id":449,"depth":109,"text":450},{"id":472,"depth":109,"text":473},{"id":508,"depth":109,"text":509},{"id":531,"depth":109,"text":532},{"id":552,"depth":109,"text":553},{"id":563,"depth":109,"text":564},"Import audio, folders, recordings, and shared soundboards.",{},3,"\u002Fadding-sounds",{"title":438,"description":579},"qcK88xpbquf2dRogb67sx4O0tzuIof13-X3Yyn9680o",{"id":586,"title":570,"body":587,"description":733,"extension":117,"meta":734,"navigation":119,"order":735,"path":736,"seo":737,"stem":591,"__hash__":738},"content_en\u002Forganizing-sounds.md",{"type":7,"value":588,"toc":724},[589,592,595,599,626,633,637,640,654,661,665,671,675,686,690,693,697,700,706,712,716],[10,590,570],{"id":591},"organizing-sounds",[14,593,594],{},"SoundNinja is built for large libraries. Use tabs, groups, search, and hotkeys so the clip you need is one click (or one key) away.",[18,596,598],{"id":597},"tabs","Tabs",[147,600,601,608,615],{},[150,602,603,604,607],{},"Add a tab with ",[38,605,606],{},"Add tab",". Give it a color so you can scan the bar fast.",[150,609,610,611,614],{},"The ",[38,612,613],{},"All"," view shows every sound across tabs.",[150,616,617,618,621,622,625],{},"A sound can belong to ",[38,619,620],{},"one or more tabs",". Right-click a sound and use ",[38,623,624],{},"Move to tab"," to assign it.",[14,627,628,629,632],{},"Tab transitions live in ",[38,630,631],{},"Settings → Main",": Slide, Fade, Buttons one by one, or None.",[18,634,636],{"id":635},"groups","Groups",[14,638,639],{},"Since v0.5.3, separators can become named groups:",[147,641,642,645,648,651],{},[150,643,644],{},"Add, rename, or remove a group from the context menu",[150,646,647],{},"Drag the group header — children move with it",[150,649,650],{},"Drop sounds in or out of a group",[150,652,653],{},"Set group border color, name color, and button alignment (or use the tab default)",[14,655,656,657,660],{},"You can still add a plain ",[38,658,659],{},"Separator"," if you only need a visual break.",[18,662,664],{"id":663},"search","Search",[14,666,667,668,670],{},"Use the ",[38,669,664],{}," field in the navbar. Results update as you type.",[18,672,674],{"id":673},"reorder","Reorder",[14,676,677,678,681,682,685],{},"Turn on drag-and-drop in ",[38,679,680],{},"Settings → Behavior"," (",[38,683,684],{},"Allow reorder","). Then drag sounds and groups into place.",[18,687,689],{"id":688},"bulk-edit","Bulk edit",[14,691,692],{},"Multi-select sounds, then change color, move them to a tab, or delete them in one step.",[18,694,696],{"id":695},"hotkeys-and-sound-ids","Hotkeys and sound IDs",[14,698,699],{},"Every sound has an 8-character ID. Copy it from the button context menu or the multi-select ID chip.",[14,701,455,702,705],{},[38,703,704],{},"Settings → Hotkeys"," to bind a key to a sound ID. Global hotkeys are optional.",[14,707,708,709,711],{},"The same ID is what ",[28,710,189],{"href":188}," uses to trigger a clip.",[18,713,715],{"id":714},"gifs-and-colors","GIFs and colors",[14,717,718,719,723],{},"Right-click a sound to set per-button colors or a GIF \u002F image background. That is separate from the ",[28,720,722],{"href":721},"\u002Fdocs\u002Ftheme-editor","Theme Creator",", which styles the whole board.",{"title":108,"searchDepth":109,"depth":109,"links":725},[726,727,728,729,730,731,732],{"id":597,"depth":109,"text":598},{"id":635,"depth":109,"text":636},{"id":663,"depth":109,"text":664},{"id":673,"depth":109,"text":674},{"id":688,"depth":109,"text":689},{"id":695,"depth":109,"text":696},{"id":714,"depth":109,"text":715},"Tabs, groups, search, bulk edit, and hotkeys.",{},4,"\u002Forganizing-sounds",{"title":570,"description":733},"Q4gLPzceZdOi3j6gqMTmPuTzf4qua7p2dfLn2shjKT4",{"id":740,"title":741,"body":742,"description":868,"extension":117,"meta":869,"navigation":119,"order":870,"path":871,"seo":872,"stem":746,"__hash__":873},"content_en\u002Ftheme-editor.md","Theme Editor",{"type":7,"value":743,"toc":862},[744,747,753,757,784,787,791,805,809,835,838,842,848],[10,745,741],{"id":746},"theme-editor",[14,748,749,750,77],{},"The Theme Creator is the full visual editor for your board. Open it from ",[38,751,752],{},"Settings → Main → Theme Creator",[18,754,756],{"id":755},"three-tabs","Three tabs",[212,758,759,773,779],{},[150,760,761,764,765,768,769,772],{},[38,762,763],{},"General"," — theme name, shared colors, and font uploads (",[330,766,767],{},".ttf"," \u002F ",[330,770,771],{},".otf",")",[150,774,775,778],{},[38,776,777],{},"Buttons"," — sound button colors, type, layout, and GIF overlay",[150,780,781,783],{},[38,782,598],{}," — tab bar colors, type, and border thickness",[14,785,786],{},"A live preview shows tabs and buttons as you edit.",[18,788,790],{"id":789},"what-you-can-change","What you can change",[147,792,793,796,799,802],{},[150,794,795],{},"Primary and accent colors, backgrounds, button colors, tab colors",[150,797,798],{},"Button and tab font family and size",[150,800,801],{},"Button width, radius, border width, gaps, and padding",[150,803,804],{},"GIF overlay opacity (normal and hover)",[18,806,808],{"id":807},"save-and-share","Save and share",[147,810,811,817,823,829],{},[150,812,813,816],{},[38,814,815],{},"Export .css"," — write a theme file you can back up or send to a friend",[150,818,819,822],{},[38,820,821],{},"Add to Themes"," — save the file into your Themes folder and apply it",[150,824,825,828],{},[38,826,827],{},"Import .css"," — load a built-in preset or a saved theme",[150,830,831,834],{},[38,832,833],{},"Reset"," — return to SoundNinja defaults",[14,836,837],{},"If you close the window with unsaved changes, SoundNinja asks you to save first.",[18,839,841],{"id":840},"without-the-full-editor","Without the full editor",[14,843,844,845,847],{},"In ",[38,846,631],{}," you can still:",[147,849,850,853,859],{},[150,851,852],{},"Pick a theme from the list",[150,854,855,856,772],{},"Edit CSS variables live (",[38,857,858],{},"Custom CSS",[150,860,861],{},"Import a theme file into the Themes folder",{"title":108,"searchDepth":109,"depth":109,"links":863},[864,865,866,867],{"id":755,"depth":109,"text":756},{"id":789,"depth":109,"text":790},{"id":807,"depth":109,"text":808},{"id":840,"depth":109,"text":841},"Design colors, fonts, buttons, and tabs in the Theme Creator.",{},5,"\u002Ftheme-editor",{"title":741,"description":868},"zpMjxENa49aUipEX7TBxcqrbaZNweyJ019KsLAMJeoc",{"id":875,"title":876,"body":877,"description":1010,"extension":117,"meta":1011,"navigation":119,"order":1012,"path":1013,"seo":1014,"stem":881,"__hash__":1015},"content_en\u002Frecording-editor.md","Recording Editor",{"type":7,"value":878,"toc":1004},[879,882,888,892,898,918,921,925,950,954,969,973,987,994],[10,880,876],{"id":881},"recording-editor",[14,883,884,885,887],{},"Record a clip inside SoundNinja, trim it, then import it onto a tab. Open the editor with the ",[38,886,520],{}," button in the player bar.",[18,889,891],{"id":890},"choose-an-input","Choose an input",[14,893,844,894,897],{},[38,895,896],{},"Settings → Audio",":",[147,899,900,906,912],{},[150,901,902,905],{},[38,903,904],{},"Input Devices"," — microphone",[150,907,908,911],{},[38,909,910],{},"Output Devices (PC Audio)"," — loopback of what your PC is playing",[150,913,914,917],{},[38,915,916],{},"Input volume"," — 