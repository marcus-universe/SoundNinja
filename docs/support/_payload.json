[{"data":1,"prerenderedAt":1566},["ShallowReactive",2],{"docs-page-en-\u002Fsupport":3,"docs-nav-en":124},{"id":4,"title":5,"body":6,"description":116,"extension":117,"meta":118,"navigation":119,"order":120,"path":121,"seo":122,"stem":12,"__hash__":123},"content_en\u002Fsupport.md","Support",{"type":7,"value":8,"toc":107},"minimark",[9,13,17,22,25,34,46,50,57,61,78,82,96,100],[10,11,5],"h1",{"id":12},"support",[14,15,16],"p",{},"SoundNinja is a community project in early beta. The fastest way to get help is GitHub.",[18,19,21],"h2",{"id":20},"report-a-bug-or-ask-a-question","Report a bug or ask a question",[14,23,24],{},"Open an issue on GitHub:",[14,26,27],{},[28,29,33],"a",{"href":30,"rel":31},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fissues",[32],"nofollow","github.com\u002Fmarcus-universe\u002FSoundNinja\u002Fissues",[14,35,36,37,41,42,45],{},"Include your OS, SoundNinja version (",[38,39,40],"strong",{},"Help → Check for Updates"," or ",[38,43,44],{},"Settings → About","), and steps to reproduce.",[18,47,49],{"id":48},"email","Email",[14,51,52,53],{},"Maintainer contact: ",[28,54,56],{"href":55},"mailto:contact@marcus-universe.de","contact@marcus-universe.de",[18,58,60],{"id":59},"updates","Updates",[14,62,63,64,66,67,71,72,77],{},"In the app, use ",[38,65,40],{},". New builds also appear on the ",[28,68,70],{"href":69},"\u002Fdownload","Download page"," and on ",[28,73,76],{"href":74,"rel":75},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Freleases",[32],"GitHub Releases",".",[18,79,81],{"id":80},"contribute","Contribute",[14,83,84,85,90,91,77],{},"Pull requests are welcome. The app repo is ",[28,86,89],{"href":87,"rel":88},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja",[32],"github.com\u002Fmarcus-universe\u002FSoundNinja",". The project is licensed under ",[28,92,95],{"href":93,"rel":94},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fblob\u002Fmain\u002FLICENSE",[32],"GPL-3.0",[18,97,99],{"id":98},"legal","Legal",[14,101,102,103,77],{},"Imprint and contact details: ",[28,104,106],{"href":105},"\u002Fimpressum","Impressum",{"title":108,"searchDepth":109,"depth":109,"links":110},"",2,[111,112,113,114,115],{"id":20,"depth":109,"text":21},{"id":48,"depth":109,"text":49},{"id":59,"depth":109,"text":60},{"id":80,"depth":109,"text":81},{"id":98,"depth":109,"text":99},"Where to get help and report bugs.","md",{},true,8,"\u002Fsupport",{"title":5,"description":116},"jRExoghmWgAfTmnmgqLhtQedAnIjqFIbv0_OahYrhTc",[125,253,448,597,1000,1135,1281,1502],{"id":126,"title":127,"body":128,"description":247,"extension":117,"meta":248,"navigation":119,"order":249,"path":250,"seo":251,"stem":132,"__hash__":252},"content_en\u002Foverview.md","Overview",{"type":7,"value":129,"toc":241},[130,133,136,139,142,146,162,166,205,209,216,220],[10,131,127],{"id":132},"overview",[14,134,135],{},"SoundNinja is an open-source soundboard for live streaming, chatting with friends, and podcast recording. It is built with Tauri v2 and Nuxt 4 so it stays light on RAM and disk.",[14,137,138],{},"The goal is simple: keep a huge sound library easy to scan, then play the right clip in milliseconds. The UI also works well as a dashboard in VR.",[14,140,141],{},"SoundNinja is still in early development. Features work, but not every platform is fully tested.",[18,143,145],{"id":144},"who-it-is-for","Who it is for",[147,148,149,153,156,159],"ul",{},[150,151,152],"li",{},"Streamers who need instant sound cues",[150,154,155],{},"Friends who want a shared board for voice chat",[150,157,158],{},"Podcasters who record clips and drop them onto a board",[150,160,161],{},"Anyone who wants a customizable, local-first soundboard",[18,163,165],{"id":164},"what-you-can-do","What you can do",[147,167,168,171,174,177,180,183,186,189,192,199,202],{},[150,169,170],{},"Build a soundboard from your own audio files",[150,172,173],{},"Organize sounds in colored tabs, groups, tags, and search",[150,175,176],{},"Filter by tags (OR) and sort by name, date, duration, or size",[150,178,179],{},"Multi-select with marquee or Shift-range, then bulk color, move, or delete",[150,181,182],{},"Set per-sound volume from the context menu",[150,184,185],{},"Design the look with the Theme Creator",[150,187,188],{},"Record PC audio or a microphone in the Record Editor",[150,190,191],{},"Assign hotkeys to individual sounds",[150,193,194,195],{},"Trigger sounds from ",[28,196,198],{"href":197},"\u002Fdocs\u002Fremote-control","Bitfocus Companion",[150,200,201],{},"Import and export a full soundboard to share with others",[150,203,204],{},"Use GIFs or images on sound buttons — from a local folder library or KLIPY",[18,206,208],{"id":207},"license","License",[14,210,211,212,215],{},"SoundNinja is free software under ",[28,213,95],{"href":93,"rel":214},[32],". Fork it, change it, share it.",[18,217,219],{"id":218},"next-steps","Next steps",[221,222,223,229,235],"ol",{},[150,224,225],{},[28,226,228],{"href":227},"\u002Fdocs\u002Finstallation","Install SoundNinja",[150,230,231],{},[28,232,234],{"href":233},"\u002Fdocs\u002Fadding-sounds","Add sounds",[150,236,237],{},[28,238,240],{"href":239},"\u002Fdocs\u002Forganizing-sounds","Organize your board",{"title":108,"searchDepth":109,"depth":109,"links":242},[243,244,245,246],{"id":144,"depth":109,"text":145},{"id":164,"depth":109,"text":165},{"id":207,"depth":109,"text":208},{"id":218,"depth":109,"text":219},"What SoundNinja is and what you can do with it.",{},1,"\u002Foverview",{"title":127,"description":247},"Dax9ydiOOeEz5F1IxWfEljWZynntK7dPp52JZ3q2G58",{"id":254,"title":255,"body":256,"description":443,"extension":117,"meta":444,"navigation":119,"order":109,"path":445,"seo":446,"stem":260,"__hash__":447},"content_en\u002Finstallation.md","Installation",{"type":7,"value":257,"toc":436},[258,261,272,276,296,299,303,317,320,324,349,360,362,368,372,386,416,432],[10,259,255],{"id":260},"installation",[14,262,263,264,266,267,271],{},"Grab a build from the ",[28,265,70],{"href":69}," or from ",[28,268,76],{"href":269,"rel":270},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Freleases\u002Flatest",[32],". SoundNinja is in early development, so treat builds as beta.",[18,273,275],{"id":274},"windows","Windows",[147,277,278,287,290,293],{},[150,279,280,41,283,286],{},[38,281,282],{},"Installer (.exe)",[38,284,285],{},"MSI (.msi)"," for 64-bit Windows",[150,288,289],{},"Landing page target: Windows 10 and newer",[150,291,292],{},"The app README also lists Windows 8 and above",[150,294,295],{},"The NSIS installer uses a dark theme. Pick a language during setup — SoundNinja remembers it on the next launch.",[14,297,298],{},"Run the installer, then launch SoundNinja from the Start menu.",[18,300,302],{"id":301},"macos","macOS",[147,304,305,311,314],{},[150,306,307,310],{},[38,308,309],{},"Universal .dmg"," for Apple Silicon and Intel",[150,312,313],{},"Landing page target: macOS 10.14 and newer",[150,315,316],{},"The app README lists macOS 10.15 and above",[14,318,319],{},"Open the disk image and drag SoundNinja to Applications.",[18,321,323],{"id":322},"linux","Linux",[147,325,326,332,338,346],{},[150,327,328,331],{},[38,329,330],{},"Debian (.deb)"," for Ubuntu \u002F Debian",[150,333,334,337],{},[38,335,336],{},"AppImage"," for other distros",[150,339,340,341,345],{},"After a release is published, Arch users can install ",[342,343,344],"code",{},"soundninja-bin"," from the AUR",[150,347,348],{},"Tested on Ubuntu 20.04",[14,350,351,352,355,356,359],{},"Desktop builds need WebKit and GTK packages. On Debian\u002FUbuntu that usually means ",[342,353,354],{},"libwebkit2gtk",", ",[342,357,358],{},"libgtk-3-0",", and an app-indicator library.",[18,361,60],{"id":59},[14,363,364,365,367],{},"In the app, open ",[38,366,40],{},". You can also let SoundNinja check on startup in Settings.",[18,369,371],{"id":370},"build-from-source","Build from source",[14,373,374,375,379,380,385],{},"Need a custom build? Clone ",[28,376,378],{"href":87,"rel":377},[32],"the repo",", install ",[28,381,384],{"href":382,"rel":383},"https:\u002F\u002Fv2.tauri.app\u002Fstart\u002Fprerequisites\u002F",[32],"Tauri prerequisites",", then:",[387,388,392],"pre",{"className":389,"code":390,"language":391,"meta":108,"style":108},"language-bash shiki shiki-themes github-light github-dark","bun install\nbun run tauri:serve\n","bash",[342,393,394,406],{"__ignoreMap":108},[395,396,398,402],"span",{"class":397,"line":249},"line",[395,399,401],{"class":400},"sScJk","bun",[395,403,405],{"class":404},"sZZnC"," install\n",[395,407,408,410,413],{"class":397,"line":109},[395,409,401],{"class":400},[395,411,412],{"class":404}," run",[395,414,415],{"class":404}," tauri:serve\n",[14,417,418,355,421,424,425,428,429,77],{},[342,419,420],{},"npm",[342,422,423],{},"pnpm",", or ",[342,426,427],{},"deno"," work too. Production build: ",[342,430,431],{},"bun run tauri:build",[433,434,435],"style",{},"html pre.shiki code .sScJk, html code.shiki .sScJk{--shiki-default:#6F42C1;--shiki-dark:#B392F0}html pre.shiki code .sZZnC, html code.shiki .sZZnC{--shiki-default:#032F62;--shiki-dark:#9ECBFF}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html.dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}",{"title":108,"searchDepth":109,"depth":109,"links":437},[438,439,440,441,442],{"id":274,"depth":109,"text":275},{"id":301,"depth":109,"text":302},{"id":322,"depth":109,"text":323},{"id":59,"depth":109,"text":60},{"id":370,"depth":109,"text":371},"Install SoundNinja on Windows, macOS, or Linux.",{},"\u002Finstallation",{"title":255,"description":443},"7viacDB8R6wsHmYhw6wWPv9XZF7nR_yMjR5-EjD4OjQ",{"id":449,"title":450,"body":451,"description":591,"extension":117,"meta":592,"navigation":119,"order":593,"path":594,"seo":595,"stem":455,"__hash__":596},"content_en\u002Fadding-sounds.md","Adding Sounds",{"type":7,"value":452,"toc":583},[453,456,459,463,482,486,518,522,541,545,559,562,566,573,577],[10,454,450],{"id":455},"adding-sounds",[14,457,458],{},"A board is empty until you add clips. SoundNinja can import files, whole folders, a recording, or a shared soundboard pack.",[18,460,462],{"id":461},"import-audio-files","Import audio files",[221,464,465,476,479],{},[150,466,467,468,471,472,475],{},"Open ",[38,469,470],{},"File → Import Audio Files",", or use ",[38,473,474],{},"Import"," in the navbar.",[150,477,478],{},"Pick one or more audio files.",[150,480,481],{},"Sounds land in the current tab.",[18,483,485],{"id":484},"import-folders","Import folders",[221,487,488,498,501],{},[150,489,467,490,493,494,497],{},[38,491,492],{},"File → Import Folders"," (or ",[38,495,496],{},"Import Folders"," in the navbar).",[150,499,500],{},"Add one or more folders. Drag to reorder them before you import.",[150,502,503,504],{},"Choose how they land:\n",[147,505,506,512],{},[150,507,508,511],{},[38,509,510],{},"Import as Tabs"," — each folder becomes its own tab",[150,513,514,517],{},[38,515,516],{},"Import to current Tab"," — every file goes into the active tab",[18,519,521],{"id":520},"record-a-clip","Record a clip",[14,523,524,525,529,530,533,534,41,537,540],{},"Open the ",[28,526,528],{"href":527},"\u002Fdocs\u002Frecording-editor","Record Editor"," from the ",[38,531,532],{},"Record"," button in the player bar. Capture, trim, then ",[38,535,536],{},"Import selected",[38,538,539],{},"Import all"," into the current tab or a tab you pick.",[18,542,544],{"id":543},"import-a-soundboard","Import a soundboard",[14,546,547,550,551,554,555,558],{},[38,548,549],{},"File → Import Soundboard"," loads a shared pack. Packs are a ",[342,552,553],{},".zip"," that contains ",[342,556,557],{},"project.sninja"," plus the sound files. After import, open the project and play.",[14,560,561],{},"You can also keep several projects (profiles). Use the project selector to switch boards.",[18,563,565],{"id":564},"relink-missing-files","Relink missing files",[14,567,568,569,572],{},"If audio files move on disk, SoundNinja shows a ",[38,570,571],{},"Missing sound files"," dialog. Pick a folder to search and relink the clips.",[18,574,576],{"id":575},"next","Next",[14,578,579,580,77],{},"Organize tabs, tags, filters, and hotkeys in ",[28,581,582],{"href":239},"Organizing Sounds",{"title":108,"searchDepth":109,"depth":109,"links":584},[585,586,587,588,589,590],{"id":461,"depth":109,"text":462},{"id":484,"depth":109,"text":485},{"id":520,"depth":109,"text":521},{"id":543,"depth":109,"text":544},{"id":564,"depth":109,"text":565},{"id":575,"depth":109,"text":576},"Import audio, folders, recordings, and shared soundboards.",{},3,"\u002Fadding-sounds",{"title":450,"description":591},"SBUvL_H4633CrDyNUKazqKwru4aq1hhgoH4_o99rBsE",{"id":598,"title":582,"body":599,"description":994,"extension":117,"meta":995,"navigation":119,"order":996,"path":997,"seo":998,"stem":603,"__hash__":999},"content_en\u002Forganizing-sounds.md",{"type":7,"value":600,"toc":979},[601,604,611,615,642,649,653,656,670,677,683,687,697,702,734,738,744,748,781,787,791,794,821,824,828,842,846,852,873,889,896,900,910,913,917,924,934,940,944,952,959,976],[10,602,582],{"id":603},"organizing-sounds",[14,605,606,607,610],{},"SoundNinja is built for large libraries. Use ",[38,608,609],{},"tags and filters",", tabs, search, multi-select, and hotkeys so the clip you need is one click (or one key) away.",[18,612,614],{"id":613},"tabs","Tabs",[147,616,617,624,631],{},[150,618,619,620,623],{},"Add a tab with ",[38,621,622],{},"Add tab",". Give it a color so you can scan the bar fast.",[150,625,626,627,630],{},"The ",[38,628,629],{},"All"," view shows every sound across tabs.",[150,632,633,634,637,638,641],{},"A sound can belong to ",[38,635,636],{},"one or more tabs",". Right-click a sound and use ",[38,639,640],{},"Move to tab"," to assign it.",[14,643,644,645,648],{},"Tab transitions live in ",[38,646,647],{},"Settings → Main",": Slide, Fade, Buttons one by one, or None.",[18,650,652],{"id":651},"groups","Groups",[14,654,655],{},"Since v0.5.3, separators can become named groups:",[147,657,658,661,664,667],{},[150,659,660],{},"Add, rename, or remove a group from the context menu",[150,662,663],{},"Drag the group header — children move with it",[150,665,666],{},"Drop sounds in or out of a group",[150,668,669],{},"Set group border color, name color, and button alignment (or use the tab default)",[14,671,672,673,676],{},"You can still add a plain ",[38,674,675],{},"Separator"," if you only need a visual break.",[14,678,679,680,77],{},"Right-click empty board space to ",[38,681,682],{},"Add Group",[18,684,686],{"id":685},"tags-filters","Tags \u002F Filters",[14,688,689,690,693,694,696],{},"Tags cut across tabs. The slide-out ",[38,691,692],{},"Filter"," panel (sidebar ",[38,695,692],{},") is where you create them and turn them into a board filter.",[698,699,701],"h3",{"id":700},"create-and-edit-tags","Create and edit tags",[221,703,704,709,720,727],{},[150,705,467,706,708],{},[38,707,692],{}," in the sidebar.",[150,710,711,712,715,716,719],{},"Under ",[38,713,714],{},"Tags",", use ",[38,717,718],{},"Add tag"," — give it a name and a color.",[150,721,722,723,726],{},"Rename, recolor, or ",[38,724,725],{},"Delete tag"," from the same list.",[150,728,729,730,733],{},"If you see ",[38,731,732],{},"No tags yet",", add one here before you assign anything.",[698,735,737],{"id":736},"assign-tags-to-sounds","Assign tags to sounds",[14,739,740,741,743],{},"Right-click a sound → ",[38,742,714],{}," (checkboxes). A sound can have several tags. If none exist yet, the menu tells you to open the filter panel.",[698,745,747],{"id":746},"filter-the-board","Filter the board",[147,749,750,756,767,778],{},[150,751,752,753,77],{},"Toggle tags in the Filter panel, or as ",[38,754,755],{},"chips under the search bar",[150,757,758,759,762,763,766],{},"Matching is ",[38,760,761],{},"OR",": a sound stays visible if it has ",[38,764,765],{},"any"," selected tag.",[150,768,769,770,773,774,777],{},"The navbar ",[38,771,772],{},"Search"," field ",[38,775,776],{},"ANDs"," with the active tag filter (type + tags together).",[150,779,780],{},"Turn chips off (or clear the filter) to show the full tab again.",[14,782,783,784,77],{},"Colored tag names can appear on buttons. Toggle them in ",[38,785,786],{},"Settings → Behavior → Show tag badges",[18,788,790],{"id":789},"sort","Sort",[14,792,793],{},"Open the filter panel and pick a sort mode:",[147,795,796,802],{},[150,797,798,801],{},[38,799,800],{},"User defined"," — your tab order, with groups visible",[150,803,804,355,807,355,810,424,813,816,817,820],{},[38,805,806],{},"Name",[38,808,809],{},"Added time",[38,811,812],{},"Play time",[38,814,815],{},"File size"," — a flat sorted list; ",[38,818,819],{},"groups are hidden"," in these modes",[14,822,823],{},"Duration sort may warm duration metadata the first time you use it.",[18,825,827],{"id":826},"reorder","Reorder",[14,829,830,831,834,835,838,839,841],{},"Turn on drag-and-drop in ",[38,832,833],{},"Settings → Behavior"," (",[38,836,837],{},"Allow reorder","). Then drag sounds and groups into place. Reorder applies in ",[38,840,800],{}," sort.",[18,843,845],{"id":844},"multi-select","Multi-select",[14,847,848,849,851],{},"Turn on ",[38,850,845],{}," in the navbar, then:",[147,853,854,857,863,870],{},[150,855,856],{},"Click a sound to toggle it",[150,858,859,862],{},[38,860,861],{},"Shift+click"," to select a range from the last anchor",[150,864,865,866,869],{},"Drag a ",[38,867,868],{},"marquee"," on empty board space",[150,871,872],{},"Click empty board (or outside) to clear the selection",[14,874,875,876,355,879,355,882,885,886,77],{},"A bulk bar appears with the count, plus ",[38,877,878],{},"Color",[38,880,881],{},"Move to tab…",[38,883,884],{},"Delete",", and ",[38,887,888],{},"Done",[14,890,891,892,895],{},"In multi-select, each button shows an ",[38,893,894],{},"8-character ID chip",". Right-click the chip to copy it.",[18,897,899],{"id":898},"per-sound-volume","Per-sound volume",[14,901,740,902,905,906,909],{},[38,903,904],{},"Volume",". Drag the slider from 0% to 100%. ",[38,907,908],{},"Double-click"," the slider to reset to 100%.",[14,911,912],{},"This stacks with the master output volume in Settings.",[18,914,916],{"id":915},"hotkeys-and-sound-ids","Hotkeys and sound IDs",[14,918,919,920,923],{},"Every sound has an 8-character ID. Copy it from the button context menu (",[38,921,922],{},"Copy ID",") or the multi-select ID chip.",[14,925,467,926,929,930,933],{},[38,927,928],{},"Settings → Hotkeys"," to bind a key to a sound ID. Global hotkeys are optional. ",[38,931,932],{},"Assign hotkey"," on the context menu jumps there with the ID prefilled.",[14,935,936,937,939],{},"The same ID is what ",[28,938,198],{"href":197}," uses to trigger a clip.",[18,941,943],{"id":942},"background-images-and-colors","Background images and colors",[14,945,946,947,951],{},"Right-click a sound to set per-button colors or a background image. That is separate from the ",[28,948,950],{"href":949},"\u002Fdocs\u002Ftheme-editor","Theme Creator",", which styles the whole board.",[14,953,954,955,958],{},"The picker is a ",[38,956,957],{},"Background image"," dialog (PNG, JPEG, GIF, WebP):",[147,960,961,967],{},[150,962,963,966],{},[38,964,965],{},"Local files"," — add folders, pick a single file, search filenames, preview the grid, or remove a folder from the library",[150,968,969,972,973,975],{},[38,970,971],{},"KLIPY"," — search online GIFs. Set your own API key in ",[38,974,833],{},". The key is not stored in project files.",[14,977,978],{},"After you pick an image, pan and crop it on the button.",{"title":108,"searchDepth":109,"depth":109,"links":980},[981,982,983,988,989,990,991,992,993],{"id":613,"depth":109,"text":614},{"id":651,"depth":109,"text":652},{"id":685,"depth":109,"text":686,"children":984},[985,986,987],{"id":700,"depth":593,"text":701},{"id":736,"depth":593,"text":737},{"id":746,"depth":593,"text":747},{"id":789,"depth":109,"text":790},{"id":826,"depth":109,"text":827},{"id":844,"depth":109,"text":845},{"id":898,"depth":109,"text":899},{"id":915,"depth":109,"text":916},{"id":942,"depth":109,"text":943},"Tags, filters, tabs, groups, sort, multi-select, volume, and hotkeys.",{},4,"\u002Forganizing-sounds",{"title":582,"description":994},"DaYqySVuX1kgdTnJw6h1GP_lGyj4zdFP2uKKbBEbVwQ",{"id":1001,"title":1002,"body":1003,"description":1129,"extension":117,"meta":1130,"navigation":119,"order":1131,"path":1132,"seo":1133,"stem":1007,"__hash__":1134},"content_en\u002Ftheme-editor.md","Theme Editor",{"type":7,"value":1004,"toc":1123},[1005,1008,1014,1018,1045,1048,1052,1066,1070,1096,1099,1103,1109],[10,1006,1002],{"id":1007},"theme-editor",[14,1009,1010,1011,77],{},"The Theme Creator is the full visual editor for your board. Open it from ",[38,1012,1013],{},"Settings → Main → Theme Creator",[18,1015,1017],{"id":1016},"three-tabs","Three tabs",[221,1019,1020,1034,1040],{},[150,1021,1022,1025,1026,1029,1030,1033],{},[38,1023,1024],{},"General"," — theme name, shared colors, and font uploads (",[342,1027,1028],{},".ttf"," \u002F ",[342,1031,1032],{},".otf",")",[150,1035,1036,1039],{},[38,1037,1038],{},"Buttons"," — sound button colors, type, layout, and GIF overlay",[150,1041,1042,1044],{},[38,1043,614],{}," — tab bar colors, type, and border thickness",[14,1046,1047],{},"A live preview shows tabs and buttons as you edit.",[18,1049,1051],{"id":1050},"what-you-can-change","What you can change",[147,1053,1054,1057,1060,1063],{},[150,1055,1056],{},"Primary and accent colors, backgrounds, button colors, tab colors",[150,1058,1059],{},"Button and tab font family and size",[150,1061,1062],{},"Button width, radius, border width, gaps, and padding",[150,1064,1065],{},"GIF overlay opacity (normal and hover)",[18,1067,1069],{"id":1068},"save-and-share","Save and share",[147,1071,1072,1078,1084,1090],{},[150,1073,1074,1077],{},[38,1075,1076],{},"Export .css"," — write a theme file you can back up or send to a friend",[150,1079,1080,1083],{},[38,1081,1082],{},"Add to Themes"," — save the file into your Themes folder and apply it",[150,1085,1086,1089],{},[38,1087,1088],{},"Import .css"," — load a built-in preset or a saved theme",[150,1091,1092,1095],{},[38,1093,1094],{},"Reset"," — return to SoundNinja defaults",[14,1097,1098],{},"If you close the window with unsaved changes, SoundNinja asks you to save first.",[18,1100,1102],{"id":1101},"without-the-full-editor","Without the full editor",[14,1104,1105,1106,1108],{},"In ",[38,1107,647],{}," you can still:",[147,1110,1111,1114,1120],{},[150,1112,1113],{},"Pick a theme from the list",[150,1115,1116,1117,1033],{},"Edit CSS variables live (",[38,1118,1119],{},"Custom CSS",[150,1121,1122],{},"Import a theme file into the Themes folder",{"title":108,"searchDepth":109,"depth":109,"links":1124},[1125,1126,1127,1128],{"id":1016,"depth":109,"text":1017},{"id":1050,"depth":109,"text":1051},{"id":1068,"depth":109,"text":1069},{"id":1101,"depth":109,"text":1102},"Design colors, fonts, buttons, and tabs in the Theme Creator.",{},5,"\u002Ftheme-editor",{"title":1002,"description":1129},"zpMjxENa49aUipEX7TBxcqrbaZNweyJ019KsLAMJeoc",{"id":1136,"title":1137,"body":1138,"description":1275,"extension":117,"meta":1276,"navigation":119,"order":1277,"path":1278,"seo":1279,"stem":1142,"__hash__":1280},"content_en\u002Frecording-editor.md","Recording Editor",{"type":7,"value":1139,"toc":1269},[1140,1143,1149,1153,1159,1179,1182,1186,1211,1215,1230,1234,1248,1259],[10,1141,1137],{"id":1142},"recording-editor",[14,1144,1145,1146,1148],{},"Record a clip inside SoundNinja, trim it, then import it onto a tab. Open the editor with the ",[38,1147,532],{}," button in the player bar.",[18,1150,1152],{"id":1151},"choose-an-input","Choose an input",[14,1154,1105,1155,1158],{},[38,1156,1157],{},"Settings → Audio",":",[147,1160,1161,1167,1173],{},[150,1162,1163,1166],{},[38,1164,1165],{},"Input Devices"," — microphone",[150,1168,1169,1172],{},[38,1170,1171],{},"Output Devices (PC Audio)"," — loopback of what your PC is playing",[150,1174,1175,1178],{},[38,1176,1177],{},"Input volume"," — capture gain from 0% to 200%",[14,1180,1181],{},"The Record button uses the device you pick here.",[18,1183,1185],{"id":1184},"edit-the-take","Edit the take",[147,1187,1188,1191,1194,1202,1205,1208],{},[150,1189,1190],{},"Record and stop",[150,1192,1193],{},"Watch the input level meter",[150,1195,1196,41,1199],{},[38,1197,1198],{},"Normalize",[38,1200,1201],{},"Noise Cancelation",[150,1203,1204],{},"Trim the whole clip, trim to a selection, or delete a selection",[150,1206,1207],{},"Undo \u002F redo",[150,1209,1210],{},"Zoom in and out",[18,1212,1214],{"id":1213},"stage-and-import","Stage and import",[221,1216,1217,1220,1223],{},[150,1218,1219],{},"Add the selection or the full track to the staging list.",[150,1221,1222],{},"The list starts empty: record, edit, then add a clip.",[150,1224,1225,41,1227,1229],{},[38,1226,536],{},[38,1228,539],{}," into the current tab or a tab you choose.",[18,1231,1233],{"id":1232},"stem-separation-optional","Stem separation (optional)",[14,1235,1236,1237,1240,1241,41,1244,1247],{},"Official Windows, macOS, and Linux release builds ship the ",[38,1238,1239],{},"stems"," feature. The Record Editor can keep ",[38,1242,1243],{},"vocals",[38,1245,1246],{},"music"," using BS-RoFormer.",[14,1249,1250,1251,1254,1255,1258],{},"The model is about 158 MB and is ",[38,1252,1253],{},"not"," bundled with the installer. Download it from ",[38,1256,1257],{},"Settings → Stem Separation",", or accept the first-run prompt. The Windows installer can also offer to download the model on first launch.",[14,1260,1261,1262,1029,1265,1268],{},"Custom source builds need an extra flag (",[342,1263,1264],{},"tauri:serve:stems",[342,1266,1267],{},"tauri:build:stems",").",{"title":108,"searchDepth":109,"depth":109,"links":1270},[1271,1272,1273,1274],{"id":1151,"depth":109,"text":1152},{"id":1184,"depth":109,"text":1185},{"id":1213,"depth":109,"text":1214},{"id":1232,"depth":109,"text":1233},"Capture mic or PC audio, edit the clip, and drop it on your board.",{},6,"\u002Frecording-editor",{"title":1137,"description":1275},"WLz7ozLeboeLKawRkz53eUj5KSVCj4xkPMhYg5P_MIo",{"id":1282,"title":1283,"body":1284,"description":1496,"extension":117,"meta":1497,"navigation":119,"order":1498,"path":1499,"seo":1500,"stem":1288,"__hash__":1501},"content_en\u002Fremote-control.md","Remote Control",{"type":7,"value":1285,"toc":1489},[1286,1289,1292,1296,1324,1327,1330,1365,1369,1389,1392,1396,1428,1432,1438],[10,1287,1283],{"id":1288},"remote-control",[14,1290,1291],{},"SoundNinja can listen on your local network so Bitfocus Companion (or any HTTP\u002FWebSocket client) can play and stop sounds.",[18,1293,1295],{"id":1294},"enable-the-remote-server","Enable the remote server",[221,1297,1298,1303,1309,1315],{},[150,1299,467,1300,77],{},[38,1301,1302],{},"Settings → Remote",[150,1304,1305,1306,77],{},"Enable the remote server. Default port is ",[38,1307,1308],{},"7331",[150,1310,1311,1312,77],{},"Optional: set a token. Clients must send it as a Bearer token or ",[342,1313,1314],{},"?token=",[150,1316,1317,1318,1321,1322,77],{},"Copy the ",[342,1319,1320],{},"http:\u002F\u002FIP:PORT"," URL, or copy the system IP from ",[38,1323,44],{},[14,1325,1326],{},"Windows may show a firewall prompt the first time the server starts. Allow private-network access.",[18,1328,198],{"id":1329},"bitfocus-companion",[221,1331,1332,1339,1348,1358],{},[150,1333,1334,1335,77],{},"Install ",[28,1336,198],{"href":1337,"rel":1338},"https:\u002F\u002Fbitfocus.io\u002Fcompanion",[32],[150,1340,1341,1342,1347],{},"Download ",[28,1343,1346],{"href":1344,"rel":1345},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002Fcompanion-module-soundninja\u002Freleases\u002Flatest",[32],"SoundNinja-Companion.tgz",". There is no Companion Store package yet.",[150,1349,1350,1351,1354,1355,77],{},"In Companion: ",[38,1352,1353],{},"Modules → Load module package"," and pick the ",[342,1356,1357],{},".tgz",[150,1359,1360,1361,1364],{},"Add a ",[38,1362,1363],{},"Sound Ninja"," connection. Paste the PC IP, port, and token if you set one.",[18,1366,1368],{"id":1367},"actions","Actions",[147,1370,1371,1377,1383],{},[150,1372,1373,1376],{},[38,1374,1375],{},"Trigger Sound"," — pick from the live dropdown, or type an 8-character sound ID (Companion variables work)",[150,1378,1379,1382],{},[38,1380,1381],{},"Stop Sound"," — stop one playing sound by ID",[150,1384,1385,1388],{},[38,1386,1387],{},"Stop All"," — stop every playing sound",[14,1390,1391],{},"Copy a sound ID in SoundNinja from the button context menu or the multi-select ID chip.",[18,1393,1395],{"id":1394},"feedbacks-and-variables","Feedbacks and variables",[147,1397,1398,1404,1416,1422],{},[150,1399,1400,1403],{},[38,1401,1402],{},"Sound Playing"," — true while that sound ID is active (use it for button color)",[150,1405,1406,1409,1410,1029,1413],{},[342,1407,1408],{},"$(soundninja:connected)"," — ",[342,1411,1412],{},"true",[342,1414,1415],{},"false",[150,1417,1418,1421],{},[342,1419,1420],{},"$(soundninja:playing_count)"," — how many sounds are playing",[150,1423,1424,1427],{},[342,1425,1426]