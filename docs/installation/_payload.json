[{"data":1,"prerenderedAt":1658},["ShallowReactive",2],{"docs-page-en-\u002Finstallation":3,"docs-nav-en":242},{"id":4,"title":5,"body":6,"description":235,"extension":236,"meta":237,"navigation":238,"order":177,"path":239,"seo":240,"stem":12,"__hash__":241},"content_en\u002Finstallation.md","Installation",{"type":7,"value":8,"toc":228},"minimark",[9,13,30,35,59,62,66,80,83,87,112,123,127,134,138,153,186,203,224],[10,11,5],"h1",{"id":12},"installation",[14,15,16,17,22,23,29],"p",{},"Grab a build from the ",[18,19,21],"a",{"href":20},"\u002Fdownload","Download page"," or from ",[18,24,28],{"href":25,"rel":26},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Freleases\u002Flatest",[27],"nofollow","GitHub Releases",". SoundNinja is in early development, so treat builds as beta.",[31,32,34],"h2",{"id":33},"windows","Windows",[36,37,38,50,53,56],"ul",{},[39,40,41,45,46,49],"li",{},[42,43,44],"strong",{},"Installer (.exe)"," or ",[42,47,48],{},"MSI (.msi)"," for 64-bit Windows",[39,51,52],{},"Landing page target: Windows 10 and newer",[39,54,55],{},"The app README also lists Windows 8 and above",[39,57,58],{},"The NSIS installer uses a dark theme. Pick a language during setup — SoundNinja remembers it on the next launch.",[14,60,61],{},"Run the installer, then launch SoundNinja from the Start menu.",[31,63,65],{"id":64},"macos","macOS",[36,67,68,74,77],{},[39,69,70,73],{},[42,71,72],{},"Universal .dmg"," for Apple Silicon and Intel",[39,75,76],{},"Landing page target: macOS 10.14 and newer",[39,78,79],{},"The app README lists macOS 10.15 and above",[14,81,82],{},"Open the disk image and drag SoundNinja to Applications.",[31,84,86],{"id":85},"linux","Linux",[36,88,89,95,101,109],{},[39,90,91,94],{},[42,92,93],{},"Debian (.deb)"," for Ubuntu \u002F Debian",[39,96,97,100],{},[42,98,99],{},"AppImage"," for other distros",[39,102,103,104,108],{},"After a release is published, Arch users can install ",[105,106,107],"code",{},"soundninja-bin"," from the AUR",[39,110,111],{},"Tested on Ubuntu 20.04",[14,113,114,115,118,119,122],{},"Desktop builds need WebKit and GTK packages. On Debian\u002FUbuntu that usually means ",[105,116,117],{},"libwebkit2gtk",", ",[105,120,121],{},"libgtk-3-0",", and an app-indicator library.",[31,124,126],{"id":125},"updates","Updates",[14,128,129,130,133],{},"In the app, open ",[42,131,132],{},"Help → Check for Updates",". You can also let SoundNinja check on startup in Settings.",[31,135,137],{"id":136},"build-from-source","Build from source",[14,139,140,141,146,147,152],{},"Need a custom build? Clone ",[18,142,145],{"href":143,"rel":144},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja",[27],"the repo",", install ",[18,148,151],{"href":149,"rel":150},"https:\u002F\u002Fv2.tauri.app\u002Fstart\u002Fprerequisites\u002F",[27],"Tauri prerequisites",", then:",[154,155,160],"pre",{"className":156,"code":157,"language":158,"meta":159,"style":159},"language-bash shiki shiki-themes github-light github-dark","bun install\nbun run tauri:serve\n","bash","",[105,161,162,175],{"__ignoreMap":159},[163,164,167,171],"span",{"class":165,"line":166},"line",1,[163,168,170],{"class":169},"sScJk","bun",[163,172,174],{"class":173},"sZZnC"," install\n",[163,176,178,180,183],{"class":165,"line":177},2,[163,179,170],{"class":169},[163,181,182],{"class":173}," run",[163,184,185],{"class":173}," tauri:serve\n",[14,187,188,118,191,194,195,198,199,202],{},[105,189,190],{},"npm",[105,192,193],{},"pnpm",", or ",[105,196,197],{},"deno"," work too. Production build: ",[105,200,201],{},"bun run tauri:build",".",[14,204,205,208,209,214,215,218,219,202],{},[42,206,207],{},"Windows only:"," every Windows compile includes ASIO via the ",[18,210,213],{"href":211,"rel":212},"https:\u002F\u002Fwww.steinberg.net\u002Fasiosdk",[27],"Steinberg ASIO SDK",". Run ",[105,216,217],{},"bun run setup:asio"," once (SDK is not in git). Linux and macOS use PipeWire \u002F Core Audio — skip that step. Full notes: ",[18,220,223],{"href":221,"rel":222},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fblob\u002Fmain\u002Fdocs\u002Fbuild-from-source.md",[27],"build-from-source.md",[225,226,227],"style",{},"html pre.shiki code .sScJk, html code.shiki .sScJk{--shiki-default:#6F42C1;--shiki-dark:#B392F0}html pre.shiki code .sZZnC, html code.shiki .sZZnC{--shiki-default:#032F62;--shiki-dark:#9ECBFF}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html.dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}",{"title":159,"searchDepth":177,"depth":177,"links":229},[230,231,232,233,234],{"id":33,"depth":177,"text":34},{"id":64,"depth":177,"text":65},{"id":85,"depth":177,"text":86},{"id":125,"depth":177,"text":126},{"id":136,"depth":177,"text":137},"Install SoundNinja on Windows, macOS, or Linux.","md",{},true,"\u002Finstallation",{"title":5,"description":235},"outLmMLibzOL_84ZfoLBrmphO4wVu0zaTr0u_DS4GUg",[243,370,505,654,1057,1192,1338,1560],{"id":244,"title":245,"body":246,"description":365,"extension":236,"meta":366,"navigation":238,"order":166,"path":367,"seo":368,"stem":250,"__hash__":369},"content_en\u002Foverview.md","Overview",{"type":7,"value":247,"toc":359},[248,251,254,257,260,264,278,282,321,325,334,338],[10,249,245],{"id":250},"overview",[14,252,253],{},"SoundNinja is an open-source soundboard for live streaming, chatting with friends, and podcast recording. It is built with Tauri v2 and Nuxt 4 so it stays light on RAM and disk.",[14,255,256],{},"The goal is simple: keep a huge sound library easy to scan, then play the right clip in milliseconds. The UI also works well as a dashboard in VR.",[14,258,259],{},"SoundNinja is still in early development. Features work, but not every platform is fully tested.",[31,261,263],{"id":262},"who-it-is-for","Who it is for",[36,265,266,269,272,275],{},[39,267,268],{},"Streamers who need instant sound cues",[39,270,271],{},"Friends who want a shared board for voice chat",[39,273,274],{},"Podcasters who record clips and drop them onto a board",[39,276,277],{},"Anyone who wants a customizable, local-first soundboard",[31,279,281],{"id":280},"what-you-can-do","What you can do",[36,283,284,287,290,293,296,299,302,305,308,315,318],{},[39,285,286],{},"Build a soundboard from your own audio files",[39,288,289],{},"Organize sounds in colored tabs, groups, tags, and search",[39,291,292],{},"Filter by tags (OR) and sort by name, date, duration, or size",[39,294,295],{},"Multi-select with marquee or Shift-range, then bulk color, move, or delete",[39,297,298],{},"Set per-sound volume from the context menu",[39,300,301],{},"Design the look with the Theme Creator",[39,303,304],{},"Record PC audio or a microphone in the Record Editor",[39,306,307],{},"Assign hotkeys to individual sounds",[39,309,310,311],{},"Trigger sounds from ",[18,312,314],{"href":313},"\u002Fdocs\u002Fremote-control","Bitfocus Companion",[39,316,317],{},"Import and export a full soundboard to share with others",[39,319,320],{},"Use GIFs or images on sound buttons — from a local folder library or KLIPY",[31,322,324],{"id":323},"license","License",[14,326,327,328,333],{},"SoundNinja is free software under ",[18,329,332],{"href":330,"rel":331},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fblob\u002Fmain\u002FLICENSE",[27],"GPL-3.0",". Fork it, change it, share it.",[31,335,337],{"id":336},"next-steps","Next steps",[339,340,341,347,353],"ol",{},[39,342,343],{},[18,344,346],{"href":345},"\u002Fdocs\u002Finstallation","Install SoundNinja",[39,348,349],{},[18,350,352],{"href":351},"\u002Fdocs\u002Fadding-sounds","Add sounds",[39,354,355],{},[18,356,358],{"href":357},"\u002Fdocs\u002Forganizing-sounds","Organize your board",{"title":159,"searchDepth":177,"depth":177,"links":360},[361,362,363,364],{"id":262,"depth":177,"text":263},{"id":280,"depth":177,"text":281},{"id":323,"depth":177,"text":324},{"id":336,"depth":177,"text":337},"What SoundNinja is and what you can do with it.",{},"\u002Foverview",{"title":245,"description":365},"Dax9ydiOOeEz5F1IxWfEljWZynntK7dPp52JZ3q2G58",{"id":4,"title":5,"body":371,"description":235,"extension":236,"meta":503,"navigation":238,"order":177,"path":239,"seo":504,"stem":12,"__hash__":241},{"type":7,"value":372,"toc":496},[373,375,382,384,398,400,402,412,414,416,432,438,440,444,446,454,472,482,494],[10,374,5],{"id":12},[14,376,16,377,22,379,29],{},[18,378,21],{"href":20},[18,380,28],{"href":25,"rel":381},[27],[31,383,34],{"id":33},[36,385,386,392,394,396],{},[39,387,388,45,390,49],{},[42,389,44],{},[42,391,48],{},[39,393,52],{},[39,395,55],{},[39,397,58],{},[14,399,61],{},[31,401,65],{"id":64},[36,403,404,408,410],{},[39,405,406,73],{},[42,407,72],{},[39,409,76],{},[39,411,79],{},[14,413,82],{},[31,415,86],{"id":85},[36,417,418,422,426,430],{},[39,419,420,94],{},[42,421,93],{},[39,423,424,100],{},[42,425,99],{},[39,427,103,428,108],{},[105,429,107],{},[39,431,111],{},[14,433,114,434,118,436,122],{},[105,435,117],{},[105,437,121],{},[31,439,126],{"id":125},[14,441,129,442,133],{},[42,443,132],{},[31,445,137],{"id":136},[14,447,140,448,146,451,152],{},[18,449,145],{"href":143,"rel":450},[27],[18,452,151],{"href":149,"rel":453},[27],[154,455,456],{"className":156,"code":157,"language":158,"meta":159,"style":159},[105,457,458,464],{"__ignoreMap":159},[163,459,460,462],{"class":165,"line":166},[163,461,170],{"class":169},[163,463,174],{"class":173},[163,465,466,468,470],{"class":165,"line":177},[163,467,170],{"class":169},[163,469,182],{"class":173},[163,471,185],{"class":173},[14,473,474,118,476,194,478,198,480,202],{},[105,475,190],{},[105,477,193],{},[105,479,197],{},[105,481,201],{},[14,483,484,208,486,214,489,218,491,202],{},[42,485,207],{},[18,487,213],{"href":211,"rel":488},[27],[105,490,217],{},[18,492,223],{"href":221,"rel":493},[27],[225,495,227],{},{"title":159,"searchDepth":177,"depth":177,"links":497},[498,499,500,501,502],{"id":33,"depth":177,"text":34},{"id":64,"depth":177,"text":65},{"id":85,"depth":177,"text":86},{"id":125,"depth":177,"text":126},{"id":136,"depth":177,"text":137},{},{"title":5,"description":235},{"id":506,"title":507,"body":508,"description":648,"extension":236,"meta":649,"navigation":238,"order":650,"path":651,"seo":652,"stem":512,"__hash__":653},"content_en\u002Fadding-sounds.md","Adding Sounds",{"type":7,"value":509,"toc":640},[510,513,516,520,539,543,575,579,598,602,616,619,623,630,634],[10,511,507],{"id":512},"adding-sounds",[14,514,515],{},"A board is empty until you add clips. SoundNinja can import files, whole folders, a recording, or a shared soundboard pack.",[31,517,519],{"id":518},"import-audio-files","Import audio files",[339,521,522,533,536],{},[39,523,524,525,528,529,532],{},"Open ",[42,526,527],{},"File → Import Audio Files",", or use ",[42,530,531],{},"Import"," in the navbar.",[39,534,535],{},"Pick one or more audio files.",[39,537,538],{},"Sounds land in the current tab.",[31,540,542],{"id":541},"import-folders","Import folders",[339,544,545,555,558],{},[39,546,524,547,550,551,554],{},[42,548,549],{},"File → Import Folders"," (or ",[42,552,553],{},"Import Folders"," in the navbar).",[39,556,557],{},"Add one or more folders. Drag to reorder them before you import.",[39,559,560,561],{},"Choose how they land:\n",[36,562,563,569],{},[39,564,565,568],{},[42,566,567],{},"Import as Tabs"," — each folder becomes its own tab",[39,570,571,574],{},[42,572,573],{},"Import to current Tab"," — every file goes into the active tab",[31,576,578],{"id":577},"record-a-clip","Record a clip",[14,580,581,582,586,587,590,591,45,594,597],{},"Open the ",[18,583,585],{"href":584},"\u002Fdocs\u002Frecording-editor","Record Editor"," from the ",[42,588,589],{},"Record"," button in the player bar. Capture, trim, then ",[42,592,593],{},"Import selected",[42,595,596],{},"Import all"," into the current tab or a tab you pick.",[31,599,601],{"id":600},"import-a-soundboard","Import a soundboard",[14,603,604,607,608,611,612,615],{},[42,605,606],{},"File → Import Soundboard"," loads a shared pack. Packs are a ",[105,609,610],{},".zip"," that contains ",[105,613,614],{},"project.sninja"," plus the sound files. After import, open the project and play.",[14,617,618],{},"You can also keep several projects (profiles). Use the project selector to switch boards.",[31,620,622],{"id":621},"relink-missing-files","Relink missing files",[14,624,625,626,629],{},"If audio files move on disk, SoundNinja shows a ",[42,627,628],{},"Missing sound files"," dialog. Pick a folder to search and relink the clips.",[31,631,633],{"id":632},"next","Next",[14,635,636,637,202],{},"Organize tabs, tags, filters, and hotkeys in ",[18,638,639],{"href":357},"Organizing Sounds",{"title":159,"searchDepth":177,"depth":177,"links":641},[642,643,644,645,646,647],{"id":518,"depth":177,"text":519},{"id":541,"depth":177,"text":542},{"id":577,"depth":177,"text":578},{"id":600,"depth":177,"text":601},{"id":621,"depth":177,"text":622},{"id":632,"depth":177,"text":633},"Import audio, folders, recordings, and shared soundboards.",{},3,"\u002Fadding-sounds",{"title":507,"description":648},"SBUvL_H4633CrDyNUKazqKwru4aq1hhgoH4_o99rBsE",{"id":655,"title":639,"body":656,"description":1051,"extension":236,"meta":1052,"navigation":238,"order":1053,"path":1054,"seo":1055,"stem":660,"__hash__":1056},"content_en\u002Forganizing-sounds.md",{"type":7,"value":657,"toc":1036},[658,661,668,672,699,706,710,713,727,734,740,744,754,759,791,795,801,805,838,844,848,851,878,881,885,899,903,909,930,946,953,957,967,970,974,981,991,997,1001,1009,1016,1033],[10,659,639],{"id":660},"organizing-sounds",[14,662,663,664,667],{},"SoundNinja is built for large libraries. Use ",[42,665,666],{},"tags and filters",", tabs, search, multi-select, and hotkeys so the clip you need is one click (or one key) away.",[31,669,671],{"id":670},"tabs","Tabs",[36,673,674,681,688],{},[39,675,676,677,680],{},"Add a tab with ",[42,678,679],{},"Add tab",". Give it a color so you can scan the bar fast.",[39,682,683,684,687],{},"The ",[42,685,686],{},"All"," view shows every sound across tabs.",[39,689,690,691,694,695,698],{},"A sound can belong to ",[42,692,693],{},"one or more tabs",". Right-click a sound and use ",[42,696,697],{},"Move to tab"," to assign it.",[14,700,701,702,705],{},"Tab transitions live in ",[42,703,704],{},"Settings → Main",": Slide, Fade, Buttons one by one, or None.",[31,707,709],{"id":708},"groups","Groups",[14,711,712],{},"Since v0.5.3, separators can become named groups:",[36,714,715,718,721,724],{},[39,716,717],{},"Add, rename, or remove a group from the context menu",[39,719,720],{},"Drag the group header — children move with it",[39,722,723],{},"Drop sounds in or out of a group",[39,725,726],{},"Set group border color, name color, and button alignment (or use the tab default)",[14,728,729,730,733],{},"You can still add a plain ",[42,731,732],{},"Separator"," if you only need a visual break.",[14,735,736,737,202],{},"Right-click empty board space to ",[42,738,739],{},"Add Group",[31,741,743],{"id":742},"tags-filters","Tags \u002F Filters",[14,745,746,747,750,751,753],{},"Tags cut across tabs. The slide-out ",[42,748,749],{},"Filter"," panel (sidebar ",[42,752,749],{},") is where you create them and turn them into a board filter.",[755,756,758],"h3",{"id":757},"create-and-edit-tags","Create and edit tags",[339,760,761,766,777,784],{},[39,762,524,763,765],{},[42,764,749],{}," in the sidebar.",[39,767,768,769,772,773,776],{},"Under ",[42,770,771],{},"Tags",", use ",[42,774,775],{},"Add tag"," — give it a name and a color.",[39,778,779,780,783],{},"Rename, recolor, or ",[42,781,782],{},"Delete tag"," from the same list.",[39,785,786,787,790],{},"If you see ",[42,788,789],{},"No tags yet",", add one here before you assign anything.",[755,792,794],{"id":793},"assign-tags-to-sounds","Assign tags to sounds",[14,796,797,798,800],{},"Right-click a sound → ",[42,799,771],{}," (checkboxes). A sound can have several tags. If none exist yet, the menu tells you to open the filter panel.",[755,802,804],{"id":803},"filter-the-board","Filter the board",[36,806,807,813,824,835],{},[39,808,809,810,202],{},"Toggle tags in the Filter panel, or as ",[42,811,812],{},"chips under the search bar",[39,814,815,816,819,820,823],{},"Matching is ",[42,817,818],{},"OR",": a sound stays visible if it has ",[42,821,822],{},"any"," selected tag.",[39,825,826,827,830,831,834],{},"The navbar ",[42,828,829],{},"Search"," field ",[42,832,833],{},"ANDs"," with the active tag filter (type + tags together).",[39,836,837],{},"Turn chips off (or clear the filter) to show the full tab again.",[14,839,840,841,202],{},"Colored tag names can appear on buttons. Toggle them in ",[42,842,843],{},"Settings → Behavior → Show tag badges",[31,845,847],{"id":846},"sort","Sort",[14,849,850],{},"Open the filter panel and pick a sort mode:",[36,852,853,859],{},[39,854,855,858],{},[42,856,857],{},"User defined"," — your tab order, with groups visible",[39,860,861,118,864,118,867,194,870,873,874,877],{},[42,862,863],{},"Name",[42,865,866],{},"Added time",[42,868,869],{},"Play time",[42,871,872],{},"File size"," — a flat sorted list; ",[42,875,876],{},"groups are hidden"," in these modes",[14,879,880],{},"Duration sort may warm duration metadata the first time you use it.",[31,882,884],{"id":883},"reorder","Reorder",[14,886,887,888,891,892,895,896,898],{},"Turn on drag-and-drop in ",[42,889,890],{},"Settings → Behavior"," (",[42,893,894],{},"Allow reorder","). Then drag sounds and groups into place. Reorder applies in ",[42,897,857],{}," sort.",[31,900,902],{"id":901},"multi-select","Multi-select",[14,904,905,906,908],{},"Turn on ",[42,907,902],{}," in the navbar, then:",[36,910,911,914,920,927],{},[39,912,913],{},"Click a sound to toggle it",[39,915,916,919],{},[42,917,918],{},"Shift+click"," to select a range from the last anchor",[39,921,922,923,926],{},"Drag a ",[42,924,925],{},"marquee"," on empty board space",[39,928,929],{},"Click empty board (or outside) to clear the selection",[14,931,932,933,118,936,118,939,942,943,202],{},"A bulk bar appears with the count, plus ",[42,934,935],{},"Color",[42,937,938],{},"Move to tab…",[42,940,941],{},"Delete",", and ",[42,944,945],{},"Done",[14,947,948,949,952],{},"In multi-select, each button shows an ",[42,950,951],{},"8-character ID chip",". Right-click the chip to copy it.",[31,954,956],{"id":955},"per-sound-volume","Per-sound volume",[14,958,797,959,962,963,966],{},[42,960,961],{},"Volume",". Drag the slider from 0% to 100%. ",[42,964,965],{},"Double-click"," the slider to reset to 100%.",[14,968,969],{},"This stacks with the master output volume in Settings.",[31,971,973],{"id":972},"hotkeys-and-sound-ids","Hotkeys and sound IDs",[14,975,976,977,980],{},"Every sound has an 8-character ID. Copy it from the button context menu (",[42,978,979],{},"Copy ID",") or the multi-select ID chip.",[14,982,524,983,986,987,990],{},[42,984,985],{},"Settings → Hotkeys"," to bind a key to a sound ID. Global hotkeys are optional. ",[42,988,989],{},"Assign hotkey"," on the context menu jumps there with the ID prefilled.",[14,992,993,994,996],{},"The same ID is what ",[18,995,314],{"href":313}," uses to trigger a clip.",[31,998,1000],{"id":999},"background-images-and-colors","Background images and colors",[14,1002,1003,1004,1008],{},"Right-click a sound to set per-button colors or a background image. That is separate from the ",[18,1005,1007],{"href":1006},"\u002Fdocs\u002Ftheme-editor","Theme Creator",", which styles the whole board.",[14,1010,1011,1012,1015],{},"The picker is a ",[42,1013,1014],{},"Background image"," dialog (PNG, JPEG, GIF, WebP):",[36,1017,1018,1024],{},[39,1019,1020,1023],{},[42,1021,1022],{},"Local files"," — add folders, pick a single file, search filenames, preview the grid, or remove a folder from the library",[39,1025,1026,1029,1030,1032],{},[42,1027,1028],{},"KLIPY"," — search online GIFs. Set your own API key in ",[42,1031,890],{},". The key is not stored in project files.",[14,1034,1035],{},"After you pick an image, pan and crop it on the button.",{"title":159,"searchDepth":177,"depth":177,"links":1037},[1038,1039,1040,1045,1046,1047,1048,1049,1050],{"id":670,"depth":177,"text":671},{"id":708,"depth":177,"text":709},{"id":742,"depth":177,"text":743,"children":1041},[1042,1043,1044],{"id":757,"depth":650,"text":758},{"id":793,"depth":650,"text":794},{"id":803,"depth":650,"text":804},{"id":846,"depth":177,"text":847},{"id":883,"depth":177,"text":884},{"id":901,"depth":177,"text":902},{"id":955,"depth":177,"text":956},{"id":972,"depth":177,"text":973},{"id":999,"depth":177,"text":1000},"Tags, filters, tabs, groups, sort, multi-select, volume, and hotkeys.",{},4,"\u002Forganizing-sounds",{"title":639,"description":1051},"DaYqySVuX1kgdTnJw6h1GP_lGyj4zdFP2uKKbBEbVwQ",{"id":1058,"title":1059,"body":1060,"description":1186,"extension":236,"meta":1187,"navigation":238,"order":1188,"path":1189,"seo":1190,"stem":1064,"__hash__":1191},"content_en\u002Ftheme-editor.md","Theme Editor",{"type":7,"value":1061,"toc":1180},[1062,1065,1071,1075,1102,1105,1109,1123,1127,1153,1156,1160,1166],[10,1063,1059],{"id":1064},"theme-editor",[14,1066,1067,1068,202],{},"The Theme Creator is the full visual editor for your board. Open it from ",[42,1069,1070],{},"Settings → Main → Theme Creator",[31,1072,1074],{"id":1073},"three-tabs","Three tabs",[339,1076,1077,1091,1097],{},[39,1078,1079,1082,1083,1086,1087,1090],{},[42,1080,1081],{},"General"," — theme name, shared colors, and font uploads (",[105,1084,1085],{},".ttf"," \u002F ",[105,1088,1089],{},".otf",")",[39,1092,1093,1096],{},[42,1094,1095],{},"Buttons"," — sound button colors, type, layout, and GIF overlay",[39,1098,1099,1101],{},[42,1100,671],{}," — tab bar colors, type, and border thickness",[14,1103,1104],{},"A live preview shows tabs and buttons as you edit.",[31,1106,1108],{"id":1107},"what-you-can-change","What you can change",[36,1110,1111,1114,1117,1120],{},[39,1112,1113],{},"Primary and accent colors, backgrounds, button colors, tab colors",[39,1115,1116],{},"Button and tab font family and size",[39,1118,1119],{},"Button width, radius, border width, gaps, and padding",[39,1121,1122],{},"GIF overlay opacity (normal and hover)",[31,1124,1126],{"id":1125},"save-and-share","Save and share",[36,1128,1129,1135,1141,1147],{},[39,1130,1131,1134],{},[42,1132,1133],{},"Export .css"," — write a theme file you can back up or send to a friend",[39,1136,1137,1140],{},[42,1138,1139],{},"Add to Themes"," — save the file into your Themes folder and apply it",[39,1142,1143,1146],{},[42,1144,1145],{},"Import .css"," — load a built-in preset or a saved theme",[39,1148,1149,1152],{},[42,1150,1151],{},"Reset"," — return to SoundNinja defaults",[14,1154,1155],{},"If you close the window with unsaved changes, SoundNinja asks you to save first.",[31,1157,1159],{"id":1158},"without-the-full-editor","Without the full editor",[14,1161,1162,1163,1165],{},"In ",[42,1164,704],{}," you can still:",[36,1167,1168,1171,1177],{},[39,1169,1170],{},"Pick a theme from the list",[39,1172,1173,1174,1090],{},"Edit CSS variables live (",[42,1175,1176],{},"Custom CSS",[39,1178,1179],{},"Import a theme file into the Themes folder",{"title":159,"searchDepth":177,"depth":177,"links":1181},[1182,1183,1184,1185],{"id":1073,"depth":177,"text":1074},{"id":1107,"depth":177,"text":1108},{"id":1125,"depth":177,"text":1126},{"id":1158,"depth":177,"text":1159},"Design colors, fonts, buttons, and tabs in the Theme Creator.",{},5,"\u002Ftheme-editor",{"title":1059,"description":1186},"zpMjxENa49aUipEX7TBxcqrbaZNweyJ019KsLAMJeoc",{"id":1193,"title":1194,"body":1195,"description":1332,"extension":236,"meta":1333,"navigation":238,"order":1334,"path":1335,"seo":1336,"stem":1199,"__hash__":1337},"content_en\u002Frecording-editor.md","Recording Editor",{"type":7,"value":1196,"toc":1326},[1197,1200,1206,1210,1216,1236,1239,1243,1268,1272,1287,1291,1305,1316],[10,1198,1194],{"id":1199},"recording-editor",[14,1201,1202,1203,1205],{},"Record a clip inside SoundNinja, trim it, then import it onto a tab. Open the editor with the ",[42,1204,589],{}," button in the player bar.",[31,1207,1209],{"id":1208},"choose-an-input","Choose an input",[14,1211,1162,1212,1215],{},[42,1213,1214],{},"Settings → Audio",":",[36,1217,1218,1224,1230],{},[39,1219,1220,1223],{},[42,1221,1222],{},"Input Devices"," — microphone",[39,1225,1226,1229],{},[42,1227,1228],{},"Output Devices (PC Audio)"," — loopback of what your PC is playing",[39,1231,1232,1235],{},[42,1233,1234],{},"Input volume"," — capture gain from 0% to 200%",[14,1237,1238],{},"The Record button uses the device you pick here.",[31,1240,1242],{"id":1241},"edit-the-take","Edit the take",[36,1244,1245,1248,1251,1259,1262,1265],{},[39,1246,1247],{},"Record and stop",[39,1249,1250],{},"Watch the input level meter",[39,1252,1253,45,1256],{},[42,1254,1255],{},"Normalize",[42,1257,1258],{},"Noise Cancelation",[39,1260,1261],{},"Trim the whole clip, trim to a selection, or delete a selection",[39,1263,1264],{},"Undo \u002F redo",[39,1266,1267],{},"Zoom in and out",[31,1269,1271],{"id":1270},"stage-and-import","Stage and import",[339,1273,1274,1277,1280],{},[39,1275,1276],{},"Add the selection or the full track to the staging list.",[39,1278,1279],{},"The list starts empty: record, edit, then add a clip.",[39,1281,1282,45,1284,1286],{},[42,1283,593],{},[42,1285,596],{}," into the current tab or a tab you choose.",[31,1288,1290],{"id":1289},"stem-separation-optional","Stem separation (optional)",[14,1292,1293,1294,1297,1298,45,1301,1304],{},"Official Windows, macOS, and Linux release builds ship the ",[42,1295,1296],{},"stems"," feature. The Record Editor can keep ",[42,1299,1300],{},"vocals",[42,1302,1303],{},"music"," using BS-RoFormer.",[14,1306,1307,1308,1311,1312,1315],{},"The model is about 158 MB and is ",[42,1309,1310],{},"not"," bundled with the installer. Download it from ",[42,1313,1314],{},"Settings → Stem Separation",", or accept the first-run prompt. The Windows installer can also offer to download the model on first launch.",[14,1317,1318,1319,1086,1322,1325],{},"Custom source builds need an extra flag (",[105,1320,1321],{},"tauri:serve:stems",[105,1323,1324],{},"tauri:build:stems",").",{"title":159,"searchDepth":177,"depth":177,"links":1327},[1328,1329,1330,1331],{"id":1208,"depth":177,"text":1209},{"id":1241,"depth":177,"text":1242},{"id":1270,"depth":177,"text":1271},{"id":1289,"depth":177,"text":1290},"Capture mic or PC audio, edit the clip, and drop it on your board.",{},6,"\u002Frecording-editor",{"title":1194,"description":1332},"WLz7ozLeboeLKawRkz53eUj5KSVCj4xkPMhYg5P_MIo",{"id":1339,"title":1340,"body":1341,"description":1554,"extension":236,"meta":1555,"navigation":238,"order":1556,"path":1557,"seo":1558,"stem":1345,"__hash__":1559},"content_en\u002Fremote-control.md","Remote Control",{"type":7,"value":1342,"toc":1547},[1343,1346,1349,1353,1382,1385,1388,1423,1427,1447,1450,1454,1486,1490,1496],[10,1344,1340],{"id":1345},"remote-control",[14,1347,1348],{},"SoundNinja can listen on your local network so Bitfocus Companion (or any HTTP\u002FWebSocket client) can play and stop sounds.",[31,1350,1352],{"id":1351},"enable-the-remote-server","Enable the remote server",[339,1354,1355,1360,1366,1372],{},[39,1356,524,1357,202],{},[42,1358,1359],{},"Settings → Remote",[39,1361,1362,1363,202],{},"Enable the remote server. Default port is ",[42,1364,1365],{},"7331",[39,1367,1368,1369,202],{},"Optional: set a token. Clients must send it as a Bearer token or ",[105,1370,1371],{},"?token=",[39,1373,1374,1375,1378,1379,202],{},"Copy the ",[105,1376,1377],{},"http:\u002F\u002FIP:PORT"," URL, or copy the system IP from ",[42,1380,1381],{},"Settings → About",[14,1383,1384],{},"Windows may show a firewall prompt the first time the server starts. Allow private-network access.",[31,1386,314],{"id":1387},"bitfocus-companion",[339,1389,1390,1397,1406,1416],{},[39,1391,1392,1393,202],{},"Install ",[18,1394,314],{"href":1395,"rel":1396},"https:\u002F\u002Fbitfocus.io\u002Fcompanion",[27],[39,1398,1399,1400,1405],{},"Download ",[18,1401,1404],{"href":1402,"rel":1403},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002Fcompanion-module-soundninja\u002Freleases\u002Flatest",[27],"SoundNinja-Companion.tgz",". There is no Companion Store package yet.",[39,1407,1408,1409,1412,1413,202],{},"In Companion: ",[42,1410,1411],{},"Modules → Load module package"," and pick the ",[105,1414,1415],{},".tgz",[39,1417,1418,1419,1422],{},"Add a ",[42,1420,1421],{},"Sound Ninja"," connection. Paste the PC IP, port, and token if you set one.",[31,1424,1426],{"id":1425},"actions","Actions",[36,1428,1429,1435,1441],{},[39,1430,1431,1434],{},[42,1432,1433],{},"Trigger Sound"," — pick from the live dropdown, or type an 8-character sound ID (Companion variables work)",[39,1436,1437,1440],{},[42,1438,1439],{},"Stop Sound"," — stop one playing sound by ID",[39,1442,1443,1446],{},[42,1444,1445],{},"Stop All"," — stop every playing sound",[14,1448,1449],{},"Copy a sound ID in SoundNinja from the button context menu or the multi-select ID chip.",[31,1451,1453],{"id":1452},"feedbacks-and-variables","Feedbacks and variables",[36,1455,1456,1462,1474,1480],{},[39,1457,1458,1461],{},[42,1459,1460],{},"Sound Playing"," — true while that sound ID is active (use it for button color)",[39,1463,1464,1467,1468,1086,1471],{},[105,1465,1466],{},"$(soundninja:connected)"," — ",[105,1469,1470],{},"true",[105,1472,1473],{},"false",[39,1475,1476,1479],{},[105,1477,1478],{},"$(soundninja:playing_count)"," — how many sounds are playing",[39,1481,1482,1485],{},[105,1483,1484],{},"$(soundninja:last_triggered)"," — last triggered sound ID",[31,1487,1489],{"id":1488},"http-api-advanced","HTTP API (advanced)",[14,1491,1492,1493],{},"Base path: ",[105,1494,1495],{},"\u002Fapi\u002Fv1",[36,1497,1498,1504,1510,1516,1526,1532,1541],{},[39,1499,1500,1503],{},[105,1501,1502],{},"GET \u002Finfo"," — app name, version, protocol, whether a token is required",[39,1505,1506,1509],{},[105,1507,1508],{},"GET \u002Fsounds"," — sound list (id, name, tabs, active)",[39,1511,1512,1515],{},[105,1513,1514],{},"GET \u002Fstate"," — sounds plus currently playing IDs",[39,1517,1518,1521,1522,1525],{},[105,1519,1520],{},"POST \u002Ftrigger"," with ",[105,1523,1524],{},"{ \"id\" }"," — play a sound",[39,1527,1528,1531],{},[105,1529,1530],{},"GET \u002Ftrigger\u002F:id"," — play (easy to test in a browser)",[39,1533,1534,1537,1538,1540],{},[105,1535,1536],{},"POST \u002Fstop"," with optional ",[105,1539,1524],{}," — stop one sound or all",[39,1542,1543,1546],{},[105,1544,1545],{},"GET \u002Fws"," — live state; send trigger\u002Fstop commands inbound",{"title":159,"searchDepth":177,"depth":177,"links":1548},[1549,1550,1551,1552,1553],{"id":1351,"depth":177,"text":1352},{"id":1387,"depth":177,"text":314},{"id":1425,"depth":177,"text":1426},{"id":1452,"depth":177,"text":1453},{"id":1488,"depth":177,"text":1489},"Trigger SoundNinja from Bitfocus Companion over the local network.",{},7,"\u002Fremote-control",{"title":1340,"description":1554},"G5BV4-hARZULMfsuLaTyczPL2Qt2QKaPmATZuk65Lik",{"id":1561,"title":1562,"body":1563,"description":1652,"extension":236,"meta":1653,"navigation":2