[{"data":1,"prerenderedAt":1625},["ShallowReactive",2],{"docs-page-en-\u002Finstallation":3,"docs-nav-en":221},{"id":4,"title":5,"body":6,"description":214,"extension":215,"meta":216,"navigation":217,"order":177,"path":218,"seo":219,"stem":12,"__hash__":220},"content_en\u002Finstallation.md","Installation",{"type":7,"value":8,"toc":207},"minimark",[9,13,30,35,59,62,66,80,83,87,112,123,127,134,138,153,186,203],[10,11,5],"h1",{"id":12},"installation",[14,15,16,17,22,23,29],"p",{},"Grab a build from the ",[18,19,21],"a",{"href":20},"\u002Fdownload","Download page"," or from ",[18,24,28],{"href":25,"rel":26},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Freleases\u002Flatest",[27],"nofollow","GitHub Releases",". SoundNinja is in early development, so treat builds as beta.",[31,32,34],"h2",{"id":33},"windows","Windows",[36,37,38,50,53,56],"ul",{},[39,40,41,45,46,49],"li",{},[42,43,44],"strong",{},"Installer (.exe)"," or ",[42,47,48],{},"MSI (.msi)"," for 64-bit Windows",[39,51,52],{},"Landing page target: Windows 10 and newer",[39,54,55],{},"The app README also lists Windows 8 and above",[39,57,58],{},"The NSIS installer uses a dark theme. Pick a language during setup — SoundNinja remembers it on the next launch.",[14,60,61],{},"Run the installer, then launch SoundNinja from the Start menu.",[31,63,65],{"id":64},"macos","macOS",[36,67,68,74,77],{},[39,69,70,73],{},[42,71,72],{},"Universal .dmg"," for Apple Silicon and Intel",[39,75,76],{},"Landing page target: macOS 10.14 and newer",[39,78,79],{},"The app README lists macOS 10.15 and above",[14,81,82],{},"Open the disk image and drag SoundNinja to Applications.",[31,84,86],{"id":85},"linux","Linux",[36,88,89,95,101,109],{},[39,90,91,94],{},[42,92,93],{},"Debian (.deb)"," for Ubuntu \u002F Debian",[39,96,97,100],{},[42,98,99],{},"AppImage"," for other distros",[39,102,103,104,108],{},"After a release is published, Arch users can install ",[105,106,107],"code",{},"soundninja-bin"," from the AUR",[39,110,111],{},"Tested on Ubuntu 20.04",[14,113,114,115,118,119,122],{},"Desktop builds need WebKit and GTK packages. On Debian\u002FUbuntu that usually means ",[105,116,117],{},"libwebkit2gtk",", ",[105,120,121],{},"libgtk-3-0",", and an app-indicator library.",[31,124,126],{"id":125},"updates","Updates",[14,128,129,130,133],{},"In the app, open ",[42,131,132],{},"Help → Check for Updates",". You can also let SoundNinja check on startup in Settings.",[31,135,137],{"id":136},"build-from-source","Build from source",[14,139,140,141,146,147,152],{},"Need a custom build? Clone ",[18,142,145],{"href":143,"rel":144},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja",[27],"the repo",", install ",[18,148,151],{"href":149,"rel":150},"https:\u002F\u002Fv2.tauri.app\u002Fstart\u002Fprerequisites\u002F",[27],"Tauri prerequisites",", then:",[154,155,160],"pre",{"className":156,"code":157,"language":158,"meta":159,"style":159},"language-bash shiki shiki-themes github-light github-dark","bun install\nbun run tauri:serve\n","bash","",[105,161,162,175],{"__ignoreMap":159},[163,164,167,171],"span",{"class":165,"line":166},"line",1,[163,168,170],{"class":169},"sScJk","bun",[163,172,174],{"class":173},"sZZnC"," install\n",[163,176,178,180,183],{"class":165,"line":177},2,[163,179,170],{"class":169},[163,181,182],{"class":173}," run",[163,184,185],{"class":173}," tauri:serve\n",[14,187,188,118,191,194,195,198,199,202],{},[105,189,190],{},"npm",[105,192,193],{},"pnpm",", or ",[105,196,197],{},"deno"," work too. Production build: ",[105,200,201],{},"bun run tauri:build",".",[204,205,206],"style",{},"html pre.shiki code .sScJk, html code.shiki .sScJk{--shiki-default:#6F42C1;--shiki-dark:#B392F0}html pre.shiki code .sZZnC, html code.shiki .sZZnC{--shiki-default:#032F62;--shiki-dark:#9ECBFF}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html.dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}",{"title":159,"searchDepth":177,"depth":177,"links":208},[209,210,211,212,213],{"id":33,"depth":177,"text":34},{"id":64,"depth":177,"text":65},{"id":85,"depth":177,"text":86},{"id":125,"depth":177,"text":126},{"id":136,"depth":177,"text":137},"Install SoundNinja on Windows, macOS, or Linux.","md",{},true,"\u002Finstallation",{"title":5,"description":214},"7viacDB8R6wsHmYhw6wWPv9XZF7nR_yMjR5-EjD4OjQ",[222,349,472,621,1024,1159,1305,1527],{"id":223,"title":224,"body":225,"description":344,"extension":215,"meta":345,"navigation":217,"order":166,"path":346,"seo":347,"stem":229,"__hash__":348},"content_en\u002Foverview.md","Overview",{"type":7,"value":226,"toc":338},[227,230,233,236,239,243,257,261,300,304,313,317],[10,228,224],{"id":229},"overview",[14,231,232],{},"SoundNinja is an open-source soundboard for live streaming, chatting with friends, and podcast recording. It is built with Tauri v2 and Nuxt 4 so it stays light on RAM and disk.",[14,234,235],{},"The goal is simple: keep a huge sound library easy to scan, then play the right clip in milliseconds. The UI also works well as a dashboard in VR.",[14,237,238],{},"SoundNinja is still in early development. Features work, but not every platform is fully tested.",[31,240,242],{"id":241},"who-it-is-for","Who it is for",[36,244,245,248,251,254],{},[39,246,247],{},"Streamers who need instant sound cues",[39,249,250],{},"Friends who want a shared board for voice chat",[39,252,253],{},"Podcasters who record clips and drop them onto a board",[39,255,256],{},"Anyone who wants a customizable, local-first soundboard",[31,258,260],{"id":259},"what-you-can-do","What you can do",[36,262,263,266,269,272,275,278,281,284,287,294,297],{},[39,264,265],{},"Build a soundboard from your own audio files",[39,267,268],{},"Organize sounds in colored tabs, groups, tags, and search",[39,270,271],{},"Filter by tags (OR) and sort by name, date, duration, or size",[39,273,274],{},"Multi-select with marquee or Shift-range, then bulk color, move, or delete",[39,276,277],{},"Set per-sound volume from the context menu",[39,279,280],{},"Design the look with the Theme Creator",[39,282,283],{},"Record PC audio or a microphone in the Record Editor",[39,285,286],{},"Assign hotkeys to individual sounds",[39,288,289,290],{},"Trigger sounds from ",[18,291,293],{"href":292},"\u002Fdocs\u002Fremote-control","Bitfocus Companion",[39,295,296],{},"Import and export a full soundboard to share with others",[39,298,299],{},"Use GIFs or images on sound buttons — from a local folder library or KLIPY",[31,301,303],{"id":302},"license","License",[14,305,306,307,312],{},"SoundNinja is free software under ",[18,308,311],{"href":309,"rel":310},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fblob\u002Fmain\u002FLICENSE",[27],"GPL-3.0",". Fork it, change it, share it.",[31,314,316],{"id":315},"next-steps","Next steps",[318,319,320,326,332],"ol",{},[39,321,322],{},[18,323,325],{"href":324},"\u002Fdocs\u002Finstallation","Install SoundNinja",[39,327,328],{},[18,329,331],{"href":330},"\u002Fdocs\u002Fadding-sounds","Add sounds",[39,333,334],{},[18,335,337],{"href":336},"\u002Fdocs\u002Forganizing-sounds","Organize your board",{"title":159,"searchDepth":177,"depth":177,"links":339},[340,341,342,343],{"id":241,"depth":177,"text":242},{"id":259,"depth":177,"text":260},{"id":302,"depth":177,"text":303},{"id":315,"depth":177,"text":316},"What SoundNinja is and what you can do with it.",{},"\u002Foverview",{"title":224,"description":344},"Dax9ydiOOeEz5F1IxWfEljWZynntK7dPp52JZ3q2G58",{"id":4,"title":5,"body":350,"description":214,"extension":215,"meta":470,"navigation":217,"order":177,"path":218,"seo":471,"stem":12,"__hash__":220},{"type":7,"value":351,"toc":463},[352,354,361,363,377,379,381,391,393,395,411,417,419,423,425,433,451,461],[10,353,5],{"id":12},[14,355,16,356,22,358,29],{},[18,357,21],{"href":20},[18,359,28],{"href":25,"rel":360},[27],[31,362,34],{"id":33},[36,364,365,371,373,375],{},[39,366,367,45,369,49],{},[42,368,44],{},[42,370,48],{},[39,372,52],{},[39,374,55],{},[39,376,58],{},[14,378,61],{},[31,380,65],{"id":64},[36,382,383,387,389],{},[39,384,385,73],{},[42,386,72],{},[39,388,76],{},[39,390,79],{},[14,392,82],{},[31,394,86],{"id":85},[36,396,397,401,405,409],{},[39,398,399,94],{},[42,400,93],{},[39,402,403,100],{},[42,404,99],{},[39,406,103,407,108],{},[105,408,107],{},[39,410,111],{},[14,412,114,413,118,415,122],{},[105,414,117],{},[105,416,121],{},[31,418,126],{"id":125},[14,420,129,421,133],{},[42,422,132],{},[31,424,137],{"id":136},[14,426,140,427,146,430,152],{},[18,428,145],{"href":143,"rel":429},[27],[18,431,151],{"href":149,"rel":432},[27],[154,434,435],{"className":156,"code":157,"language":158,"meta":159,"style":159},[105,436,437,443],{"__ignoreMap":159},[163,438,439,441],{"class":165,"line":166},[163,440,170],{"class":169},[163,442,174],{"class":173},[163,444,445,447,449],{"class":165,"line":177},[163,446,170],{"class":169},[163,448,182],{"class":173},[163,450,185],{"class":173},[14,452,453,118,455,194,457,198,459,202],{},[105,454,190],{},[105,456,193],{},[105,458,197],{},[105,460,201],{},[204,462,206],{},{"title":159,"searchDepth":177,"depth":177,"links":464},[465,466,467,468,469],{"id":33,"depth":177,"text":34},{"id":64,"depth":177,"text":65},{"id":85,"depth":177,"text":86},{"id":125,"depth":177,"text":126},{"id":136,"depth":177,"text":137},{},{"title":5,"description":214},{"id":473,"title":474,"body":475,"description":615,"extension":215,"meta":616,"navigation":217,"order":617,"path":618,"seo":619,"stem":479,"__hash__":620},"content_en\u002Fadding-sounds.md","Adding Sounds",{"type":7,"value":476,"toc":607},[477,480,483,487,506,510,542,546,565,569,583,586,590,597,601],[10,478,474],{"id":479},"adding-sounds",[14,481,482],{},"A board is empty until you add clips. SoundNinja can import files, whole folders, a recording, or a shared soundboard pack.",[31,484,486],{"id":485},"import-audio-files","Import audio files",[318,488,489,500,503],{},[39,490,491,492,495,496,499],{},"Open ",[42,493,494],{},"File → Import Audio Files",", or use ",[42,497,498],{},"Import"," in the navbar.",[39,501,502],{},"Pick one or more audio files.",[39,504,505],{},"Sounds land in the current tab.",[31,507,509],{"id":508},"import-folders","Import folders",[318,511,512,522,525],{},[39,513,491,514,517,518,521],{},[42,515,516],{},"File → Import Folders"," (or ",[42,519,520],{},"Import Folders"," in the navbar).",[39,523,524],{},"Add one or more folders. Drag to reorder them before you import.",[39,526,527,528],{},"Choose how they land:\n",[36,529,530,536],{},[39,531,532,535],{},[42,533,534],{},"Import as Tabs"," — each folder becomes its own tab",[39,537,538,541],{},[42,539,540],{},"Import to current Tab"," — every file goes into the active tab",[31,543,545],{"id":544},"record-a-clip","Record a clip",[14,547,548,549,553,554,557,558,45,561,564],{},"Open the ",[18,550,552],{"href":551},"\u002Fdocs\u002Frecording-editor","Record Editor"," from the ",[42,555,556],{},"Record"," button in the player bar. Capture, trim, then ",[42,559,560],{},"Import selected",[42,562,563],{},"Import all"," into the current tab or a tab you pick.",[31,566,568],{"id":567},"import-a-soundboard","Import a soundboard",[14,570,571,574,575,578,579,582],{},[42,572,573],{},"File → Import Soundboard"," loads a shared pack. Packs are a ",[105,576,577],{},".zip"," that contains ",[105,580,581],{},"project.sninja"," plus the sound files. After import, open the project and play.",[14,584,585],{},"You can also keep several projects (profiles). Use the project selector to switch boards.",[31,587,589],{"id":588},"relink-missing-files","Relink missing files",[14,591,592,593,596],{},"If audio files move on disk, SoundNinja shows a ",[42,594,595],{},"Missing sound files"," dialog. Pick a folder to search and relink the clips.",[31,598,600],{"id":599},"next","Next",[14,602,603,604,202],{},"Organize tabs, tags, filters, and hotkeys in ",[18,605,606],{"href":336},"Organizing Sounds",{"title":159,"searchDepth":177,"depth":177,"links":608},[609,610,611,612,613,614],{"id":485,"depth":177,"text":486},{"id":508,"depth":177,"text":509},{"id":544,"depth":177,"text":545},{"id":567,"depth":177,"text":568},{"id":588,"depth":177,"text":589},{"id":599,"depth":177,"text":600},"Import audio, folders, recordings, and shared soundboards.",{},3,"\u002Fadding-sounds",{"title":474,"description":615},"SBUvL_H4633CrDyNUKazqKwru4aq1hhgoH4_o99rBsE",{"id":622,"title":606,"body":623,"description":1018,"extension":215,"meta":1019,"navigation":217,"order":1020,"path":1021,"seo":1022,"stem":627,"__hash__":1023},"content_en\u002Forganizing-sounds.md",{"type":7,"value":624,"toc":1003},[625,628,635,639,666,673,677,680,694,701,707,711,721,726,758,762,768,772,805,811,815,818,845,848,852,866,870,876,897,913,920,924,934,937,941,948,958,964,968,976,983,1000],[10,626,606],{"id":627},"organizing-sounds",[14,629,630,631,634],{},"SoundNinja is built for large libraries. Use ",[42,632,633],{},"tags and filters",", tabs, search, multi-select, and hotkeys so the clip you need is one click (or one key) away.",[31,636,638],{"id":637},"tabs","Tabs",[36,640,641,648,655],{},[39,642,643,644,647],{},"Add a tab with ",[42,645,646],{},"Add tab",". Give it a color so you can scan the bar fast.",[39,649,650,651,654],{},"The ",[42,652,653],{},"All"," view shows every sound across tabs.",[39,656,657,658,661,662,665],{},"A sound can belong to ",[42,659,660],{},"one or more tabs",". Right-click a sound and use ",[42,663,664],{},"Move to tab"," to assign it.",[14,667,668,669,672],{},"Tab transitions live in ",[42,670,671],{},"Settings → Main",": Slide, Fade, Buttons one by one, or None.",[31,674,676],{"id":675},"groups","Groups",[14,678,679],{},"Since v0.5.3, separators can become named groups:",[36,681,682,685,688,691],{},[39,683,684],{},"Add, rename, or remove a group from the context menu",[39,686,687],{},"Drag the group header — children move with it",[39,689,690],{},"Drop sounds in or out of a group",[39,692,693],{},"Set group border color, name color, and button alignment (or use the tab default)",[14,695,696,697,700],{},"You can still add a plain ",[42,698,699],{},"Separator"," if you only need a visual break.",[14,702,703,704,202],{},"Right-click empty board space to ",[42,705,706],{},"Add Group",[31,708,710],{"id":709},"tags-filters","Tags \u002F Filters",[14,712,713,714,717,718,720],{},"Tags cut across tabs. The slide-out ",[42,715,716],{},"Filter"," panel (sidebar ",[42,719,716],{},") is where you create them and turn them into a board filter.",[722,723,725],"h3",{"id":724},"create-and-edit-tags","Create and edit tags",[318,727,728,733,744,751],{},[39,729,491,730,732],{},[42,731,716],{}," in the sidebar.",[39,734,735,736,739,740,743],{},"Under ",[42,737,738],{},"Tags",", use ",[42,741,742],{},"Add tag"," — give it a name and a color.",[39,745,746,747,750],{},"Rename, recolor, or ",[42,748,749],{},"Delete tag"," from the same list.",[39,752,753,754,757],{},"If you see ",[42,755,756],{},"No tags yet",", add one here before you assign anything.",[722,759,761],{"id":760},"assign-tags-to-sounds","Assign tags to sounds",[14,763,764,765,767],{},"Right-click a sound → ",[42,766,738],{}," (checkboxes). A sound can have several tags. If none exist yet, the menu tells you to open the filter panel.",[722,769,771],{"id":770},"filter-the-board","Filter the board",[36,773,774,780,791,802],{},[39,775,776,777,202],{},"Toggle tags in the Filter panel, or as ",[42,778,779],{},"chips under the search bar",[39,781,782,783,786,787,790],{},"Matching is ",[42,784,785],{},"OR",": a sound stays visible if it has ",[42,788,789],{},"any"," selected tag.",[39,792,793,794,797,798,801],{},"The navbar ",[42,795,796],{},"Search"," field ",[42,799,800],{},"ANDs"," with the active tag filter (type + tags together).",[39,803,804],{},"Turn chips off (or clear the filter) to show the full tab again.",[14,806,807,808,202],{},"Colored tag names can appear on buttons. Toggle them in ",[42,809,810],{},"Settings → Behavior → Show tag badges",[31,812,814],{"id":813},"sort","Sort",[14,816,817],{},"Open the filter panel and pick a sort mode:",[36,819,820,826],{},[39,821,822,825],{},[42,823,824],{},"User defined"," — your tab order, with groups visible",[39,827,828,118,831,118,834,194,837,840,841,844],{},[42,829,830],{},"Name",[42,832,833],{},"Added time",[42,835,836],{},"Play time",[42,838,839],{},"File size"," — a flat sorted list; ",[42,842,843],{},"groups are hidden"," in these modes",[14,846,847],{},"Duration sort may warm duration metadata the first time you use it.",[31,849,851],{"id":850},"reorder","Reorder",[14,853,854,855,858,859,862,863,865],{},"Turn on drag-and-drop in ",[42,856,857],{},"Settings → Behavior"," (",[42,860,861],{},"Allow reorder","). Then drag sounds and groups into place. Reorder applies in ",[42,864,824],{}," sort.",[31,867,869],{"id":868},"multi-select","Multi-select",[14,871,872,873,875],{},"Turn on ",[42,874,869],{}," in the navbar, then:",[36,877,878,881,887,894],{},[39,879,880],{},"Click a sound to toggle it",[39,882,883,886],{},[42,884,885],{},"Shift+click"," to select a range from the last anchor",[39,888,889,890,893],{},"Drag a ",[42,891,892],{},"marquee"," on empty board space",[39,895,896],{},"Click empty board (or outside) to clear the selection",[14,898,899,900,118,903,118,906,909,910,202],{},"A bulk bar appears with the count, plus ",[42,901,902],{},"Color",[42,904,905],{},"Move to tab…",[42,907,908],{},"Delete",", and ",[42,911,912],{},"Done",[14,914,915,916,919],{},"In multi-select, each button shows an ",[42,917,918],{},"8-character ID chip",". Right-click the chip to copy it.",[31,921,923],{"id":922},"per-sound-volume","Per-sound volume",[14,925,764,926,929,930,933],{},[42,927,928],{},"Volume",". Drag the slider from 0% to 100%. ",[42,931,932],{},"Double-click"," the slider to reset to 100%.",[14,935,936],{},"This stacks with the master output volume in Settings.",[31,938,940],{"id":939},"hotkeys-and-sound-ids","Hotkeys and sound IDs",[14,942,943,944,947],{},"Every sound has an 8-character ID. Copy it from the button context menu (",[42,945,946],{},"Copy ID",") or the multi-select ID chip.",[14,949,491,950,953,954,957],{},[42,951,952],{},"Settings → Hotkeys"," to bind a key to a sound ID. Global hotkeys are optional. ",[42,955,956],{},"Assign hotkey"," on the context menu jumps there with the ID prefilled.",[14,959,960,961,963],{},"The same ID is what ",[18,962,293],{"href":292}," uses to trigger a clip.",[31,965,967],{"id":966},"background-images-and-colors","Background images and colors",[14,969,970,971,975],{},"Right-click a sound to set per-button colors or a background image. That is separate from the ",[18,972,974],{"href":973},"\u002Fdocs\u002Ftheme-editor","Theme Creator",", which styles the whole board.",[14,977,978,979,982],{},"The picker is a ",[42,980,981],{},"Background image"," dialog (PNG, JPEG, GIF, WebP):",[36,984,985,991],{},[39,986,987,990],{},[42,988,989],{},"Local files"," — add folders, pick a single file, search filenames, preview the grid, or remove a folder from the library",[39,992,993,996,997,999],{},[42,994,995],{},"KLIPY"," — search online GIFs. Set your own API key in ",[42,998,857],{},". The key is not stored in project files.",[14,1001,1002],{},"After you pick an image, pan and crop it on the button.",{"title":159,"searchDepth":177,"depth":177,"links":1004},[1005,1006,1007,1012,1013,1014,1015,1016,1017],{"id":637,"depth":177,"text":638},{"id":675,"depth":177,"text":676},{"id":709,"depth":177,"text":710,"children":1008},[1009,1010,1011],{"id":724,"depth":617,"text":725},{"id":760,"depth":617,"text":761},{"id":770,"depth":617,"text":771},{"id":813,"depth":177,"text":814},{"id":850,"depth":177,"text":851},{"id":868,"depth":177,"text":869},{"id":922,"depth":177,"text":923},{"id":939,"depth":177,"text":940},{"id":966,"depth":177,"text":967},"Tags, filters, tabs, groups, sort, multi-select, volume, and hotkeys.",{},4,"\u002Forganizing-sounds",{"title":606,"description":1018},"DaYqySVuX1kgdTnJw6h1GP_lGyj4zdFP2uKKbBEbVwQ",{"id":1025,"title":1026,"body":1027,"description":1153,"extension":215,"meta":1154,"navigation":217,"order":1155,"path":1156,"seo":1157,"stem":1031,"__hash__":1158},"content_en\u002Ftheme-editor.md","Theme Editor",{"type":7,"value":1028,"toc":1147},[1029,1032,1038,1042,1069,1072,1076,1090,1094,1120,1123,1127,1133],[10,1030,1026],{"id":1031},"theme-editor",[14,1033,1034,1035,202],{},"The Theme Creator is the full visual editor for your board. Open it from ",[42,1036,1037],{},"Settings → Main → Theme Creator",[31,1039,1041],{"id":1040},"three-tabs","Three tabs",[318,1043,1044,1058,1064],{},[39,1045,1046,1049,1050,1053,1054,1057],{},[42,1047,1048],{},"General"," — theme name, shared colors, and font uploads (",[105,1051,1052],{},".ttf"," \u002F ",[105,1055,1056],{},".otf",")",[39,1059,1060,1063],{},[42,1061,1062],{},"Buttons"," — sound button colors, type, layout, and GIF overlay",[39,1065,1066,1068],{},[42,1067,638],{}," — tab bar colors, type, and border thickness",[14,1070,1071],{},"A live preview shows tabs and buttons as you edit.",[31,1073,1075],{"id":1074},"what-you-can-change","What you can change",[36,1077,1078,1081,1084,1087],{},[39,1079,1080],{},"Primary and accent colors, backgrounds, button colors, tab colors",[39,1082,1083],{},"Button and tab font family and size",[39,1085,1086],{},"Button width, radius, border width, gaps, and padding",[39,1088,1089],{},"GIF overlay opacity (normal and hover)",[31,1091,1093],{"id":1092},"save-and-share","Save and share",[36,1095,1096,1102,1108,1114],{},[39,1097,1098,1101],{},[42,1099,1100],{},"Export .css"," — write a theme file you can back up or send to a friend",[39,1103,1104,1107],{},[42,1105,1106],{},"Add to Themes"," — save the file into your Themes folder and apply it",[39,1109,1110,1113],{},[42,1111,1112],{},"Import .css"," — load a built-in preset or a saved theme",[39,1115,1116,1119],{},[42,1117,1118],{},"Reset"," — return to SoundNinja defaults",[14,1121,1122],{},"If you close the window with unsaved changes, SoundNinja asks you to save first.",[31,1124,1126],{"id":1125},"without-the-full-editor","Without the full editor",[14,1128,1129,1130,1132],{},"In ",[42,1131,671],{}," you can still:",[36,1134,1135,1138,1144],{},[39,1136,1137],{},"Pick a theme from the list",[39,1139,1140,1141,1057],{},"Edit CSS variables live (",[42,1142,1143],{},"Custom CSS",[39,1145,1146],{},"Import a theme file into the Themes folder",{"title":159,"searchDepth":177,"depth":177,"links":1148},[1149,1150,1151,1152],{"id":1040,"depth":177,"text":1041},{"id":1074,"depth":177,"text":1075},{"id":1092,"depth":177,"text":1093},{"id":1125,"depth":177,"text":1126},"Design colors, fonts, buttons, and tabs in the Theme Creator.",{},5,"\u002Ftheme-editor",{"title":1026,"description":1153},"zpMjxENa49aUipEX7TBxcqrbaZNweyJ019KsLAMJeoc",{"id":1160,"title":1161,"body":1162,"description":1299,"extension":215,"meta":1300,"navigation":217,"order":1301,"path":1302,"seo":1303,"stem":1166,"__hash__":1304},"content_en\u002Frecording-editor.md","Recording Editor",{"type":7,"value":1163,"toc":1293},[1164,1167,1173,1177,1183,1203,1206,1210,1235,1239,1254,1258,1272,1283],[10,1165,1161],{"id":1166},"recording-editor",[14,1168,1169,1170,1172],{},"Record a clip inside SoundNinja, trim it, then import it onto a tab. Open the editor with the ",[42,1171,556],{}," button in the player bar.",[31,1174,1176],{"id":1175},"choose-an-input","Choose an input",[14,1178,1129,1179,1182],{},[42,1180,1181],{},"Settings → Audio",":",[36,1184,1185,1191,1197],{},[39,1186,1187,1190],{},[42,1188,1189],{},"Input Devices"," — microphone",[39,1192,1193,1196],{},[42,1194,1195],{},"Output Devices (PC Audio)"," — loopback of what your PC is playing",[39,1198,1199,1202],{},[42,1200,1201],{},"Input volume"," — capture gain from 0% to 200%",[14,1204,1205],{},"The Record button uses the device you pick here.",[31,1207,1209],{"id":1208},"edit-the-take","Edit the take",[36,1211,1212,1215,1218,1226,1229,1232],{},[39,1213,1214],{},"Record and stop",[39,1216,1217],{},"Watch the input level meter",[39,1219,1220,45,1223],{},[42,1221,1222],{},"Normalize",[42,1224,1225],{},"Noise Cancelation",[39,1227,1228],{},"Trim the whole clip, trim to a selection, or delete a selection",[39,1230,1231],{},"Undo \u002F redo",[39,1233,1234],{},"Zoom in and out",[31,1236,1238],{"id":1237},"stage-and-import","Stage and import",[318,1240,1241,1244,1247],{},[39,1242,1243],{},"Add the selection or the full track to the staging list.",[39,1245,1246],{},"The list starts empty: record, edit, then add a clip.",[39,1248,1249,45,1251,1253],{},[42,1250,560],{},[42,1252,563],{}," into the current tab or a tab you choose.",[31,1255,1257],{"id":1256},"stem-separation-optional","Stem separation (optional)",[14,1259,1260,1261,1264,1265,45,1268,1271],{},"Official Windows, macOS, and Linux release builds ship the ",[42,1262,1263],{},"stems"," feature. The Record Editor can keep ",[42,1266,1267],{},"vocals",[42,1269,1270],{},"music"," using BS-RoFormer.",[14,1273,1274,1275,1278,1279,1282],{},"The model is about 158 MB and is ",[42,1276,1277],{},"not"," bundled with the installer. Download it from ",[42,1280,1281],{},"Settings → Stem Separation",", or accept the first-run prompt. The Windows installer can also offer to download the model on first launch.",[14,1284,1285,1286,1053,1289,1292],{},"Custom source builds need an extra flag (",[105,1287,1288],{},"tauri:serve:stems",[105,1290,1291],{},"tauri:build:stems",").",{"title":159,"searchDepth":177,"depth":177,"links":1294},[1295,1296,1297,1298],{"id":1175,"depth":177,"text":1176},{"id":1208,"depth":177,"text":1209},{"id":1237,"depth":177,"text":1238},{"id":1256,"depth":177,"text":1257},"Capture mic or PC audio, edit the clip, and drop it on your board.",{},6,"\u002Frecording-editor",{"title":1161,"description":1299},"WLz7ozLeboeLKawRkz53eUj5KSVCj4xkPMhYg5P_MIo",{"id":1306,"title":1307,"body":1308,"description":1521,"extension":215,"meta":1522,"navigation":217,"order":1523,"path":1524,"seo":1525,"stem":1312,"__hash__":1526},"content_en\u002Fremote-control.md","Remote Control",{"type":7,"value":1309,"toc":1514},[1310,1313,1316,1320,1349,1352,1355,1390,1394,1414,1417,1421,1453,1457,1463],[10,1311,1307],{"id":1312},"remote-control",[14,1314,1315],{},"SoundNinja can listen on your local network so Bitfocus Companion (or any HTTP\u002FWebSocket client) can play and stop sounds.",[31,1317,1319],{"id":1318},"enable-the-remote-server","Enable the remote server",[318,1321,1322,1327,1333,1339],{},[39,1323,491,1324,202],{},[42,1325,1326],{},"Settings → Remote",[39,1328,1329,1330,202],{},"Enable the remote server. Default port is ",[42,1331,1332],{},"7331",[39,1334,1335,1336,202],{},"Optional: set a token. Clients must send it as a Bearer token or ",[105,1337,1338],{},"?token=",[39,1340,1341,1342,1345,1346,202],{},"Copy the ",[105,1343,1344],{},"http:\u002F\u002FIP:PORT"," URL, or copy the system IP from ",[42,1347,1348],{},"Settings → About",[14,1350,1351],{},"Windows may show a firewall prompt the first time the server starts. Allow private-network access.",[31,1353,293],{"id":1354},"bitfocus-companion",[318,1356,1357,1364,1373,1383],{},[39,1358,1359,1360,202],{},"Install ",[18,1361,293],{"href":1362,"rel":1363},"https:\u002F\u002Fbitfocus.io\u002Fcompanion",[27],[39,1365,1366,1367,1372],{},"Download ",[18,1368,1371],{"href":1369,"rel":1370},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Freleases\u002Flatest\u002Fdownload\u002FSoundNinja-Companion.tgz",[27],"SoundNinja-Companion.tgz",". There is no Companion Store package yet.",[39,1374,1375,1376,1379,1380,202],{},"In Companion: ",[42,1377,1378],{},"Modules → Load module package"," and pick the ",[105,1381,1382],{},".tgz",[39,1384,1385,1386,1389],{},"Add a ",[42,1387,1388],{},"Sound Ninja"," connection. Paste the PC IP, port, and token if you set one.",[31,1391,1393],{"id":1392},"actions","Actions",[36,1395,1396,1402,1408],{},[39,1397,1398,1401],{},[42,1399,1400],{},"Trigger Sound"," — pick from the live dropdown, or type an 8-character sound ID (Companion variables work)",[39,1403,1404,1407],{},[42,1405,1406],{},"Stop Sound"," — stop one playing sound by ID",[39,1409,1410,1413],{},[42,1411,1412],{},"Stop All"," — stop every playing sound",[14,1415,1416],{},"Copy a sound ID in SoundNinja from the button context menu or the multi-select ID chip.",[31,1418,1420],{"id":1419},"feedbacks-and-variables","Feedbacks and variables",[36,1422,1423,1429,1441,1447],{},[39,1424,1425,1428],{},[42,1426,1427],{},"Sound Playing"," — true while that sound ID is active (use it for button color)",[39,1430,1431,1434,1435,1053,1438],{},[105,1432,1433],{},"$(soundninja:connected)"," — ",[105,1436,1437],{},"true",[105,1439,1440],{},"false",[39,1442,1443,1446],{},[105,1444,1445],{},"$(soundninja:playing_count)"," — how many sounds are playing",[39,1448,1449,1452],{},[105,1450,1451],{},"$(soundninja:last_triggered)"," — last triggered sound ID",[31,1454,1456],{"id":1455},"http-api-advanced","HTTP API (advanced)",[14,1458,1459,1460],{},"Base path: ",[105,1461,1462],{},"\u002Fapi\u002Fv1",[36,1464,1465,1471,1477,1483,1493,1499,1508],{},[39,1466,1467,1470],{},[105,1468,1469],{},"GET \u002Finfo"," — app name, version, protocol, whether a token is required",[39,1472,1473,1476],{},[105,1474,1475],{},"GET \u002Fsounds"," — sound list (id, name, tabs, active)",[39,1478,1479,1482],{},[105,1480,1481],{},"GET \u002Fstate"," — sounds plus currently playing IDs",[39,1484,1485,1488,1489,1492],{},[105,1486,1487],{},"POST \u002Ftrigger"," with ",[105,1490,1491],{},"{ \"id\" }"," — play a sound",[39,1494,1495,1498],{},[105,1496,1497],{},"GET \u002Ftrigger\u002F:id"," — play (easy to test in a browser)",[39,1500,1501,1504,1505,1507],{},[105,1502,1503],{},"POST \u002Fstop"," with optional ",[105,1506,1491],{}," — stop one sound or all",[39,1509,1510,1513],{},[105,1511,1512],{},"GET \u002Fws"," — live state; send trigger\u002Fstop commands inbound",{"title":159,"searchDepth":177,"depth":177,"links":1515},[1516,1517,1518,1519,1520],{"id":1318,"depth":177,"text":1319},{"id":1354,"depth":177,"text":293},{"id":1392,"depth":177,"text":1393},{"id":1419,"depth":177,"text":1420},{"id":1455,"depth":177,"text":1456},"Trigger SoundNinja from Bitfocus Companion over the local network.",{},7,"\u002Fremote-control",{"title":1307,"description":1521},"KQi7j7adHXnJVvGqR1hkm5SITYH6EtQRjIgawVIKPhY",{"id":1528,"title":1529,"body":1530,"description":1619,"extension":215,"meta":1620,"navigation":217,"order":1621,"path":1622,"seo":1623,"stem":1534,"__hash__":1624},"content_en\u002Fsupport.md","Support",{"type":7,"value":1531,"toc":1612},[1532,1535,1538,1542,1545,1552,1560,1564,1571,1573,1586,1590,1601,1605],[10,1533,1529],{"id":1534},"support",[14,1536,1537],{},"SoundNinja is a community project in early beta. The fastest way to get help is GitHub.",[31,1539,1541],{"id":1540},"report-a-bug-or-ask-a-question","Report a bug or ask a question",[14,1543,1544],{},"Open an issue on GitHub:",[14,1546,1547],{},[18,1548,1551],{"href":1549,"rel":1550},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fissues",[27],"github.com\u002Fmarcus-universe\u002FSoundNinja\u002Fissues",[14,1553,1554,1555,45,1557,1559],{},"Include your OS, SoundNinja version (",[42,1556,132],{},[42,1558,1348],{},"), and steps to reproduce.",[31,1561,1563],{"id":1562},"email","Email",[14,1565,1566,1567],{},"Maintainer contact: ",[18,1568,1570],{"href":1569},"mailto:contact@marcus-universe.de","contact@marcus-universe.de",[31,1572,126],{"id":125},[14,1574,1575,1576,1578,1579,1581,1582,202],{},"In the app, use ",[42,1577,132],{},". New builds also appear on the ",[18,1580,21],{"href":20}," and on ",[18,1583,28],{"href":1584,"rel":1585},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Freleases",[27],[31,1587,1589],{"id":1588},"contribute","Contribute",[14,1591,1592,1593,1597,1598,202],{},"Pull requests are welcome. The app repo is ",[18,1594,1596],{"href":143,"rel":1595},[27],"github.com\u002Fmarcus-universe\u002FSoundNinja",". The project is licensed under ",[18,1599,311],{"href":309,"rel":1600},[27],[31,1602,1604],{"id":1603},"legal","Legal",[14,1606,1607,1608,202],{},"Imprint and contact details: ",[18,1609,1611],{"href":1610},"\u002Fimpressum","Impressum",{"title":159,"searchDepth":177,"depth":177,"links":1613},[1614,1615,1616,1617,1618],{"id":1540,"depth":177,"text":1541},{"id":1562,"depth":177,"text":1563},{"id":125,"depth":177,"text":126},{"id":1588,"depth":177,"text":1589},{"id":1603,"depth":177,"text":1604},"Where to get help and report bugs.",{},8,"\u002Fsupport",{"title":1529,"description":1619},"jRExoghmWgAfTmnmgqLhtQedAnIjqFIbv0_OahYrhTc",1789333836266]