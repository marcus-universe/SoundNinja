[{"data":1,"prerenderedAt":1361},["ShallowReactive",2],{"docs-page-en-\u002Finstallation":3,"docs-nav-en":218},{"id":4,"title":5,"body":6,"description":211,"extension":212,"meta":213,"navigation":214,"order":174,"path":215,"seo":216,"stem":12,"__hash__":217},"content_en\u002Finstallation.md","Installation",{"type":7,"value":8,"toc":204},"minimark",[9,13,30,35,56,59,63,77,80,84,109,120,124,131,135,150,183,200],[10,11,5],"h1",{"id":12},"installation",[14,15,16,17,22,23,29],"p",{},"Grab a build from the ",[18,19,21],"a",{"href":20},"\u002Fdownload","Download page"," or from ",[18,24,28],{"href":25,"rel":26},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Freleases\u002Flatest",[27],"nofollow","GitHub Releases",". SoundNinja is in early development, so treat builds as beta.",[31,32,34],"h2",{"id":33},"windows","Windows",[36,37,38,50,53],"ul",{},[39,40,41,45,46,49],"li",{},[42,43,44],"strong",{},"Installer (.exe)"," or ",[42,47,48],{},"MSI (.msi)"," for 64-bit Windows",[39,51,52],{},"Landing page target: Windows 10 and newer",[39,54,55],{},"The app README also lists Windows 8 and above",[14,57,58],{},"Run the installer, then launch SoundNinja from the Start menu.",[31,60,62],{"id":61},"macos","macOS",[36,64,65,71,74],{},[39,66,67,70],{},[42,68,69],{},"Universal .dmg"," for Apple Silicon and Intel",[39,72,73],{},"Landing page target: macOS 10.14 and newer",[39,75,76],{},"The app README lists macOS 10.15 and above",[14,78,79],{},"Open the disk image and drag SoundNinja to Applications.",[31,81,83],{"id":82},"linux","Linux",[36,85,86,92,98,106],{},[39,87,88,91],{},[42,89,90],{},"Debian (.deb)"," for Ubuntu \u002F Debian",[39,93,94,97],{},[42,95,96],{},"AppImage"," for other distros",[39,99,100,101,105],{},"After a release is published, Arch users can install ",[102,103,104],"code",{},"soundninja-bin"," from the AUR",[39,107,108],{},"Tested on Ubuntu 20.04",[14,110,111,112,115,116,119],{},"Desktop builds need WebKit and GTK packages. On Debian\u002FUbuntu that usually means ",[102,113,114],{},"libwebkit2gtk",", ",[102,117,118],{},"libgtk-3-0",", and an app-indicator library.",[31,121,123],{"id":122},"updates","Updates",[14,125,126,127,130],{},"In the app, open ",[42,128,129],{},"Help → Check for Updates",". You can also let SoundNinja check on startup in Settings.",[31,132,134],{"id":133},"build-from-source","Build from source",[14,136,137,138,143,144,149],{},"Need a custom build? Clone ",[18,139,142],{"href":140,"rel":141},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja",[27],"the repo",", install ",[18,145,148],{"href":146,"rel":147},"https:\u002F\u002Fv2.tauri.app\u002Fstart\u002Fprerequisites\u002F",[27],"Tauri prerequisites",", then:",[151,152,157],"pre",{"className":153,"code":154,"language":155,"meta":156,"style":156},"language-bash shiki shiki-themes github-light github-dark","bun install\nbun run tauri:serve\n","bash","",[102,158,159,172],{"__ignoreMap":156},[160,161,164,168],"span",{"class":162,"line":163},"line",1,[160,165,167],{"class":166},"sScJk","bun",[160,169,171],{"class":170},"sZZnC"," install\n",[160,173,175,177,180],{"class":162,"line":174},2,[160,176,167],{"class":166},[160,178,179],{"class":170}," run",[160,181,182],{"class":170}," tauri:serve\n",[14,184,185,115,188,191,192,195,196,199],{},[102,186,187],{},"npm",[102,189,190],{},"pnpm",", or ",[102,193,194],{},"deno"," work too. Production build: ",[102,197,198],{},"bun run tauri:build",".",[201,202,203],"style",{},"html pre.shiki code .sScJk, html code.shiki .sScJk{--shiki-default:#6F42C1;--shiki-dark:#B392F0}html pre.shiki code .sZZnC, html code.shiki .sZZnC{--shiki-default:#032F62;--shiki-dark:#9ECBFF}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html.dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}",{"title":156,"searchDepth":174,"depth":174,"links":205},[206,207,208,209,210],{"id":33,"depth":174,"text":34},{"id":61,"depth":174,"text":62},{"id":82,"depth":174,"text":83},{"id":122,"depth":174,"text":123},{"id":133,"depth":174,"text":134},"Install SoundNinja on Windows, macOS, or Linux.","md",{},true,"\u002Finstallation",{"title":5,"description":211},"i4XnnjkhxVb30IICErH1K_cBbAQ7GmnD52FYRYjh50k",[219,337,458,607,761,896,1038,1263],{"id":220,"title":221,"body":222,"description":332,"extension":212,"meta":333,"navigation":214,"order":163,"path":334,"seo":335,"stem":226,"__hash__":336},"content_en\u002Foverview.md","Overview",{"type":7,"value":223,"toc":326},[224,227,230,233,236,240,254,258,288,292,301,305],[10,225,221],{"id":226},"overview",[14,228,229],{},"SoundNinja is an open-source soundboard for live streaming, chatting with friends, and podcast recording. It is built with Tauri v2 and Nuxt 4 so it stays light on RAM and disk.",[14,231,232],{},"The goal is simple: keep a huge sound library easy to scan, then play the right clip in milliseconds. The UI also works well as a dashboard in VR.",[14,234,235],{},"SoundNinja is still in early development. Features work, but not every platform is fully tested.",[31,237,239],{"id":238},"who-it-is-for","Who it is for",[36,241,242,245,248,251],{},[39,243,244],{},"Streamers who need instant sound cues",[39,246,247],{},"Friends who want a shared board for voice chat",[39,249,250],{},"Podcasters who record clips and drop them onto a board",[39,252,253],{},"Anyone who wants a customizable, local-first soundboard",[31,255,257],{"id":256},"what-you-can-do","What you can do",[36,259,260,263,266,269,272,275,282,285],{},[39,261,262],{},"Build a soundboard from your own audio files",[39,264,265],{},"Organize sounds in colored tabs, groups, and search",[39,267,268],{},"Design the look with the Theme Creator",[39,270,271],{},"Record PC audio or a microphone in the Record Editor",[39,273,274],{},"Assign hotkeys to individual sounds",[39,276,277,278],{},"Trigger sounds from ",[18,279,281],{"href":280},"\u002Fdocs\u002Fremote-control","Bitfocus Companion",[39,283,284],{},"Import and export a full soundboard to share with others",[39,286,287],{},"Use GIFs or images on sound buttons",[31,289,291],{"id":290},"license","License",[14,293,294,295,300],{},"SoundNinja is free software under ",[18,296,299],{"href":297,"rel":298},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fblob\u002Fmain\u002FLICENSE",[27],"GPL-3.0",". Fork it, change it, share it.",[31,302,304],{"id":303},"next-steps","Next steps",[306,307,308,314,320],"ol",{},[39,309,310],{},[18,311,313],{"href":312},"\u002Fdocs\u002Finstallation","Install SoundNinja",[39,315,316],{},[18,317,319],{"href":318},"\u002Fdocs\u002Fadding-sounds","Add sounds",[39,321,322],{},[18,323,325],{"href":324},"\u002Fdocs\u002Forganizing-sounds","Organize your board",{"title":156,"searchDepth":174,"depth":174,"links":327},[328,329,330,331],{"id":238,"depth":174,"text":239},{"id":256,"depth":174,"text":257},{"id":290,"depth":174,"text":291},{"id":303,"depth":174,"text":304},"What SoundNinja is and what you can do with it.",{},"\u002Foverview",{"title":221,"description":332},"cOxJIh0ybRdZsyS1INxo9O3CTipyV8220IKpyfnYFJA",{"id":4,"title":5,"body":338,"description":211,"extension":212,"meta":456,"navigation":214,"order":174,"path":215,"seo":457,"stem":12,"__hash__":217},{"type":7,"value":339,"toc":449},[340,342,349,351,363,365,367,377,379,381,397,403,405,409,411,419,437,447],[10,341,5],{"id":12},[14,343,16,344,22,346,29],{},[18,345,21],{"href":20},[18,347,28],{"href":25,"rel":348},[27],[31,350,34],{"id":33},[36,352,353,359,361],{},[39,354,355,45,357,49],{},[42,356,44],{},[42,358,48],{},[39,360,52],{},[39,362,55],{},[14,364,58],{},[31,366,62],{"id":61},[36,368,369,373,375],{},[39,370,371,70],{},[42,372,69],{},[39,374,73],{},[39,376,76],{},[14,378,79],{},[31,380,83],{"id":82},[36,382,383,387,391,395],{},[39,384,385,91],{},[42,386,90],{},[39,388,389,97],{},[42,390,96],{},[39,392,100,393,105],{},[102,394,104],{},[39,396,108],{},[14,398,111,399,115,401,119],{},[102,400,114],{},[102,402,118],{},[31,404,123],{"id":122},[14,406,126,407,130],{},[42,408,129],{},[31,410,134],{"id":133},[14,412,137,413,143,416,149],{},[18,414,142],{"href":140,"rel":415},[27],[18,417,148],{"href":146,"rel":418},[27],[151,420,421],{"className":153,"code":154,"language":155,"meta":156,"style":156},[102,422,423,429],{"__ignoreMap":156},[160,424,425,427],{"class":162,"line":163},[160,426,167],{"class":166},[160,428,171],{"class":170},[160,430,431,433,435],{"class":162,"line":174},[160,432,167],{"class":166},[160,434,179],{"class":170},[160,436,182],{"class":170},[14,438,439,115,441,191,443,195,445,199],{},[102,440,187],{},[102,442,190],{},[102,444,194],{},[102,446,198],{},[201,448,203],{},{"title":156,"searchDepth":174,"depth":174,"links":450},[451,452,453,454,455],{"id":33,"depth":174,"text":34},{"id":61,"depth":174,"text":62},{"id":82,"depth":174,"text":83},{"id":122,"depth":174,"text":123},{"id":133,"depth":174,"text":134},{},{"title":5,"description":211},{"id":459,"title":460,"body":461,"description":601,"extension":212,"meta":602,"navigation":214,"order":603,"path":604,"seo":605,"stem":465,"__hash__":606},"content_en\u002Fadding-sounds.md","Adding Sounds",{"type":7,"value":462,"toc":593},[463,466,469,473,492,496,528,532,551,555,569,572,576,583,587],[10,464,460],{"id":465},"adding-sounds",[14,467,468],{},"A board is empty until you add clips. SoundNinja can import files, whole folders, a recording, or a shared soundboard pack.",[31,470,472],{"id":471},"import-audio-files","Import audio files",[306,474,475,486,489],{},[39,476,477,478,481,482,485],{},"Open ",[42,479,480],{},"File → Import Audio Files",", or use ",[42,483,484],{},"Import"," in the navbar.",[39,487,488],{},"Pick one or more audio files.",[39,490,491],{},"Sounds land in the current tab.",[31,493,495],{"id":494},"import-folders","Import folders",[306,497,498,508,511],{},[39,499,477,500,503,504,507],{},[42,501,502],{},"File → Import Folders"," (or ",[42,505,506],{},"Import Folders"," in the navbar).",[39,509,510],{},"Add one or more folders. Drag to reorder them before you import.",[39,512,513,514],{},"Choose how they land:\n",[36,515,516,522],{},[39,517,518,521],{},[42,519,520],{},"Import as Tabs"," — each folder becomes its own tab",[39,523,524,527],{},[42,525,526],{},"Import to current Tab"," — every file goes into the active tab",[31,529,531],{"id":530},"record-a-clip","Record a clip",[14,533,534,535,539,540,543,544,45,547,550],{},"Open the ",[18,536,538],{"href":537},"\u002Fdocs\u002Frecording-editor","Record Editor"," from the ",[42,541,542],{},"Record"," button in the player bar. Capture, trim, then ",[42,545,546],{},"Import selected",[42,548,549],{},"Import all"," into the current tab or a tab you pick.",[31,552,554],{"id":553},"import-a-soundboard","Import a soundboard",[14,556,557,560,561,564,565,568],{},[42,558,559],{},"File → Import Soundboard"," loads a shared pack. Packs are a ",[102,562,563],{},".zip"," that contains ",[102,566,567],{},"project.sninja"," plus the sound files. After import, open the project and play.",[14,570,571],{},"You can also keep several projects (profiles). Use the project selector to switch boards.",[31,573,575],{"id":574},"relink-missing-files","Relink missing files",[14,577,578,579,582],{},"If audio files move on disk, SoundNinja shows a ",[42,580,581],{},"Missing sound files"," dialog. Pick a folder to search and relink the clips.",[31,584,586],{"id":585},"next","Next",[14,588,589,590,199],{},"Organize tabs, groups, and hotkeys in ",[18,591,592],{"href":324},"Organizing Sounds",{"title":156,"searchDepth":174,"depth":174,"links":594},[595,596,597,598,599,600],{"id":471,"depth":174,"text":472},{"id":494,"depth":174,"text":495},{"id":530,"depth":174,"text":531},{"id":553,"depth":174,"text":554},{"id":574,"depth":174,"text":575},{"id":585,"depth":174,"text":586},"Import audio, folders, recordings, and shared soundboards.",{},3,"\u002Fadding-sounds",{"title":460,"description":601},"qcK88xpbquf2dRogb67sx4O0tzuIof13-X3Yyn9680o",{"id":608,"title":592,"body":609,"description":755,"extension":212,"meta":756,"navigation":214,"order":757,"path":758,"seo":759,"stem":613,"__hash__":760},"content_en\u002Forganizing-sounds.md",{"type":7,"value":610,"toc":746},[611,614,617,621,648,655,659,662,676,683,687,693,697,708,712,715,719,722,728,734,738],[10,612,592],{"id":613},"organizing-sounds",[14,615,616],{},"SoundNinja is built for large libraries. Use tabs, groups, search, and hotkeys so the clip you need is one click (or one key) away.",[31,618,620],{"id":619},"tabs","Tabs",[36,622,623,630,637],{},[39,624,625,626,629],{},"Add a tab with ",[42,627,628],{},"Add tab",". Give it a color so you can scan the bar fast.",[39,631,632,633,636],{},"The ",[42,634,635],{},"All"," view shows every sound across tabs.",[39,638,639,640,643,644,647],{},"A sound can belong to ",[42,641,642],{},"one or more tabs",". Right-click a sound and use ",[42,645,646],{},"Move to tab"," to assign it.",[14,649,650,651,654],{},"Tab transitions live in ",[42,652,653],{},"Settings → Main",": Slide, Fade, Buttons one by one, or None.",[31,656,658],{"id":657},"groups","Groups",[14,660,661],{},"Since v0.5.3, separators can become named groups:",[36,663,664,667,670,673],{},[39,665,666],{},"Add, rename, or remove a group from the context menu",[39,668,669],{},"Drag the group header — children move with it",[39,671,672],{},"Drop sounds in or out of a group",[39,674,675],{},"Set group border color, name color, and button alignment (or use the tab default)",[14,677,678,679,682],{},"You can still add a plain ",[42,680,681],{},"Separator"," if you only need a visual break.",[31,684,686],{"id":685},"search","Search",[14,688,689,690,692],{},"Use the ",[42,691,686],{}," field in the navbar. Results update as you type.",[31,694,696],{"id":695},"reorder","Reorder",[14,698,699,700,703,704,707],{},"Turn on drag-and-drop in ",[42,701,702],{},"Settings → Behavior"," (",[42,705,706],{},"Allow reorder","). Then drag sounds and groups into place.",[31,709,711],{"id":710},"bulk-edit","Bulk edit",[14,713,714],{},"Multi-select sounds, then change color, move them to a tab, or delete them in one step.",[31,716,718],{"id":717},"hotkeys-and-sound-ids","Hotkeys and sound IDs",[14,720,721],{},"Every sound has an 8-character ID. Copy it from the button context menu or the multi-select ID chip.",[14,723,477,724,727],{},[42,725,726],{},"Settings → Hotkeys"," to bind a key to a sound ID. Global hotkeys are optional.",[14,729,730,731,733],{},"The same ID is what ",[18,732,281],{"href":280}," uses to trigger a clip.",[31,735,737],{"id":736},"gifs-and-colors","GIFs and colors",[14,739,740,741,745],{},"Right-click a sound to set per-button colors or a GIF \u002F image background. That is separate from the ",[18,742,744],{"href":743},"\u002Fdocs\u002Ftheme-editor","Theme Creator",", which styles the whole board.",{"title":156,"searchDepth":174,"depth":174,"links":747},[748,749,750,751,752,753,754],{"id":619,"depth":174,"text":620},{"id":657,"depth":174,"text":658},{"id":685,"depth":174,"text":686},{"id":695,"depth":174,"text":696},{"id":710,"depth":174,"text":711},{"id":717,"depth":174,"text":718},{"id":736,"depth":174,"text":737},"Tabs, groups, search, bulk edit, and hotkeys.",{},4,"\u002Forganizing-sounds",{"title":592,"description":755},"Q4gLPzceZdOi3j6gqMTmPuTzf4qua7p2dfLn2shjKT4",{"id":762,"title":763,"body":764,"description":890,"extension":212,"meta":891,"navigation":214,"order":892,"path":893,"seo":894,"stem":768,"__hash__":895},"content_en\u002Ftheme-editor.md","Theme Editor",{"type":7,"value":765,"toc":884},[766,769,775,779,806,809,813,827,831,857,860,864,870],[10,767,763],{"id":768},"theme-editor",[14,770,771,772,199],{},"The Theme Creator is the full visual editor for your board. Open it from ",[42,773,774],{},"Settings → Main → Theme Creator",[31,776,778],{"id":777},"three-tabs","Three tabs",[306,780,781,795,801],{},[39,782,783,786,787,790,791,794],{},[42,784,785],{},"General"," — theme name, shared colors, and font uploads (",[102,788,789],{},".ttf"," \u002F ",[102,792,793],{},".otf",")",[39,796,797,800],{},[42,798,799],{},"Buttons"," — sound button colors, type, layout, and GIF overlay",[39,802,803,805],{},[42,804,620],{}," — tab bar colors, type, and border thickness",[14,807,808],{},"A live preview shows tabs and buttons as you edit.",[31,810,812],{"id":811},"what-you-can-change","What you can change",[36,814,815,818,821,824],{},[39,816,817],{},"Primary and accent colors, backgrounds, button colors, tab colors",[39,819,820],{},"Button and tab font family and size",[39,822,823],{},"Button width, radius, border width, gaps, and padding",[39,825,826],{},"GIF overlay opacity (normal and hover)",[31,828,830],{"id":829},"save-and-share","Save and share",[36,832,833,839,845,851],{},[39,834,835,838],{},[42,836,837],{},"Export .css"," — write a theme file you can back up or send to a friend",[39,840,841,844],{},[42,842,843],{},"Add to Themes"," — save the file into your Themes folder and apply it",[39,846,847,850],{},[42,848,849],{},"Import .css"," — load a built-in preset or a saved theme",[39,852,853,856],{},[42,854,855],{},"Reset"," — return to SoundNinja defaults",[14,858,859],{},"If you close the window with unsaved changes, SoundNinja asks you to save first.",[31,861,863],{"id":862},"without-the-full-editor","Without the full editor",[14,865,866,867,869],{},"In ",[42,868,653],{}," you can still:",[36,871,872,875,881],{},[39,873,874],{},"Pick a theme from the list",[39,876,877,878,794],{},"Edit CSS variables live (",[42,879,880],{},"Custom CSS",[39,882,883],{},"Import a theme file into the Themes folder",{"title":156,"searchDepth":174,"depth":174,"links":885},[886,887,888,889],{"id":777,"depth":174,"text":778},{"id":811,"depth":174,"text":812},{"id":829,"depth":174,"text":830},{"id":862,"depth":174,"text":863},"Design colors, fonts, buttons, and tabs in the Theme Creator.",{},5,"\u002Ftheme-editor",{"title":763,"description":890},"zpMjxENa49aUipEX7TBxcqrbaZNweyJ019KsLAMJeoc",{"id":897,"title":898,"body":899,"description":1032,"extension":212,"meta":1033,"navigation":214,"order":1034,"path":1035,"seo":1036,"stem":903,"__hash__":1037},"content_en\u002Frecording-editor.md","Recording Editor",{"type":7,"value":900,"toc":1026},[901,904,910,914,920,940,943,947,972,976,991,995,1009,1016],[10,902,898],{"id":903},"recording-editor",[14,905,906,907,909],{},"Record a clip inside SoundNinja, trim it, then import it onto a tab. Open the editor with the ",[42,908,542],{}," button in the player bar.",[31,911,913],{"id":912},"choose-an-input","Choose an input",[14,915,866,916,919],{},[42,917,918],{},"Settings → Audio",":",[36,921,922,928,934],{},[39,923,924,927],{},[42,925,926],{},"Input Devices"," — microphone",[39,929,930,933],{},[42,931,932],{},"Output Devices (PC Audio)"," — loopback of what your PC is playing",[39,935,936,939],{},[42,937,938],{},"Input volume"," — capture gain from 0% to 200%",[14,941,942],{},"The Record button uses the device you pick here.",[31,944,946],{"id":945},"edit-the-take","Edit the take",[36,948,949,952,955,963,966,969],{},[39,950,951],{},"Record and stop",[39,953,954],{},"Watch the input level meter",[39,956,957,45,960],{},[42,958,959],{},"Normalize",[42,961,962],{},"Noise Cancelation",[39,964,965],{},"Trim the whole clip, trim to a selection, or delete a selection",[39,967,968],{},"Undo \u002F redo",[39,970,971],{},"Zoom in and out",[31,973,975],{"id":974},"stage-and-import","Stage and import",[306,977,978,981,984],{},[39,979,980],{},"Add the selection or the full track to the staging list.",[39,982,983],{},"The list starts empty: record, edit, then add a clip.",[39,985,986,45,988,990],{},[42,987,546],{},[42,989,549],{}," into the current tab or a tab you choose.",[31,992,994],{"id":993},"stem-separation-optional","Stem separation (optional)",[14,996,997,998,45,1001,1004,1005,1008],{},"The Record Editor can keep ",[42,999,1000],{},"vocals",[42,1002,1003],{},"music"," using BS-RoFormer. The model is about 158 MB and is ",[42,1006,1007],{},"not"," bundled with the app.",[14,1010,1011,1012,1015],{},"Download it from ",[42,1013,1014],{},"Settings → Stem Separation",", or accept the first-run prompt. The Windows installer can also offer to download the model on first launch.",[14,1017,1018,1019,790,1022,1025],{},"Stem builds from source need an extra flag (",[102,1020,1021],{},"tauri:serve:stems",[102,1023,1024],{},"tauri:build:stems",").",{"title":156,"searchDepth":174,"depth":174,"links":1027},[1028,1029,1030,1031],{"id":912,"depth":174,"text":913},{"id":945,"depth":174,"text":946},{"id":974,"depth":174,"text":975},{"id":993,"depth":174,"text":994},"Capture mic or PC audio, edit the clip, and drop it on your board.",{},6,"\u002Frecording-editor",{"title":898,"description":1032},"MJVcc7XyjWmtAdA8N6FQhHNz88XkH8JRCYOy28MJ364",{"id":1039,"title":1040,"body":1041,"description":1257,"extension":212,"meta":1258,"navigation":214,"order":1259,"path":1260,"seo":1261,"stem":1045,"__hash__":1262},"content_en\u002Fremote-control.md","Remote Control",{"type":7,"value":1042,"toc":1250},[1043,1046,1049,1053,1082,1085,1088,1126,1130,1150,1153,1157,1189,1193,1199],[10,1044,1040],{"id":1045},"remote-control",[14,1047,1048],{},"SoundNinja can listen on your local network so Bitfocus Companion (or any HTTP\u002FWebSocket client) can play and stop sounds.",[31,1050,1052],{"id":1051},"enable-the-remote-server","Enable the remote server",[306,1054,1055,1060,1066,1072],{},[39,1056,477,1057,199],{},[42,1058,1059],{},"Settings → Remote",[39,1061,1062,1063,199],{},"Enable the remote server. Default port is ",[42,1064,1065],{},"7331",[39,1067,1068,1069,199],{},"Optional: set a token. Clients must send it as a Bearer token or ",[102,1070,1071],{},"?token=",[39,1073,1074,1075,1078,1079,199],{},"Copy the ",[102,1076,1077],{},"http:\u002F\u002FIP:PORT"," URL, or copy the system IP from ",[42,1080,1081],{},"Settings → About",[14,1083,1084],{},"Windows may show a firewall prompt the first time the server starts. Allow private-network access.",[31,1086,281],{"id":1087},"bitfocus-companion",[306,1089,1090,1097,1106,1113,1119],{},[39,1091,1092,1093,199],{},"Install ",[18,1094,281],{"href":1095,"rel":1096},"https:\u002F\u002Fbitfocus.io\u002Fcompanion",[27],[39,1098,1099,1100,1105],{},"Download the SoundNinja module from the official folder: ",[18,1101,1104],{"href":1102,"rel":1103},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Ftree\u002Fmain\u002Fcompanion-module-soundninja",[27],"companion-module-soundninja",". There is no Companion Store package yet — this folder is the download.",[39,1107,1108,1109,1112],{},"In Companion open ",[42,1110,1111],{},"Developer → Modules",", or drop the folder into Companion’s custom modules path.",[39,1114,1115,1116,199],{},"In the module folder run ",[102,1117,1118],{},"npm install",[39,1120,1121,1122,1125],{},"Add a ",[42,1123,1124],{},"Sound Ninja"," connection. Paste the PC IP, port, and token if you set one.",[31,1127,1129],{"id":1128},"actions","Actions",[36,1131,1132,1138,1144],{},[39,1133,1134,1137],{},[42,1135,1136],{},"Trigger Sound"," — pick from the live dropdown, or type an 8-character sound ID (Companion variables work)",[39,1139,1140,1143],{},[42,1141,1142],{},"Stop Sound"," — stop one playing sound by ID",[39,1145,1146,1149],{},[42,1147,1148],{},"Stop All"," — stop every playing sound",[14,1151,1152],{},"Copy a sound ID in SoundNinja from the button context menu or the multi-select ID chip.",[31,1154,1156],{"id":1155},"feedbacks-and-variables","Feedbacks and variables",[36,1158,1159,1165,1177,1183],{},[39,1160,1161,1164],{},[42,1162,1163],{},"Sound Playing"," — true while that sound ID is active (use it for button color)",[39,1166,1167,1170,1171,790,1174],{},[102,1168,1169],{},"$(soundninja:connected)"," — ",[102,1172,1173],{},"true",[102,1175,1176],{},"false",[39,1178,1179,1182],{},[102,1180,1181],{},"$(soundninja:playing_count)"," — how many sounds are playing",[39,1184,1185,1188],{},[102,1186,1187],{},"$(soundninja:last_triggered)"," — last triggered sound ID",[31,1190,1192],{"id":1191},"http-api-advanced","HTTP API (advanced)",[14,1194,1195,1196],{},"Base path: ",[102,1197,1198],{},"\u002Fapi\u002Fv1",[36,1200,1201,1207,1213,1219,1229,1235,1244],{},[39,1202,1203,1206],{},[102,1204,1205],{},"GET \u002Finfo"," — app name, version, protocol, whether a token is required",[39,1208,1209,1212],{},[102,1210,1211],{},"GET \u002Fsounds"," — sound list (id, name, tabs, active)",[39,1214,1215,1218],{},[102,1216,1217],{},"GET \u002Fstate"," — sounds plus currently playing IDs",[39,1220,1221,1224,1225,1228],{},[102,1222,1223],{},"POST \u002Ftrigger"," with ",[102,1226,1227],{},"{ \"id\" }"," — play a sound",[39,1230,1231,1234],{},[102,1232,1233],{},"GET \u002Ftrigger\u002F:id"," — play (easy to test in a browser)",[39,1236,1237,1240,1241,1243],{},[102,1238,1239],{},"POST \u002Fstop"," with optional ",[102,1242,1227],{}," — stop one sound or all",[39,1245,1246,1249],{},[102,1247,1248],{},"GET \u002Fws"," — live state; send trigger\u002Fstop commands inbound",{"title":156,"searchDepth":174,"depth":174,"links":1251},[1252,1253,1254,1255,1256],{"id":1051,"depth":174,"text":1052},{"id":1087,"depth":174,"text":281},{"id":1128,"depth":174,"text":1129},{"id":1155,"depth":174,"text":1156},{"id":1191,"dep