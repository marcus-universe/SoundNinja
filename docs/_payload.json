[{"data":1,"prerenderedAt":1313},["ShallowReactive",2],{"docs-page-en-\u002Foverview":3,"docs-nav-en":134},{"id":4,"title":5,"body":6,"description":126,"extension":127,"meta":128,"navigation":129,"order":130,"path":131,"seo":132,"stem":12,"__hash__":133},"content_en\u002Foverview.md","Overview",{"type":7,"value":8,"toc":118},"minimark",[9,13,17,20,23,28,44,48,79,83,93,97],[10,11,5],"h1",{"id":12},"overview",[14,15,16],"p",{},"SoundNinja is an open-source soundboard for live streaming, chatting with friends, and podcast recording. It is built with Tauri v2 and Nuxt 4 so it stays light on RAM and disk.",[14,18,19],{},"The goal is simple: keep a huge sound library easy to scan, then play the right clip in milliseconds. The UI also works well as a dashboard in VR.",[14,21,22],{},"SoundNinja is still in early development. Features work, but not every platform is fully tested.",[24,25,27],"h2",{"id":26},"who-it-is-for","Who it is for",[29,30,31,35,38,41],"ul",{},[32,33,34],"li",{},"Streamers who need instant sound cues",[32,36,37],{},"Friends who want a shared board for voice chat",[32,39,40],{},"Podcasters who record clips and drop them onto a board",[32,42,43],{},"Anyone who wants a customizable, local-first soundboard",[24,45,47],{"id":46},"what-you-can-do","What you can do",[29,49,50,53,56,59,62,65,73,76],{},[32,51,52],{},"Build a soundboard from your own audio files",[32,54,55],{},"Organize sounds in colored tabs, groups, and search",[32,57,58],{},"Design the look with the Theme Creator",[32,60,61],{},"Record PC audio or a microphone in the Record Editor",[32,63,64],{},"Assign hotkeys to individual sounds",[32,66,67,68],{},"Trigger sounds from ",[69,70,72],"a",{"href":71},"\u002Fdocs\u002Fremote-control","Bitfocus Companion",[32,74,75],{},"Import and export a full soundboard to share with others",[32,77,78],{},"Use GIFs or images on sound buttons",[24,80,82],{"id":81},"license","License",[14,84,85,86,92],{},"SoundNinja is free software under ",[69,87,91],{"href":88,"rel":89},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fblob\u002Fmain\u002FLICENSE",[90],"nofollow","GPL-3.0",". Fork it, change it, share it.",[24,94,96],{"id":95},"next-steps","Next steps",[98,99,100,106,112],"ol",{},[32,101,102],{},[69,103,105],{"href":104},"\u002Fdocs\u002Finstallation","Install SoundNinja",[32,107,108],{},[69,109,111],{"href":110},"\u002Fdocs\u002Fadding-sounds","Add sounds",[32,113,114],{},[69,115,117],{"href":116},"\u002Fdocs\u002Forganizing-sounds","Organize your board",{"title":119,"searchDepth":120,"depth":120,"links":121},"",2,[122,123,124,125],{"id":26,"depth":120,"text":27},{"id":46,"depth":120,"text":47},{"id":81,"depth":120,"text":82},{"id":95,"depth":120,"text":96},"What SoundNinja is and what you can do with it.","md",{},true,1,"\u002Foverview",{"title":5,"description":126},"cOxJIh0ybRdZsyS1INxo9O3CTipyV8220IKpyfnYFJA",[135,211,413,562,716,851,993,1215],{"id":4,"title":5,"body":136,"description":126,"extension":127,"meta":209,"navigation":129,"order":130,"path":131,"seo":210,"stem":12,"__hash__":133},{"type":7,"value":137,"toc":203},[138,140,142,144,146,148,158,160,180,182,187,189],[10,139,5],{"id":12},[14,141,16],{},[14,143,19],{},[14,145,22],{},[24,147,27],{"id":26},[29,149,150,152,154,156],{},[32,151,34],{},[32,153,37],{},[32,155,40],{},[32,157,43],{},[24,159,47],{"id":46},[29,161,162,164,166,168,170,172,176,178],{},[32,163,52],{},[32,165,55],{},[32,167,58],{},[32,169,61],{},[32,171,64],{},[32,173,67,174],{},[69,175,72],{"href":71},[32,177,75],{},[32,179,78],{},[24,181,82],{"id":81},[14,183,85,184,92],{},[69,185,91],{"href":88,"rel":186},[90],[24,188,96],{"id":95},[98,190,191,195,199],{},[32,192,193],{},[69,194,105],{"href":104},[32,196,197],{},[69,198,111],{"href":110},[32,200,201],{},[69,202,117],{"href":116},{"title":119,"searchDepth":120,"depth":120,"links":204},[205,206,207,208],{"id":26,"depth":120,"text":27},{"id":46,"depth":120,"text":47},{"id":81,"depth":120,"text":82},{"id":95,"depth":120,"text":96},{},{"title":5,"description":126},{"id":212,"title":213,"body":214,"description":408,"extension":127,"meta":409,"navigation":129,"order":120,"path":410,"seo":411,"stem":218,"__hash__":412},"content_en\u002Finstallation.md","Installation",{"type":7,"value":215,"toc":401},[216,219,233,237,256,259,263,277,280,284,309,320,324,331,335,350,380,397],[10,217,213],{"id":218},"installation",[14,220,221,222,226,227,232],{},"Grab a build from the ",[69,223,225],{"href":224},"\u002Fdownload","Download page"," or from ",[69,228,231],{"href":229,"rel":230},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Freleases\u002Flatest",[90],"GitHub Releases",". SoundNinja is in early development, so treat builds as beta.",[24,234,236],{"id":235},"windows","Windows",[29,238,239,250,253],{},[32,240,241,245,246,249],{},[242,243,244],"strong",{},"Installer (.exe)"," or ",[242,247,248],{},"MSI (.msi)"," for 64-bit Windows",[32,251,252],{},"Landing page target: Windows 10 and newer",[32,254,255],{},"The app README also lists Windows 8 and above",[14,257,258],{},"Run the installer, then launch SoundNinja from the Start menu.",[24,260,262],{"id":261},"macos","macOS",[29,264,265,271,274],{},[32,266,267,270],{},[242,268,269],{},"Universal .dmg"," for Apple Silicon and Intel",[32,272,273],{},"Landing page target: macOS 10.14 and newer",[32,275,276],{},"The app README lists macOS 10.15 and above",[14,278,279],{},"Open the disk image and drag SoundNinja to Applications.",[24,281,283],{"id":282},"linux","Linux",[29,285,286,292,298,306],{},[32,287,288,291],{},[242,289,290],{},"Debian (.deb)"," for Ubuntu \u002F Debian",[32,293,294,297],{},[242,295,296],{},"AppImage"," for other distros",[32,299,300,301,305],{},"After a release is published, Arch users can install ",[302,303,304],"code",{},"soundninja-bin"," from the AUR",[32,307,308],{},"Tested on Ubuntu 20.04",[14,310,311,312,315,316,319],{},"Desktop builds need WebKit and GTK packages. On Debian\u002FUbuntu that usually means ",[302,313,314],{},"libwebkit2gtk",", ",[302,317,318],{},"libgtk-3-0",", and an app-indicator library.",[24,321,323],{"id":322},"updates","Updates",[14,325,326,327,330],{},"In the app, open ",[242,328,329],{},"Help → Check for Updates",". You can also let SoundNinja check on startup in Settings.",[24,332,334],{"id":333},"build-from-source","Build from source",[14,336,337,338,343,344,349],{},"Need a custom build? Clone ",[69,339,342],{"href":340,"rel":341},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja",[90],"the repo",", install ",[69,345,348],{"href":346,"rel":347},"https:\u002F\u002Fv2.tauri.app\u002Fstart\u002Fprerequisites\u002F",[90],"Tauri prerequisites",", then:",[351,352,356],"pre",{"className":353,"code":354,"language":355,"meta":119,"style":119},"language-bash shiki shiki-themes github-light github-dark","bun install\nbun run tauri:serve\n","bash",[302,357,358,370],{"__ignoreMap":119},[359,360,362,366],"span",{"class":361,"line":130},"line",[359,363,365],{"class":364},"sScJk","bun",[359,367,369],{"class":368},"sZZnC"," install\n",[359,371,372,374,377],{"class":361,"line":120},[359,373,365],{"class":364},[359,375,376],{"class":368}," run",[359,378,379],{"class":368}," tauri:serve\n",[14,381,382,315,385,388,389,392,393,396],{},[302,383,384],{},"npm",[302,386,387],{},"pnpm",", or ",[302,390,391],{},"deno"," work too. Production build: ",[302,394,395],{},"bun run tauri:build",".",[398,399,400],"style",{},"html pre.shiki code .sScJk, html code.shiki .sScJk{--shiki-default:#6F42C1;--shiki-dark:#B392F0}html pre.shiki code .sZZnC, html code.shiki .sZZnC{--shiki-default:#032F62;--shiki-dark:#9ECBFF}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html.dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}",{"title":119,"searchDepth":120,"depth":120,"links":402},[403,404,405,406,407],{"id":235,"depth":120,"text":236},{"id":261,"depth":120,"text":262},{"id":282,"depth":120,"text":283},{"id":322,"depth":120,"text":323},{"id":333,"depth":120,"text":334},"Install SoundNinja on Windows, macOS, or Linux.",{},"\u002Finstallation",{"title":213,"description":408},"i4XnnjkhxVb30IICErH1K_cBbAQ7GmnD52FYRYjh50k",{"id":414,"title":415,"body":416,"description":556,"extension":127,"meta":557,"navigation":129,"order":558,"path":559,"seo":560,"stem":420,"__hash__":561},"content_en\u002Fadding-sounds.md","Adding Sounds",{"type":7,"value":417,"toc":548},[418,421,424,428,447,451,483,487,506,510,524,527,531,538,542],[10,419,415],{"id":420},"adding-sounds",[14,422,423],{},"A board is empty until you add clips. SoundNinja can import files, whole folders, a recording, or a shared soundboard pack.",[24,425,427],{"id":426},"import-audio-files","Import audio files",[98,429,430,441,444],{},[32,431,432,433,436,437,440],{},"Open ",[242,434,435],{},"File → Import Audio Files",", or use ",[242,438,439],{},"Import"," in the navbar.",[32,442,443],{},"Pick one or more audio files.",[32,445,446],{},"Sounds land in the current tab.",[24,448,450],{"id":449},"import-folders","Import folders",[98,452,453,463,466],{},[32,454,432,455,458,459,462],{},[242,456,457],{},"File → Import Folders"," (or ",[242,460,461],{},"Import Folders"," in the navbar).",[32,464,465],{},"Add one or more folders. Drag to reorder them before you import.",[32,467,468,469],{},"Choose how they land:\n",[29,470,471,477],{},[32,472,473,476],{},[242,474,475],{},"Import as Tabs"," — each folder becomes its own tab",[32,478,479,482],{},[242,480,481],{},"Import to current Tab"," — every file goes into the active tab",[24,484,486],{"id":485},"record-a-clip","Record a clip",[14,488,489,490,494,495,498,499,245,502,505],{},"Open the ",[69,491,493],{"href":492},"\u002Fdocs\u002Frecording-editor","Record Editor"," from the ",[242,496,497],{},"Record"," button in the player bar. Capture, trim, then ",[242,500,501],{},"Import selected",[242,503,504],{},"Import all"," into the current tab or a tab you pick.",[24,507,509],{"id":508},"import-a-soundboard","Import a soundboard",[14,511,512,515,516,519,520,523],{},[242,513,514],{},"File → Import Soundboard"," loads a shared pack. Packs are a ",[302,517,518],{},".zip"," that contains ",[302,521,522],{},"project.sninja"," plus the sound files. After import, open the project and play.",[14,525,526],{},"You can also keep several projects (profiles). Use the project selector to switch boards.",[24,528,530],{"id":529},"relink-missing-files","Relink missing files",[14,532,533,534,537],{},"If audio files move on disk, SoundNinja shows a ",[242,535,536],{},"Missing sound files"," dialog. Pick a folder to search and relink the clips.",[24,539,541],{"id":540},"next","Next",[14,543,544,545,396],{},"Organize tabs, groups, and hotkeys in ",[69,546,547],{"href":116},"Organizing Sounds",{"title":119,"searchDepth":120,"depth":120,"links":549},[550,551,552,553,554,555],{"id":426,"depth":120,"text":427},{"id":449,"depth":120,"text":450},{"id":485,"depth":120,"text":486},{"id":508,"depth":120,"text":509},{"id":529,"depth":120,"text":530},{"id":540,"depth":120,"text":541},"Import audio, folders, recordings, and shared soundboards.",{},3,"\u002Fadding-sounds",{"title":415,"description":556},"qcK88xpbquf2dRogb67sx4O0tzuIof13-X3Yyn9680o",{"id":563,"title":547,"body":564,"description":710,"extension":127,"meta":711,"navigation":129,"order":712,"path":713,"seo":714,"stem":568,"__hash__":715},"content_en\u002Forganizing-sounds.md",{"type":7,"value":565,"toc":701},[566,569,572,576,603,610,614,617,631,638,642,648,652,663,667,670,674,677,683,689,693],[10,567,547],{"id":568},"organizing-sounds",[14,570,571],{},"SoundNinja is built for large libraries. Use tabs, groups, search, and hotkeys so the clip you need is one click (or one key) away.",[24,573,575],{"id":574},"tabs","Tabs",[29,577,578,585,592],{},[32,579,580,581,584],{},"Add a tab with ",[242,582,583],{},"Add tab",". Give it a color so you can scan the bar fast.",[32,586,587,588,591],{},"The ",[242,589,590],{},"All"," view shows every sound across tabs.",[32,593,594,595,598,599,602],{},"A sound can belong to ",[242,596,597],{},"one or more tabs",". Right-click a sound and use ",[242,600,601],{},"Move to tab"," to assign it.",[14,604,605,606,609],{},"Tab transitions live in ",[242,607,608],{},"Settings → Main",": Slide, Fade, Buttons one by one, or None.",[24,611,613],{"id":612},"groups","Groups",[14,615,616],{},"Since v0.5.3, separators can become named groups:",[29,618,619,622,625,628],{},[32,620,621],{},"Add, rename, or remove a group from the context menu",[32,623,624],{},"Drag the group header — children move with it",[32,626,627],{},"Drop sounds in or out of a group",[32,629,630],{},"Set group border color, name color, and button alignment (or use the tab default)",[14,632,633,634,637],{},"You can still add a plain ",[242,635,636],{},"Separator"," if you only need a visual break.",[24,639,641],{"id":640},"search","Search",[14,643,644,645,647],{},"Use the ",[242,646,641],{}," field in the navbar. Results update as you type.",[24,649,651],{"id":650},"reorder","Reorder",[14,653,654,655,658,659,662],{},"Turn on drag-and-drop in ",[242,656,657],{},"Settings → Behavior"," (",[242,660,661],{},"Allow reorder","). Then drag sounds and groups into place.",[24,664,666],{"id":665},"bulk-edit","Bulk edit",[14,668,669],{},"Multi-select sounds, then change color, move them to a tab, or delete them in one step.",[24,671,673],{"id":672},"hotkeys-and-sound-ids","Hotkeys and sound IDs",[14,675,676],{},"Every sound has an 8-character ID. Copy it from the button context menu or the multi-select ID chip.",[14,678,432,679,682],{},[242,680,681],{},"Settings → Hotkeys"," to bind a key to a sound ID. Global hotkeys are optional.",[14,684,685,686,688],{},"The same ID is what ",[69,687,72],{"href":71}," uses to trigger a clip.",[24,690,692],{"id":691},"gifs-and-colors","GIFs and colors",[14,694,695,696,700],{},"Right-click a sound to set per-button colors or a GIF \u002F image background. That is separate from the ",[69,697,699],{"href":698},"\u002Fdocs\u002Ftheme-editor","Theme Creator",", which styles the whole board.",{"title":119,"searchDepth":120,"depth":120,"links":702},[703,704,705,706,707,708,709],{"id":574,"depth":120,"text":575},{"id":612,"depth":120,"text":613},{"id":640,"depth":120,"text":641},{"id":650,"depth":120,"text":651},{"id":665,"depth":120,"text":666},{"id":672,"depth":120,"text":673},{"id":691,"depth":120,"text":692},"Tabs, groups, search, bulk edit, and hotkeys.",{},4,"\u002Forganizing-sounds",{"title":547,"description":710},"Q4gLPzceZdOi3j6gqMTmPuTzf4qua7p2dfLn2shjKT4",{"id":717,"title":718,"body":719,"description":845,"extension":127,"meta":846,"navigation":129,"order":847,"path":848,"seo":849,"stem":723,"__hash__":850},"content_en\u002Ftheme-editor.md","Theme Editor",{"type":7,"value":720,"toc":839},[721,724,730,734,761,764,768,782,786,812,815,819,825],[10,722,718],{"id":723},"theme-editor",[14,725,726,727,396],{},"The Theme Creator is the full visual editor for your board. Open it from ",[242,728,729],{},"Settings → Main → Theme Creator",[24,731,733],{"id":732},"three-tabs","Three tabs",[98,735,736,750,756],{},[32,737,738,741,742,745,746,749],{},[242,739,740],{},"General"," — theme name, shared colors, and font uploads (",[302,743,744],{},".ttf"," \u002F ",[302,747,748],{},".otf",")",[32,751,752,755],{},[242,753,754],{},"Buttons"," — sound button colors, type, layout, and GIF overlay",[32,757,758,760],{},[242,759,575],{}," — tab bar colors, type, and border thickness",[14,762,763],{},"A live preview shows tabs and buttons as you edit.",[24,765,767],{"id":766},"what-you-can-change","What you can change",[29,769,770,773,776,779],{},[32,771,772],{},"Primary and accent colors, backgrounds, button colors, tab colors",[32,774,775],{},"Button and tab font family and size",[32,777,778],{},"Button width, radius, border width, gaps, and padding",[32,780,781],{},"GIF overlay opacity (normal and hover)",[24,783,785],{"id":784},"save-and-share","Save and share",[29,787,788,794,800,806],{},[32,789,790,793],{},[242,791,792],{},"Export .css"," — write a theme file you can back up or send to a friend",[32,795,796,799],{},[242,797,798],{},"Add to Themes"," — save the file into your Themes folder and apply it",[32,801,802,805],{},[242,803,804],{},"Import .css"," — load a built-in preset or a saved theme",[32,807,808,811],{},[242,809,810],{},"Reset"," — return to SoundNinja defaults",[14,813,814],{},"If you close the window with unsaved changes, SoundNinja asks you to save first.",[24,816,818],{"id":817},"without-the-full-editor","Without the full editor",[14,820,821,822,824],{},"In ",[242,823,608],{}," you can still:",[29,826,827,830,836],{},[32,828,829],{},"Pick a theme from the list",[32,831,832,833,749],{},"Edit CSS variables live (",[242,834,835],{},"Custom CSS",[32,837,838],{},"Import a theme file into the Themes folder",{"title":119,"searchDepth":120,"depth":120,"links":840},[841,842,843,844],{"id":732,"depth":120,"text":733},{"id":766,"depth":120,"text":767},{"id":784,"depth":120,"text":785},{"id":817,"depth":120,"text":818},"Design colors, fonts, buttons, and tabs in the Theme Creator.",{},5,"\u002Ftheme-editor",{"title":718,"description":845},"zpMjxENa49aUipEX7TBxcqrbaZNweyJ019KsLAMJeoc",{"id":852,"title":853,"body":854,"description":987,"extension":127,"meta":988,"navigation":129,"order":989,"path":990,"seo":991,"stem":858,"__hash__":992},"content_en\u002Frecording-editor.md","Recording Editor",{"type":7,"value":855,"toc":981},[856,859,865,869,875,895,898,902,927,931,946,950,964,971],[10,857,853],{"id":858},"recording-editor",[14,860,861,862,864],{},"Record a clip inside SoundNinja, trim it, then import it onto a tab. Open the editor with the ",[242,863,497],{}," button in the player bar.",[24,866,868],{"id":867},"choose-an-input","Choose an input",[14,870,821,871,874],{},[242,872,873],{},"Settings → Audio",":",[29,876,877,883,889],{},[32,878,879,882],{},[242,880,881],{},"Input Devices"," — microphone",[32,884,885,888],{},[242,886,887],{},"Output Devices (PC Audio)"," — loopback of what your PC is playing",[32,890,891,894],{},[242,892,893],{},"Input volume"," — capture gain from 0% to 200%",[14,896,897],{},"The Record button uses the device you pick here.",[24,899,901],{"id":900},"edit-the-take","Edit the take",[29,903,904,907,910,918,921,924],{},[32,905,906],{},"Record and stop",[32,908,909],{},"Watch the input level meter",[32,911,912,245,915],{},[242,913,914],{},"Normalize",[242,916,917],{},"Noise Cancelation",[32,919,920],{},"Trim the whole clip, trim to a selection, or delete a selection",[32,922,923],{},"Undo \u002F redo",[32,925,926],{},"Zoom in and out",[24,928,930],{"id":929},"stage-and-import","Stage and import",[98,932,933,936,939],{},[32,934,935],{},"Add the selection or the full track to the staging list.",[32,937,938],{},"The list starts empty: record, edit, then add a clip.",[32,940,941,245,943,945],{},[242,942,501],{},[242,944,504],{}," into the current tab or a tab you choose.",[24,947,949],{"id":948},"stem-separation-optional","Stem separation (optional)",[14,951,952,953,245,956,959,960,963],{},"The Record Editor can keep ",[242,954,955],{},"vocals",[242,957,958],{},"music"," using BS-RoFormer. The model is about 158 MB and is ",[242,961,962],{},"not"," bundled with the app.",[14,965,966,967,970],{},"Download it from ",[242,968,969],{},"Settings → Stem Separation",", or accept the first-run prompt. The Windows installer can also offer to download the model on first launch.",[14,972,973,974,745,977,980],{},"Stem builds from source need an extra flag (",[302,975,976],{},"tauri:serve:stems",[302,978,979],{},"tauri:build:stems",").",{"title":119,"searchDepth":120,"depth":120,"links":982},[983,984,985,986],{"id":867,"depth":120,"text":868},{"id":900,"depth":120,"text":901},{"id":929,"depth":120,"text":930},{"id":948,"depth":120,"text":949},"Capture mic or PC audio, edit the clip, and drop it on your board.",{},6,"\u002Frecording-editor",{"title":853,"description":987},"MJVcc7XyjWmtAdA8N6FQhHNz88XkH8JRCYOy28MJ364",{"id":994,"title":995,"body":996,"description":1209,"extension":127,"meta":1210,"navigation":129,"order":1211,"path":1212,"seo":1213,"stem":1000,"__hash__":1214},"content_en\u002Fremote-control.md","Remote Control",{"type":7,"value":997,"toc":1202},[998,1001,1004,1008,1037,1040,1043,1078,1082,1102,1105,1109,1141,1145,1151],[10,999,995],{"id":1000},"remote-control",[14,1002,1003],{},"SoundNinja can listen on your local network so Bitfocus Companion (or any HTTP\u002FWebSocket client) can play and stop sounds.",[24,1005,1007],{"id":1006},"enable-the-remote-server","Enable the remote server",[98,1009,1010,1015,1021,1027],{},[32,1011,432,1012,396],{},[242,1013,1014],{},"Settings → Remote",[32,1016,1017,1018,396],{},"Enable the remote server. Default port is ",[242,1019,1020],{},"7331",[32,1022,1023,1024,396],{},"Optional: set a token. Clients must send it as a Bearer token or ",[302,1025,1026],{},"?token=",[32,1028,1029,1030,1033,1034,396],{},"Copy the ",[302,1031,1032],{},"http:\u002F\u002FIP:PORT"," URL, or copy the system IP from ",[242,1035,1036],{},"Settings → About",[14,1038,1039],{},"Windows may show a firewall prompt the first time the server starts. Allow private-network access.",[24,10