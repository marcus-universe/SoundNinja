[{"data":1,"prerenderedAt":1584},["ShallowReactive",2],{"docs-page-en-\u002Foverview":3,"docs-nav-en":143},{"id":4,"title":5,"body":6,"description":135,"extension":136,"meta":137,"navigation":138,"order":139,"path":140,"seo":141,"stem":12,"__hash__":142},"content_en\u002Foverview.md","Overview",{"type":7,"value":8,"toc":127},"minimark",[9,13,17,20,23,28,44,48,88,92,102,106],[10,11,5],"h1",{"id":12},"overview",[14,15,16],"p",{},"SoundNinja is an open-source soundboard for live streaming, chatting with friends, and podcast recording. It is built with Tauri v2 and Nuxt 4 so it stays light on RAM and disk.",[14,18,19],{},"The goal is simple: keep a huge sound library easy to scan, then play the right clip in milliseconds. The UI also works well as a dashboard in VR.",[14,21,22],{},"SoundNinja is still in early development. Features work, but not every platform is fully tested.",[24,25,27],"h2",{"id":26},"who-it-is-for","Who it is for",[29,30,31,35,38,41],"ul",{},[32,33,34],"li",{},"Streamers who need instant sound cues",[32,36,37],{},"Friends who want a shared board for voice chat",[32,39,40],{},"Podcasters who record clips and drop them onto a board",[32,42,43],{},"Anyone who wants a customizable, local-first soundboard",[24,45,47],{"id":46},"what-you-can-do","What you can do",[29,49,50,53,56,59,62,65,68,71,74,82,85],{},[32,51,52],{},"Build a soundboard from your own audio files",[32,54,55],{},"Organize sounds in colored tabs, groups, tags, and search",[32,57,58],{},"Filter by tags (OR) and sort by name, date, duration, or size",[32,60,61],{},"Multi-select with marquee or Shift-range, then bulk color, move, or delete",[32,63,64],{},"Set per-sound volume from the context menu",[32,66,67],{},"Design the look with the Theme Creator",[32,69,70],{},"Record PC audio or a microphone in the Record Editor",[32,72,73],{},"Assign hotkeys to individual sounds",[32,75,76,77],{},"Trigger sounds from ",[78,79,81],"a",{"href":80},"\u002Fdocs\u002Fremote-control","Bitfocus Companion",[32,83,84],{},"Import and export a full soundboard to share with others",[32,86,87],{},"Use GIFs or images on sound buttons — from a local folder library or KLIPY",[24,89,91],{"id":90},"license","License",[14,93,94,95,101],{},"SoundNinja is free software under ",[78,96,100],{"href":97,"rel":98},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fblob\u002Fmain\u002FLICENSE",[99],"nofollow","GPL-3.0",". Fork it, change it, share it.",[24,103,105],{"id":104},"next-steps","Next steps",[107,108,109,115,121],"ol",{},[32,110,111],{},[78,112,114],{"href":113},"\u002Fdocs\u002Finstallation","Install SoundNinja",[32,116,117],{},[78,118,120],{"href":119},"\u002Fdocs\u002Fadding-sounds","Add sounds",[32,122,123],{},[78,124,126],{"href":125},"\u002Fdocs\u002Forganizing-sounds","Organize your board",{"title":128,"searchDepth":129,"depth":129,"links":130},"",2,[131,132,133,134],{"id":26,"depth":129,"text":27},{"id":46,"depth":129,"text":47},{"id":90,"depth":129,"text":91},{"id":104,"depth":129,"text":105},"What SoundNinja is and what you can do with it.","md",{},true,1,"\u002Foverview",{"title":5,"description":135},"Dax9ydiOOeEz5F1IxWfEljWZynntK7dPp52JZ3q2G58",[144,226,431,580,983,1118,1264,1486],{"id":4,"title":5,"body":145,"description":135,"extension":136,"meta":224,"navigation":138,"order":139,"path":140,"seo":225,"stem":12,"__hash__":142},{"type":7,"value":146,"toc":218},[147,149,151,153,155,157,167,169,195,197,202,204],[10,148,5],{"id":12},[14,150,16],{},[14,152,19],{},[14,154,22],{},[24,156,27],{"id":26},[29,158,159,161,163,165],{},[32,160,34],{},[32,162,37],{},[32,164,40],{},[32,166,43],{},[24,168,47],{"id":46},[29,170,171,173,175,177,179,181,183,185,187,191,193],{},[32,172,52],{},[32,174,55],{},[32,176,58],{},[32,178,61],{},[32,180,64],{},[32,182,67],{},[32,184,70],{},[32,186,73],{},[32,188,76,189],{},[78,190,81],{"href":80},[32,192,84],{},[32,194,87],{},[24,196,91],{"id":90},[14,198,94,199,101],{},[78,200,100],{"href":97,"rel":201},[99],[24,203,105],{"id":104},[107,205,206,210,214],{},[32,207,208],{},[78,209,114],{"href":113},[32,211,212],{},[78,213,120],{"href":119},[32,215,216],{},[78,217,126],{"href":125},{"title":128,"searchDepth":129,"depth":129,"links":219},[220,221,222,223],{"id":26,"depth":129,"text":27},{"id":46,"depth":129,"text":47},{"id":90,"depth":129,"text":91},{"id":104,"depth":129,"text":105},{},{"title":5,"description":135},{"id":227,"title":228,"body":229,"description":426,"extension":136,"meta":427,"navigation":138,"order":129,"path":428,"seo":429,"stem":233,"__hash__":430},"content_en\u002Finstallation.md","Installation",{"type":7,"value":230,"toc":419},[231,234,248,252,274,277,281,295,298,302,327,338,342,349,353,368,398,415],[10,232,228],{"id":233},"installation",[14,235,236,237,241,242,247],{},"Grab a build from the ",[78,238,240],{"href":239},"\u002Fdownload","Download page"," or from ",[78,243,246],{"href":244,"rel":245},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Freleases\u002Flatest",[99],"GitHub Releases",". SoundNinja is in early development, so treat builds as beta.",[24,249,251],{"id":250},"windows","Windows",[29,253,254,265,268,271],{},[32,255,256,260,261,264],{},[257,258,259],"strong",{},"Installer (.exe)"," or ",[257,262,263],{},"MSI (.msi)"," for 64-bit Windows",[32,266,267],{},"Landing page target: Windows 10 and newer",[32,269,270],{},"The app README also lists Windows 8 and above",[32,272,273],{},"The NSIS installer uses a dark theme. Pick a language during setup — SoundNinja remembers it on the next launch.",[14,275,276],{},"Run the installer, then launch SoundNinja from the Start menu.",[24,278,280],{"id":279},"macos","macOS",[29,282,283,289,292],{},[32,284,285,288],{},[257,286,287],{},"Universal .dmg"," for Apple Silicon and Intel",[32,290,291],{},"Landing page target: macOS 10.14 and newer",[32,293,294],{},"The app README lists macOS 10.15 and above",[14,296,297],{},"Open the disk image and drag SoundNinja to Applications.",[24,299,301],{"id":300},"linux","Linux",[29,303,304,310,316,324],{},[32,305,306,309],{},[257,307,308],{},"Debian (.deb)"," for Ubuntu \u002F Debian",[32,311,312,315],{},[257,313,314],{},"AppImage"," for other distros",[32,317,318,319,323],{},"After a release is published, Arch users can install ",[320,321,322],"code",{},"soundninja-bin"," from the AUR",[32,325,326],{},"Tested on Ubuntu 20.04",[14,328,329,330,333,334,337],{},"Desktop builds need WebKit and GTK packages. On Debian\u002FUbuntu that usually means ",[320,331,332],{},"libwebkit2gtk",", ",[320,335,336],{},"libgtk-3-0",", and an app-indicator library.",[24,339,341],{"id":340},"updates","Updates",[14,343,344,345,348],{},"In the app, open ",[257,346,347],{},"Help → Check for Updates",". You can also let SoundNinja check on startup in Settings.",[24,350,352],{"id":351},"build-from-source","Build from source",[14,354,355,356,361,362,367],{},"Need a custom build? Clone ",[78,357,360],{"href":358,"rel":359},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja",[99],"the repo",", install ",[78,363,366],{"href":364,"rel":365},"https:\u002F\u002Fv2.tauri.app\u002Fstart\u002Fprerequisites\u002F",[99],"Tauri prerequisites",", then:",[369,370,374],"pre",{"className":371,"code":372,"language":373,"meta":128,"style":128},"language-bash shiki shiki-themes github-light github-dark","bun install\nbun run tauri:serve\n","bash",[320,375,376,388],{"__ignoreMap":128},[377,378,380,384],"span",{"class":379,"line":139},"line",[377,381,383],{"class":382},"sScJk","bun",[377,385,387],{"class":386},"sZZnC"," install\n",[377,389,390,392,395],{"class":379,"line":129},[377,391,383],{"class":382},[377,393,394],{"class":386}," run",[377,396,397],{"class":386}," tauri:serve\n",[14,399,400,333,403,406,407,410,411,414],{},[320,401,402],{},"npm",[320,404,405],{},"pnpm",", or ",[320,408,409],{},"deno"," work too. Production build: ",[320,412,413],{},"bun run tauri:build",".",[416,417,418],"style",{},"html pre.shiki code .sScJk, html code.shiki .sScJk{--shiki-default:#6F42C1;--shiki-dark:#B392F0}html pre.shiki code .sZZnC, html code.shiki .sZZnC{--shiki-default:#032F62;--shiki-dark:#9ECBFF}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html.dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}",{"title":128,"searchDepth":129,"depth":129,"links":420},[421,422,423,424,425],{"id":250,"depth":129,"text":251},{"id":279,"depth":129,"text":280},{"id":300,"depth":129,"text":301},{"id":340,"depth":129,"text":341},{"id":351,"depth":129,"text":352},"Install SoundNinja on Windows, macOS, or Linux.",{},"\u002Finstallation",{"title":228,"description":426},"7viacDB8R6wsHmYhw6wWPv9XZF7nR_yMjR5-EjD4OjQ",{"id":432,"title":433,"body":434,"description":574,"extension":136,"meta":575,"navigation":138,"order":576,"path":577,"seo":578,"stem":438,"__hash__":579},"content_en\u002Fadding-sounds.md","Adding Sounds",{"type":7,"value":435,"toc":566},[436,439,442,446,465,469,501,505,524,528,542,545,549,556,560],[10,437,433],{"id":438},"adding-sounds",[14,440,441],{},"A board is empty until you add clips. SoundNinja can import files, whole folders, a recording, or a shared soundboard pack.",[24,443,445],{"id":444},"import-audio-files","Import audio files",[107,447,448,459,462],{},[32,449,450,451,454,455,458],{},"Open ",[257,452,453],{},"File → Import Audio Files",", or use ",[257,456,457],{},"Import"," in the navbar.",[32,460,461],{},"Pick one or more audio files.",[32,463,464],{},"Sounds land in the current tab.",[24,466,468],{"id":467},"import-folders","Import folders",[107,470,471,481,484],{},[32,472,450,473,476,477,480],{},[257,474,475],{},"File → Import Folders"," (or ",[257,478,479],{},"Import Folders"," in the navbar).",[32,482,483],{},"Add one or more folders. Drag to reorder them before you import.",[32,485,486,487],{},"Choose how they land:\n",[29,488,489,495],{},[32,490,491,494],{},[257,492,493],{},"Import as Tabs"," — each folder becomes its own tab",[32,496,497,500],{},[257,498,499],{},"Import to current Tab"," — every file goes into the active tab",[24,502,504],{"id":503},"record-a-clip","Record a clip",[14,506,507,508,512,513,516,517,260,520,523],{},"Open the ",[78,509,511],{"href":510},"\u002Fdocs\u002Frecording-editor","Record Editor"," from the ",[257,514,515],{},"Record"," button in the player bar. Capture, trim, then ",[257,518,519],{},"Import selected",[257,521,522],{},"Import all"," into the current tab or a tab you pick.",[24,525,527],{"id":526},"import-a-soundboard","Import a soundboard",[14,529,530,533,534,537,538,541],{},[257,531,532],{},"File → Import Soundboard"," loads a shared pack. Packs are a ",[320,535,536],{},".zip"," that contains ",[320,539,540],{},"project.sninja"," plus the sound files. After import, open the project and play.",[14,543,544],{},"You can also keep several projects (profiles). Use the project selector to switch boards.",[24,546,548],{"id":547},"relink-missing-files","Relink missing files",[14,550,551,552,555],{},"If audio files move on disk, SoundNinja shows a ",[257,553,554],{},"Missing sound files"," dialog. Pick a folder to search and relink the clips.",[24,557,559],{"id":558},"next","Next",[14,561,562,563,414],{},"Organize tabs, tags, filters, and hotkeys in ",[78,564,565],{"href":125},"Organizing Sounds",{"title":128,"searchDepth":129,"depth":129,"links":567},[568,569,570,571,572,573],{"id":444,"depth":129,"text":445},{"id":467,"depth":129,"text":468},{"id":503,"depth":129,"text":504},{"id":526,"depth":129,"text":527},{"id":547,"depth":129,"text":548},{"id":558,"depth":129,"text":559},"Import audio, folders, recordings, and shared soundboards.",{},3,"\u002Fadding-sounds",{"title":433,"description":574},"SBUvL_H4633CrDyNUKazqKwru4aq1hhgoH4_o99rBsE",{"id":581,"title":565,"body":582,"description":977,"extension":136,"meta":978,"navigation":138,"order":979,"path":980,"seo":981,"stem":586,"__hash__":982},"content_en\u002Forganizing-sounds.md",{"type":7,"value":583,"toc":962},[584,587,594,598,625,632,636,639,653,660,666,670,680,685,717,721,727,731,764,770,774,777,804,807,811,825,829,835,856,872,879,883,893,896,900,907,917,923,927,935,942,959],[10,585,565],{"id":586},"organizing-sounds",[14,588,589,590,593],{},"SoundNinja is built for large libraries. Use ",[257,591,592],{},"tags and filters",", tabs, search, multi-select, and hotkeys so the clip you need is one click (or one key) away.",[24,595,597],{"id":596},"tabs","Tabs",[29,599,600,607,614],{},[32,601,602,603,606],{},"Add a tab with ",[257,604,605],{},"Add tab",". Give it a color so you can scan the bar fast.",[32,608,609,610,613],{},"The ",[257,611,612],{},"All"," view shows every sound across tabs.",[32,615,616,617,620,621,624],{},"A sound can belong to ",[257,618,619],{},"one or more tabs",". Right-click a sound and use ",[257,622,623],{},"Move to tab"," to assign it.",[14,626,627,628,631],{},"Tab transitions live in ",[257,629,630],{},"Settings → Main",": Slide, Fade, Buttons one by one, or None.",[24,633,635],{"id":634},"groups","Groups",[14,637,638],{},"Since v0.5.3, separators can become named groups:",[29,640,641,644,647,650],{},[32,642,643],{},"Add, rename, or remove a group from the context menu",[32,645,646],{},"Drag the group header — children move with it",[32,648,649],{},"Drop sounds in or out of a group",[32,651,652],{},"Set group border color, name color, and button alignment (or use the tab default)",[14,654,655,656,659],{},"You can still add a plain ",[257,657,658],{},"Separator"," if you only need a visual break.",[14,661,662,663,414],{},"Right-click empty board space to ",[257,664,665],{},"Add Group",[24,667,669],{"id":668},"tags-filters","Tags \u002F Filters",[14,671,672,673,676,677,679],{},"Tags cut across tabs. The slide-out ",[257,674,675],{},"Filter"," panel (sidebar ",[257,678,675],{},") is where you create them and turn them into a board filter.",[681,682,684],"h3",{"id":683},"create-and-edit-tags","Create and edit tags",[107,686,687,692,703,710],{},[32,688,450,689,691],{},[257,690,675],{}," in the sidebar.",[32,693,694,695,698,699,702],{},"Under ",[257,696,697],{},"Tags",", use ",[257,700,701],{},"Add tag"," — give it a name and a color.",[32,704,705,706,709],{},"Rename, recolor, or ",[257,707,708],{},"Delete tag"," from the same list.",[32,711,712,713,716],{},"If you see ",[257,714,715],{},"No tags yet",", add one here before you assign anything.",[681,718,720],{"id":719},"assign-tags-to-sounds","Assign tags to sounds",[14,722,723,724,726],{},"Right-click a sound → ",[257,725,697],{}," (checkboxes). A sound can have several tags. If none exist yet, the menu tells you to open the filter panel.",[681,728,730],{"id":729},"filter-the-board","Filter the board",[29,732,733,739,750,761],{},[32,734,735,736,414],{},"Toggle tags in the Filter panel, or as ",[257,737,738],{},"chips under the search bar",[32,740,741,742,745,746,749],{},"Matching is ",[257,743,744],{},"OR",": a sound stays visible if it has ",[257,747,748],{},"any"," selected tag.",[32,751,752,753,756,757,760],{},"The navbar ",[257,754,755],{},"Search"," field ",[257,758,759],{},"ANDs"," with the active tag filter (type + tags together).",[32,762,763],{},"Turn chips off (or clear the filter) to show the full tab again.",[14,765,766,767,414],{},"Colored tag names can appear on buttons. Toggle them in ",[257,768,769],{},"Settings → Behavior → Show tag badges",[24,771,773],{"id":772},"sort","Sort",[14,775,776],{},"Open the filter panel and pick a sort mode:",[29,778,779,785],{},[32,780,781,784],{},[257,782,783],{},"User defined"," — your tab order, with groups visible",[32,786,787,333,790,333,793,406,796,799,800,803],{},[257,788,789],{},"Name",[257,791,792],{},"Added time",[257,794,795],{},"Play time",[257,797,798],{},"File size"," — a flat sorted list; ",[257,801,802],{},"groups are hidden"," in these modes",[14,805,806],{},"Duration sort may warm duration metadata the first time you use it.",[24,808,810],{"id":809},"reorder","Reorder",[14,812,813,814,817,818,821,822,824],{},"Turn on drag-and-drop in ",[257,815,816],{},"Settings → Behavior"," (",[257,819,820],{},"Allow reorder","). Then drag sounds and groups into place. Reorder applies in ",[257,823,783],{}," sort.",[24,826,828],{"id":827},"multi-select","Multi-select",[14,830,831,832,834],{},"Turn on ",[257,833,828],{}," in the navbar, then:",[29,836,837,840,846,853],{},[32,838,839],{},"Click a sound to toggle it",[32,841,842,845],{},[257,843,844],{},"Shift+click"," to select a range from the last anchor",[32,847,848,849,852],{},"Drag a ",[257,850,851],{},"marquee"," on empty board space",[32,854,855],{},"Click empty board (or outside) to clear the selection",[14,857,858,859,333,862,333,865,868,869,414],{},"A bulk bar appears with the count, plus ",[257,860,861],{},"Color",[257,863,864],{},"Move to tab…",[257,866,867],{},"Delete",", and ",[257,870,871],{},"Done",[14,873,874,875,878],{},"In multi-select, each button shows an ",[257,876,877],{},"8-character ID chip",". Right-click the chip to copy it.",[24,880,882],{"id":881},"per-sound-volume","Per-sound volume",[14,884,723,885,888,889,892],{},[257,886,887],{},"Volume",". Drag the slider from 0% to 100%. ",[257,890,891],{},"Double-click"," the slider to reset to 100%.",[14,894,895],{},"This stacks with the master output volume in Settings.",[24,897,899],{"id":898},"hotkeys-and-sound-ids","Hotkeys and sound IDs",[14,901,902,903,906],{},"Every sound has an 8-character ID. Copy it from the button context menu (",[257,904,905],{},"Copy ID",") or the multi-select ID chip.",[14,908,450,909,912,913,916],{},[257,910,911],{},"Settings → Hotkeys"," to bind a key to a sound ID. Global hotkeys are optional. ",[257,914,915],{},"Assign hotkey"," on the context menu jumps there with the ID prefilled.",[14,918,919,920,922],{},"The same ID is what ",[78,921,81],{"href":80}," uses to trigger a clip.",[24,924,926],{"id":925},"background-images-and-colors","Background images and colors",[14,928,929,930,934],{},"Right-click a sound to set per-button colors or a background image. That is separate from the ",[78,931,933],{"href":932},"\u002Fdocs\u002Ftheme-editor","Theme Creator",", which styles the whole board.",[14,936,937,938,941],{},"The picker is a ",[257,939,940],{},"Background image"," dialog (PNG, JPEG, GIF, WebP):",[29,943,944,950],{},[32,945,946,949],{},[257,947,948],{},"Local files"," — add folders, pick a single file, search filenames, preview the grid, or remove a folder from the library",[32,951,952,955,956,958],{},[257,953,954],{},"KLIPY"," — search online GIFs. Set your own API key in ",[257,957,816],{},". The key is not stored in project files.",[14,960,961],{},"After you pick an image, pan and crop it on the button.",{"title":128,"searchDepth":129,"depth":129,"links":963},[964,965,966,971,972,973,974,975,976],{"id":596,"depth":129,"text":597},{"id":634,"depth":129,"text":635},{"id":668,"depth":129,"text":669,"children":967},[968,969,970],{"id":683,"depth":576,"text":684},{"id":719,"depth":576,"text":720},{"id":729,"depth":576,"text":730},{"id":772,"depth":129,"text":773},{"id":809,"depth":129,"text":810},{"id":827,"depth":129,"text":828},{"id":881,"depth":129,"text":882},{"id":898,"depth":129,"text":899},{"id":925,"depth":129,"text":926},"Tags, filters, tabs, groups, sort, multi-select, volume, and hotkeys.",{},4,"\u002Forganizing-sounds",{"title":565,"description":977},"DaYqySVuX1kgdTnJw6h1GP_lGyj4zdFP2uKKbBEbVwQ",{"id":984,"title":985,"body":986,"description":1112,"extension":136,"meta":1113,"navigation":138,"order":1114,"path":1115,"seo":1116,"stem":990,"__hash__":1117},"content_en\u002Ftheme-editor.md","Theme Editor",{"type":7,"value":987,"toc":1106},[988,991,997,1001,1028,1031,1035,1049,1053,1079,1082,1086,1092],[10,989,985],{"id":990},"theme-editor",[14,992,993,994,414],{},"The Theme Creator is the full visual editor for your board. Open it from ",[257,995,996],{},"Settings → Main → Theme Creator",[24,998,1000],{"id":999},"three-tabs","Three tabs",[107,1002,1003,1017,1023],{},[32,1004,1005,1008,1009,1012,1013,1016],{},[257,1006,1007],{},"General"," — theme name, shared colors, and font uploads (",[320,1010,1011],{},".ttf"," \u002F ",[320,1014,1015],{},".otf",")",[32,1018,1019,1022],{},[257,1020,1021],{},"Buttons"," — sound button colors, type, layout, and GIF overlay",[32,1024,1025,1027],{},[257,1026,597],{}," — tab bar colors, type, and border thickness",[14,1029,1030],{},"A live preview shows tabs and buttons as you edit.",[24,1032,1034],{"id":1033},"what-you-can-change","What you can change",[29,1036,1037,1040,1043,1046],{},[32,1038,1039],{},"Primary and accent colors, backgrounds, button colors, tab colors",[32,1041,1042],{},"Button and tab font family and size",[32,1044,1045],{},"Button width, radius, border width, gaps, and padding",[32,1047,1048],{},"GIF overlay opacity (normal and hover)",[24,1050,1052],{"id":1051},"save-and-share","Save and share",[29,1054,1055,1061,1067,1073],{},[32,1056,1057,1060],{},[257,1058,1059],{},"Export .css"," — write a theme file you can back up or send to a friend",[32,1062,1063,1066],{},[257,1064,1065],{},"Add to Themes"," — save the file into your Themes folder and apply it",[32,1068,1069,1072],{},[257,1070,1071],{},"Import .css"," — load a built-in preset or a saved theme",[32,1074,1075,1078],{},[257,1076,1077],{},"Reset"," — return to SoundNinja defaults",[14,1080,1081],{},"If you close the window with unsaved changes, SoundNinja asks you to save first.",[24,1083,1085],{"id":1084},"without-the-full-editor","Without the full editor",[14,1087,1088,1089,1091],{},"In ",[257,1090,630],{}," you can still:",[29,1093,1094,1097,1103],{},[32,1095,1096],{},"Pick a theme from the list",[32,1098,1099,1100,1016],{},"Edit CSS variables live (",[257,1101,1102],{},"Custom CSS",[32,1104,1105],{},"Import a theme file into the Themes folder",{"title":128,"searchDepth":129,"depth":129,"links":1107},[1108,1109,1110,1111],{"id":999,"depth":129,"text":1000},{"id":1033,"depth":129,"text":1034},{"id":1051,"depth":129,"text":1052},{"id":1084,"depth":129,"text":1085},"Design colors, fonts, buttons, and tabs in the Theme Creator.",{},5,"\u002Ftheme-editor",{"title":985,"description":1112},"zpMjxENa49aUipEX7TBxcqrbaZNweyJ019KsLAMJeoc",{"id":1119,"title":1120,"body":1121,"description":1258,"extension":136,"meta":1259,"navigation":138,"order":1260,"path":1261,"seo":1262,"stem":1125,"__hash__":1263},"content_en\u002Frecording-editor.md","Recording Editor",{"type":7,"value":1122,"toc":1252},[1123,1126,1132,1136,1142,1162,1165,1169,1194,1198,1213,1217,1231,1242],[10,1124,1120],{"id":1125},"recording-editor",[14,1127,1128,1129,1131],{},"Record a clip inside SoundNinja, trim it, then import it onto a tab. Open the editor with the ",[257,1130,515],{}," button in the player bar.",[24,1133,1135],{"id":1134},"choose-an-input","Choose an input",[14,1137,1088,1138,1141],{},[257,1139,1140],{},"Settings → Audio",":",[29,1143,1144,1150,1156],{},[32,1145,1146,1149],{},[257,1147,1148],{},"Input Devices"," — microphone",[32,1151,1152,1155],{},[257,1153,1154],{},"Output Devices (PC Audio)"," — loopback of what your PC is playing",[32,1157,1158,1161],{},[257,1159,1160],{},"Input volume"," — capture gain from 0% to 200%",[14,1163,1164],{},"The Record button uses the device you pick here.",[24,1166,1168],{"id":1167},"edit-the-take","Edit the take",[29,1170,1171,1174,1177,1185,1188,1191],{},[32,1172,1173],{},"Record and stop",[32,1175,1176],{},"Watch the input level meter",[32,1178,1179,260,1182],{},[257,1180,1181],{},"Normalize",[257,1183,1184],{},"Noise Cancelation",[32,1186,1187],{},"Trim the whole clip, trim to a selection, or delete a selection",[32,1189,1190],{},"Undo \u002F redo",[32,1192,1193],{},"Zoom in and out",[24,1195,1197],{"id":1196},"stage-and-import","Stage and import",[107,1199,1200,1203,1206],{},[32,1201,1202],{},"Add the selection or the full track to the staging list.",[32,1204,1205],{},"The list starts empty: record, edit, then add a clip.",[32,1207,1208,260,1210,1212],{},[257,1209,519],{},[257,1211,522],{}," into the current tab or a tab you choose.",[24,1214,1216],{"id":1215},"stem-separation-optional","Stem separation (optional)",[14,1218,1219,1220,1223,1224,260,1227,1230],{},"Official Windows, macOS, and Linux release builds ship the ",[257,1221,1222],{},"stems"," feature. The Record Editor can keep ",[257,1225,1226],{},"vocals",[257,1228,1229],{},"music"," using BS-RoFormer.",[14,1232,1233,1234,1237,1238,1241],{},"The model is about 158 MB and is ",[257,1235,1236],{},"not"," bundled with the installer. Download it from ",[257,1239,1240],{},"Settings → Stem Separation",", or accept the first-run prompt. The Windows installer can also offer to download the model on first launch.",[14,1243,1244,1245,1012,1248,1251],{},"Custom source builds need an extra flag (",[320,1246,1247],{},"tauri:serve:stems",[320,1249,1250],{},"tauri:build:stems",").",{"title":128,"searchDepth":129,"depth":129,"links":1253},[1254,1255,1256,1257],{"id":1134,"depth":129,"text":1135},{"id":1167,"depth":129,"text":1168},{"id":1196,"depth":129,"text":1197},{"id":1215,"depth":129,"text":1216},"Capture mic or PC audio, edit the clip, and drop it on your board.",{},6,"\u002Frecording-editor",{"title":1120,"description":1258},"WLz7ozLeboeLKawRkz53eUj5KSVCj4xkPMhYg5P_MIo",{"id":1265,"titl