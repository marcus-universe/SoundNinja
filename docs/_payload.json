":1351},"actions","Actions",[29,1354,1355,1361,1367],{},[32,1356,1357,1360],{},[257,1358,1359],{},"Trigger Sound"," — pick from the live dropdown, or type an 8-character sound ID (Companion variables work)",[32,1362,1363,1366],{},[257,1364,1365],{},"Stop Sound"," — stop one playing sound by ID",[32,1368,1369,1372],{},[257,1370,1371],{},"Stop All"," — stop every playing sound",[14,1374,1375],{},"Copy a sound ID in SoundNinja from the button context menu or the multi-select ID chip.",[24,1377,1379],{"id":1378},"feedbacks-and-variables","Feedbacks and variables",[29,1381,1382,1388,1400,1406],{},[32,1383,1384,1387],{},[257,1385,1386],{},"Sound Playing"," — true while that sound ID is active (use it for button color)",[32,1389,1390,1393,1394,1012,1397],{},[320,1391,1392],{},"$(soundninja:connected)"," — ",[320,1395,1396],{},"true",[320,1398,1399],{},"false",[32,1401,1402,1405],{},[320,1403,1404],{},"$(soundninja:playing_count)"," — how many sounds are playing",[32,1407,1408,1411],{},[320,1409,1410],{},"$(soundninja:last_triggered)"," — last triggered sound ID",[24,1413,1415],{"id":1414},"http-api-advanced","HTTP API (advanced)",[14,1417,1418,1419],{},"Base path: ",[320,1420,1421],{},"\u002Fapi\u002Fv1",[29,1423,1424,1430,1436,1442,1452,1458,1467],{},[32,1425,1426,1429],{},[320,1427,1428],{},"GET \u002Finfo"," — app name, version, protocol, whether a token is required",[32,1431,1432,1435],{},[320,1433,1434],{},"GET \u002Fsounds"," — sound list (id, name, tabs, active)",[32,1437,1438,1441],{},[320,1439,1440],{},"GET \u002Fstate"," — sounds plus currently playing IDs",[32,1443,1444,1447,1448,1451],{},[320,1445,1446],{},"POST \u002Ftrigger"," with ",[320,1449,1450],{},"{ \"id\" }"," — play a sound",[32,1453,1454,1457],{},[320,1455,1456],{},"GET \u002Ftrigger\u002F:id"," — play (easy to test in a browser)",[32,1459,1460,1463,1464,1466],{},[320,1461,1462],{},"POST \u002Fstop"," with optional ",[320,1465,1450],{}," — stop one sound or all",[32,1468,1469,1472],{},[320,1470,1471]