[{"data":1,"prerenderedAt":1333},["ShallowReactive",2],{"docs-page-en-\u002Frecording-editor":3,"docs-nav-en":164},{"id":4,"title":5,"body":6,"description":156,"extension":157,"meta":158,"navigation":159,"order":160,"path":161,"seo":162,"stem":12,"__hash__":163},"content_en\u002Frecording-editor.md","Recording Editor",{"type":7,"value":8,"toc":148},"minimark",[9,13,22,27,34,56,59,63,89,93,111,115,129,136],[10,11,5],"h1",{"id":12},"recording-editor",[14,15,16,17,21],"p",{},"Record a clip inside SoundNinja, trim it, then import it onto a tab. Open the editor with the ",[18,19,20],"strong",{},"Record"," button in the player bar.",[23,24,26],"h2",{"id":25},"choose-an-input","Choose an input",[14,28,29,30,33],{},"In ",[18,31,32],{},"Settings → Audio",":",[35,36,37,44,50],"ul",{},[38,39,40,43],"li",{},[18,41,42],{},"Input Devices"," — microphone",[38,45,46,49],{},[18,47,48],{},"Output Devices (PC Audio)"," — loopback of what your PC is playing",[38,51,52,55],{},[18,53,54],{},"Input volume"," — capture gain from 0% to 200%",[14,57,58],{},"The Record button uses the device you pick here.",[23,60,62],{"id":61},"edit-the-take","Edit the take",[35,64,65,68,71,80,83,86],{},[38,66,67],{},"Record and stop",[38,69,70],{},"Watch the input level meter",[38,72,73,76,77],{},[18,74,75],{},"Normalize"," or ",[18,78,79],{},"Noise Cancelation",[38,81,82],{},"Trim the whole clip, trim to a selection, or delete a selection",[38,84,85],{},"Undo \u002F redo",[38,87,88],{},"Zoom in and out",[23,90,92],{"id":91},"stage-and-import","Stage and import",[94,95,96,99,102],"ol",{},[38,97,98],{},"Add the selection or the full track to the staging list.",[38,100,101],{},"The list starts empty: record, edit, then add a clip.",[38,103,104,76,107,110],{},[18,105,106],{},"Import selected",[18,108,109],{},"Import all"," into the current tab or a tab you choose.",[23,112,114],{"id":113},"stem-separation-optional","Stem separation (optional)",[14,116,117,118,76,121,124,125,128],{},"The Record Editor can keep ",[18,119,120],{},"vocals",[18,122,123],{},"music"," using BS-RoFormer. The model is about 158 MB and is ",[18,126,127],{},"not"," bundled with the app.",[14,130,131,132,135],{},"Download it from ",[18,133,134],{},"Settings → Stem Separation",", or accept the first-run prompt. The Windows installer can also offer to download the model on first launch.",[14,137,138,139,143,144,147],{},"Stem builds from source need an extra flag (",[140,141,142],"code",{},"tauri:serve:stems"," \u002F ",[140,145,146],{},"tauri:build:stems",").",{"title":149,"searchDepth":150,"depth":150,"links":151},"",2,[152,153,154,155],{"id":25,"depth":150,"text":26},{"id":61,"depth":150,"text":62},{"id":91,"depth":150,"text":92},{"id":113,"depth":150,"text":114},"Capture mic or PC audio, edit the clip, and drop it on your board.","md",{},true,6,"\u002Frecording-editor",{"title":5,"description":156},"MJVcc7XyjWmtAdA8N6FQhHNz88XkH8JRCYOy28MJ364",[165,285,484,630,784,917,1010,1235],{"id":166,"title":167,"body":168,"description":279,"extension":157,"meta":280,"navigation":159,"order":281,"path":282,"seo":283,"stem":172,"__hash__":284},"content_en\u002Foverview.md","Overview",{"type":7,"value":169,"toc":273},[170,173,176,179,182,186,200,204,235,239,249,253],[10,171,167],{"id":172},"overview",[14,174,175],{},"SoundNinja is an open-source soundboard for live streaming, chatting with friends, and podcast recording. It is built with Tauri v2 and Nuxt 4 so it stays light on RAM and disk.",[14,177,178],{},"The goal is simple: keep a huge sound library easy to scan, then play the right clip in milliseconds. The UI also works well as a dashboard in VR.",[14,180,181],{},"SoundNinja is still in early development. Features work, but not every platform is fully tested.",[23,183,185],{"id":184},"who-it-is-for","Who it is for",[35,187,188,191,194,197],{},[38,189,190],{},"Streamers who need instant sound cues",[38,192,193],{},"Friends who want a shared board for voice chat",[38,195,196],{},"Podcasters who record clips and drop them onto a board",[38,198,199],{},"Anyone who wants a customizable, local-first soundboard",[23,201,203],{"id":202},"what-you-can-do","What you can do",[35,205,206,209,212,215,218,221,229,232],{},[38,207,208],{},"Build a soundboard from your own audio files",[38,210,211],{},"Organize sounds in colored tabs, groups, and search",[38,213,214],{},"Design the look with the Theme Creator",[38,216,217],{},"Record PC audio or a microphone in the Record Editor",[38,219,220],{},"Assign hotkeys to individual sounds",[38,222,223,224],{},"Trigger sounds from ",[225,226,228],"a",{"href":227},"\u002Fdocs\u002Fremote-control","Bitfocus Companion",[38,230,231],{},"Import and export a full soundboard to share with others",[38,233,234],{},"Use GIFs or images on sound buttons",[23,236,238],{"id":237},"license","License",[14,240,241,242,248],{},"SoundNinja is free software under ",[225,243,247],{"href":244,"rel":245},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fblob\u002Fmain\u002FLICENSE",[246],"nofollow","GPL-3.0",". Fork it, change it, share it.",[23,250,252],{"id":251},"next-steps","Next steps",[94,254,255,261,267],{},[38,256,257],{},[225,258,260],{"href":259},"\u002Fdocs\u002Finstallation","Install SoundNinja",[38,262,263],{},[225,264,266],{"href":265},"\u002Fdocs\u002Fadding-sounds","Add sounds",[38,268,269],{},[225,270,272],{"href":271},"\u002Fdocs\u002Forganizing-sounds","Organize your board",{"title":149,"searchDepth":150,"depth":150,"links":274},[275,276,277,278],{"id":184,"depth":150,"text":185},{"id":202,"depth":150,"text":203},{"id":237,"depth":150,"text":238},{"id":251,"depth":150,"text":252},"What SoundNinja is and what you can do with it.",{},1,"\u002Foverview",{"title":167,"description":279},"cOxJIh0ybRdZsyS1INxo9O3CTipyV8220IKpyfnYFJA",{"id":286,"title":287,"body":288,"description":479,"extension":157,"meta":480,"navigation":159,"order":150,"path":481,"seo":482,"stem":292,"__hash__":483},"content_en\u002Finstallation.md","Installation",{"type":7,"value":289,"toc":472},[290,293,307,311,328,331,335,349,352,356,380,391,395,402,406,421,451,468],[10,291,287],{"id":292},"installation",[14,294,295,296,300,301,306],{},"Grab a build from the ",[225,297,299],{"href":298},"\u002Fdownload","Download page"," or from ",[225,302,305],{"href":303,"rel":304},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Freleases\u002Flatest",[246],"GitHub Releases",". SoundNinja is in early development, so treat builds as beta.",[23,308,310],{"id":309},"windows","Windows",[35,312,313,322,325],{},[38,314,315,76,318,321],{},[18,316,317],{},"Installer (.exe)",[18,319,320],{},"MSI (.msi)"," for 64-bit Windows",[38,323,324],{},"Landing page target: Windows 10 and newer",[38,326,327],{},"The app README also lists Windows 8 and above",[14,329,330],{},"Run the installer, then launch SoundNinja from the Start menu.",[23,332,334],{"id":333},"macos","macOS",[35,336,337,343,346],{},[38,338,339,342],{},[18,340,341],{},"Universal .dmg"," for Apple Silicon and Intel",[38,344,345],{},"Landing page target: macOS 10.14 and newer",[38,347,348],{},"The app README lists macOS 10.15 and above",[14,350,351],{},"Open the disk image and drag SoundNinja to Applications.",[23,353,355],{"id":354},"linux","Linux",[35,357,358,364,370,377],{},[38,359,360,363],{},[18,361,362],{},"Debian (.deb)"," for Ubuntu \u002F Debian",[38,365,366,369],{},[18,367,368],{},"AppImage"," for other distros",[38,371,372,373,376],{},"After a release is published, Arch users can install ",[140,374,375],{},"soundninja-bin"," from the AUR",[38,378,379],{},"Tested on Ubuntu 20.04",[14,381,382,383,386,387,390],{},"Desktop builds need WebKit and GTK packages. On Debian\u002FUbuntu that usually means ",[140,384,385],{},"libwebkit2gtk",", ",[140,388,389],{},"libgtk-3-0",", and an app-indicator library.",[23,392,394],{"id":393},"updates","Updates",[14,396,397,398,401],{},"In the app, open ",[18,399,400],{},"Help → Check for Updates",". You can also let SoundNinja check on startup in Settings.",[23,403,405],{"id":404},"build-from-source","Build from source",[14,407,408,409,414,415,420],{},"Need a custom build? Clone ",[225,410,413],{"href":411,"rel":412},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja",[246],"the repo",", install ",[225,416,419],{"href":417,"rel":418},"https:\u002F\u002Fv2.tauri.app\u002Fstart\u002Fprerequisites\u002F",[246],"Tauri prerequisites",", then:",[422,423,427],"pre",{"className":424,"code":425,"language":426,"meta":149,"style":149},"language-bash shiki shiki-themes github-light github-dark","bun install\nbun run tauri:serve\n","bash",[140,428,429,441],{"__ignoreMap":149},[430,431,433,437],"span",{"class":432,"line":281},"line",[430,434,436],{"class":435},"sScJk","bun",[430,438,440],{"class":439},"sZZnC"," install\n",[430,442,443,445,448],{"class":432,"line":150},[430,444,436],{"class":435},[430,446,447],{"class":439}," run",[430,449,450],{"class":439}," tauri:serve\n",[14,452,453,386,456,459,460,463,464,467],{},[140,454,455],{},"npm",[140,457,458],{},"pnpm",", or ",[140,461,462],{},"deno"," work too. Production build: ",[140,465,466],{},"bun run tauri:build",".",[469,470,471],"style",{},"html pre.shiki code .sScJk, html code.shiki .sScJk{--shiki-default:#6F42C1;--shiki-dark:#B392F0}html pre.shiki code .sZZnC, html code.shiki .sZZnC{--shiki-default:#032F62;--shiki-dark:#9ECBFF}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html.dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}",{"title":149,"searchDepth":150,"depth":150,"links":473},[474,475,476,477,478],{"id":309,"depth":150,"text":310},{"id":333,"depth":150,"text":334},{"id":354,"depth":150,"text":355},{"id":393,"depth":150,"text":394},{"id":404,"depth":150,"text":405},"Install SoundNinja on Windows, macOS, or Linux.",{},"\u002Finstallation",{"title":287,"description":479},"i4XnnjkhxVb30IICErH1K_cBbAQ7GmnD52FYRYjh50k",{"id":485,"title":486,"body":487,"description":624,"extension":157,"meta":625,"navigation":159,"order":626,"path":627,"seo":628,"stem":491,"__hash__":629},"content_en\u002Fadding-sounds.md","Adding Sounds",{"type":7,"value":488,"toc":616},[489,492,495,499,518,522,554,558,574,578,592,595,599,606,610],[10,490,486],{"id":491},"adding-sounds",[14,493,494],{},"A board is empty until you add clips. SoundNinja can import files, whole folders, a recording, or a shared soundboard pack.",[23,496,498],{"id":497},"import-audio-files","Import audio files",[94,500,501,512,515],{},[38,502,503,504,507,508,511],{},"Open ",[18,505,506],{},"File → Import Audio Files",", or use ",[18,509,510],{},"Import"," in the navbar.",[38,513,514],{},"Pick one or more audio files.",[38,516,517],{},"Sounds land in the current tab.",[23,519,521],{"id":520},"import-folders","Import folders",[94,523,524,534,537],{},[38,525,503,526,529,530,533],{},[18,527,528],{},"File → Import Folders"," (or ",[18,531,532],{},"Import Folders"," in the navbar).",[38,535,536],{},"Add one or more folders. Drag to reorder them before you import.",[38,538,539,540],{},"Choose how they land:\n",[35,541,542,548],{},[38,543,544,547],{},[18,545,546],{},"Import as Tabs"," — each folder becomes its own tab",[38,549,550,553],{},[18,551,552],{},"Import to current Tab"," — every file goes into the active tab",[23,555,557],{"id":556},"record-a-clip","Record a clip",[14,559,560,561,565,566,568,569,76,571,573],{},"Open the ",[225,562,564],{"href":563},"\u002Fdocs\u002Frecording-editor","Record Editor"," from the ",[18,567,20],{}," button in the player bar. Capture, trim, then ",[18,570,106],{},[18,572,109],{}," into the current tab or a tab you pick.",[23,575,577],{"id":576},"import-a-soundboard","Import a soundboard",[14,579,580,583,584,587,588,591],{},[18,581,582],{},"File → Import Soundboard"," loads a shared pack. Packs are a ",[140,585,586],{},".zip"," that contains ",[140,589,590],{},"project.sninja"," plus the sound files. After import, open the project and play.",[14,593,594],{},"You can also keep several projects (profiles). Use the project selector to switch boards.",[23,596,598],{"id":597},"relink-missing-files","Relink missing files",[14,600,601,602,605],{},"If audio files move on disk, SoundNinja shows a ",[18,603,604],{},"Missing sound files"," dialog. Pick a folder to search and relink the clips.",[23,607,609],{"id":608},"next","Next",[14,611,612,613,467],{},"Organize tabs, groups, and hotkeys in ",[225,614,615],{"href":271},"Organizing Sounds",{"title":149,"searchDepth":150,"depth":150,"links":617},[618,619,620,621,622,623],{"id":497,"depth":150,"text":498},{"id":520,"depth":150,"text":521},{"id":556,"depth":150,"text":557},{"id":576,"depth":150,"text":577},{"id":597,"depth":150,"text":598},{"id":608,"depth":150,"text":609},"Import audio, folders, recordings, and shared soundboards.",{},3,"\u002Fadding-sounds",{"title":486,"description":624},"qcK88xpbquf2dRogb67sx4O0tzuIof13-X3Yyn9680o",{"id":631,"title":615,"body":632,"description":778,"extension":157,"meta":779,"navigation":159,"order":780,"path":781,"seo":782,"stem":636,"__hash__":783},"content_en\u002Forganizing-sounds.md",{"type":7,"value":633,"toc":769},[634,637,640,644,671,678,682,685,699,706,710,716,720,731,735,738,742,745,751,757,761],[10,635,615],{"id":636},"organizing-sounds",[14,638,639],{},"SoundNinja is built for large libraries. Use tabs, groups, search, and hotkeys so the clip you need is one click (or one key) away.",[23,641,643],{"id":642},"tabs","Tabs",[35,645,646,653,660],{},[38,647,648,649,652],{},"Add a tab with ",[18,650,651],{},"Add tab",". Give it a color so you can scan the bar fast.",[38,654,655,656,659],{},"The ",[18,657,658],{},"All"," view shows every sound across tabs.",[38,661,662,663,666,667,670],{},"A sound can belong to ",[18,664,665],{},"one or more tabs",". Right-click a sound and use ",[18,668,669],{},"Move to tab"," to assign it.",[14,672,673,674,677],{},"Tab transitions live in ",[18,675,676],{},"Settings → Main",": Slide, Fade, Buttons one by one, or None.",[23,679,681],{"id":680},"groups","Groups",[14,683,684],{},"Since v0.5.3, separators can become named groups:",[35,686,687,690,693,696],{},[38,688,689],{},"Add, rename, or remove a group from the context menu",[38,691,692],{},"Drag the group header — children move with it",[38,694,695],{},"Drop sounds in or out of a group",[38,697,698],{},"Set group border color, name color, and button alignment (or use the tab default)",[14,700,701,702,705],{},"You can still add a plain ",[18,703,704],{},"Separator"," if you only need a visual break.",[23,707,709],{"id":708},"search","Search",[14,711,712,713,715],{},"Use the ",[18,714,709],{}," field in the navbar. Results update as you type.",[23,717,719],{"id":718},"reorder","Reorder",[14,721,722,723,726,727,730],{},"Turn on drag-and-drop in ",[18,724,725],{},"Settings → Behavior"," (",[18,728,729],{},"Allow reorder","). Then drag sounds and groups into place.",[23,732,734],{"id":733},"bulk-edit","Bulk edit",[14,736,737],{},"Multi-select sounds, then change color, move them to a tab, or delete them in one step.",[23,739,741],{"id":740},"hotkeys-and-sound-ids","Hotkeys and sound IDs",[14,743,744],{},"Every sound has an 8-character ID. Copy it from the button context menu or the multi-select ID chip.",[14,746,503,747,750],{},[18,748,749],{},"Settings → Hotkeys"," to bind a key to a sound ID. Global hotkeys are optional.",[14,752,753,754,756],{},"The same ID is what ",[225,755,228],{"href":227}," uses to trigger a clip.",[23,758,760],{"id":759},"gifs-and-colors","GIFs and colors",[14,762,763,764,768],{},"Right-click a sound to set per-button colors or a GIF \u002F image background. That is separate from the ",[225,765,767],{"href":766},"\u002Fdocs\u002Ftheme-editor","Theme Creator",", which styles the whole board.",{"title":149,"searchDepth":150,"depth":150,"links":770},[771,772,773,774,775,776,777],{"id":642,"depth":150,"text":643},{"id":680,"depth":150,"text":681},{"id":708,"depth":150,"text":709},{"id":718,"depth":150,"text":719},{"id":733,"depth":150,"text":734},{"id":740,"depth":150,"text":741},{"id":759,"depth":150,"text":760},"Tabs, groups, search, bulk edit, and hotkeys.",{},4,"\u002Forganizing-sounds",{"title":615,"description":778},"Q4gLPzceZdOi3j6gqMTmPuTzf4qua7p2dfLn2shjKT4",{"id":785,"title":786,"body":787,"description":911,"extension":157,"meta":912,"navigation":159,"order":913,"path":914,"seo":915,"stem":791,"__hash__":916},"content_en\u002Ftheme-editor.md","Theme Editor",{"type":7,"value":788,"toc":905},[789,792,798,802,828,831,835,849,853,879,882,886,891],[10,790,786],{"id":791},"theme-editor",[14,793,794,795,467],{},"The Theme Creator is the full visual editor for your board. Open it from ",[18,796,797],{},"Settings → Main → Theme Creator",[23,799,801],{"id":800},"three-tabs","Three tabs",[94,803,804,817,823],{},[38,805,806,809,810,143,813,816],{},[18,807,808],{},"General"," — theme name, shared colors, and font uploads (",[140,811,812],{},".ttf",[140,814,815],{},".otf",")",[38,818,819,822],{},[18,820,821],{},"Buttons"," — sound button colors, type, layout, and GIF overlay",[38,824,825,827],{},[18,826,643],{}," — tab bar colors, type, and border thickness",[14,829,830],{},"A live preview shows tabs and buttons as you edit.",[23,832,834],{"id":833},"what-you-can-change","What you can change",[35,836,837,840,843,846],{},[38,838,839],{},"Primary and accent colors, backgrounds, button colors, tab colors",[38,841,842],{},"Button and tab font family and size",[38,844,845],{},"Button width, radius, border width, gaps, and padding",[38,847,848],{},"GIF overlay opacity (normal and hover)",[23,850,852],{"id":851},"save-and-share","Save and share",[35,854,855,861,867,873],{},[38,856,857,860],{},[18,858,859],{},"Export .css"," — write a theme file you can back up or send to a friend",[38,862,863,866],{},[18,864,865],{},"Add to Themes"," — save the file into your Themes folder and apply it",[38,868,869,872],{},[18,870,871],{},"Import .css"," — load a built-in preset or a saved theme",[38,874,875,878],{},[18,876,877],{},"Reset"," — return to SoundNinja defaults",[14,880,881],{},"If you close the window with unsaved changes, SoundNinja asks you to save first.",[23,883,885],{"id":884},"without-the-full-editor","Without the full editor",[14,887,29,888,890],{},[18,889,676],{}," you can still:",[35,892,893,896,902],{},[38,894,895],{},"Pick a theme from the list",[38,897,898,899,816],{},"Edit CSS variables live (",[18,900,901],{},"Custom CSS",[38,903,904],{},"Import a theme file into the Themes folder",{"title":149,"searchDepth":150,"depth":150,"links":906},[907,908,909,910],{"id":800,"depth":150,"text":801},{"id":833,"depth":150,"text":834},{"id":851,"depth":150,"text":852},{"id":884,"depth":150,"text":885},"Design colors, fonts, buttons, and tabs in the Theme Creator.",{},5,"\u002Ftheme-editor",{"title":786,"description":911},"zpMjxENa49aUipEX7TBxcqrbaZNweyJ019KsLAMJeoc",{"id":4,"title":5,"body":918,"description":156,"extension":157,"meta":1008,"navigation":159,"order":160,"path":161,"seo":1009,"stem":12,"__hash__":163},{"type":7,"value":919,"toc":1002},[920,922,926,928,932,946,948,950,968,970,982,984,992,996],[10,921,5],{"id":12},[14,923,16,924,21],{},[18,925,20],{},[23,927,26],{"id":25},[14,929,29,930,33],{},[18,931,32],{},[35,933,934,938,942],{},[38,935,936,43],{},[18,937,42],{},[38,939,940,49],{},[18,941,48],{},[38,943,944,55],{},[18,945,54],{},[14,947,58],{},[23,949,62],{"id":61},[35,951,952,954,956,962,964,966],{},[38,953,67],{},[38,955,70],{},[38,957,958,76,960],{},[18,959,75],{},[18,961,79],{},[38,963,82],{},[38,965,85],{},[38,967,88],{},[23,969,92],{"id":91},[94,971,972,974,976],{},[38,973,98],{},[38,975,101],{},[38,977,978,76,980,110],{},[18,979,106],{},[18,981,109],{},[23,983,114],{"id":113},[14,985,117,986,76,988,124,990,128],{},[18,987,120],{},[18,989,123],{},[18,991,127],{},[14,993,131,994,135],{},[18,995,134],{},[14,997,138,998,143,1000,147],{},[140,999,142],{},[140,1001,146],{},{"title":149,"searchDepth":150,"depth":150,"links":1003},[1004,1005,1006,1007],{"id":25,"depth":150,"text":26},{"id":61,"depth":150,"text":62},{"id":91,"depth":150,"text":92},{"id":113,"depth":150,"text":114},{},{"title":5,"description":156},{"id":1011,"title":1012,"body":1013,"description":1229,"extension":157,"meta":1230,"navigation":159,"order":1231,"path":1232,"seo":1233,"stem":1017,"__hash__":1234},"content_en\u002Fremote-control.md","Remote Control",{"type":7,"value":1014,"toc":1222},[1015,1018,1021,1025,1054,1057,1060,1098,1102,1122,1125,1129,1161,1165,1171],[10,1016,1012],{"id":1017},"remote-control",[14,1019,1020],{},"SoundNinja can listen on your local network so Bitfocus Companion (or any HTTP\u002FWebSocket client) can play and stop sounds.",[23,1022,1024],{"id":1023},"enable-the-remote-server","Enable the remote server",[94,1026,1027,1032,1038,1044],{},[38,1028,503,1029,467],{},[18,1030,1031],{},"Settings → Remote",[38,1033,1034,1035,467],{},"Enable the remote server. Default port is ",[18,1036,1037],{},"7331",[38,1039,1040,1041,467],{},"Optional: set a token. Clients must send it as a Bearer token or ",[140,1042,1043],{},"?token=",[38,1045,1046,1047,1050,1051,467],{},"Copy the ",[140,1048,1049],{},"http:\u002F\u002FIP:PORT"," URL, or copy the system IP from ",[18,1052,1053],{},"Settings → About",[14,1055,1056],{},"Windows may show a firewall prompt the first time the server starts. Allow private-network access.",[23,1058,228],{"id":1059},"bitfocus-companion",[94,1061,1062,1069,1078,1085,1091],{},[38,1063,1064,1065,467],{},"Install ",[225,1066,228],{"href":1067,"rel":1068},"https:\u002F\u002Fbitfocus.io\u002Fcompanion",[246],[38,1070,1071,1072,1077],{},"Download the SoundNinja module from the official folder: ",[225,1073,1076],{"href":1074,"rel":1075},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Ftree\u002Fmain\u002Fcompanion-module-soundninja",[246],"companion-module-soundninja",". There is no Companion Store package yet — this folder is the download.",[38,1079,1080,1081,1084],{},"In Companion open ",[18,1082,1083],{},"Developer → Modules",", or drop the folder into Companion’s custom modules path.",[38,1086,1087,1088,467],{},"In the module folder run ",[140,1089,1090],{},"npm install",[38,1092,1093,1094,1097],{},"Add a ",[18,1095,1096],{},"Sound Ninja"," connection. Paste the PC IP, port, and token if you set one.",[23,1099,1101],{"id":1100},"actions","Actions",[35,1103,1104,1110,1116],{},[38,1105,1106,1109],{},[18,1107,1108],{},"Trigger Sound"," — pick from the live dropdown, or type an 8-character sound ID (Companion variables work)",[38,1111,1112,1115],{},[18,1113,1114],{},"Stop Sound"," — stop one playing sound by ID",[38,1117,1118,1121],{},[18,1119,1120],{},"Stop All"," — stop every playing sound",[14,1123,1124],{},"Copy a sound ID in SoundNinja from the button context menu or the multi-select ID chip.",[23,1126,1128],{"id":1127},"feedbacks-and-variables","Feedbacks and variables",[35,1130,1131,1137,1149,1155],{},[38,1132,1133,1136],{},[18,1134,1135],{},"Sound Playing"," — true while that sound ID is active (use it for button color)",[38,1138,1139,1142,1143,143,1146],{},[140,1140,1141],{},"$(soundninja:connected)"," — ",[140,1144,1145],{},"true",[140,1147,1148],{},"false",[38,1150,1151,1154],{},[140,1152,1153],{},"$(soundninja:playing_count)"," — how many sounds are playing",[38,1156,1157,1160],{},[140,1158,1159],{},"$(soundninja:last_triggered)"," — last triggered sound ID",[23,1162,1164],{"id":1163},"http-api-advanced","HTTP API (advanced)",[14,1166,1167,1168],{},"Base path: ",[140,1169,1170],{},"\u002Fapi\u002Fv1",[35,1172,1173,1179,1185,1191,1201,1207,1216],{},[38,1174,1175,1178],{},[140,1176,1177],{},"GET \u002Finfo"," — app name, version, protocol, whether a token is required",[38,1180,1181,1184],{},[140,1182,1183],{},"GET \u002Fsounds"," — sound list (id, name, tabs, active)",[38,1186,1187,1190],{},[140,1188,1189],{},"GET \u002Fstate"," — sounds plus currently playing IDs",[38,1192,1193,1196,1197,1200],{},[140,1194,1195],{},"POST \u002Ftrigger"," with ",[140,1198,1199],{},"{ \"id\" }"," — play a sound",[38,1202,1203,1206],{},[140,1204,1205],{},"GET \u002Ftrigger\u002F:id"," — play (easy to test in a browser)",[38,1208,1209,1212,1213,1215],{},[140,1210,1211],{},"POST \u002Fstop"," with optional ",[140,1214,1199],{}," — stop one sound or all",[38,1217,1218,1221],{},[140,1219,1220],{},"GET \u002Fws"," — live state; send trigger\u002Fstop commands inbound",{"title":149,"searchDepth":150,"depth":150,"links":1223},[1224,1225,1226,1227,1228],{"id":1023,"depth":150,"text":1024},{"id":1059,"depth":150,"text":228},{"id":1100,"depth":150,"text":1101},{"id":1127,"depth":150,"text":1128},{"id":1163,"depth":150,"text":1164},"Trigger SoundNinja from Bitfocus Companion over the local network.",{},7,"\u002Fremote-control",{"title":1012,"description":1229},"2a4c6ZB00Bri0Ad7GlCOyPluyHgB3pAQRtUqVGwvFbk",{"id":1236,"title":1237,"body":1238,"description":1327,"extension":157,"meta":1328,"navigation":159,"order":1329,"path":1330,"seo":1331,"stem":1242,"__hash__":1332},"content_en\u002Fsupport.md","Support",{"type":7,"value":1239,"toc":1320},[1240,1243,1246,1250,1253,1260,1268,1272,1279,1281,1294,1298,1309,1313],[10,1241,1237],{"id":1242},"support",[14,1244,1245],{},"SoundNinja i