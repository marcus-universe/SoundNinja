[{"data":1,"prerenderedAt":1597},["ShallowReactive",2],{"docs-page-en-\u002Frecording-editor":3,"docs-nav-en":168},{"id":4,"title":5,"body":6,"description":160,"extension":161,"meta":162,"navigation":163,"order":164,"path":165,"seo":166,"stem":12,"__hash__":167},"content_en\u002Frecording-editor.md","Recording Editor",{"type":7,"value":8,"toc":152},"minimark",[9,13,22,27,34,56,59,63,89,93,111,115,129,140],[10,11,5],"h1",{"id":12},"recording-editor",[14,15,16,17,21],"p",{},"Record a clip inside SoundNinja, trim it, then import it onto a tab. Open the editor with the ",[18,19,20],"strong",{},"Record"," button in the player bar.",[23,24,26],"h2",{"id":25},"choose-an-input","Choose an input",[14,28,29,30,33],{},"In ",[18,31,32],{},"Settings → Audio",":",[35,36,37,44,50],"ul",{},[38,39,40,43],"li",{},[18,41,42],{},"Input Devices"," — microphone",[38,45,46,49],{},[18,47,48],{},"Output Devices (PC Audio)"," — loopback of what your PC is playing",[38,51,52,55],{},[18,53,54],{},"Input volume"," — capture gain from 0% to 200%",[14,57,58],{},"The Record button uses the device you pick here.",[23,60,62],{"id":61},"edit-the-take","Edit the take",[35,64,65,68,71,80,83,86],{},[38,66,67],{},"Record and stop",[38,69,70],{},"Watch the input level meter",[38,72,73,76,77],{},[18,74,75],{},"Normalize"," or ",[18,78,79],{},"Noise Cancelation",[38,81,82],{},"Trim the whole clip, trim to a selection, or delete a selection",[38,84,85],{},"Undo \u002F redo",[38,87,88],{},"Zoom in and out",[23,90,92],{"id":91},"stage-and-import","Stage and import",[94,95,96,99,102],"ol",{},[38,97,98],{},"Add the selection or the full track to the staging list.",[38,100,101],{},"The list starts empty: record, edit, then add a clip.",[38,103,104,76,107,110],{},[18,105,106],{},"Import selected",[18,108,109],{},"Import all"," into the current tab or a tab you choose.",[23,112,114],{"id":113},"stem-separation-optional","Stem separation (optional)",[14,116,117,118,121,122,76,125,128],{},"Official Windows, macOS, and Linux release builds ship the ",[18,119,120],{},"stems"," feature. The Record Editor can keep ",[18,123,124],{},"vocals",[18,126,127],{},"music"," using BS-RoFormer.",[14,130,131,132,135,136,139],{},"The model is about 158 MB and is ",[18,133,134],{},"not"," bundled with the installer. Download it from ",[18,137,138],{},"Settings → Stem Separation",", or accept the first-run prompt. The Windows installer can also offer to download the model on first launch.",[14,141,142,143,147,148,151],{},"Custom source builds need an extra flag (",[144,145,146],"code",{},"tauri:serve:stems"," \u002F ",[144,149,150],{},"tauri:build:stems",").",{"title":153,"searchDepth":154,"depth":154,"links":155},"",2,[156,157,158,159],{"id":25,"depth":154,"text":26},{"id":61,"depth":154,"text":62},{"id":91,"depth":154,"text":92},{"id":113,"depth":154,"text":114},"Capture mic or PC audio, edit the clip, and drop it on your board.","md",{},true,6,"\u002Frecording-editor",{"title":5,"description":160},"WLz7ozLeboeLKawRkz53eUj5KSVCj4xkPMhYg5P_MIo",[169,298,500,646,1049,1182,1277,1499],{"id":170,"title":171,"body":172,"description":292,"extension":161,"meta":293,"navigation":163,"order":294,"path":295,"seo":296,"stem":176,"__hash__":297},"content_en\u002Foverview.md","Overview",{"type":7,"value":173,"toc":286},[174,177,180,183,186,190,204,208,248,252,262,266],[10,175,171],{"id":176},"overview",[14,178,179],{},"SoundNinja is an open-source soundboard for live streaming, chatting with friends, and podcast recording. It is built with Tauri v2 and Nuxt 4 so it stays light on RAM and disk.",[14,181,182],{},"The goal is simple: keep a huge sound library easy to scan, then play the right clip in milliseconds. The UI also works well as a dashboard in VR.",[14,184,185],{},"SoundNinja is still in early development. Features work, but not every platform is fully tested.",[23,187,189],{"id":188},"who-it-is-for","Who it is for",[35,191,192,195,198,201],{},[38,193,194],{},"Streamers who need instant sound cues",[38,196,197],{},"Friends who want a shared board for voice chat",[38,199,200],{},"Podcasters who record clips and drop them onto a board",[38,202,203],{},"Anyone who wants a customizable, local-first soundboard",[23,205,207],{"id":206},"what-you-can-do","What you can do",[35,209,210,213,216,219,222,225,228,231,234,242,245],{},[38,211,212],{},"Build a soundboard from your own audio files",[38,214,215],{},"Organize sounds in colored tabs, groups, tags, and search",[38,217,218],{},"Filter by tags (OR) and sort by name, date, duration, or size",[38,220,221],{},"Multi-select with marquee or Shift-range, then bulk color, move, or delete",[38,223,224],{},"Set per-sound volume from the context menu",[38,226,227],{},"Design the look with the Theme Creator",[38,229,230],{},"Record PC audio or a microphone in the Record Editor",[38,232,233],{},"Assign hotkeys to individual sounds",[38,235,236,237],{},"Trigger sounds from ",[238,239,241],"a",{"href":240},"\u002Fdocs\u002Fremote-control","Bitfocus Companion",[38,243,244],{},"Import and export a full soundboard to share with others",[38,246,247],{},"Use GIFs or images on sound buttons — from a local folder library or KLIPY",[23,249,251],{"id":250},"license","License",[14,253,254,255,261],{},"SoundNinja is free software under ",[238,256,260],{"href":257,"rel":258},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fblob\u002Fmain\u002FLICENSE",[259],"nofollow","GPL-3.0",". Fork it, change it, share it.",[23,263,265],{"id":264},"next-steps","Next steps",[94,267,268,274,280],{},[38,269,270],{},[238,271,273],{"href":272},"\u002Fdocs\u002Finstallation","Install SoundNinja",[38,275,276],{},[238,277,279],{"href":278},"\u002Fdocs\u002Fadding-sounds","Add sounds",[38,281,282],{},[238,283,285],{"href":284},"\u002Fdocs\u002Forganizing-sounds","Organize your board",{"title":153,"searchDepth":154,"depth":154,"links":287},[288,289,290,291],{"id":188,"depth":154,"text":189},{"id":206,"depth":154,"text":207},{"id":250,"depth":154,"text":251},{"id":264,"depth":154,"text":265},"What SoundNinja is and what you can do with it.",{},1,"\u002Foverview",{"title":171,"description":292},"Dax9ydiOOeEz5F1IxWfEljWZynntK7dPp52JZ3q2G58",{"id":299,"title":300,"body":301,"description":495,"extension":161,"meta":496,"navigation":163,"order":154,"path":497,"seo":498,"stem":305,"__hash__":499},"content_en\u002Finstallation.md","Installation",{"type":7,"value":302,"toc":488},[303,306,320,324,344,347,351,365,368,372,396,407,411,418,422,437,467,484],[10,304,300],{"id":305},"installation",[14,307,308,309,313,314,319],{},"Grab a build from the ",[238,310,312],{"href":311},"\u002Fdownload","Download page"," or from ",[238,315,318],{"href":316,"rel":317},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Freleases\u002Flatest",[259],"GitHub Releases",". SoundNinja is in early development, so treat builds as beta.",[23,321,323],{"id":322},"windows","Windows",[35,325,326,335,338,341],{},[38,327,328,76,331,334],{},[18,329,330],{},"Installer (.exe)",[18,332,333],{},"MSI (.msi)"," for 64-bit Windows",[38,336,337],{},"Landing page target: Windows 10 and newer",[38,339,340],{},"The app README also lists Windows 8 and above",[38,342,343],{},"The NSIS installer uses a dark theme. Pick a language during setup — SoundNinja remembers it on the next launch.",[14,345,346],{},"Run the installer, then launch SoundNinja from the Start menu.",[23,348,350],{"id":349},"macos","macOS",[35,352,353,359,362],{},[38,354,355,358],{},[18,356,357],{},"Universal .dmg"," for Apple Silicon and Intel",[38,360,361],{},"Landing page target: macOS 10.14 and newer",[38,363,364],{},"The app README lists macOS 10.15 and above",[14,366,367],{},"Open the disk image and drag SoundNinja to Applications.",[23,369,371],{"id":370},"linux","Linux",[35,373,374,380,386,393],{},[38,375,376,379],{},[18,377,378],{},"Debian (.deb)"," for Ubuntu \u002F Debian",[38,381,382,385],{},[18,383,384],{},"AppImage"," for other distros",[38,387,388,389,392],{},"After a release is published, Arch users can install ",[144,390,391],{},"soundninja-bin"," from the AUR",[38,394,395],{},"Tested on Ubuntu 20.04",[14,397,398,399,402,403,406],{},"Desktop builds need WebKit and GTK packages. On Debian\u002FUbuntu that usually means ",[144,400,401],{},"libwebkit2gtk",", ",[144,404,405],{},"libgtk-3-0",", and an app-indicator library.",[23,408,410],{"id":409},"updates","Updates",[14,412,413,414,417],{},"In the app, open ",[18,415,416],{},"Help → Check for Updates",". You can also let SoundNinja check on startup in Settings.",[23,419,421],{"id":420},"build-from-source","Build from source",[14,423,424,425,430,431,436],{},"Need a custom build? Clone ",[238,426,429],{"href":427,"rel":428},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja",[259],"the repo",", install ",[238,432,435],{"href":433,"rel":434},"https:\u002F\u002Fv2.tauri.app\u002Fstart\u002Fprerequisites\u002F",[259],"Tauri prerequisites",", then:",[438,439,443],"pre",{"className":440,"code":441,"language":442,"meta":153,"style":153},"language-bash shiki shiki-themes github-light github-dark","bun install\nbun run tauri:serve\n","bash",[144,444,445,457],{"__ignoreMap":153},[446,447,449,453],"span",{"class":448,"line":294},"line",[446,450,452],{"class":451},"sScJk","bun",[446,454,456],{"class":455},"sZZnC"," install\n",[446,458,459,461,464],{"class":448,"line":154},[446,460,452],{"class":451},[446,462,463],{"class":455}," run",[446,465,466],{"class":455}," tauri:serve\n",[14,468,469,402,472,475,476,479,480,483],{},[144,470,471],{},"npm",[144,473,474],{},"pnpm",", or ",[144,477,478],{},"deno"," work too. Production build: ",[144,481,482],{},"bun run tauri:build",".",[485,486,487],"style",{},"html pre.shiki code .sScJk, html code.shiki .sScJk{--shiki-default:#6F42C1;--shiki-dark:#B392F0}html pre.shiki code .sZZnC, html code.shiki .sZZnC{--shiki-default:#032F62;--shiki-dark:#9ECBFF}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html.dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}",{"title":153,"searchDepth":154,"depth":154,"links":489},[490,491,492,493,494],{"id":322,"depth":154,"text":323},{"id":349,"depth":154,"text":350},{"id":370,"depth":154,"text":371},{"id":409,"depth":154,"text":410},{"id":420,"depth":154,"text":421},"Install SoundNinja on Windows, macOS, or Linux.",{},"\u002Finstallation",{"title":300,"description":495},"7viacDB8R6wsHmYhw6wWPv9XZF7nR_yMjR5-EjD4OjQ",{"id":501,"title":502,"body":503,"description":640,"extension":161,"meta":641,"navigation":163,"order":642,"path":643,"seo":644,"stem":507,"__hash__":645},"content_en\u002Fadding-sounds.md","Adding Sounds",{"type":7,"value":504,"toc":632},[505,508,511,515,534,538,570,574,590,594,608,611,615,622,626],[10,506,502],{"id":507},"adding-sounds",[14,509,510],{},"A board is empty until you add clips. SoundNinja can import files, whole folders, a recording, or a shared soundboard pack.",[23,512,514],{"id":513},"import-audio-files","Import audio files",[94,516,517,528,531],{},[38,518,519,520,523,524,527],{},"Open ",[18,521,522],{},"File → Import Audio Files",", or use ",[18,525,526],{},"Import"," in the navbar.",[38,529,530],{},"Pick one or more audio files.",[38,532,533],{},"Sounds land in the current tab.",[23,535,537],{"id":536},"import-folders","Import folders",[94,539,540,550,553],{},[38,541,519,542,545,546,549],{},[18,543,544],{},"File → Import Folders"," (or ",[18,547,548],{},"Import Folders"," in the navbar).",[38,551,552],{},"Add one or more folders. Drag to reorder them before you import.",[38,554,555,556],{},"Choose how they land:\n",[35,557,558,564],{},[38,559,560,563],{},[18,561,562],{},"Import as Tabs"," — each folder becomes its own tab",[38,565,566,569],{},[18,567,568],{},"Import to current Tab"," — every file goes into the active tab",[23,571,573],{"id":572},"record-a-clip","Record a clip",[14,575,576,577,581,582,584,585,76,587,589],{},"Open the ",[238,578,580],{"href":579},"\u002Fdocs\u002Frecording-editor","Record Editor"," from the ",[18,583,20],{}," button in the player bar. Capture, trim, then ",[18,586,106],{},[18,588,109],{}," into the current tab or a tab you pick.",[23,591,593],{"id":592},"import-a-soundboard","Import a soundboard",[14,595,596,599,600,603,604,607],{},[18,597,598],{},"File → Import Soundboard"," loads a shared pack. Packs are a ",[144,601,602],{},".zip"," that contains ",[144,605,606],{},"project.sninja"," plus the sound files. After import, open the project and play.",[14,609,610],{},"You can also keep several projects (profiles). Use the project selector to switch boards.",[23,612,614],{"id":613},"relink-missing-files","Relink missing files",[14,616,617,618,621],{},"If audio files move on disk, SoundNinja shows a ",[18,619,620],{},"Missing sound files"," dialog. Pick a folder to search and relink the clips.",[23,623,625],{"id":624},"next","Next",[14,627,628,629,483],{},"Organize tabs, tags, filters, and hotkeys in ",[238,630,631],{"href":284},"Organizing Sounds",{"title":153,"searchDepth":154,"depth":154,"links":633},[634,635,636,637,638,639],{"id":513,"depth":154,"text":514},{"id":536,"depth":154,"text":537},{"id":572,"depth":154,"text":573},{"id":592,"depth":154,"text":593},{"id":613,"depth":154,"text":614},{"id":624,"depth":154,"text":625},"Import audio, folders, recordings, and shared soundboards.",{},3,"\u002Fadding-sounds",{"title":502,"description":640},"SBUvL_H4633CrDyNUKazqKwru4aq1hhgoH4_o99rBsE",{"id":647,"title":631,"body":648,"description":1043,"extension":161,"meta":1044,"navigation":163,"order":1045,"path":1046,"seo":1047,"stem":652,"__hash__":1048},"content_en\u002Forganizing-sounds.md",{"type":7,"value":649,"toc":1028},[650,653,660,664,691,698,702,705,719,726,732,736,746,751,783,787,793,797,830,836,840,843,870,873,877,891,895,901,922,938,945,949,959,962,966,973,983,989,993,1001,1008,1025],[10,651,631],{"id":652},"organizing-sounds",[14,654,655,656,659],{},"SoundNinja is built for large libraries. Use ",[18,657,658],{},"tags and filters",", tabs, search, multi-select, and hotkeys so the clip you need is one click (or one key) away.",[23,661,663],{"id":662},"tabs","Tabs",[35,665,666,673,680],{},[38,667,668,669,672],{},"Add a tab with ",[18,670,671],{},"Add tab",". Give it a color so you can scan the bar fast.",[38,674,675,676,679],{},"The ",[18,677,678],{},"All"," view shows every sound across tabs.",[38,681,682,683,686,687,690],{},"A sound can belong to ",[18,684,685],{},"one or more tabs",". Right-click a sound and use ",[18,688,689],{},"Move to tab"," to assign it.",[14,692,693,694,697],{},"Tab transitions live in ",[18,695,696],{},"Settings → Main",": Slide, Fade, Buttons one by one, or None.",[23,699,701],{"id":700},"groups","Groups",[14,703,704],{},"Since v0.5.3, separators can become named groups:",[35,706,707,710,713,716],{},[38,708,709],{},"Add, rename, or remove a group from the context menu",[38,711,712],{},"Drag the group header — children move with it",[38,714,715],{},"Drop sounds in or out of a group",[38,717,718],{},"Set group border color, name color, and button alignment (or use the tab default)",[14,720,721,722,725],{},"You can still add a plain ",[18,723,724],{},"Separator"," if you only need a visual break.",[14,727,728,729,483],{},"Right-click empty board space to ",[18,730,731],{},"Add Group",[23,733,735],{"id":734},"tags-filters","Tags \u002F Filters",[14,737,738,739,742,743,745],{},"Tags cut across tabs. The slide-out ",[18,740,741],{},"Filter"," panel (sidebar ",[18,744,741],{},") is where you create them and turn them into a board filter.",[747,748,750],"h3",{"id":749},"create-and-edit-tags","Create and edit tags",[94,752,753,758,769,776],{},[38,754,519,755,757],{},[18,756,741],{}," in the sidebar.",[38,759,760,761,764,765,768],{},"Under ",[18,762,763],{},"Tags",", use ",[18,766,767],{},"Add tag"," — give it a name and a color.",[38,770,771,772,775],{},"Rename, recolor, or ",[18,773,774],{},"Delete tag"," from the same list.",[38,777,778,779,782],{},"If you see ",[18,780,781],{},"No tags yet",", add one here before you assign anything.",[747,784,786],{"id":785},"assign-tags-to-sounds","Assign tags to sounds",[14,788,789,790,792],{},"Right-click a sound → ",[18,791,763],{}," (checkboxes). A sound can have several tags. If none exist yet, the menu tells you to open the filter panel.",[747,794,796],{"id":795},"filter-the-board","Filter the board",[35,798,799,805,816,827],{},[38,800,801,802,483],{},"Toggle tags in the Filter panel, or as ",[18,803,804],{},"chips under the search bar",[38,806,807,808,811,812,815],{},"Matching is ",[18,809,810],{},"OR",": a sound stays visible if it has ",[18,813,814],{},"any"," selected tag.",[38,817,818,819,822,823,826],{},"The navbar ",[18,820,821],{},"Search"," field ",[18,824,825],{},"ANDs"," with the active tag filter (type + tags together).",[38,828,829],{},"Turn chips off (or clear the filter) to show the full tab again.",[14,831,832,833,483],{},"Colored tag names can appear on buttons. Toggle them in ",[18,834,835],{},"Settings → Behavior → Show tag badges",[23,837,839],{"id":838},"sort","Sort",[14,841,842],{},"Open the filter panel and pick a sort mode:",[35,844,845,851],{},[38,846,847,850],{},[18,848,849],{},"User defined"," — your tab order, with groups visible",[38,852,853,402,856,402,859,475,862,865,866,869],{},[18,854,855],{},"Name",[18,857,858],{},"Added time",[18,860,861],{},"Play time",[18,863,864],{},"File size"," — a flat sorted list; ",[18,867,868],{},"groups are hidden"," in these modes",[14,871,872],{},"Duration sort may warm duration metadata the first time you use it.",[23,874,876],{"id":875},"reorder","Reorder",[14,878,879,880,883,884,887,888,890],{},"Turn on drag-and-drop in ",[18,881,882],{},"Settings → Behavior"," (",[18,885,886],{},"Allow reorder","). Then drag sounds and groups into place. Reorder applies in ",[18,889,849],{}," sort.",[23,892,894],{"id":893},"multi-select","Multi-select",[14,896,897,898,900],{},"Turn on ",[18,899,894],{}," in the navbar, then:",[35,902,903,906,912,919],{},[38,904,905],{},"Click a sound to toggle it",[38,907,908,911],{},[18,909,910],{},"Shift+click"," to select a range from the last anchor",[38,913,914,915,918],{},"Drag a ",[18,916,917],{},"marquee"," on empty board space",[38,920,921],{},"Click empty board (or outside) to clear the selection",[14,923,924,925,402,928,402,931,934,935,483],{},"A bulk bar appears with the count, plus ",[18,926,927],{},"Color",[18,929,930],{},"Move to tab…",[18,932,933],{},"Delete",", and ",[18,936,937],{},"Done",[14,939,940,941,944],{},"In multi-select, each button shows an ",[18,942,943],{},"8-character ID chip",". Right-click the chip to copy it.",[23,946,948],{"id":947},"per-sound-volume","Per-sound volume",[14,950,789,951,954,955,958],{},[18,952,953],{},"Volume",". Drag the slider from 0% to 100%. ",[18,956,957],{},"Double-click"," the slider to reset to 100%.",[14,960,961],{},"This stacks with the master output volume in Settings.",[23,963,965],{"id":964},"hotkeys-and-sound-ids","Hotkeys and sound IDs",[14,967,968,969,972],{},"Every sound has an 8-character ID. Copy it from the button context menu (",[18,970,971],{},"Copy ID",") or the multi-select ID chip.",[14,974,519,975,978,979,982],{},[18,976,977],{},"Settings → Hotkeys"," to bind a key to a sound ID. Global hotkeys are optional. ",[18,980,981],{},"Assign hotkey"," on the context menu jumps there with the ID prefilled.",[14,984,985,986,988],{},"The same ID is what ",[238,987,241],{"href":240}," uses to trigger a clip.",[23,990,992],{"id":991},"background-images-and-colors","Background images and colors",[14,994,995,996,1000],{},"Right-click a sound to set per-button colors or a background image. That is separate from the ",[238,997,999],{"href":998},"\u002Fdocs\u002Ftheme-editor","Theme Creator",", which styles the whole board.",[14,1002,1003,1004,1007],{},"The picker is a ",[18,1005,1006],{},"Background image"," dialog (PNG, JPEG, GIF, WebP):",[35,1009,1010,1016],{},[38,1011,1012,1015],{},[18,1013,1014],{},"Local files"," — add folders, pick a single file, search filenames, preview the grid, or remove a folder from the library",[38,1017,1018,1021,1022,1024],{},[18,1019,1020],{},"KLIPY"," — search online GIFs. Set your own API key in ",[18,1023,882],{},". The key is not stored in project files.",[14,1026,1027],{},"After you pick an image, pan and crop it on the button.",{"title":153,"searchDepth":154,"depth":154,"links":1029},[1030,1031,1032,1037,1038,1039,1040,1041,1042],{"id":662,"depth":154,"text":663},{"id":700,"depth":154,"text":701},{"id":734,"depth":154,"text":735,"children":1033},[1034,1035,1036],{"id":749,"depth":642,"text":750},{"id":785,"depth":642,"text":786},{"id":795,"depth":642,"text":796},{"id":838,"depth":154,"text":839},{"id":875,"depth":154,"text":876},{"id":893,"depth":154,"text":894},{"id":947,"depth":154,"text":948},{"id":964,"depth":154,"text":965},{"id":991,"depth":154,"text":992},"Tags, filters, tabs, groups, sort, multi-select, volume, and hotkeys.",{},4,"\u002Forganizing-sounds",{"title":631,"description":1043},"DaYqySVuX1kgdTnJw6h1GP_lGyj4zdFP2uKKbBEbVwQ",{"id":1050,"title":1051,"body":1052,"description":1176,"extension":161,"meta":1177,"navigation":163,"order":1178,"path":1179,"seo":1180,"stem":1056,"__hash__":1181},"content_en\u002Ftheme-editor.md","Theme Editor",{"type":7,"value":1053,"toc":1170},[1054,1057,1063,1067,1093,1096,1100,1114,1118,1144,1147,1151,1156],[10,1055,1051],{"id":1056},"theme-editor",[14,1058,1059,1060,483],{},"The Theme Creator is the full visual editor for your board. Open it from ",[18,1061,1062],{},"Settings → Main → Theme Creator",[23,1064,1066],{"id":1065},"three-tabs","Three tabs",[94,1068,1069,1082,1088],{},[38,1070,1071,1074,1075,147,1078,1081],{},[18,1072,1073],{},"General"," — theme name, shared colors, and font uploads (",[144,1076,1077],{},".ttf",[144,1079,1080],{},".otf",")",[38,1083,1084,1087],{},[18,1085,1086],{},"Buttons"," — sound button colors, type, layout, and GIF overlay",[38,1089,1090,1092],{},[18,1091,663],{}," — tab bar colors, type, and border thickness",[14,1094,1095],{},"A live preview shows tabs and buttons as you edit.",[23,1097,1099],{"id":1098},"what-you-can-change","What you can change",[35,1101,1102,1105,1108,1111],{},[38,1103,1104],{},"Primary and accent colors, backgrounds, button colors, tab colors",[38,1106,1107],{},"Button and tab font family and size",[38,1109,1110],{},"Button width, radius, border width, gaps, and padding",[38,1112,1113],{},"GIF overlay opacity (normal and hover)",[23,1115,1117],{"id":1116},"save-and-share","Save and share",[35,1119,1120,1126,1132,1138],{},[38,1121,1122,1125],{},[18,1123,1124],{},"Export .css"," — write a theme file you can back up or send to a friend",[38,1127,1128,1131],{},[18,1129,1130],{},"Add to Themes"," — save the file into your Themes folder and apply it",[38,1133,1134,1137],{},[18,1135,1136],{},"Import .css"," — load a built-in preset or a saved theme",[38,1139,1140,1143],{},[18,1141,1142],{},"Reset"," — return to SoundNinja defaults",[14,1145,1146],{},"If you close the window with unsaved changes, SoundNinja asks you to save first.",[23,1148,1150],{"id":1149},"without-the-full-editor","Without the full editor",[14,1152,29,1153,1155],{},[18,1154,696],{}," you can still:",[35,1157,1158,1161,1167],{},[38,1159,1160],{},"Pick a theme from the list",[38,1162,1163,1164,1081],{},"Edit CSS variables live (",[18,1165,1166],{},"Custom CSS",[38,1168,1169],{},"Import a theme file into the Themes folder",{"title":153,"searchDepth":154,"depth":154,"links":1171},[1172,1173,1174,1175],{"id":1065,"depth":154,"text":1066},{"id":1098,"depth":154,"text":1099},{"id":1116,"depth":154,"text":1117},{"id":1149,"depth":154,"text":1150},"Design colors, fonts, buttons, and tabs in the Theme Creator.",{},5,"\u002Ftheme-editor",{"title":1051,"description":1176},"zpMjxENa49aUipEX7TBxcqrbaZNweyJ019KsLAMJeoc",{"id":4,"title":5,"body":1183,"description":160,"extension":161,"meta":1275,"navigation":163,"order":164,"path":165,"seo":1276,"stem":12,"__hash__":167},{"type":7,"value":1184,"toc":1269},[1185,1187,1191,1193,1197,1211,1213,1215,1233,1235,1247,1249,1257,1263],[10,1186,5],{"id":12},[14,1188,16,1189,21],{},[18,1190,20],{},[23,1192,26],{"id":25},[14,1194,29,1195,33],{},[18,1196,32],{},[35,1198,1199,1203,1207],{},[38,1200,1201,43],{},[18,1202,42],{},[38,1204,1205,49],{},[18,1206,48],{},[38,1208,1209,55],{},[18,1210,54],{},[14,1212,58],{},[23,1214,62],{"id":61},[35,1216,1217,1219,1221,1227,1229,1231],{},[38,1218,67],{},[38,1220,70],{},[38,1222,1223,76,1225],{},[18,1224,75],{},[18,1226,79],{},[38,1228,82],{},[38,1230,85],{},[38,1232,88],{},[23,1234,92],{"id":91},[94,1236,1237,1239,1241],{},[38,1238,98],{},[38,1240,101],{},[38,1242,1243,76,1245,110],{},[18,1244,106],{},[18,1246,109],{},[23,1248,114],{"id":113},[14,1250,117,1251,121,1253,76,1255,128],{},[18,1252,120],{},[18,1254,124],{},[18,1256,127],{},[14,1258,131,1259,135,1261,139],{},[18,1260,134],{},[18,1262,138],{},[14,1264,142,1265,147,1267,151],{},[144,1266,146],{},[144,1268,150],{},{"title":153,"searchDepth":154,"depth":154,"links":1270},[1271,1272,1273,1274],{"id":25,"depth":154,"text":26},{"id":61,"depth":154,"text":62},{"id":91,"depth":154,"text":92},{"id":113,"depth":154,"text":114},{},{"title":5,"description":160},{"id":1278,"title":1279,"body":1280,"description":1493,"extension":161,"meta":1494,"navigation":163,"order":1495,"path":1496,"seo":1497,"stem":1284,"__hash__":1498},"content_en\u002Fremote-control.md","Remote Control",{"type":7,"value":1281,"toc":1486},[1282,1285,1288,1292,1321,1324,1327,1362,1366,1386,1389,1393,1425,1429,1435],[10,1283,1279],{"id":1284},"remote-control",[14,1286,1287],{},"SoundNinja can listen on your local network so Bitfocus Companion (or any HTTP\u002FWebSocket client) can play and stop sounds.",[23,1289,1291],{"id":1290},"enable-the-remote-server","Enable the remote server",[94,1293,1294,1299,1305,1311],{},[38,1295,519,1296,483],{},[18,1297,1298],{},"Settings → Remote",[38,1300,1301,1302,483],{},"Enable the remote server. Default port is ",[18,1303,1304],{},"7331",[38,1306,1307,1308,483],{},"Optional: set a token. Clients must send it as a Bearer token or ",[144,1309,1310],{},"?token=",[38,1312,1313,1314,1317,1318,483],{},"Copy the ",[144,1315,1316],{},"http:\u002F\u002FIP:PORT"," URL, or copy the system IP from ",[18,1319,1320],{},"Settings → About",[14,1322,1323],{},"Windows may show a firewall prompt the first time the server starts. Allow private-network access.",[23,1325,241],{"id":1326},"bitfocus-companion",[94,1328,1329,1336,1345,1355],{},[38,1330,1331,1332,483],{},"Install ",[238,1333,241],{"href":1334,"rel":1335},"https:\u002F\u002Fbitfocus.io\u002Fcompanion",[259],[38,1337,1338,1339,1344],{},"Download ",[238,1340,1343],{"href":1341,"rel":1342},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Freleases\u002Flatest\u002Fdownload\u002FSoundNinja-Companion.tgz",[259],"SoundNinja-Companion.tgz",". There is no Companion Store package yet.",[38,1346,1347,1348,1351,1352,483],{},"In Companion: ",[18,1349,1350],{},"Modules → Load module package"," and pick the ",[144,1353,1354],{},".tgz",[38,1356,1357,1358,1361],{},"Add a ",[18,1359,1360],{},"Sound Ninja"," connection. Paste the PC IP, port, and token if you set one.",[23,1363,1365],{"id":1364},"actions","Actions",[35,1367,1368,1374,1380],{},[38,1369,1370,1373],{},[18,1371,1372],{},"Trigger Sound"," — pick from the live dropdown, or type an 8-character sound ID (Companion variables work)",[38,1375,1376,1379],{},[18,1377,1378],{},"Stop Sound"," — stop one playing sound by ID",[38,1381,1382,1385],{},[18,1383,1384],{},"Stop All"," — stop every playing sound",[14,1387,1388],{},"Copy a sound ID in SoundNinja from the button context menu or the multi-select ID chip.",[23,1390,1392],{"id":1391},"feedbacks-and-variables","Feedbacks and variables",[35,1394,1395,1401,1413,1419],{},[38,1396,1397,1400],{},[18,1398,1399],{},"Sound Playing"," — true while that sound ID is active (use it for button color)",[38,1402,1403,1406,1407,147,1410],{},[144,1404,1405],{},"$(soundninja:connected)"," — ",[144,1408,1409],{},"true",[144,1411,1412],{},"false",[38,1414,1415,1418],{},[144,1416,1417],{},"$(soundninja:playing_count)"," — how many sounds are playing",[38,1420,1421,1424],{},[144,1422,1423],{},"$(soundninja:last_triggered)"," — last triggered sound ID",[23,1426,1428],{"id":1427},"http-api-advanced","HTTP API (advanced)",[14,1430,1431,1432],{},"Base path: ",[144,1433,1434],{},"\u002Fapi\u002Fv1",[35,1436,1437,1443,1449,1455,1465,1471,1480],{},[38,1438,1439,1442],{},[144,1440,1441],{},"GET \u002Finfo"," — app name, version, protocol, whether a token is required",[38,1444,1445,1448],{},[144,1446,1447],{},"GET \u002Fsounds"," — sound list (id, name, tabs, active)",[38,1450,1451,1454],{},[144,1452,1453],{},"GET \u002Fstate"," — sounds plus currently playing IDs",[38,1456,1457,1460,1461,1464],{},[144,1458,1459],{},"POST \u002Ftrigger"," with ",[144,1462,1463],{},"{ \"id\" }"," — play a sound",[38,1466,1467,1470],{},[144,1468,1469],{},"GET \u002Ftrigger\u002F:id"," — play (easy to test in a browser)",[38,1472,1473,1476,1477,1479],{},[144,1474,1475],{},"POST \u002Fstop"," with optional ",[144,1478,1463],{}," — stop one sound or all",[38,1481,1482,1485],{},[144,1483,1484],{},"GET \u002Fws"," — live state; send trigger\u002Fstop commands inbound",{"title":153,"searchDepth":154,"depth":154,"links":1487},[1488,1489,1490,1491,1492],{"id":1290,"depth":154,"text":1291},{"id":1326,"depth":154,"text":241},{"id":1364,"depth":154,"text":1365},{"id":1391,"depth":154,"text":1392},{"id":1427,"depth":154,"text":1428},"Trigger SoundNinja from Bitfocus Companion over the local network.",{},7,"\u002Fremote-control",{"title":1279,"description":1493},"KQi7j7adHXnJVvGqR1hkm5SITYH6EtQRjIgawVIKPhY",{"id":1500,"title":1501,"body":1502,"description":1591,"extension":161,"meta":1592,"navigation":163,"order":1593,"path":1594,"seo":1595,"stem":1506,"__hash__":1596},"content_en\u002Fsupport.md","Support",{"type":7,"value":1503,"toc":1584},[1504,1507,1510,1514,1517,1524,1532,1536,1543,1545,1558,1562,1573,1577],[10,1505,1501],{"id":1506},"support",[14,1508,1509],{},"SoundNinja is a community project in early beta. The fastest way to get help is GitHub.",[23,1511,1513],{"id":1512},"report-a-bug-or-ask-a-question","Report a bug or ask a question",[14,1515,1516],{},"Open an issue on GitHub:",[14,1518,1519],{},[238,1520,1523],{"href":1521,"rel":1522},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fissues",[259],"github.com\u002Fmarcus-universe\u002FSoundNinja\u002Fissues",[14,1525,1526,1527,76,1529,1531],{},"Include your OS, SoundNinja version (",[18,1528,416],{},[18,1530,1320],{},"), and steps to reproduce.",[23,1533,1535],{"id":1534},"email","Email",[14,1537,1538,1539],{},"Maintainer contact: ",[238,1540,1542],{"href":1541},"mailto:contact@marcus-universe.de","contact@marcus-universe.de",[23,1544,410],{"id":409},[14,1546,1547,1548,1550,1551,1553,1554,483],{},"In the app, use ",[18,1549,416],{},". New builds also appear on the ",[238,1552,312],{"href":311}," and on ",[238,1555,318],{"href":1556,"rel":1557},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Freleases",[259],[23