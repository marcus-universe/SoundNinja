[{"data":1,"prerenderedAt":1614},["ShallowReactive",2],{"docs-page-en-\u002Fadding-sounds":3,"docs-nav-en":169},{"id":4,"title":5,"body":6,"description":161,"extension":162,"meta":163,"navigation":164,"order":165,"path":166,"seo":167,"stem":12,"__hash__":168},"content_en\u002Fadding-sounds.md","Adding Sounds",{"type":7,"value":8,"toc":151},"minimark",[9,13,17,22,44,48,81,85,106,110,125,128,132,139,143],[10,11,5],"h1",{"id":12},"adding-sounds",[14,15,16],"p",{},"A board is empty until you add clips. SoundNinja can import files, whole folders, a recording, or a shared soundboard pack.",[18,19,21],"h2",{"id":20},"import-audio-files","Import audio files",[23,24,25,38,41],"ol",{},[26,27,28,29,33,34,37],"li",{},"Open ",[30,31,32],"strong",{},"File → Import Audio Files",", or use ",[30,35,36],{},"Import"," in the navbar.",[26,39,40],{},"Pick one or more audio files.",[26,42,43],{},"Sounds land in the current tab.",[18,45,47],{"id":46},"import-folders","Import folders",[23,49,50,60,63],{},[26,51,28,52,55,56,59],{},[30,53,54],{},"File → Import Folders"," (or ",[30,57,58],{},"Import Folders"," in the navbar).",[26,61,62],{},"Add one or more folders. Drag to reorder them before you import.",[26,64,65,66],{},"Choose how they land:\n",[67,68,69,75],"ul",{},[26,70,71,74],{},[30,72,73],{},"Import as Tabs"," — each folder becomes its own tab",[26,76,77,80],{},[30,78,79],{},"Import to current Tab"," — every file goes into the active tab",[18,82,84],{"id":83},"record-a-clip","Record a clip",[14,86,87,88,93,94,97,98,101,102,105],{},"Open the ",[89,90,92],"a",{"href":91},"\u002Fdocs\u002Frecording-editor","Record Editor"," from the ",[30,95,96],{},"Record"," button in the player bar. Capture, trim, then ",[30,99,100],{},"Import selected"," or ",[30,103,104],{},"Import all"," into the current tab or a tab you pick.",[18,107,109],{"id":108},"import-a-soundboard","Import a soundboard",[14,111,112,115,116,120,121,124],{},[30,113,114],{},"File → Import Soundboard"," loads a shared pack. Packs are a ",[117,118,119],"code",{},".zip"," that contains ",[117,122,123],{},"project.sninja"," plus the sound files. After import, open the project and play.",[14,126,127],{},"You can also keep several projects (profiles). Use the project selector to switch boards.",[18,129,131],{"id":130},"relink-missing-files","Relink missing files",[14,133,134,135,138],{},"If audio files move on disk, SoundNinja shows a ",[30,136,137],{},"Missing sound files"," dialog. Pick a folder to search and relink the clips.",[18,140,142],{"id":141},"next","Next",[14,144,145,146,150],{},"Organize tabs, tags, filters, and hotkeys in ",[89,147,149],{"href":148},"\u002Fdocs\u002Forganizing-sounds","Organizing Sounds",".",{"title":152,"searchDepth":153,"depth":153,"links":154},"",2,[155,156,157,158,159,160],{"id":20,"depth":153,"text":21},{"id":46,"depth":153,"text":47},{"id":83,"depth":153,"text":84},{"id":108,"depth":153,"text":109},{"id":130,"depth":153,"text":131},{"id":141,"depth":153,"text":142},"Import audio, folders, recordings, and shared soundboards.","md",{},true,3,"\u002Fadding-sounds",{"title":5,"description":161},"SBUvL_H4633CrDyNUKazqKwru4aq1hhgoH4_o99rBsE",[170,297,519,610,1013,1148,1294,1516],{"id":171,"title":172,"body":173,"description":291,"extension":162,"meta":292,"navigation":164,"order":293,"path":294,"seo":295,"stem":177,"__hash__":296},"content_en\u002Foverview.md","Overview",{"type":7,"value":174,"toc":285},[175,178,181,184,187,191,205,209,248,252,262,266],[10,176,172],{"id":177},"overview",[14,179,180],{},"SoundNinja is an open-source soundboard for live streaming, chatting with friends, and podcast recording. It is built with Tauri v2 and Nuxt 4 so it stays light on RAM and disk.",[14,182,183],{},"The goal is simple: keep a huge sound library easy to scan, then play the right clip in milliseconds. The UI also works well as a dashboard in VR.",[14,185,186],{},"SoundNinja is still in early development. Features work, but not every platform is fully tested.",[18,188,190],{"id":189},"who-it-is-for","Who it is for",[67,192,193,196,199,202],{},[26,194,195],{},"Streamers who need instant sound cues",[26,197,198],{},"Friends who want a shared board for voice chat",[26,200,201],{},"Podcasters who record clips and drop them onto a board",[26,203,204],{},"Anyone who wants a customizable, local-first soundboard",[18,206,208],{"id":207},"what-you-can-do","What you can do",[67,210,211,214,217,220,223,226,229,232,235,242,245],{},[26,212,213],{},"Build a soundboard from your own audio files",[26,215,216],{},"Organize sounds in colored tabs, groups, tags, and search",[26,218,219],{},"Filter by tags (OR) and sort by name, date, duration, or size",[26,221,222],{},"Multi-select with marquee or Shift-range, then bulk color, move, or delete",[26,224,225],{},"Set per-sound volume from the context menu",[26,227,228],{},"Design the look with the Theme Creator",[26,230,231],{},"Record PC audio or a microphone in the Record Editor",[26,233,234],{},"Assign hotkeys to individual sounds",[26,236,237,238],{},"Trigger sounds from ",[89,239,241],{"href":240},"\u002Fdocs\u002Fremote-control","Bitfocus Companion",[26,243,244],{},"Import and export a full soundboard to share with others",[26,246,247],{},"Use GIFs or images on sound buttons — from a local folder library or KLIPY",[18,249,251],{"id":250},"license","License",[14,253,254,255,261],{},"SoundNinja is free software under ",[89,256,260],{"href":257,"rel":258},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fblob\u002Fmain\u002FLICENSE",[259],"nofollow","GPL-3.0",". Fork it, change it, share it.",[18,263,265],{"id":264},"next-steps","Next steps",[23,267,268,274,280],{},[26,269,270],{},[89,271,273],{"href":272},"\u002Fdocs\u002Finstallation","Install SoundNinja",[26,275,276],{},[89,277,279],{"href":278},"\u002Fdocs\u002Fadding-sounds","Add sounds",[26,281,282],{},[89,283,284],{"href":148},"Organize your board",{"title":152,"searchDepth":153,"depth":153,"links":286},[287,288,289,290],{"id":189,"depth":153,"text":190},{"id":207,"depth":153,"text":208},{"id":250,"depth":153,"text":251},{"id":264,"depth":153,"text":265},"What SoundNinja is and what you can do with it.",{},1,"\u002Foverview",{"title":172,"description":291},"Dax9ydiOOeEz5F1IxWfEljWZynntK7dPp52JZ3q2G58",{"id":298,"title":299,"body":300,"description":514,"extension":162,"meta":515,"navigation":164,"order":153,"path":516,"seo":517,"stem":304,"__hash__":518},"content_en\u002Finstallation.md","Installation",{"type":7,"value":301,"toc":507},[302,305,319,323,343,346,350,364,367,371,395,406,410,417,421,436,466,482,503],[10,303,299],{"id":304},"installation",[14,306,307,308,312,313,318],{},"Grab a build from the ",[89,309,311],{"href":310},"\u002Fdownload","Download page"," or from ",[89,314,317],{"href":315,"rel":316},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Freleases\u002Flatest",[259],"GitHub Releases",". SoundNinja is in early development, so treat builds as beta.",[18,320,322],{"id":321},"windows","Windows",[67,324,325,334,337,340],{},[26,326,327,101,330,333],{},[30,328,329],{},"Installer (.exe)",[30,331,332],{},"MSI (.msi)"," for 64-bit Windows",[26,335,336],{},"Landing page target: Windows 10 and newer",[26,338,339],{},"The app README also lists Windows 8 and above",[26,341,342],{},"The NSIS installer uses a dark theme. Pick a language during setup — SoundNinja remembers it on the next launch.",[14,344,345],{},"Run the installer, then launch SoundNinja from the Start menu.",[18,347,349],{"id":348},"macos","macOS",[67,351,352,358,361],{},[26,353,354,357],{},[30,355,356],{},"Universal .dmg"," for Apple Silicon and Intel",[26,359,360],{},"Landing page target: macOS 10.14 and newer",[26,362,363],{},"The app README lists macOS 10.15 and above",[14,365,366],{},"Open the disk image and drag SoundNinja to Applications.",[18,368,370],{"id":369},"linux","Linux",[67,372,373,379,385,392],{},[26,374,375,378],{},[30,376,377],{},"Debian (.deb)"," for Ubuntu \u002F Debian",[26,380,381,384],{},[30,382,383],{},"AppImage"," for other distros",[26,386,387,388,391],{},"After a release is published, Arch users can install ",[117,389,390],{},"soundninja-bin"," from the AUR",[26,393,394],{},"Tested on Ubuntu 20.04",[14,396,397,398,401,402,405],{},"Desktop builds need WebKit and GTK packages. On Debian\u002FUbuntu that usually means ",[117,399,400],{},"libwebkit2gtk",", ",[117,403,404],{},"libgtk-3-0",", and an app-indicator library.",[18,407,409],{"id":408},"updates","Updates",[14,411,412,413,416],{},"In the app, open ",[30,414,415],{},"Help → Check for Updates",". You can also let SoundNinja check on startup in Settings.",[18,418,420],{"id":419},"build-from-source","Build from source",[14,422,423,424,429,430,435],{},"Need a custom build? Clone ",[89,425,428],{"href":426,"rel":427},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja",[259],"the repo",", install ",[89,431,434],{"href":432,"rel":433},"https:\u002F\u002Fv2.tauri.app\u002Fstart\u002Fprerequisites\u002F",[259],"Tauri prerequisites",", then:",[437,438,442],"pre",{"className":439,"code":440,"language":441,"meta":152,"style":152},"language-bash shiki shiki-themes github-light github-dark","bun install\nbun run tauri:serve\n","bash",[117,443,444,456],{"__ignoreMap":152},[445,446,448,452],"span",{"class":447,"line":293},"line",[445,449,451],{"class":450},"sScJk","bun",[445,453,455],{"class":454},"sZZnC"," install\n",[445,457,458,460,463],{"class":447,"line":153},[445,459,451],{"class":450},[445,461,462],{"class":454}," run",[445,464,465],{"class":454}," tauri:serve\n",[14,467,468,401,471,474,475,478,479,150],{},[117,469,470],{},"npm",[117,472,473],{},"pnpm",", or ",[117,476,477],{},"deno"," work too. Production build: ",[117,480,481],{},"bun run tauri:build",[14,483,484,487,488,493,494,497,498,150],{},[30,485,486],{},"Windows only:"," every Windows compile includes ASIO via the ",[89,489,492],{"href":490,"rel":491},"https:\u002F\u002Fwww.steinberg.net\u002Fasiosdk",[259],"Steinberg ASIO SDK",". Run ",[117,495,496],{},"bun run setup:asio"," once (SDK is not in git). Linux and macOS use PipeWire \u002F Core Audio — skip that step. Full notes: ",[89,499,502],{"href":500,"rel":501},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fblob\u002Fmain\u002Fdocs\u002Fbuild-from-source.md",[259],"build-from-source.md",[504,505,506],"style",{},"html pre.shiki code .sScJk, html code.shiki .sScJk{--shiki-default:#6F42C1;--shiki-dark:#B392F0}html pre.shiki code .sZZnC, html code.shiki .sZZnC{--shiki-default:#032F62;--shiki-dark:#9ECBFF}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html.dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}",{"title":152,"searchDepth":153,"depth":153,"links":508},[509,510,511,512,513],{"id":321,"depth":153,"text":322},{"id":348,"depth":153,"text":349},{"id":369,"depth":153,"text":370},{"id":408,"depth":153,"text":409},{"id":419,"depth":153,"text":420},"Install SoundNinja on Windows, macOS, or Linux.",{},"\u002Finstallation",{"title":299,"description":514},"outLmMLibzOL_84ZfoLBrmphO4wVu0zaTr0u_DS4GUg",{"id":4,"title":5,"body":520,"description":161,"extension":162,"meta":608,"navigation":164,"order":165,"path":166,"seo":609,"stem":12,"__hash__":168},{"type":7,"value":521,"toc":600},[522,524,526,528,540,542,564,566,576,578,586,588,590,594,596],[10,523,5],{"id":12},[14,525,16],{},[18,527,21],{"id":20},[23,529,530,536,538],{},[26,531,28,532,33,534,37],{},[30,533,32],{},[30,535,36],{},[26,537,40],{},[26,539,43],{},[18,541,47],{"id":46},[23,543,544,550,552],{},[26,545,28,546,55,548,59],{},[30,547,54],{},[30,549,58],{},[26,551,62],{},[26,553,65,554],{},[67,555,556,560],{},[26,557,558,74],{},[30,559,73],{},[26,561,562,80],{},[30,563,79],{},[18,565,84],{"id":83},[14,567,87,568,93,570,97,572,101,574,105],{},[89,569,92],{"href":91},[30,571,96],{},[30,573,100],{},[30,575,104],{},[18,577,109],{"id":108},[14,579,580,115,582,120,584,124],{},[30,581,114],{},[117,583,119],{},[117,585,123],{},[14,587,127],{},[18,589,131],{"id":130},[14,591,134,592,138],{},[30,593,137],{},[18,595,142],{"id":141},[14,597,145,598,150],{},[89,599,149],{"href":148},{"title":152,"searchDepth":153,"depth":153,"links":601},[602,603,604,605,606,607],{"id":20,"depth":153,"text":21},{"id":46,"depth":153,"text":47},{"id":83,"depth":153,"text":84},{"id":108,"depth":153,"text":109},{"id":130,"depth":153,"text":131},{"id":141,"depth":153,"text":142},{},{"title":5,"description":161},{"id":611,"title":149,"body":612,"description":1007,"extension":162,"meta":1008,"navigation":164,"order":1009,"path":1010,"seo":1011,"stem":616,"__hash__":1012},"content_en\u002Forganizing-sounds.md",{"type":7,"value":613,"toc":992},[614,617,624,628,655,662,666,669,683,690,696,700,710,715,747,751,757,761,794,800,804,807,834,837,841,855,859,865,886,902,909,913,923,926,930,937,947,953,957,965,972,989],[10,615,149],{"id":616},"organizing-sounds",[14,618,619,620,623],{},"SoundNinja is built for large libraries. Use ",[30,621,622],{},"tags and filters",", tabs, search, multi-select, and hotkeys so the clip you need is one click (or one key) away.",[18,625,627],{"id":626},"tabs","Tabs",[67,629,630,637,644],{},[26,631,632,633,636],{},"Add a tab with ",[30,634,635],{},"Add tab",". Give it a color so you can scan the bar fast.",[26,638,639,640,643],{},"The ",[30,641,642],{},"All"," view shows every sound across tabs.",[26,645,646,647,650,651,654],{},"A sound can belong to ",[30,648,649],{},"one or more tabs",". Right-click a sound and use ",[30,652,653],{},"Move to tab"," to assign it.",[14,656,657,658,661],{},"Tab transitions live in ",[30,659,660],{},"Settings → Main",": Slide, Fade, Buttons one by one, or None.",[18,663,665],{"id":664},"groups","Groups",[14,667,668],{},"Since v0.5.3, separators can become named groups:",[67,670,671,674,677,680],{},[26,672,673],{},"Add, rename, or remove a group from the context menu",[26,675,676],{},"Drag the group header — children move with it",[26,678,679],{},"Drop sounds in or out of a group",[26,681,682],{},"Set group border color, name color, and button alignment (or use the tab default)",[14,684,685,686,689],{},"You can still add a plain ",[30,687,688],{},"Separator"," if you only need a visual break.",[14,691,692,693,150],{},"Right-click empty board space to ",[30,694,695],{},"Add Group",[18,697,699],{"id":698},"tags-filters","Tags \u002F Filters",[14,701,702,703,706,707,709],{},"Tags cut across tabs. The slide-out ",[30,704,705],{},"Filter"," panel (sidebar ",[30,708,705],{},") is where you create them and turn them into a board filter.",[711,712,714],"h3",{"id":713},"create-and-edit-tags","Create and edit tags",[23,716,717,722,733,740],{},[26,718,28,719,721],{},[30,720,705],{}," in the sidebar.",[26,723,724,725,728,729,732],{},"Under ",[30,726,727],{},"Tags",", use ",[30,730,731],{},"Add tag"," — give it a name and a color.",[26,734,735,736,739],{},"Rename, recolor, or ",[30,737,738],{},"Delete tag"," from the same list.",[26,741,742,743,746],{},"If you see ",[30,744,745],{},"No tags yet",", add one here before you assign anything.",[711,748,750],{"id":749},"assign-tags-to-sounds","Assign tags to sounds",[14,752,753,754,756],{},"Right-click a sound → ",[30,755,727],{}," (checkboxes). A sound can have several tags. If none exist yet, the menu tells you to open the filter panel.",[711,758,760],{"id":759},"filter-the-board","Filter the board",[67,762,763,769,780,791],{},[26,764,765,766,150],{},"Toggle tags in the Filter panel, or as ",[30,767,768],{},"chips under the search bar",[26,770,771,772,775,776,779],{},"Matching is ",[30,773,774],{},"OR",": a sound stays visible if it has ",[30,777,778],{},"any"," selected tag.",[26,781,782,783,786,787,790],{},"The navbar ",[30,784,785],{},"Search"," field ",[30,788,789],{},"ANDs"," with the active tag filter (type + tags together).",[26,792,793],{},"Turn chips off (or clear the filter) to show the full tab again.",[14,795,796,797,150],{},"Colored tag names can appear on buttons. Toggle them in ",[30,798,799],{},"Settings → Behavior → Show tag badges",[18,801,803],{"id":802},"sort","Sort",[14,805,806],{},"Open the filter panel and pick a sort mode:",[67,808,809,815],{},[26,810,811,814],{},[30,812,813],{},"User defined"," — your tab order, with groups visible",[26,816,817,401,820,401,823,474,826,829,830,833],{},[30,818,819],{},"Name",[30,821,822],{},"Added time",[30,824,825],{},"Play time",[30,827,828],{},"File size"," — a flat sorted list; ",[30,831,832],{},"groups are hidden"," in these modes",[14,835,836],{},"Duration sort may warm duration metadata the first time you use it.",[18,838,840],{"id":839},"reorder","Reorder",[14,842,843,844,847,848,851,852,854],{},"Turn on drag-and-drop in ",[30,845,846],{},"Settings → Behavior"," (",[30,849,850],{},"Allow reorder","). Then drag sounds and groups into place. Reorder applies in ",[30,853,813],{}," sort.",[18,856,858],{"id":857},"multi-select","Multi-select",[14,860,861,862,864],{},"Turn on ",[30,863,858],{}," in the navbar, then:",[67,866,867,870,876,883],{},[26,868,869],{},"Click a sound to toggle it",[26,871,872,875],{},[30,873,874],{},"Shift+click"," to select a range from the last anchor",[26,877,878,879,882],{},"Drag a ",[30,880,881],{},"marquee"," on empty board space",[26,884,885],{},"Click empty board (or outside) to clear the selection",[14,887,888,889,401,892,401,895,898,899,150],{},"A bulk bar appears with the count, plus ",[30,890,891],{},"Color",[30,893,894],{},"Move to tab…",[30,896,897],{},"Delete",", and ",[30,900,901],{},"Done",[14,903,904,905,908],{},"In multi-select, each button shows an ",[30,906,907],{},"8-character ID chip",". Right-click the chip to copy it.",[18,910,912],{"id":911},"per-sound-volume","Per-sound volume",[14,914,753,915,918,919,922],{},[30,916,917],{},"Volume",". Drag the slider from 0% to 100%. ",[30,920,921],{},"Double-click"," the slider to reset to 100%.",[14,924,925],{},"This stacks with the master output volume in Settings.",[18,927,929],{"id":928},"hotkeys-and-sound-ids","Hotkeys and sound IDs",[14,931,932,933,936],{},"Every sound has an 8-character ID. Copy it from the button context menu (",[30,934,935],{},"Copy ID",") or the multi-select ID chip.",[14,938,28,939,942,943,946],{},[30,940,941],{},"Settings → Hotkeys"," to bind a key to a sound ID. Global hotkeys are optional. ",[30,944,945],{},"Assign hotkey"," on the context menu jumps there with the ID prefilled.",[14,948,949,950,952],{},"The same ID is what ",[89,951,241],{"href":240}," uses to trigger a clip.",[18,954,956],{"id":955},"background-images-and-colors","Background images and colors",[14,958,959,960,964],{},"Right-click a sound to set per-button colors or a background image. That is separate from the ",[89,961,963],{"href":962},"\u002Fdocs\u002Ftheme-editor","Theme Creator",", which styles the whole board.",[14,966,967,968,971],{},"The picker is a ",[30,969,970],{},"Background image"," dialog (PNG, JPEG, GIF, WebP):",[67,973,974,980],{},[26,975,976,979],{},[30,977,978],{},"Local files"," — add folders, pick a single file, search filenames, preview the grid, or remove a folder from the library",[26,981,982,985,986,988],{},[30,983,984],{},"KLIPY"," — search online GIFs. Set your own API key in ",[30,987,846],{},". The key is not stored in project files.",[14,990,991],{},"After you pick an image, pan and crop it on the button.",{"title":152,"searchDepth":153,"depth":153,"links":993},[994,995,996,1001,1002,1003,1004,1005,1006],{"id":626,"depth":153,"text":627},{"id":664,"depth":153,"text":665},{"id":698,"depth":153,"text":699,"children":997},[998,999,1000],{"id":713,"depth":165,"text":714},{"id":749,"depth":165,"text":750},{"id":759,"depth":165,"text":760},{"id":802,"depth":153,"text":803},{"id":839,"depth":153,"text":840},{"id":857,"depth":153,"text":858},{"id":911,"depth":153,"text":912},{"id":928,"depth":153,"text":929},{"id":955,"depth":153,"text":956},"Tags, filters, tabs, groups, sort, multi-select, volume, and hotkeys.",{},4,"\u002Forganizing-sounds",{"title":149,"description":1007},"DaYqySVuX1kgdTnJw6h1GP_lGyj4zdFP2uKKbBEbVwQ",{"id":1014,"title":1015,"body":1016,"description":1142,"extension":162,"meta":1143,"navigation":164,"order":1144,"path":1145,"seo":1146,"stem":1020,"__hash__":1147},"content_en\u002Ftheme-editor.md","Theme Editor",{"type":7,"value":1017,"toc":1136},[1018,1021,1027,1031,1058,1061,1065,1079,1083,1109,1112,1116,1122],[10,1019,1015],{"id":1020},"theme-editor",[14,1022,1023,1024,150],{},"The Theme Creator is the full visual editor for your board. Open it from ",[30,1025,1026],{},"Settings → Main → Theme Creator",[18,1028,1030],{"id":1029},"three-tabs","Three tabs",[23,1032,1033,1047,1053],{},[26,1034,1035,1038,1039,1042,1043,1046],{},[30,1036,1037],{},"General"," — theme name, shared colors, and font uploads (",[117,1040,1041],{},".ttf"," \u002F ",[117,1044,1045],{},".otf",")",[26,1048,1049,1052],{},[30,1050,1051],{},"Buttons"," — sound button colors, type, layout, and GIF overlay",[26,1054,1055,1057],{},[30,1056,627],{}," — tab bar colors, type, and border thickness",[14,1059,1060],{},"A live preview shows tabs and buttons as you edit.",[18,1062,1064],{"id":1063},"what-you-can-change","What you can change",[67,1066,1067,1070,1073,1076],{},[26,1068,1069],{},"Primary and accent colors, backgrounds, button colors, tab colors",[26,1071,1072],{},"Button and tab font family and size",[26,1074,1075],{},"Button width, radius, border width, gaps, and padding",[26,1077,1078],{},"GIF overlay opacity (normal and hover)",[18,1080,1082],{"id":1081},"save-and-share","Save and share",[67,1084,1085,1091,1097,1103],{},[26,1086,1087,1090],{},[30,1088,1089],{},"Export .css"," — write a theme file you can back up or send to a friend",[26,1092,1093,1096],{},[30,1094,1095],{},"Add to Themes"," — save the file into your Themes folder and apply it",[26,1098,1099,1102],{},[30,1100,1101],{},"Import .css"," — load a built-in preset or a saved theme",[26,1104,1105,1108],{},[30,1106,1107],{},"Reset"," — return to SoundNinja defaults",[14,1110,1111],{},"If you close the window with unsaved changes, SoundNinja asks you to save first.",[18,1113,1115],{"id":1114},"without-the-full-editor","Without the full editor",[14,1117,1118,1119,1121],{},"In ",[30,1120,660],{}," you can still:",[67,1123,1124,1127,1133],{},[26,1125,1126],{},"Pick a theme from the list",[26,1128,1129,1130,1046],{},"Edit CSS variables live (",[30,1131,1132],{},"Custom CSS",[26,1134,1135],{},"Import a theme file into the Themes folder",{"title":152,"searchDepth":153,"depth":153,"links":1137},[1138,1139,1140,1141],{"id":1029,"depth":153,"text":1030},{"id":1063,"depth":153,"text":1064},{"id":1081,"depth":153,"text":1082},{"id":1114,"depth":153,"text":1115},"Design colors, fonts, buttons, and tabs in the Theme Creator.",{},5,"\u002Ftheme-editor",{"title":1015,"description":1142},"zpMjxENa49aUipEX7TBxcqrbaZNweyJ019KsLAMJeoc",{"id":1149,"title":1150,"body":1151,"description":1288,"extension":162,"meta":1289,"navigation":164,"order":1290,"path":1291,"seo":1292,"stem":1155,"__hash__":1293},"content_en\u002Frecording-editor.md","Recording Editor",{"type":7,"value":1152,"toc":1282},[1153,1156,1162,1166,1172,1192,1195,1199,1224,1228,1243,1247,1261,1272],[10,1154,1150],{"id":1155},"recording-editor",[14,1157,1158,1159,1161],{},"Record a clip inside SoundNinja, trim it, then import it onto a tab. Open the editor with the ",[30,1160,96],{}," button in the player bar.",[18,1163,1165],{"id":1164},"choose-an-input","Choose an input",[14,1167,1118,1168,1171],{},[30,1169,1170],{},"Settings → Audio",":",[67,1173,1174,1180,1186],{},[26,1175,1176,1179],{},[30,1177,1178],{},"Input Devices"," — microphone",[26,1181,1182,1185],{},[30,1183,1184],{},"Output Devices (PC Audio)"," — loopback of what your PC is playing",[26,1187,1188,1191],{},[30,1189,1190],{},"Input volume"," — capture gain from 0% to 200%",[14,1193,1194],{},"The Record button uses the device you pick here.",[18,1196,1198],{"id":1197},"edit-the-take","Edit the take",[67,1200,1201,1204,1207,1215,1218,1221],{},[26,1202,1203],{},"Record and stop",[26,1205,1206],{},"Watch the input level meter",[26,1208,1209,101,1212],{},[30,1210,1211],{},"Normalize",[30,1213,1214],{},"Noise Cancelation",[26,1216,1217],{},"Trim the whole clip, trim to a selection, or delete a selection",[26,1219,1220],{},"Undo \u002F redo",[26,1222,1223],{},"Zoom in and out",[18,1225,1227],{"id":1226},"stage-and-import","Stage and import",[23,1229,1230,1233,1236],{},[26,1231,1232],{},"Add the selection or the full track to the staging list.",[26,1234,1235],{},"The list starts empty: record, edit, then add a clip.",[26,1237,1238,101,1240,1242],{},[30,1239,100],{},[30,1241,104],{}," into the current tab or a tab you choose.",[18,1244,1246],{"id":1245},"stem-separation-optional","Stem separation (optional)",[14,1248,1249,1250,1253,1254,101,1257,1260],{},"Official Windows, macOS, and Linux release builds ship the ",[30,1251,1252],{},"stems"," feature. The Record Editor can keep ",[30,1255,1256],{},"vocals",[30,1258,1259],{},"music"," using BS-RoFormer.",[14,1262,1263,1264,1267,1268,1271],{},"The model is about 158 MB and is ",[30,1265,1266],{},"not"," bundled with the installer. Download it from ",[30,1269,1270],{},"Settings → Stem Separation",", or accept the first-run prompt. The Windows installer can also offer to download the model on first launch.",[14,1273,1274,1275,1042,1278,1281],{},"Custom source builds need an extra flag (",[117,1276,1277],{},"tauri:serve:stems",[117,1279,1280],{},"tauri:build:stems",").",{"title":152,"searchDepth":153,"depth":153,"links":1283},[1284,1285,1286,1287],{"id":1164,"depth":153,"text":1165},{"id":1197,"depth":153,"text":1198},{"id":1226,"depth":153,"text":1227},{"id":1245,"depth":153,"text":1246},"Capture mic or PC audio, edit the clip, and drop it on your board.",{},6,"\u002Frecording-editor",{"title":1150,"description":1288},"WLz7ozLeboeLKawRkz53eUj5KSVCj4xkPMhYg5P_MIo",{"id":1295,"title":1296,"body":1297,"description":1510,"extension":162,"meta":1511,"navigation":164,"order":1512,"path":1513,"seo":1514,"stem":1301,"__hash__":1515},"content_en\u002Fremote-control.md","Remote Control",{"type":7,"value":1298,"toc":1503},[1299,1302,1305,1309,1338,1341,1344,1379,1383,1403,1406,1410,1442,1446,1452],[10,1300,1296],{"id":1301},"remote-control",[14,1303,1304],{},"SoundNinja can listen on your local network so Bitfocus Companion (or any HTTP\u002FWebSocket client) can play and stop sounds.",[18,1306,1308],{"id":1307},"enable-the-remote-server","Enable the remote server",[23,1310,1311,1316,1322,1328],{},[26,1312,28,1313,150],{},[30,1314,1315],{},"Settings → Remote",[26,1317,1318,1319,150],{},"Enable the remote server. Default port is ",[30,1320,1321],{},"7331",[26,1323,1324,1325,150],{},"Optional: set a token. Clients must send it as a Bearer token or ",[117,1326,1327],{},"?token=",[26,1329,1330,1331,1334,1335,150],{},"Copy the ",[117,1332,1333],{},"http:\u002F\u002FIP:PORT"," URL, or copy the system IP from ",[30,1336,1337],{},"Settings → About",[14,1339,1340],{},"Windows may show a firewall prompt the first time the server starts. Allow private-network access.",[18,1342,241],{"id":1343},"bitfocus-companion",[23,1345,1346,1353,1362,1372],{},[26,1347,1348,1349,150],{},"Install ",[89,1350,241],{"href":1351,"rel":1352},"https:\u002F\u002Fbitfocus.io\u002Fcompanion",[259],[26,1354,1355,1356,1361],{},"Download ",[89,1357,1360],{"href":1358,"rel":1359},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002Fcompanion-module-soundninja\u002Freleases\u002Flatest",[259],"SoundNinja-Companion.tgz",". There is no Companion Store package yet.",[26,1363,1364,1365,1368,1369,150],{},"In Companion: ",[30,1366,1367],{},"Modules → Load module package"," and pick the ",[117,1370,1371],{},".tgz",[26,1373,1374,1375,1378],{},"Add a ",[30,1376,1377],{},"Sound Ninja"," connection. Paste the PC IP, port, and token if you set one.",[18,1380,1382],{"id":1381},"actions","Actions",[67,1384,1385,1391,1397],{},[26,1386,1387,1390],{},[30,1388,1389],{},"Trigger Sound"," — pick from the live dropdown, or type an 8-character sound ID (Companion variables work)",[26,1392,1393,1396],{},[30,1394,1395],{},"Stop Sound"," — stop one playing sound by ID",[26,1398,1399,1402],{},[30,1400,1401],{},"Stop All"," — stop every playing sound",[14,1404,1405],{},"Copy a sound ID in SoundNinja from the button context menu or the multi-select ID chip.",[18,1407,1409],{"id":1408},"feedbacks-and-variables","Feedbacks and variables",[67,1411,1412,1418,1430,1436],{},[26,1413,1414,1417],{},[30,1415,1416],{},"Sound Playing"," — true while that sound ID is active (use it for button color)",[26,1419,1420,1423,1424,1042,1427],{},[117,1421,1422],{},"$(soundninja:connected)"," — ",[117,1425,1426],{},"true",[117,1428,1429],{},"false",[26,1431,1432,1435],{},[117,1433,1434],{},"$(soundninja:playing_count)"," — how many sounds are playing",[26,1437,1438,1441],{},[117,1439,1440],{},"$(soundninja:last_triggered)"," — last triggered sound ID",[18,1443,1445],{"id":1444},"http-api-advanced","HTTP API (advanced)",[14,1447,1448,1449],{},"Base path: ",[117,1450,1451],{},"\u002Fapi\u002Fv1",[67,1453,1454,1460,1466,1472,1482,1488,1497],{},[26,1455,1456,1459],{},[117,1457,1458],{},"GET \u002Finfo"," — app name, version, protocol, whether a token is required",[26,1461,1462,1465],{},[117,1463,1464],{},"GET \u002Fsounds"," — sound list (id, name, tabs, active)",[26,1467,1468,1471],{},[117,1469,1470],{},"GET \u002Fstate"," — sounds plus currently playing IDs",[26,1473,1474,1477,1478,1481],{},[117,1475,1476],{},"POST \u002Ftrigger"," with ",[117,1479,1480],{},"{ \"id\" }"," — play a sound",[26,1483,1484,1487],{},[117,1485,1486],{},"GET \u002Ftrigger\u002F:id"," — play (easy to test in a browser)",[26,1489,1490,1493,1494,1496],{},[117,1491,1492],{},"POST \u002Fstop"," with optional ",[117,1495,1480],{}," — stop one sound or all",[26,1498,1499,1502],{},[117,1500,1501],{},"GET \u002Fws"," — live state; send trigger\u002Fstop commands inbound",{"title":152,"searchDepth":153,"depth":153,"links":1504},[1505,1506,1507,1508,1509],{"id":1307,"depth":153,"text":1308},{"id":1343,"depth":153,"text":241},{"id":1381,"depth":153,"text":1382},{"id":1408,"depth":153,"text":1409},{"id":1444,"depth":153,"text":1445},"Trigger SoundNinja from Bitfocus Companion over the local network.",{},7,"\u002Fremote-control",{"title":1296,"description":1510},"G5BV4-hARZULMfsuLaTyczPL2Qt2QKaPmATZuk65Lik",{"id":1517,"title":1518,"body":1519,"description":1608,"extension":162,"meta":1609,"navigation":164,"order":1610,"path":1611,"seo":1612,"stem":1523,"__hash__":1613},"content_en\u002Fsupport.md","Support",{"type":7,"value":1520,"toc":1601},[1521,1524,1527,1531,1534,1541,1549,1553,1560,1562,1575,1579,1590,1594],[10,1522,1518],{"id":1523},"support",[14,1525,1526],{},"SoundNinja is a community project in early beta. The fastest way to get help is GitHub.",[18,1528,1530],{"id":1529},"report-a-bug-or-ask-a-question","Report a bug or ask a question",[14,1532,1533],{},"Open an issue on GitHub:",[14,1535,1536],{},[89,1537,1540],{"href":1538,"rel":1539},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fissues",[259],"github.com\u002Fmarcus-universe\u002FSoundNinja\u002Fissues",[14,1542,1543,1544,101,1546,1548],{},"Include your OS, SoundNinja version (",[30,1545,415],{},[30,1547,1337],{},"), and steps to reproduce.",[18,1550,1552],{"id":1551},"email","Email",[14,1554,1555,1556],{},"Maintainer contact: ",[89,1557,1559],{"href":1558},"mailto:contact@marcus-universe.de","contact@marcus-universe.de",[18,1561,409],{"id":408},[14,1563,1564,1565,1567,1568,1570,1571,150],{},"In the app, use ",[30,1566,415],{},". New builds also appear on the ",[89,1569,311],{"href":310}," and on ",[89,1572,317],{"href":1573,"rel":1574},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Freleases",[259],[18,1576,1578],{"id":1577},"contribute","Contribute",[14,1580,1581,1582,1586,1587,150],{},"Pull requests are welcome. The app repo is ",[89,1583,1585],{"href":426,"rel":1584},[259],"github.com\u002Fmarcus-universe\u002FSoundNinja",". The project is licensed under ",[89,1588,260],{"href":257,"rel":1589},[259],[18,1591,1593],{"id":1592},"legal","Legal",[14,1595,1596,1597,150],{},"Imprint and contact details: ",[89,1598,1600],{"href":1599},"\u002Fimpressum","Impressum",{"title":152,"searchDepth":153,"depth":153,"links":1602},[1603,1604,1605,1606,1607],{"id":1529,"depth":153,"text":1530},{"id":1551,"depth":153,"text":1552},{"id":408,"depth":153,"text":409},{"id":1577,"depth":153,"text":1578},{"id":1592,"depth":153,"text":1593},"Where to get help and report bugs.",{},8,"\u002Fsupport",{"title":1518,"description":1608},"jRExoghmWgAfTmnmgqLhtQedAnIjqFIbv0_OahYrhTc",1789597755449]