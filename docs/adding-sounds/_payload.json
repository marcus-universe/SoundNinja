[{"data":1,"prerenderedAt":1593},["ShallowReactive",2],{"docs-page-en-\u002Fadding-sounds":3,"docs-nav-en":169},{"id":4,"title":5,"body":6,"description":161,"extension":162,"meta":163,"navigation":164,"order":165,"path":166,"seo":167,"stem":12,"__hash__":168},"content_en\u002Fadding-sounds.md","Adding Sounds",{"type":7,"value":8,"toc":151},"minimark",[9,13,17,22,44,48,81,85,106,110,125,128,132,139,143],[10,11,5],"h1",{"id":12},"adding-sounds",[14,15,16],"p",{},"A board is empty until you add clips. SoundNinja can import files, whole folders, a recording, or a shared soundboard pack.",[18,19,21],"h2",{"id":20},"import-audio-files","Import audio files",[23,24,25,38,41],"ol",{},[26,27,28,29,33,34,37],"li",{},"Open ",[30,31,32],"strong",{},"File → Import Audio Files",", or use ",[30,35,36],{},"Import"," in the navbar.",[26,39,40],{},"Pick one or more audio files.",[26,42,43],{},"Sounds land in the current tab.",[18,45,47],{"id":46},"import-folders","Import folders",[23,49,50,60,63],{},[26,51,28,52,55,56,59],{},[30,53,54],{},"File → Import Folders"," (or ",[30,57,58],{},"Import Folders"," in the navbar).",[26,61,62],{},"Add one or more folders. Drag to reorder them before you import.",[26,64,65,66],{},"Choose how they land:\n",[67,68,69,75],"ul",{},[26,70,71,74],{},[30,72,73],{},"Import as Tabs"," — each folder becomes its own tab",[26,76,77,80],{},[30,78,79],{},"Import to current Tab"," — every file goes into the active tab",[18,82,84],{"id":83},"record-a-clip","Record a clip",[14,86,87,88,93,94,97,98,101,102,105],{},"Open the ",[89,90,92],"a",{"href":91},"\u002Fdocs\u002Frecording-editor","Record Editor"," from the ",[30,95,96],{},"Record"," button in the player bar. Capture, trim, then ",[30,99,100],{},"Import selected"," or ",[30,103,104],{},"Import all"," into the current tab or a tab you pick.",[18,107,109],{"id":108},"import-a-soundboard","Import a soundboard",[14,111,112,115,116,120,121,124],{},[30,113,114],{},"File → Import Soundboard"," loads a shared pack. Packs are a ",[117,118,119],"code",{},".zip"," that contains ",[117,122,123],{},"project.sninja"," plus the sound files. After import, open the project and play.",[14,126,127],{},"You can also keep several projects (profiles). Use the project selector to switch boards.",[18,129,131],{"id":130},"relink-missing-files","Relink missing files",[14,133,134,135,138],{},"If audio files move on disk, SoundNinja shows a ",[30,136,137],{},"Missing sound files"," dialog. Pick a folder to search and relink the clips.",[18,140,142],{"id":141},"next","Next",[14,144,145,146,150],{},"Organize tabs, tags, filters, and hotkeys in ",[89,147,149],{"href":148},"\u002Fdocs\u002Forganizing-sounds","Organizing Sounds",".",{"title":152,"searchDepth":153,"depth":153,"links":154},"",2,[155,156,157,158,159,160],{"id":20,"depth":153,"text":21},{"id":46,"depth":153,"text":47},{"id":83,"depth":153,"text":84},{"id":108,"depth":153,"text":109},{"id":130,"depth":153,"text":131},{"id":141,"depth":153,"text":142},"Import audio, folders, recordings, and shared soundboards.","md",{},true,3,"\u002Fadding-sounds",{"title":5,"description":161},"SBUvL_H4633CrDyNUKazqKwru4aq1hhgoH4_o99rBsE",[170,297,498,589,992,1127,1273,1495],{"id":171,"title":172,"body":173,"description":291,"extension":162,"meta":292,"navigation":164,"order":293,"path":294,"seo":295,"stem":177,"__hash__":296},"content_en\u002Foverview.md","Overview",{"type":7,"value":174,"toc":285},[175,178,181,184,187,191,205,209,248,252,262,266],[10,176,172],{"id":177},"overview",[14,179,180],{},"SoundNinja is an open-source soundboard for live streaming, chatting with friends, and podcast recording. It is built with Tauri v2 and Nuxt 4 so it stays light on RAM and disk.",[14,182,183],{},"The goal is simple: keep a huge sound library easy to scan, then play the right clip in milliseconds. The UI also works well as a dashboard in VR.",[14,185,186],{},"SoundNinja is still in early development. Features work, but not every platform is fully tested.",[18,188,190],{"id":189},"who-it-is-for","Who it is for",[67,192,193,196,199,202],{},[26,194,195],{},"Streamers who need instant sound cues",[26,197,198],{},"Friends who want a shared board for voice chat",[26,200,201],{},"Podcasters who record clips and drop them onto a board",[26,203,204],{},"Anyone who wants a customizable, local-first soundboard",[18,206,208],{"id":207},"what-you-can-do","What you can do",[67,210,211,214,217,220,223,226,229,232,235,242,245],{},[26,212,213],{},"Build a soundboard from your own audio files",[26,215,216],{},"Organize sounds in colored tabs, groups, tags, and search",[26,218,219],{},"Filter by tags (OR) and sort by name, date, duration, or size",[26,221,222],{},"Multi-select with marquee or Shift-range, then bulk color, move, or delete",[26,224,225],{},"Set per-sound volume from the context menu",[26,227,228],{},"Design the look with the Theme Creator",[26,230,231],{},"Record PC audio or a microphone in the Record Editor",[26,233,234],{},"Assign hotkeys to individual sounds",[26,236,237,238],{},"Trigger sounds from ",[89,239,241],{"href":240},"\u002Fdocs\u002Fremote-control","Bitfocus Companion",[26,243,244],{},"Import and export a full soundboard to share with others",[26,246,247],{},"Use GIFs or images on sound buttons — from a local folder library or KLIPY",[18,249,251],{"id":250},"license","License",[14,253,254,255,261],{},"SoundNinja is free software under ",[89,256,260],{"href":257,"rel":258},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fblob\u002Fmain\u002FLICENSE",[259],"nofollow","GPL-3.0",". Fork it, change it, share it.",[18,263,265],{"id":264},"next-steps","Next steps",[23,267,268,274,280],{},[26,269,270],{},[89,271,273],{"href":272},"\u002Fdocs\u002Finstallation","Install SoundNinja",[26,275,276],{},[89,277,279],{"href":278},"\u002Fdocs\u002Fadding-sounds","Add sounds",[26,281,282],{},[89,283,284],{"href":148},"Organize your board",{"title":152,"searchDepth":153,"depth":153,"links":286},[287,288,289,290],{"id":189,"depth":153,"text":190},{"id":207,"depth":153,"text":208},{"id":250,"depth":153,"text":251},{"id":264,"depth":153,"text":265},"What SoundNinja is and what you can do with it.",{},1,"\u002Foverview",{"title":172,"description":291},"Dax9ydiOOeEz5F1IxWfEljWZynntK7dPp52JZ3q2G58",{"id":298,"title":299,"body":300,"description":493,"extension":162,"meta":494,"navigation":164,"order":153,"path":495,"seo":496,"stem":304,"__hash__":497},"content_en\u002Finstallation.md","Installation",{"type":7,"value":301,"toc":486},[302,305,319,323,343,346,350,364,367,371,395,406,410,417,421,436,466,482],[10,303,299],{"id":304},"installation",[14,306,307,308,312,313,318],{},"Grab a build from the ",[89,309,311],{"href":310},"\u002Fdownload","Download page"," or from ",[89,314,317],{"href":315,"rel":316},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Freleases\u002Flatest",[259],"GitHub Releases",". SoundNinja is in early development, so treat builds as beta.",[18,320,322],{"id":321},"windows","Windows",[67,324,325,334,337,340],{},[26,326,327,101,330,333],{},[30,328,329],{},"Installer (.exe)",[30,331,332],{},"MSI (.msi)"," for 64-bit Windows",[26,335,336],{},"Landing page target: Windows 10 and newer",[26,338,339],{},"The app README also lists Windows 8 and above",[26,341,342],{},"The NSIS installer uses a dark theme. Pick a language during setup — SoundNinja remembers it on the next launch.",[14,344,345],{},"Run the installer, then launch SoundNinja from the Start menu.",[18,347,349],{"id":348},"macos","macOS",[67,351,352,358,361],{},[26,353,354,357],{},[30,355,356],{},"Universal .dmg"," for Apple Silicon and Intel",[26,359,360],{},"Landing page target: macOS 10.14 and newer",[26,362,363],{},"The app README lists macOS 10.15 and above",[14,365,366],{},"Open the disk image and drag SoundNinja to Applications.",[18,368,370],{"id":369},"linux","Linux",[67,372,373,379,385,392],{},[26,374,375,378],{},[30,376,377],{},"Debian (.deb)"," for Ubuntu \u002F Debian",[26,380,381,384],{},[30,382,383],{},"AppImage"," for other distros",[26,386,387,388,391],{},"After a release is published, Arch users can install ",[117,389,390],{},"soundninja-bin"," from the AUR",[26,393,394],{},"Tested on Ubuntu 20.04",[14,396,397,398,401,402,405],{},"Desktop builds need WebKit and GTK packages. On Debian\u002FUbuntu that usually means ",[117,399,400],{},"libwebkit2gtk",", ",[117,403,404],{},"libgtk-3-0",", and an app-indicator library.",[18,407,409],{"id":408},"updates","Updates",[14,411,412,413,416],{},"In the app, open ",[30,414,415],{},"Help → Check for Updates",". You can also let SoundNinja check on startup in Settings.",[18,418,420],{"id":419},"build-from-source","Build from source",[14,422,423,424,429,430,435],{},"Need a custom build? Clone ",[89,425,428],{"href":426,"rel":427},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja",[259],"the repo",", install ",[89,431,434],{"href":432,"rel":433},"https:\u002F\u002Fv2.tauri.app\u002Fstart\u002Fprerequisites\u002F",[259],"Tauri prerequisites",", then:",[437,438,442],"pre",{"className":439,"code":440,"language":441,"meta":152,"style":152},"language-bash shiki shiki-themes github-light github-dark","bun install\nbun run tauri:serve\n","bash",[117,443,444,456],{"__ignoreMap":152},[445,446,448,452],"span",{"class":447,"line":293},"line",[445,449,451],{"class":450},"sScJk","bun",[445,453,455],{"class":454},"sZZnC"," install\n",[445,457,458,460,463],{"class":447,"line":153},[445,459,451],{"class":450},[445,461,462],{"class":454}," run",[445,464,465],{"class":454}," tauri:serve\n",[14,467,468,401,471,474,475,478,479,150],{},[117,469,470],{},"npm",[117,472,473],{},"pnpm",", or ",[117,476,477],{},"deno"," work too. Production build: ",[117,480,481],{},"bun run tauri:build",[483,484,485],"style",{},"html pre.shiki code .sScJk, html code.shiki .sScJk{--shiki-default:#6F42C1;--shiki-dark:#B392F0}html pre.shiki code .sZZnC, html code.shiki .sZZnC{--shiki-default:#032F62;--shiki-dark:#9ECBFF}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html.dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}",{"title":152,"searchDepth":153,"depth":153,"links":487},[488,489,490,491,492],{"id":321,"depth":153,"text":322},{"id":348,"depth":153,"text":349},{"id":369,"depth":153,"text":370},{"id":408,"depth":153,"text":409},{"id":419,"depth":153,"text":420},"Install SoundNinja on Windows, macOS, or Linux.",{},"\u002Finstallation",{"title":299,"description":493},"7viacDB8R6wsHmYhw6wWPv9XZF7nR_yMjR5-EjD4OjQ",{"id":4,"title":5,"body":499,"description":161,"extension":162,"meta":587,"navigation":164,"order":165,"path":166,"seo":588,"stem":12,"__hash__":168},{"type":7,"value":500,"toc":579},[501,503,505,507,519,521,543,545,555,557,565,567,569,573,575],[10,502,5],{"id":12},[14,504,16],{},[18,506,21],{"id":20},[23,508,509,515,517],{},[26,510,28,511,33,513,37],{},[30,512,32],{},[30,514,36],{},[26,516,40],{},[26,518,43],{},[18,520,47],{"id":46},[23,522,523,529,531],{},[26,524,28,525,55,527,59],{},[30,526,54],{},[30,528,58],{},[26,530,62],{},[26,532,65,533],{},[67,534,535,539],{},[26,536,537,74],{},[30,538,73],{},[26,540,541,80],{},[30,542,79],{},[18,544,84],{"id":83},[14,546,87,547,93,549,97,551,101,553,105],{},[89,548,92],{"href":91},[30,550,96],{},[30,552,100],{},[30,554,104],{},[18,556,109],{"id":108},[14,558,559,115,561,120,563,124],{},[30,560,114],{},[117,562,119],{},[117,564,123],{},[14,566,127],{},[18,568,131],{"id":130},[14,570,134,571,138],{},[30,572,137],{},[18,574,142],{"id":141},[14,576,145,577,150],{},[89,578,149],{"href":148},{"title":152,"searchDepth":153,"depth":153,"links":580},[581,582,583,584,585,586],{"id":20,"depth":153,"text":21},{"id":46,"depth":153,"text":47},{"id":83,"depth":153,"text":84},{"id":108,"depth":153,"text":109},{"id":130,"depth":153,"text":131},{"id":141,"depth":153,"text":142},{},{"title":5,"description":161},{"id":590,"title":149,"body":591,"description":986,"extension":162,"meta":987,"navigation":164,"order":988,"path":989,"seo":990,"stem":595,"__hash__":991},"content_en\u002Forganizing-sounds.md",{"type":7,"value":592,"toc":971},[593,596,603,607,634,641,645,648,662,669,675,679,689,694,726,730,736,740,773,779,783,786,813,816,820,834,838,844,865,881,888,892,902,905,909,916,926,932,936,944,951,968],[10,594,149],{"id":595},"organizing-sounds",[14,597,598,599,602],{},"SoundNinja is built for large libraries. Use ",[30,600,601],{},"tags and filters",", tabs, search, multi-select, and hotkeys so the clip you need is one click (or one key) away.",[18,604,606],{"id":605},"tabs","Tabs",[67,608,609,616,623],{},[26,610,611,612,615],{},"Add a tab with ",[30,613,614],{},"Add tab",". Give it a color so you can scan the bar fast.",[26,617,618,619,622],{},"The ",[30,620,621],{},"All"," view shows every sound across tabs.",[26,624,625,626,629,630,633],{},"A sound can belong to ",[30,627,628],{},"one or more tabs",". Right-click a sound and use ",[30,631,632],{},"Move to tab"," to assign it.",[14,635,636,637,640],{},"Tab transitions live in ",[30,638,639],{},"Settings → Main",": Slide, Fade, Buttons one by one, or None.",[18,642,644],{"id":643},"groups","Groups",[14,646,647],{},"Since v0.5.3, separators can become named groups:",[67,649,650,653,656,659],{},[26,651,652],{},"Add, rename, or remove a group from the context menu",[26,654,655],{},"Drag the group header — children move with it",[26,657,658],{},"Drop sounds in or out of a group",[26,660,661],{},"Set group border color, name color, and button alignment (or use the tab default)",[14,663,664,665,668],{},"You can still add a plain ",[30,666,667],{},"Separator"," if you only need a visual break.",[14,670,671,672,150],{},"Right-click empty board space to ",[30,673,674],{},"Add Group",[18,676,678],{"id":677},"tags-filters","Tags \u002F Filters",[14,680,681,682,685,686,688],{},"Tags cut across tabs. The slide-out ",[30,683,684],{},"Filter"," panel (sidebar ",[30,687,684],{},") is where you create them and turn them into a board filter.",[690,691,693],"h3",{"id":692},"create-and-edit-tags","Create and edit tags",[23,695,696,701,712,719],{},[26,697,28,698,700],{},[30,699,684],{}," in the sidebar.",[26,702,703,704,707,708,711],{},"Under ",[30,705,706],{},"Tags",", use ",[30,709,710],{},"Add tag"," — give it a name and a color.",[26,713,714,715,718],{},"Rename, recolor, or ",[30,716,717],{},"Delete tag"," from the same list.",[26,720,721,722,725],{},"If you see ",[30,723,724],{},"No tags yet",", add one here before you assign anything.",[690,727,729],{"id":728},"assign-tags-to-sounds","Assign tags to sounds",[14,731,732,733,735],{},"Right-click a sound → ",[30,734,706],{}," (checkboxes). A sound can have several tags. If none exist yet, the menu tells you to open the filter panel.",[690,737,739],{"id":738},"filter-the-board","Filter the board",[67,741,742,748,759,770],{},[26,743,744,745,150],{},"Toggle tags in the Filter panel, or as ",[30,746,747],{},"chips under the search bar",[26,749,750,751,754,755,758],{},"Matching is ",[30,752,753],{},"OR",": a sound stays visible if it has ",[30,756,757],{},"any"," selected tag.",[26,760,761,762,765,766,769],{},"The navbar ",[30,763,764],{},"Search"," field ",[30,767,768],{},"ANDs"," with the active tag filter (type + tags together).",[26,771,772],{},"Turn chips off (or clear the filter) to show the full tab again.",[14,774,775,776,150],{},"Colored tag names can appear on buttons. Toggle them in ",[30,777,778],{},"Settings → Behavior → Show tag badges",[18,780,782],{"id":781},"sort","Sort",[14,784,785],{},"Open the filter panel and pick a sort mode:",[67,787,788,794],{},[26,789,790,793],{},[30,791,792],{},"User defined"," — your tab order, with groups visible",[26,795,796,401,799,401,802,474,805,808,809,812],{},[30,797,798],{},"Name",[30,800,801],{},"Added time",[30,803,804],{},"Play time",[30,806,807],{},"File size"," — a flat sorted list; ",[30,810,811],{},"groups are hidden"," in these modes",[14,814,815],{},"Duration sort may warm duration metadata the first time you use it.",[18,817,819],{"id":818},"reorder","Reorder",[14,821,822,823,826,827,830,831,833],{},"Turn on drag-and-drop in ",[30,824,825],{},"Settings → Behavior"," (",[30,828,829],{},"Allow reorder","). Then drag sounds and groups into place. Reorder applies in ",[30,832,792],{}," sort.",[18,835,837],{"id":836},"multi-select","Multi-select",[14,839,840,841,843],{},"Turn on ",[30,842,837],{}," in the navbar, then:",[67,845,846,849,855,862],{},[26,847,848],{},"Click a sound to toggle it",[26,850,851,854],{},[30,852,853],{},"Shift+click"," to select a range from the last anchor",[26,856,857,858,861],{},"Drag a ",[30,859,860],{},"marquee"," on empty board space",[26,863,864],{},"Click empty board (or outside) to clear the selection",[14,866,867,868,401,871,401,874,877,878,150],{},"A bulk bar appears with the count, plus ",[30,869,870],{},"Color",[30,872,873],{},"Move to tab…",[30,875,876],{},"Delete",", and ",[30,879,880],{},"Done",[14,882,883,884,887],{},"In multi-select, each button shows an ",[30,885,886],{},"8-character ID chip",". Right-click the chip to copy it.",[18,889,891],{"id":890},"per-sound-volume","Per-sound volume",[14,893,732,894,897,898,901],{},[30,895,896],{},"Volume",". Drag the slider from 0% to 100%. ",[30,899,900],{},"Double-click"," the slider to reset to 100%.",[14,903,904],{},"This stacks with the master output volume in Settings.",[18,906,908],{"id":907},"hotkeys-and-sound-ids","Hotkeys and sound IDs",[14,910,911,912,915],{},"Every sound has an 8-character ID. Copy it from the button context menu (",[30,913,914],{},"Copy ID",") or the multi-select ID chip.",[14,917,28,918,921,922,925],{},[30,919,920],{},"Settings → Hotkeys"," to bind a key to a sound ID. Global hotkeys are optional. ",[30,923,924],{},"Assign hotkey"," on the context menu jumps there with the ID prefilled.",[14,927,928,929,931],{},"The same ID is what ",[89,930,241],{"href":240}," uses to trigger a clip.",[18,933,935],{"id":934},"background-images-and-colors","Background images and colors",[14,937,938,939,943],{},"Right-click a sound to set per-button colors or a background image. That is separate from the ",[89,940,942],{"href":941},"\u002Fdocs\u002Ftheme-editor","Theme Creator",", which styles the whole board.",[14,945,946,947,950],{},"The picker is a ",[30,948,949],{},"Background image"," dialog (PNG, JPEG, GIF, WebP):",[67,952,953,959],{},[26,954,955,958],{},[30,956,957],{},"Local files"," — add folders, pick a single file, search filenames, preview the grid, or remove a folder from the library",[26,960,961,964,965,967],{},[30,962,963],{},"KLIPY"," — search online GIFs. Set your own API key in ",[30,966,825],{},". The key is not stored in project files.",[14,969,970],{},"After you pick an image, pan and crop it on the button.",{"title":152,"searchDepth":153,"depth":153,"links":972},[973,974,975,980,981,982,983,984,985],{"id":605,"depth":153,"text":606},{"id":643,"depth":153,"text":644},{"id":677,"depth":153,"text":678,"children":976},[977,978,979],{"id":692,"depth":165,"text":693},{"id":728,"depth":165,"text":729},{"id":738,"depth":165,"text":739},{"id":781,"depth":153,"text":782},{"id":818,"depth":153,"text":819},{"id":836,"depth":153,"text":837},{"id":890,"depth":153,"text":891},{"id":907,"depth":153,"text":908},{"id":934,"depth":153,"text":935},"Tags, filters, tabs, groups, sort, multi-select, volume, and hotkeys.",{},4,"\u002Forganizing-sounds",{"title":149,"description":986},"DaYqySVuX1kgdTnJw6h1GP_lGyj4zdFP2uKKbBEbVwQ",{"id":993,"title":994,"body":995,"description":1121,"extension":162,"meta":1122,"navigation":164,"order":1123,"path":1124,"seo":1125,"stem":999,"__hash__":1126},"content_en\u002Ftheme-editor.md","Theme Editor",{"type":7,"value":996,"toc":1115},[997,1000,1006,1010,1037,1040,1044,1058,1062,1088,1091,1095,1101],[10,998,994],{"id":999},"theme-editor",[14,1001,1002,1003,150],{},"The Theme Creator is the full visual editor for your board. Open it from ",[30,1004,1005],{},"Settings → Main → Theme Creator",[18,1007,1009],{"id":1008},"three-tabs","Three tabs",[23,1011,1012,1026,1032],{},[26,1013,1014,1017,1018,1021,1022,1025],{},[30,1015,1016],{},"General"," — theme name, shared colors, and font uploads (",[117,1019,1020],{},".ttf"," \u002F ",[117,1023,1024],{},".otf",")",[26,1027,1028,1031],{},[30,1029,1030],{},"Buttons"," — sound button colors, type, layout, and GIF overlay",[26,1033,1034,1036],{},[30,1035,606],{}," — tab bar colors, type, and border thickness",[14,1038,1039],{},"A live preview shows tabs and buttons as you edit.",[18,1041,1043],{"id":1042},"what-you-can-change","What you can change",[67,1045,1046,1049,1052,1055],{},[26,1047,1048],{},"Primary and accent colors, backgrounds, button colors, tab colors",[26,1050,1051],{},"Button and tab font family and size",[26,1053,1054],{},"Button width, radius, border width, gaps, and padding",[26,1056,1057],{},"GIF overlay opacity (normal and hover)",[18,1059,1061],{"id":1060},"save-and-share","Save and share",[67,1063,1064,1070,1076,1082],{},[26,1065,1066,1069],{},[30,1067,1068],{},"Export .css"," — write a theme file you can back up or send to a friend",[26,1071,1072,1075],{},[30,1073,1074],{},"Add to Themes"," — save the file into your Themes folder and apply it",[26,1077,1078,1081],{},[30,1079,1080],{},"Import .css"," — load a built-in preset or a saved theme",[26,1083,1084,1087],{},[30,1085,1086],{},"Reset"," — return to SoundNinja defaults",[14,1089,1090],{},"If you close the window with unsaved changes, SoundNinja asks you to save first.",[18,1092,1094],{"id":1093},"without-the-full-editor","Without the full editor",[14,1096,1097,1098,1100],{},"In ",[30,1099,639],{}," you can still:",[67,1102,1103,1106,1112],{},[26,1104,1105],{},"Pick a theme from the list",[26,1107,1108,1109,1025],{},"Edit CSS variables live (",[30,1110,1111],{},"Custom CSS",[26,1113,1114],{},"Import a theme file into the Themes folder",{"title":152,"searchDepth":153,"depth":153,"links":1116},[1117,1118,1119,1120],{"id":1008,"depth":153,"text":1009},{"id":1042,"depth":153,"text":1043},{"id":1060,"depth":153,"text":1061},{"id":1093,"depth":153,"text":1094},"Design colors, fonts, buttons, and tabs in the Theme Creator.",{},5,"\u002Ftheme-editor",{"title":994,"description":1121},"zpMjxENa49aUipEX7TBxcqrbaZNweyJ019KsLAMJeoc",{"id":1128,"title":1129,"body":1130,"description":1267,"extension":162,"meta":1268,"navigation":164,"order":1269,"path":1270,"seo":1271,"stem":1134,"__hash__":1272},"content_en\u002Frecording-editor.md","Recording Editor",{"type":7,"value":1131,"toc":1261},[1132,1135,1141,1145,1151,1171,1174,1178,1203,1207,1222,1226,1240,1251],[10,1133,1129],{"id":1134},"recording-editor",[14,1136,1137,1138,1140],{},"Record a clip inside SoundNinja, trim it, then import it onto a tab. Open the editor with the ",[30,1139,96],{}," button in the player bar.",[18,1142,1144],{"id":1143},"choose-an-input","Choose an input",[14,1146,1097,1147,1150],{},[30,1148,1149],{},"Settings → Audio",":",[67,1152,1153,1159,1165],{},[26,1154,1155,1158],{},[30,1156,1157],{},"Input Devices"," — microphone",[26,1160,1161,1164],{},[30,1162,1163],{},"Output Devices (PC Audio)"," — loopback of what your PC is playing",[26,1166,1167,1170],{},[30,1168,1169],{},"Input volume"," — capture gain from 0% to 200%",[14,1172,1173],{},"The Record button uses the device you pick here.",[18,1175,1177],{"id":1176},"edit-the-take","Edit the take",[67,1179,1180,1183,1186,1194,1197,1200],{},[26,1181,1182],{},"Record and stop",[26,1184,1185],{},"Watch the input level meter",[26,1187,1188,101,1191],{},[30,1189,1190],{},"Normalize",[30,1192,1193],{},"Noise Cancelation",[26,1195,1196],{},"Trim the whole clip, trim to a selection, or delete a selection",[26,1198,1199],{},"Undo \u002F redo",[26,1201,1202],{},"Zoom in and out",[18,1204,1206],{"id":1205},"stage-and-import","Stage and import",[23,1208,1209,1212,1215],{},[26,1210,1211],{},"Add the selection or the full track to the staging list.",[26,1213,1214],{},"The list starts empty: record, edit, then add a clip.",[26,1216,1217,101,1219,1221],{},[30,1218,100],{},[30,1220,104],{}," into the current tab or a tab you choose.",[18,1223,1225],{"id":1224},"stem-separation-optional","Stem separation (optional)",[14,1227,1228,1229,1232,1233,101,1236,1239],{},"Official Windows, macOS, and Linux release builds ship the ",[30,1230,1231],{},"stems"," feature. The Record Editor can keep ",[30,1234,1235],{},"vocals",[30,1237,1238],{},"music"," using BS-RoFormer.",[14,1241,1242,1243,1246,1247,1250],{},"The model is about 158 MB and is ",[30,1244,1245],{},"not"," bundled with the installer. Download it from ",[30,1248,1249],{},"Settings → Stem Separation",", or accept the first-run prompt. The Windows installer can also offer to download the model on first launch.",[14,1252,1253,1254,1021,1257,1260],{},"Custom source builds need an extra flag (",[117,1255,1256],{},"tauri:serve:stems",[117,1258,1259],{},"tauri:build:stems",").",{"title":152,"searchDepth":153,"depth":153,"links":1262},[1263,1264,1265,1266],{"id":1143,"depth":153,"text":1144},{"id":1176,"depth":153,"text":1177},{"id":1205,"depth":153,"text":1206},{"id":1224,"depth":153,"text":1225},"Capture mic or PC audio, edit the clip, and drop it on your board.",{},6,"\u002Frecording-editor",{"title":1129,"description":1267},"WLz7ozLeboeLKawRkz53eUj5KSVCj4xkPMhYg5P_MIo",{"id":1274,"title":1275,"body":1276,"description":1489,"extension":162,"meta":1490,"navigation":164,"order":1491,"path":1492,"seo":1493,"stem":1280,"__hash__":1494},"content_en\u002Fremote-control.md","Remote Control",{"type":7,"value":1277,"toc":1482},[1278,1281,1284,1288,1317,1320,1323,1358,1362,1382,1385,1389,1421,1425,1431],[10,1279,1275],{"id":1280},"remote-control",[14,1282,1283],{},"SoundNinja can listen on your local network so Bitfocus Companion (or any HTTP\u002FWebSocket client) can play and stop sounds.",[18,1285,1287],{"id":1286},"enable-the-remote-server","Enable the remote server",[23,1289,1290,1295,1301,1307],{},[26,1291,28,1292,150],{},[30,1293,1294],{},"Settings → Remote",[26,1296,1297,1298,150],{},"Enable the remote server. Default port is ",[30,1299,1300],{},"7331",[26,1302,1303,1304,150],{},"Optional: set a token. Clients must send it as a Bearer token or ",[117,1305,1306],{},"?token=",[26,1308,1309,1310,1313,1314,150],{},"Copy the ",[117,1311,1312],{},"http:\u002F\u002FIP:PORT"," URL, or copy the system IP from ",[30,1315,1316],{},"Settings → About",[14,1318,1319],{},"Windows may show a firewall prompt the first time the server starts. Allow private-network access.",[18,1321,241],{"id":1322},"bitfocus-companion",[23,1324,1325,1332,1341,1351],{},[26,1326,1327,1328,150],{},"Install ",[89,1329,241],{"href":1330,"rel":1331},"https:\u002F\u002Fbitfocus.io\u002Fcompanion",[259],[26,1333,1334,1335,1340],{},"Download ",[89,1336,1339],{"href":1337,"rel":1338},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002Fcompanion-module-soundninja\u002Freleases\u002Flatest",[259],"SoundNinja-Companion.tgz",". There is no Companion Store package yet.",[26,1342,1343,1344,1347,1348,150],{},"In Companion: ",[30,1345,1346],{},"Modules → Load module package"," and pick the ",[117,1349,1350],{},".tgz",[26,1352,1353,1354,1357],{},"Add a ",[30,1355,1356],{},"Sound Ninja"," connection. Paste the PC IP, port, and token if you set one.",[18,1359,1361],{"id":1360},"actions","Actions",[67,1363,1364,1370,1376],{},[26,1365,1366,1369],{},[30,1367,1368],{},"Trigger Sound"," — pick from the live dropdown, or type an 8-character sound ID (Companion variables work)",[26,1371,1372,1375],{},[30,1373,1374],{},"Stop Sound"," — stop one playing sound by ID",[26,1377,1378,1381],{},[30,1379,1380],{},"Stop All"," — stop every playing sound",[14,1383,1384],{},"Copy a sound ID in SoundNinja from the button context menu or the multi-select ID chip.",[18,1386,1388],{"id":1387},"feedbacks-and-variables","Feedbacks and variables",[67,1390,1391,1397,1409,1415],{},[26,1392,1393,1396],{},[30,1394,1395],{},"Sound Playing"," — true while that sound ID is active (use it for button color)",[26,1398,1399,1402,1403,1021,1406],{},[117,1400,1401],{},"$(soundninja:connected)"," — ",[117,1404,1405],{},"true",[117,1407,1408],{},"false",[26,1410,1411,1414],{},[117,1412,1413],{},"$(soundninja:playing_count)"," — how many sounds are playing",[26,1416,1417,1420],{},[117,1418,1419],{},"$(soundninja:last_triggered)"," — last triggered sound ID",[18,1422,1424],{"id":1423},"http-api-advanced","HTTP API (advanced)",[14,1426,1427,1428],{},"Base path: ",[117,1429,1430],{},"\u002Fapi\u002Fv1",[67,1432,1433,1439,1445,1451,1461,1467,1476],{},[26,1434,1435,1438],{},[117,1436,1437],{},"GET \u002Finfo"," — app name, version, protocol, whether a token is required",[26,1440,1441,1444],{},[117,1442,1443],{},"GET \u002Fsounds"," — sound list (id, name, tabs, active)",[26,1446,1447,1450],{},[117,1448,1449],{},"GET \u002Fstate"," — sounds plus currently playing IDs",[26,1452,1453,1456,1457,1460],{},[117,1454,1455],{},"POST \u002Ftrigger"," with ",[117,1458,1459],{},"{ \"id\" }"," — play a sound",[26,1462,1463,1466],{},[117,1464,1465],{},"GET \u002Ftrigger\u002F:id"," — play (easy to test in a browser)",[26,1468,1469,1472,1473,1475],{},[117,1470,1471],{},"POST \u002Fstop"," with optional ",[117,1474,1459],{}," — stop one sound or all",[26,1477,1478,1481],{},[117,1479,1480],{},"GET \u002Fws"," — live state; send trigger\u002Fstop commands inbound",{"title":152,"searchDepth":153,"depth":153,"links":1483},[1484,1485,1486,1487,1488],{"id":1286,"depth":153,"text":1287},{"id":1322,"depth":153,"text":241},{"id":1360,"depth":153,"text":1361},{"id":1387,"depth":153,"text":1388},{"id":1423,"depth":153,"text":1424},"Trigger SoundNinja from Bitfocus Companion over the local network.",{},7,"\u002Fremote-control",{"title":1275,"description":1489},"G5BV4-hARZULMfsuLaTyczPL2Qt2QKaPmATZuk65Lik",{"id":1496,"title":1497,"body":1498,"description":1587,"extension":162,"meta":1588,"navigation":164,"order":1589,"path":1590,"seo":1591,"stem":1502,"__hash__":1592},"content_en\u002Fsupport.md","Support",{"type":7,"value":1499,"toc":1580},[1500,1503,1506,1510,1513,1520,1528,1532,1539,1541,1554,1558,1569,1573],[10,1501,1497],{"id":1502},"support",[14,1504,1505],{},"SoundNinja is a community project in early beta. The fastest way to get help is GitHub.",[18,1507,1509],{"id":1508},"report-a-bug-or-ask-a-question","Report a bug or ask a question",[14,1511,1512],{},"Open an issue on GitHub:",[14,1514,1515],{},[89,1516,1519],{"href":1517,"rel":1518},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fissues",[259],"github.com\u002Fmarcus-universe\u002FSoundNinja\u002Fissues",[14,1521,1522,1523,101,1525,1527],{},"Include your OS, SoundNinja version (",[30,1524,415],{},[30,1526,1316],{},"), and steps to reproduce.",[18,1529,1531],{"id":1530},"email","Email",[14,1533,1534,1535],{},"Maintainer contact: ",[89,1536,1538],{"href":1537},"mailto:contact@marcus-universe.de","contact@marcus-universe.de",[18,1540,409],{"id":408},[14,1542,1543,1544,1546,1547,1549,1550,150],{},"In the app, use ",[30,1545,415],{},". New builds also appear on the ",[89,1548,311],{"href":310}," and on ",[89,1551,317],{"href":1552,"rel":1553},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Freleases",[259],[18,1555,1557],{"id":1556},"contribute","Contribute",[14,1559,1560,1561,1565,1566,150],{},"Pull requests are welcome. The app repo is ",[89,1562,1564],{"href":426,"rel":1563},[259],"github.com\u002Fmarcus-universe\u002FSoundNinja",". The project is licensed under ",[89,1567,260],{"href":257,"rel":1568},[259],[18,1570,1572],{"id":1571},"legal","Legal",[14,1574,1575,1576,150],{},"Imprint and contact details: ",[89,1577,1579],{"href":1578},"\u002Fimpressum","Impressum",{"title":152,"searchDepth":153,"depth":153,"links":1581},[1582,1583,1584,1585,1586],{"id":1508,"depth":153,"text":1509},{"id":1530,"depth":153,"text":1531},{"id":408,"depth":153,"text":409},{"id":1556,"depth":153,"text":1557},{"id":1571,"depth":153,"text":1572},"Where to get help and report bugs.",{},8,"\u002Fsupport",{"title":1497,"description":1587},"jRExoghmWgAfTmnmgqLhtQedAnIjqFIbv0_OahYrhTc",1789586416559]