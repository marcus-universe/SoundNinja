[{"data":1,"prerenderedAt":1328},["ShallowReactive",2],{"docs-page-en-\u002Fadding-sounds":3,"docs-nav-en":169},{"id":4,"title":5,"body":6,"description":161,"extension":162,"meta":163,"navigation":164,"order":165,"path":166,"seo":167,"stem":12,"__hash__":168},"content_en\u002Fadding-sounds.md","Adding Sounds",{"type":7,"value":8,"toc":151},"minimark",[9,13,17,22,44,48,81,85,106,110,125,128,132,139,143],[10,11,5],"h1",{"id":12},"adding-sounds",[14,15,16],"p",{},"A board is empty until you add clips. SoundNinja can import files, whole folders, a recording, or a shared soundboard pack.",[18,19,21],"h2",{"id":20},"import-audio-files","Import audio files",[23,24,25,38,41],"ol",{},[26,27,28,29,33,34,37],"li",{},"Open ",[30,31,32],"strong",{},"File → Import Audio Files",", or use ",[30,35,36],{},"Import"," in the navbar.",[26,39,40],{},"Pick one or more audio files.",[26,42,43],{},"Sounds land in the current tab.",[18,45,47],{"id":46},"import-folders","Import folders",[23,49,50,60,63],{},[26,51,28,52,55,56,59],{},[30,53,54],{},"File → Import Folders"," (or ",[30,57,58],{},"Import Folders"," in the navbar).",[26,61,62],{},"Add one or more folders. Drag to reorder them before you import.",[26,64,65,66],{},"Choose how they land:\n",[67,68,69,75],"ul",{},[26,70,71,74],{},[30,72,73],{},"Import as Tabs"," — each folder becomes its own tab",[26,76,77,80],{},[30,78,79],{},"Import to current Tab"," — every file goes into the active tab",[18,82,84],{"id":83},"record-a-clip","Record a clip",[14,86,87,88,93,94,97,98,101,102,105],{},"Open the ",[89,90,92],"a",{"href":91},"\u002Fdocs\u002Frecording-editor","Record Editor"," from the ",[30,95,96],{},"Record"," button in the player bar. Capture, trim, then ",[30,99,100],{},"Import selected"," or ",[30,103,104],{},"Import all"," into the current tab or a tab you pick.",[18,107,109],{"id":108},"import-a-soundboard","Import a soundboard",[14,111,112,115,116,120,121,124],{},[30,113,114],{},"File → Import Soundboard"," loads a shared pack. Packs are a ",[117,118,119],"code",{},".zip"," that contains ",[117,122,123],{},"project.sninja"," plus the sound files. After import, open the project and play.",[14,126,127],{},"You can also keep several projects (profiles). Use the project selector to switch boards.",[18,129,131],{"id":130},"relink-missing-files","Relink missing files",[14,133,134,135,138],{},"If audio files move on disk, SoundNinja shows a ",[30,136,137],{},"Missing sound files"," dialog. Pick a folder to search and relink the clips.",[18,140,142],{"id":141},"next","Next",[14,144,145,146,150],{},"Organize tabs, groups, and hotkeys in ",[89,147,149],{"href":148},"\u002Fdocs\u002Forganizing-sounds","Organizing Sounds",".",{"title":152,"searchDepth":153,"depth":153,"links":154},"",2,[155,156,157,158,159,160],{"id":20,"depth":153,"text":21},{"id":46,"depth":153,"text":47},{"id":83,"depth":153,"text":84},{"id":108,"depth":153,"text":109},{"id":130,"depth":153,"text":131},{"id":141,"depth":153,"text":142},"Import audio, folders, recordings, and shared soundboards.","md",{},true,3,"\u002Fadding-sounds",{"title":5,"description":161},"qcK88xpbquf2dRogb67sx4O0tzuIof13-X3Yyn9680o",[170,288,486,577,731,866,1008,1230],{"id":171,"title":172,"body":173,"description":282,"extension":162,"meta":283,"navigation":164,"order":284,"path":285,"seo":286,"stem":177,"__hash__":287},"content_en\u002Foverview.md","Overview",{"type":7,"value":174,"toc":276},[175,178,181,184,187,191,205,209,239,243,253,257],[10,176,172],{"id":177},"overview",[14,179,180],{},"SoundNinja is an open-source soundboard for live streaming, chatting with friends, and podcast recording. It is built with Tauri v2 and Nuxt 4 so it stays light on RAM and disk.",[14,182,183],{},"The goal is simple: keep a huge sound library easy to scan, then play the right clip in milliseconds. The UI also works well as a dashboard in VR.",[14,185,186],{},"SoundNinja is still in early development. Features work, but not every platform is fully tested.",[18,188,190],{"id":189},"who-it-is-for","Who it is for",[67,192,193,196,199,202],{},[26,194,195],{},"Streamers who need instant sound cues",[26,197,198],{},"Friends who want a shared board for voice chat",[26,200,201],{},"Podcasters who record clips and drop them onto a board",[26,203,204],{},"Anyone who wants a customizable, local-first soundboard",[18,206,208],{"id":207},"what-you-can-do","What you can do",[67,210,211,214,217,220,223,226,233,236],{},[26,212,213],{},"Build a soundboard from your own audio files",[26,215,216],{},"Organize sounds in colored tabs, groups, and search",[26,218,219],{},"Design the look with the Theme Creator",[26,221,222],{},"Record PC audio or a microphone in the Record Editor",[26,224,225],{},"Assign hotkeys to individual sounds",[26,227,228,229],{},"Trigger sounds from ",[89,230,232],{"href":231},"\u002Fdocs\u002Fremote-control","Bitfocus Companion",[26,234,235],{},"Import and export a full soundboard to share with others",[26,237,238],{},"Use GIFs or images on sound buttons",[18,240,242],{"id":241},"license","License",[14,244,245,246,252],{},"SoundNinja is free software under ",[89,247,251],{"href":248,"rel":249},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fblob\u002Fmain\u002FLICENSE",[250],"nofollow","GPL-3.0",". Fork it, change it, share it.",[18,254,256],{"id":255},"next-steps","Next steps",[23,258,259,265,271],{},[26,260,261],{},[89,262,264],{"href":263},"\u002Fdocs\u002Finstallation","Install SoundNinja",[26,266,267],{},[89,268,270],{"href":269},"\u002Fdocs\u002Fadding-sounds","Add sounds",[26,272,273],{},[89,274,275],{"href":148},"Organize your board",{"title":152,"searchDepth":153,"depth":153,"links":277},[278,279,280,281],{"id":189,"depth":153,"text":190},{"id":207,"depth":153,"text":208},{"id":241,"depth":153,"text":242},{"id":255,"depth":153,"text":256},"What SoundNinja is and what you can do with it.",{},1,"\u002Foverview",{"title":172,"description":282},"cOxJIh0ybRdZsyS1INxo9O3CTipyV8220IKpyfnYFJA",{"id":289,"title":290,"body":291,"description":481,"extension":162,"meta":482,"navigation":164,"order":153,"path":483,"seo":484,"stem":295,"__hash__":485},"content_en\u002Finstallation.md","Installation",{"type":7,"value":292,"toc":474},[293,296,310,314,331,334,338,352,355,359,383,394,398,405,409,424,454,470],[10,294,290],{"id":295},"installation",[14,297,298,299,303,304,309],{},"Grab a build from the ",[89,300,302],{"href":301},"\u002Fdownload","Download page"," or from ",[89,305,308],{"href":306,"rel":307},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Freleases\u002Flatest",[250],"GitHub Releases",". SoundNinja is in early development, so treat builds as beta.",[18,311,313],{"id":312},"windows","Windows",[67,315,316,325,328],{},[26,317,318,101,321,324],{},[30,319,320],{},"Installer (.exe)",[30,322,323],{},"MSI (.msi)"," for 64-bit Windows",[26,326,327],{},"Landing page target: Windows 10 and newer",[26,329,330],{},"The app README also lists Windows 8 and above",[14,332,333],{},"Run the installer, then launch SoundNinja from the Start menu.",[18,335,337],{"id":336},"macos","macOS",[67,339,340,346,349],{},[26,341,342,345],{},[30,343,344],{},"Universal .dmg"," for Apple Silicon and Intel",[26,347,348],{},"Landing page target: macOS 10.14 and newer",[26,350,351],{},"The app README lists macOS 10.15 and above",[14,353,354],{},"Open the disk image and drag SoundNinja to Applications.",[18,356,358],{"id":357},"linux","Linux",[67,360,361,367,373,380],{},[26,362,363,366],{},[30,364,365],{},"Debian (.deb)"," for Ubuntu \u002F Debian",[26,368,369,372],{},[30,370,371],{},"AppImage"," for other distros",[26,374,375,376,379],{},"After a release is published, Arch users can install ",[117,377,378],{},"soundninja-bin"," from the AUR",[26,381,382],{},"Tested on Ubuntu 20.04",[14,384,385,386,389,390,393],{},"Desktop builds need WebKit and GTK packages. On Debian\u002FUbuntu that usually means ",[117,387,388],{},"libwebkit2gtk",", ",[117,391,392],{},"libgtk-3-0",", and an app-indicator library.",[18,395,397],{"id":396},"updates","Updates",[14,399,400,401,404],{},"In the app, open ",[30,402,403],{},"Help → Check for Updates",". You can also let SoundNinja check on startup in Settings.",[18,406,408],{"id":407},"build-from-source","Build from source",[14,410,411,412,417,418,423],{},"Need a custom build? Clone ",[89,413,416],{"href":414,"rel":415},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja",[250],"the repo",", install ",[89,419,422],{"href":420,"rel":421},"https:\u002F\u002Fv2.tauri.app\u002Fstart\u002Fprerequisites\u002F",[250],"Tauri prerequisites",", then:",[425,426,430],"pre",{"className":427,"code":428,"language":429,"meta":152,"style":152},"language-bash shiki shiki-themes github-light github-dark","bun install\nbun run tauri:serve\n","bash",[117,431,432,444],{"__ignoreMap":152},[433,434,436,440],"span",{"class":435,"line":284},"line",[433,437,439],{"class":438},"sScJk","bun",[433,441,443],{"class":442},"sZZnC"," install\n",[433,445,446,448,451],{"class":435,"line":153},[433,447,439],{"class":438},[433,449,450],{"class":442}," run",[433,452,453],{"class":442}," tauri:serve\n",[14,455,456,389,459,462,463,466,467,150],{},[117,457,458],{},"npm",[117,460,461],{},"pnpm",", or ",[117,464,465],{},"deno"," work too. Production build: ",[117,468,469],{},"bun run tauri:build",[471,472,473],"style",{},"html pre.shiki code .sScJk, html code.shiki .sScJk{--shiki-default:#6F42C1;--shiki-dark:#B392F0}html pre.shiki code .sZZnC, html code.shiki .sZZnC{--shiki-default:#032F62;--shiki-dark:#9ECBFF}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html.dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}",{"title":152,"searchDepth":153,"depth":153,"links":475},[476,477,478,479,480],{"id":312,"depth":153,"text":313},{"id":336,"depth":153,"text":337},{"id":357,"depth":153,"text":358},{"id":396,"depth":153,"text":397},{"id":407,"depth":153,"text":408},"Install SoundNinja on Windows, macOS, or Linux.",{},"\u002Finstallation",{"title":290,"description":481},"i4XnnjkhxVb30IICErH1K_cBbAQ7GmnD52FYRYjh50k",{"id":4,"title":5,"body":487,"description":161,"extension":162,"meta":575,"navigation":164,"order":165,"path":166,"seo":576,"stem":12,"__hash__":168},{"type":7,"value":488,"toc":567},[489,491,493,495,507,509,531,533,543,545,553,555,557,561,563],[10,490,5],{"id":12},[14,492,16],{},[18,494,21],{"id":20},[23,496,497,503,505],{},[26,498,28,499,33,501,37],{},[30,500,32],{},[30,502,36],{},[26,504,40],{},[26,506,43],{},[18,508,47],{"id":46},[23,510,511,517,519],{},[26,512,28,513,55,515,59],{},[30,514,54],{},[30,516,58],{},[26,518,62],{},[26,520,65,521],{},[67,522,523,527],{},[26,524,525,74],{},[30,526,73],{},[26,528,529,80],{},[30,530,79],{},[18,532,84],{"id":83},[14,534,87,535,93,537,97,539,101,541,105],{},[89,536,92],{"href":91},[30,538,96],{},[30,540,100],{},[30,542,104],{},[18,544,109],{"id":108},[14,546,547,115,549,120,551,124],{},[30,548,114],{},[117,550,119],{},[117,552,123],{},[14,554,127],{},[18,556,131],{"id":130},[14,558,134,559,138],{},[30,560,137],{},[18,562,142],{"id":141},[14,564,145,565,150],{},[89,566,149],{"href":148},{"title":152,"searchDepth":153,"depth":153,"links":568},[569,570,571,572,573,574],{"id":20,"depth":153,"text":21},{"id":46,"depth":153,"text":47},{"id":83,"depth":153,"text":84},{"id":108,"depth":153,"text":109},{"id":130,"depth":153,"text":131},{"id":141,"depth":153,"text":142},{},{"title":5,"description":161},{"id":578,"title":149,"body":579,"description":725,"extension":162,"meta":726,"navigation":164,"order":727,"path":728,"seo":729,"stem":583,"__hash__":730},"content_en\u002Forganizing-sounds.md",{"type":7,"value":580,"toc":716},[581,584,587,591,618,625,629,632,646,653,657,663,667,678,682,685,689,692,698,704,708],[10,582,149],{"id":583},"organizing-sounds",[14,585,586],{},"SoundNinja is built for large libraries. Use tabs, groups, search, and hotkeys so the clip you need is one click (or one key) away.",[18,588,590],{"id":589},"tabs","Tabs",[67,592,593,600,607],{},[26,594,595,596,599],{},"Add a tab with ",[30,597,598],{},"Add tab",". Give it a color so you can scan the bar fast.",[26,601,602,603,606],{},"The ",[30,604,605],{},"All"," view shows every sound across tabs.",[26,608,609,610,613,614,617],{},"A sound can belong to ",[30,611,612],{},"one or more tabs",". Right-click a sound and use ",[30,615,616],{},"Move to tab"," to assign it.",[14,619,620,621,624],{},"Tab transitions live in ",[30,622,623],{},"Settings → Main",": Slide, Fade, Buttons one by one, or None.",[18,626,628],{"id":627},"groups","Groups",[14,630,631],{},"Since v0.5.3, separators can become named groups:",[67,633,634,637,640,643],{},[26,635,636],{},"Add, rename, or remove a group from the context menu",[26,638,639],{},"Drag the group header — children move with it",[26,641,642],{},"Drop sounds in or out of a group",[26,644,645],{},"Set group border color, name color, and button alignment (or use the tab default)",[14,647,648,649,652],{},"You can still add a plain ",[30,650,651],{},"Separator"," if you only need a visual break.",[18,654,656],{"id":655},"search","Search",[14,658,659,660,662],{},"Use the ",[30,661,656],{}," field in the navbar. Results update as you type.",[18,664,666],{"id":665},"reorder","Reorder",[14,668,669,670,673,674,677],{},"Turn on drag-and-drop in ",[30,671,672],{},"Settings → Behavior"," (",[30,675,676],{},"Allow reorder","). Then drag sounds and groups into place.",[18,679,681],{"id":680},"bulk-edit","Bulk edit",[14,683,684],{},"Multi-select sounds, then change color, move them to a tab, or delete them in one step.",[18,686,688],{"id":687},"hotkeys-and-sound-ids","Hotkeys and sound IDs",[14,690,691],{},"Every sound has an 8-character ID. Copy it from the button context menu or the multi-select ID chip.",[14,693,28,694,697],{},[30,695,696],{},"Settings → Hotkeys"," to bind a key to a sound ID. Global hotkeys are optional.",[14,699,700,701,703],{},"The same ID is what ",[89,702,232],{"href":231}," uses to trigger a clip.",[18,705,707],{"id":706},"gifs-and-colors","GIFs and colors",[14,709,710,711,715],{},"Right-click a sound to set per-button colors or a GIF \u002F image background. That is separate from the ",[89,712,714],{"href":713},"\u002Fdocs\u002Ftheme-editor","Theme Creator",", which styles the whole board.",{"title":152,"searchDepth":153,"depth":153,"links":717},[718,719,720,721,722,723,724],{"id":589,"depth":153,"text":590},{"id":627,"depth":153,"text":628},{"id":655,"depth":153,"text":656},{"id":665,"depth":153,"text":666},{"id":680,"depth":153,"text":681},{"id":687,"depth":153,"text":688},{"id":706,"depth":153,"text":707},"Tabs, groups, search, bulk edit, and hotkeys.",{},4,"\u002Forganizing-sounds",{"title":149,"description":725},"Q4gLPzceZdOi3j6gqMTmPuTzf4qua7p2dfLn2shjKT4",{"id":732,"title":733,"body":734,"description":860,"extension":162,"meta":861,"navigation":164,"order":862,"path":863,"seo":864,"stem":738,"__hash__":865},"content_en\u002Ftheme-editor.md","Theme Editor",{"type":7,"value":735,"toc":854},[736,739,745,749,776,779,783,797,801,827,830,834,840],[10,737,733],{"id":738},"theme-editor",[14,740,741,742,150],{},"The Theme Creator is the full visual editor for your board. Open it from ",[30,743,744],{},"Settings → Main → Theme Creator",[18,746,748],{"id":747},"three-tabs","Three tabs",[23,750,751,765,771],{},[26,752,753,756,757,760,761,764],{},[30,754,755],{},"General"," — theme name, shared colors, and font uploads (",[117,758,759],{},".ttf"," \u002F ",[117,762,763],{},".otf",")",[26,766,767,770],{},[30,768,769],{},"Buttons"," — sound button colors, type, layout, and GIF overlay",[26,772,773,775],{},[30,774,590],{}," — tab bar colors, type, and border thickness",[14,777,778],{},"A live preview shows tabs and buttons as you edit.",[18,780,782],{"id":781},"what-you-can-change","What you can change",[67,784,785,788,791,794],{},[26,786,787],{},"Primary and accent colors, backgrounds, button colors, tab colors",[26,789,790],{},"Button and tab font family and size",[26,792,793],{},"Button width, radius, border width, gaps, and padding",[26,795,796],{},"GIF overlay opacity (normal and hover)",[18,798,800],{"id":799},"save-and-share","Save and share",[67,802,803,809,815,821],{},[26,804,805,808],{},[30,806,807],{},"Export .css"," — write a theme file you can back up or send to a friend",[26,810,811,814],{},[30,812,813],{},"Add to Themes"," — save the file into your Themes folder and apply it",[26,816,817,820],{},[30,818,819],{},"Import .css"," — load a built-in preset or a saved theme",[26,822,823,826],{},[30,824,825],{},"Reset"," — return to SoundNinja defaults",[14,828,829],{},"If you close the window with unsaved changes, SoundNinja asks you to save first.",[18,831,833],{"id":832},"without-the-full-editor","Without the full editor",[14,835,836,837,839],{},"In ",[30,838,623],{}," you can still:",[67,841,842,845,851],{},[26,843,844],{},"Pick a theme from the list",[26,846,847,848,764],{},"Edit CSS variables live (",[30,849,850],{},"Custom CSS",[26,852,853],{},"Import a theme file into the Themes folder",{"title":152,"searchDepth":153,"depth":153,"links":855},[856,857,858,859],{"id":747,"depth":153,"text":748},{"id":781,"depth":153,"text":782},{"id":799,"depth":153,"text":800},{"id":832,"depth":153,"text":833},"Design colors, fonts, buttons, and tabs in the Theme Creator.",{},5,"\u002Ftheme-editor",{"title":733,"description":860},"zpMjxENa49aUipEX7TBxcqrbaZNweyJ019KsLAMJeoc",{"id":867,"title":868,"body":869,"description":1002,"extension":162,"meta":1003,"navigation":164,"order":1004,"path":1005,"seo":1006,"stem":873,"__hash__":1007},"content_en\u002Frecording-editor.md","Recording Editor",{"type":7,"value":870,"toc":996},[871,874,880,884,890,910,913,917,942,946,961,965,979,986],[10,872,868],{"id":873},"recording-editor",[14,875,876,877,879],{},"Record a clip inside SoundNinja, trim it, then import it onto a tab. Open the editor with the ",[30,878,96],{}," button in the player bar.",[18,881,883],{"id":882},"choose-an-input","Choose an input",[14,885,836,886,889],{},[30,887,888],{},"Settings → Audio",":",[67,891,892,898,904],{},[26,893,894,897],{},[30,895,896],{},"Input Devices"," — microphone",[26,899,900,903],{},[30,901,902],{},"Output Devices (PC Audio)"," — loopback of what your PC is playing",[26,905,906,909],{},[30,907,908],{},"Input volume"," — capture gain from 0% to 200%",[14,911,912],{},"The Record button uses the device you pick here.",[18,914,916],{"id":915},"edit-the-take","Edit the take",[67,918,919,922,925,933,936,939],{},[26,920,921],{},"Record and stop",[26,923,924],{},"Watch the input level meter",[26,926,927,101,930],{},[30,928,929],{},"Normalize",[30,931,932],{},"Noise Cancelation",[26,934,935],{},"Trim the whole clip, trim to a selection, or delete a selection",[26,937,938],{},"Undo \u002F redo",[26,940,941],{},"Zoom in and out",[18,943,945],{"id":944},"stage-and-import","Stage and import",[23,947,948,951,954],{},[26,949,950],{},"Add the selection or the full track to the staging list.",[26,952,953],{},"The list starts empty: record, edit, then add a clip.",[26,955,956,101,958,960],{},[30,957,100],{},[30,959,104],{}," into the current tab or a tab you choose.",[18,962,964],{"id":963},"stem-separation-optional","Stem separation (optional)",[14,966,967,968,101,971,974,975,978],{},"The Record Editor can keep ",[30,969,970],{},"vocals",[30,972,973],{},"music"," using BS-RoFormer. The model is about 158 MB and is ",[30,976,977],{},"not"," bundled with the app.",[14,980,981,982,985],{},"Download it from ",[30,983,984],{},"Settings → Stem Separation",", or accept the first-run prompt. The Windows installer can also offer to download the model on first launch.",[14,987,988,989,760,992,995],{},"Stem builds from source need an extra flag (",[117,990,991],{},"tauri:serve:stems",[117,993,994],{},"tauri:build:stems",").",{"title":152,"searchDepth":153,"depth":153,"links":997},[998,999,1000,1001],{"id":882,"depth":153,"text":883},{"id":915,"depth":153,"text":916},{"id":944,"depth":153,"text":945},{"id":963,"depth":153,"text":964},"Capture mic or PC audio, edit the clip, and drop it on your board.",{},6,"\u002Frecording-editor",{"title":868,"description":1002},"MJVcc7XyjWmtAdA8N6FQhHNz88XkH8JRCYOy28MJ364",{"id":1009,"title":1010,"body":1011,"description":1224,"extension":162,"meta":1225,"navigation":164,"order":1226,"path":1227,"seo":1228,"stem":1015,"__hash__":1229},"content_en\u002Fremote-control.md","Remote Control",{"type":7,"value":1012,"toc":1217},[1013,1016,1019,1023,1052,1055,1058,1093,1097,1117,1120,1124,1156,1160,1166],[10,1014,1010],{"id":1015},"remote-control",[14,1017,1018],{},"SoundNinja can listen on your local network so Bitfocus Companion (or any HTTP\u002FWebSocket client) can play and stop sounds.",[18,1020,1022],{"id":1021},"enable-the-remote-server","Enable the remote server",[23,1024,1025,1030,1036,1042],{},[26,1026,28,1027,150],{},[30,1028,1029],{},"Settings → Remote",[26,1031,1032,1033,150],{},"Enable the remote server. Default port is ",[30,1034,1035],{},"7331",[26,1037,1038,1039,150],{},"Optional: set a token. Clients must send it as a Bearer token or ",[117,1040,1041],{},"?token=",[26,1043,1044,1045,1048,1049,150],{},"Copy the ",[117,1046,1047],{},"http:\u002F\u002FIP:PORT"," URL, or copy the system IP from ",[30,1050,1051],{},"Settings → About",[14,1053,1054],{},"Windows may show a firewall prompt the first time the server starts. Allow private-network access.",[18,1056,232],{"id":1057},"bitfocus-companion",[23,1059,1060,1067,1076,1086],{},[26,1061,1062,1063,150],{},"Install ",[89,1064,232],{"href":1065,"rel":1066},"https:\u002F\u002Fbitfocus.io\u002Fcompanion",[250],[26,1068,1069,1070,1075],{},"Download ",[89,1071,1074],{"href":1072,"rel":1073},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Freleases\u002Flatest\u002Fdownload\u002Fcompanion-module-soundninja.tgz",[250],"companion-module-soundninja.tgz",". There is no Companion Store package yet.",[26,1077,1078,1079,1082,1083,150],{},"In Companion: ",[30,1080,1081],{},"Modules → Load module package"," and pick the ",[117,1084,1085],{},".tgz",[26,1087,1088,1089,1092],{},"Add a ",[30,1090,1091],{},"Sound Ninja"," connection. Paste the PC IP, port, and token if you set one.",[18,1094,1096],{"id":1095},"actions","Actions",[67,1098,1099,1105,1111],{},[26,1100,1101,1104],{},[30,1102,1103],{},"Trigger Sound"," — pick from the live dropdown, or type an 8-character sound ID (Companion variables work)",[26,1106,1107,1110],{},[30,1108,1109],{},"Stop Sound"," — stop one playing sound by ID",[26,1112,1113,1116],{},[30,1114,1115],{},"Stop All"," — stop every playing sound",[14,1118,1119],{},"Copy a sound ID in SoundNinja from the button context menu or the multi-select ID chip.",[18,1121,1123],{"id":1122},"feedbacks-and-variables","Feedbacks and variables",[67,1125,1126,1132,1144,1150],{},[26,1127,1128,1131],{},[30,1129,1130],{},"Sound Playing"," — true while that sound ID is active (use it for button color)",[26,1133,1134,1137,1138,760,1141],{},[117,1135,1136],{},"$(soundninja:connected)"," — ",[117,1139,1140],{},"true",[117,1142,1143],{},"false",[26,1145,1146,1149],{},[117,1147,1148],{},"$(soundninja:playing_count)"," — how many sounds are playing",[26,1151,1152,1155],{},[117,1153,1154],{},"$(soundninja:last_triggered)"," — last triggered sound ID",[18,1157,1159],{"id":1158},"http-api-advanced","HTTP API (advanced)",[14,1161,1162,1163],{},"Base path: ",[117,1164,1165],{},"\u002Fapi\u002Fv1",[67,1167,1168,1174,1180,1186,1196,1202,1211],{},[26,1169,1170,1173],{},[117,1171,1172],{},"GET \u002Finfo"," — app name, version, protocol, whether a token is required",[26,1175,1176,1179],{},[117,1177,1178],{},"GET \u002Fsounds"," — sound list (id, name, tabs, active)",[26,1181,1182,1185],{},[117,1183,1184],{},"GET \u002Fstate"," — sounds plus currently playing IDs",[26,1187,1188,1191,1192,1195],{},[117,1189,1190],{},"POST \u002Ftrigger"," with ",[117,1193,1194],{},"{ \"id\" }"," — play a sound",[26,1197,1198,1201],{},[117,1199,1200],{},"GET \u002Ftrigger\u002F:id"," — play (easy to test in a browser)",[26,1203,1204,1207,1208,1210],{},[117,1205,1206],{},"POST \u002Fstop"," with optional ",[117,1209,1194],{}," — stop one sound or all",[26,1212,1213,1216],{},[117,1214,1215],{},"GET \u002Fws"," — live state; send trigger\u002Fstop commands inbound",{"title":152,"searchDepth":153,"depth":153,"links":1218},[1219,1220,1221,1222,1223],{"id":1021,"depth":153,"text":1022},{"id":1057,"depth":153,"text":232},{"id":1095,"depth":153,"text":1096},{"id":1122,"depth":153,"text":1123},{"id":1158,"depth":153,"text":1159},"Trigger SoundNinja from Bitfocus Companion over the local network.",{},7,"\u002Fremote-control",{"title":1010,"description":1224},"wUUXEeUIG0wA5XHXyiMCGZXzR5yznF1l2ByKM6FEobI",{"id":1231,"title":1232,"body":1233,"description":1322,"extension":162,"meta":1323,"navigation":164,"order":1324,"path":1325,"seo":1326,"stem":1237,"__hash__":1327},"content_en\u002Fsupport.md","Support",{"type":7,"value":1234,"toc":1315},[1235,1238,1241,1245,1248,1255,1263,1267,1274,1276,1289,1293,1304,1308],[10,1236,1232],{"id":1237},"support",[14,1239,1240],{},"SoundNinja is a community project in early beta. The fastest way to get help is GitHub.",[1