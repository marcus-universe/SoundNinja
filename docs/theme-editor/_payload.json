[{"data":1,"prerenderedAt":1612},["ShallowReactive",2],{"docs-page-en-\u002Ftheme-editor":3,"docs-nav-en":154},{"id":4,"title":5,"body":6,"description":146,"extension":147,"meta":148,"navigation":149,"order":150,"path":151,"seo":152,"stem":12,"__hash__":153},"content_en\u002Ftheme-editor.md","Theme Editor",{"type":7,"value":8,"toc":138},"minimark",[9,13,22,27,58,61,65,80,84,110,113,117,124],[10,11,5],"h1",{"id":12},"theme-editor",[14,15,16,17,21],"p",{},"The Theme Creator is the full visual editor for your board. Open it from ",[18,19,20],"strong",{},"Settings → Main → Theme Creator",".",[23,24,26],"h2",{"id":25},"three-tabs","Three tabs",[28,29,30,46,52],"ol",{},[31,32,33,36,37,41,42,45],"li",{},[18,34,35],{},"General"," — theme name, shared colors, and font uploads (",[38,39,40],"code",{},".ttf"," \u002F ",[38,43,44],{},".otf",")",[31,47,48,51],{},[18,49,50],{},"Buttons"," — sound button colors, type, layout, and GIF overlay",[31,53,54,57],{},[18,55,56],{},"Tabs"," — tab bar colors, type, and border thickness",[14,59,60],{},"A live preview shows tabs and buttons as you edit.",[23,62,64],{"id":63},"what-you-can-change","What you can change",[66,67,68,71,74,77],"ul",{},[31,69,70],{},"Primary and accent colors, backgrounds, button colors, tab colors",[31,72,73],{},"Button and tab font family and size",[31,75,76],{},"Button width, radius, border width, gaps, and padding",[31,78,79],{},"GIF overlay opacity (normal and hover)",[23,81,83],{"id":82},"save-and-share","Save and share",[66,85,86,92,98,104],{},[31,87,88,91],{},[18,89,90],{},"Export .css"," — write a theme file you can back up or send to a friend",[31,93,94,97],{},[18,95,96],{},"Add to Themes"," — save the file into your Themes folder and apply it",[31,99,100,103],{},[18,101,102],{},"Import .css"," — load a built-in preset or a saved theme",[31,105,106,109],{},[18,107,108],{},"Reset"," — return to SoundNinja defaults",[14,111,112],{},"If you close the window with unsaved changes, SoundNinja asks you to save first.",[23,114,116],{"id":115},"without-the-full-editor","Without the full editor",[14,118,119,120,123],{},"In ",[18,121,122],{},"Settings → Main"," you can still:",[66,125,126,129,135],{},[31,127,128],{},"Pick a theme from the list",[31,130,131,132,45],{},"Edit CSS variables live (",[18,133,134],{},"Custom CSS",[31,136,137],{},"Import a theme file into the Themes folder",{"title":139,"searchDepth":140,"depth":140,"links":141},"",2,[142,143,144,145],{"id":25,"depth":140,"text":26},{"id":63,"depth":140,"text":64},{"id":82,"depth":140,"text":83},{"id":115,"depth":140,"text":116},"Design colors, fonts, buttons, and tabs in the Theme Creator.","md",{},true,5,"\u002Ftheme-editor",{"title":5,"description":146},"zpMjxENa49aUipEX7TBxcqrbaZNweyJ019KsLAMJeoc",[155,284,507,656,1057,1146,1292,1514],{"id":156,"title":157,"body":158,"description":278,"extension":147,"meta":279,"navigation":149,"order":280,"path":281,"seo":282,"stem":162,"__hash__":283},"content_en\u002Foverview.md","Overview",{"type":7,"value":159,"toc":272},[160,163,166,169,172,176,190,194,234,238,248,252],[10,161,157],{"id":162},"overview",[14,164,165],{},"SoundNinja is an open-source soundboard for live streaming, chatting with friends, and podcast recording. It is built with Tauri v2 and Nuxt 4 so it stays light on RAM and disk.",[14,167,168],{},"The goal is simple: keep a huge sound library easy to scan, then play the right clip in milliseconds. The UI also works well as a dashboard in VR.",[14,170,171],{},"SoundNinja is still in early development. Features work, but not every platform is fully tested.",[23,173,175],{"id":174},"who-it-is-for","Who it is for",[66,177,178,181,184,187],{},[31,179,180],{},"Streamers who need instant sound cues",[31,182,183],{},"Friends who want a shared board for voice chat",[31,185,186],{},"Podcasters who record clips and drop them onto a board",[31,188,189],{},"Anyone who wants a customizable, local-first soundboard",[23,191,193],{"id":192},"what-you-can-do","What you can do",[66,195,196,199,202,205,208,211,214,217,220,228,231],{},[31,197,198],{},"Build a soundboard from your own audio files",[31,200,201],{},"Organize sounds in colored tabs, groups, tags, and search",[31,203,204],{},"Filter by tags (OR) and sort by name, date, duration, or size",[31,206,207],{},"Multi-select with marquee or Shift-range, then bulk color, move, or delete",[31,209,210],{},"Set per-sound volume from the context menu",[31,212,213],{},"Design the look with the Theme Creator",[31,215,216],{},"Record PC audio or a microphone in the Record Editor",[31,218,219],{},"Assign hotkeys to individual sounds",[31,221,222,223],{},"Trigger sounds from ",[224,225,227],"a",{"href":226},"\u002Fdocs\u002Fremote-control","Bitfocus Companion",[31,229,230],{},"Import and export a full soundboard to share with others",[31,232,233],{},"Use GIFs or images on sound buttons — from a local folder library or KLIPY",[23,235,237],{"id":236},"license","License",[14,239,240,241,247],{},"SoundNinja is free software under ",[224,242,246],{"href":243,"rel":244},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fblob\u002Fmain\u002FLICENSE",[245],"nofollow","GPL-3.0",". Fork it, change it, share it.",[23,249,251],{"id":250},"next-steps","Next steps",[28,253,254,260,266],{},[31,255,256],{},[224,257,259],{"href":258},"\u002Fdocs\u002Finstallation","Install SoundNinja",[31,261,262],{},[224,263,265],{"href":264},"\u002Fdocs\u002Fadding-sounds","Add sounds",[31,267,268],{},[224,269,271],{"href":270},"\u002Fdocs\u002Forganizing-sounds","Organize your board",{"title":139,"searchDepth":140,"depth":140,"links":273},[274,275,276,277],{"id":174,"depth":140,"text":175},{"id":192,"depth":140,"text":193},{"id":236,"depth":140,"text":237},{"id":250,"depth":140,"text":251},"What SoundNinja is and what you can do with it.",{},1,"\u002Foverview",{"title":157,"description":278},"Dax9ydiOOeEz5F1IxWfEljWZynntK7dPp52JZ3q2G58",{"id":285,"title":286,"body":287,"description":502,"extension":147,"meta":503,"navigation":149,"order":140,"path":504,"seo":505,"stem":291,"__hash__":506},"content_en\u002Finstallation.md","Installation",{"type":7,"value":288,"toc":495},[289,292,306,310,331,334,338,352,355,359,383,394,398,405,409,424,454,470,491],[10,290,286],{"id":291},"installation",[14,293,294,295,299,300,305],{},"Grab a build from the ",[224,296,298],{"href":297},"\u002Fdownload","Download page"," or from ",[224,301,304],{"href":302,"rel":303},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Freleases\u002Flatest",[245],"GitHub Releases",". SoundNinja is in early development, so treat builds as beta.",[23,307,309],{"id":308},"windows","Windows",[66,311,312,322,325,328],{},[31,313,314,317,318,321],{},[18,315,316],{},"Installer (.exe)"," or ",[18,319,320],{},"MSI (.msi)"," for 64-bit Windows",[31,323,324],{},"Landing page target: Windows 10 and newer",[31,326,327],{},"The app README also lists Windows 8 and above",[31,329,330],{},"The NSIS installer uses a dark theme. Pick a language during setup — SoundNinja remembers it on the next launch.",[14,332,333],{},"Run the installer, then launch SoundNinja from the Start menu.",[23,335,337],{"id":336},"macos","macOS",[66,339,340,346,349],{},[31,341,342,345],{},[18,343,344],{},"Universal .dmg"," for Apple Silicon and Intel",[31,347,348],{},"Landing page target: macOS 10.14 and newer",[31,350,351],{},"The app README lists macOS 10.15 and above",[14,353,354],{},"Open the disk image and drag SoundNinja to Applications.",[23,356,358],{"id":357},"linux","Linux",[66,360,361,367,373,380],{},[31,362,363,366],{},[18,364,365],{},"Debian (.deb)"," for Ubuntu \u002F Debian",[31,368,369,372],{},[18,370,371],{},"AppImage"," for other distros",[31,374,375,376,379],{},"After a release is published, Arch users can install ",[38,377,378],{},"soundninja-bin"," from the AUR",[31,381,382],{},"Tested on Ubuntu 20.04",[14,384,385,386,389,390,393],{},"Desktop builds need WebKit and GTK packages. On Debian\u002FUbuntu that usually means ",[38,387,388],{},"libwebkit2gtk",", ",[38,391,392],{},"libgtk-3-0",", and an app-indicator library.",[23,395,397],{"id":396},"updates","Updates",[14,399,400,401,404],{},"In the app, open ",[18,402,403],{},"Help → Check for Updates",". You can also let SoundNinja check on startup in Settings.",[23,406,408],{"id":407},"build-from-source","Build from source",[14,410,411,412,417,418,423],{},"Need a custom build? Clone ",[224,413,416],{"href":414,"rel":415},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja",[245],"the repo",", install ",[224,419,422],{"href":420,"rel":421},"https:\u002F\u002Fv2.tauri.app\u002Fstart\u002Fprerequisites\u002F",[245],"Tauri prerequisites",", then:",[425,426,430],"pre",{"className":427,"code":428,"language":429,"meta":139,"style":139},"language-bash shiki shiki-themes github-light github-dark","bun install\nbun run tauri:serve\n","bash",[38,431,432,444],{"__ignoreMap":139},[433,434,436,440],"span",{"class":435,"line":280},"line",[433,437,439],{"class":438},"sScJk","bun",[433,441,443],{"class":442},"sZZnC"," install\n",[433,445,446,448,451],{"class":435,"line":140},[433,447,439],{"class":438},[433,449,450],{"class":442}," run",[433,452,453],{"class":442}," tauri:serve\n",[14,455,456,389,459,462,463,466,467,21],{},[38,457,458],{},"npm",[38,460,461],{},"pnpm",", or ",[38,464,465],{},"deno"," work too. Production build: ",[38,468,469],{},"bun run tauri:build",[14,471,472,475,476,481,482,485,486,21],{},[18,473,474],{},"Windows only:"," every Windows compile includes ASIO via the ",[224,477,480],{"href":478,"rel":479},"https:\u002F\u002Fwww.steinberg.net\u002Fasiosdk",[245],"Steinberg ASIO SDK",". Run ",[38,483,484],{},"bun run setup:asio"," once (SDK is not in git). Linux and macOS use PipeWire \u002F Core Audio — skip that step. Full notes: ",[224,487,490],{"href":488,"rel":489},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fblob\u002Fmain\u002Fdocs\u002Fbuild-from-source.md",[245],"build-from-source.md",[492,493,494],"style",{},"html pre.shiki code .sScJk, html code.shiki .sScJk{--shiki-default:#6F42C1;--shiki-dark:#B392F0}html pre.shiki code .sZZnC, html code.shiki .sZZnC{--shiki-default:#032F62;--shiki-dark:#9ECBFF}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html.dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}",{"title":139,"searchDepth":140,"depth":140,"links":496},[497,498,499,500,501],{"id":308,"depth":140,"text":309},{"id":336,"depth":140,"text":337},{"id":357,"depth":140,"text":358},{"id":396,"depth":140,"text":397},{"id":407,"depth":140,"text":408},"Install SoundNinja on Windows, macOS, or Linux.",{},"\u002Finstallation",{"title":286,"description":502},"outLmMLibzOL_84ZfoLBrmphO4wVu0zaTr0u_DS4GUg",{"id":508,"title":509,"body":510,"description":650,"extension":147,"meta":651,"navigation":149,"order":652,"path":653,"seo":654,"stem":514,"__hash__":655},"content_en\u002Fadding-sounds.md","Adding Sounds",{"type":7,"value":511,"toc":642},[512,515,518,522,541,545,577,581,600,604,618,621,625,632,636],[10,513,509],{"id":514},"adding-sounds",[14,516,517],{},"A board is empty until you add clips. SoundNinja can import files, whole folders, a recording, or a shared soundboard pack.",[23,519,521],{"id":520},"import-audio-files","Import audio files",[28,523,524,535,538],{},[31,525,526,527,530,531,534],{},"Open ",[18,528,529],{},"File → Import Audio Files",", or use ",[18,532,533],{},"Import"," in the navbar.",[31,536,537],{},"Pick one or more audio files.",[31,539,540],{},"Sounds land in the current tab.",[23,542,544],{"id":543},"import-folders","Import folders",[28,546,547,557,560],{},[31,548,526,549,552,553,556],{},[18,550,551],{},"File → Import Folders"," (or ",[18,554,555],{},"Import Folders"," in the navbar).",[31,558,559],{},"Add one or more folders. Drag to reorder them before you import.",[31,561,562,563],{},"Choose how they land:\n",[66,564,565,571],{},[31,566,567,570],{},[18,568,569],{},"Import as Tabs"," — each folder becomes its own tab",[31,572,573,576],{},[18,574,575],{},"Import to current Tab"," — every file goes into the active tab",[23,578,580],{"id":579},"record-a-clip","Record a clip",[14,582,583,584,588,589,592,593,317,596,599],{},"Open the ",[224,585,587],{"href":586},"\u002Fdocs\u002Frecording-editor","Record Editor"," from the ",[18,590,591],{},"Record"," button in the player bar. Capture, trim, then ",[18,594,595],{},"Import selected",[18,597,598],{},"Import all"," into the current tab or a tab you pick.",[23,601,603],{"id":602},"import-a-soundboard","Import a soundboard",[14,605,606,609,610,613,614,617],{},[18,607,608],{},"File → Import Soundboard"," loads a shared pack. Packs are a ",[38,611,612],{},".zip"," that contains ",[38,615,616],{},"project.sninja"," plus the sound files. After import, open the project and play.",[14,619,620],{},"You can also keep several projects (profiles). Use the project selector to switch boards.",[23,622,624],{"id":623},"relink-missing-files","Relink missing files",[14,626,627,628,631],{},"If audio files move on disk, SoundNinja shows a ",[18,629,630],{},"Missing sound files"," dialog. Pick a folder to search and relink the clips.",[23,633,635],{"id":634},"next","Next",[14,637,638,639,21],{},"Organize tabs, tags, filters, and hotkeys in ",[224,640,641],{"href":270},"Organizing Sounds",{"title":139,"searchDepth":140,"depth":140,"links":643},[644,645,646,647,648,649],{"id":520,"depth":140,"text":521},{"id":543,"depth":140,"text":544},{"id":579,"depth":140,"text":580},{"id":602,"depth":140,"text":603},{"id":623,"depth":140,"text":624},{"id":634,"depth":140,"text":635},"Import audio, folders, recordings, and shared soundboards.",{},3,"\u002Fadding-sounds",{"title":509,"description":650},"SBUvL_H4633CrDyNUKazqKwru4aq1hhgoH4_o99rBsE",{"id":657,"title":641,"body":658,"description":1051,"extension":147,"meta":1052,"navigation":149,"order":1053,"path":1054,"seo":1055,"stem":662,"__hash__":1056},"content_en\u002Forganizing-sounds.md",{"type":7,"value":659,"toc":1036},[660,663,670,673,700,706,710,713,727,734,740,744,754,759,791,795,801,805,838,844,848,851,878,881,885,899,903,909,930,946,953,957,967,970,974,981,991,997,1001,1009,1016,1033],[10,661,641],{"id":662},"organizing-sounds",[14,664,665,666,669],{},"SoundNinja is built for large libraries. Use ",[18,667,668],{},"tags and filters",", tabs, search, multi-select, and hotkeys so the clip you need is one click (or one key) away.",[23,671,56],{"id":672},"tabs",[66,674,675,682,689],{},[31,676,677,678,681],{},"Add a tab with ",[18,679,680],{},"Add tab",". Give it a color so you can scan the bar fast.",[31,683,684,685,688],{},"The ",[18,686,687],{},"All"," view shows every sound across tabs.",[31,690,691,692,695,696,699],{},"A sound can belong to ",[18,693,694],{},"one or more tabs",". Right-click a sound and use ",[18,697,698],{},"Move to tab"," to assign it.",[14,701,702,703,705],{},"Tab transitions live in ",[18,704,122],{},": Slide, Fade, Buttons one by one, or None.",[23,707,709],{"id":708},"groups","Groups",[14,711,712],{},"Since v0.5.3, separators can become named groups:",[66,714,715,718,721,724],{},[31,716,717],{},"Add, rename, or remove a group from the context menu",[31,719,720],{},"Drag the group header — children move with it",[31,722,723],{},"Drop sounds in or out of a group",[31,725,726],{},"Set group border color, name color, and button alignment (or use the tab default)",[14,728,729,730,733],{},"You can still add a plain ",[18,731,732],{},"Separator"," if you only need a visual break.",[14,735,736,737,21],{},"Right-click empty board space to ",[18,738,739],{},"Add Group",[23,741,743],{"id":742},"tags-filters","Tags \u002F Filters",[14,745,746,747,750,751,753],{},"Tags cut across tabs. The slide-out ",[18,748,749],{},"Filter"," panel (sidebar ",[18,752,749],{},") is where you create them and turn them into a board filter.",[755,756,758],"h3",{"id":757},"create-and-edit-tags","Create and edit tags",[28,760,761,766,777,784],{},[31,762,526,763,765],{},[18,764,749],{}," in the sidebar.",[31,767,768,769,772,773,776],{},"Under ",[18,770,771],{},"Tags",", use ",[18,774,775],{},"Add tag"," — give it a name and a color.",[31,778,779,780,783],{},"Rename, recolor, or ",[18,781,782],{},"Delete tag"," from the same list.",[31,785,786,787,790],{},"If you see ",[18,788,789],{},"No tags yet",", add one here before you assign anything.",[755,792,794],{"id":793},"assign-tags-to-sounds","Assign tags to sounds",[14,796,797,798,800],{},"Right-click a sound → ",[18,799,771],{}," (checkboxes). A sound can have several tags. If none exist yet, the menu tells you to open the filter panel.",[755,802,804],{"id":803},"filter-the-board","Filter the board",[66,806,807,813,824,835],{},[31,808,809,810,21],{},"Toggle tags in the Filter panel, or as ",[18,811,812],{},"chips under the search bar",[31,814,815,816,819,820,823],{},"Matching is ",[18,817,818],{},"OR",": a sound stays visible if it has ",[18,821,822],{},"any"," selected tag.",[31,825,826,827,830,831,834],{},"The navbar ",[18,828,829],{},"Search"," field ",[18,832,833],{},"ANDs"," with the active tag filter (type + tags together).",[31,836,837],{},"Turn chips off (or clear the filter) to show the full tab again.",[14,839,840,841,21],{},"Colored tag names can appear on buttons. Toggle them in ",[18,842,843],{},"Settings → Behavior → Show tag badges",[23,845,847],{"id":846},"sort","Sort",[14,849,850],{},"Open the filter panel and pick a sort mode:",[66,852,853,859],{},[31,854,855,858],{},[18,856,857],{},"User defined"," — your tab order, with groups visible",[31,860,861,389,864,389,867,462,870,873,874,877],{},[18,862,863],{},"Name",[18,865,866],{},"Added time",[18,868,869],{},"Play time",[18,871,872],{},"File size"," — a flat sorted list; ",[18,875,876],{},"groups are hidden"," in these modes",[14,879,880],{},"Duration sort may warm duration metadata the first time you use it.",[23,882,884],{"id":883},"reorder","Reorder",[14,886,887,888,891,892,895,896,898],{},"Turn on drag-and-drop in ",[18,889,890],{},"Settings → Behavior"," (",[18,893,894],{},"Allow reorder","). Then drag sounds and groups into place. Reorder applies in ",[18,897,857],{}," sort.",[23,900,902],{"id":901},"multi-select","Multi-select",[14,904,905,906,908],{},"Turn on ",[18,907,902],{}," in the navbar, then:",[66,910,911,914,920,927],{},[31,912,913],{},"Click a sound to toggle it",[31,915,916,919],{},[18,917,918],{},"Shift+click"," to select a range from the last anchor",[31,921,922,923,926],{},"Drag a ",[18,924,925],{},"marquee"," on empty board space",[31,928,929],{},"Click empty board (or outside) to clear the selection",[14,931,932,933,389,936,389,939,942,943,21],{},"A bulk bar appears with the count, plus ",[18,934,935],{},"Color",[18,937,938],{},"Move to tab…",[18,940,941],{},"Delete",", and ",[18,944,945],{},"Done",[14,947,948,949,952],{},"In multi-select, each button shows an ",[18,950,951],{},"8-character ID chip",". Right-click the chip to copy it.",[23,954,956],{"id":955},"per-sound-volume","Per-sound volume",[14,958,797,959,962,963,966],{},[18,960,961],{},"Volume",". Drag the slider from 0% to 100%. ",[18,964,965],{},"Double-click"," the slider to reset to 100%.",[14,968,969],{},"This stacks with the master output volume in Settings.",[23,971,973],{"id":972},"hotkeys-and-sound-ids","Hotkeys and sound IDs",[14,975,976,977,980],{},"Every sound has an 8-character ID. Copy it from the button context menu (",[18,978,979],{},"Copy ID",") or the multi-select ID chip.",[14,982,526,983,986,987,990],{},[18,984,985],{},"Settings → Hotkeys"," to bind a key to a sound ID. Global hotkeys are optional. ",[18,988,989],{},"Assign hotkey"," on the context menu jumps there with the ID prefilled.",[14,992,993,994,996],{},"The same ID is what ",[224,995,227],{"href":226}," uses to trigger a clip.",[23,998,1000],{"id":999},"background-images-and-colors","Background images and colors",[14,1002,1003,1004,1008],{},"Right-click a sound to set per-button colors or a background image. That is separate from the ",[224,1005,1007],{"href":1006},"\u002Fdocs\u002Ftheme-editor","Theme Creator",", which styles the whole board.",[14,1010,1011,1012,1015],{},"The picker is a ",[18,1013,1014],{},"Background image"," dialog (PNG, JPEG, GIF, WebP):",[66,1017,1018,1024],{},[31,1019,1020,1023],{},[18,1021,1022],{},"Local files"," — add folders, pick a single file, search filenames, preview the grid, or remove a folder from the library",[31,1025,1026,1029,1030,1032],{},[18,1027,1028],{},"KLIPY"," — search online GIFs. Set your own API key in ",[18,1031,890],{},". The key is not stored in project files.",[14,1034,1035],{},"After you pick an image, pan and crop it on the button.",{"title":139,"searchDepth":140,"depth":140,"links":1037},[1038,1039,1040,1045,1046,1047,1048,1049,1050],{"id":672,"depth":140,"text":56},{"id":708,"depth":140,"text":709},{"id":742,"depth":140,"text":743,"children":1041},[1042,1043,1044],{"id":757,"depth":652,"text":758},{"id":793,"depth":652,"text":794},{"id":803,"depth":652,"text":804},{"id":846,"depth":140,"text":847},{"id":883,"depth":140,"text":884},{"id":901,"depth":140,"text":902},{"id":955,"depth":140,"text":956},{"id":972,"depth":140,"text":973},{"id":999,"depth":140,"text":1000},"Tags, filters, tabs, groups, sort, multi-select, volume, and hotkeys.",{},4,"\u002Forganizing-sounds",{"title":641,"description":1051},"DaYqySVuX1kgdTnJw6h1GP_lGyj4zdFP2uKKbBEbVwQ",{"id":4,"title":5,"body":1058,"description":146,"extension":147,"meta":1144,"navigation":149,"order":150,"path":151,"seo":1145,"stem":12,"__hash__":153},{"type":7,"value":1059,"toc":1138},[1060,1062,1066,1068,1086,1088,1090,1100,1102,1120,1122,1124,1128],[10,1061,5],{"id":12},[14,1063,16,1064,21],{},[18,1065,20],{},[23,1067,26],{"id":25},[28,1069,1070,1078,1082],{},[31,1071,1072,36,1074,41,1076,45],{},[18,1073,35],{},[38,1075,40],{},[38,1077,44],{},[31,1079,1080,51],{},[18,1081,50],{},[31,1083,1084,57],{},[18,1085,56],{},[14,1087,60],{},[23,1089,64],{"id":63},[66,1091,1092,1094,1096,1098],{},[31,1093,70],{},[31,1095,73],{},[31,1097,76],{},[31,1099,79],{},[23,1101,83],{"id":82},[66,1103,1104,1108,1112,1116],{},[31,1105,1106,91],{},[18,1107,90],{},[31,1109,1110,97],{},[18,1111,96],{},[31,1113,1114,103],{},[18,1115,102],{},[31,1117,1118,109],{},[18,1119,108],{},[14,1121,112],{},[23,1123,116],{"id":115},[14,1125,119,1126,123],{},[18,1127,122],{},[66,1129,1130,1132,1136],{},[31,1131,128],{},[31,1133,131,1134,45],{},[18,1135,134],{},[31,1137,137],{},{"title":139,"searchDepth":140,"depth":140,"links":1139},[1140,1141,1142,1143],{"id":25,"depth":140,"text":26},{"id":63,"depth":140,"text":64},{"id":82,"depth":140,"text":83},{"id":115,"depth":140,"text":116},{},{"title":5,"description":146},{"id":1147,"title":1148,"body":1149,"description":1286,"extension":147,"meta":1287,"navigation":149,"order":1288,"path":1289,"seo":1290,"stem":1153,"__hash__":1291},"content_en\u002Frecording-editor.md","Recording Editor",{"type":7,"value":1150,"toc":1280},[1151,1154,1160,1164,1170,1190,1193,1197,1222,1226,1241,1245,1259,1270],[10,1152,1148],{"id":1153},"recording-editor",[14,1155,1156,1157,1159],{},"Record a clip inside SoundNinja, trim it, then import it onto a tab. Open the editor with the ",[18,1158,591],{}," button in the player bar.",[23,1161,1163],{"id":1162},"choose-an-input","Choose an input",[14,1165,119,1166,1169],{},[18,1167,1168],{},"Settings → Audio",":",[66,1171,1172,1178,1184],{},[31,1173,1174,1177],{},[18,1175,1176],{},"Input Devices"," — microphone",[31,1179,1180,1183],{},[18,1181,1182],{},"Output Devices (PC Audio)"," — loopback of what your PC is playing",[31,1185,1186,1189],{},[18,1187,1188],{},"Input volume"," — capture gain from 0% to 200%",[14,1191,1192],{},"The Record button uses the device you pick here.",[23,1194,1196],{"id":1195},"edit-the-take","Edit the take",[66,1198,1199,1202,1205,1213,1216,1219],{},[31,1200,1201],{},"Record and stop",[31,1203,1204],{},"Watch the input level meter",[31,1206,1207,317,1210],{},[18,1208,1209],{},"Normalize",[18,1211,1212],{},"Noise Cancelation",[31,1214,1215],{},"Trim the whole clip, trim to a selection, or delete a selection",[31,1217,1218],{},"Undo \u002F redo",[31,1220,1221],{},"Zoom in and out",[23,1223,1225],{"id":1224},"stage-and-import","Stage and import",[28,1227,1228,1231,1234],{},[31,1229,1230],{},"Add the selection or the full track to the staging list.",[31,1232,1233],{},"The list starts empty: record, edit, then add a clip.",[31,1235,1236,317,1238,1240],{},[18,1237,595],{},[18,1239,598],{}," into the current tab or a tab you choose.",[23,1242,1244],{"id":1243},"stem-separation-optional","Stem separation (optional)",[14,1246,1247,1248,1251,1252,317,1255,1258],{},"Official Windows, macOS, and Linux release builds ship the ",[18,1249,1250],{},"stems"," feature. The Record Editor can keep ",[18,1253,1254],{},"vocals",[18,1256,1257],{},"music"," using BS-RoFormer.",[14,1260,1261,1262,1265,1266,1269],{},"The model is about 158 MB and is ",[18,1263,1264],{},"not"," bundled with the installer. Download it from ",[18,1267,1268],{},"Settings → Stem Separation",", or accept the first-run prompt. The Windows installer can also offer to download the model on first launch.",[14,1271,1272,1273,41,1276,1279],{},"Custom source builds need an extra flag (",[38,1274,1275],{},"tauri:serve:stems",[38,1277,1278],{},"tauri:build:stems",").",{"title":139,"searchDepth":140,"depth":140,"links":1281},[1282,1283,1284,1285],{"id":1162,"depth":140,"text":1163},{"id":1195,"depth":140,"text":1196},{"id":1224,"depth":140,"text":1225},{"id":1243,"depth":140,"text":1244},"Capture mic or PC audio, edit the clip, and drop it on your board.",{},6,"\u002Frecording-editor",{"title":1148,"description":1286},"WLz7ozLeboeLKawRkz53eUj5KSVCj4xkPMhYg5P_MIo",{"id":1293,"title":1294,"body":1295,"description":1508,"extension":147,"meta":1509,"navigation":149,"order":1510,"path":1511,"seo":1512,"stem":1299,"__hash__":1513},"content_en\u002Fremote-control.md","Remote Control",{"type":7,"value":1296,"toc":1501},[1297,1300,1303,1307,1336,1339,1342,1377,1381,1401,1404,1408,1440,1444,1450],[10,1298,1294],{"id":1299},"remote-control",[14,1301,1302],{},"SoundNinja can listen on your local network so Bitfocus Companion (or any HTTP\u002FWebSocket client) can play and stop sounds.",[23,1304,1306],{"id":1305},"enable-the-remote-server","Enable the remote server",[28,1308,1309,1314,1320,1326],{},[31,1310,526,1311,21],{},[18,1312,1313],{},"Settings → Remote",[31,1315,1316,1317,21],{},"Enable the remote server. Default port is ",[18,1318,1319],{},"7331",[31,1321,1322,1323,21],{},"Optional: set a token. Clients must send it as a Bearer token or ",[38,1324,1325],{},"?token=",[31,1327,1328,1329,1332,1333,21],{},"Copy the ",[38,1330,1331],{},"http:\u002F\u002FIP:PORT"," URL, or copy the system IP from ",[18,1334,1335],{},"Settings → About",[14,1337,1338],{},"Windows may show a firewall prompt the first time the server starts. Allow private-network access.",[23,1340,227],{"id":1341},"bitfocus-companion",[28,1343,1344,1351,1360,1370],{},[31,1345,1346,1347,21],{},"Install ",[224,1348,227],{"href":1349,"rel":1350},"https:\u002F\u002Fbitfocus.io\u002Fcompanion",[245],[31,1352,1353,1354,1359],{},"Download ",[224,1355,1358],{"href":1356,"rel":1357},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002Fcompanion-module-soundninja\u002Freleases\u002Flatest",[245],"SoundNinja-Companion.tgz",". There is no Companion Store package yet.",[31,1361,1362,1363,1366,1367,21],{},"In Companion: ",[18,1364,1365],{},"Modules → Load module package"," and pick the ",[38,1368,1369],{},".tgz",[31,1371,1372,1373,1376],{},"Add a ",[18,1374,1375],{},"Sound Ninja"," connection. Paste the PC IP, port, and token if you set one.",[23,1378,1380],{"id":1379},"actions","Actions",[66,1382,1383,1389,1395],{},[31,1384,1385,1388],{},[18,1386,1387],{},"Trigger Sound"," — pick from the live dropdown, or type an 8-character sound ID (Companion variables work)",[31,1390,1391,1394],{},[18,1392,1393],{},"Stop Sound"," — stop one playing sound by ID",[31,1396,1397,1400],{},[18,1398,1399],{},"Stop All"," — stop every playing sound",[14,1402,1403],{},"Copy a sound ID in SoundNinja from the button context menu or the multi-select ID chip.",[23,1405,1407],{"id":1406},"feedbacks-and-variables","Feedbacks and variables",[66,1409,1410,1416,1428,1434],{},[31,1411,1412,1415],{},[18,1413,1414],{},"Sound Playing"," — true while that sound ID is active (use it for button color)",[31,1417,1418,1421,1422,41,1425],{},[38,1419,1420],{},"$(soundninja:connected)"," — ",[38,1423,1424],{},"true",[38,1426,1427],{},"false",[31,1429,1430,1433],{},[38,1431,1432],{},"$(soundninja:playing_count)"," — how many sounds are playing",[31,1435,1436,1439],{},[38,1437,1438],{},"$(soundninja:last_triggered)"," — last triggered sound ID",[23,1441,1443],{"id":1442},"http-api-advanced","HTTP API (advanced)",[14,1445,1446,1447],{},"Base path: ",[38,1448,1449],{},"\u002Fapi\u002Fv1",[66,1451,1452,1458,1464,1470,1480,1486,1495],{},[31,1453,1454,1457],{},[38,1455,1456],{},"GET \u002Finfo"," — app name, version, protocol, whether a token is required",[31,1459,1460,1463],{},[38,1461,1462],{},"GET \u002Fsounds"," — sound list (id, name, tabs, active)",[31,1465,1466,1469],{},[38,1467,1468],{},"GET \u002Fstate"," — sounds plus currently playing IDs",[31,1471,1472,1475,1476,1479],{},[38,1473,1474],{},"POST \u002Ftrigger"," with ",[38,1477,1478],{},"{ \"id\" }"," — play a sound",[31,1481,1482,1485],{},[38,1483,1484],{},"GET \u002Ftrigger\u002F:id"," — play (easy to test in a browser)",[31,1487,1488,1491,1492,1494],{},[38,1489,1490],{},"POST \u002Fstop"," with optional ",[38,1493,1478],{}," — stop one sound or all",[31,1496,1497,1500],{},[38,1498,1499],{},"GET \u002Fws"," — live state; send trigger\u002Fstop commands inbound",{"title":139,"searchDepth":140,"depth":140,"links":1502},[1503,1504,1505,1506,1507],{"id":1305,"depth":140,"text":1306},{"id":1341,"depth":140,"text":227},{"id":1379,"depth":140,"text":1380},{"id":1406,"depth":140,"text":1407},{"id":1442,"depth":140,"text":1443},"Trigger SoundNinja from Bitfocus Companion over the local network.",{},7,"\u002Fremote-control",{"title":1294,"description":1508},"G5BV4-hARZULMfsuLaTyczPL2Qt2QKaPmATZuk65Lik",{"id":1515,"title":1516,"body":1517,"description":1606,"extension":147,"meta":1607,"navigation":149,"order":1608,"path":1609,"seo":1610,"stem":1521,"__hash__":1611},"content_en\u002Fsupport.md","Support",{"type":7,"value":1518,"toc":1599},[1519,1522,1525,1529,1532,1539,1547,1551,1558,1560,1573,1577,1588,1592],[10,1520,1516],{"id":1521},"support",[14,1523,1524],{},"SoundNinja is a community project in early beta. The fastest way to get help is GitHub.",[23,1526,1528],{"id":1527},"report-a-bug-or-ask-a-question","Report a bug or ask a question",[14,1530,1531],{},"Open an issue on GitHub:",[14,1533,1534],{},[224,1535,1538],{"href":1536,"rel":1537},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fissues",[245],"github.com\u002Fmarcus-universe\u002FSoundNinja\u002Fissues",[14,1540,1541,1542,317,1544,1546],{},"Include your OS, SoundNinja version (",[18,1543,403],{},[18,1545,1335],{},"), and steps to reproduce.",[23,1548,1550],{"id":1549},"email","Email",[14,1552,1553,1554],{},"Maintainer contact: ",[224,1555,1557],{"href":1556},"mailto:contact@marcus-universe.de","contact@marcus-universe.de",[23,1559,397],{"id":396},[14,1561,1562,1563,1565,1566,1568,1569,21],{},"In the app, use ",[18,1564,403],{},". New builds also appear on the ",[224,1567,298],{"href":297}," and on ",[224,1570,304],{"href":1571,"rel":1572},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Freleases",[245],[23,1574,1576],{"id":1575},"contribute","Contribute",[14,1578,1579,1580,1584,1585,21],{},"Pull requests are welcome. The app repo is ",[224,1581,1583],{"href":414,"rel":1582},[245],"github.com\u002Fmarcus-universe\u002FSoundNinja",". The project is licensed under ",[224,1586,246],{"href":243,"rel":1587},[245],[23,1589,1591],{"id":1590},"legal","Legal",[14,1593,1594,1595,21],{},"Imprint and contact details: ",[224,1596,1598],{"href":1597},"\u002Fimpressum","Impressum",{"title":139,"searchDepth":140,"depth":140,"links":1600},[1601,1602,1603,1604,1605],{"id":1527,"depth":140,"text":1528},{"id":1549,"depth":140,"text":1550},{"id":396,"depth":140,"text":397},{"id":1575,"depth":140,"text":1576},{"id":1590,"depth":140,"text":1591},"Where to get help and report bugs.",{},8,"\u002Fsupport",{"title":1516,"description":1606},"jRExoghmWgAfTmnmgqLhtQedAnIjqFIbv0_OahYrhTc",1789597755474]