[{"data":1,"prerenderedAt":1591},["ShallowReactive",2],{"docs-page-en-\u002Ftheme-editor":3,"docs-nav-en":154},{"id":4,"title":5,"body":6,"description":146,"extension":147,"meta":148,"navigation":149,"order":150,"path":151,"seo":152,"stem":12,"__hash__":153},"content_en\u002Ftheme-editor.md","Theme Editor",{"type":7,"value":8,"toc":138},"minimark",[9,13,22,27,58,61,65,80,84,110,113,117,124],[10,11,5],"h1",{"id":12},"theme-editor",[14,15,16,17,21],"p",{},"The Theme Creator is the full visual editor for your board. Open it from ",[18,19,20],"strong",{},"Settings → Main → Theme Creator",".",[23,24,26],"h2",{"id":25},"three-tabs","Three tabs",[28,29,30,46,52],"ol",{},[31,32,33,36,37,41,42,45],"li",{},[18,34,35],{},"General"," — theme name, shared colors, and font uploads (",[38,39,40],"code",{},".ttf"," \u002F ",[38,43,44],{},".otf",")",[31,47,48,51],{},[18,49,50],{},"Buttons"," — sound button colors, type, layout, and GIF overlay",[31,53,54,57],{},[18,55,56],{},"Tabs"," — tab bar colors, type, and border thickness",[14,59,60],{},"A live preview shows tabs and buttons as you edit.",[23,62,64],{"id":63},"what-you-can-change","What you can change",[66,67,68,71,74,77],"ul",{},[31,69,70],{},"Primary and accent colors, backgrounds, button colors, tab colors",[31,72,73],{},"Button and tab font family and size",[31,75,76],{},"Button width, radius, border width, gaps, and padding",[31,78,79],{},"GIF overlay opacity (normal and hover)",[23,81,83],{"id":82},"save-and-share","Save and share",[66,85,86,92,98,104],{},[31,87,88,91],{},[18,89,90],{},"Export .css"," — write a theme file you can back up or send to a friend",[31,93,94,97],{},[18,95,96],{},"Add to Themes"," — save the file into your Themes folder and apply it",[31,99,100,103],{},[18,101,102],{},"Import .css"," — load a built-in preset or a saved theme",[31,105,106,109],{},[18,107,108],{},"Reset"," — return to SoundNinja defaults",[14,111,112],{},"If you close the window with unsaved changes, SoundNinja asks you to save first.",[23,114,116],{"id":115},"without-the-full-editor","Without the full editor",[14,118,119,120,123],{},"In ",[18,121,122],{},"Settings → Main"," you can still:",[66,125,126,129,135],{},[31,127,128],{},"Pick a theme from the list",[31,130,131,132,45],{},"Edit CSS variables live (",[18,133,134],{},"Custom CSS",[31,136,137],{},"Import a theme file into the Themes folder",{"title":139,"searchDepth":140,"depth":140,"links":141},"",2,[142,143,144,145],{"id":25,"depth":140,"text":26},{"id":63,"depth":140,"text":64},{"id":82,"depth":140,"text":83},{"id":115,"depth":140,"text":116},"Design colors, fonts, buttons, and tabs in the Theme Creator.","md",{},true,5,"\u002Ftheme-editor",{"title":5,"description":146},"zpMjxENa49aUipEX7TBxcqrbaZNweyJ019KsLAMJeoc",[155,284,486,635,1036,1125,1271,1493],{"id":156,"title":157,"body":158,"description":278,"extension":147,"meta":279,"navigation":149,"order":280,"path":281,"seo":282,"stem":162,"__hash__":283},"content_en\u002Foverview.md","Overview",{"type":7,"value":159,"toc":272},[160,163,166,169,172,176,190,194,234,238,248,252],[10,161,157],{"id":162},"overview",[14,164,165],{},"SoundNinja is an open-source soundboard for live streaming, chatting with friends, and podcast recording. It is built with Tauri v2 and Nuxt 4 so it stays light on RAM and disk.",[14,167,168],{},"The goal is simple: keep a huge sound library easy to scan, then play the right clip in milliseconds. The UI also works well as a dashboard in VR.",[14,170,171],{},"SoundNinja is still in early development. Features work, but not every platform is fully tested.",[23,173,175],{"id":174},"who-it-is-for","Who it is for",[66,177,178,181,184,187],{},[31,179,180],{},"Streamers who need instant sound cues",[31,182,183],{},"Friends who want a shared board for voice chat",[31,185,186],{},"Podcasters who record clips and drop them onto a board",[31,188,189],{},"Anyone who wants a customizable, local-first soundboard",[23,191,193],{"id":192},"what-you-can-do","What you can do",[66,195,196,199,202,205,208,211,214,217,220,228,231],{},[31,197,198],{},"Build a soundboard from your own audio files",[31,200,201],{},"Organize sounds in colored tabs, groups, tags, and search",[31,203,204],{},"Filter by tags (OR) and sort by name, date, duration, or size",[31,206,207],{},"Multi-select with marquee or Shift-range, then bulk color, move, or delete",[31,209,210],{},"Set per-sound volume from the context menu",[31,212,213],{},"Design the look with the Theme Creator",[31,215,216],{},"Record PC audio or a microphone in the Record Editor",[31,218,219],{},"Assign hotkeys to individual sounds",[31,221,222,223],{},"Trigger sounds from ",[224,225,227],"a",{"href":226},"\u002Fdocs\u002Fremote-control","Bitfocus Companion",[31,229,230],{},"Import and export a full soundboard to share with others",[31,232,233],{},"Use GIFs or images on sound buttons — from a local folder library or KLIPY",[23,235,237],{"id":236},"license","License",[14,239,240,241,247],{},"SoundNinja is free software under ",[224,242,246],{"href":243,"rel":244},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fblob\u002Fmain\u002FLICENSE",[245],"nofollow","GPL-3.0",". Fork it, change it, share it.",[23,249,251],{"id":250},"next-steps","Next steps",[28,253,254,260,266],{},[31,255,256],{},[224,257,259],{"href":258},"\u002Fdocs\u002Finstallation","Install SoundNinja",[31,261,262],{},[224,263,265],{"href":264},"\u002Fdocs\u002Fadding-sounds","Add sounds",[31,267,268],{},[224,269,271],{"href":270},"\u002Fdocs\u002Forganizing-sounds","Organize your board",{"title":139,"searchDepth":140,"depth":140,"links":273},[274,275,276,277],{"id":174,"depth":140,"text":175},{"id":192,"depth":140,"text":193},{"id":236,"depth":140,"text":237},{"id":250,"depth":140,"text":251},"What SoundNinja is and what you can do with it.",{},1,"\u002Foverview",{"title":157,"description":278},"Dax9ydiOOeEz5F1IxWfEljWZynntK7dPp52JZ3q2G58",{"id":285,"title":286,"body":287,"description":481,"extension":147,"meta":482,"navigation":149,"order":140,"path":483,"seo":484,"stem":291,"__hash__":485},"content_en\u002Finstallation.md","Installation",{"type":7,"value":288,"toc":474},[289,292,306,310,331,334,338,352,355,359,383,394,398,405,409,424,454,470],[10,290,286],{"id":291},"installation",[14,293,294,295,299,300,305],{},"Grab a build from the ",[224,296,298],{"href":297},"\u002Fdownload","Download page"," or from ",[224,301,304],{"href":302,"rel":303},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Freleases\u002Flatest",[245],"GitHub Releases",". SoundNinja is in early development, so treat builds as beta.",[23,307,309],{"id":308},"windows","Windows",[66,311,312,322,325,328],{},[31,313,314,317,318,321],{},[18,315,316],{},"Installer (.exe)"," or ",[18,319,320],{},"MSI (.msi)"," for 64-bit Windows",[31,323,324],{},"Landing page target: Windows 10 and newer",[31,326,327],{},"The app README also lists Windows 8 and above",[31,329,330],{},"The NSIS installer uses a dark theme. Pick a language during setup — SoundNinja remembers it on the next launch.",[14,332,333],{},"Run the installer, then launch SoundNinja from the Start menu.",[23,335,337],{"id":336},"macos","macOS",[66,339,340,346,349],{},[31,341,342,345],{},[18,343,344],{},"Universal .dmg"," for Apple Silicon and Intel",[31,347,348],{},"Landing page target: macOS 10.14 and newer",[31,350,351],{},"The app README lists macOS 10.15 and above",[14,353,354],{},"Open the disk image and drag SoundNinja to Applications.",[23,356,358],{"id":357},"linux","Linux",[66,360,361,367,373,380],{},[31,362,363,366],{},[18,364,365],{},"Debian (.deb)"," for Ubuntu \u002F Debian",[31,368,369,372],{},[18,370,371],{},"AppImage"," for other distros",[31,374,375,376,379],{},"After a release is published, Arch users can install ",[38,377,378],{},"soundninja-bin"," from the AUR",[31,381,382],{},"Tested on Ubuntu 20.04",[14,384,385,386,389,390,393],{},"Desktop builds need WebKit and GTK packages. On Debian\u002FUbuntu that usually means ",[38,387,388],{},"libwebkit2gtk",", ",[38,391,392],{},"libgtk-3-0",", and an app-indicator library.",[23,395,397],{"id":396},"updates","Updates",[14,399,400,401,404],{},"In the app, open ",[18,402,403],{},"Help → Check for Updates",". You can also let SoundNinja check on startup in Settings.",[23,406,408],{"id":407},"build-from-source","Build from source",[14,410,411,412,417,418,423],{},"Need a custom build? Clone ",[224,413,416],{"href":414,"rel":415},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja",[245],"the repo",", install ",[224,419,422],{"href":420,"rel":421},"https:\u002F\u002Fv2.tauri.app\u002Fstart\u002Fprerequisites\u002F",[245],"Tauri prerequisites",", then:",[425,426,430],"pre",{"className":427,"code":428,"language":429,"meta":139,"style":139},"language-bash shiki shiki-themes github-light github-dark","bun install\nbun run tauri:serve\n","bash",[38,431,432,444],{"__ignoreMap":139},[433,434,436,440],"span",{"class":435,"line":280},"line",[433,437,439],{"class":438},"sScJk","bun",[433,441,443],{"class":442},"sZZnC"," install\n",[433,445,446,448,451],{"class":435,"line":140},[433,447,439],{"class":438},[433,449,450],{"class":442}," run",[433,452,453],{"class":442}," tauri:serve\n",[14,455,456,389,459,462,463,466,467,21],{},[38,457,458],{},"npm",[38,460,461],{},"pnpm",", or ",[38,464,465],{},"deno"," work too. Production build: ",[38,468,469],{},"bun run tauri:build",[471,472,473],"style",{},"html pre.shiki code .sScJk, html code.shiki .sScJk{--shiki-default:#6F42C1;--shiki-dark:#B392F0}html pre.shiki code .sZZnC, html code.shiki .sZZnC{--shiki-default:#032F62;--shiki-dark:#9ECBFF}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html.dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}",{"title":139,"searchDepth":140,"depth":140,"links":475},[476,477,478,479,480],{"id":308,"depth":140,"text":309},{"id":336,"depth":140,"text":337},{"id":357,"depth":140,"text":358},{"id":396,"depth":140,"text":397},{"id":407,"depth":140,"text":408},"Install SoundNinja on Windows, macOS, or Linux.",{},"\u002Finstallation",{"title":286,"description":481},"7viacDB8R6wsHmYhw6wWPv9XZF7nR_yMjR5-EjD4OjQ",{"id":487,"title":488,"body":489,"description":629,"extension":147,"meta":630,"navigation":149,"order":631,"path":632,"seo":633,"stem":493,"__hash__":634},"content_en\u002Fadding-sounds.md","Adding Sounds",{"type":7,"value":490,"toc":621},[491,494,497,501,520,524,556,560,579,583,597,600,604,611,615],[10,492,488],{"id":493},"adding-sounds",[14,495,496],{},"A board is empty until you add clips. SoundNinja can import files, whole folders, a recording, or a shared soundboard pack.",[23,498,500],{"id":499},"import-audio-files","Import audio files",[28,502,503,514,517],{},[31,504,505,506,509,510,513],{},"Open ",[18,507,508],{},"File → Import Audio Files",", or use ",[18,511,512],{},"Import"," in the navbar.",[31,515,516],{},"Pick one or more audio files.",[31,518,519],{},"Sounds land in the current tab.",[23,521,523],{"id":522},"import-folders","Import folders",[28,525,526,536,539],{},[31,527,505,528,531,532,535],{},[18,529,530],{},"File → Import Folders"," (or ",[18,533,534],{},"Import Folders"," in the navbar).",[31,537,538],{},"Add one or more folders. Drag to reorder them before you import.",[31,540,541,542],{},"Choose how they land:\n",[66,543,544,550],{},[31,545,546,549],{},[18,547,548],{},"Import as Tabs"," — each folder becomes its own tab",[31,551,552,555],{},[18,553,554],{},"Import to current Tab"," — every file goes into the active tab",[23,557,559],{"id":558},"record-a-clip","Record a clip",[14,561,562,563,567,568,571,572,317,575,578],{},"Open the ",[224,564,566],{"href":565},"\u002Fdocs\u002Frecording-editor","Record Editor"," from the ",[18,569,570],{},"Record"," button in the player bar. Capture, trim, then ",[18,573,574],{},"Import selected",[18,576,577],{},"Import all"," into the current tab or a tab you pick.",[23,580,582],{"id":581},"import-a-soundboard","Import a soundboard",[14,584,585,588,589,592,593,596],{},[18,586,587],{},"File → Import Soundboard"," loads a shared pack. Packs are a ",[38,590,591],{},".zip"," that contains ",[38,594,595],{},"project.sninja"," plus the sound files. After import, open the project and play.",[14,598,599],{},"You can also keep several projects (profiles). Use the project selector to switch boards.",[23,601,603],{"id":602},"relink-missing-files","Relink missing files",[14,605,606,607,610],{},"If audio files move on disk, SoundNinja shows a ",[18,608,609],{},"Missing sound files"," dialog. Pick a folder to search and relink the clips.",[23,612,614],{"id":613},"next","Next",[14,616,617,618,21],{},"Organize tabs, tags, filters, and hotkeys in ",[224,619,620],{"href":270},"Organizing Sounds",{"title":139,"searchDepth":140,"depth":140,"links":622},[623,624,625,626,627,628],{"id":499,"depth":140,"text":500},{"id":522,"depth":140,"text":523},{"id":558,"depth":140,"text":559},{"id":581,"depth":140,"text":582},{"id":602,"depth":140,"text":603},{"id":613,"depth":140,"text":614},"Import audio, folders, recordings, and shared soundboards.",{},3,"\u002Fadding-sounds",{"title":488,"description":629},"SBUvL_H4633CrDyNUKazqKwru4aq1hhgoH4_o99rBsE",{"id":636,"title":620,"body":637,"description":1030,"extension":147,"meta":1031,"navigation":149,"order":1032,"path":1033,"seo":1034,"stem":641,"__hash__":1035},"content_en\u002Forganizing-sounds.md",{"type":7,"value":638,"toc":1015},[639,642,649,652,679,685,689,692,706,713,719,723,733,738,770,774,780,784,817,823,827,830,857,860,864,878,882,888,909,925,932,936,946,949,953,960,970,976,980,988,995,1012],[10,640,620],{"id":641},"organizing-sounds",[14,643,644,645,648],{},"SoundNinja is built for large libraries. Use ",[18,646,647],{},"tags and filters",", tabs, search, multi-select, and hotkeys so the clip you need is one click (or one key) away.",[23,650,56],{"id":651},"tabs",[66,653,654,661,668],{},[31,655,656,657,660],{},"Add a tab with ",[18,658,659],{},"Add tab",". Give it a color so you can scan the bar fast.",[31,662,663,664,667],{},"The ",[18,665,666],{},"All"," view shows every sound across tabs.",[31,669,670,671,674,675,678],{},"A sound can belong to ",[18,672,673],{},"one or more tabs",". Right-click a sound and use ",[18,676,677],{},"Move to tab"," to assign it.",[14,680,681,682,684],{},"Tab transitions live in ",[18,683,122],{},": Slide, Fade, Buttons one by one, or None.",[23,686,688],{"id":687},"groups","Groups",[14,690,691],{},"Since v0.5.3, separators can become named groups:",[66,693,694,697,700,703],{},[31,695,696],{},"Add, rename, or remove a group from the context menu",[31,698,699],{},"Drag the group header — children move with it",[31,701,702],{},"Drop sounds in or out of a group",[31,704,705],{},"Set group border color, name color, and button alignment (or use the tab default)",[14,707,708,709,712],{},"You can still add a plain ",[18,710,711],{},"Separator"," if you only need a visual break.",[14,714,715,716,21],{},"Right-click empty board space to ",[18,717,718],{},"Add Group",[23,720,722],{"id":721},"tags-filters","Tags \u002F Filters",[14,724,725,726,729,730,732],{},"Tags cut across tabs. The slide-out ",[18,727,728],{},"Filter"," panel (sidebar ",[18,731,728],{},") is where you create them and turn them into a board filter.",[734,735,737],"h3",{"id":736},"create-and-edit-tags","Create and edit tags",[28,739,740,745,756,763],{},[31,741,505,742,744],{},[18,743,728],{}," in the sidebar.",[31,746,747,748,751,752,755],{},"Under ",[18,749,750],{},"Tags",", use ",[18,753,754],{},"Add tag"," — give it a name and a color.",[31,757,758,759,762],{},"Rename, recolor, or ",[18,760,761],{},"Delete tag"," from the same list.",[31,764,765,766,769],{},"If you see ",[18,767,768],{},"No tags yet",", add one here before you assign anything.",[734,771,773],{"id":772},"assign-tags-to-sounds","Assign tags to sounds",[14,775,776,777,779],{},"Right-click a sound → ",[18,778,750],{}," (checkboxes). A sound can have several tags. If none exist yet, the menu tells you to open the filter panel.",[734,781,783],{"id":782},"filter-the-board","Filter the board",[66,785,786,792,803,814],{},[31,787,788,789,21],{},"Toggle tags in the Filter panel, or as ",[18,790,791],{},"chips under the search bar",[31,793,794,795,798,799,802],{},"Matching is ",[18,796,797],{},"OR",": a sound stays visible if it has ",[18,800,801],{},"any"," selected tag.",[31,804,805,806,809,810,813],{},"The navbar ",[18,807,808],{},"Search"," field ",[18,811,812],{},"ANDs"," with the active tag filter (type + tags together).",[31,815,816],{},"Turn chips off (or clear the filter) to show the full tab again.",[14,818,819,820,21],{},"Colored tag names can appear on buttons. Toggle them in ",[18,821,822],{},"Settings → Behavior → Show tag badges",[23,824,826],{"id":825},"sort","Sort",[14,828,829],{},"Open the filter panel and pick a sort mode:",[66,831,832,838],{},[31,833,834,837],{},[18,835,836],{},"User defined"," — your tab order, with groups visible",[31,839,840,389,843,389,846,462,849,852,853,856],{},[18,841,842],{},"Name",[18,844,845],{},"Added time",[18,847,848],{},"Play time",[18,850,851],{},"File size"," — a flat sorted list; ",[18,854,855],{},"groups are hidden"," in these modes",[14,858,859],{},"Duration sort may warm duration metadata the first time you use it.",[23,861,863],{"id":862},"reorder","Reorder",[14,865,866,867,870,871,874,875,877],{},"Turn on drag-and-drop in ",[18,868,869],{},"Settings → Behavior"," (",[18,872,873],{},"Allow reorder","). Then drag sounds and groups into place. Reorder applies in ",[18,876,836],{}," sort.",[23,879,881],{"id":880},"multi-select","Multi-select",[14,883,884,885,887],{},"Turn on ",[18,886,881],{}," in the navbar, then:",[66,889,890,893,899,906],{},[31,891,892],{},"Click a sound to toggle it",[31,894,895,898],{},[18,896,897],{},"Shift+click"," to select a range from the last anchor",[31,900,901,902,905],{},"Drag a ",[18,903,904],{},"marquee"," on empty board space",[31,907,908],{},"Click empty board (or outside) to clear the selection",[14,910,911,912,389,915,389,918,921,922,21],{},"A bulk bar appears with the count, plus ",[18,913,914],{},"Color",[18,916,917],{},"Move to tab…",[18,919,920],{},"Delete",", and ",[18,923,924],{},"Done",[14,926,927,928,931],{},"In multi-select, each button shows an ",[18,929,930],{},"8-character ID chip",". Right-click the chip to copy it.",[23,933,935],{"id":934},"per-sound-volume","Per-sound volume",[14,937,776,938,941,942,945],{},[18,939,940],{},"Volume",". Drag the slider from 0% to 100%. ",[18,943,944],{},"Double-click"," the slider to reset to 100%.",[14,947,948],{},"This stacks with the master output volume in Settings.",[23,950,952],{"id":951},"hotkeys-and-sound-ids","Hotkeys and sound IDs",[14,954,955,956,959],{},"Every sound has an 8-character ID. Copy it from the button context menu (",[18,957,958],{},"Copy ID",") or the multi-select ID chip.",[14,961,505,962,965,966,969],{},[18,963,964],{},"Settings → Hotkeys"," to bind a key to a sound ID. Global hotkeys are optional. ",[18,967,968],{},"Assign hotkey"," on the context menu jumps there with the ID prefilled.",[14,971,972,973,975],{},"The same ID is what ",[224,974,227],{"href":226}," uses to trigger a clip.",[23,977,979],{"id":978},"background-images-and-colors","Background images and colors",[14,981,982,983,987],{},"Right-click a sound to set per-button colors or a background image. That is separate from the ",[224,984,986],{"href":985},"\u002Fdocs\u002Ftheme-editor","Theme Creator",", which styles the whole board.",[14,989,990,991,994],{},"The picker is a ",[18,992,993],{},"Background image"," dialog (PNG, JPEG, GIF, WebP):",[66,996,997,1003],{},[31,998,999,1002],{},[18,1000,1001],{},"Local files"," — add folders, pick a single file, search filenames, preview the grid, or remove a folder from the library",[31,1004,1005,1008,1009,1011],{},[18,1006,1007],{},"KLIPY"," — search online GIFs. Set your own API key in ",[18,1010,869],{},". The key is not stored in project files.",[14,1013,1014],{},"After you pick an image, pan and crop it on the button.",{"title":139,"searchDepth":140,"depth":140,"links":1016},[1017,1018,1019,1024,1025,1026,1027,1028,1029],{"id":651,"depth":140,"text":56},{"id":687,"depth":140,"text":688},{"id":721,"depth":140,"text":722,"children":1020},[1021,1022,1023],{"id":736,"depth":631,"text":737},{"id":772,"depth":631,"text":773},{"id":782,"depth":631,"text":783},{"id":825,"depth":140,"text":826},{"id":862,"depth":140,"text":863},{"id":880,"depth":140,"text":881},{"id":934,"depth":140,"text":935},{"id":951,"depth":140,"text":952},{"id":978,"depth":140,"text":979},"Tags, filters, tabs, groups, sort, multi-select, volume, and hotkeys.",{},4,"\u002Forganizing-sounds",{"title":620,"description":1030},"DaYqySVuX1kgdTnJw6h1GP_lGyj4zdFP2uKKbBEbVwQ",{"id":4,"title":5,"body":1037,"description":146,"extension":147,"meta":1123,"navigation":149,"order":150,"path":151,"seo":1124,"stem":12,"__hash__":153},{"type":7,"value":1038,"toc":1117},[1039,1041,1045,1047,1065,1067,1069,1079,1081,1099,1101,1103,1107],[10,1040,5],{"id":12},[14,1042,16,1043,21],{},[18,1044,20],{},[23,1046,26],{"id":25},[28,1048,1049,1057,1061],{},[31,1050,1051,36,1053,41,1055,45],{},[18,1052,35],{},[38,1054,40],{},[38,1056,44],{},[31,1058,1059,51],{},[18,1060,50],{},[31,1062,1063,57],{},[18,1064,56],{},[14,1066,60],{},[23,1068,64],{"id":63},[66,1070,1071,1073,1075,1077],{},[31,1072,70],{},[31,1074,73],{},[31,1076,76],{},[31,1078,79],{},[23,1080,83],{"id":82},[66,1082,1083,1087,1091,1095],{},[31,1084,1085,91],{},[18,1086,90],{},[31,1088,1089,97],{},[18,1090,96],{},[31,1092,1093,103],{},[18,1094,102],{},[31,1096,1097,109],{},[18,1098,108],{},[14,1100,112],{},[23,1102,116],{"id":115},[14,1104,119,1105,123],{},[18,1106,122],{},[66,1108,1109,1111,1115],{},[31,1110,128],{},[31,1112,131,1113,45],{},[18,1114,134],{},[31,1116,137],{},{"title":139,"searchDepth":140,"depth":140,"links":1118},[1119,1120,1121,1122],{"id":25,"depth":140,"text":26},{"id":63,"depth":140,"text":64},{"id":82,"depth":140,"text":83},{"id":115,"depth":140,"text":116},{},{"title":5,"description":146},{"id":1126,"title":1127,"body":1128,"description":1265,"extension":147,"meta":1266,"navigation":149,"order":1267,"path":1268,"seo":1269,"stem":1132,"__hash__":1270},"content_en\u002Frecording-editor.md","Recording Editor",{"type":7,"value":1129,"toc":1259},[1130,1133,1139,1143,1149,1169,1172,1176,1201,1205,1220,1224,1238,1249],[10,1131,1127],{"id":1132},"recording-editor",[14,1134,1135,1136,1138],{},"Record a clip inside SoundNinja, trim it, then import it onto a tab. Open the editor with the ",[18,1137,570],{}," button in the player bar.",[23,1140,1142],{"id":1141},"choose-an-input","Choose an input",[14,1144,119,1145,1148],{},[18,1146,1147],{},"Settings → Audio",":",[66,1150,1151,1157,1163],{},[31,1152,1153,1156],{},[18,1154,1155],{},"Input Devices"," — microphone",[31,1158,1159,1162],{},[18,1160,1161],{},"Output Devices (PC Audio)"," — loopback of what your PC is playing",[31,1164,1165,1168],{},[18,1166,1167],{},"Input volume"," — capture gain from 0% to 200%",[14,1170,1171],{},"The Record button uses the device you pick here.",[23,1173,1175],{"id":1174},"edit-the-take","Edit the take",[66,1177,1178,1181,1184,1192,1195,1198],{},[31,1179,1180],{},"Record and stop",[31,1182,1183],{},"Watch the input level meter",[31,1185,1186,317,1189],{},[18,1187,1188],{},"Normalize",[18,1190,1191],{},"Noise Cancelation",[31,1193,1194],{},"Trim the whole clip, trim to a selection, or delete a selection",[31,1196,1197],{},"Undo \u002F redo",[31,1199,1200],{},"Zoom in and out",[23,1202,1204],{"id":1203},"stage-and-import","Stage and import",[28,1206,1207,1210,1213],{},[31,1208,1209],{},"Add the selection or the full track to the staging list.",[31,1211,1212],{},"The list starts empty: record, edit, then add a clip.",[31,1214,1215,317,1217,1219],{},[18,1216,574],{},[18,1218,577],{}," into the current tab or a tab you choose.",[23,1221,1223],{"id":1222},"stem-separation-optional","Stem separation (optional)",[14,1225,1226,1227,1230,1231,317,1234,1237],{},"Official Windows, macOS, and Linux release builds ship the ",[18,1228,1229],{},"stems"," feature. The Record Editor can keep ",[18,1232,1233],{},"vocals",[18,1235,1236],{},"music"," using BS-RoFormer.",[14,1239,1240,1241,1244,1245,1248],{},"The model is about 158 MB and is ",[18,1242,1243],{},"not"," bundled with the installer. Download it from ",[18,1246,1247],{},"Settings → Stem Separation",", or accept the first-run prompt. The Windows installer can also offer to download the model on first launch.",[14,1250,1251,1252,41,1255,1258],{},"Custom source builds need an extra flag (",[38,1253,1254],{},"tauri:serve:stems",[38,1256,1257],{},"tauri:build:stems",").",{"title":139,"searchDepth":140,"depth":140,"links":1260},[1261,1262,1263,1264],{"id":1141,"depth":140,"text":1142},{"id":1174,"depth":140,"text":1175},{"id":1203,"depth":140,"text":1204},{"id":1222,"depth":140,"text":1223},"Capture mic or PC audio, edit the clip, and drop it on your board.",{},6,"\u002Frecording-editor",{"title":1127,"description":1265},"WLz7ozLeboeLKawRkz53eUj5KSVCj4xkPMhYg5P_MIo",{"id":1272,"title":1273,"body":1274,"description":1487,"extension":147,"meta":1488,"navigation":149,"order":1489,"path":1490,"seo":1491,"stem":1278,"__hash__":1492},"content_en\u002Fremote-control.md","Remote Control",{"type":7,"value":1275,"toc":1480},[1276,1279,1282,1286,1315,1318,1321,1356,1360,1380,1383,1387,1419,1423,1429],[10,1277,1273],{"id":1278},"remote-control",[14,1280,1281],{},"SoundNinja can listen on your local network so Bitfocus Companion (or any HTTP\u002FWebSocket client) can play and stop sounds.",[23,1283,1285],{"id":1284},"enable-the-remote-server","Enable the remote server",[28,1287,1288,1293,1299,1305],{},[31,1289,505,1290,21],{},[18,1291,1292],{},"Settings → Remote",[31,1294,1295,1296,21],{},"Enable the remote server. Default port is ",[18,1297,1298],{},"7331",[31,1300,1301,1302,21],{},"Optional: set a token. Clients must send it as a Bearer token or ",[38,1303,1304],{},"?token=",[31,1306,1307,1308,1311,1312,21],{},"Copy the ",[38,1309,1310],{},"http:\u002F\u002FIP:PORT"," URL, or copy the system IP from ",[18,1313,1314],{},"Settings → About",[14,1316,1317],{},"Windows may show a firewall prompt the first time the server starts. Allow private-network access.",[23,1319,227],{"id":1320},"bitfocus-companion",[28,1322,1323,1330,1339,1349],{},[31,1324,1325,1326,21],{},"Install ",[224,1327,227],{"href":1328,"rel":1329},"https:\u002F\u002Fbitfocus.io\u002Fcompanion",[245],[31,1331,1332,1333,1338],{},"Download ",[224,1334,1337],{"href":1335,"rel":1336},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002Fcompanion-module-soundninja\u002Freleases\u002Flatest",[245],"SoundNinja-Companion.tgz",". There is no Companion Store package yet.",[31,1340,1341,1342,1345,1346,21],{},"In Companion: ",[18,1343,1344],{},"Modules → Load module package"," and pick the ",[38,1347,1348],{},".tgz",[31,1350,1351,1352,1355],{},"Add a ",[18,1353,1354],{},"Sound Ninja"," connection. Paste the PC IP, port, and token if you set one.",[23,1357,1359],{"id":1358},"actions","Actions",[66,1361,1362,1368,1374],{},[31,1363,1364,1367],{},[18,1365,1366],{},"Trigger Sound"," — pick from the live dropdown, or type an 8-character sound ID (Companion variables work)",[31,1369,1370,1373],{},[18,1371,1372],{},"Stop Sound"," — stop one playing sound by ID",[31,1375,1376,1379],{},[18,1377,1378],{},"Stop All"," — stop every playing sound",[14,1381,1382],{},"Copy a sound ID in SoundNinja from the button context menu or the multi-select ID chip.",[23,1384,1386],{"id":1385},"feedbacks-and-variables","Feedbacks and variables",[66,1388,1389,1395,1407,1413],{},[31,1390,1391,1394],{},[18,1392,1393],{},"Sound Playing"," — true while that sound ID is active (use it for button color)",[31,1396,1397,1400,1401,41,1404],{},[38,1398,1399],{},"$(soundninja:connected)"," — ",[38,1402,1403],{},"true",[38,1405,1406],{},"false",[31,1408,1409,1412],{},[38,1410,1411],{},"$(soundninja:playing_count)"," — how many sounds are playing",[31,1414,1415,1418],{},[38,1416,1417],{},"$(soundninja:last_triggered)"," — last triggered sound ID",[23,1420,1422],{"id":1421},"http-api-advanced","HTTP API (advanced)",[14,1424,1425,1426],{},"Base path: ",[38,1427,1428],{},"\u002Fapi\u002Fv1",[66,1430,1431,1437,1443,1449,1459,1465,1474],{},[31,1432,1433,1436],{},[38,1434,1435],{},"GET \u002Finfo"," — app name, version, protocol, whether a token is required",[31,1438,1439,1442],{},[38,1440,1441],{},"GET \u002Fsounds"," — sound list (id, name, tabs, active)",[31,1444,1445,1448],{},[38,1446,1447],{},"GET \u002Fstate"," — sounds plus currently playing IDs",[31,1450,1451,1454,1455,1458],{},[38,1452,1453],{},"POST \u002Ftrigger"," with ",[38,1456,1457],{},"{ \"id\" }"," — play a sound",[31,1460,1461,1464],{},[38,1462,1463],{},"GET \u002Ftrigger\u002F:id"," — play (easy to test in a browser)",[31,1466,1467,1470,1471,1473],{},[38,1468,1469],{},"POST \u002Fstop"," with optional ",[38,1472,1457],{}," — stop one sound or all",[31,1475,1476,1479],{},[38,1477,1478],{},"GET \u002Fws"," — live state; send trigger\u002Fstop commands inbound",{"title":139,"searchDepth":140,"depth":140,"links":1481},[1482,1483,1484,1485,1486],{"id":1284,"depth":140,"text":1285},{"id":1320,"depth":140,"text":227},{"id":1358,"depth":140,"text":1359},{"id":1385,"depth":140,"text":1386},{"id":1421,"depth":140,"text":1422},"Trigger SoundNinja from Bitfocus Companion over the local network.",{},7,"\u002Fremote-control",{"title":1273,"description":1487},"G5BV4-hARZULMfsuLaTyczPL2Qt2QKaPmATZuk65Lik",{"id":1494,"title":1495,"body":1496,"description":1585,"extension":147,"meta":1586,"navigation":149,"order":1587,"path":1588,"seo":1589,"stem":1500,"__hash__":1590},"content_en\u002Fsupport.md","Support",{"type":7,"value":1497,"toc":1578},[1498,1501,1504,1508,1511,1518,1526,1530,1537,1539,1552,1556,1567,1571],[10,1499,1495],{"id":1500},"support",[14,1502,1503],{},"SoundNinja is a community project in early beta. The fastest way to get help is GitHub.",[23,1505,1507],{"id":1506},"report-a-bug-or-ask-a-question","Report a bug or ask a question",[14,1509,1510],{},"Open an issue on GitHub:",[14,1512,1513],{},[224,1514,1517],{"href":1515,"rel":1516},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fissues",[245],"github.com\u002Fmarcus-universe\u002FSoundNinja\u002Fissues",[14,1519,1520,1521,317,1523,1525],{},"Include your OS, SoundNinja version (",[18,1522,403],{},[18,1524,1314],{},"), and steps to reproduce.",[23,1527,1529],{"id":1528},"email","Email",[14,1531,1532,1533],{},"Maintainer contact: ",[224,1534,1536],{"href":1535},"mailto:contact@marcus-universe.de","contact@marcus-universe.de",[23,1538,397],{"id":396},[14,1540,1541,1542,1544,1545,1547,1548,21],{},"In the app, use ",[18,1543,403],{},". New builds also appear on the ",[224,1546,298],{"href":297}," and on ",[224,1549,304],{"href":1550,"rel":1551},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Freleases",[245],[23,1553,1555],{"id":1554},"contribute","Contribute",[14,1557,1558,1559,1563,1564,21],{},"Pull requests are welcome. The app repo is ",[224,1560,1562],{"href":414,"rel":1561},[245],"github.com\u002Fmarcus-universe\u002FSoundNinja",". The project is licensed under ",[224,1565,246],{"href":243,"rel":1566},[245],[23,1568,1570],{"id":1569},"legal","Legal",[14,1572,1573,1574,21],{},"Imprint and contact details: ",[224,1575,1577],{"href":1576},"\u002Fimpressum","Impressum",{"title":139,"searchDepth":140,"depth":140,"links":1579},[1580,1581,1582,1583,1584],{"id":1506,"depth":140,"text":1507},{"id":1528,"depth":140,"text":1529},{"id":396,"depth":140,"text":397},{"id":1554,"depth":140,"text":1555},{"id":1569,"depth":140,"text":1570},"Where to get help and report bugs.",{},8,"\u002Fsupport",{"title":1495,"description":1585},"jRExoghmWgAfTmnmgqLhtQedAnIjqFIbv0_OahYrhTc",1789586416589]