[{"data":1,"prerenderedAt":1326},["ShallowReactive",2],{"docs-page-en-\u002Ftheme-editor":3,"docs-nav-en":154},{"id":4,"title":5,"body":6,"description":146,"extension":147,"meta":148,"navigation":149,"order":150,"path":151,"seo":152,"stem":12,"__hash__":153},"content_en\u002Ftheme-editor.md","Theme Editor",{"type":7,"value":8,"toc":138},"minimark",[9,13,22,27,58,61,65,80,84,110,113,117,124],[10,11,5],"h1",{"id":12},"theme-editor",[14,15,16,17,21],"p",{},"The Theme Creator is the full visual editor for your board. Open it from ",[18,19,20],"strong",{},"Settings → Main → Theme Creator",".",[23,24,26],"h2",{"id":25},"three-tabs","Three tabs",[28,29,30,46,52],"ol",{},[31,32,33,36,37,41,42,45],"li",{},[18,34,35],{},"General"," — theme name, shared colors, and font uploads (",[38,39,40],"code",{},".ttf"," \u002F ",[38,43,44],{},".otf",")",[31,47,48,51],{},[18,49,50],{},"Buttons"," — sound button colors, type, layout, and GIF overlay",[31,53,54,57],{},[18,55,56],{},"Tabs"," — tab bar colors, type, and border thickness",[14,59,60],{},"A live preview shows tabs and buttons as you edit.",[23,62,64],{"id":63},"what-you-can-change","What you can change",[66,67,68,71,74,77],"ul",{},[31,69,70],{},"Primary and accent colors, backgrounds, button colors, tab colors",[31,72,73],{},"Button and tab font family and size",[31,75,76],{},"Button width, radius, border width, gaps, and padding",[31,78,79],{},"GIF overlay opacity (normal and hover)",[23,81,83],{"id":82},"save-and-share","Save and share",[66,85,86,92,98,104],{},[31,87,88,91],{},[18,89,90],{},"Export .css"," — write a theme file you can back up or send to a friend",[31,93,94,97],{},[18,95,96],{},"Add to Themes"," — save the file into your Themes folder and apply it",[31,99,100,103],{},[18,101,102],{},"Import .css"," — load a built-in preset or a saved theme",[31,105,106,109],{},[18,107,108],{},"Reset"," — return to SoundNinja defaults",[14,111,112],{},"If you close the window with unsaved changes, SoundNinja asks you to save first.",[23,114,116],{"id":115},"without-the-full-editor","Without the full editor",[14,118,119,120,123],{},"In ",[18,121,122],{},"Settings → Main"," you can still:",[66,125,126,129,135],{},[31,127,128],{},"Pick a theme from the list",[31,130,131,132,45],{},"Edit CSS variables live (",[18,133,134],{},"Custom CSS",[31,136,137],{},"Import a theme file into the Themes folder",{"title":139,"searchDepth":140,"depth":140,"links":141},"",2,[142,143,144,145],{"id":25,"depth":140,"text":26},{"id":63,"depth":140,"text":64},{"id":82,"depth":140,"text":83},{"id":115,"depth":140,"text":116},"Design colors, fonts, buttons, and tabs in the Theme Creator.","md",{},true,5,"\u002Ftheme-editor",{"title":5,"description":146},"zpMjxENa49aUipEX7TBxcqrbaZNweyJ019KsLAMJeoc",[155,275,474,623,775,864,1006,1228],{"id":156,"title":157,"body":158,"description":269,"extension":147,"meta":270,"navigation":149,"order":271,"path":272,"seo":273,"stem":162,"__hash__":274},"content_en\u002Foverview.md","Overview",{"type":7,"value":159,"toc":263},[160,163,166,169,172,176,190,194,225,229,239,243],[10,161,157],{"id":162},"overview",[14,164,165],{},"SoundNinja is an open-source soundboard for live streaming, chatting with friends, and podcast recording. It is built with Tauri v2 and Nuxt 4 so it stays light on RAM and disk.",[14,167,168],{},"The goal is simple: keep a huge sound library easy to scan, then play the right clip in milliseconds. The UI also works well as a dashboard in VR.",[14,170,171],{},"SoundNinja is still in early development. Features work, but not every platform is fully tested.",[23,173,175],{"id":174},"who-it-is-for","Who it is for",[66,177,178,181,184,187],{},[31,179,180],{},"Streamers who need instant sound cues",[31,182,183],{},"Friends who want a shared board for voice chat",[31,185,186],{},"Podcasters who record clips and drop them onto a board",[31,188,189],{},"Anyone who wants a customizable, local-first soundboard",[23,191,193],{"id":192},"what-you-can-do","What you can do",[66,195,196,199,202,205,208,211,219,222],{},[31,197,198],{},"Build a soundboard from your own audio files",[31,200,201],{},"Organize sounds in colored tabs, groups, and search",[31,203,204],{},"Design the look with the Theme Creator",[31,206,207],{},"Record PC audio or a microphone in the Record Editor",[31,209,210],{},"Assign hotkeys to individual sounds",[31,212,213,214],{},"Trigger sounds from ",[215,216,218],"a",{"href":217},"\u002Fdocs\u002Fremote-control","Bitfocus Companion",[31,220,221],{},"Import and export a full soundboard to share with others",[31,223,224],{},"Use GIFs or images on sound buttons",[23,226,228],{"id":227},"license","License",[14,230,231,232,238],{},"SoundNinja is free software under ",[215,233,237],{"href":234,"rel":235},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fblob\u002Fmain\u002FLICENSE",[236],"nofollow","GPL-3.0",". Fork it, change it, share it.",[23,240,242],{"id":241},"next-steps","Next steps",[28,244,245,251,257],{},[31,246,247],{},[215,248,250],{"href":249},"\u002Fdocs\u002Finstallation","Install SoundNinja",[31,252,253],{},[215,254,256],{"href":255},"\u002Fdocs\u002Fadding-sounds","Add sounds",[31,258,259],{},[215,260,262],{"href":261},"\u002Fdocs\u002Forganizing-sounds","Organize your board",{"title":139,"searchDepth":140,"depth":140,"links":264},[265,266,267,268],{"id":174,"depth":140,"text":175},{"id":192,"depth":140,"text":193},{"id":227,"depth":140,"text":228},{"id":241,"depth":140,"text":242},"What SoundNinja is and what you can do with it.",{},1,"\u002Foverview",{"title":157,"description":269},"cOxJIh0ybRdZsyS1INxo9O3CTipyV8220IKpyfnYFJA",{"id":276,"title":277,"body":278,"description":469,"extension":147,"meta":470,"navigation":149,"order":140,"path":471,"seo":472,"stem":282,"__hash__":473},"content_en\u002Finstallation.md","Installation",{"type":7,"value":279,"toc":462},[280,283,297,301,319,322,326,340,343,347,371,382,386,393,397,412,442,458],[10,281,277],{"id":282},"installation",[14,284,285,286,290,291,296],{},"Grab a build from the ",[215,287,289],{"href":288},"\u002Fdownload","Download page"," or from ",[215,292,295],{"href":293,"rel":294},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Freleases\u002Flatest",[236],"GitHub Releases",". SoundNinja is in early development, so treat builds as beta.",[23,298,300],{"id":299},"windows","Windows",[66,302,303,313,316],{},[31,304,305,308,309,312],{},[18,306,307],{},"Installer (.exe)"," or ",[18,310,311],{},"MSI (.msi)"," for 64-bit Windows",[31,314,315],{},"Landing page target: Windows 10 and newer",[31,317,318],{},"The app README also lists Windows 8 and above",[14,320,321],{},"Run the installer, then launch SoundNinja from the Start menu.",[23,323,325],{"id":324},"macos","macOS",[66,327,328,334,337],{},[31,329,330,333],{},[18,331,332],{},"Universal .dmg"," for Apple Silicon and Intel",[31,335,336],{},"Landing page target: macOS 10.14 and newer",[31,338,339],{},"The app README lists macOS 10.15 and above",[14,341,342],{},"Open the disk image and drag SoundNinja to Applications.",[23,344,346],{"id":345},"linux","Linux",[66,348,349,355,361,368],{},[31,350,351,354],{},[18,352,353],{},"Debian (.deb)"," for Ubuntu \u002F Debian",[31,356,357,360],{},[18,358,359],{},"AppImage"," for other distros",[31,362,363,364,367],{},"After a release is published, Arch users can install ",[38,365,366],{},"soundninja-bin"," from the AUR",[31,369,370],{},"Tested on Ubuntu 20.04",[14,372,373,374,377,378,381],{},"Desktop builds need WebKit and GTK packages. On Debian\u002FUbuntu that usually means ",[38,375,376],{},"libwebkit2gtk",", ",[38,379,380],{},"libgtk-3-0",", and an app-indicator library.",[23,383,385],{"id":384},"updates","Updates",[14,387,388,389,392],{},"In the app, open ",[18,390,391],{},"Help → Check for Updates",". You can also let SoundNinja check on startup in Settings.",[23,394,396],{"id":395},"build-from-source","Build from source",[14,398,399,400,405,406,411],{},"Need a custom build? Clone ",[215,401,404],{"href":402,"rel":403},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja",[236],"the repo",", install ",[215,407,410],{"href":408,"rel":409},"https:\u002F\u002Fv2.tauri.app\u002Fstart\u002Fprerequisites\u002F",[236],"Tauri prerequisites",", then:",[413,414,418],"pre",{"className":415,"code":416,"language":417,"meta":139,"style":139},"language-bash shiki shiki-themes github-light github-dark","bun install\nbun run tauri:serve\n","bash",[38,419,420,432],{"__ignoreMap":139},[421,422,424,428],"span",{"class":423,"line":271},"line",[421,425,427],{"class":426},"sScJk","bun",[421,429,431],{"class":430},"sZZnC"," install\n",[421,433,434,436,439],{"class":423,"line":140},[421,435,427],{"class":426},[421,437,438],{"class":430}," run",[421,440,441],{"class":430}," tauri:serve\n",[14,443,444,377,447,450,451,454,455,21],{},[38,445,446],{},"npm",[38,448,449],{},"pnpm",", or ",[38,452,453],{},"deno"," work too. Production build: ",[38,456,457],{},"bun run tauri:build",[459,460,461],"style",{},"html pre.shiki code .sScJk, html code.shiki .sScJk{--shiki-default:#6F42C1;--shiki-dark:#B392F0}html pre.shiki code .sZZnC, html code.shiki .sZZnC{--shiki-default:#032F62;--shiki-dark:#9ECBFF}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html.dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}",{"title":139,"searchDepth":140,"depth":140,"links":463},[464,465,466,467,468],{"id":299,"depth":140,"text":300},{"id":324,"depth":140,"text":325},{"id":345,"depth":140,"text":346},{"id":384,"depth":140,"text":385},{"id":395,"depth":140,"text":396},"Install SoundNinja on Windows, macOS, or Linux.",{},"\u002Finstallation",{"title":277,"description":469},"i4XnnjkhxVb30IICErH1K_cBbAQ7GmnD52FYRYjh50k",{"id":475,"title":476,"body":477,"description":617,"extension":147,"meta":618,"navigation":149,"order":619,"path":620,"seo":621,"stem":481,"__hash__":622},"content_en\u002Fadding-sounds.md","Adding Sounds",{"type":7,"value":478,"toc":609},[479,482,485,489,508,512,544,548,567,571,585,588,592,599,603],[10,480,476],{"id":481},"adding-sounds",[14,483,484],{},"A board is empty until you add clips. SoundNinja can import files, whole folders, a recording, or a shared soundboard pack.",[23,486,488],{"id":487},"import-audio-files","Import audio files",[28,490,491,502,505],{},[31,492,493,494,497,498,501],{},"Open ",[18,495,496],{},"File → Import Audio Files",", or use ",[18,499,500],{},"Import"," in the navbar.",[31,503,504],{},"Pick one or more audio files.",[31,506,507],{},"Sounds land in the current tab.",[23,509,511],{"id":510},"import-folders","Import folders",[28,513,514,524,527],{},[31,515,493,516,519,520,523],{},[18,517,518],{},"File → Import Folders"," (or ",[18,521,522],{},"Import Folders"," in the navbar).",[31,525,526],{},"Add one or more folders. Drag to reorder them before you import.",[31,528,529,530],{},"Choose how they land:\n",[66,531,532,538],{},[31,533,534,537],{},[18,535,536],{},"Import as Tabs"," — each folder becomes its own tab",[31,539,540,543],{},[18,541,542],{},"Import to current Tab"," — every file goes into the active tab",[23,545,547],{"id":546},"record-a-clip","Record a clip",[14,549,550,551,555,556,559,560,308,563,566],{},"Open the ",[215,552,554],{"href":553},"\u002Fdocs\u002Frecording-editor","Record Editor"," from the ",[18,557,558],{},"Record"," button in the player bar. Capture, trim, then ",[18,561,562],{},"Import selected",[18,564,565],{},"Import all"," into the current tab or a tab you pick.",[23,568,570],{"id":569},"import-a-soundboard","Import a soundboard",[14,572,573,576,577,580,581,584],{},[18,574,575],{},"File → Import Soundboard"," loads a shared pack. Packs are a ",[38,578,579],{},".zip"," that contains ",[38,582,583],{},"project.sninja"," plus the sound files. After import, open the project and play.",[14,586,587],{},"You can also keep several projects (profiles). Use the project selector to switch boards.",[23,589,591],{"id":590},"relink-missing-files","Relink missing files",[14,593,594,595,598],{},"If audio files move on disk, SoundNinja shows a ",[18,596,597],{},"Missing sound files"," dialog. Pick a folder to search and relink the clips.",[23,600,602],{"id":601},"next","Next",[14,604,605,606,21],{},"Organize tabs, groups, and hotkeys in ",[215,607,608],{"href":261},"Organizing Sounds",{"title":139,"searchDepth":140,"depth":140,"links":610},[611,612,613,614,615,616],{"id":487,"depth":140,"text":488},{"id":510,"depth":140,"text":511},{"id":546,"depth":140,"text":547},{"id":569,"depth":140,"text":570},{"id":590,"depth":140,"text":591},{"id":601,"depth":140,"text":602},"Import audio, folders, recordings, and shared soundboards.",{},3,"\u002Fadding-sounds",{"title":476,"description":617},"qcK88xpbquf2dRogb67sx4O0tzuIof13-X3Yyn9680o",{"id":624,"title":608,"body":625,"description":769,"extension":147,"meta":770,"navigation":149,"order":771,"path":772,"seo":773,"stem":629,"__hash__":774},"content_en\u002Forganizing-sounds.md",{"type":7,"value":626,"toc":760},[627,630,633,636,663,669,673,676,690,697,701,707,711,722,726,729,733,736,742,748,752],[10,628,608],{"id":629},"organizing-sounds",[14,631,632],{},"SoundNinja is built for large libraries. Use tabs, groups, search, and hotkeys so the clip you need is one click (or one key) away.",[23,634,56],{"id":635},"tabs",[66,637,638,645,652],{},[31,639,640,641,644],{},"Add a tab with ",[18,642,643],{},"Add tab",". Give it a color so you can scan the bar fast.",[31,646,647,648,651],{},"The ",[18,649,650],{},"All"," view shows every sound across tabs.",[31,653,654,655,658,659,662],{},"A sound can belong to ",[18,656,657],{},"one or more tabs",". Right-click a sound and use ",[18,660,661],{},"Move to tab"," to assign it.",[14,664,665,666,668],{},"Tab transitions live in ",[18,667,122],{},": Slide, Fade, Buttons one by one, or None.",[23,670,672],{"id":671},"groups","Groups",[14,674,675],{},"Since v0.5.3, separators can become named groups:",[66,677,678,681,684,687],{},[31,679,680],{},"Add, rename, or remove a group from the context menu",[31,682,683],{},"Drag the group header — children move with it",[31,685,686],{},"Drop sounds in or out of a group",[31,688,689],{},"Set group border color, name color, and button alignment (or use the tab default)",[14,691,692,693,696],{},"You can still add a plain ",[18,694,695],{},"Separator"," if you only need a visual break.",[23,698,700],{"id":699},"search","Search",[14,702,703,704,706],{},"Use the ",[18,705,700],{}," field in the navbar. Results update as you type.",[23,708,710],{"id":709},"reorder","Reorder",[14,712,713,714,717,718,721],{},"Turn on drag-and-drop in ",[18,715,716],{},"Settings → Behavior"," (",[18,719,720],{},"Allow reorder","). Then drag sounds and groups into place.",[23,723,725],{"id":724},"bulk-edit","Bulk edit",[14,727,728],{},"Multi-select sounds, then change color, move them to a tab, or delete them in one step.",[23,730,732],{"id":731},"hotkeys-and-sound-ids","Hotkeys and sound IDs",[14,734,735],{},"Every sound has an 8-character ID. Copy it from the button context menu or the multi-select ID chip.",[14,737,493,738,741],{},[18,739,740],{},"Settings → Hotkeys"," to bind a key to a sound ID. Global hotkeys are optional.",[14,743,744,745,747],{},"The same ID is what ",[215,746,218],{"href":217}," uses to trigger a clip.",[23,749,751],{"id":750},"gifs-and-colors","GIFs and colors",[14,753,754,755,759],{},"Right-click a sound to set per-button colors or a GIF \u002F image background. That is separate from the ",[215,756,758],{"href":757},"\u002Fdocs\u002Ftheme-editor","Theme Creator",", which styles the whole board.",{"title":139,"searchDepth":140,"depth":140,"links":761},[762,763,764,765,766,767,768],{"id":635,"depth":140,"text":56},{"id":671,"depth":140,"text":672},{"id":699,"depth":140,"text":700},{"id":709,"depth":140,"text":710},{"id":724,"depth":140,"text":725},{"id":731,"depth":140,"text":732},{"id":750,"depth":140,"text":751},"Tabs, groups, search, bulk edit, and hotkeys.",{},4,"\u002Forganizing-sounds",{"title":608,"description":769},"Q4gLPzceZdOi3j6gqMTmPuTzf4qua7p2dfLn2shjKT4",{"id":4,"title":5,"body":776,"description":146,"extension":147,"meta":862,"navigation":149,"order":150,"path":151,"seo":863,"stem":12,"__hash__":153},{"type":7,"value":777,"toc":856},[778,780,784,786,804,806,808,818,820,838,840,842,846],[10,779,5],{"id":12},[14,781,16,782,21],{},[18,783,20],{},[23,785,26],{"id":25},[28,787,788,796,800],{},[31,789,790,36,792,41,794,45],{},[18,791,35],{},[38,793,40],{},[38,795,44],{},[31,797,798,51],{},[18,799,50],{},[31,801,802,57],{},[18,803,56],{},[14,805,60],{},[23,807,64],{"id":63},[66,809,810,812,814,816],{},[31,811,70],{},[31,813,73],{},[31,815,76],{},[31,817,79],{},[23,819,83],{"id":82},[66,821,822,826,830,834],{},[31,823,824,91],{},[18,825,90],{},[31,827,828,97],{},[18,829,96],{},[31,831,832,103],{},[18,833,102],{},[31,835,836,109],{},[18,837,108],{},[14,839,112],{},[23,841,116],{"id":115},[14,843,119,844,123],{},[18,845,122],{},[66,847,848,850,854],{},[31,849,128],{},[31,851,131,852,45],{},[18,853,134],{},[31,855,137],{},{"title":139,"searchDepth":140,"depth":140,"links":857},[858,859,860,861],{"id":25,"depth":140,"text":26},{"id":63,"depth":140,"text":64},{"id":82,"depth":140,"text":83},{"id":115,"depth":140,"text":116},{},{"title":5,"description":146},{"id":865,"title":866,"body":867,"description":1000,"extension":147,"meta":1001,"navigation":149,"order":1002,"path":1003,"seo":1004,"stem":871,"__hash__":1005},"content_en\u002Frecording-editor.md","Recording Editor",{"type":7,"value":868,"toc":994},[869,872,878,882,888,908,911,915,940,944,959,963,977,984],[10,870,866],{"id":871},"recording-editor",[14,873,874,875,877],{},"Record a clip inside SoundNinja, trim it, then import it onto a tab. Open the editor with the ",[18,876,558],{}," button in the player bar.",[23,879,881],{"id":880},"choose-an-input","Choose an input",[14,883,119,884,887],{},[18,885,886],{},"Settings → Audio",":",[66,889,890,896,902],{},[31,891,892,895],{},[18,893,894],{},"Input Devices"," — microphone",[31,897,898,901],{},[18,899,900],{},"Output Devices (PC Audio)"," — loopback of what your PC is playing",[31,903,904,907],{},[18,905,906],{},"Input volume"," — capture gain from 0% to 200%",[14,909,910],{},"The Record button uses the device you pick here.",[23,912,914],{"id":913},"edit-the-take","Edit the take",[66,916,917,920,923,931,934,937],{},[31,918,919],{},"Record and stop",[31,921,922],{},"Watch the input level meter",[31,924,925,308,928],{},[18,926,927],{},"Normalize",[18,929,930],{},"Noise Cancelation",[31,932,933],{},"Trim the whole clip, trim to a selection, or delete a selection",[31,935,936],{},"Undo \u002F redo",[31,938,939],{},"Zoom in and out",[23,941,943],{"id":942},"stage-and-import","Stage and import",[28,945,946,949,952],{},[31,947,948],{},"Add the selection or the full track to the staging list.",[31,950,951],{},"The list starts empty: record, edit, then add a clip.",[31,953,954,308,956,958],{},[18,955,562],{},[18,957,565],{}," into the current tab or a tab you choose.",[23,960,962],{"id":961},"stem-separation-optional","Stem separation (optional)",[14,964,965,966,308,969,972,973,976],{},"The Record Editor can keep ",[18,967,968],{},"vocals",[18,970,971],{},"music"," using BS-RoFormer. The model is about 158 MB and is ",[18,974,975],{},"not"," bundled with the app.",[14,978,979,980,983],{},"Download it from ",[18,981,982],{},"Settings → Stem Separation",", or accept the first-run prompt. The Windows installer can also offer to download the model on first launch.",[14,985,986,987,41,990,993],{},"Stem builds from source need an extra flag (",[38,988,989],{},"tauri:serve:stems",[38,991,992],{},"tauri:build:stems",").",{"title":139,"searchDepth":140,"depth":140,"links":995},[996,997,998,999],{"id":880,"depth":140,"text":881},{"id":913,"depth":140,"text":914},{"id":942,"depth":140,"text":943},{"id":961,"depth":140,"text":962},"Capture mic or PC audio, edit the clip, and drop it on your board.",{},6,"\u002Frecording-editor",{"title":866,"description":1000},"MJVcc7XyjWmtAdA8N6FQhHNz88XkH8JRCYOy28MJ364",{"id":1007,"title":1008,"body":1009,"description":1222,"extension":147,"meta":1223,"navigation":149,"order":1224,"path":1225,"seo":1226,"stem":1013,"__hash__":1227},"content_en\u002Fremote-control.md","Remote Control",{"type":7,"value":1010,"toc":1215},[1011,1014,1017,1021,1050,1053,1056,1091,1095,1115,1118,1122,1154,1158,1164],[10,1012,1008],{"id":1013},"remote-control",[14,1015,1016],{},"SoundNinja can listen on your local network so Bitfocus Companion (or any HTTP\u002FWebSocket client) can play and stop sounds.",[23,1018,1020],{"id":1019},"enable-the-remote-server","Enable the remote server",[28,1022,1023,1028,1034,1040],{},[31,1024,493,1025,21],{},[18,1026,1027],{},"Settings → Remote",[31,1029,1030,1031,21],{},"Enable the remote server. Default port is ",[18,1032,1033],{},"7331",[31,1035,1036,1037,21],{},"Optional: set a token. Clients must send it as a Bearer token or ",[38,1038,1039],{},"?token=",[31,1041,1042,1043,1046,1047,21],{},"Copy the ",[38,1044,1045],{},"http:\u002F\u002FIP:PORT"," URL, or copy the system IP from ",[18,1048,1049],{},"Settings → About",[14,1051,1052],{},"Windows may show a firewall prompt the first time the server starts. Allow private-network access.",[23,1054,218],{"id":1055},"bitfocus-companion",[28,1057,1058,1065,1074,1084],{},[31,1059,1060,1061,21],{},"Install ",[215,1062,218],{"href":1063,"rel":1064},"https:\u002F\u002Fbitfocus.io\u002Fcompanion",[236],[31,1066,1067,1068,1073],{},"Download ",[215,1069,1072],{"href":1070,"rel":1071},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Freleases\u002Flatest\u002Fdownload\u002Fcompanion-module-soundninja.tgz",[236],"companion-module-soundninja.tgz",". There is no Companion Store package yet.",[31,1075,1076,1077,1080,1081,21],{},"In Companion: ",[18,1078,1079],{},"Modules → Load module package"," and pick the ",[38,1082,1083],{},".tgz",[31,1085,1086,1087,1090],{},"Add a ",[18,1088,1089],{},"Sound Ninja"," connection. Paste the PC IP, port, and token if you set one.",[23,1092,1094],{"id":1093},"actions","Actions",[66,1096,1097,1103,1109],{},[31,1098,1099,1102],{},[18,1100,1101],{},"Trigger Sound"," — pick from the live dropdown, or type an 8-character sound ID (Companion variables work)",[31,1104,1105,1108],{},[18,1106,1107],{},"Stop Sound"," — stop one playing sound by ID",[31,1110,1111,1114],{},[18,1112,1113],{},"Stop All"," — stop every playing sound",[14,1116,1117],{},"Copy a sound ID in SoundNinja from the button context menu or the multi-select ID chip.",[23,1119,1121],{"id":1120},"feedbacks-and-variables","Feedbacks and variables",[66,1123,1124,1130,1142,1148],{},[31,1125,1126,1129],{},[18,1127,1128],{},"Sound Playing"," — true while that sound ID is active (use it for button color)",[31,1131,1132,1135,1136,41,1139],{},[38,1133,1134],{},"$(soundninja:connected)"," — ",[38,1137,1138],{},"true",[38,1140,1141],{},"false",[31,1143,1144,1147],{},[38,1145,1146],{},"$(soundninja:playing_count)"," — how many sounds are playing",[31,1149,1150,1153],{},[38,1151,1152],{},"$(soundninja:last_triggered)"," — last triggered sound ID",[23,1155,1157],{"id":1156},"http-api-advanced","HTTP API (advanced)",[14,1159,1160,1161],{},"Base path: ",[38,1162,1163],{},"\u002Fapi\u002Fv1",[66,1165,1166,1172,1178,1184,1194,1200,1209],{},[31,1167,1168,1171],{},[38,1169,1170],{},"GET \u002Finfo"," — app name, version, protocol, whether a token is required",[31,1173,1174,1177],{},[38,1175,1176],{},"GET \u002Fsounds"," — sound list (id, name, tabs, active)",[31,1179,1180,1183],{},[38,1181,1182],{},"GET \u002Fstate"," — sounds plus currently playing IDs",[31,1185,1186,1189,1190,1193],{},[38,1187,1188],{},"POST \u002Ftrigger"," with ",[38,1191,1192],{},"{ \"id\" }"," — play a sound",[31,1195,1196,1199],{},[38,1197,1198],{},"GET \u002Ftrigger\u002F:id"," — play (easy to test in a browser)",[31,1201,1202,1205,1206,1208],{},[38,1203,1204],{},"POST \u002Fstop"," with optional ",[38,1207,1192],{}," — stop one sound or all",[31,1210,1211,1214],{},[38,1212,1213],{},"GET \u002Fws"," — live state; send trigger\u002Fstop commands inbound",{"title":139,"searchDepth":140,"depth":140,"links":1216},[1217,1218,1219,1220,1221],{"id":1019,"depth":140,"text":1020},{"id":1055,"depth":140,"text":218},{"id":1093,"depth":140,"text":1094},{"id":1120,"depth":140,"text":1121},{"id":1156,"depth":140,"text":1157},"Trigger SoundNinja from Bitfocus Companion over the local network.",{},7,"\u002Fremote-control",{"title":1008,"description":1222},"wUUXEeUIG0wA5XHXyiMCGZXzR5yznF1l2ByKM6FEobI",{"id":1229,"title":1230,"body":1231,"description":1320,"extension":147,"meta":1321,"navigation":149,"order":1322,"path":1323,"seo":1324,"stem":1235,"__hash__":1325},"content_en\u002Fsupport.md","Support",{"type":7,"value":1232,"toc":1313},[1233,1236,1239,1243,1246,1253,1261,1265,1272,1274,1287,1291,1302,1306],[10,1234,1230],{"id":1235},"support",[14,1237,1238],{},"SoundNinja is a community project in early beta. The fastest way to get help is GitHub.",[23,1240,1242],{"id":1241},"report-a-bug-or-ask-a-question","Report a bug or ask a question",[14,1244,1245],{},"Open an issue on GitHub:",[14,1247,1248],{},[215,1249,1252],{"h