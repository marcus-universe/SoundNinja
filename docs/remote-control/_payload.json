,[30,1579,490],{},[30,1581,56],{},"), and steps to reproduce.",[18,1584,1586],{"id":1585},"email","Email",[14,1588,1589,1590],{},"Maintainer contact: ",[70,1591,1593],{"href":1592},"mailto:contact@marcus-universe.de","contact@marcus-universe.de",[18,1595,484],{"id":483},[14,1597,1598,1599,1601,1602,1604,1605,33],{},"In the app, use ",[30,1600,490],{},". New builds also appear on the ",[70,1603,385],{"href":384}," and on ",[70,1606,391],{"href":1607,"rel":1608},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Freleases",[74],[18,1610,1612],{"id":1611},"contribute","Contribute",[14,1614,1615,1616,1620,1621,33],{},"Pull requests are welcome. The app repo is ",[70,1617,1619],{"href":501,"rel":1618},[74],"github.com\u002Fmarcus-universe\u002FSoundNinja",". The project is licensed under ",[70,1622,333],{"href":331,"rel":1623},[74],[18,1625,1627],{"id":1626},"legal","Legal",[14,1629,1630,1631,33],{},"Imprint and contact details: ",[70,1632,1634],{"href":1633},"\u002Fimpressum","Impressum",{"title":228,"searchDepth":229,"depth":229,"links":1636},[1637,1638,1639,1640,1641],{"id":1563,"depth":229,"text":1564},{"id":1585,"depth":229,"text":1586},{"id":483,"depth":229,"text":484},{"id":1611,"depth":229,"text":1612},{"id":1626,"depth":229,"text":1627},"Where to get help and report bugs.",{},8,"\u002Fsupport",{"title":1552,"description":1642},"jRExoghmWgAfTmnmgqLhtQedAnIjqFIbv0_OahYrhTc",1789586416619]