"description":236},{"id":1582,"title":1583,"body":1584,"description":1673,"extension":237,"meta":1674,"navigation":239,"order":1675,"path":1676,"seo":1677,"stem":1588,"__hash__":1678},"content_en\u002Fsupport.md","Support",{"type":7,"value":1585,"toc":1666},[1586,1589,1592,1596,1599,1606,1614,1618,1625,1627,1640,1644,1655,1659],[10,1587,1583],{"id":1588},"support",[14,1590,1591],{},"SoundNinja is a community project in early beta. The fastest way to get help is GitHub.",[18,1593,1595],{"id":1594},"report-a-bug-or-ask-a-question","Report a bug or ask a question",[14,1597,1598],{},"Open an issue on GitHub:",[14,1600,1601],{},[70,1602,1605],{"href":1603,"rel":1604},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fissues",[74],"github.com\u002Fmarcus-universe\u002FSoundNinja\u002Fissues",[14,1607,1608,1609,404,1611,1613],{},"Include your OS, SoundNinja version (",[30,1610,490],{},[30,1612,56],{},"), and steps to reproduce.",[18,1615,1617],{"id":1616},"email","Email",[14,1619,1620,1621],{},"Maintainer contact: ",[70,1622,1624],{"href":1623},"mailto:contact@marcus-universe.de","contact@marcus-universe.de",[18,1626,484],{"id":483},[14,1628,1629,1630,1632,1633,1635,1636,33],{},"In the app, use ",[30,1631,490],{},". New builds also appear on the ",[70,1634,385],{"href":384}," and on ",[70,1637,391],{"href":1638,"rel":1639},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Freleases",[74],[18,1641,1643],{"id":1642},"contribute","Contribute",[14,1645,1646,1647,1651,1652,33],{},"Pull requests are welcome. The app repo is ",[70,1648,1650],{"href":501,"rel":1649},[74],"github.com\u002Fmarcus-universe\u002FSoundNinja",". The project is licensed under ",[70,1653,333],{"href":331,"rel":1654},[74],[18,1656,1658],{"id":1657},"legal","Legal",[14,1660,1661,1662,33],{},"Imprint and contact details: ",[70,1663,1665],{"href":1664},"\u002Fimpressum","Impressum",{"title":228,"searchDepth":229,"depth":229,"links":1667},[1668,1669,1670,1671,1672],{"id":1594,"depth":229,"text":1595},{"id":1616,"depth":229,"text":1617},{"id":483,"depth":229,"text":484},{"id":1642,"depth":229,"text":1643},{"id":1657,"depth":229,"text":1658},"Where to get help and report bugs.",{},8,"\u002Fsupport",{"title":1583,"description":1673},"jRExoghmWgAfTmnmgqLhtQedAnIjqFIbv0_OahYrhTc",1789685088540]