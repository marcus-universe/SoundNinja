[{"data":1,"prerenderedAt":1669},["ShallowReactive",2],{"docs-page-en-\u002Fremote-control":3,"docs-nav-en":244},{"id":4,"title":5,"body":6,"description":236,"extension":237,"meta":238,"navigation":239,"order":240,"path":241,"seo":242,"stem":12,"__hash__":243},"content_en\u002Fremote-control.md","Remote Control",{"type":7,"value":8,"toc":227},"minimark",[9,13,17,22,57,60,64,101,105,126,129,133,166,170,176],[10,11,5],"h1",{"id":12},"remote-control",[14,15,16],"p",{},"SoundNinja can listen on your local network so Bitfocus Companion (or any HTTP\u002FWebSocket client) can play and stop sounds.",[18,19,21],"h2",{"id":20},"enable-the-remote-server","Enable the remote server",[23,24,25,34,40,47],"ol",{},[26,27,28,29,33],"li",{},"Open ",[30,31,32],"strong",{},"Settings → Remote",".",[26,35,36,37,33],{},"Enable the remote server. Default port is ",[30,38,39],{},"7331",[26,41,42,43,33],{},"Optional: set a token. Clients must send it as a Bearer token or ",[44,45,46],"code",{},"?token=",[26,48,49,50,53,54,33],{},"Copy the ",[44,51,52],{},"http:\u002F\u002FIP:PORT"," URL, or copy the system IP from ",[30,55,56],{},"Settings → About",[14,58,59],{},"Windows may show a firewall prompt the first time the server starts. Allow private-network access.",[18,61,63],{"id":62},"bitfocus-companion","Bitfocus Companion",[23,65,66,75,84,94],{},[26,67,68,69,33],{},"Install ",[70,71,63],"a",{"href":72,"rel":73},"https:\u002F\u002Fbitfocus.io\u002Fcompanion",[74],"nofollow",[26,76,77,78,83],{},"Download ",[70,79,82],{"href":80,"rel":81},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002Fcompanion-module-soundninja\u002Freleases\u002Flatest",[74],"SoundNinja-Companion.tgz",". There is no Companion Store package yet.",[26,85,86,87,90,91,33],{},"In Companion: ",[30,88,89],{},"Modules → Load module package"," and pick the ",[44,92,93],{},".tgz",[26,95,96,97,100],{},"Add a ",[30,98,99],{},"Sound Ninja"," connection. Paste the PC IP, port, and token if you set one.",[18,102,104],{"id":103},"actions","Actions",[106,107,108,114,120],"ul",{},[26,109,110,113],{},[30,111,112],{},"Trigger Sound"," — pick from the live dropdown, or type an 8-character sound ID (Companion variables work)",[26,115,116,119],{},[30,117,118],{},"Stop Sound"," — stop one playing sound by ID",[26,121,122,125],{},[30,123,124],{},"Stop All"," — stop every playing sound",[14,127,128],{},"Copy a sound ID in SoundNinja from the button context menu or the multi-select ID chip.",[18,130,132],{"id":131},"feedbacks-and-variables","Feedbacks and variables",[106,134,135,141,154,160],{},[26,136,137,140],{},[30,138,139],{},"Sound Playing"," — true while that sound ID is active (use it for button color)",[26,142,143,146,147,150,151],{},[44,144,145],{},"$(soundninja:connected)"," — ",[44,148,149],{},"true"," \u002F ",[44,152,153],{},"false",[26,155,156,159],{},[44,157,158],{},"$(soundninja:playing_count)"," — how many sounds are playing",[26,161,162,165],{},[44,163,164],{},"$(soundninja:last_triggered)"," — last triggered sound ID",[18,167,169],{"id":168},"http-api-advanced","HTTP API (advanced)",[14,171,172,173],{},"Base path: ",[44,174,175],{},"\u002Fapi\u002Fv1",[106,177,178,184,190,196,206,212,221],{},[26,179,180,183],{},[44,181,182],{},"GET \u002Finfo"," — app name, version, protocol, whether a token is required",[26,185,186,189],{},[44,187,188],{},"GET \u002Fsounds"," — sound list (id, name, tabs, active)",[26,191,192,195],{},[44,193,194],{},"GET \u002Fstate"," — sounds plus currently playing IDs",[26,197,198,201,202,205],{},[44,199,200],{},"POST \u002Ftrigger"," with ",[44,203,204],{},"{ \"id\" }"," — play a sound",[26,207,208,211],{},[44,209,210],{},"GET \u002Ftrigger\u002F:id"," — play (easy to test in a browser)",[26,213,214,217,218,220],{},[44,215,216],{},"POST \u002Fstop"," with optional ",[44,219,204],{}," — stop one sound or all",[26,222,223,226],{},[44,224,225],{},"GET \u002Fws"," — live state; send trigger\u002Fstop commands inbound",{"title":228,"searchDepth":229,"depth":229,"links":230},"",2,[231,232,233,234,235],{"id":20,"depth":229,"text":21},{"id":62,"depth":229,"text":63},{"id":103,"depth":229,"text":104},{"id":131,"depth":229,"text":132},{"id":168,"depth":229,"text":169},"Trigger SoundNinja from Bitfocus Companion over the local network.","md",{},true,7,"\u002Fremote-control",{"title":5,"description":236},"G5BV4-hARZULMfsuLaTyczPL2Qt2QKaPmATZuk65Lik",[245,371,594,742,1145,1279,1425,1571],{"id":246,"title":247,"body":248,"description":365,"extension":237,"meta":366,"navigation":239,"order":367,"path":368,"seo":369,"stem":252,"__hash__":370},"content_en\u002Foverview.md","Overview",{"type":7,"value":249,"toc":359},[250,253,256,259,262,266,280,284,322,326,335,339],[10,251,247],{"id":252},"overview",[14,254,255],{},"SoundNinja is an open-source soundboard for live streaming, chatting with friends, and podcast recording. It is built with Tauri v2 and Nuxt 4 so it stays light on RAM and disk.",[14,257,258],{},"The goal is simple: keep a huge sound library easy to scan, then play the right clip in milliseconds. The UI also works well as a dashboard in VR.",[14,260,261],{},"SoundNinja is still in early development. Features work, but not every platform is fully tested.",[18,263,265],{"id":264},"who-it-is-for","Who it is for",[106,267,268,271,274,277],{},[26,269,270],{},"Streamers who need instant sound cues",[26,272,273],{},"Friends who want a shared board for voice chat",[26,275,276],{},"Podcasters who record clips and drop them onto a board",[26,278,279],{},"Anyone who wants a customizable, local-first soundboard",[18,281,283],{"id":282},"what-you-can-do","What you can do",[106,285,286,289,292,295,298,301,304,307,310,316,319],{},[26,287,288],{},"Build a soundboard from your own audio files",[26,290,291],{},"Organize sounds in colored tabs, groups, tags, and search",[26,293,294],{},"Filter by tags (OR) and sort by name, date, duration, or size",[26,296,297],{},"Multi-select with marquee or Shift-range, then bulk color, move, or delete",[26,299,300],{},"Set per-sound volume from the context menu",[26,302,303],{},"Design the look with the Theme Creator",[26,305,306],{},"Record PC audio or a microphone in the Record Editor",[26,308,309],{},"Assign hotkeys to individual sounds",[26,311,312,313],{},"Trigger sounds from ",[70,314,63],{"href":315},"\u002Fdocs\u002Fremote-control",[26,317,318],{},"Import and export a full soundboard to share with others",[26,320,321],{},"Use GIFs or images on sound buttons — from a local folder library or KLIPY",[18,323,325],{"id":324},"license","License",[14,327,328,329,334],{},"SoundNinja is free software under ",[70,330,333],{"href":331,"rel":332},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fblob\u002Fmain\u002FLICENSE",[74],"GPL-3.0",". Fork it, change it, share it.",[18,336,338],{"id":337},"next-steps","Next steps",[23,340,341,347,353],{},[26,342,343],{},[70,344,346],{"href":345},"\u002Fdocs\u002Finstallation","Install SoundNinja",[26,348,349],{},[70,350,352],{"href":351},"\u002Fdocs\u002Fadding-sounds","Add sounds",[26,354,355],{},[70,356,358],{"href":357},"\u002Fdocs\u002Forganizing-sounds","Organize your board",{"title":228,"searchDepth":229,"depth":229,"links":360},[361,362,363,364],{"id":264,"depth":229,"text":265},{"id":282,"depth":229,"text":283},{"id":324,"depth":229,"text":325},{"id":337,"depth":229,"text":338},"What SoundNinja is and what you can do with it.",{},1,"\u002Foverview",{"title":247,"description":365},"Dax9ydiOOeEz5F1IxWfEljWZynntK7dPp52JZ3q2G58",{"id":372,"title":373,"body":374,"description":589,"extension":237,"meta":590,"navigation":239,"order":229,"path":591,"seo":592,"stem":378,"__hash__":593},"content_en\u002Finstallation.md","Installation",{"type":7,"value":375,"toc":582},[376,379,393,397,418,421,425,439,442,446,470,481,485,492,496,511,541,557,578],[10,377,373],{"id":378},"installation",[14,380,381,382,386,387,392],{},"Grab a build from the ",[70,383,385],{"href":384},"\u002Fdownload","Download page"," or from ",[70,388,391],{"href":389,"rel":390},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Freleases\u002Flatest",[74],"GitHub Releases",". SoundNinja is in early development, so treat builds as beta.",[18,394,396],{"id":395},"windows","Windows",[106,398,399,409,412,415],{},[26,400,401,404,405,408],{},[30,402,403],{},"Installer (.exe)"," or ",[30,406,407],{},"MSI (.msi)"," for 64-bit Windows",[26,410,411],{},"Landing page target: Windows 10 and newer",[26,413,414],{},"The app README also lists Windows 8 and above",[26,416,417],{},"The NSIS installer uses a dark theme. Pick a language during setup — SoundNinja remembers it on the next launch.",[14,419,420],{},"Run the installer, then launch SoundNinja from the Start menu.",[18,422,424],{"id":423},"macos","macOS",[106,426,427,433,436],{},[26,428,429,432],{},[30,430,431],{},"Universal .dmg"," for Apple Silicon and Intel",[26,434,435],{},"Landing page target: macOS 10.14 and newer",[26,437,438],{},"The app README lists macOS 10.15 and above",[14,440,441],{},"Open the disk image and drag SoundNinja to Applications.",[18,443,445],{"id":444},"linux","Linux",[106,447,448,454,460,467],{},[26,449,450,453],{},[30,451,452],{},"Debian (.deb)"," for Ubuntu \u002F Debian",[26,455,456,459],{},[30,457,458],{},"AppImage"," for other distros",[26,461,462,463,466],{},"After a release is published, Arch users can install ",[44,464,465],{},"soundninja-bin"," from the AUR",[26,468,469],{},"Tested on Ubuntu 20.04",[14,471,472,473,476,477,480],{},"Desktop builds need WebKit and GTK packages. On Debian\u002FUbuntu that usually means ",[44,474,475],{},"libwebkit2gtk",", ",[44,478,479],{},"libgtk-3-0",", and an app-indicator library.",[18,482,484],{"id":483},"updates","Updates",[14,486,487,488,491],{},"In the app, open ",[30,489,490],{},"Help → Check for Updates",". You can also let SoundNinja check on startup in Settings.",[18,493,495],{"id":494},"build-from-source","Build from source",[14,497,498,499,504,505,510],{},"Need a custom build? Clone ",[70,500,503],{"href":501,"rel":502},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja",[74],"the repo",", install ",[70,506,509],{"href":507,"rel":508},"https:\u002F\u002Fv2.tauri.app\u002Fstart\u002Fprerequisites\u002F",[74],"Tauri prerequisites",", then:",[512,513,517],"pre",{"className":514,"code":515,"language":516,"meta":228,"style":228},"language-bash shiki shiki-themes github-light github-dark","bun install\nbun run tauri:serve\n","bash",[44,518,519,531],{"__ignoreMap":228},[520,521,523,527],"span",{"class":522,"line":367},"line",[520,524,526],{"class":525},"sScJk","bun",[520,528,530],{"class":529},"sZZnC"," install\n",[520,532,533,535,538],{"class":522,"line":229},[520,534,526],{"class":525},[520,536,537],{"class":529}," run",[520,539,540],{"class":529}," tauri:serve\n",[14,542,543,476,546,549,550,553,554,33],{},[44,544,545],{},"npm",[44,547,548],{},"pnpm",", or ",[44,551,552],{},"deno"," work too. Production build: ",[44,555,556],{},"bun run tauri:build",[14,558,559,562,563,568,569,572,573,33],{},[30,560,561],{},"Windows only:"," every Windows compile includes ASIO via the ",[70,564,567],{"href":565,"rel":566},"https:\u002F\u002Fwww.steinberg.net\u002Fasiosdk",[74],"Steinberg ASIO SDK",". Run ",[44,570,571],{},"bun run setup:asio"," once (SDK is not in git). Linux and macOS use PipeWire \u002F Core Audio — skip that step. Full notes: ",[70,574,577],{"href":575,"rel":576},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fblob\u002Fmain\u002Fdocs\u002Fbuild-from-source.md",[74],"build-from-source.md",[579,580,581],"style",{},"html pre.shiki code .sScJk, html code.shiki .sScJk{--shiki-default:#6F42C1;--shiki-dark:#B392F0}html pre.shiki code .sZZnC, html code.shiki .sZZnC{--shiki-default:#032F62;--shiki-dark:#9ECBFF}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html.dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}",{"title":228,"searchDepth":229,"depth":229,"links":583},[584,585,586,587,588],{"id":395,"depth":229,"text":396},{"id":423,"depth":229,"text":424},{"id":444,"depth":229,"text":445},{"id":483,"depth":229,"text":484},{"id":494,"depth":229,"text":495},"Install SoundNinja on Windows, macOS, or Linux.",{},"\u002Finstallation",{"title":373,"description":589},"outLmMLibzOL_84ZfoLBrmphO4wVu0zaTr0u_DS4GUg",{"id":595,"title":596,"body":597,"description":736,"extension":237,"meta":737,"navigation":239,"order":738,"path":739,"seo":740,"stem":601,"__hash__":741},"content_en\u002Fadding-sounds.md","Adding Sounds",{"type":7,"value":598,"toc":728},[599,602,605,609,627,631,663,667,686,690,704,707,711,718,722],[10,600,596],{"id":601},"adding-sounds",[14,603,604],{},"A board is empty until you add clips. SoundNinja can import files, whole folders, a recording, or a shared soundboard pack.",[18,606,608],{"id":607},"import-audio-files","Import audio files",[23,610,611,621,624],{},[26,612,28,613,616,617,620],{},[30,614,615],{},"File → Import Audio Files",", or use ",[30,618,619],{},"Import"," in the navbar.",[26,622,623],{},"Pick one or more audio files.",[26,625,626],{},"Sounds land in the current tab.",[18,628,630],{"id":629},"import-folders","Import folders",[23,632,633,643,646],{},[26,634,28,635,638,639,642],{},[30,636,637],{},"File → Import Folders"," (or ",[30,640,641],{},"Import Folders"," in the navbar).",[26,644,645],{},"Add one or more folders. Drag to reorder them before you import.",[26,647,648,649],{},"Choose how they land:\n",[106,650,651,657],{},[26,652,653,656],{},[30,654,655],{},"Import as Tabs"," — each folder becomes its own tab",[26,658,659,662],{},[30,660,661],{},"Import to current Tab"," — every file goes into the active tab",[18,664,666],{"id":665},"record-a-clip","Record a clip",[14,668,669,670,674,675,678,679,404,682,685],{},"Open the ",[70,671,673],{"href":672},"\u002Fdocs\u002Frecording-editor","Record Editor"," from the ",[30,676,677],{},"Record"," button in the player bar. Capture, trim, then ",[30,680,681],{},"Import selected",[30,683,684],{},"Import all"," into the current tab or a tab you pick.",[18,687,689],{"id":688},"import-a-soundboard","Import a soundboard",[14,691,692,695,696,699,700,703],{},[30,693,694],{},"File → Import Soundboard"," loads a shared pack. Packs are a ",[44,697,698],{},".zip"," that contains ",[44,701,702],{},"project.sninja"," plus the sound files. After import, open the project and play.",[14,705,706],{},"You can also keep several projects (profiles). Use the project selector to switch boards.",[18,708,710],{"id":709},"relink-missing-files","Relink missing files",[14,712,713,714,717],{},"If audio files move on disk, SoundNinja shows a ",[30,715,716],{},"Missing sound files"," dialog. Pick a folder to search and relink the clips.",[18,719,721],{"id":720},"next","Next",[14,723,724,725,33],{},"Organize tabs, tags, filters, and hotkeys in ",[70,726,727],{"href":357},"Organizing Sounds",{"title":228,"searchDepth":229,"depth":229,"links":729},[730,731,732,733,734,735],{"id":607,"depth":229,"text":608},{"id":629,"depth":229,"text":630},{"id":665,"depth":229,"text":666},{"id":688,"depth":229,"text":689},{"id":709,"depth":229,"text":710},{"id":720,"depth":229,"text":721},"Import audio, folders, recordings, and shared soundboards.",{},3,"\u002Fadding-sounds",{"title":596,"description":736},"SBUvL_H4633CrDyNUKazqKwru4aq1hhgoH4_o99rBsE",{"id":743,"title":727,"body":744,"description":1139,"extension":237,"meta":1140,"navigation":239,"order":1141,"path":1142,"seo":1143,"stem":748,"__hash__":1144},"content_en\u002Forganizing-sounds.md",{"type":7,"value":745,"toc":1124},[746,749,756,760,787,794,798,801,815,822,828,832,842,847,879,883,889,893,926,932,936,939,966,969,973,987,991,997,1018,1034,1041,1045,1055,1058,1062,1069,1079,1085,1089,1097,1104,1121],[10,747,727],{"id":748},"organizing-sounds",[14,750,751,752,755],{},"SoundNinja is built for large libraries. Use ",[30,753,754],{},"tags and filters",", tabs, search, multi-select, and hotkeys so the clip you need is one click (or one key) away.",[18,757,759],{"id":758},"tabs","Tabs",[106,761,762,769,776],{},[26,763,764,765,768],{},"Add a tab with ",[30,766,767],{},"Add tab",". Give it a color so you can scan the bar fast.",[26,770,771,772,775],{},"The ",[30,773,774],{},"All"," view shows every sound across tabs.",[26,777,778,779,782,783,786],{},"A sound can belong to ",[30,780,781],{},"one or more tabs",". Right-click a sound and use ",[30,784,785],{},"Move to tab"," to assign it.",[14,788,789,790,793],{},"Tab transitions live in ",[30,791,792],{},"Settings → Main",": Slide, Fade, Buttons one by one, or None.",[18,795,797],{"id":796},"groups","Groups",[14,799,800],{},"Since v0.5.3, separators can become named groups:",[106,802,803,806,809,812],{},[26,804,805],{},"Add, rename, or remove a group from the context menu",[26,807,808],{},"Drag the group header — children move with it",[26,810,811],{},"Drop sounds in or out of a group",[26,813,814],{},"Set group border color, name color, and button alignment (or use the tab default)",[14,816,817,818,821],{},"You can still add a plain ",[30,819,820],{},"Separator"," if you only need a visual break.",[14,823,824,825,33],{},"Right-click empty board space to ",[30,826,827],{},"Add Group",[18,829,831],{"id":830},"tags-filters","Tags \u002F Filters",[14,833,834,835,838,839,841],{},"Tags cut across tabs. The slide-out ",[30,836,837],{},"Filter"," panel (sidebar ",[30,840,837],{},") is where you create them and turn them into a board filter.",[843,844,846],"h3",{"id":845},"create-and-edit-tags","Create and edit tags",[23,848,849,854,865,872],{},[26,850,28,851,853],{},[30,852,837],{}," in the sidebar.",[26,855,856,857,860,861,864],{},"Under ",[30,858,859],{},"Tags",", use ",[30,862,863],{},"Add tag"," — give it a name and a color.",[26,866,867,868,871],{},"Rename, recolor, or ",[30,869,870],{},"Delete tag"," from the same list.",[26,873,874,875,878],{},"If you see ",[30,876,877],{},"No tags yet",", add one here before you assign anything.",[843,880,882],{"id":881},"assign-tags-to-sounds","Assign tags to sounds",[14,884,885,886,888],{},"Right-click a sound → ",[30,887,859],{}," (checkboxes). A sound can have several tags. If none exist yet, the menu tells you to open the filter panel.",[843,890,892],{"id":891},"filter-the-board","Filter the board",[106,894,895,901,912,923],{},[26,896,897,898,33],{},"Toggle tags in the Filter panel, or as ",[30,899,900],{},"chips under the search bar",[26,902,903,904,907,908,911],{},"Matching is ",[30,905,906],{},"OR",": a sound stays visible if it has ",[30,909,910],{},"any"," selected tag.",[26,913,914,915,918,919,922],{},"The navbar ",[30,916,917],{},"Search"," field ",[30,920,921],{},"ANDs"," with the active tag filter (type + tags together).",[26,924,925],{},"Turn chips off (or clear the filter) to show the full tab again.",[14,927,928,929,33],{},"Colored tag names can appear on buttons. Toggle them in ",[30,930,931],{},"Settings → Behavior → Show tag badges",[18,933,935],{"id":934},"sort","Sort",[14,937,938],{},"Open the filter panel and pick a sort mode:",[106,940,941,947],{},[26,942,943,946],{},[30,944,945],{},"User defined"," — your tab order, with groups visible",[26,948,949,476,952,476,955,549,958,961,962,965],{},[30,950,951],{},"Name",[30,953,954],{},"Added time",[30,956,957],{},"Play time",[30,959,960],{},"File size"," — a flat sorted list; ",[30,963,964],{},"groups are hidden"," in these modes",[14,967,968],{},"Duration sort may warm duration metadata the first time you use it.",[18,970,972],{"id":971},"reorder","Reorder",[14,974,975,976,979,980,983,984,986],{},"Turn on drag-and-drop in ",[30,977,978],{},"Settings → Behavior"," (",[30,981,982],{},"Allow reorder","). Then drag sounds and groups into place. Reorder applies in ",[30,985,945],{}," sort.",[18,988,990],{"id":989},"multi-select","Multi-select",[14,992,993,994,996],{},"Turn on ",[30,995,990],{}," in the navbar, then:",[106,998,999,1002,1008,1015],{},[26,1000,1001],{},"Click a sound to toggle it",[26,1003,1004,1007],{},[30,1005,1006],{},"Shift+click"," to select a range from the last anchor",[26,1009,1010,1011,1014],{},"Drag a ",[30,1012,1013],{},"marquee"," on empty board space",[26,1016,1017],{},"Click empty board (or outside) to clear the selection",[14,1019,1020,1021,476,1024,476,1027,1030,1031,33],{},"A bulk bar appears with the count, plus ",[30,1022,1023],{},"Color",[30,1025,1026],{},"Move to tab…",[30,1028,1029],{},"Delete",", and ",[30,1032,1033],{},"Done",[14,1035,1036,1037,1040],{},"In multi-select, each button shows an ",[30,1038,1039],{},"8-character ID chip",". Right-click the chip to copy it.",[18,1042,1044],{"id":1043},"per-sound-volume","Per-sound volume",[14,1046,885,1047,1050,1051,1054],{},[30,1048,1049],{},"Volume",". Drag the slider from 0% to 100%. ",[30,1052,1053],{},"Double-click"," the slider to reset to 100%.",[14,1056,1057],{},"This stacks with the master output volume in Settings.",[18,1059,1061],{"id":1060},"hotkeys-and-sound-ids","Hotkeys and sound IDs",[14,1063,1064,1065,1068],{},"Every sound has an 8-character ID. Copy it from the button context menu (",[30,1066,1067],{},"Copy ID",") or the multi-select ID chip.",[14,1070,28,1071,1074,1075,1078],{},[30,1072,1073],{},"Settings → Hotkeys"," to bind a key to a sound ID. Global hotkeys are optional. ",[30,1076,1077],{},"Assign hotkey"," on the context menu jumps there with the ID prefilled.",[14,1080,1081,1082,1084],{},"The same ID is what ",[70,1083,63],{"href":315}," uses to trigger a clip.",[18,1086,1088],{"id":1087},"background-images-and-colors","Background images and colors",[14,1090,1091,1092,1096],{},"Right-click a sound to set per-button colors or a background image. That is separate from the ",[70,1093,1095],{"href":1094},"\u002Fdocs\u002Ftheme-editor","Theme Creator",", which styles the whole board.",[14,1098,1099,1100,1103],{},"The picker is a ",[30,1101,1102],{},"Background image"," dialog (PNG, JPEG, GIF, WebP):",[106,1105,1106,1112],{},[26,1107,1108,1111],{},[30,1109,1110],{},"Local files"," — add folders, pick a single file, search filenames, preview the grid, or remove a folder from the library",[26,1113,1114,1117,1118,1120],{},[30,1115,1116],{},"KLIPY"," — search online GIFs. Set your own API key in ",[30,1119,978],{},". The key is not stored in project files.",[14,1122,1123],{},"After you pick an image, pan and crop it on the button.",{"title":228,"searchDepth":229,"depth":229,"links":1125},[1126,1127,1128,1133,1134,1135,1136,1137,1138],{"id":758,"depth":229,"text":759},{"id":796,"depth":229,"text":797},{"id":830,"depth":229,"text":831,"children":1129},[1130,1131,1132],{"id":845,"depth":738,"text":846},{"id":881,"depth":738,"text":882},{"id":891,"depth":738,"text":892},{"id":934,"depth":229,"text":935},{"id":971,"depth":229,"text":972},{"id":989,"depth":229,"text":990},{"id":1043,"depth":229,"text":1044},{"id":1060,"depth":229,"text":1061},{"id":1087,"depth":229,"text":1088},"Tags, filters, tabs, groups, sort, multi-select, volume, and hotkeys.",{},4,"\u002Forganizing-sounds",{"title":727,"description":1139},"DaYqySVuX1kgdTnJw6h1GP_lGyj4zdFP2uKKbBEbVwQ",{"id":1146,"title":1147,"body":1148,"description":1273,"extension":237,"meta":1274,"navigation":239,"order":1275,"path":1276,"seo":1277,"stem":1152,"__hash__":1278},"content_en\u002Ftheme-editor.md","Theme Editor",{"type":7,"value":1149,"toc":1267},[1150,1153,1159,1163,1189,1192,1196,1210,1214,1240,1243,1247,1253],[10,1151,1147],{"id":1152},"theme-editor",[14,1154,1155,1156,33],{},"The Theme Creator is the full visual editor for your board. Open it from ",[30,1157,1158],{},"Settings → Main → Theme Creator",[18,1160,1162],{"id":1161},"three-tabs","Three tabs",[23,1164,1165,1178,1184],{},[26,1166,1167,1170,1171,150,1174,1177],{},[30,1168,1169],{},"General"," — theme name, shared colors, and font uploads (",[44,1172,1173],{},".ttf",[44,1175,1176],{},".otf",")",[26,1179,1180,1183],{},[30,1181,1182],{},"Buttons"," — sound button colors, type, layout, and GIF overlay",[26,1185,1186,1188],{},[30,1187,759],{}," — tab bar colors, type, and border thickness",[14,1190,1191],{},"A live preview shows tabs and buttons as you edit.",[18,1193,1195],{"id":1194},"what-you-can-change","What you can change",[106,1197,1198,1201,1204,1207],{},[26,1199,1200],{},"Primary and accent colors, backgrounds, button colors, tab colors",[26,1202,1203],{},"Button and tab font family and size",[26,1205,1206],{},"Button width, radius, border width, gaps, and padding",[26,1208,1209],{},"GIF overlay opacity (normal and hover)",[18,1211,1213],{"id":1212},"save-and-share","Save and share",[106,1215,1216,1222,1228,1234],{},[26,1217,1218,1221],{},[30,1219,1220],{},"Export .css"," — write a theme file you can back up or send to a friend",[26,1223,1224,1227],{},[30,1225,1226],{},"Add to Themes"," — save the file into your Themes folder and apply it",[26,1229,1230,1233],{},[30,1231,1232],{},"Import .css"," — load a built-in preset or a saved theme",[26,1235,1236,1239],{},[30,1237,1238],{},"Reset"," — return to SoundNinja defaults",[14,1241,1242],{},"If you close the window with unsaved changes, SoundNinja asks you to save first.",[18,1244,1246],{"id":1245},"without-the-full-editor","Without the full editor",[14,1248,1249,1250,1252],{},"In ",[30,1251,792],{}," you can still:",[106,1254,1255,1258,1264],{},[26,1256,1257],{},"Pick a theme from the list",[26,1259,1260,1261,1177],{},"Edit CSS variables live (",[30,1262,1263],{},"Custom CSS",[26,1265,1266],{},"Import a theme file into the Themes folder",{"title":228,"searchDepth":229,"depth":229,"links":1268},[1269,1270,1271,1272],{"id":1161,"depth":229,"text":1162},{"id":1194,"depth":229,"text":1195},{"id":1212,"depth":229,"text":1213},{"id":1245,"depth":229,"text":1246},"Design colors, fonts, buttons, and tabs in the Theme Creator.",{},5,"\u002Ftheme-editor",{"title":1147,"description":1273},"zpMjxENa49aUipEX7TBxcqrbaZNweyJ019KsLAMJeoc",{"id":1280,"title":1281,"body":1282,"description":1419,"extension":237,"meta":1420,"navigation":239,"order":1421,"path":1422,"seo":1423,"stem":1286,"__hash__":1424},"content_en\u002Frecording-editor.md","Recording Editor",{"type":7,"value":1283,"toc":1413},[1284,1287,1293,1297,1303,1323,1326,1330,1355,1359,1374,1378,1392,1403],[10,1285,1281],{"id":1286},"recording-editor",[14,1288,1289,1290,1292],{},"Record a clip inside SoundNinja, trim it, then import it onto a tab. Open the editor with the ",[30,1291,677],{}," button in the player bar.",[18,1294,1296],{"id":1295},"choose-an-input","Choose an input",[14,1298,1249,1299,1302],{},[30,1300,1301],{},"Settings → Audio",":",[106,1304,1305,1311,1317],{},[26,1306,1307,1310],{},[30,1308,1309],{},"Input Devices"," — microphone",[26,1312,1313,1316],{},[30,1314,1315],{},"Output Devices (PC Audio)"," — loopback of what your PC is playing",[26,1318,1319,1322],{},[30,1320,1321],{},"Input volume"," — capture gain from 0% to 200%",[14,1324,1325],{},"The Record button uses the device you pick here.",[18,1327,1329],{"id":1328},"edit-the-take","Edit the take",[106,1331,1332,1335,1338,1346,1349,1352],{},[26,1333,1334],{},"Record and stop",[26,1336,1337],{},"Watch the input level meter",[26,1339,1340,404,1343],{},[30,1341,1342],{},"Normalize",[30,1344,1345],{},"Noise Cancelation",[26,1347,1348],{},"Trim the whole clip, trim to a selection, or delete a selection",[26,1350,1351],{},"Undo \u002F redo",[26,1353,1354],{},"Zoom in and out",[18,1356,1358],{"id":1357},"stage-and-import","Stage and import",[23,1360,1361,1364,1367],{},[26,1362,1363],{},"Add the selection or the full track to the staging list.",[26,1365,1366],{},"The list starts empty: record, edit, then add a clip.",[26,1368,1369,404,1371,1373],{},[30,1370,681],{},[30,1372,684],{}," into the current tab or a tab you choose.",[18,1375,1377],{"id":1376},"stem-separation-optional","Stem separation (optional)",[14,1379,1380,1381,1384,1385,404,1388,1391],{},"Official Windows, macOS, and Linux release builds ship the ",[30,1382,1383],{},"stems"," feature. The Record Editor can keep ",[30,1386,1387],{},"vocals",[30,1389,1390],{},"music"," using BS-RoFormer.",[14,1393,1394,1395,1398,1399,1402],{},"The model is about 158 MB and is ",[30,1396,1397],{},"not"," bundled with the installer. Download it from ",[30,1400,1401],{},"Settings → Stem Separation",", or accept the first-run prompt. The Windows installer can also offer to download the model on first launch.",[14,1404,1405,1406,150,1409,1412],{},"Custom source builds need an extra flag (",[44,1407,1408],{},"tauri:serve:stems",[44,1410,1411],{},"tauri:build:stems",").",{"title":228,"searchDepth":229,"depth":229,"links":1414},[1415,1416,1417,1418],{"id":1295,"depth":229,"text":1296},{"id":1328,"depth":229,"text":1329},{"id":1357,"depth":229,"text":1358},{"id":1376,"depth":229,"text":1377},"Capture mic or PC audio, edit the clip, and drop it on your board.",{},6,"\u002Frecording-editor",{"title":1281,"description":1419},"WLz7ozLeboeLKawRkz53eUj5KSVCj4xkPMhYg5P_MIo",{"id":4,"title":5,"body":1426,"description":236,"extension":237,"meta":1569,"navigation":239,"order":240,"path":241,"seo":1570,"stem":12,"__hash__":243},{"type":7,"value":1427,"toc":1562},[1428,1430,1432,1434,1454,1456,1458,1480,1482,1496,1498,1500,1522,1524,1528],[10,1429,5],{"id":12},[14,1431,16],{},[18,1433,21],{"id":20},[23,1435,1436,1440,1444,1448],{},[26,1437,28,1438,33],{},[30,1439,32],{},[26,1441,36,1442,33],{},[30,1443,39],{},[26,1445,42,1446,33],{},[44,1447,46],{},[26,1449,49,1450,53,1452,33],{},[44,1451,52],{},[30,1453,56],{},[14,1455,59],{},[18,1457,63],{"id":62},[23,1459,1460,1465,1470,1476],{},[26,1461,68,1462,33],{},[70,1463,63],{"href":72,"rel":1464},[74],[26,1466,77,1467,83],{},[70,1468,82],{"href":80,"rel":1469},[74],[26,1471,86,1472,90,1474,33],{},[30,1473,89],{},[44,1475,93],{},[26,1477,96,1478,100],{},[30,1479,99],{},[18,1481,104],{"id":103},[106,1483,1484,1488,1492],{},[26,1485,1486,113],{},[30,1487,112],{},[26,1489,1490,119],{},[30,1491,118],{},[26,1493,1494,125],{},[30,1495,124],{},[14,1497,128],{},[18,1499,132],{"id":131},[106,1501,1502,1506,1514,1518],{},[26,1503,1504,140],{},[30,1505,139],{},[26,1507,1508,146,1510,150,1512],{},[44,1509,145],{},[44,1511,149],{},[44,1513,153],{},[26,1515,1516,159],{},[44,1517,158],{},[26,1519,1520,165],{},[44,1521,164],{},[18,1523,169],{"id":168},[14,1525,172,1526],{},[44,1527,175],{},[106,1529,1530,1534,1538,1542,1548,1552,1558],{},[26,1531,1532,183],{},[44,1533,182],{},[26,1535,1536,189],{},[44,1537,188],{},[26,1539,1540,195],{},[44,1541,194],{},[26,1543,1544,201,1546,205],{},[44,1545,200],{},[44,1547,204],{},[26,1549,1550,211],{},[44,1551,210],{},[26,1553,1554,217,1556,220],{},[44,1555,216],{},[44,1557,204],{},[26,1559,1560,226],{},[44,1561,225],{},{"title":228,"searchDepth":229,"depth":229,"links":1563},[1564,1565,1566,1567,1568],{"id":20,"depth":229,"text":21},{"id":62,"depth":229,"text":63},{"id":103,"depth":229,"text":104},{"id":131,"depth":229,"text":132},{"id":168,"depth":229,"text":169},{},{"title":5,"description":236},{"id":1572,"title":1573,"body":1574,"description":1663,"extension":237,"meta":1664,"navigation":239,"order":1665,"path":1666,"seo":1667,"stem":1578,"__hash__":1668},"content_en\u002Fsupport.md","Support",{"type":7,"value":1575,"toc":1656},[1576,1579,1582,1586,1589,1596,1604,1608,1615,1617,1630,1634,1645,1649],[10,1577,1573],{"id":1578},"support",[14,1580,1581],{},"SoundNinja is a community project in early beta. The fastest way to get help is GitHub.",[18,1583,1585],{"id":1584},"report-a-bug-or-ask-a-question","Report a bug or ask a question",[14,1587,1588],{},"Open an issue on GitHub:",[14,1590,1591],{},[70,1592,1595],{"href":1593,"rel":1594},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fissues",[74],"github.com\u002Fmarcus-universe\u002FSoundNinja\u002Fissues",[14,1597,1598,1599,404,1601,1603],{},"Include your OS, SoundNinja version (",[30,1600,490],{},[30,1602,56],{},"), and steps to reproduce.",[18,1605,1607],{"id":1606},"email","Email",[14,1609,1610,1611],{},"Maintainer contact: ",[70,1612,1614],{"href":1613},"mailto:contact@marcus-universe.de","contact@marcus-universe.de",[18,1616,484],{"id":483},[14,1618,1619,1620,1622,1623,1625,1626,33],{},"In the app, use ",[30,1621,490],{},". New builds also appear on the ",[70,1624,385],{"href":384}," and on ",[70,1627,391],{"href":1628,"rel":1629},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Freleases",[74],[18,1631,1633],{"id":1632},"contribute","Contribute",[14,1635,1636,1637,1641,1642,33],{},"Pull requests are welcome. The app repo is ",[70,1638,1640],{"href":501,"rel":1639},[74],"github.com\u002Fmarcus-universe\u002FSoundNinja",". The project is licensed under ",[70,1643,333],{"href":331,"rel":1644},[74],[18,1646,1648],{"id":1647},"legal","Legal",[14,1650,1651,1652,33],{},"Imprint and contact details: ",[70,1653,1655],{"href":1654},"\u002Fimpressum","Impressum",{"title":228,"searchDepth":229,"depth":229,"links":1657},[1658,1659,1660,1661,1662],{"id":1584,"depth":229,"text":1585},{"id":1606,"depth":229,"text":1607},{"id":483,"depth":229,"text":484},{"id":1632,"depth":229,"text":1633},{"id":1647,"depth":229,"text":1648},"Where to get help and report bugs.",{},8,"\u002Fsupport",{"title":1573,"description":1663},"jRExoghmWgAfTmnmgqLhtQed