[{"data":1,"prerenderedAt":1388},["ShallowReactive",2],{"docs-page-en-\u002Fremote-control":3,"docs-nav-en":247},{"id":4,"title":5,"body":6,"description":239,"extension":240,"meta":241,"navigation":242,"order":243,"path":244,"seo":245,"stem":12,"__hash__":246},"content_en\u002Fremote-control.md","Remote Control",{"type":7,"value":8,"toc":230},"minimark",[9,13,17,22,57,60,64,104,108,129,132,136,169,173,179],[10,11,5],"h1",{"id":12},"remote-control",[14,15,16],"p",{},"SoundNinja can listen on your local network so Bitfocus Companion (or any HTTP\u002FWebSocket client) can play and stop sounds.",[18,19,21],"h2",{"id":20},"enable-the-remote-server","Enable the remote server",[23,24,25,34,40,47],"ol",{},[26,27,28,29,33],"li",{},"Open ",[30,31,32],"strong",{},"Settings → Remote",".",[26,35,36,37,33],{},"Enable the remote server. Default port is ",[30,38,39],{},"7331",[26,41,42,43,33],{},"Optional: set a token. Clients must send it as a Bearer token or ",[44,45,46],"code",{},"?token=",[26,48,49,50,53,54,33],{},"Copy the ",[44,51,52],{},"http:\u002F\u002FIP:PORT"," URL, or copy the system IP from ",[30,55,56],{},"Settings → About",[14,58,59],{},"Windows may show a firewall prompt the first time the server starts. Allow private-network access.",[18,61,63],{"id":62},"bitfocus-companion","Bitfocus Companion",[23,65,66,75,84,91,97],{},[26,67,68,69,33],{},"Install ",[70,71,63],"a",{"href":72,"rel":73},"https:\u002F\u002Fbitfocus.io\u002Fcompanion",[74],"nofollow",[26,76,77,78,83],{},"Download the SoundNinja module from the official folder: ",[70,79,82],{"href":80,"rel":81},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Ftree\u002Fmain\u002Fcompanion-module-soundninja",[74],"companion-module-soundninja",". There is no Companion Store package yet — this folder is the download.",[26,85,86,87,90],{},"In Companion open ",[30,88,89],{},"Developer → Modules",", or drop the folder into Companion’s custom modules path.",[26,92,93,94,33],{},"In the module folder run ",[44,95,96],{},"npm install",[26,98,99,100,103],{},"Add a ",[30,101,102],{},"Sound Ninja"," connection. Paste the PC IP, port, and token if you set one.",[18,105,107],{"id":106},"actions","Actions",[109,110,111,117,123],"ul",{},[26,112,113,116],{},[30,114,115],{},"Trigger Sound"," — pick from the live dropdown, or type an 8-character sound ID (Companion variables work)",[26,118,119,122],{},[30,120,121],{},"Stop Sound"," — stop one playing sound by ID",[26,124,125,128],{},[30,126,127],{},"Stop All"," — stop every playing sound",[14,130,131],{},"Copy a sound ID in SoundNinja from the button context menu or the multi-select ID chip.",[18,133,135],{"id":134},"feedbacks-and-variables","Feedbacks and variables",[109,137,138,144,157,163],{},[26,139,140,143],{},[30,141,142],{},"Sound Playing"," — true while that sound ID is active (use it for button color)",[26,145,146,149,150,153,154],{},[44,147,148],{},"$(soundninja:connected)"," — ",[44,151,152],{},"true"," \u002F ",[44,155,156],{},"false",[26,158,159,162],{},[44,160,161],{},"$(soundninja:playing_count)"," — how many sounds are playing",[26,164,165,168],{},[44,166,167],{},"$(soundninja:last_triggered)"," — last triggered sound ID",[18,170,172],{"id":171},"http-api-advanced","HTTP API (advanced)",[14,174,175,176],{},"Base path: ",[44,177,178],{},"\u002Fapi\u002Fv1",[109,180,181,187,193,199,209,215,224],{},[26,182,183,186],{},[44,184,185],{},"GET \u002Finfo"," — app name, version, protocol, whether a token is required",[26,188,189,192],{},[44,190,191],{},"GET \u002Fsounds"," — sound list (id, name, tabs, active)",[26,194,195,198],{},[44,196,197],{},"GET \u002Fstate"," — sounds plus currently playing IDs",[26,200,201,204,205,208],{},[44,202,203],{},"POST \u002Ftrigger"," with ",[44,206,207],{},"{ \"id\" }"," — play a sound",[26,210,211,214],{},[44,212,213],{},"GET \u002Ftrigger\u002F:id"," — play (easy to test in a browser)",[26,216,217,220,221,223],{},[44,218,219],{},"POST \u002Fstop"," with optional ",[44,222,207],{}," — stop one sound or all",[26,225,226,229],{},[44,227,228],{},"GET \u002Fws"," — live state; send trigger\u002Fstop commands inbound",{"title":231,"searchDepth":232,"depth":232,"links":233},"",2,[234,235,236,237,238],{"id":20,"depth":232,"text":21},{"id":62,"depth":232,"text":63},{"id":106,"depth":232,"text":107},{"id":134,"depth":232,"text":135},{"id":171,"depth":232,"text":172},"Trigger SoundNinja from Bitfocus Companion over the local network.","md",{},true,7,"\u002Fremote-control",{"title":5,"description":239},"2a4c6ZB00Bri0Ad7GlCOyPluyHgB3pAQRtUqVGwvFbk",[248,365,564,712,866,1000,1142,1290],{"id":249,"title":250,"body":251,"description":359,"extension":240,"meta":360,"navigation":242,"order":361,"path":362,"seo":363,"stem":255,"__hash__":364},"content_en\u002Foverview.md","Overview",{"type":7,"value":252,"toc":353},[253,256,259,262,265,269,283,287,316,320,329,333],[10,254,250],{"id":255},"overview",[14,257,258],{},"SoundNinja is an open-source soundboard for live streaming, chatting with friends, and podcast recording. It is built with Tauri v2 and Nuxt 4 so it stays light on RAM and disk.",[14,260,261],{},"The goal is simple: keep a huge sound library easy to scan, then play the right clip in milliseconds. The UI also works well as a dashboard in VR.",[14,263,264],{},"SoundNinja is still in early development. Features work, but not every platform is fully tested.",[18,266,268],{"id":267},"who-it-is-for","Who it is for",[109,270,271,274,277,280],{},[26,272,273],{},"Streamers who need instant sound cues",[26,275,276],{},"Friends who want a shared board for voice chat",[26,278,279],{},"Podcasters who record clips and drop them onto a board",[26,281,282],{},"Anyone who wants a customizable, local-first soundboard",[18,284,286],{"id":285},"what-you-can-do","What you can do",[109,288,289,292,295,298,301,304,310,313],{},[26,290,291],{},"Build a soundboard from your own audio files",[26,293,294],{},"Organize sounds in colored tabs, groups, and search",[26,296,297],{},"Design the look with the Theme Creator",[26,299,300],{},"Record PC audio or a microphone in the Record Editor",[26,302,303],{},"Assign hotkeys to individual sounds",[26,305,306,307],{},"Trigger sounds from ",[70,308,63],{"href":309},"\u002Fdocs\u002Fremote-control",[26,311,312],{},"Import and export a full soundboard to share with others",[26,314,315],{},"Use GIFs or images on sound buttons",[18,317,319],{"id":318},"license","License",[14,321,322,323,328],{},"SoundNinja is free software under ",[70,324,327],{"href":325,"rel":326},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fblob\u002Fmain\u002FLICENSE",[74],"GPL-3.0",". Fork it, change it, share it.",[18,330,332],{"id":331},"next-steps","Next steps",[23,334,335,341,347],{},[26,336,337],{},[70,338,340],{"href":339},"\u002Fdocs\u002Finstallation","Install SoundNinja",[26,342,343],{},[70,344,346],{"href":345},"\u002Fdocs\u002Fadding-sounds","Add sounds",[26,348,349],{},[70,350,352],{"href":351},"\u002Fdocs\u002Forganizing-sounds","Organize your board",{"title":231,"searchDepth":232,"depth":232,"links":354},[355,356,357,358],{"id":267,"depth":232,"text":268},{"id":285,"depth":232,"text":286},{"id":318,"depth":232,"text":319},{"id":331,"depth":232,"text":332},"What SoundNinja is and what you can do with it.",{},1,"\u002Foverview",{"title":250,"description":359},"cOxJIh0ybRdZsyS1INxo9O3CTipyV8220IKpyfnYFJA",{"id":366,"title":367,"body":368,"description":559,"extension":240,"meta":560,"navigation":242,"order":232,"path":561,"seo":562,"stem":372,"__hash__":563},"content_en\u002Finstallation.md","Installation",{"type":7,"value":369,"toc":552},[370,373,387,391,409,412,416,430,433,437,461,472,476,483,487,502,532,548],[10,371,367],{"id":372},"installation",[14,374,375,376,380,381,386],{},"Grab a build from the ",[70,377,379],{"href":378},"\u002Fdownload","Download page"," or from ",[70,382,385],{"href":383,"rel":384},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Freleases\u002Flatest",[74],"GitHub Releases",". SoundNinja is in early development, so treat builds as beta.",[18,388,390],{"id":389},"windows","Windows",[109,392,393,403,406],{},[26,394,395,398,399,402],{},[30,396,397],{},"Installer (.exe)"," or ",[30,400,401],{},"MSI (.msi)"," for 64-bit Windows",[26,404,405],{},"Landing page target: Windows 10 and newer",[26,407,408],{},"The app README also lists Windows 8 and above",[14,410,411],{},"Run the installer, then launch SoundNinja from the Start menu.",[18,413,415],{"id":414},"macos","macOS",[109,417,418,424,427],{},[26,419,420,423],{},[30,421,422],{},"Universal .dmg"," for Apple Silicon and Intel",[26,425,426],{},"Landing page target: macOS 10.14 and newer",[26,428,429],{},"The app README lists macOS 10.15 and above",[14,431,432],{},"Open the disk image and drag SoundNinja to Applications.",[18,434,436],{"id":435},"linux","Linux",[109,438,439,445,451,458],{},[26,440,441,444],{},[30,442,443],{},"Debian (.deb)"," for Ubuntu \u002F Debian",[26,446,447,450],{},[30,448,449],{},"AppImage"," for other distros",[26,452,453,454,457],{},"After a release is published, Arch users can install ",[44,455,456],{},"soundninja-bin"," from the AUR",[26,459,460],{},"Tested on Ubuntu 20.04",[14,462,463,464,467,468,471],{},"Desktop builds need WebKit and GTK packages. On Debian\u002FUbuntu that usually means ",[44,465,466],{},"libwebkit2gtk",", ",[44,469,470],{},"libgtk-3-0",", and an app-indicator library.",[18,473,475],{"id":474},"updates","Updates",[14,477,478,479,482],{},"In the app, open ",[30,480,481],{},"Help → Check for Updates",". You can also let SoundNinja check on startup in Settings.",[18,484,486],{"id":485},"build-from-source","Build from source",[14,488,489,490,495,496,501],{},"Need a custom build? Clone ",[70,491,494],{"href":492,"rel":493},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja",[74],"the repo",", install ",[70,497,500],{"href":498,"rel":499},"https:\u002F\u002Fv2.tauri.app\u002Fstart\u002Fprerequisites\u002F",[74],"Tauri prerequisites",", then:",[503,504,508],"pre",{"className":505,"code":506,"language":507,"meta":231,"style":231},"language-bash shiki shiki-themes github-light github-dark","bun install\nbun run tauri:serve\n","bash",[44,509,510,522],{"__ignoreMap":231},[511,512,514,518],"span",{"class":513,"line":361},"line",[511,515,517],{"class":516},"sScJk","bun",[511,519,521],{"class":520},"sZZnC"," install\n",[511,523,524,526,529],{"class":513,"line":232},[511,525,517],{"class":516},[511,527,528],{"class":520}," run",[511,530,531],{"class":520}," tauri:serve\n",[14,533,534,467,537,540,541,544,545,33],{},[44,535,536],{},"npm",[44,538,539],{},"pnpm",", or ",[44,542,543],{},"deno"," work too. Production build: ",[44,546,547],{},"bun run tauri:build",[549,550,551],"style",{},"html pre.shiki code .sScJk, html code.shiki .sScJk{--shiki-default:#6F42C1;--shiki-dark:#B392F0}html pre.shiki code .sZZnC, html code.shiki .sZZnC{--shiki-default:#032F62;--shiki-dark:#9ECBFF}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html.dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}",{"title":231,"searchDepth":232,"depth":232,"links":553},[554,555,556,557,558],{"id":389,"depth":232,"text":390},{"id":414,"depth":232,"text":415},{"id":435,"depth":232,"text":436},{"id":474,"depth":232,"text":475},{"id":485,"depth":232,"text":486},"Install SoundNinja on Windows, macOS, or Linux.",{},"\u002Finstallation",{"title":367,"description":559},"i4XnnjkhxVb30IICErH1K_cBbAQ7GmnD52FYRYjh50k",{"id":565,"title":566,"body":567,"description":706,"extension":240,"meta":707,"navigation":242,"order":708,"path":709,"seo":710,"stem":571,"__hash__":711},"content_en\u002Fadding-sounds.md","Adding Sounds",{"type":7,"value":568,"toc":698},[569,572,575,579,597,601,633,637,656,660,674,677,681,688,692],[10,570,566],{"id":571},"adding-sounds",[14,573,574],{},"A board is empty until you add clips. SoundNinja can import files, whole folders, a recording, or a shared soundboard pack.",[18,576,578],{"id":577},"import-audio-files","Import audio files",[23,580,581,591,594],{},[26,582,28,583,586,587,590],{},[30,584,585],{},"File → Import Audio Files",", or use ",[30,588,589],{},"Import"," in the navbar.",[26,592,593],{},"Pick one or more audio files.",[26,595,596],{},"Sounds land in the current tab.",[18,598,600],{"id":599},"import-folders","Import folders",[23,602,603,613,616],{},[26,604,28,605,608,609,612],{},[30,606,607],{},"File → Import Folders"," (or ",[30,610,611],{},"Import Folders"," in the navbar).",[26,614,615],{},"Add one or more folders. Drag to reorder them before you import.",[26,617,618,619],{},"Choose how they land:\n",[109,620,621,627],{},[26,622,623,626],{},[30,624,625],{},"Import as Tabs"," — each folder becomes its own tab",[26,628,629,632],{},[30,630,631],{},"Import to current Tab"," — every file goes into the active tab",[18,634,636],{"id":635},"record-a-clip","Record a clip",[14,638,639,640,644,645,648,649,398,652,655],{},"Open the ",[70,641,643],{"href":642},"\u002Fdocs\u002Frecording-editor","Record Editor"," from the ",[30,646,647],{},"Record"," button in the player bar. Capture, trim, then ",[30,650,651],{},"Import selected",[30,653,654],{},"Import all"," into the current tab or a tab you pick.",[18,657,659],{"id":658},"import-a-soundboard","Import a soundboard",[14,661,662,665,666,669,670,673],{},[30,663,664],{},"File → Import Soundboard"," loads a shared pack. Packs are a ",[44,667,668],{},".zip"," that contains ",[44,671,672],{},"project.sninja"," plus the sound files. After import, open the project and play.",[14,675,676],{},"You can also keep several projects (profiles). Use the project selector to switch boards.",[18,678,680],{"id":679},"relink-missing-files","Relink missing files",[14,682,683,684,687],{},"If audio files move on disk, SoundNinja shows a ",[30,685,686],{},"Missing sound files"," dialog. Pick a folder to search and relink the clips.",[18,689,691],{"id":690},"next","Next",[14,693,694,695,33],{},"Organize tabs, groups, and hotkeys in ",[70,696,697],{"href":351},"Organizing Sounds",{"title":231,"searchDepth":232,"depth":232,"links":699},[700,701,702,703,704,705],{"id":577,"depth":232,"text":578},{"id":599,"depth":232,"text":600},{"id":635,"depth":232,"text":636},{"id":658,"depth":232,"text":659},{"id":679,"depth":232,"text":680},{"id":690,"depth":232,"text":691},"Import audio, folders, recordings, and shared soundboards.",{},3,"\u002Fadding-sounds",{"title":566,"description":706},"qcK88xpbquf2dRogb67sx4O0tzuIof13-X3Yyn9680o",{"id":713,"title":697,"body":714,"description":860,"extension":240,"meta":861,"navigation":242,"order":862,"path":863,"seo":864,"stem":718,"__hash__":865},"content_en\u002Forganizing-sounds.md",{"type":7,"value":715,"toc":851},[716,719,722,726,753,760,764,767,781,788,792,798,802,813,817,820,824,827,833,839,843],[10,717,697],{"id":718},"organizing-sounds",[14,720,721],{},"SoundNinja is built for large libraries. Use tabs, groups, search, and hotkeys so the clip you need is one click (or one key) away.",[18,723,725],{"id":724},"tabs","Tabs",[109,727,728,735,742],{},[26,729,730,731,734],{},"Add a tab with ",[30,732,733],{},"Add tab",". Give it a color so you can scan the bar fast.",[26,736,737,738,741],{},"The ",[30,739,740],{},"All"," view shows every sound across tabs.",[26,743,744,745,748,749,752],{},"A sound can belong to ",[30,746,747],{},"one or more tabs",". Right-click a sound and use ",[30,750,751],{},"Move to tab"," to assign it.",[14,754,755,756,759],{},"Tab transitions live in ",[30,757,758],{},"Settings → Main",": Slide, Fade, Buttons one by one, or None.",[18,761,763],{"id":762},"groups","Groups",[14,765,766],{},"Since v0.5.3, separators can become named groups:",[109,768,769,772,775,778],{},[26,770,771],{},"Add, rename, or remove a group from the context menu",[26,773,774],{},"Drag the group header — children move with it",[26,776,777],{},"Drop sounds in or out of a group",[26,779,780],{},"Set group border color, name color, and button alignment (or use the tab default)",[14,782,783,784,787],{},"You can still add a plain ",[30,785,786],{},"Separator"," if you only need a visual break.",[18,789,791],{"id":790},"search","Search",[14,793,794,795,797],{},"Use the ",[30,796,791],{}," field in the navbar. Results update as you type.",[18,799,801],{"id":800},"reorder","Reorder",[14,803,804,805,808,809,812],{},"Turn on drag-and-drop in ",[30,806,807],{},"Settings → Behavior"," (",[30,810,811],{},"Allow reorder","). Then drag sounds and groups into place.",[18,814,816],{"id":815},"bulk-edit","Bulk edit",[14,818,819],{},"Multi-select sounds, then change color, move them to a tab, or delete them in one step.",[18,821,823],{"id":822},"hotkeys-and-sound-ids","Hotkeys and sound IDs",[14,825,826],{},"Every sound has an 8-character ID. Copy it from the button context menu or the multi-select ID chip.",[14,828,28,829,832],{},[30,830,831],{},"Settings → Hotkeys"," to bind a key to a sound ID. Global hotkeys are optional.",[14,834,835,836,838],{},"The same ID is what ",[70,837,63],{"href":309}," uses to trigger a clip.",[18,840,842],{"id":841},"gifs-and-colors","GIFs and colors",[14,844,845,846,850],{},"Right-click a sound to set per-button colors or a GIF \u002F image background. That is separate from the ",[70,847,849],{"href":848},"\u002Fdocs\u002Ftheme-editor","Theme Creator",", which styles the whole board.",{"title":231,"searchDepth":232,"depth":232,"links":852},[853,854,855,856,857,858,859],{"id":724,"depth":232,"text":725},{"id":762,"depth":232,"text":763},{"id":790,"depth":232,"text":791},{"id":800,"depth":232,"text":801},{"id":815,"depth":232,"text":816},{"id":822,"depth":232,"text":823},{"id":841,"depth":232,"text":842},"Tabs, groups, search, bulk edit, and hotkeys.",{},4,"\u002Forganizing-sounds",{"title":697,"description":860},"Q4gLPzceZdOi3j6gqMTmPuTzf4qua7p2dfLn2shjKT4",{"id":867,"title":868,"body":869,"description":994,"extension":240,"meta":995,"navigation":242,"order":996,"path":997,"seo":998,"stem":873,"__hash__":999},"content_en\u002Ftheme-editor.md","Theme Editor",{"type":7,"value":870,"toc":988},[871,874,880,884,910,913,917,931,935,961,964,968,974],[10,872,868],{"id":873},"theme-editor",[14,875,876,877,33],{},"The Theme Creator is the full visual editor for your board. Open it from ",[30,878,879],{},"Settings → Main → Theme Creator",[18,881,883],{"id":882},"three-tabs","Three tabs",[23,885,886,899,905],{},[26,887,888,891,892,153,895,898],{},[30,889,890],{},"General"," — theme name, shared colors, and font uploads (",[44,893,894],{},".ttf",[44,896,897],{},".otf",")",[26,900,901,904],{},[30,902,903],{},"Buttons"," — sound button colors, type, layout, and GIF overlay",[26,906,907,909],{},[30,908,725],{}," — tab bar colors, type, and border thickness",[14,911,912],{},"A live preview shows tabs and buttons as you edit.",[18,914,916],{"id":915},"what-you-can-change","What you can change",[109,918,919,922,925,928],{},[26,920,921],{},"Primary and accent colors, backgrounds, button colors, tab colors",[26,923,924],{},"Button and tab font family and size",[26,926,927],{},"Button width, radius, border width, gaps, and padding",[26,929,930],{},"GIF overlay opacity (normal and hover)",[18,932,934],{"id":933},"save-and-share","Save and share",[109,936,937,943,949,955],{},[26,938,939,942],{},[30,940,941],{},"Export .css"," — write a theme file you can back up or send to a friend",[26,944,945,948],{},[30,946,947],{},"Add to Themes"," — save the file into your Themes folder and apply it",[26,950,951,954],{},[30,952,953],{},"Import .css"," — load a built-in preset or a saved theme",[26,956,957,960],{},[30,958,959],{},"Reset"," — return to SoundNinja defaults",[14,962,963],{},"If you close the window with unsaved changes, SoundNinja asks you to save first.",[18,965,967],{"id":966},"without-the-full-editor","Without the full editor",[14,969,970,971,973],{},"In ",[30,972,758],{}," you can still:",[109,975,976,979,985],{},[26,977,978],{},"Pick a theme from the list",[26,980,981,982,898],{},"Edit CSS variables live (",[30,983,984],{},"Custom CSS",[26,986,987],{},"Import a theme file into the Themes folder",{"title":231,"searchDepth":232,"depth":232,"links":989},[990,991,992,993],{"id":882,"depth":232,"text":883},{"id":915,"depth":232,"text":916},{"id":933,"depth":232,"text":934},{"id":966,"depth":232,"text":967},"Design colors, fonts, buttons, and tabs in the Theme Creator.",{},5,"\u002Ftheme-editor",{"title":868,"description":994},"zpMjxENa49aUipEX7TBxcqrbaZNweyJ019KsLAMJeoc",{"id":1001,"title":1002,"body":1003,"description":1136,"extension":240,"meta":1137,"navigation":242,"order":1138,"path":1139,"seo":1140,"stem":1007,"__hash__":1141},"content_en\u002Frecording-editor.md","Recording Editor",{"type":7,"value":1004,"toc":1130},[1005,1008,1014,1018,1024,1044,1047,1051,1076,1080,1095,1099,1113,1120],[10,1006,1002],{"id":1007},"recording-editor",[14,1009,1010,1011,1013],{},"Record a clip inside SoundNinja, trim it, then import it onto a tab. Open the editor with the ",[30,1012,647],{}," button in the player bar.",[18,1015,1017],{"id":1016},"choose-an-input","Choose an input",[14,1019,970,1020,1023],{},[30,1021,1022],{},"Settings → Audio",":",[109,1025,1026,1032,1038],{},[26,1027,1028,1031],{},[30,1029,1030],{},"Input Devices"," — microphone",[26,1033,1034,1037],{},[30,1035,1036],{},"Output Devices (PC Audio)"," — loopback of what your PC is playing",[26,1039,1040,1043],{},[30,1041,1042],{},"Input volume"," — capture gain from 0% to 200%",[14,1045,1046],{},"The Record button uses the device you pick here.",[18,1048,1050],{"id":1049},"edit-the-take","Edit the take",[109,1052,1053,1056,1059,1067,1070,1073],{},[26,1054,1055],{},"Record and stop",[26,1057,1058],{},"Watch the input level meter",[26,1060,1061,398,1064],{},[30,1062,1063],{},"Normalize",[30,1065,1066],{},"Noise Cancelation",[26,1068,1069],{},"Trim the whole clip, trim to a selection, or delete a selection",[26,1071,1072],{},"Undo \u002F redo",[26,1074,1075],{},"Zoom in and out",[18,1077,1079],{"id":1078},"stage-and-import","Stage and import",[23,1081,1082,1085,1088],{},[26,1083,1084],{},"Add the selection or the full track to the staging list.",[26,1086,1087],{},"The list starts empty: record, edit, then add a clip.",[26,1089,1090,398,1092,1094],{},[30,1091,651],{},[30,1093,654],{}," into the current tab or a tab you choose.",[18,1096,1098],{"id":1097},"stem-separation-optional","Stem separation (optional)",[14,1100,1101,1102,398,1105,1108,1109,1112],{},"The Record Editor can keep ",[30,1103,1104],{},"vocals",[30,1106,1107],{},"music"," using BS-RoFormer. The model is about 158 MB and is ",[30,1110,1111],{},"not"," bundled with the app.",[14,1114,1115,1116,1119],{},"Download it from ",[30,1117,1118],{},"Settings → Stem Separation",", or accept the first-run prompt. The Windows installer can also offer to download the model on first launch.",[14,1121,1122,1123,153,1126,1129],{},"Stem builds from source need an extra flag (",[44,1124,1125],{},"tauri:serve:stems",[44,1127,1128],{},"tauri:build:stems",").",{"title":231,"searchDepth":232,"depth":232,"links":1131},[1132,1133,1134,1135],{"id":1016,"depth":232,"text":1017},{"id":1049,"depth":232,"text":1050},{"id":1078,"depth":232,"text":1079},{"id":