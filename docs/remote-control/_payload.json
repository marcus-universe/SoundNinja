[{"data":1,"prerenderedAt":1648},["ShallowReactive",2],{"docs-page-en-\u002Fremote-control":3,"docs-nav-en":244},{"id":4,"title":5,"body":6,"description":236,"extension":237,"meta":238,"navigation":239,"order":240,"path":241,"seo":242,"stem":12,"__hash__":243},"content_en\u002Fremote-control.md","Remote Control",{"type":7,"value":8,"toc":227},"minimark",[9,13,17,22,57,60,64,101,105,126,129,133,166,170,176],[10,11,5],"h1",{"id":12},"remote-control",[14,15,16],"p",{},"SoundNinja can listen on your local network so Bitfocus Companion (or any HTTP\u002FWebSocket client) can play and stop sounds.",[18,19,21],"h2",{"id":20},"enable-the-remote-server","Enable the remote server",[23,24,25,34,40,47],"ol",{},[26,27,28,29,33],"li",{},"Open ",[30,31,32],"strong",{},"Settings → Remote",".",[26,35,36,37,33],{},"Enable the remote server. Default port is ",[30,38,39],{},"7331",[26,41,42,43,33],{},"Optional: set a token. Clients must send it as a Bearer token or ",[44,45,46],"code",{},"?token=",[26,48,49,50,53,54,33],{},"Copy the ",[44,51,52],{},"http:\u002F\u002FIP:PORT"," URL, or copy the system IP from ",[30,55,56],{},"Settings → About",[14,58,59],{},"Windows may show a firewall prompt the first time the server starts. Allow private-network access.",[18,61,63],{"id":62},"bitfocus-companion","Bitfocus Companion",[23,65,66,75,84,94],{},[26,67,68,69,33],{},"Install ",[70,71,63],"a",{"href":72,"rel":73},"https:\u002F\u002Fbitfocus.io\u002Fcompanion",[74],"nofollow",[26,76,77,78,83],{},"Download ",[70,79,82],{"href":80,"rel":81},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002Fcompanion-module-soundninja\u002Freleases\u002Flatest",[74],"SoundNinja-Companion.tgz",". There is no Companion Store package yet.",[26,85,86,87,90,91,33],{},"In Companion: ",[30,88,89],{},"Modules → Load module package"," and pick the ",[44,92,93],{},".tgz",[26,95,96,97,100],{},"Add a ",[30,98,99],{},"Sound Ninja"," connection. Paste the PC IP, port, and token if you set one.",[18,102,104],{"id":103},"actions","Actions",[106,107,108,114,120],"ul",{},[26,109,110,113],{},[30,111,112],{},"Trigger Sound"," — pick from the live dropdown, or type an 8-character sound ID (Companion variables work)",[26,115,116,119],{},[30,117,118],{},"Stop Sound"," — stop one playing sound by ID",[26,121,122,125],{},[30,123,124],{},"Stop All"," — stop every playing sound",[14,127,128],{},"Copy a sound ID in SoundNinja from the button context menu or the multi-select ID chip.",[18,130,132],{"id":131},"feedbacks-and-variables","Feedbacks and variables",[106,134,135,141,154,160],{},[26,136,137,140],{},[30,138,139],{},"Sound Playing"," — true while that sound ID is active (use it for button color)",[26,142,143,146,147,150,151],{},[44,144,145],{},"$(soundninja:connected)"," — ",[44,148,149],{},"true"," \u002F ",[44,152,153],{},"false",[26,155,156,159],{},[44,157,158],{},"$(soundninja:playing_count)"," — how many sounds are playing",[26,161,162,165],{},[44,163,164],{},"$(soundninja:last_triggered)"," — last triggered sound ID",[18,167,169],{"id":168},"http-api-advanced","HTTP API (advanced)",[14,171,172,173],{},"Base path: ",[44,174,175],{},"\u002Fapi\u002Fv1",[106,177,178,184,190,196,206,212,221],{},[26,179,180,183],{},[44,181,182],{},"GET \u002Finfo"," — app name, version, protocol, whether a token is required",[26,185,186,189],{},[44,187,188],{},"GET \u002Fsounds"," — sound list (id, name, tabs, active)",[26,191,192,195],{},[44,193,194],{},"GET \u002Fstate"," — sounds plus currently playing IDs",[26,197,198,201,202,205],{},[44,199,200],{},"POST \u002Ftrigger"," with ",[44,203,204],{},"{ \"id\" }"," — play a sound",[26,207,208,211],{},[44,209,210],{},"GET \u002Ftrigger\u002F:id"," — play (easy to test in a browser)",[26,213,214,217,218,220],{},[44,215,216],{},"POST \u002Fstop"," with optional ",[44,219,204],{}," — stop one sound or all",[26,222,223,226],{},[44,224,225],{},"GET \u002Fws"," — live state; send trigger\u002Fstop commands inbound",{"title":228,"searchDepth":229,"depth":229,"links":230},"",2,[231,232,233,234,235],{"id":20,"depth":229,"text":21},{"id":62,"depth":229,"text":63},{"id":103,"depth":229,"text":104},{"id":131,"depth":229,"text":132},{"id":168,"depth":229,"text":169},"Trigger SoundNinja from Bitfocus Companion over the local network.","md",{},true,7,"\u002Fremote-control",{"title":5,"description":236},"G5BV4-hARZULMfsuLaTyczPL2Qt2QKaPmATZuk65Lik",[245,371,573,721,1124,1258,1404,1550],{"id":246,"title":247,"body":248,"description":365,"extension":237,"meta":366,"navigation":239,"order":367,"path":368,"seo":369,"stem":252,"__hash__":370},"content_en\u002Foverview.md","Overview",{"type":7,"value":249,"toc":359},[250,253,256,259,262,266,280,284,322,326,335,339],[10,251,247],{"id":252},"overview",[14,254,255],{},"SoundNinja is an open-source soundboard for live streaming, chatting with friends, and podcast recording. It is built with Tauri v2 and Nuxt 4 so it stays light on RAM and disk.",[14,257,258],{},"The goal is simple: keep a huge sound library easy to scan, then play the right clip in milliseconds. The UI also works well as a dashboard in VR.",[14,260,261],{},"SoundNinja is still in early development. Features work, but not every platform is fully tested.",[18,263,265],{"id":264},"who-it-is-for","Who it is for",[106,267,268,271,274,277],{},[26,269,270],{},"Streamers who need instant sound cues",[26,272,273],{},"Friends who want a shared board for voice chat",[26,275,276],{},"Podcasters who record clips and drop them onto a board",[26,278,279],{},"Anyone who wants a customizable, local-first soundboard",[18,281,283],{"id":282},"what-you-can-do","What you can do",[106,285,286,289,292,295,298,301,304,307,310,316,319],{},[26,287,288],{},"Build a soundboard from your own audio files",[26,290,291],{},"Organize sounds in colored tabs, groups, tags, and search",[26,293,294],{},"Filter by tags (OR) and sort by name, date, duration, or size",[26,296,297],{},"Multi-select with marquee or Shift-range, then bulk color, move, or delete",[26,299,300],{},"Set per-sound volume from the context menu",[26,302,303],{},"Design the look with the Theme Creator",[26,305,306],{},"Record PC audio or a microphone in the Record Editor",[26,308,309],{},"Assign hotkeys to individual sounds",[26,311,312,313],{},"Trigger sounds from ",[70,314,63],{"href":315},"\u002Fdocs\u002Fremote-control",[26,317,318],{},"Import and export a full soundboard to share with others",[26,320,321],{},"Use GIFs or images on sound buttons — from a local folder library or KLIPY",[18,323,325],{"id":324},"license","License",[14,327,328,329,334],{},"SoundNinja is free software under ",[70,330,333],{"href":331,"rel":332},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fblob\u002Fmain\u002FLICENSE",[74],"GPL-3.0",". Fork it, change it, share it.",[18,336,338],{"id":337},"next-steps","Next steps",[23,340,341,347,353],{},[26,342,343],{},[70,344,346],{"href":345},"\u002Fdocs\u002Finstallation","Install SoundNinja",[26,348,349],{},[70,350,352],{"href":351},"\u002Fdocs\u002Fadding-sounds","Add sounds",[26,354,355],{},[70,356,358],{"href":357},"\u002Fdocs\u002Forganizing-sounds","Organize your board",{"title":228,"searchDepth":229,"depth":229,"links":360},[361,362,363,364],{"id":264,"depth":229,"text":265},{"id":282,"depth":229,"text":283},{"id":324,"depth":229,"text":325},{"id":337,"depth":229,"text":338},"What SoundNinja is and what you can do with it.",{},1,"\u002Foverview",{"title":247,"description":365},"Dax9ydiOOeEz5F1IxWfEljWZynntK7dPp52JZ3q2G58",{"id":372,"title":373,"body":374,"description":568,"extension":237,"meta":569,"navigation":239,"order":229,"path":570,"seo":571,"stem":378,"__hash__":572},"content_en\u002Finstallation.md","Installation",{"type":7,"value":375,"toc":561},[376,379,393,397,418,421,425,439,442,446,470,481,485,492,496,511,541,557],[10,377,373],{"id":378},"installation",[14,380,381,382,386,387,392],{},"Grab a build from the ",[70,383,385],{"href":384},"\u002Fdownload","Download page"," or from ",[70,388,391],{"href":389,"rel":390},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Freleases\u002Flatest",[74],"GitHub Releases",". SoundNinja is in early development, so treat builds as beta.",[18,394,396],{"id":395},"windows","Windows",[106,398,399,409,412,415],{},[26,400,401,404,405,408],{},[30,402,403],{},"Installer (.exe)"," or ",[30,406,407],{},"MSI (.msi)"," for 64-bit Windows",[26,410,411],{},"Landing page target: Windows 10 and newer",[26,413,414],{},"The app README also lists Windows 8 and above",[26,416,417],{},"The NSIS installer uses a dark theme. Pick a language during setup — SoundNinja remembers it on the next launch.",[14,419,420],{},"Run the installer, then launch SoundNinja from the Start menu.",[18,422,424],{"id":423},"macos","macOS",[106,426,427,433,436],{},[26,428,429,432],{},[30,430,431],{},"Universal .dmg"," for Apple Silicon and Intel",[26,434,435],{},"Landing page target: macOS 10.14 and newer",[26,437,438],{},"The app README lists macOS 10.15 and above",[14,440,441],{},"Open the disk image and drag SoundNinja to Applications.",[18,443,445],{"id":444},"linux","Linux",[106,447,448,454,460,467],{},[26,449,450,453],{},[30,451,452],{},"Debian (.deb)"," for Ubuntu \u002F Debian",[26,455,456,459],{},[30,457,458],{},"AppImage"," for other distros",[26,461,462,463,466],{},"After a release is published, Arch users can install ",[44,464,465],{},"soundninja-bin"," from the AUR",[26,468,469],{},"Tested on Ubuntu 20.04",[14,471,472,473,476,477,480],{},"Desktop builds need WebKit and GTK packages. On Debian\u002FUbuntu that usually means ",[44,474,475],{},"libwebkit2gtk",", ",[44,478,479],{},"libgtk-3-0",", and an app-indicator library.",[18,482,484],{"id":483},"updates","Updates",[14,486,487,488,491],{},"In the app, open ",[30,489,490],{},"Help → Check for Updates",". You can also let SoundNinja check on startup in Settings.",[18,493,495],{"id":494},"build-from-source","Build from source",[14,497,498,499,504,505,510],{},"Need a custom build? Clone ",[70,500,503],{"href":501,"rel":502},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja",[74],"the repo",", install ",[70,506,509],{"href":507,"rel":508},"https:\u002F\u002Fv2.tauri.app\u002Fstart\u002Fprerequisites\u002F",[74],"Tauri prerequisites",", then:",[512,513,517],"pre",{"className":514,"code":515,"language":516,"meta":228,"style":228},"language-bash shiki shiki-themes github-light github-dark","bun install\nbun run tauri:serve\n","bash",[44,518,519,531],{"__ignoreMap":228},[520,521,523,527],"span",{"class":522,"line":367},"line",[520,524,526],{"class":525},"sScJk","bun",[520,528,530],{"class":529},"sZZnC"," install\n",[520,532,533,535,538],{"class":522,"line":229},[520,534,526],{"class":525},[520,536,537],{"class":529}," run",[520,539,540],{"class":529}," tauri:serve\n",[14,542,543,476,546,549,550,553,554,33],{},[44,544,545],{},"npm",[44,547,548],{},"pnpm",", or ",[44,551,552],{},"deno"," work too. Production build: ",[44,555,556],{},"bun run tauri:build",[558,559,560],"style",{},"html pre.shiki code .sScJk, html code.shiki .sScJk{--shiki-default:#6F42C1;--shiki-dark:#B392F0}html pre.shiki code .sZZnC, html code.shiki .sZZnC{--shiki-default:#032F62;--shiki-dark:#9ECBFF}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html.dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}",{"title":228,"searchDepth":229,"depth":229,"links":562},[563,564,565,566,567],{"id":395,"depth":229,"text":396},{"id":423,"depth":229,"text":424},{"id":444,"depth":229,"text":445},{"id":483,"depth":229,"text":484},{"id":494,"depth":229,"text":495},"Install SoundNinja on Windows, macOS, or Linux.",{},"\u002Finstallation",{"title":373,"description":568},"7viacDB8R6wsHmYhw6wWPv9XZF7nR_yMjR5-EjD4OjQ",{"id":574,"title":575,"body":576,"description":715,"extension":237,"meta":716,"navigation":239,"order":717,"path":718,"seo":719,"stem":580,"__hash__":720},"content_en\u002Fadding-sounds.md","Adding Sounds",{"type":7,"value":577,"toc":707},[578,581,584,588,606,610,642,646,665,669,683,686,690,697,701],[10,579,575],{"id":580},"adding-sounds",[14,582,583],{},"A board is empty until you add clips. SoundNinja can import files, whole folders, a recording, or a shared soundboard pack.",[18,585,587],{"id":586},"import-audio-files","Import audio files",[23,589,590,600,603],{},[26,591,28,592,595,596,599],{},[30,593,594],{},"File → Import Audio Files",", or use ",[30,597,598],{},"Import"," in the navbar.",[26,601,602],{},"Pick one or more audio files.",[26,604,605],{},"Sounds land in the current tab.",[18,607,609],{"id":608},"import-folders","Import folders",[23,611,612,622,625],{},[26,613,28,614,617,618,621],{},[30,615,616],{},"File → Import Folders"," (or ",[30,619,620],{},"Import Folders"," in the navbar).",[26,623,624],{},"Add one or more folders. Drag to reorder them before you import.",[26,626,627,628],{},"Choose how they land:\n",[106,629,630,636],{},[26,631,632,635],{},[30,633,634],{},"Import as Tabs"," — each folder becomes its own tab",[26,637,638,641],{},[30,639,640],{},"Import to current Tab"," — every file goes into the active tab",[18,643,645],{"id":644},"record-a-clip","Record a clip",[14,647,648,649,653,654,657,658,404,661,664],{},"Open the ",[70,650,652],{"href":651},"\u002Fdocs\u002Frecording-editor","Record Editor"," from the ",[30,655,656],{},"Record"," button in the player bar. Capture, trim, then ",[30,659,660],{},"Import selected",[30,662,663],{},"Import all"," into the current tab or a tab you pick.",[18,666,668],{"id":667},"import-a-soundboard","Import a soundboard",[14,670,671,674,675,678,679,682],{},[30,672,673],{},"File → Import Soundboard"," loads a shared pack. Packs are a ",[44,676,677],{},".zip"," that contains ",[44,680,681],{},"project.sninja"," plus the sound files. After import, open the project and play.",[14,684,685],{},"You can also keep several projects (profiles). Use the project selector to switch boards.",[18,687,689],{"id":688},"relink-missing-files","Relink missing files",[14,691,692,693,696],{},"If audio files move on disk, SoundNinja shows a ",[30,694,695],{},"Missing sound files"," dialog. Pick a folder to search and relink the clips.",[18,698,700],{"id":699},"next","Next",[14,702,703,704,33],{},"Organize tabs, tags, filters, and hotkeys in ",[70,705,706],{"href":357},"Organizing Sounds",{"title":228,"searchDepth":229,"depth":229,"links":708},[709,710,711,712,713,714],{"id":586,"depth":229,"text":587},{"id":608,"depth":229,"text":609},{"id":644,"depth":229,"text":645},{"id":667,"depth":229,"text":668},{"id":688,"depth":229,"text":689},{"id":699,"depth":229,"text":700},"Import audio, folders, recordings, and shared soundboards.",{},3,"\u002Fadding-sounds",{"title":575,"description":715},"SBUvL_H4633CrDyNUKazqKwru4aq1hhgoH4_o99rBsE",{"id":722,"title":706,"body":723,"description":1118,"extension":237,"meta":1119,"navigation":239,"order":1120,"path":1121,"seo":1122,"stem":727,"__hash__":1123},"content_en\u002Forganizing-sounds.md",{"type":7,"value":724,"toc":1103},[725,728,735,739,766,773,777,780,794,801,807,811,821,826,858,862,868,872,905,911,915,918,945,948,952,966,970,976,997,1013,1020,1024,1034,1037,1041,1048,1058,1064,1068,1076,1083,1100],[10,726,706],{"id":727},"organizing-sounds",[14,729,730,731,734],{},"SoundNinja is built for large libraries. Use ",[30,732,733],{},"tags and filters",", tabs, search, multi-select, and hotkeys so the clip you need is one click (or one key) away.",[18,736,738],{"id":737},"tabs","Tabs",[106,740,741,748,755],{},[26,742,743,744,747],{},"Add a tab with ",[30,745,746],{},"Add tab",". Give it a color so you can scan the bar fast.",[26,749,750,751,754],{},"The ",[30,752,753],{},"All"," view shows every sound across tabs.",[26,756,757,758,761,762,765],{},"A sound can belong to ",[30,759,760],{},"one or more tabs",". Right-click a sound and use ",[30,763,764],{},"Move to tab"," to assign it.",[14,767,768,769,772],{},"Tab transitions live in ",[30,770,771],{},"Settings → Main",": Slide, Fade, Buttons one by one, or None.",[18,774,776],{"id":775},"groups","Groups",[14,778,779],{},"Since v0.5.3, separators can become named groups:",[106,781,782,785,788,791],{},[26,783,784],{},"Add, rename, or remove a group from the context menu",[26,786,787],{},"Drag the group header — children move with it",[26,789,790],{},"Drop sounds in or out of a group",[26,792,793],{},"Set group border color, name color, and button alignment (or use the tab default)",[14,795,796,797,800],{},"You can still add a plain ",[30,798,799],{},"Separator"," if you only need a visual break.",[14,802,803,804,33],{},"Right-click empty board space to ",[30,805,806],{},"Add Group",[18,808,810],{"id":809},"tags-filters","Tags \u002F Filters",[14,812,813,814,817,818,820],{},"Tags cut across tabs. The slide-out ",[30,815,816],{},"Filter"," panel (sidebar ",[30,819,816],{},") is where you create them and turn them into a board filter.",[822,823,825],"h3",{"id":824},"create-and-edit-tags","Create and edit tags",[23,827,828,833,844,851],{},[26,829,28,830,832],{},[30,831,816],{}," in the sidebar.",[26,834,835,836,839,840,843],{},"Under ",[30,837,838],{},"Tags",", use ",[30,841,842],{},"Add tag"," — give it a name and a color.",[26,845,846,847,850],{},"Rename, recolor, or ",[30,848,849],{},"Delete tag"," from the same list.",[26,852,853,854,857],{},"If you see ",[30,855,856],{},"No tags yet",", add one here before you assign anything.",[822,859,861],{"id":860},"assign-tags-to-sounds","Assign tags to sounds",[14,863,864,865,867],{},"Right-click a sound → ",[30,866,838],{}," (checkboxes). A sound can have several tags. If none exist yet, the menu tells you to open the filter panel.",[822,869,871],{"id":870},"filter-the-board","Filter the board",[106,873,874,880,891,902],{},[26,875,876,877,33],{},"Toggle tags in the Filter panel, or as ",[30,878,879],{},"chips under the search bar",[26,881,882,883,886,887,890],{},"Matching is ",[30,884,885],{},"OR",": a sound stays visible if it has ",[30,888,889],{},"any"," selected tag.",[26,892,893,894,897,898,901],{},"The navbar ",[30,895,896],{},"Search"," field ",[30,899,900],{},"ANDs"," with the active tag filter (type + tags together).",[26,903,904],{},"Turn chips off (or clear the filter) to show the full tab again.",[14,906,907,908,33],{},"Colored tag names can appear on buttons. Toggle them in ",[30,909,910],{},"Settings → Behavior → Show tag badges",[18,912,914],{"id":913},"sort","Sort",[14,916,917],{},"Open the filter panel and pick a sort mode:",[106,919,920,926],{},[26,921,922,925],{},[30,923,924],{},"User defined"," — your tab order, with groups visible",[26,927,928,476,931,476,934,549,937,940,941,944],{},[30,929,930],{},"Name",[30,932,933],{},"Added time",[30,935,936],{},"Play time",[30,938,939],{},"File size"," — a flat sorted list; ",[30,942,943],{},"groups are hidden"," in these modes",[14,946,947],{},"Duration sort may warm duration metadata the first time you use it.",[18,949,951],{"id":950},"reorder","Reorder",[14,953,954,955,958,959,962,963,965],{},"Turn on drag-and-drop in ",[30,956,957],{},"Settings → Behavior"," (",[30,960,961],{},"Allow reorder","). Then drag sounds and groups into place. Reorder applies in ",[30,964,924],{}," sort.",[18,967,969],{"id":968},"multi-select","Multi-select",[14,971,972,973,975],{},"Turn on ",[30,974,969],{}," in the navbar, then:",[106,977,978,981,987,994],{},[26,979,980],{},"Click a sound to toggle it",[26,982,983,986],{},[30,984,985],{},"Shift+click"," to select a range from the last anchor",[26,988,989,990,993],{},"Drag a ",[30,991,992],{},"marquee"," on empty board space",[26,995,996],{},"Click empty board (or outside) to clear the selection",[14,998,999,1000,476,1003,476,1006,1009,1010,33],{},"A bulk bar appears with the count, plus ",[30,1001,1002],{},"Color",[30,1004,1005],{},"Move to tab…",[30,1007,1008],{},"Delete",", and ",[30,1011,1012],{},"Done",[14,1014,1015,1016,1019],{},"In multi-select, each button shows an ",[30,1017,1018],{},"8-character ID chip",". Right-click the chip to copy it.",[18,1021,1023],{"id":1022},"per-sound-volume","Per-sound volume",[14,1025,864,1026,1029,1030,1033],{},[30,1027,1028],{},"Volume",". Drag the slider from 0% to 100%. ",[30,1031,1032],{},"Double-click"," the slider to reset to 100%.",[14,1035,1036],{},"This stacks with the master output volume in Settings.",[18,1038,1040],{"id":1039},"hotkeys-and-sound-ids","Hotkeys and sound IDs",[14,1042,1043,1044,1047],{},"Every sound has an 8-character ID. Copy it from the button context menu (",[30,1045,1046],{},"Copy ID",") or the multi-select ID chip.",[14,1049,28,1050,1053,1054,1057],{},[30,1051,1052],{},"Settings → Hotkeys"," to bind a key to a sound ID. Global hotkeys are optional. ",[30,1055,1056],{},"Assign hotkey"," on the context menu jumps there with the ID prefilled.",[14,1059,1060,1061,1063],{},"The same ID is what ",[70,1062,63],{"href":315}," uses to trigger a clip.",[18,1065,1067],{"id":1066},"background-images-and-colors","Background images and colors",[14,1069,1070,1071,1075],{},"Right-click a sound to set per-button colors or a background image. That is separate from the ",[70,1072,1074],{"href":1073},"\u002Fdocs\u002Ftheme-editor","Theme Creator",", which styles the whole board.",[14,1077,1078,1079,1082],{},"The picker is a ",[30,1080,1081],{},"Background image"," dialog (PNG, JPEG, GIF, WebP):",[106,1084,1085,1091],{},[26,1086,1087,1090],{},[30,1088,1089],{},"Local files"," — add folders, pick a single file, search filenames, preview the grid, or remove a folder from the library",[26,1092,1093,1096,1097,1099],{},[30,1094,1095],{},"KLIPY"," — search online GIFs. Set your own API key in ",[30,1098,957],{},". The key is not stored in project files.",[14,1101,1102],{},"After you pick an image, pan and crop it on the button.",{"title":228,"searchDepth":229,"depth":229,"links":1104},[1105,1106,1107,1112,1113,1114,1115,1116,1117],{"id":737,"depth":229,"text":738},{"id":775,"depth":229,"text":776},{"id":809,"depth":229,"text":810,"children":1108},[1109,1110,1111],{"id":824,"depth":717,"text":825},{"id":860,"depth":717,"text":861},{"id":870,"depth":717,"text":871},{"id":913,"depth":229,"text":914},{"id":950,"depth":229,"text":951},{"id":968,"depth":229,"text":969},{"id":1022,"depth":229,"text":1023},{"id":1039,"depth":229,"text":1040},{"id":1066,"depth":229,"text":1067},"Tags, filters, tabs, groups, sort, multi-select, volume, and hotkeys.",{},4,"\u002Forganizing-sounds",{"title":706,"description":1118},"DaYqySVuX1kgdTnJw6h1GP_lGyj4zdFP2uKKbBEbVwQ",{"id":1125,"title":1126,"body":1127,"description":1252,"extension":237,"meta":1253,"navigation":239,"order":1254,"path":1255,"seo":1256,"stem":1131,"__hash__":1257},"content_en\u002Ftheme-editor.md","Theme Editor",{"type":7,"value":1128,"toc":1246},[1129,1132,1138,1142,1168,1171,1175,1189,1193,1219,1222,1226,1232],[10,1130,1126],{"id":1131},"theme-editor",[14,1133,1134,1135,33],{},"The Theme Creator is the full visual editor for your board. Open it from ",[30,1136,1137],{},"Settings → Main → Theme Creator",[18,1139,1141],{"id":1140},"three-tabs","Three tabs",[23,1143,1144,1157,1163],{},[26,1145,1146,1149,1150,150,1153,1156],{},[30,1147,1148],{},"General"," — theme name, shared colors, and font uploads (",[44,1151,1152],{},".ttf",[44,1154,1155],{},".otf",")",[26,1158,1159,1162],{},[30,1160,1161],{},"Buttons"," — sound button colors, type, layout, and GIF overlay",[26,1164,1165,1167],{},[30,1166,738],{}," — tab bar colors, type, and border thickness",[14,1169,1170],{},"A live preview shows tabs and buttons as you edit.",[18,1172,1174],{"id":1173},"what-you-can-change","What you can change",[106,1176,1177,1180,1183,1186],{},[26,1178,1179],{},"Primary and accent colors, backgrounds, button colors, tab colors",[26,1181,1182],{},"Button and tab font family and size",[26,1184,1185],{},"Button width, radius, border width, gaps, and padding",[26,1187,1188],{},"GIF overlay opacity (normal and hover)",[18,1190,1192],{"id":1191},"save-and-share","Save and share",[106,1194,1195,1201,1207,1213],{},[26,1196,1197,1200],{},[30,1198,1199],{},"Export .css"," — write a theme file you can back up or send to a friend",[26,1202,1203,1206],{},[30,1204,1205],{},"Add to Themes"," — save the file into your Themes folder and apply it",[26,1208,1209,1212],{},[30,1210,1211],{},"Import .css"," — load a built-in preset or a saved theme",[26,1214,1215,1218],{},[30,1216,1217],{},"Reset"," — return to SoundNinja defaults",[14,1220,1221],{},"If you close the window with unsaved changes, SoundNinja asks you to save first.",[18,1223,1225],{"id":1224},"without-the-full-editor","Without the full editor",[14,1227,1228,1229,1231],{},"In ",[30,1230,771],{}," you can still:",[106,1233,1234,1237,1243],{},[26,1235,1236],{},"Pick a theme from the list",[26,1238,1239,1240,1156],{},"Edit CSS variables live (",[30,1241,1242],{},"Custom CSS",[26,1244,1245],{},"Import a theme file into the Themes folder",{"title":228,"searchDepth":229,"depth":229,"links":1247},[1248,1249,1250,1251],{"id":1140,"depth":229,"text":1141},{"id":1173,"depth":229,"text":1174},{"id":1191,"depth":229,"text":1192},{"id":1224,"depth":229,"text":1225},"Design colors, fonts, buttons, and tabs in the Theme Creator.",{},5,"\u002Ftheme-editor",{"title":1126,"description":1252},"zpMjxENa49aUipEX7TBxcqrbaZNweyJ019KsLAMJeoc",{"id":1259,"title":1260,"body":1261,"description":1398,"extension":237,"meta":1399,"navigation":239,"order":1400,"path":1401,"seo":1402,"stem":1265,"__hash__":1403},"content_en\u002Frecording-editor.md","Recording Editor",{"type":7,"value":1262,"toc":1392},[1263,1266,1272,1276,1282,1302,1305,1309,1334,1338,1353,1357,1371,1382],[10,1264,1260],{"id":1265},"recording-editor",[14,1267,1268,1269,1271],{},"Record a clip inside SoundNinja, trim it, then import it onto a tab. Open the editor with the ",[30,1270,656],{}," button in the player bar.",[18,1273,1275],{"id":1274},"choose-an-input","Choose an input",[14,1277,1228,1278,1281],{},[30,1279,1280],{},"Settings → Audio",":",[106,1283,1284,1290,1296],{},[26,1285,1286,1289],{},[30,1287,1288],{},"Input Devices"," — microphone",[26,1291,1292,1295],{},[30,1293,1294],{},"Output Devices (PC Audio)"," — loopback of what your PC is playing",[26,1297,1298,1301],{},[30,1299,1300],{},"Input volume"," — capture gain from 0% to 200%",[14,1303,1304],{},"The Record button uses the device you pick here.",[18,1306,1308],{"id":1307},"edit-the-take","Edit the take",[106,1310,1311,1314,1317,1325,1328,1331],{},[26,1312,1313],{},"Record and stop",[26,1315,1316],{},"Watch the input level meter",[26,1318,1319,404,1322],{},[30,1320,1321],{},"Normalize",[30,1323,1324],{},"Noise Cancelation",[26,1326,1327],{},"Trim the whole clip, trim to a selection, or delete a selection",[26,1329,1330],{},"Undo \u002F redo",[26,1332,1333],{},"Zoom in and out",[18,1335,1337],{"id":1336},"stage-and-import","Stage and import",[23,1339,1340,1343,1346],{},[26,1341,1342],{},"Add the selection or the full track to the staging list.",[26,1344,1345],{},"The list starts empty: record, edit, then add a clip.",[26,1347,1348,404,1350,1352],{},[30,1349,660],{},[30,1351,663],{}," into the current tab or a tab you choose.",[18,1354,1356],{"id":1355},"stem-separation-optional","Stem separation (optional)",[14,1358,1359,1360,1363,1364,404,1367,1370],{},"Official Windows, macOS, and Linux release builds ship the ",[30,1361,1362],{},"stems"," feature. The Record Editor can keep ",[30,1365,1366],{},"vocals",[30,1368,1369],{},"music"," using BS-RoFormer.",[14,1372,1373,1374,1377,1378,1381],{},"The model is about 158 MB and is ",[30,1375,1376],{},"not"," bundled with the installer. Download it from ",[30,1379,1380],{},"Settings → Stem Separation",", or accept the first-run prompt. The Windows installer can also offer to download the model on first launch.",[14,1383,1384,1385,150,1388,1391],{},"Custom source builds need an extra flag (",[44,1386,1387],{},"tauri:serve:stems",[44,1389,1390],{},"tauri:build:stems",").",{"title":228,"searchDepth":229,"depth":229,"links":1393},[1394,1395,1396,1397],{"id":1274,"depth":229,"text":1275},{"id":1307,"depth":229,"text":1308},{"id":1336,"depth":229,"text":1337},{"id":1355,"depth":229,"text":1356},"Capture mic or PC audio, edit the clip, and drop it on your board.",{},6,"\u002Frecording-editor",{"title":1260,"description":1398},"WLz7ozLeboeLKawRkz53eUj5KSVCj4xkPMhYg5P_MIo",{"id":4,"title":5,"body":1405,"description":236,"extension":237,"meta":1548,"navigation":239,"order":240,"path":241,"seo":1549,"stem":12,"__hash__":243},{"type":7,"value":1406,"toc":1541},[1407,1409,1411,1413,1433,1435,1437,1459,1461,1475,1477,1479,1501,1503,1507],[10,1408,5],{"id":12},[14,1410,16],{},[18,1412,21],{"id":20},[23,1414,1415,1419,1423,1427],{},[26,1416,28,1417,33],{},[30,1418,32],{},[26,1420,36,1421,33],{},[30,1422,39],{},[26,1424,42,1425,33],{},[44,1426,46],{},[26,1428,49,1429,53,1431,33],{},[44,1430,52],{},[30,1432,56],{},[14,1434,59],{},[18,1436,63],{"id":62},[23,1438,1439,1444,1449,1455],{},[26,1440,68,1441,33],{},[70,1442,63],{"href":72,"rel":1443},[74],[26,1445,77,1446,83],{},[70,1447,82],{"href":80,"rel":1448},[74],[26,1450,86,1451,90,1453,33],{},[30,1452,89],{},[44,1454,93],{},[26,1456,96,1457,100],{},[30,1458,99],{},[18,1460,104],{"id":103},[106,1462,1463,1467,14