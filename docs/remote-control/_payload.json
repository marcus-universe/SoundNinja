[{"data":1,"prerenderedAt":1383},["ShallowReactive",2],{"docs-page-en-\u002Fremote-control":3,"docs-nav-en":244},{"id":4,"title":5,"body":6,"description":236,"extension":237,"meta":238,"navigation":239,"order":240,"path":241,"seo":242,"stem":12,"__hash__":243},"content_en\u002Fremote-control.md","Remote Control",{"type":7,"value":8,"toc":227},"minimark",[9,13,17,22,57,60,64,101,105,126,129,133,166,170,176],[10,11,5],"h1",{"id":12},"remote-control",[14,15,16],"p",{},"SoundNinja can listen on your local network so Bitfocus Companion (or any HTTP\u002FWebSocket client) can play and stop sounds.",[18,19,21],"h2",{"id":20},"enable-the-remote-server","Enable the remote server",[23,24,25,34,40,47],"ol",{},[26,27,28,29,33],"li",{},"Open ",[30,31,32],"strong",{},"Settings → Remote",".",[26,35,36,37,33],{},"Enable the remote server. Default port is ",[30,38,39],{},"7331",[26,41,42,43,33],{},"Optional: set a token. Clients must send it as a Bearer token or ",[44,45,46],"code",{},"?token=",[26,48,49,50,53,54,33],{},"Copy the ",[44,51,52],{},"http:\u002F\u002FIP:PORT"," URL, or copy the system IP from ",[30,55,56],{},"Settings → About",[14,58,59],{},"Windows may show a firewall prompt the first time the server starts. Allow private-network access.",[18,61,63],{"id":62},"bitfocus-companion","Bitfocus Companion",[23,65,66,75,84,94],{},[26,67,68,69,33],{},"Install ",[70,71,63],"a",{"href":72,"rel":73},"https:\u002F\u002Fbitfocus.io\u002Fcompanion",[74],"nofollow",[26,76,77,78,83],{},"Download ",[70,79,82],{"href":80,"rel":81},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Freleases\u002Flatest\u002Fdownload\u002Fcompanion-module-soundninja.tgz",[74],"companion-module-soundninja.tgz",". There is no Companion Store package yet.",[26,85,86,87,90,91,33],{},"In Companion: ",[30,88,89],{},"Modules → Load module package"," and pick the ",[44,92,93],{},".tgz",[26,95,96,97,100],{},"Add a ",[30,98,99],{},"Sound Ninja"," connection. Paste the PC IP, port, and token if you set one.",[18,102,104],{"id":103},"actions","Actions",[106,107,108,114,120],"ul",{},[26,109,110,113],{},[30,111,112],{},"Trigger Sound"," — pick from the live dropdown, or type an 8-character sound ID (Companion variables work)",[26,115,116,119],{},[30,117,118],{},"Stop Sound"," — stop one playing sound by ID",[26,121,122,125],{},[30,123,124],{},"Stop All"," — stop every playing sound",[14,127,128],{},"Copy a sound ID in SoundNinja from the button context menu or the multi-select ID chip.",[18,130,132],{"id":131},"feedbacks-and-variables","Feedbacks and variables",[106,134,135,141,154,160],{},[26,136,137,140],{},[30,138,139],{},"Sound Playing"," — true while that sound ID is active (use it for button color)",[26,142,143,146,147,150,151],{},[44,144,145],{},"$(soundninja:connected)"," — ",[44,148,149],{},"true"," \u002F ",[44,152,153],{},"false",[26,155,156,159],{},[44,157,158],{},"$(soundninja:playing_count)"," — how many sounds are playing",[26,161,162,165],{},[44,163,164],{},"$(soundninja:last_triggered)"," — last triggered sound ID",[18,167,169],{"id":168},"http-api-advanced","HTTP API (advanced)",[14,171,172,173],{},"Base path: ",[44,174,175],{},"\u002Fapi\u002Fv1",[106,177,178,184,190,196,206,212,221],{},[26,179,180,183],{},[44,181,182],{},"GET \u002Finfo"," — app name, version, protocol, whether a token is required",[26,185,186,189],{},[44,187,188],{},"GET \u002Fsounds"," — sound list (id, name, tabs, active)",[26,191,192,195],{},[44,193,194],{},"GET \u002Fstate"," — sounds plus currently playing IDs",[26,197,198,201,202,205],{},[44,199,200],{},"POST \u002Ftrigger"," with ",[44,203,204],{},"{ \"id\" }"," — play a sound",[26,207,208,211],{},[44,209,210],{},"GET \u002Ftrigger\u002F:id"," — play (easy to test in a browser)",[26,213,214,217,218,220],{},[44,215,216],{},"POST \u002Fstop"," with optional ",[44,219,204],{}," — stop one sound or all",[26,222,223,226],{},[44,224,225],{},"GET \u002Fws"," — live state; send trigger\u002Fstop commands inbound",{"title":228,"searchDepth":229,"depth":229,"links":230},"",2,[231,232,233,234,235],{"id":20,"depth":229,"text":21},{"id":62,"depth":229,"text":63},{"id":103,"depth":229,"text":104},{"id":131,"depth":229,"text":132},{"id":168,"depth":229,"text":169},"Trigger SoundNinja from Bitfocus Companion over the local network.","md",{},true,7,"\u002Fremote-control",{"title":5,"description":236},"wUUXEeUIG0wA5XHXyiMCGZXzR5yznF1l2ByKM6FEobI",[245,362,561,709,863,997,1139,1285],{"id":246,"title":247,"body":248,"description":356,"extension":237,"meta":357,"navigation":239,"order":358,"path":359,"seo":360,"stem":252,"__hash__":361},"content_en\u002Foverview.md","Overview",{"type":7,"value":249,"toc":350},[250,253,256,259,262,266,280,284,313,317,326,330],[10,251,247],{"id":252},"overview",[14,254,255],{},"SoundNinja is an open-source soundboard for live streaming, chatting with friends, and podcast recording. It is built with Tauri v2 and Nuxt 4 so it stays light on RAM and disk.",[14,257,258],{},"The goal is simple: keep a huge sound library easy to scan, then play the right clip in milliseconds. The UI also works well as a dashboard in VR.",[14,260,261],{},"SoundNinja is still in early development. Features work, but not every platform is fully tested.",[18,263,265],{"id":264},"who-it-is-for","Who it is for",[106,267,268,271,274,277],{},[26,269,270],{},"Streamers who need instant sound cues",[26,272,273],{},"Friends who want a shared board for voice chat",[26,275,276],{},"Podcasters who record clips and drop them onto a board",[26,278,279],{},"Anyone who wants a customizable, local-first soundboard",[18,281,283],{"id":282},"what-you-can-do","What you can do",[106,285,286,289,292,295,298,301,307,310],{},[26,287,288],{},"Build a soundboard from your own audio files",[26,290,291],{},"Organize sounds in colored tabs, groups, and search",[26,293,294],{},"Design the look with the Theme Creator",[26,296,297],{},"Record PC audio or a microphone in the Record Editor",[26,299,300],{},"Assign hotkeys to individual sounds",[26,302,303,304],{},"Trigger sounds from ",[70,305,63],{"href":306},"\u002Fdocs\u002Fremote-control",[26,308,309],{},"Import and export a full soundboard to share with others",[26,311,312],{},"Use GIFs or images on sound buttons",[18,314,316],{"id":315},"license","License",[14,318,319,320,325],{},"SoundNinja is free software under ",[70,321,324],{"href":322,"rel":323},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fblob\u002Fmain\u002FLICENSE",[74],"GPL-3.0",". Fork it, change it, share it.",[18,327,329],{"id":328},"next-steps","Next steps",[23,331,332,338,344],{},[26,333,334],{},[70,335,337],{"href":336},"\u002Fdocs\u002Finstallation","Install SoundNinja",[26,339,340],{},[70,341,343],{"href":342},"\u002Fdocs\u002Fadding-sounds","Add sounds",[26,345,346],{},[70,347,349],{"href":348},"\u002Fdocs\u002Forganizing-sounds","Organize your board",{"title":228,"searchDepth":229,"depth":229,"links":351},[352,353,354,355],{"id":264,"depth":229,"text":265},{"id":282,"depth":229,"text":283},{"id":315,"depth":229,"text":316},{"id":328,"depth":229,"text":329},"What SoundNinja is and what you can do with it.",{},1,"\u002Foverview",{"title":247,"description":356},"cOxJIh0ybRdZsyS1INxo9O3CTipyV8220IKpyfnYFJA",{"id":363,"title":364,"body":365,"description":556,"extension":237,"meta":557,"navigation":239,"order":229,"path":558,"seo":559,"stem":369,"__hash__":560},"content_en\u002Finstallation.md","Installation",{"type":7,"value":366,"toc":549},[367,370,384,388,406,409,413,427,430,434,458,469,473,480,484,499,529,545],[10,368,364],{"id":369},"installation",[14,371,372,373,377,378,383],{},"Grab a build from the ",[70,374,376],{"href":375},"\u002Fdownload","Download page"," or from ",[70,379,382],{"href":380,"rel":381},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Freleases\u002Flatest",[74],"GitHub Releases",". SoundNinja is in early development, so treat builds as beta.",[18,385,387],{"id":386},"windows","Windows",[106,389,390,400,403],{},[26,391,392,395,396,399],{},[30,393,394],{},"Installer (.exe)"," or ",[30,397,398],{},"MSI (.msi)"," for 64-bit Windows",[26,401,402],{},"Landing page target: Windows 10 and newer",[26,404,405],{},"The app README also lists Windows 8 and above",[14,407,408],{},"Run the installer, then launch SoundNinja from the Start menu.",[18,410,412],{"id":411},"macos","macOS",[106,414,415,421,424],{},[26,416,417,420],{},[30,418,419],{},"Universal .dmg"," for Apple Silicon and Intel",[26,422,423],{},"Landing page target: macOS 10.14 and newer",[26,425,426],{},"The app README lists macOS 10.15 and above",[14,428,429],{},"Open the disk image and drag SoundNinja to Applications.",[18,431,433],{"id":432},"linux","Linux",[106,435,436,442,448,455],{},[26,437,438,441],{},[30,439,440],{},"Debian (.deb)"," for Ubuntu \u002F Debian",[26,443,444,447],{},[30,445,446],{},"AppImage"," for other distros",[26,449,450,451,454],{},"After a release is published, Arch users can install ",[44,452,453],{},"soundninja-bin"," from the AUR",[26,456,457],{},"Tested on Ubuntu 20.04",[14,459,460,461,464,465,468],{},"Desktop builds need WebKit and GTK packages. On Debian\u002FUbuntu that usually means ",[44,462,463],{},"libwebkit2gtk",", ",[44,466,467],{},"libgtk-3-0",", and an app-indicator library.",[18,470,472],{"id":471},"updates","Updates",[14,474,475,476,479],{},"In the app, open ",[30,477,478],{},"Help → Check for Updates",". You can also let SoundNinja check on startup in Settings.",[18,481,483],{"id":482},"build-from-source","Build from source",[14,485,486,487,492,493,498],{},"Need a custom build? Clone ",[70,488,491],{"href":489,"rel":490},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja",[74],"the repo",", install ",[70,494,497],{"href":495,"rel":496},"https:\u002F\u002Fv2.tauri.app\u002Fstart\u002Fprerequisites\u002F",[74],"Tauri prerequisites",", then:",[500,501,505],"pre",{"className":502,"code":503,"language":504,"meta":228,"style":228},"language-bash shiki shiki-themes github-light github-dark","bun install\nbun run tauri:serve\n","bash",[44,506,507,519],{"__ignoreMap":228},[508,509,511,515],"span",{"class":510,"line":358},"line",[508,512,514],{"class":513},"sScJk","bun",[508,516,518],{"class":517},"sZZnC"," install\n",[508,520,521,523,526],{"class":510,"line":229},[508,522,514],{"class":513},[508,524,525],{"class":517}," run",[508,527,528],{"class":517}," tauri:serve\n",[14,530,531,464,534,537,538,541,542,33],{},[44,532,533],{},"npm",[44,535,536],{},"pnpm",", or ",[44,539,540],{},"deno"," work too. Production build: ",[44,543,544],{},"bun run tauri:build",[546,547,548],"style",{},"html pre.shiki code .sScJk, html code.shiki .sScJk{--shiki-default:#6F42C1;--shiki-dark:#B392F0}html pre.shiki code .sZZnC, html code.shiki .sZZnC{--shiki-default:#032F62;--shiki-dark:#9ECBFF}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html.dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}",{"title":228,"searchDepth":229,"depth":229,"links":550},[551,552,553,554,555],{"id":386,"depth":229,"text":387},{"id":411,"depth":229,"text":412},{"id":432,"depth":229,"text":433},{"id":471,"depth":229,"text":472},{"id":482,"depth":229,"text":483},"Install SoundNinja on Windows, macOS, or Linux.",{},"\u002Finstallation",{"title":364,"description":556},"i4XnnjkhxVb30IICErH1K_cBbAQ7GmnD52FYRYjh50k",{"id":562,"title":563,"body":564,"description":703,"extension":237,"meta":704,"navigation":239,"order":705,"path":706,"seo":707,"stem":568,"__hash__":708},"content_en\u002Fadding-sounds.md","Adding Sounds",{"type":7,"value":565,"toc":695},[566,569,572,576,594,598,630,634,653,657,671,674,678,685,689],[10,567,563],{"id":568},"adding-sounds",[14,570,571],{},"A board is empty until you add clips. SoundNinja can import files, whole folders, a recording, or a shared soundboard pack.",[18,573,575],{"id":574},"import-audio-files","Import audio files",[23,577,578,588,591],{},[26,579,28,580,583,584,587],{},[30,581,582],{},"File → Import Audio Files",", or use ",[30,585,586],{},"Import"," in the navbar.",[26,589,590],{},"Pick one or more audio files.",[26,592,593],{},"Sounds land in the current tab.",[18,595,597],{"id":596},"import-folders","Import folders",[23,599,600,610,613],{},[26,601,28,602,605,606,609],{},[30,603,604],{},"File → Import Folders"," (or ",[30,607,608],{},"Import Folders"," in the navbar).",[26,611,612],{},"Add one or more folders. Drag to reorder them before you import.",[26,614,615,616],{},"Choose how they land:\n",[106,617,618,624],{},[26,619,620,623],{},[30,621,622],{},"Import as Tabs"," — each folder becomes its own tab",[26,625,626,629],{},[30,627,628],{},"Import to current Tab"," — every file goes into the active tab",[18,631,633],{"id":632},"record-a-clip","Record a clip",[14,635,636,637,641,642,645,646,395,649,652],{},"Open the ",[70,638,640],{"href":639},"\u002Fdocs\u002Frecording-editor","Record Editor"," from the ",[30,643,644],{},"Record"," button in the player bar. Capture, trim, then ",[30,647,648],{},"Import selected",[30,650,651],{},"Import all"," into the current tab or a tab you pick.",[18,654,656],{"id":655},"import-a-soundboard","Import a soundboard",[14,658,659,662,663,666,667,670],{},[30,660,661],{},"File → Import Soundboard"," loads a shared pack. Packs are a ",[44,664,665],{},".zip"," that contains ",[44,668,669],{},"project.sninja"," plus the sound files. After import, open the project and play.",[14,672,673],{},"You can also keep several projects (profiles). Use the project selector to switch boards.",[18,675,677],{"id":676},"relink-missing-files","Relink missing files",[14,679,680,681,684],{},"If audio files move on disk, SoundNinja shows a ",[30,682,683],{},"Missing sound files"," dialog. Pick a folder to search and relink the clips.",[18,686,688],{"id":687},"next","Next",[14,690,691,692,33],{},"Organize tabs, groups, and hotkeys in ",[70,693,694],{"href":348},"Organizing Sounds",{"title":228,"searchDepth":229,"depth":229,"links":696},[697,698,699,700,701,702],{"id":574,"depth":229,"text":575},{"id":596,"depth":229,"text":597},{"id":632,"depth":229,"text":633},{"id":655,"depth":229,"text":656},{"id":676,"depth":229,"text":677},{"id":687,"depth":229,"text":688},"Import audio, folders, recordings, and shared soundboards.",{},3,"\u002Fadding-sounds",{"title":563,"description":703},"qcK88xpbquf2dRogb67sx4O0tzuIof13-X3Yyn9680o",{"id":710,"title":694,"body":711,"description":857,"extension":237,"meta":858,"navigation":239,"order":859,"path":860,"seo":861,"stem":715,"__hash__":862},"content_en\u002Forganizing-sounds.md",{"type":7,"value":712,"toc":848},[713,716,719,723,750,757,761,764,778,785,789,795,799,810,814,817,821,824,830,836,840],[10,714,694],{"id":715},"organizing-sounds",[14,717,718],{},"SoundNinja is built for large libraries. Use tabs, groups, search, and hotkeys so the clip you need is one click (or one key) away.",[18,720,722],{"id":721},"tabs","Tabs",[106,724,725,732,739],{},[26,726,727,728,731],{},"Add a tab with ",[30,729,730],{},"Add tab",". Give it a color so you can scan the bar fast.",[26,733,734,735,738],{},"The ",[30,736,737],{},"All"," view shows every sound across tabs.",[26,740,741,742,745,746,749],{},"A sound can belong to ",[30,743,744],{},"one or more tabs",". Right-click a sound and use ",[30,747,748],{},"Move to tab"," to assign it.",[14,751,752,753,756],{},"Tab transitions live in ",[30,754,755],{},"Settings → Main",": Slide, Fade, Buttons one by one, or None.",[18,758,760],{"id":759},"groups","Groups",[14,762,763],{},"Since v0.5.3, separators can become named groups:",[106,765,766,769,772,775],{},[26,767,768],{},"Add, rename, or remove a group from the context menu",[26,770,771],{},"Drag the group header — children move with it",[26,773,774],{},"Drop sounds in or out of a group",[26,776,777],{},"Set group border color, name color, and button alignment (or use the tab default)",[14,779,780,781,784],{},"You can still add a plain ",[30,782,783],{},"Separator"," if you only need a visual break.",[18,786,788],{"id":787},"search","Search",[14,790,791,792,794],{},"Use the ",[30,793,788],{}," field in the navbar. Results update as you type.",[18,796,798],{"id":797},"reorder","Reorder",[14,800,801,802,805,806,809],{},"Turn on drag-and-drop in ",[30,803,804],{},"Settings → Behavior"," (",[30,807,808],{},"Allow reorder","). Then drag sounds and groups into place.",[18,811,813],{"id":812},"bulk-edit","Bulk edit",[14,815,816],{},"Multi-select sounds, then change color, move them to a tab, or delete them in one step.",[18,818,820],{"id":819},"hotkeys-and-sound-ids","Hotkeys and sound IDs",[14,822,823],{},"Every sound has an 8-character ID. Copy it from the button context menu or the multi-select ID chip.",[14,825,28,826,829],{},[30,827,828],{},"Settings → Hotkeys"," to bind a key to a sound ID. Global hotkeys are optional.",[14,831,832,833,835],{},"The same ID is what ",[70,834,63],{"href":306}," uses to trigger a clip.",[18,837,839],{"id":838},"gifs-and-colors","GIFs and colors",[14,841,842,843,847],{},"Right-click a sound to set per-button colors or a GIF \u002F image background. That is separate from the ",[70,844,846],{"href":845},"\u002Fdocs\u002Ftheme-editor","Theme Creator",", which styles the whole board.",{"title":228,"searchDepth":229,"depth":229,"links":849},[850,851,852,853,854,855,856],{"id":721,"depth":229,"text":722},{"id":759,"depth":229,"text":760},{"id":787,"depth":229,"text":788},{"id":797,"depth":229,"text":798},{"id":812,"depth":229,"text":813},{"id":819,"depth":229,"text":820},{"id":838,"depth":229,"text":839},"Tabs, groups, search, bulk edit, and hotkeys.",{},4,"\u002Forganizing-sounds",{"title":694,"description":857},"Q4gLPzceZdOi3j6gqMTmPuTzf4qua7p2dfLn2shjKT4",{"id":864,"title":865,"body":866,"description":991,"extension":237,"meta":992,"navigation":239,"order":993,"path":994,"seo":995,"stem":870,"__hash__":996},"content_en\u002Ftheme-editor.md","Theme Editor",{"type":7,"value":867,"toc":985},[868,871,877,881,907,910,914,928,932,958,961,965,971],[10,869,865],{"id":870},"theme-editor",[14,872,873,874,33],{},"The Theme Creator is the full visual editor for your board. Open it from ",[30,875,876],{},"Settings → Main → Theme Creator",[18,878,880],{"id":879},"three-tabs","Three tabs",[23,882,883,896,902],{},[26,884,885,888,889,150,892,895],{},[30,886,887],{},"General"," — theme name, shared colors, and font uploads (",[44,890,891],{},".ttf",[44,893,894],{},".otf",")",[26,897,898,901],{},[30,899,900],{},"Buttons"," — sound button colors, type, layout, and GIF overlay",[26,903,904,906],{},[30,905,722],{}," — tab bar colors, type, and border thickness",[14,908,909],{},"A live preview shows tabs and buttons as you edit.",[18,911,913],{"id":912},"what-you-can-change","What you can change",[106,915,916,919,922,925],{},[26,917,918],{},"Primary and accent colors, backgrounds, button colors, tab colors",[26,920,921],{},"Button and tab font family and size",[26,923,924],{},"Button width, radius, border width, gaps, and padding",[26,926,927],{},"GIF overlay opacity (normal and hover)",[18,929,931],{"id":930},"save-and-share","Save and share",[106,933,934,940,946,952],{},[26,935,936,939],{},[30,937,938],{},"Export .css"," — write a theme file you can back up or send to a friend",[26,941,942,945],{},[30,943,944],{},"Add to Themes"," — save the file into your Themes folder and apply it",[26,947,948,951],{},[30,949,950],{},"Import .css"," — load a built-in preset or a saved theme",[26,953,954,957],{},[30,955,956],{},"Reset"," — return to SoundNinja defaults",[14,959,960],{},"If you close the window with unsaved changes, SoundNinja asks you to save first.",[18,962,964],{"id":963},"without-the-full-editor","Without the full editor",[14,966,967,968,970],{},"In ",[30,969,755],{}," you can still:",[106,972,973,976,982],{},[26,974,975],{},"Pick a theme from the list",[26,977,978,979,895],{},"Edit CSS variables live (",[30,980,981],{},"Custom CSS",[26,983,984],{},"Import a theme file into the Themes folder",{"title":228,"searchDepth":229,"depth":229,"links":986},[987,988,989,990],{"id":879,"depth":229,"text":880},{"id":912,"depth":229,"text":913},{"id":930,"depth":229,"text":931},{"id":963,"depth":229,"text":964},"Design colors, fonts, buttons, and tabs in the Theme Creator.",{},5,"\u002Ftheme-editor",{"title":865,"description":991},"zpMjxENa49aUipEX7TBxcqrbaZNweyJ019KsLAMJeoc",{"id":998,"title":999,"body":1000,"description":1133,"extension":237,"meta":1134,"navigation":239,"order":1135,"path":1136,"seo":1137,"stem":1004,"__hash__":1138},"content_en\u002Frecording-editor.md","Recording Editor",{"type":7,"value":1001,"toc":1127},[1002,1005,1011,1015,1021,1041,1044,1048,1073,1077,1092,1096,1110,1117],[10,1003,999],{"id":1004},"recording-editor",[14,1006,1007,1008,1010],{},"Record a clip inside SoundNinja, trim it, then import it onto a tab. Open the editor with the ",[30,1009,644],{}," button in the player bar.",[18,1012,1014],{"id":1013},"choose-an-input","Choose an input",[14,1016,967,1017,1020],{},[30,1018,1019],{},"Settings → Audio",":",[106,1022,1023,1029,1035],{},[26,1024,1025,1028],{},[30,1026,1027],{},"Input Devices"," — microphone",[26,1030,1031,1034],{},[30,1032,1033],{},"Output Devices (PC Audio)"," — loopback of what your PC is playing",[26,1036,1037,1040],{},[30,1038,1039],{},"Input volume"," — capture gain from 0% to 200%",[14,1042,1043],{},"The Record button uses the device you pick here.",[18,1045,1047],{"id":1046},"edit-the-take","Edit the take",[106,1049,1050,1053,1056,1064,1067,1070],{},[26,1051,1052],{},"Record and stop",[26,1054,1055],{},"Watch the input level meter",[26,1057,1058,395,1061],{},[30,1059,1060],{},"Normalize",[30,1062,1063],{},"Noise Cancelation",[26,1065,1066],{},"Trim the whole clip, trim to a selection, or delete a selection",[26,1068,1069],{},"Undo \u002F redo",[26,1071,1072],{},"Zoom in and out",[18,1074,1076],{"id":1075},"stage-and-import","Stage and import",[23,1078,1079,1082,1085],{},[26,1080,1081],{},"Add the selection or the full track to the staging list.",[26,1083,1084],{},"The list starts empty: record, edit, then add a clip.",[26,1086,1087,395,1089,1091],{},[30,1088,648],{},[30,1090,651],{}," into the current tab or a tab you choose.",[18,1093,1095],{"id":1094},"stem-separation-optional","Stem separation (optional)",[14,1097,1098,1099,395,1102,1105,1106,1109],{},"The Record Editor can keep ",[30,1100,1101],{},"vocals",[30,1103,1104],{},"music"," using BS-RoFormer. The model is about 158 MB and is ",[30,1107,1108],{},"not"," bundled with the app.",[14,1111,1112,1113,1116],{},"Download it from ",[30,1114,1115],{},"Settings → Stem Separation",", or accept the first-run prompt. The Windows installer can also offer to download the model on first launch.",[14,1118,1119,1120,150,1123,1126],{},"Stem builds from source need an extra flag (",[44,1121,1122],{},"tauri:serve:stems",[44,1124,1125],{},"tauri:build:stems",").",{"title":228,"searchDepth":229,"depth":229,"links":1128},[1129,1130,1131,1132],{"id":1013,"depth":229,"text":1014},{"id":1046,"depth":229,"text":1047},{"id":1075,"depth":229,"text":1076},{"id":1094,"depth":229,"text":1095},"Capture mic or PC audio, edit the clip, and drop it on your board.",{},6,"\u002Frecording-editor",{"title":999,"desc