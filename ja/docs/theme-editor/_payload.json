[{"data":1,"prerenderedAt":1293},["ShallowReactive",2],{"docs-page-ja-\u002Ftheme-editor":3,"docs-nav-ja":150},{"id":4,"title":5,"body":6,"description":141,"extension":142,"meta":143,"navigation":144,"order":145,"path":146,"seo":147,"stem":148,"__hash__":149},"content_ja\u002Ftheme-editor.md","テーマエディター",{"type":7,"value":8,"toc":133},"minimark",[9,12,21,26,57,60,63,78,81,107,110,113,119],[10,11,5],"h1",{"id":5},[13,14,15,16,20],"p",{},"Theme Creatorは、ボードの完全なビジュアルエディターです。",[17,18,19],"strong",{},"設定 → メイン → Theme Creator"," から開きます。",[22,23,25],"h2",{"id":24},"_3つのタブ","3つのタブ",[27,28,29,45,51],"ol",{},[30,31,32,35,36,40,41,44],"li",{},[17,33,34],{},"一般"," — テーマ名、共有色、フォントのアップロード（",[37,38,39],"code",{},".ttf"," \u002F ",[37,42,43],{},".otf","）",[30,46,47,50],{},[17,48,49],{},"ボタン"," — サウンドボタンの色、書体、レイアウト、GIFオーバーレイ",[30,52,53,56],{},[17,54,55],{},"タブ"," — タブバーの色、書体、枠線の太さ",[13,58,59],{},"編集中、ライブプレビューがタブとボタンを表示します。",[22,61,62],{"id":62},"変更できる項目",[64,65,66,69,72,75],"ul",{},[30,67,68],{},"プライマリとアクセントの色、背景、ボタン色、タブ色",[30,70,71],{},"ボタンとタブのフォントファミリーとサイズ",[30,73,74],{},"ボタンの幅、半径、枠線幅、隙間、パディング",[30,76,77],{},"GIFオーバーレイの不透明度（通常とホバー）",[22,79,80],{"id":80},"保存と共有",[64,82,83,89,95,101],{},[30,84,85,88],{},[17,86,87],{},".cssをエクスポート"," — バックアップや友人への送信用テーマファイルを書き出す",[30,90,91,94],{},[17,92,93],{},"テーマに追加"," — Themesフォルダに保存して適用",[30,96,97,100],{},[17,98,99],{},".cssをインポート"," — 組み込みプリセットまたは保存済みテーマを読み込む",[30,102,103,106],{},[17,104,105],{},"リセット"," — SoundNinjaのデフォルトに戻す",[13,108,109],{},"未保存の変更があるままウィンドウを閉じると、SoundNinjaが先に保存を求めます。",[22,111,112],{"id":112},"フルエディターなしで",[13,114,115,118],{},[17,116,117],{},"設定 → メイン"," でも次が可能です：",[64,120,121,124,130],{},[30,122,123],{},"リストからテーマを選ぶ",[30,125,126,127,44],{},"CSS変数をライブ編集する（",[17,128,129],{},"カスタムCSS",[30,131,132],{},"テーマファイルをThemesフォルダにインポートする",{"title":134,"searchDepth":135,"depth":135,"links":136},"",2,[137,138,139,140],{"id":24,"depth":135,"text":25},{"id":62,"depth":135,"text":62},{"id":80,"depth":135,"text":80},{"id":112,"depth":135,"text":112},"Theme Creatorで色、フォント、ボタン、タブをデザイン。","md",{},true,5,"\u002Ftheme-editor",{"title":5,"description":141},"theme-editor","tGeQE8HatAeqLeJ_3U4A-ac0RfIRzcoq-KghedjPolg",[151,267,463,604,748,837,973,1198],{"id":152,"title":153,"body":154,"description":260,"extension":142,"meta":261,"navigation":144,"order":262,"path":263,"seo":264,"stem":265,"__hash__":266},"content_ja\u002Foverview.md","概要",{"type":7,"value":155,"toc":254},[156,158,161,164,167,170,184,187,218,221,231,234],[10,157,153],{"id":153},[13,159,160],{},"SoundNinjaは、ライブ配信、友だちとのチャット、ポッドキャスト収録向けのオープンソースサウンドボードです。Tauri v2とNuxt 4で構築されており、RAMとディスクの負荷を抑えています。",[13,162,163],{},"目標はシンプルです。巨大なサウンドライブラリをすばやく眺め、目的のクリップをミリ秒で再生すること。UIはVRのダッシュボードとしても使いやすいです。",[13,165,166],{},"SoundNinjaはまだ初期開発段階です。機能は動きますが、すべてのプラットフォームで完全に検証されているわけではありません。",[22,168,169],{"id":169},"対象ユーザー",[64,171,172,175,178,181],{},[30,173,174],{},"即時のサウンドキューが必要な配信者",[30,176,177],{},"ボイスチャット用の共有ボードが欲しい友だち",[30,179,180],{},"クリップを録ってボードに置くポッドキャスター",[30,182,183],{},"カスタマイズ可能な、ローカル優先のサウンドボードが欲しい人",[22,185,186],{"id":186},"できること",[64,188,189,192,195,198,201,204,212,215],{},[30,190,191],{},"自分の音声ファイルからサウンドボードを作る",[30,193,194],{},"色付きタブ、グループ、検索で整理する",[30,196,197],{},"Theme Creatorで見た目をデザインする",[30,199,200],{},"Record EditorでPCオーディオまたはマイクを録音する",[30,202,203],{},"個別のサウンドにホットキーを割り当てる",[30,205,206,211],{},[207,208,210],"a",{"href":209},"\u002Fdocs\u002Fremote-control","Bitfocus Companion","からサウンドをトリガーする",[30,213,214],{},"サウンドボード全体をインポート／エクスポートして共有する",[30,216,217],{},"サウンドボタンにGIFや画像を使う",[22,219,220],{"id":220},"ライセンス",[13,222,223,224,230],{},"SoundNinjaは",[207,225,229],{"href":226,"rel":227},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fblob\u002Fmain\u002FLICENSE",[228],"nofollow","GPL-3.0","のフリーソフトウェアです。フォーク、改変、共有できます。",[22,232,233],{"id":233},"次のステップ",[27,235,236,242,248],{},[30,237,238],{},[207,239,241],{"href":240},"\u002Fdocs\u002Finstallation","SoundNinjaをインストール",[30,243,244],{},[207,245,247],{"href":246},"\u002Fdocs\u002Fadding-sounds","サウンドを追加",[30,249,250],{},[207,251,253],{"href":252},"\u002Fdocs\u002Forganizing-sounds","ボードを整理",{"title":134,"searchDepth":135,"depth":135,"links":255},[256,257,258,259],{"id":169,"depth":135,"text":169},{"id":186,"depth":135,"text":186},{"id":220,"depth":135,"text":220},{"id":233,"depth":135,"text":233},"SoundNinjaとは何か、何ができるか。",{},1,"\u002Foverview",{"title":153,"description":260},"overview","KJDpLdg7ixvHWAtVFjPRaSTU7NMWgwE__i0PB3mQH3E",{"id":268,"title":269,"body":270,"description":457,"extension":142,"meta":458,"navigation":144,"order":135,"path":459,"seo":460,"stem":461,"__hash__":462},"content_ja\u002Finstallation.md","インストール",{"type":7,"value":271,"toc":450},[272,274,287,291,309,312,316,330,333,337,361,372,375,382,385,400,430,446],[10,273,269],{"id":269},[13,275,276,280,281,286],{},[207,277,279],{"href":278},"\u002Fdownload","ダウンロードページ","または",[207,282,285],{"href":283,"rel":284},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Freleases\u002Flatest",[228],"GitHub Releases","からビルドを入手してください。SoundNinjaは初期開発中なので、ビルドはベータとして扱ってください。",[22,288,290],{"id":289},"windows","Windows",[64,292,293,303,306],{},[30,294,295,296,299,300],{},"64ビットWindows向けの",[17,297,298],{},"インストーラー (.exe)"," または ",[17,301,302],{},"MSI (.msi)",[30,304,305],{},"ランディングページの対象：Windows 10以降",[30,307,308],{},"アプリのREADMEはWindows 8以上も記載",[13,310,311],{},"インストーラーを実行し、スタートメニューからSoundNinjaを起動します。",[22,313,315],{"id":314},"macos","macOS",[64,317,318,324,327],{},[30,319,320,321],{},"Apple SiliconとIntel向けの",[17,322,323],{},"ユニバーサル .dmg",[30,325,326],{},"ランディングページの対象：macOS 10.14以降",[30,328,329],{},"アプリのREADMEはmacOS 10.15以上を記載",[13,331,332],{},"ディスクイメージを開き、SoundNinjaをアプリケーションにドラッグします。",[22,334,336],{"id":335},"linux","Linux",[64,338,339,345,351,358],{},[30,340,341,342],{},"Ubuntu \u002F Debian向けの",[17,343,344],{},"Debian (.deb)",[30,346,347,348],{},"その他のディストリ向けの",[17,349,350],{},"AppImage",[30,352,353,354,357],{},"リリース公開後、ArchユーザーはAURから",[37,355,356],{},"soundninja-bin","をインストールできます",[