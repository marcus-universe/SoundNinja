var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html.dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}",{"title":134,"searchDepth":135,"depth":135,"links":451},[452,453,454,455,456],{"id":289,"depth":135,"text":290},{"id":314,"depth":135,"text":315},{"id":335,"depth":135,"text":336},{"id":374,"depth":135,"text":374},{"id":384,"depth":135,"text":384},"Windows、macOS、LinuxにSoundNinjaをインストール。",{},"\u002Finstallation",{"title":269,"description":457},"installation","PtsEiD1MtLz3wDVCCGAWac0JxyBztTW1uRBbWQWqSOs",{"id":464,"title":465,"body":466,"description":597,"extension":142,"meta":598,"navigation":144,"order":599,"path":600,"seo":601,"stem":602,"__hash__":603},"content_ja\u002Fadding-sounds.md","サウンドの追加",{"type":7,"value":467,"toc":589},[468,470,473,476,494,497,528,531,550,553,567,570,573,580,583],[10,469,465],{"id":465},[13,471,472],{},"クリップを追加するまで、ボードは空です。SoundNinjaはファイル、フォルダ全体、録音、共有サウンドボードパックをインポートできます。",[22,474,475],{"id":475},"音声ファイルをインポート",[27,477,478,488,491],{},[30,479,480,483,484,487],{},[17,481,482],{},"ファイル → 音声ファイルをインポート","、またはナビバーの ",[17,485,486],{},"インポート"," を使います。",[30,489,490],{},"1つ以上の音声ファイルを選びます。",[30,492,493],{},"サウンドは現在のタブに入ります。",[22,495,496],{"id":496},"フォルダをインポート",[27,498,499,508,511],{},[30,500,501,504,505,507],{},[17,502,503],{},"ファイル → フォルダをインポート","（またはナビバーの ",[17,506,496],{},"）。",[30,509,510],{},"1つ以上のフォルダを追加。インポート前にドラッグで並べ替えできます。",[30,512,513,514],{},"配置方法を選びます：\n",[64,515,516,522],{},[30,517,518,521],{},[17,519,520],{},"タブとしてインポート"," — 各フォルダが独自のタブになる",[30,523,524,527],{},[17,525,526],{},"現在のタブにインポート"," — すべてのファイルがアクティブなタブに入る",[22,529,530],{"id":530},"クリップを録音",[13,532,533,534,537,538,542,543,299,546,549],{},"プレイヤーバーの ",[17,535,536],{},"録音"," ボタンから",[207,539,541],{"href":540},"\u002Fdocs\u002Frecording-editor","Record Editor","を開きます。キャプチャ、トリムし、",[17,544,545],{},"選択をインポート",[17,547,548],{},"すべてインポート"," で現在のタブまたは選んだタブに入れます。",[22,551,552],{"id":552},"サウンドボードをインポート",[13,554,555,558,559,562,563,566],{},[17,556,557],{},"ファイル → サウンドボードをインポート"," で共有パックを読み込みます。パックは ",[37,560,561],{},"project.sninja"," とサウンドファイルを含む ",[37,564,565],{},".zip"," です。インポート後、プロジェクトを開いて再生します。",[13,568,569],{},"複数のプロジェクト（プロファイル）も保てます。プロジェクトセレクターでボードを切り替えます。",[22,571,572],{"id":572},"見つからないファイルを再リンク",[13,574,575,576,579],{},"ディスク上で音声ファイルが移動すると、SoundNinjaは ",[17,577,578],{},"見つからないサウンドファイル"," ダイアログを表示します。検索するフォルダを選び、クリップを再リンクします。",[22,581,582],{"id":582},"次へ",[13,584,585,586,445],{},"タブ、グループ、ホットキーの整理は",[207,587,588],{"href":252},"サウンドの整理",{"title":134,"searchDepth":135,"depth":135,"links":590},[591,592,593,594,595,596],{"id":475,"depth":135,"text":475},{"id":496,"depth":135,"text":496},{"id":530,"depth":135,"text":530},{"id":552,"depth":135,"text":552},{"id":572,"depth":135,"text":572},{"id":582,"depth":135,"text":582},"音声、フォルダ、録音、共有サウンドボードをインポート。",{},3,"\u002Fadding-sounds",{"title":465,"description":597},"adding-sounds","Fa08TvxAivFfa2zc5Ab8J5x_IO2j6rzWXGssNBY_HnY",{"id":605,"title":588,"body":606,"description":741,"extension":142,"meta":742,"navigation":144,"order":743,"path":744,"seo":745,"stem":746,"__hash__":747},"content_ja\u002Forganizing-sounds.md",{"type":7,"value":607,"toc":732},[608,610,613,615,640,646,649,652,666,673,676,682,685,695,698,701,705,708,714,720,724],[10,609,588],{"id":588},[13,611,612],{},"SoundNinjaは大規模ライブラリ向けです。タブ、グループ、検索、ホットキーで、必要なクリップをワンクリック（またはワンキー）で出せます。",[22,614,55],{"id":55},[64,616,617,623,629],{},[30,618,619,622],{},[17,620,621],{},"タブを追加"," でタブを作り、色を付けてバーをすばやく眺められます。",[30,624,625,628],{},[17,626,627],{},"すべて"," ビューはタブを横断して全サウンドを表示します。",[30,630,631,632,635,636,639],{},"サウンドは ",[17,633,634],{},"1つ以上のタブ"," に所属できます。サウンドを右クリックし、",[17,637,638],{},"タブへ移動"," で割り当てます。",[13,641,642,643,645],{},"タブの切り替え演出は ",[17,644,117],{},"：スライド、フェード、ボタンを1つずつ、またはなし。",[22,647,648],{"id":648},"グループ",[13,650,651],{},"v0.5.3以降、セパレーターを名前付きグループにできます：",[64,653,654,657,660,663],{},[30,655,656],{},"コンテキストメニューからグループの追加、名前変更、削除",[30,658,659],{},"グループヘッダーをドラッグ — 子も一緒に動く",[30,661,662],{},"グループにサウンドを入れたり出したり",[30,664,665],{},"グループの枠線色、名前の色、ボタン配置を設定（またはタブのデフォルトを使う）",[13,667,668,669,672],{},"見た目の区切りだけなら、通常の ",[17,670,671],{},"セパレーター"," も追加できます。",[22,674,675],{"id":675},"検索",[13,677,678,679,681],{},"ナビバーの ",[17,680,675],{}," フィールドを使います。入力に合わせて結果が更新されます。",[22,683,684],{"id":684},"並べ替え",[13,686,687,690,691,694],{},[17,688,689],{},"設定 → 動作"," でドラッグ＆ドロップをオンにします（",[17,692,693],{},"並べ替えを許可","）。その後、サウンドとグループをドラッグして配置します。",[22,696,697],{"id":697},"一括編集",[13,699,700],{},"複数のサウンドを選び、色の変更、タブへの移動、削除を一度に行えます。",[22,702,704],{"id":703},"ホットキーとサウンドid","ホットキーとサウンドID",[13,706,707],{},"すべてのサウンドには8文字のIDがあります。ボタンのコンテキストメニュー、または複数選択のIDチップからコピーします。",[13,709,710,713],{},[17,711,712],{},"設定 → ホットキー"," を開き、キーをサウンドIDに割り当てます。グローバルホットキーは任意です。",[13,715,716,717,719],{},"同じIDを",[207,718,210],{"href":209},"がクリップのトリガーに使います。",[22,721,723],{"id":722},"gifと色","GIFと色",[13,725,726,727,731],{},"サウンドを右クリックして、ボタンごとの色やGIF \u002F 画像背景を設定します。ボード全体を整える",[207,728,730],{"href":729},"\u002Fdocs\u002Ftheme-editor","Theme Creator","とは別です。",{"title":134,"searchDepth":135,"depth":135,"links":733},[734,735,736,737,738,739,740],{"id":55,"depth":135,"text":55},{"id":648,"depth":135,"text":648},{"id":675,"depth":135,"text":675},{"id":684,"depth":135,"text":684},{"id":697,"depth":135,"text":697},{"id":703,"depth":135,"text":704},{"id":722,"depth":135,"text":723},"タブ、グループ、検索、一括編集、ホットキー。",{},4,"\u002Forganizing-sounds",{"title":588,"description":741},"organizing-sounds","0mH24BvA7-1dcjELHB8mQnjaQMzT8Ie60aamXtNUZEE",{"id":4,"title":5,"body":749,"description":141,"extension":142,"meta":835,"navigation":144,"order":145,"path":146,"seo":836,"stem":148,"__hash__":149},{"type":7,"value":750,"toc":829},[751,753,757,759,777,779,781,791,793,811,813,815,819],[10,752,5],{"id":5},[13,754,15,755,20],{},[17,756,19],{},[22,758,25],{"id":24},[27,760,761,769,773],{},[30,762,763,35,765,40,767,44],{},[17,764,34],{},[37,766,39],{},[37,768,43],{},[30,770,771,50],{},[17,772,49],{},[30,774,775,56],{},[17,776,55],{},[13,778,59],{},[22,780,62],{"id":62},[64,782,783,785,787,789],{},[30,784,68],{},[30,786,71],{},[30,788,74],{},[30,790,77],{},[22,792,80],{"id":80},[64,794,795,799,803,807],{},[30,796,797,88],{},[17,798,87],{},[30,800,801,94],{},[17,802,93],{},[30,804,805,100],{},[17,806,99],{},[30,808,809,106],{},[17,810,105],{},[13,812,109],{},[22,814,112],{"id":112},[13,816,817,118],{},[17,818,117],{},[64,820,821,823,827],{},[30,822,123],{},[30,824,126,825,44],{},[17,826,129],{},[30,828,132],{},{"title":134,"searchDepth":135,"depth":135,"links":830},[831,832,833,834],{"id":24,"depth":135,"text":25},{"id":62,"depth":135,"text":62},{"id":80,"depth":135,"text":80},{"id":112,"depth":135,"text":112},{},{"title":5,"description":141},{"id":838,"title":839,"body":840,"description":966,"extension":142,"meta":967,"navigation":144,"order":968,"path":969,"seo":970,"stem":971,"__hash__":972},"content_ja\u002Frecording-editor.md","録音エディター",{"type":7,"value":841,"toc":960},[842,844,850,853,859,879,882,885,910,913,928,932,945,951],[10,843,839],{"id":839},[13,845,846,847,849],{},"SoundNinja内でクリップを録音し、トリムしてタブにインポートします。プレイヤーバーの ",[17,848,536],{}," ボタンでエディターを開きます。",[22,851,852],{"id":852},"入力を選ぶ",[13,854,855,858],{},[17,856,857],{},"設定 → オーディオ"," で：",[64,860,861,867,873],{},[30,862,863,866],{},[17,864,865],{},"入力デバイス"," — マイク",[30,868,869,872],{},[17,870,871],{},"出力デバイス（PCオーディオ）"," — PCが再生している音のループバック",[30,874,875,878],{},[17,876,877],{},"入力音量"," — キャプチャゲイン 0%〜200%",[13,880,881],{},"録音ボタンは、ここで選んだデバイスを使います。",[22,883,884],{"id":884},"テイクを編集",[64,886,887,890,893,901,904,907],{},[30,888,889],{},"録音と停止",[30,891,892],{},"入力レベルメーターを確認",[30,894,895,299,898],{},[17,896,897],{},"ノーマライズ",[17,899,900],{},"ノイズキャンセレーション",[30,902,903],{},"クリップ全体のトリム、選択範囲へのトリム、選択の削除",[30,905,906],{},"元に戻す \u002F やり直し",[30,908,909],{},"ズームインとズームアウト",[22,911,912],{"id":912},"ステージしてインポート",[27,914,915,918,921],{},[30,916,917],{},"選択範囲またはトラック全体をステージングリストに追加します。",[30,919,920],{},"リストは空から始まります。録音、編集、それからクリップを追加。",[30,922,923,299,925,927],{},[17,924,545],{},[17,926,548],{}," で、現在のタブまたは選んだタブに入れます。",[22,929,931],{"id":930},"ステム分離任意","ステム分離（任意）",[13,933,934,935,299,938,941,942,445],{},"Record EditorはBS-RoFormerで ",[17,936,937],{},"ボーカル",[17,939,940],{},"音楽"," を残せます。モデルは約158 MBで、アプリには ",[17,943,944],{},"同梱されていません",[13,946,947,950],{},[17,948,949],{},"設定 → ステム分離"," からダウンロードするか、初回起動のプロンプトを承認します。Windowsインストーラーも初回起動時にモデルのダウンロードを案内できます。",[13,952,953,954,40,957,507],{},"ソースからのステムビルドには追加フラグが必要です（",[37,955,956],{},"tauri:serve:stems",[37,958,959],{},"tauri:build:stems",{"title":134,"searchDepth":135,"depth":135,"links":961},[962,963,964,965],{"id":852,"depth":135,"text":852},{"id":884,"depth":135,"text":884},{"id":912,"depth":135,"text":912},{"id":930,"depth":135,"text":931},"マイクまたはPCオーディオを取り込み、クリップを編集してボードに置く。",{},6,"\u002Frecording-editor",{"title":839,"description":966},"recording-editor","fkw2G1vYZhqRZ8t2Y9irOID6H-BdjzVV8fvv-hE_qbo",{"id":974,"title":975,"body":976,"description":1191,"extension":142,"meta":1192,"navigation":144,"order":1193,"path":1194,"seo":1195,"stem":1196,"__hash__":1197},"content_ja\u002Fremote-control.md","リモートコントロール",{"type":7,"value":977,"toc":1184},[978,980,983,986,1018,1021,1024,1062,1065,1085,1088,1091,1123,1127,1133],[10,979,975],{"id":975},[13,981,982],{},"SoundNinjaはローカルネットワークで待ち受け、Bitfocus Companion（または任意のHTTP\u002FWebSocketクライアント）がサウンドを再生・停止できます。",[22,984,985],{"id":985},"リモートサーバーを有効化",[27,987,988,994,1001,1008],{},[30,989,990,993],{},[17,991,992],{},"設定 → リモート"," を開きます。",[30,995,996,997,1000],{},"リモートサーバーを有効にします。デフォルトポートは ",[17,998,999],{},"7331"," です。",[30,1002,1003,1004,1007],{},"任意：トークンを設定。クライアントはBearerトークンまたは ",[37,1005,1006],{},"?token="," で送ります。",[30,1009,1010,1013,1014,1017],{},[37,1011,1012],{},"http:\u002F\u002FIP:PORT"," URLをコピーするか、",[17,1015,1016],{},"設定 → 情報"," からシステムIPをコピーします。",[13,1019,1020],{},"Windowsはサーバー初回起動時にファイアウォールの確認を出すことがあります。プライベートネットワークのアクセスを許可してください。",[22,1022,210],{"id":1023},"bitfocus-companion",[27,1025,1026,1033,1042,1049,1056],{},[30,1027,1028,1032],{},[207,1029,210],{"href":1030,"rel":1031},"https:\u002F\u002Fbitfocus.io\u002Fcompanion",[228],"をインストールします。",[30,1034,1035,1036,1041],{},"公式フォルダからSoundNinjaモジュールをダウンロード：",[207,1037,1040],{"href":1038,"rel":1039},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Ftree\u002Fmain\u002Fcompanion-module-soundninja",[228],"companion-module-soundninja","。Companion Storeのパッケージはまだありません — このフォルダがダウンロードです。",[30,1043,1044,1045,1048],{},"Companionで ",[17,1046,1047],{},"Developer → Modules"," を開くか、フォルダをCompanionのカスタムモジュールパスに置きます。",[30,1050,1051,1052,1055],{},"モジュールフォルダで ",[37,1053,1054],{},"npm install"," を実行します。",[30,1057,1058,1061],{},[17,1059,1060],{},"Sound Ninja"," 接続を追加。PCのIP、ポート、設定したトークンを貼り付けます。",[22,1063,1064],{"id":1064},"アクション",[64,1066,1067,1073,1079],{},[30,1068,1069,1072],{},[17,1070,1071],{},"Trigger Sound"," — ライブドロップダウンから選ぶか、8文字のサウンドIDを入力（Companion変数が使えます）",[30,1074,1075,1078],{},[17,1076,1077],{},"Stop Sound"," — IDで再生中のサウンドを1つ停止",[30,1080,1081,1084],{},[17,1082,1083],{},"Stop All"," — 再生中の全サウンドを停止",[13,1086,1087],{},"SoundNinjaでは、ボタンのコンテキストメニューまたは複数選択のIDチップからサウンドIDをコピーします。",[22,1089,1090],{"id":1090},"フィードバックと変数",[64,1092,1093,1099,1111,1117],{},[30,1094,1095,1098],{},[17,1096,1097],{},"Sound Playing"," — そのサウンドIDがアクティブな間はtrue（ボタン色に使う）",[30,1100,1101,1104,1105,40,1108],{},[37,1102,1103],{},"$(soundninja:connected)"," — ",[37,1106,1107],{},"true",[37,1109,1110],{},"false",[30,1112,1113,1116],{},[37,1114,1115],{},"$(soundninja:playing_count)"," — 再生中のサウンド数",[30,1118,1119,1122],{},[37,1120,1121],{},"$(soundninja:last_triggered)"," — 最後にトリガーしたサウンドID",[22,1124,1126],{"id":1125},"http-api上級","HTTP API（上級）",[13,1128,1129,1130],{},"ベースパス：",[37,1131,1132],{},"\u002Fapi\u002Fv1",[64,1134,1135,1141,1147,1153,1163,1169,1178],{},[30,1136,1137,1140],{},[37,1138,1139],{},"GET \u002Finfo"," — アプリ名、バージョン、プロトコル、トークンが必要か",[30,1142,1143,1146],{},[37,1144,1145],{},"GET \u002Fsounds"," — サウンド一覧（id、name、tabs、active）",[30,1148,1149,1152],{},[37,1150,1151],{},"GET \u002Fstate"," — サウンドと現在再生中のID",[30,1154,1155,1158,1159,1162],{},[37,1156,1157],{},"POST \u002Ftrigger"," に ",[37,1160,1161],{},"{ \"id\" }"," — サウンドを再生",[30,1164,1165,1168],{},[37,1166,1167],{},"GET \u002Ftrigger\u002F:id"," — 再生（ブラウザで簡単にテスト）",[30,1170,1171,1174,1175,1177],{},[37,1172,1173],{},"POST \u002Fstop"," に任意の ",[37,1176,1161],{}," — 1つまたはすべて停止",[30,1179,1180,1183],{},[37,1181,1182],{},"GET \u002Fws"," — ライブ状態。trigger\u002Fstopコマンドを受信",{"title":134,"searchDepth":135,"depth":135,"links":1185},[1186,1187,1188,1189,1190],{"id":985,"depth":135,"text":985},{"id":1023,"depth":135,"text":210},{"id":1064,"depth":135,"text":1064},{"id":1090,"depth":135,"text":1090},{"id":1125,"depth":135,"text":1126},"ローカルネットワーク経由でBitfocus CompanionからSoundNinjaを操作。",{},7,"\u002Fremote-control",{"title":975,"description":1191},"remote-control","zONoY2nsMS914utdiT4H8vCiez_Sndn4qxbRAolwtHw",{"id":1199,"title":1200,"body":1201,"description":1286,"extension":142,"meta":1287,"navigation":144,"order":1288,"path":1289,"seo":1290,"stem":1291,"__hash__":1292},"content_ja\u002Fsupport.md","サポート",{"type":7,"value":1202,"toc":1279},[1203,1205,1208,1211,1214,1221,1229,1232,1239,1241,1254,1257,1269,1272],[10,1204,1200],{"id":1200},[13,1206,1207],{},"SoundNinjaは初期ベータのコミュニティプロジェクトです。いちばん早い助けはGitHubです。",[22,1209,1210],{"id":1210},"バグ報告または質問",[13,1212,1213],{},"GitHubでissueを開いてください：",[13,1215,1216],{},[207,1217,1220],{"href":1218,"rel":1219},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fissues",[228],"github.com\u002Fmarcus-universe\u002FSoundNinja\u002Fissues",[13,1222,1223,1224,299,1226,1228],{},"OS、SoundNinjaのバージョン（",[17,1225,380],{},[17,1227,1016],{},"）、再現手順を書いてください。",[22,1230,1231],{"id":1231},"メール",[13,1233,1234,1235],{},"メンテナー連絡先：",[207,1236,1238],{"href":1237},"mailto:contact@marcus-universe.de","contact@marcus-universe.de",[22,1240,374],{"id":374},[13,1242,377,1243,1245,1246,1248,1249,1253],{},[17,1244,380],{}," を使います。新しいビルドは",[207,1247,279],{"href":278},"と",[207,1250,285],{"href":1251,"rel":1252},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Freleases",[228],"にも出ます。",[22,1255,1256],{"id":1256},"コントリビュート",[13,1258,1259,1260,1264,1265,1268],{},"プルリクエストを歓迎します。アプリのリポジトリは",[207,1261,1263],{"href":390,"rel":1262},[228],"github.com\u002Fmarcus-universe\u002FSoundNinja","です。プロジェクトは",[207,1266,229],{"href":226,"rel":1267},[228],"ライセンスです。",[22,1270,1271],{"id":1271},"法的情報",[13,1273,1274,1275,445],{},"インプリントと連絡先：",[207,1276,1278],{"href":1277},"\u002Fimpressum","インプリント",{"title":134,"searchDepth":135,"depth":135,"links":1280},[1281,1282,1283,1284,1285],{"id":1210,"depth":135,"text":1210},{"id":1231,"depth":135,"text":1231},{"id":374,"depth":135,"text":374},{"id":1256,"depth":135,"text":1256},{"id":1271,"depth":135,"text":1271},"ヘルプの入手先とバグ報告。",{},8,"\u002Fsupport",{"title":1200,"description":1286},"support","T2BdU-sWENDKBxowzv9wjeevj1bEK3iit1IGD77Vz_M",1788110440649]