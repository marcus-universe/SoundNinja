"）。",[30,521,522],{},"1つ以上のフォルダを追加。インポート前にドラッグで並べ替えできます。",[30,524,525,526],{},"配置方法を選びます：\n",[64,527,528,534],{},[30,529,530,533],{},[17,531,532],{},"タブとしてインポート"," — 各フォルダが独自のタブになる",[30,535,536,539],{},[17,537,538],{},"現在のタブにインポート"," — すべてのファイルがアクティブなタブに入る",[22,541,542],{"id":542},"クリップを録音",[13,544,545,546,549,550,554,555,308,558,561],{},"プレイヤーバーの ",[17,547,548],{},"録音"," ボタンから",[216,551,553],{"href":552},"\u002Fdocs\u002Frecording-editor","Record Editor","を開きます。キャプチャ、トリムし、",[17,556,557],{},"選択をインポート",[17,559,560],{},"すべてインポート"," で現在のタブまたは選んだタブに入れます。",[22,563,564],{"id":564},"サウンドボードをインポート",[13,566,567,570,571,574,575,578],{},[17,568,569],{},"ファイル → サウンドボードをインポート"," で共有パックを読み込みます。パックは ",[37,572,573],{},"project.sninja"," とサウンドファイルを含む ",[37,576,577],{},".zip"," です。インポート後、プロジェクトを開いて再生します。",[13,580,581],{},"複数のプロジェクト（プロファイル）も保てます。プロジェクトセレクターでボードを切り替えます。",[22,583,584],{"id":584},"見つからないファイルを再リンク",[13,586,587,588,591],{},"ディスク上で音声ファイルが移動すると、SoundNinjaは ",[17,589,590],{},"見つからないサウンドファイル"," ダイアログを表示します。検索するフォルダを選び、クリップを再リンクします。",[22,593,594],{"id":594},"次へ",[13,596,597,598,457],{},"タブ、タグ、フィルター、ホットキーの整理は",[216,599,600],{"href":261},"サウンドの整理",{"title":134,"searchDepth":135,"depth":135,"links":602},[603,604,605,606,607,608],{"id":487,"depth":135,"text":487},{"id":508,"depth":135,"text":508},{"id":542,"depth":135,"text":542},{"id":564,"depth":135,"text":564},{"id":584,"depth":135,"text":584},{"id":594,"depth":135,"text":594},"音声、フォルダ、録音、共有サウンドボードをインポート。",{},3,"\u002Fadding-sounds",{"title":477,"description":609},"adding-sounds","5_cjd2COcPz0pj4ZrBehCZv6ouzBimE8UGjkcfngQjw",{"id":617,"title":600,"body":618,"description":998,"extension":142,"meta":999,"navigation":144,"order":1000,"path":1001,"seo":1002,"stem":1003,"__hash__":1004},"content_ja\u002Forganizing-sounds.md",{"type":7,"value":619,"toc":983},[620,622,629,631,656,662,665,668,682,689,695,699,709,713,743,746,752,755,789,796,800,803,829,832,836,849,852,857,878,894,901,904,915,918,922,929,939,945,948,956,963,980],[10,621,600],{"id":600},[13,623,624,625,628],{},"SoundNinjaは大規模ライブラリ向けです。",[17,626,627],{},"タグとフィルター","、タブ、検索、複数選択、ホットキーで、必要なクリップをワンクリック（またはワンキー）で出せます。",[22,630,55],{"id":55},[64,632,633,639,645],{},[30,634,635,638],{},[17,636,637],{},"タブを追加"," でタブを作り、色を付けてバーをすばやく眺められます。",[30,640,641,644],{},[17,642,643],{},"すべて"," ビューはタブを横断して全サウンドを表示します。",[30,646,647,648,651,652,655],{},"サウンドは ",[17,649,650],{},"1つ以上のタブ"," に所属できます。サウンドを右クリックし、",[17,653,654],{},"タブへ移動"," で割り当てます。",[13,657,658,659,661],{},"タブの切り替え演出は ",[17,660,117],{},"：スライド、フェード、ボタンを1つずつ、またはなし。",[22,663,664],{"id":664},"グループ",[13,666,667],{},"v0.5.3以降、セパレーターを名前付きグループにできます：",[64,669,670,673,676,679],{},[30,671,672],{},"コンテキストメニューからグループの追加、名前変更、削除",[30,674,675],{},"グループヘッダーをドラッグ — 子も一緒に動く",[30,677,678],{},"グループにサウンドを入れたり出したり",[30,680,681],{},"グループの枠線色、名前の色、ボタン配置を設定（またはタブのデフォルトを使う）",[13,683,684,685,688],{},"見た目の区切りだけなら、通常の ",[17,686,687],{},"セパレーター"," も追加できます。",[13,690,691,692,457],{},"ボードの空き領域を右クリックして ",[17,693,694],{},"グループを追加",[22,696,698],{"id":697},"タグ-フィルター","タグ \u002F フィルター",[13,700,701,702,705,706,708],{},"タグはタブを横断します。スライドアウトの ",[17,703,704],{},"フィルター"," パネル（サイドバー ",[17,707,704],{},"）で作成し、ボードを絞ります。",[710,711,712],"h3",{"id":712},"タグの作成と編集",[27,714,715,721,731,737],{},[30,716,717,718,720],{},"サイドバーで ",[17,719,704],{}," を開く。",[30,722,723,726,727,730],{},[17,724,725],{},"タグ"," の ",[17,728,729],{},"タグを追加"," — 名前と色を付ける。",[30,732,733,734,457],{},"同じリストで名前変更、色変更、",[17,735,736],{},"タグを削除",[30,738,739,742],{},[17,740,741],{},"タグはまだありません"," と出たら、割り当てる前にここで追加する。",[710,744,745],{"id":745},"サウンドにタグを付ける",[13,747,748,749,751],{},"サウンドを右クリック → ",[17,750,725],{},"（チェックボックス）。1つのサウンドに複数可。タグが無い場合、メニューはフィルターパネルへ案内します。",[710,753,754],{"id":754},"ボードをフィルター",[64,756,757,764,775,786],{},[30,758,759,760,763],{},"フィルターパネル、または ",[17,761,762],{},"検索バー下のチップ"," でタグを切り替え。",[30,765,766,767,770,771,774],{},"一致は ",[17,768,769],{},"OR","：選択したタグの ",[17,772,773],{},"いずれか"," を持つサウンドが表示される。",[30,776,777,778,781,782,785],{},"ナビバーの ",[17,779,780],{},"検索"," は有効なタグフィルターと ",[17,783,784],{},"AND","（入力 + タグ）。",[30,787,788],{},"チップをオフ（またはフィルター解除）でタブ全体を再表示。",[13,790,791,792,795],{},"色付きタグ名をボタンに表示できます。",[17,793,794],{},"設定 → 動作 → タグバッジを表示"," で切り替え。",[22,797,799],{"id":798},"並べ替えソート","並べ替え（ソート）",[13,801,802],{},"フィルターパネルでソートモードを選びます：",[64,804,805,811],{},[30,806,807,810],{},[17,808,809],{},"ユーザー定義"," — タブ順、グループ表示",[30,812,813,379,816,379,819,379,822,825,826],{},[17,814,815],{},"名前",[17,817,818],{},"追加日時",[17,820,821],{},"再生時間",[17,823,824],{},"ファイルサイズ"," — フラットなソート一覧。これらのモードでは ",[17,827,828],{},"グループは非表示",[13,830,831],{},"再生時間ソートは、初回に長さのメタデータを準備することがあります。",[22,833,835],{"id":834},"並べ替えドラッグ","並べ替え（ドラッグ）",[13,837,838,841,842,845,846,848],{},[17,839,840],{},"設定 → 動作"," でドラッグ＆ドロップをオンにします（",[17,843,844],{},"並べ替えを許可","）。その後、サウンドとグループをドラッグして配置します。ドラッグ並べ替えは ",[17,847,809],{}," ソートで有効です。",[22,850,851],{"id":851},"複数選択",[13,853,777,854,856],{},[17,855,851],{}," をオンにして：",[64,858,859,862,868,875],{},[30,860,861],{},"クリックでサウンドをトグル",[30,863,864,867],{},[17,865,866],{},"Shift+クリック"," で直前のアンカーから範囲選択",[30,869,870,871,874],{},"空きボード上で ",[17,872,873],{},"マーキー"," をドラッグ",[30,876,877],{},"空きボード（または外側）をクリックして選択解除",[13,879,880,881,379,884,379,887,379,890,893],{},"一括バーに件数が表示され、",[17,882,883],{},"色",[17,885,886],{},"タブへ移動…",[17,888,889],{},"削除",[17,891,892],{},"完了"," が使えます。",[13,895,896,897,900],{},"複数選択中、各ボタンに ",[17,898,899],{},"8文字のIDチップ"," が出ます。チップを右クリックでコピー。",[22,902,903],{"id":903},"サウンドごとの音量",[13,905,906,907,910,911,914],{},"右クリック → ",[17,908,909],{},"音量","。スライダーを 0%〜100%。",[17,912,913],{},"ダブルクリック"," で 100% にリセット。",[13,916,917],{},"設定のマスター出力音量と重ねて効きます。",[22,919,921],{"id":920},"ホットキーとサウンドid","ホットキーとサウンドID",[13,923,924,925,928],{},"すべてのサウンドには8文字のIDがあります。ボタンのコンテキストメニュー（",[17,926,927],{},"IDをコピー","）、または複数選択のIDチップからコピーします。",[13,930,931,934,935,938],{},[17,932,933],{},"設定 → ホットキー"," を開き、キーをサウンドIDに割り当てます。グローバルホットキーは任意です。コンテキストメニューの ",[17,936,937],{},"ホットキーを割り当て"," は、IDを埋めた状態でそこにジャンプします。",[13,940,941,942,944],{},"同じIDを",[216,943,219],{"href":218},"がクリップのトリガーに使います。",[22,946,947],{"id":947},"背景画像と色",[13,949,950,951,955],{},"サウンドを右クリックして、ボタンごとの色や背景画像を設定します。ボード全体を整える",[216,952,954],{"href":953},"\u002Fdocs\u002Ftheme-editor","Theme Creator","とは別です。",[13,957,958,959,962],{},"ピッカーは ",[17,960,961],{},"背景画像"," ダイアログ（PNG、JPEG、GIF、WebP）：",[64,964,965,971],{},[30,966,967,970],{},[17,968,969],{},"ローカルファイル"," — フォルダ追加、単一ファイル選択、ファイル名検索、グリッドプレビュー、ライブラリからフォルダ削除",[30,972,973,976,977,979],{},[17,974,975],{},"KLIPY"," — オンラインGIFを検索。APIキーは ",[17,978,840],{},"。キーはプロジェクトファイルには保存されません。",[13,981,982],{},"画像を選んだあと、ボタン上でパンとクロップできます。",{"title":134,"searchDepth":135,"depth":135,"links":984},[985,986,987,992,993,994,995,996,997],{"id":55,"depth":135,"text":55},{"id":664,"depth":135,"text":664},{"id":697,"depth":135,"text":698,"children":988},[989,990,991],{"id":712,"depth":611,"text":712},{"id":745,"depth":611,"text":745},{"id":754,"depth":611,"text":754},{"id":798,"depth":135,"text":799},{"id":834,"depth":135,"text":835},{"id":851,"depth":135,"text":851},{"id":903,"depth":135,"text":903},{"id":920,"depth":135,"text":921},{"id":947,"depth":135,"text":947},"タグ、フィルター、タブ、グループ、並べ替え、複数選択、音量、ホットキー。",{},4,"\u002Forganizing-sounds",{"title":600,"description":998},"organizing-sounds","PGqVreiuZb1jRxkXIW9tv66PvwPYs2iRx5-4j_D8sho",{"id":4,"title":5,"body":1006,"description":141,"extension":142,"meta":1092,"navigation":144,"order":145,"path":146,"seo":1093,"stem":148,"__hash__":149},{"type":7,"value":1007,"toc":1086},[1008,1010,1014,1016,1034,1036,1038,1048,1050,1068,1070,1072,1076],[10,1009,5],{"id":5},[13,1011,15,1012,20],{},[17,1013,19],{},[22,1015,25],{"id":24},[27,1017,1018,1026,1030],{},[30,1019,1020,35,1022,40,1024,44],{},[17,1021,34],{},[37,1023,39],{},[37,1025,43],{},[30,1027,1028,50],{},[17,1029,49],{},[30,1031,1032,56],{},[17,1033,55],{},[13,1035,59],{},[22,1037,62],{"id":62},[64,1039,1040,1042,1044,1046],{},[30,1041,68],{},[30,1043,71],{},[30,1045,74],{},[30,1047,77],{},[22,1049,80],{"id":80},[64,1051,1052,1056,1060,1064],{},[30,1053,1054,88],{},[17,1055,87],{},[30,1057,1058,94],{},[17,1059,93],{},[30,1061,1062,100],{},[17,1063,99],{},[30,1065,1066,106],{},[17,1067,105],{},[13,1069,109],{},[22,1071,112],{"id":112},[13,1073,1074,118],{},[17,1075,117],{},[64,1077,1078,1080,1084],{},[30,1079,123],{},[30,1081,126,1082,44],{},[17,1083,129],{},[30,1085,132],{},{"title":134,"searchDepth":135,"depth":135,"links":1087},[1088,1089,1090,1091],{"id":24,"depth":135,"text":25},{"id":62,"depth":135,"text":62},{"id":80,"depth":135,"text":80},{"id":112,"depth":135,"text":112},{},{"title":5,"description":141},{"id":1095,"title":1096,"body":1097,"description":1228,"extension":142,"meta":1229,"navigation":144,"order":1230,"path":1231,"seo":1232,"stem":1233,"__hash__":1234},"content_ja\u002Frecording-editor.md","録音エディター",{"type":7,"value":1098,"toc":1222},[1099,1101,1107,1110,1116,1136,1139,1142,1167,1170,1185,1189,1203,1213],[10,1100,1096],{"id":1096},[13,1102,1103,1104,1106],{},"SoundNinja内でクリップを録音し、トリムしてタブにインポートします。プレイヤーバーの ",[17,1105,548],{}," ボタンでエディターを開きます。",[22,1108,1109],{"id":1109},"入力を選ぶ",[13,1111,1112,1115],{},[17,1113,1114],{},"設定 → オーディオ"," で：",[64,1117,1118,1124,1130],{},[30,1119,1120,1123],{},[17,1121,1122],{},"入力デバイス"," — マイク",[30,1125,1126,1129],{},[17,1127,1128],{},"出力デバイス（PCオーディオ）"," — PCが再生している音のループバック",[30,1131,1132,1135],{},[17,1133,1134],{},"入力音量"," — キャプチャゲイン 0%〜200%",[13,1137,1138],{},"録音ボタンは、ここで選んだデバイスを使います。",[22,1140,1141],{"id":1141},"テイクを編集",[64,1143,1144,1147,1150,1158,1161,1164],{},[30,1145,1146],{},"録音と停止",[30,1148,1149],{},"入力レベルメーターを確認",[30,1151,1152,308,1155],{},[17,1153,1154],{},"ノーマライズ",[17,1156,1157],{},"ノイズキャンセレーション",[30,1159,1160],{},"クリップ全体のトリム、選択範囲へのトリム、選択の削除",[30,1162,1163],{},"元に戻す \u002F やり直し",[30,1165,1166],{},"ズームインとズームアウト",[22,1168,1169],{"id":1169},"ステージしてインポート",[27,1171,1172,1175,1178],{},[30,1173,1174],{},"選択範囲またはトラック全体をステージングリストに追加します。",[30,1176,1177],{},"リストは空から始まります。録音、編集、それからクリップを追加。",[30,1179,1180,308,1182,1184],{},[17,1181,557],{},[17,1183,560],{}," で、現在のタブまたは選んだタブに入れます。",[22,1186,1188],{"id":1187},"ステム分離任意","ステム分離（任意）",[13,1190,1191,1192,1195,1196,308,1199,1202],{},"公式のWindows \u002F macOS \u002F Linuxリリースビルドには ",[17,1193,1194],{},"ステム"," 機能が入ります。Record EditorはBS-RoFormerで ",[17,1197,1198],{},"ボーカル",[17,1200,1201],{},"音楽"," を残せます。",[13,1204,1205,1206,457,1209,1212],{},"モデルは約158 MBで、インストーラーには ",[17,1207,1208],{},"同梱されていません",[17,1210,1211],{},"設定 → ステム分離"," からダウンロードするか、初回起動のプロンプトを承認します。Windowsインストーラーも初回起動時にモデルのダウンロードを案内できます。",[13,1214,1215,1216,40,1219,519],{},"カスタムのソースビルドには追加フラグが必要です（",[37,1217,1218],{},"tauri:serve:stems",[37,1220,1221],{},"tauri:build:stems",{"title":134,"searchDepth":135,"depth":135,"links":1223},[1224,1225,1226,1227],{"id":1109,"depth":135,"text":1109},{"id":1141,"depth":135,"text":1141},{"id":1169,"depth":135,"text":1169},{"id":1187,"depth":135,"text":1188},"マイクまたはPCオーディオを取り込み、クリップを編集してボードに置く。",{},6,"\u002Frecording-editor",{"title":1096,"description":1228},"recording-editor","7_RI-WNd1luOVgn5vTAoyTmO8dKVtHVwkffwMt4LBQc",{"id":1236,"title":1237,"body":1238,"description":1449,"extension":142,"meta":1450,"navigation":144,"order":1451,"path":1452,"seo":1453,"stem":1454,"__hash__":1455},"content_ja\u002Fremote-control.md","リモートコントロール",{"type":7,"value":1239,"toc":1442},[1240,1242,1245,1248,1280,1283,1286,1320,1323,1343,1346,1349,1381,1385,1391],[10,1241,1237],{"id":1237},[13,1243,1244],{},"SoundNinjaはローカルネットワークで待ち受け、Bitfocus Companion（または任意のHTTP\u002FWebSocketクライアント）がサウンドを再生・停止できます。",[22,1246,1247],{"id":1247},"リモートサーバーを有効化",[27,1249,1250,1256,1263,1270],{},[30,1251,1252,1255],{},[17,1253,1254],{},"設定 → リモート"," を開きます。",[30,1257,1258,1259,1262],{},"リモートサーバーを有効にします。デフォルトポートは ",[17,1260,1261],{},"7331"," です。",[30,1264,1265,1266,1269],{},"任意：トークンを設定。クライアントはBearerトークンまたは ",[37,1267,1268],{},"?token="," で送ります。",[30,1271,1272,1275,1276,1279],{},[37,1273,1274],{},"http:\u002F\u002FIP:PORT"," URLをコピーするか、",[17,1277,1278],{},"設定 → 情報"," からシステムIPをコピーします。",[13,1281,1282],{},"Windowsはサーバー初回起動時にファイアウォールの確認を出すことがあります。プライベートネットワークのアクセスを許可してください。",[22,1284,219],{"id":1285},"bitfocus-companion",[27,1287,1288,1295,1303,1314],{},[30,1289,1290,1294],{},[216,1291,219],{"href":1292,"rel":1293},"https:\u002F\u002Fbitfocus.io\u002Fcompanion",[237],"をインストールします。",[30,1296,1297,1302],{},[216,1298,1301],{"href":1299,"rel":1300},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Freleases\u002Flatest\u002Fdownload\u002FSoundNinja-Companion.tgz",[237],"SoundNinja-Companion.tgz"," をダウンロード。Companion Storeのパッケージはまだありません。",[30,1304,1305,1306,1309,1310,1313],{},"Companionで ",[17,1307,1308],{},"Modules → Load module package"," を開き、",[37,1311,1312],{},".tgz"," を選びます。",[30,1315,1316,1319],{},[17,1317,1318],{},"Sound Ninja"," 接続を追加。PCのIP、ポート、設定したトークンを貼り付けます。",[22,1321,1322],{"id":1322},"アクション",[64,1324,1325,1331,1337],{},[30,1326,1327,1330],{},[17,1328,1329],{},"Trigger Sound"," — ライブドロップダウンから選ぶか、8文字のサウンドIDを入力（Companion変数が使えます）",[30,1332,1333,1336],{},[17,1334,1335],{},"Stop Sound"," — IDで再生中のサウンドを1つ停止",[30,1338,1339,1342],{},[17,1340,1341],{},"Stop All"," — 再生中の全サウンドを停止",[13,1344,1345],{},"SoundNinjaでは、ボタンのコンテキストメニューまたは複数選択のIDチップからサウンドIDをコピーします。",[22,1347,1348],{"id":1348},"フィードバックと変数",[64,1350,1351,1357,1369,1375],{},[30,1352,1353,1356],{},[17,1354,1355],{},"Sound Playing"," — そのサウンドIDがアクティブな間はtrue（ボタン色に使う）",[30,1358,1359,1362,1363,40,1366],{},[37,1360,1361],{},"$(soundninja:connected)"," — ",[37,1364,1365],{},"true",[37,1367,1368],{},"false",[30,1370,1371,1374],{},[37,1372,1373],{},"$(soundninja:playing_count)"," — 再生中のサウンド数",[30,1376,1377,1380],{},[37,1378,1379],{},"$(soundninja:last_triggered)"," — 最後にトリガーしたサウンドID",[22,1382,1384],{"id":1383},"http-api上級","HTTP API（上級）",[13,1386,1387,1388],{},"ベースパス：",[37,1389,1390],{},"\u002Fapi\u002Fv1",[64,1392,1393,1399,1405,1411,1421,1427,1436],{},[30,1394,1395,1398],{},[37,1396,1397],{},"GET \u002Finfo"," — アプリ名、バージョン、プロトコル、トークンが必要か",[30,1400,1401,1404],{},[37,1402,1403],{},"GET \u002Fsounds"," — サウンド一覧（id、name、tabs、active）",[30,1406,1407,1410],{},[37,1408,1409],{},"GET \u002Fstate"," — サウンドと現在再生中のID",[30,1412,1413,1416,1417,1420],{},[37,1414,1415],{},"POST \u002Ftrigger"," に ",[37,1418,1419],{},"{ \"id\" }"," — サウンドを再生",[30,1422,1423,1426],{},[37,1424,1425],{},"GET \u002Ftrigger\u002F:id"," — 再生（ブラウザで簡単にテスト）",[30,1428,1429,1432,1433,1435],{},[37,1430,1431],{},"POST \u002Fstop"," に任意の ",[37,1434,1419],{}," — 1つまたはすべて停止",[30,1437,1438,1441],{},[37,1439,1440],{},"GET \u002Fws"," — ライブ状態。trigger\u002Fstopコマンドを受信",{"title":134,"searchDepth":135,"depth":135,"links":1443},[1444,1445,1446,1447,1448],{"id":1247,"depth":135,"text":1247},{"id":1285,"depth":135,"text":219},{"id":1322,"depth":135,"text":1322},{"id":1348,"depth":135,"text":1348},{"id":1383,"depth":135,"text":1384},"ローカルネットワーク経由でBitfocus CompanionからSoundNinjaを操作。",{},7,"\u002Fremote-control",{"title":1237,"description":1449},"remote-control","_6T2WMAtPh7L1pRelAkpGazesfqk5Swk4FcTh5g7BTw",{"id":1457,"title":1458,"body":1459,"description":1544,"extension":142,"meta":1545,"navigation":144,"order":1546,"path":1547,"seo":1548,"stem":1549,"__hash__":1550},"content_ja\u002Fsupport.md","サポート",{"type":7,"value":1460,"toc":1537},[1461,1463,1466,1469,1472,1479,1487,1490,1497,1499,1512,1515,1527,1530],[10,1462,1458],{"id":1458},[13,1464,1465],{},"SoundNinjaは初期ベータのコミュニティプロジェクトです。いちばん早い助けはGitHubです。",[22,1467,1468],{"id":1468},"バグ報告または質問",[13,1470,1471],{},"GitHubでissueを開いてください：",[13,1473,1474],{},[216,1475,1478],{"href":1476,"rel":1477},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fissues",[237],"github.com\u002Fmarcus-universe\u002FSoundNinja\u002Fissues",[13,1480,1481,1482,308,1484,1486],{},"OS、SoundNinjaのバージョン（",[17,1483,392],{},[17,1485,1278],{},"）、再現手順を書いてください。",[22,1488,1489],{"id":1489},"メール",[13,1491,1492,1493],{},"メンテナー連絡先：",[216,1494,1496],{"href":1495},"mailto:contact@marcus-universe.de","contact@marcus-universe.de",[22,1498,386],{"id":386},[13,1500,389,1501,1503,1504,1506,1507,1511],{},[17,1502,392],{}," を使います。新しいビルドは",[216,1505,288],{"h