,"Linux",[64,350,351,357,363,370],{},[30,352,353,354],{},"Ubuntu \u002F Debian向けの",[17,355,356],{},"Debian (.deb)",[30,358,359,360],{},"その他のディストリ向けの",[17,361,362],{},"AppImage",[30,364,365,366,369],{},"リリース公開後、ArchユーザーはAURから",[37,367,368],{},"soundninja-bin","をインストールできます",[30,371,372],{},"Ubuntu 20.04でテスト済み",[13,374,375,376,379,380,383],{},"デスクトップビルドにはWebKitとGTKのパッケージが必要です。Debian\u002FUbuntuでは通常、",[37,377,378],{},"libwebkit2gtk","、",[37,381,382],{},"libgtk-3-0","、app-indicatorライブラリです。",[22,385,386],{"id":386},"アップデート",[13,388,389,390,393],{},"アプリ内で ",[17,391,392],{},"ヘルプ → アップデートを確認"," を開きます。設定で起動時にSoundNinjaが確認するようにもできます。",[22,395,396],{"id":396},"ソースからビルド",[13,398,399,400,405,406,411],{},"カスタムビルドが必要なら、",[216,401,404],{"href":402,"rel":403},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja",[237],"リポジトリ","をクローンし、",[216,407,410],{"href":408,"rel":409},"https:\u002F\u002Fv2.tauri.app\u002Fstart\u002Fprerequisites\u002F",[237],"Tauriの前提条件","を入れたうえで：",[413,414,418],"pre",{"className":415,"code":416,"language":417,"meta":134,"style":134},"language-bash shiki shiki-themes github-light github-dark","bun install\nbun run tauri:serve\n","bash",[37,419,420,432],{"__ignoreMap":134},[421,422,424,428],"span",{"class":423,"line":271},"line",[421,425,427],{"class":426},"sScJk","bun",[421,429,431],{"class":430},"sZZnC"," install\n",[421,433,434,436,439],{"class":423,"line":135},[421,435,427],{"class":426},[421,437,438],{"class":430}," run",[421,440,441],{"class":430}," tauri:serve\n",[13,443,444,379,447,379,450,453,454,457],{},[37,445,446],{},"npm",[37,448,449],{},"pnpm",[37,451,452],{},"deno","でも動きます。本番ビルド：",[37,455,456],{},"bun run tauri:build","。",[13,459,460,463,464,469,470,473,474,457],{},[17,461,462],{},"Windowsのみ:"," Windowsビルドはすべて ",[216,465,468],{"href":466,"rel":467},"https:\u002F\u002Fwww.steinberg.net\u002Fasiosdk",[237],"Steinberg ASIO SDK"," 経由でASIOを含めます。一度 ",[37,471,472],{},"bun run setup:asio"," を実行（SDKはgitに含まれません）。Linux \u002F macOSは PipeWire \u00