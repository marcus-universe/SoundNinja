0,561,564,583,586,600,603,606,613,616],[10,502,498],{"id":498},[13,504,505],{},"クリップを追加するまで、ボードは空です。SoundNinjaはファイル、フォルダ全体、録音、共有サウンドボードパックをインポートできます。",[22,507,508],{"id":508},"音声ファイルをインポート",[27,510,511,521,524],{},[30,512,513,516,517,520],{},[17,514,515],{},"ファイル → 音声ファイルをインポート","、またはナビバーの ",[17,518,519],{},"インポート"," を使います。",[30,522,523],{},"1つ以上の音声ファイルを選びます。",[30,525,526],{},"サウンドは現在のタブに入ります。",[22,528,529],{"id":529},"フォルダをインポート",[27,531,532,541,544],{},[30,533,534,537,538,540],{},[17,535,536],{},"ファイル → フォルダをインポート","（またはナビバーの ",[17,539,529],{},"）。",[30,542,543],{},"1つ以上のフォルダを追加。インポート前にドラッグで並べ替えできます。",[30,545,546,547],{},"配置方法を選びます：\n",[64,548,549,555],{},[30,550,551,554],{},[17,552,553],{},"タブとしてインポート"," — 各フォルダが独自のタブになる",[30,556,557,560],{},[17,558,559],{},"現在のタブにインポート"," — すべてのファイルがアクティブなタブに入る",[22,562,563],{"id":563},"クリップを録音",[13,565,566,567,570,571,575,576,308,579,582],{},"プレイヤーバーの ",[17,568,569],{},"録音"," ボタンから",[216,572,574],{"href":573},"\u002Fdocs\u002Frecording-editor","Record Editor","を開きます。キャプチャ、トリムし、",[17,577,578],{},"選択をインポート",[17,580,581],{},"すべてインポート"," で現在のタブまたは選んだタブに入れます。",[22,584,585],{"id":585},"サウンドボードをインポート",[13,587,588,591,592,595,596,599],{},[17,589,590],{},"ファイル → サウンドボードをインポート"," で共有パックを読み込みます。パックは ",[37,593,594],{},"project.sninja"," とサウンドファイルを含む ",[37,597,598],{},".zip"," です。インポート後、プロジェクトを開いて再生します。",[13,601,602],{},"複数のプロジェクト（プロファイル）も保てます。プロジェクトセレクターでボードを切り替えます。",[22,604,605],{"id":605},"見つからないファイルを再リンク",[13,607,608,609,612],{},"ディスク上で音声ファイルが移動すると、SoundNinjaは ",[17,610,611],{},"見つからないサウンドファイル"," ダイアログを表示します。検索するフォルダを選び、クリップを再リンクします。",[22,614,615],{"id":615},"次へ",[13,617,618,619,457],{},"タブ、タグ、フィルター、ホットキーの整理は",[216,620,621],{"href":261},"サウンドの整理",{"title":134,"searchDepth":135,"depth":135,"links":623},[624,625,626,627,628,629],{"id":508,"depth":135,"text":508},{"id":529,"depth":135,"text":529},{"id":563,"depth":135,"text":563},{"id":585,"depth":135,"text":585},{"id":605,"depth":135,"text":605},{"id":615,"depth":135,"text":615},"音声、フォルダ、録音、共有サウンドボードをインポート。",{},3,"\u002Fadding-sounds",{"title":498,"description":630},"adding-sounds","5_cjd2COcPz0pj4ZrBehCZv6ouzBimE8UGjkcfngQjw",{"id":638,"title":621,"body":639,"description":1029,"extension":142,"meta":1030,"navigation":144,"order":1031,"path":1032,"seo":1033,"stem":1034,"__hash__":1035},"content_ja\u002Forganizing-sounds.md",{"type":7,"value":640,"toc":1014},[641,643,650,652,677,683,686,689,703,710,716,720,730,734,764,767,773,776,810,817,821,824,850,853,857,870,873,878,899,915,922,925,936,939,943,950,960,966,969,977,984,1011],[10,642,621],{"id":621},[13,644,645,646,649],{},"SoundNinjaは大規模ライブラリ向けです。",[17,647,648],{},"タグとフィルター","、タブ、検索、複数選択、ホットキーで、必要なクリップをワンクリック（またはワンキー）で出せます。",[22,651,55],{"id":55},[64,653,654,660,666],{},[30,655,656,659],{},[17,657,658],{},"タブを追加"," でタブを作り、色を付けてバーをすばやく眺められます。",[30,661,662,665],{},[17,663,664],{},"すべて"," ビューはタブを横断して全サウンドを表示します。",[30,667,668,669,672,673,676],{},"サウンドは ",[17,670,671],{},"1つ以上のタブ"," に所属できます。サウンドを右クリックし、",[17,674,675],{},"タブへ移動"," で割り当てます。",[13,678,679,680,682],{},"タブの切り替え演出は ",[17,681,117],{},"：スライド、フェード、ボタンを1つずつ、またはなし。",[22,684,685],{"id":685},"グループ",[13,687,688],{},"v0.5.3以降、セパレーターを名前付きグループにできます：",[64,690,691,694,697,700],{},[30,692,693],{},"コンテキストメニューからグループの追加、名前変更、削除",[30,695,696],{},"グループヘッダーをドラッグ — 子も一緒に動く",[30,698,699],{},"グループにサウンドを入れたり出したり",[30,701,702],{},"グループの枠線色、名前の色、ボタン配置を設定（またはタブのデフォルトを使う）",[13,704,705,706,709],{},"見た目の区切りだけなら、通常の ",[17,707,708],{},"セパレーター"," も追加できます。",[13,711,712,713,457],{},"ボードの空き領域を右クリックして ",[17,714,715],{},"グループを追加",[22,717,719],{"id":718},"タグ-フィルター","タグ \u002F フィルター",[13,721,722,723,726,727,729],{},"タグはタブを横断します。スライドアウトの ",[17,724,725],{},"フィルター"," パネル（サイドバー ",[17,728,725],{},"）で作成し、ボードを絞ります。",[731,732,733],"h3",{"id":733},"タグの作成と編集",[27,735,736,742,752,758],{},[30,737,738,739,741],{},"サイドバーで ",[17,740,725],{}," を開く。",[30,743,744,747,748,751],{},[17,745,746],{},"タグ"," の ",[17,749,750],{},"タグを追加"," — 名前と色を付ける。",[30,753,754,755,457],{},"同じリストで名前変更、色変更、",[17,756,757],{},"タグを削除",[30,759,760,763],{},[17,761,762],{},"タグはまだありません"," と出たら、割り当てる前にここで追加する。",[731,765,766],{"id":766},"サウンドにタグを付ける",[13,768,769,770,772],{},"サウンドを右クリック → ",[17,771,746],{},"（チェックボックス）。1つのサウンドに複数可。タグが無い場合、メニューはフィルターパネルへ案内します。",[731,774,775],{"id":775},"ボードをフィルター",[64,777,778,785,796,807],{},[30,779,780,781,784],{},"フィルターパネル、または ",[17,782,783],{},"検索バー下のチップ"," でタグを切り替え。",[30,786,787,788,791,792,795],{},"一致は ",[17,789,790],{},"OR","：選択したタグの ",[17,793,794],{},"いずれか"," を持つサウンドが表示される。",[30,797,798,799,802,803,806],{},"ナビバーの ",[17,800,801],{},"検索"," は有効なタグフィルターと ",[17,804,805],{},"AND","（入力 + タグ）。",[30,808,809],{},"チップをオフ（またはフィルター解除）でタブ全体を再表示。",[13,811,812,813,816],{},"色付きタグ名をボタンに表示できます。",[17,814,815],{},"設定 → 動作 → タグバッジを表示"," で切り替え。",[22,818,820],{"id":819},"並べ替えソート","並べ替え（ソート）",[13,822,823],{},"フィルターパネルでソートモードを選びます：",[64,825,826,832],{},[30,827,828,831],{},[17,829,830],{},"ユーザー定義"," — タブ順、グループ表示",[30,833,834,379,837,379,840,379,843,846,847],{},[17,835,836],{},"名前",[17,838,839],{},"追加日時",[17,841,842],{},"再生時間",[17,844,845],{},"ファイルサイズ"," — フラットなソート一覧。これらのモードでは ",[17,848,849],{},"グループは非表示",[13,851,852],{},"再生時間ソートは、初回に長さのメタデータを準備することがあります。",[22,854,856],{"id":855},"並べ替えドラッグ","並べ替え（ドラッグ）",[13,858,859,862,863,866,867,869],{},[17,860,861],{},"設定 → 動作"," でドラッグ＆ドロップをオンにします（",[17,864,865],{},"並べ替えを許可","）。その後、サウンドとグループをドラッグして配置します。ドラッグ並べ替えは ",[17,868,830],{}," ソートで有効です。",[22,871,872],{"id":872},"複数選択",[13,874,798,875,877],{},[17,876,872],{}," をオンにして：",[64,879,880,883,889,896],{},[30,881,882],{},"クリックでサウンドをトグル",[30,884,885,888],{},[17,886,887],{},"Shift+クリック"," で直前のアンカーから範囲選択",[30,890,891,892,895],{},"空きボード上で ",[17,893,894],{},"マーキー"," をドラッグ",[30,897,898],{},"空きボード（または外側）をクリックして選択解除",[13,900,901,902,379,905,379,908,379,911,914],{},"一括バーに件数が表示され、",[17,903,904],{},"色",[17,906,907],{},"タブへ移動…",[17,909,910],{},"削除",[17,912,913],{},"完了"," が使えます。",[13,916,917,918,921],{},"複数選択中、各ボタンに ",[17,919,920],{},"8文字のIDチップ"," が出ます。チップを右クリックでコピー。",[22,923,924],{"id":924},"サウンドごとの音量",[13,926,927,928,931,932,935],{},"右クリック → ",[17,929,930],{},"音量","。スライダーを 0%〜100%。",[17,933,934],{},"ダブルクリック"," で 100% にリセット。",[13,937,938],{},"設定のマスター出力音量と重ねて効きます。",[22,940,942],{"id":941},"ホットキーとサウンドid","ホットキーとサウンドID",[13,944,945,946,949],{},"すべてのサウンドには8文字のIDがあります。ボタンのコンテキストメニュー（",[17,947,948],{},"IDをコピー","）、または複数選択のIDチップからコピーします。",[13,951,952,955,956,959],{},[17,953,954],{},"設定 → ホットキー"," を開き、キーをサウンドIDに割り当てます。グローバルホットキーは任意です。コンテキストメニューの ",[17,957,958],{},"ホットキーを割り当て"," は、IDを埋めた状態でそこにジャンプします。",[13,961,962,963,965],{},"同じIDを",[216,964,219],{"href":218},"がクリップのトリガーに使います。",[22,967,968],{"id":968},"背景画像と色",[13,970,971,972,976],{},"サウンドを右クリックして、ボタンごとの色や背景画像を設定します。ボード全体を整える",[216,973,975],{"href":974},"\u002Fdocs\u002Ftheme-editor","Theme Creator","とは別です。",[13,978,979,980,983],{},"ピッカーは ",[17,981,982],{},"背景画像"," ダイアログ（PNG、JPEG、GIF、WebP）：",[64,985,986,992,1002],{},[30,987,988,991],{},[17,989,990],{},"ローカルファイル"," — フォルダ追加、単一ファイル選択、ファイル名検索、グリッドプレビュー、ライブラリからフォルダ削除",[30,993,994,997,998],{},[17,995,996],{},"GifSnap"," — APIキーなしでオンラインGIFを検索。初回は GifSnap へのリクエスト許可を求めます。検索結果はキャッシュして通信を減らします。",[216,999,996],{"href":1000,"rel":1001},"https:\u002F\u002Fgifsnap.com",[237],[30,1003,1004,1007,1008,1010],{},[17,1005,1006],{},"KLIPY"," — オンラインGIFを検索。APIキーは ",[17,1009,861],{},"。キーはプロジェクトファイルには保存されません。",[13,1012,1013],{},"画像を選んだあと、ボタン上でパンとクロップできます。",{"title":134,"searchDepth":135,"depth":135,"links":1015},[1016,1017,1018,1023,1024,1025,1026,1027,1028],{"id":55,"depth":135,"text":55},{"id":685,"depth":135,"text":685},{"id":718,"depth":135,"text":719,"children":1019},[1020,1021,1022],{"id":733,"depth":632,"text":733},{"id":766,"depth":632,"text":766},{"id":775,"depth":632,"text":775},{"id":819,"depth":135,"text":820},{"id":855,"depth":135,"text":856},{"id":872,"depth":135,"text":872},{"id":924,"depth":135,"text":924},{"id":941,"depth":135,"text":942},{"id":968,"depth":135,"text":968},"タグ、フィルター、タブ、グループ、並べ替え、複数選択、音量、ホットキー。",{},4,"\u002Forganizing-sounds",{"title":621,"description":1029},"organizing-sounds","7eo3HsiR87FfpmaZ2egiJxhWDKGaOqGKyaXl1gmdAbY",{"id":4,"title":5,"body":1037,"description":141,"extension":142,"meta":1123,"navigation":144,"order":145,"path":146,"seo":1124,"stem":148,"__hash__":149},{"type":7,"value":1038,"toc":1117},[1039,1041,1045,1047,1065,1067,1069,1079,1081,1099,1101,1103,1107],[10,1040,5],{"id":5},[13,1042,15,1043,20],{},[17,1044,19],{},[22,1046,25],{"id":24},[27,1048,1049,1057,1061],{},[30,1050,1051,35,1053,40,1055,44],{},[17,1052,34],{},[37,1054,39],{},[37,1056,43],{},[30,1058,1059,50],{},[17,1060,49],{},[30,1062,1063,56],{},[17,1064,55],{},[13,1066,59],{},[22,1068,62],{"id":62},[64,1070,1071,1073,1075,1077],{},[30,1072,68],{},[30,1074,71],{},[30,1076,74],{},[30,1078,77],{},[22,1080,80],{"id":80},[64,1082,1083,1087,1091,1095],{},[30,1084,1085,88],{},[17,1086,87],{},[30,1088,1089,94],{},[17,1090,93],{},[30,1092,1093,100],{},[17,1094,99],{},[30,1096,1097,106],{},[17,1098,105],{},[13,1100,109],{},[22,1102,112],{"id":112},[13,1104,1105,118],{},[17,1106,117],{},[64,1108,1109,1111,1115],{},[30,1110,123],{},[30,1112,126,1113,44],{},[17,1114,129],{},[30,1116,132],{},{"title":134,"searchDepth":135,"depth":135,"links":1118},[1119,1120,1121,1122],{"id":24,"depth":135,"text":25},{"id":62,"depth":135,"text":62},{"id":80,"depth":135,"text":80},{"id":112,"depth":135,"text":112},{},{"title":5,"description":141},{"id":1126,"title":1127,"body":1128,"description":1259,"extension":142,"meta":1260,"navigation":144,"order":1261,"path":1262,"seo":1263,"stem":1264,"__hash__":1265},"content_ja\u002Frecording-editor.md","録音エディター",{"type":7,"value":1129,"toc":1253},[1130,1132,1138,1141,1147,1167,1170,1173,1198,1201,1216,1220,1234,1244],[10,1131,1127],{"id":1127},[13,1133,1134,1135,1137],{},"SoundNinja内でクリップを録音し、トリムしてタブにインポートします。プレイヤーバーの ",[17,1136,569],{}," ボタンでエディターを開きます。",[22,1139,1140],{"id":1140},"入力を選ぶ",[13,1142,1143,1146],{},[17,1144,1145],{},"設定 → オーディオ"," で：",[64,1148,1149,1155,1161],{},[30,1150,1151,1154],{},[17,1152,1153],{},"入力デバイス"," — マイク",[30,1156,1157,1160],{},[17,1158,1159],{},"出力デバイス（PCオーディオ）"," — PCが再生している音のループバック",[30,1162,1163,1166],{},[17,1164,1165],{},"入力音量"," — キャプチャゲイン 0%〜200%",[13,1168,1169],{},"録音ボタンは、ここで選んだデバイスを使います。",[22,1171,1172],{"id":1172},"テイクを編集",[64,1174,1175,1178,1181,1189,1192,1195],{},[30,1176,1177],{},"録音と停止",[30,1179,1180],{},"入力レベルメーターを確認",[30,1182,1183,308,1186],{},[17,1184,1185],{},"ノーマライズ",[17,1187,1188],{},"ノイズキャンセレーション",[30,1190,1191],{},"クリップ全体のトリム、選択範囲へのトリム、選択の削除",[30,1193,1194],{},"元に戻す \u002F やり直し",[30,1196,1197],{},"ズームインとズームアウト",[22,1199,1200],{"id":1200},"ステージしてインポート",[27,1202,1203,1206,1209],{},[30,1204,1205],{},"選択範囲またはトラック全体をステージングリストに追加します。",[30,1207,1208],{},"リストは空から始まります。録音、編集、それからクリップを追加。",[30,1210,1211,308,1213,1215],{},[17,1212,578],{},[17,1214,581],{}," で、現在のタブまたは選んだタブに入れます。",[22,1217,1219],{"id":1218},"ステム分離任意","ステム分離（任意）",[13,1221,1222,1223,1226,1227,308,1230,1233],{},"公式のWindows \u002F macOS \u002F Linuxリリースビルドには ",[17,1224,1225],{},"ステム"," 機能が入ります。Record EditorはBS-RoFormerで ",[17,1228,1229],{},"ボーカル",[17,1231,1232],{},"音楽"," を残せます。",[13,1235,1236,1237,457,1240,1243],{},"モデルは約158 MBで、インストーラーには ",[17,1238,1239],{},"同梱されていません",[17,1241,1242],{},"設定 → ステム分離"," からダウンロードするか、初回起動のプロンプトを承認します。Windowsインストーラーも初回起動時にモデルのダウンロードを案内できます。",[13,1245,1246,1247,40,1250,540],{},"カスタムのソースビルドには追加フラグが必要です（",[37,1248,1249],{},"tauri:serve:stems",[37,1251,1252],{},"tauri:build:stems",{"title":134,"searchDepth":135,"depth":135,"links":1254},[1255,1256,1257,1258],{"id":1140,"depth":135,"text":1140},{"id":1172,"depth":135,"text":1172},{"id":1200,"depth":135,"text":1200},{"id":1218,"depth":135,"text":1219},"マイクまたはPCオーディオを取り込み、クリップを編集してボードに置く。",{},6,"\u002Frecording-editor",{"title":1127,"description":1259},"recording-editor","7_RI-WNd1luOVgn5vTAoyTmO8dKVtHVwkffwMt4LBQc",{"id":1267,"title":1268,"body":1269,"description":1480,"extension":142,"meta":1481,"navigation":144,"order":1482,"path":1483,"seo":1484,"stem":1485,"__hash__":1486},"content_ja\u002Fremote-control.md","リモートコントロール",{"type":7,"value":1270,"toc":1473},[1271,1273,1276,1279,1311,1314,1317,1351,1354,1374,1377,1380,1412,1416,1422],[10,1272,1268],{"id":1268},[13,1274,1275],{},"SoundNinjaはローカルネットワークで待ち受け、Bitfocus Companion（または任意のHTTP\u002FWebSocketクライアント）がサウンドを再生・停止できます。",[22,1277,1278],{"id":1278},"リモートサーバーを有効化",[27,1280,1281,1287,1294,1301],{},[30,1282,1283,1286],{},[17,1284,1285],{},"設定 → リモート"," を開きます。",[30,1288,1289,1290,1293],{},"リモートサーバーを有効にします。デフォルトポートは ",[17,1291,1292],{},"7331"," です。",[30,1295,1296,1297,1300],{},"任意：トークンを設定。クライアントはBearerトークンまたは ",[37,1298,1299],{},"?token="," で送ります。",[30,1302,1303,1306,1307,1310],{},[37,1304,1305],{},"http:\u002F\u002FIP:PORT"," URLをコピーするか、",[17,1308,1309],{},"設定 → 情報"," からシステムIPをコピーします。",[13,1312,1313],{},"Windowsはサーバー初回起動時にファイアウォールの確認を出すことがあります。プライベートネットワークのアクセスを許可してください。",[22,1315,219],{"id":1316},"bitfocus-companion",[27,1318,1319,1326,1334,1345],{},[30,1320,1321,1325],{},[216,1322,219],{"href":1323,"rel":1324},"https:\u002F\u002Fbitfocus.io\u002Fcompanion",[237],"をインストールします。",[30,1327,1328,1333],{},[216,1329,1332],{"href":1330,"rel":1331},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002Fcompanion-module-soundninja\u002Freleases\u002Flatest",[237],"SoundNinja-Companion.tgz"," をダウンロード。Companion Storeのパッケージはまだありません。",[30,1335,1336,1337,1340,1341,1344],{},"Companionで ",[17,1338,1339],{},"Modules → Load module package"," を開き、",[37,1342,1343],{},".tgz"," を選びます。",[30,1346,1347,1350],{},[17,1348,1349],{},"Sound Ninja"," 接続を追加。PCのIP、ポート、設定したトークンを貼り付けます。",[22,1352,1353],{"id":1353},"アクション",[64,1355,1356,1362,1368],{},[30,1357,1358,1361],{},[17,1359,1360],{},"Trigger Sound"," — ライブドロップダウンから選ぶか、8文字のサウンドIDを入力（Companion変数が使えます）",[30,1363,1364,1367],{},[17,1365,1366],{},"Stop Sound"," — IDで再生中のサウンドを1つ停止",[30,1369,1370,1373],{},[17,1371,1372],{},"Stop All"," — 再生中の全サウンドを停止",[13,1375,1376],{},"SoundNinjaでは、ボタンのコンテキストメニューまたは複数選択のIDチップからサウンドIDをコピーします。",[22,1378,1379],{"id":1379},"フィードバックと変数",[64,1381,1382,1388,1400,1406],{},[30,1383,1384,1387],{},[17,1385,1386],{},"Sound Playing"," — そのサウンドIDがアクティブな間はtrue（ボタン色に使う）",[30,1389,1390,1393,1394,40,1397],{},[37,1391,1392],{},"$(soundninja:connected)"," — ",[37,1395,1396],{},"true",[37,1398,1399],{},"false",[30,1401,1402,1405],{},[37,1403,1404],{},"$(soundninja:playing_count)"," — 再生中のサウンド数",[30,1407,1408,1411],{},[37,1409,1410],{},"$(soundninja:last_triggered)"," — 最後にトリガーしたサウンドID",[22,1413,1415],{"id":1414},"http-api上級","HTTP API（上級）",[13,1417,1418,1419],{},"ベースパス：",[37,1420,1421],{},"\u002Fapi\u002Fv1",[64,1423,1424,1430,1436,1442,1452,1458,1467],{},[30,1425,1426,1429],{},[37,1427,1428],{},"GET \u002Finfo"," — アプリ名、バージョン、プロトコル、トークンが必要か",[30,1431,1432,1435],{},[37,1433,1434],{},"GET \u002Fsounds"," — サウンド一覧（id、name、tabs、active）",[30,1437,1438,1441],{},[37,1439,1440],{},"GET \u002Fstate"," — サウンドと現在再生中のID",[30,1443,1444,1447,1448,1451],{},[37,1445,1446],{},"POST \u002Ftrigger"," に ",[37,1449,1450],{},"{ \"id\" }"," — サウンドを再生",[30,1453,1454,1457],{},[37,1455,1456],{},"GET \u002Ftrigger\u002F:id"," — 再生（ブラウザで簡単にテスト）",[30,1459,1460,1463,1464,1466],{},[37,1461,1462],{},"POST \u002Fstop"," に任意の ",[37,1465,1450],{}," — 1つまたはすべて停止",[30,1468,1469,1472],{},[37,1470,1471],{},"GET \u002Fws"," — ライブ状態。trigger\u002Fstopコマンドを受信",{"title":134,"searchDepth":135,"depth":135,"links":1474},[1475,1476,1477,1478,1479],{"id":1278,"depth":135,"text":1278},{"id":1316,"depth":135,"text":219},{"id":1353,"depth":135,"text":1353},{"id":1379,"depth":135,"text":1379},{"id":1414,"depth":135,"text":1415},"ローカルネットワーク経由でBitfocus CompanionからSoundNinjaを操作。",{},7,"\u002Fremote-control",{"title":1268,"description":1480},"remote-control","mPFqlRPL-jxRSpdtuwlQQcHhnmsyzKrKdjplGWwWueU",{"id":1488,"title":1489,"body":1490,"description":1575,"extension":142,"meta":1576,"navigation":144,"order":1577,"path":1578,"seo":1579,"stem":1580,"__hash__":1581},"content_ja\u002Fsupport.md","サポート",{"type":7,"value":1491,"toc":1568},[1492,1494,1497,1500,1503,1510,1518,1521,1528,1530,1543,1546,1558,1561],[10,1493,1489],{"id":1489}