[{"data":1,"prerenderedAt":1264},["ShallowReactive",2],{"docs-page-ja-\u002Fsupport":3,"docs-nav-ja":121},{"id":4,"title":5,"body":6,"description":112,"extension":113,"meta":114,"navigation":115,"order":116,"path":117,"seo":118,"stem":119,"__hash__":120},"content_ja\u002Fsupport.md","サポート",{"type":7,"value":8,"toc":103},"minimark",[9,12,16,20,23,32,44,47,54,57,74,77,92,95],[10,11,5],"h1",{"id":5},[13,14,15],"p",{},"SoundNinjaは初期ベータのコミュニティプロジェクトです。いちばん早い助けはGitHubです。",[17,18,19],"h2",{"id":19},"バグ報告または質問",[13,21,22],{},"GitHubでissueを開いてください：",[13,24,25],{},[26,27,31],"a",{"href":28,"rel":29},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fissues",[30],"nofollow","github.com\u002Fmarcus-universe\u002FSoundNinja\u002Fissues",[13,33,34,35,39,40,43],{},"OS、SoundNinjaのバージョン（",[36,37,38],"strong",{},"ヘルプ → アップデートを確認"," または ",[36,41,42],{},"設定 → 情報","）、再現手順を書いてください。",[17,45,46],{"id":46},"メール",[13,48,49,50],{},"メンテナー連絡先：",[26,51,53],{"href":52},"mailto:contact@marcus-universe.de","contact@marcus-universe.de",[17,55,56],{"id":56},"アップデート",[13,58,59,60,62,63,67,68,73],{},"アプリ内で ",[36,61,38],{}," を使います。新しいビルドは",[26,64,66],{"href":65},"\u002Fdownload","ダウンロードページ","と",[26,69,72],{"href":70,"rel":71},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Freleases",[30],"GitHub Releases","にも出ます。",[17,75,76],{"id":76},"コントリビュート",[13,78,79,80,85,86,91],{},"プルリクエストを歓迎します。アプリのリポジトリは",[26,81,84],{"href":82,"rel":83},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja",[30],"github.com\u002Fmarcus-universe\u002FSoundNinja","です。プロジェクトは",[26,87,90],{"href":88,"rel":89},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fblob\u002Fmain\u002FLICENSE",[30],"GPL-3.0","ライセンスです。",[17,93,94],{"id":94},"法的情報",[13,96,97,98,102],{},"インプリントと連絡先：",[26,99,101],{"href":100},"\u002Fimpressum","インプリント","。",{"title":104,"searchDepth":105,"depth":105,"links":106},"",2,[107,108,109,110,111],{"id":19,"depth":105,"text":19},{"id":46,"depth":105,"text":46},{"id":56,"depth":105,"text":56},{"id":76,"depth":105,"text":76},{"id":94,"depth":105,"text":94},"ヘルプの入手先とバグ報告。","md",{},true,8,"\u002Fsupport",{"title":5,"description":112},"support","T2BdU-sWENDKBxowzv9wjeevj1bEK3iit1IGD77Vz_M",[122,237,425,566,712,844,980,1200],{"id":123,"title":124,"body":125,"description":230,"extension":113,"meta":231,"navigation":115,"order":232,"path":233,"seo":234,"stem":235,"__hash__":236},"content_ja\u002Foverview.md","概要",{"type":7,"value":126,"toc":224},[127,129,132,135,138,141,157,160,190,193,200,203],[10,128,124],{"id":124},[13,130,131],{},"SoundNinjaは、ライブ配信、友だちとのチャット、ポッドキャスト収録向けのオープンソースサウンドボードです。Tauri v2とNuxt 4で構築されており、RAMとディスクの負荷を抑えています。",[13,133,134],{},"目標はシンプルです。巨大なサウンドライブラリをすばやく眺め、目的のクリップをミリ秒で再生すること。UIはVRのダッシュボードとしても使いやすいです。",[13,136,137],{},"SoundNinjaはまだ初期開発段階です。機能は動きますが、すべてのプラットフォームで完全に検証されているわけではありません。",[17,139,140],{"id":140},"対象ユーザー",[142,143,144,148,151,154],"ul",{},[145,146,147],"li",{},"即時のサウンドキューが必要な配信者",[145,149,150],{},"ボイスチャット用の共有ボードが欲しい友だち",[145,152,153],{},"クリップを録ってボードに置くポッドキャスター",[145,155,156],{},"カスタマイズ可能な、ローカル優先のサウンドボードが欲しい人",[17,158,159],{"id":159},"できること",[142,161,162,165,168,171,174,177,184,187],{},[145,163,164],{},"自分の音声ファイルからサウンドボードを作る",[145,166,167],{},"色付きタブ、グループ、検索で整理する",[145,169,170],{},"Theme Creatorで見た目をデザインする",[145,172,173],{},"Record EditorでPCオーディオまたはマイクを録音する",[145,175,176],{},"個別のサウンドにホットキーを割り当てる",[145,178,179,183],{},[26,180,182],{"href":181},"\u002Fdocs\u002Fremote-control","Bitfocus Companion","からサウンドをトリガーする",[145,185,186],{},"サウンドボード全体をインポート／エクスポートして共有する",[145,188,189],{},"サウンドボタンにGIFや画像を使う",[17,191,192],{"id":192},"ライセンス",[13,194,195,196,199],{},"SoundNinjaは",[26,197,90],{"href":88,"rel":198},[30],"のフリーソフトウェアです。フォーク、改変、共有できます。",[17,201,202],{"id":202},"次のステップ",[204,205,206,212,218],"ol",{},[145,207,208],{},[26,209,211],{"href":210},"\u002Fdocs\u002Finstallation","SoundNinjaをインストール",[145,213,214],{},[26,215,217],{"href":216},"\u002Fdocs\u002Fadding-sounds","サウンドを追加",[145,219,220],{},[26,221,223],{"href":222},"\u002Fdocs\u002Forganizing-sounds","ボードを整理",{"title":104,"searchDepth":105,"depth":105,"links":225},[226,227,228,229],{"id":140,"depth":105,"text":140},{"id":159,"depth":105,"text":159},{"id":192,"depth":105,"text":192},{"id":202,"depth":105,"text":202},"SoundNinjaとは何か、何ができるか。",{},1,"\u002Foverview",{"title":124,"description":230},"overview","KJDpLdg7ixvHWAtVFjPRaSTU7NMWgwE__i0PB3mQH3E",{"id":238,"title":239,"body":240,"description":419,"extension":113,"meta":420,"navigation":115,"order":105,"path":421,"seo":422,"stem":423,"__hash__":424},"content_ja\u002Finstallation.md","インストール",{"type":7,"value":241,"toc":412},[242,244,254,258,275,278,282,296,299,303,328,339,341,346,349,363,393,408],[10,243,239],{"id":239},[13,245,246,248,249,253],{},[26,247,66],{"href":65},"または",[26,250,72],{"href":251,"rel":252},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Freleases\u002Flatest",[30],"からビルドを入手してください。SoundNinjaは初期開発中なので、ビルドはベータとして扱ってください。",[17,255,257],{"id":256},"windows","Windows",[142,259,260,269,272],{},[145,261,262,263,39,266],{},"64ビットWindows向けの",[36,264,265],{},"インストーラー (.exe)",[36,267,268],{},"MSI (.msi)",[145,270,271],{},"ランディングページの対象：Windows 10以降",[145,273,274],{},"アプリのREADMEはWindows 8以上も記載",[13,276,277],{},"インストーラーを実行し、スタートメニューからSoundNinjaを起動します。",[17,279,281],{"id":280},"macos","macOS",[142,283,284,290,293],{},[145,285,286,287],{},"Apple SiliconとIntel向けの",[36,288,289],{},"ユニバーサル .dmg",[145,291,292],{},"ランディングページの対象：macOS 10.14以降",[145,294,295],{},"アプリのREADMEはmacOS 10.15以上を記載",[13,297,298],{},"ディスクイメージを開き、SoundNinjaをアプリケーションにドラッグします。",[17,300,302],{"id":301},"linux","Linux",[142,304,305,311,317,325],{},[145,306,307,308],{},"Ubuntu \u002F Debian向けの",[36,309,310],{},"Debian (.deb)",[145,312,313,314],{},"その他のディストリ向けの",[36,315,316],{},"AppImage",[145,318,319,320,324],{},"リリース公開後、ArchユーザーはAURから",[321,322,323],"code",{},"soundninja-bin","をインストールできます",[145,326,327],{},"Ubuntu 20.04でテスト済み",[13,329,330,331,334,335,338],{},"デスクトップビルドにはWebKitとGTKのパッケージが必要です。Debian\u002FUbuntuでは通常、",[321,332,333],{},"libwebkit2gtk","、",[321,336,337],{},"libgtk-3-0","、app-indicatorライブラリです。",[17,340,56],{"id":56},[13,342,59,343,345],{},[36,344,38],{}," を開きます。設定で起動時にSoundNinjaが確認するようにもできます。",[17,347,348],{"id":348},"ソースからビルド",[13,350,351,352,356,357,362],{},"カスタムビルドが必要なら、",[26,353,355],{"href":82,"rel":354},[30],"リポジトリ","をクローンし、",[26,358,361],{"href":359,"rel":360},"https:\u002F\u002Fv2.tauri.app\u002Fstart\u002Fprerequisites\u002F",[30],"Tauriの前提条件","を入れたうえで：",[364,365,369],"pre",{"className":366,"code":367,"language":368,"meta":104,"style":104},"language-bash shiki shiki-themes github-light github-dark","bun install\nbun run tauri:serve\n","bash",[321,370,371,383],{"__ignoreMap":104},[372,373,375,379],"span",{"class":374,"line":232},"line",[372,376,378],{"class":377},"sScJk","bun",[372,380,382],{"class":381},"sZZnC"," install\n",[372,384,385,387,390],{"class":374,"line":105},[372,386,378],{"class":377},[372,388,389],{"class":381}," run",[372,391,392],{"class":381}," tauri:serve\n",[13,394,395,334,398,334,401,404,405,102],{},[321,396,397],{},"npm",[321,399,400],{},"pnpm",[321,402,403],{},"deno","でも動きます。本番ビルド：",[321,406,407],{},"bun run tauri:build",[409,410,411],"style",{},"html pre.shiki code .sScJk, html code.shiki .sScJk{--shiki-default:#6F42C1;--shiki-dark:#B392F0}html pre.shiki code .sZZnC, html code.shiki .sZZnC{--shiki-default:#032F62;--shiki-dark:#9ECBFF}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html.dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}",{"title":104,"searchDepth":105,"depth":105,"links":413},[414,415,416,417,418],{"id":256,"depth":105,"text":257},{"id":280,"depth":105,"text":281},{"id":301,"depth":105,"text":302},{"id":56,"depth":105,"text":56},{"id":348,"depth":105,"text":348},"Windows、macOS、LinuxにSoundNinjaをインストール。",{},"\u002Finstallation",{"title":239,"description":419},"installation","PtsEiD1MtLz3wDVCCGAWac0JxyBztTW1uRBbWQWqSOs",{"id":426,"title":427,"body":428,"description":559,"extension":113,"meta":560,"navigation":115,"order":561,"path":562,"seo":563,"stem":564,"__hash__":565},"content_ja\u002Fadding-sounds.md","サウンドの追加",{"type":7,"value":429,"toc":551},[430,432,435,438,456,459,490,493,512,515,529,532,535,542,545],[10,431,427],{"id":427},[13,433,434],{},"クリップを追加するまで、ボードは空です。SoundNinjaはファイル、フォルダ全体、録音、共有サウンドボードパックをインポートできます。",[17,436,437],{"id":437},"音声ファイルをインポート",[204,439,440,450,453],{},[145,441,442,445,446,449],{},[36,443,444],{},"ファイル → 音声ファイルをインポート","、またはナビバーの ",[36,447,448],{},"インポート"," を使います。",[145,451,452],{},"1つ以上の音声ファイルを選びます。",[145,454,455],{},"サウンドは現在のタブに入ります。",[17,457,458],{"id":458},"フォルダをインポート",[204,460,461,470,473],{},[145,462,463,466,467,469],{},[36,464,465],{},"ファイル → フォルダをインポート","（またはナビバーの ",[36,468,458],{},"）。",[145,471,472],{},"1つ以上のフォルダを追加。インポート前にドラッグで並べ替えできます。",[145,474,475,476],{},"配置方法を選びます：\n",[142,477,478,484],{},[145,479,480,483],{},[36,481,482],{},"タブとしてインポート"," — 各フォルダが独自のタブになる",[145,485,486,489],{},[36,487,488],{},"現在のタブにインポート"," — すべてのファイルがアクティブなタブに入る",[17,491,492],{"id":492},"クリップを録音",[13,494,495,496,499,500,504,505,39,508,511],{},"プレイヤーバーの ",[36,497,498],{},"録音"," ボタンから",[26,501,503],{"href":502},"\u002Fdocs\u002Frecording-editor","Record Editor","を開きます。キャプチャ、トリムし、",[36,506,507],{},"選択をインポート",[36,509,510],{},"すべてインポート"," で現在のタブまたは選んだタブに入れます。",[17,513,514],{"id":514},"サウンドボードをインポート",[13,516,517,520,521,524,525,528],{},[36,518,519],{},"ファイル → サウンドボードをインポート"," で共有パックを読み込みます。パックは ",[321,522,523],{},"project.sninja"," とサウンドファイルを含む ",[321,526,527],{},".zip"," です。インポート後、プロジェクトを開いて再生します。",[13,530,531],{},"複数のプロジェクト（プロファイル）も保てます。プロジェクトセレクターでボードを切り替えます。",[17,533,534],{"id":534},"見つからないファイルを再リンク",[13,536,537,538,541],{},"ディスク上で音声ファイルが移動すると、SoundNinjaは ",[36,539,540],{},"見つからないサウンドファイル"," ダイアログを表示します。検索するフォルダを選び、クリップを再リンクします。",[17,543,544],{"id":544},"次へ",[13,546,547,548,102],{},"タブ、グループ、ホットキーの整理は",[26,549,550],{"href":222},"サウンドの整理",{"title":104,"searchDepth":105,"depth":105,"links":552},[553,554,555,556,557,558],{"id":437,"depth":105,"text":437},{"id":458,"depth":105,"text":458},{"id":492,"depth":105,"text":492},{"id":514,"depth":105,"text":514},{"id":534,"depth":105,"text":534},{"id":544,"depth":105,"text":544},"音声、フォルダ、録音、共有サウンドボードをインポート。",{},3,"\u002Fadding-sounds",{"title":427,"description":559},"adding-sounds","Fa08TvxAivFfa2zc5Ab8J5x_IO2j6rzWXGssNBY_HnY",{"id":567,"title":550,"body":568,"description":705,"extension":113,"meta":706,"navigation":115,"order":707,"path":708,"seo":709,"stem":710,"__hash__":711},"content_ja\u002Forganizing-sounds.md",{"type":7,"value":569,"toc":696},[570,572,575,578,603,610,613,616,630,637,640,646,649,659,662,665,669,672,678,684,688],[10,571,550],{"id":550},[13,573,574],{},"SoundNinjaは大規模ライブラリ向けです。タブ、グループ、検索、ホットキーで、必要なクリップをワンクリック（またはワンキー）で出せます。",[17,576,577],{"id":577},"タブ",[142,579,580,586,592],{},[145,581,582,585],{},[36,583,584],{},"タブを追加"," でタブを作り、色を付けてバーをすばやく眺められます。",[145,587,588,591],{},[36,589,590],{},"すべて"," ビューはタブを横断して全サウンドを表示します。",[145,593,594,595,598,599,602],{},"サウンドは ",[36,596,597],{},"1つ以上のタブ"," に所属できます。サウンドを右クリックし、",[36,600,601],{},"タブへ移動"," で割り当てます。",[13,604,605,606,609],{},"タブの切り替え演出は ",[36,607,608],{},"設定 → メイン","：スライド、フェード、ボタンを1つずつ、またはなし。",[17,611,612],{"id":612},"グループ",[13,614,615],{},"v0.5.3以降、セパレーターを名前付きグループにできます：",[142,617,618,621,624,627],{},[145,619,620],{},"コンテキストメニューからグループの追加、名前変更、削除",[145,622,623],{},"グループヘッダーをドラッグ — 子も一緒に動く",[145,625,626],{},"グループにサウンドを入れたり出したり",[145,628,629],{},"グループの枠線色、名前の色、ボタン配置を設定（またはタブのデフォルトを使う）",[13,631,632,633,636],{},"見た目の区切りだけなら、通常の ",[36,634,635],{},"セパレーター"," も追加できます。",[17,638,639],{"id":639},"検索",[13,641,642,643,645],{},"ナビバーの ",[36,644,639],{}," フィールドを使います。入力に合わせて結果が更新されます。",[17,647,648],{"id":648},"並べ替え",[13,650,651,654,655,658],{},[36,652,653],{},"設定 → 動作"," でドラッグ＆ドロップをオンにします（",[36,656,657],{},"並べ替えを許可","）。その後、サウンドとグループをドラッグして配置します。",[17,660,661],{"id":661},"一括編集",[13,663,664],{},"複数のサウンドを選び、色の変更、タブへの移動、削除を一度に行えます。",[17,666,668],{"id":667},"ホットキーとサウンドid","ホットキーとサウンドID",[13,670,671],{},"すべてのサウンドには8文字のIDがあります。ボタンのコンテキストメニュー、または複数選択のIDチップからコピーします。",[13,673,674,677],{},[36,675,676],{},"設定 → ホットキー"," を開き、キーをサウンドIDに割り当てます。グローバルホットキーは任意です。",[13,679,680,681,683],{},"同じIDを",[26,682,182],{"href":181},"がクリップのトリガーに使います。",[17,685,687],{"id":686},"gifと色","GIFと色",[13,689,690,691,695],{},"サウンドを右クリックして、ボタンごとの色やGIF \u002F 画像背景を設定します。ボード全体を整える",[26,692,694],{"href":693},"\u002Fdocs\u002Ftheme-editor","Theme Creator","とは別です。",{"title":104,"searchDepth":105,"depth":105,"links":697},[698,699,700,701,702,703,704],{"id":577,"depth":105,"text":577},{"id":612,"depth":105,"text":612},{"id":639,"depth":105,"text":639},{"id":648,"depth":105,"text":648},{"id":661,"depth":105,"text":661},{"id":667,"depth":105,"text":668},{"id":686,"depth":105,"text":687},"タブ、グループ、検索、一括編集、ホットキー。",{},4,"\u002Forganizing-sounds",{"title":550,"description":705},"organizing-sounds","0mH24BvA7-1dcjELHB8mQnjaQMzT8Ie60aamXtNUZEE",{"id":713,"title":714,"body":715,"description":837,"extension":113,"meta":838,"navigation":115,"order":839,"path":840,"seo":841,"stem":842,"__hash__":843},"content_ja\u002Ftheme-editor.md","テーマエディター",{"type":7,"value":716,"toc":831},[717,719,726,730,757,760,763,777,780,806,809,812,817],[10,718,714],{"id":714},[13,720,721,722,725],{},"Theme Creatorは、ボードの完全なビジュアルエディターです。",[36,723,724],{},"設定 → メイン → Theme Creator"," から開きます。",[17,727,729],{"id":728},"_3つのタブ","3つのタブ",[204,731,732,746,752],{},[145,733,734,737,738,741,742,745],{},[36,735,736],{},"一般"," — テーマ名、共有色、フォントのアップロード（",[321,739,740],{},".ttf"," \u002F ",[321,743,744],{},".otf","）",[145,747,748,751],{},[36,749,750],{},"ボタン"," — サウンドボタンの色、書体、レイアウト、GIFオーバーレイ",[145,753,754,756],{},[36,755,577],{}," — タブバーの色、書体、枠線の太さ",[13,758,759],{},"編集中、ライブプレビューがタブとボタンを表示します。",[17,761,762],{"id":762},"変更できる項目",[142,764,765,768,771,774],{},[145,766,767],{},"プライマリとアクセントの色、背景、ボタン色、タブ色",[145,769,770],{},"ボタンとタブのフォントファミリーとサイズ",[145,772,773],{},"ボタンの幅、半径、枠線幅、隙間、パディング",[145,775,776],{},"GIFオーバーレイの不透明度（通常とホバー）",[17,778,779],{"id":779},"保存と共有",[142,781,782,788,794,800],{},[145,783,784,787],{},[36,785,786],{},".cssをエクスポート"," — バックアップや友人への送信用テーマファイルを書き出す",[145,789,790,793],{},[36,791,792],{},"テーマに追加"," — Themesフォルダに保存して適用",[145,795,796,799],{},[36,797,798],{},".cssをインポート"," — 組み込みプリセットまたは保存済みテーマを読み込む",[145,801,802,805],{},[36,803,804],{},"リセット"," — SoundNinjaのデフォルトに戻す",[13,807,808],{},"未保存の変更があるままウィンドウを閉じると、SoundNinjaが先に保存を求めます。",[17,810,811],{"id":811},"フルエディターなしで",[13,813,814,816],{},[36,815,608],{}," でも次が可能です：",[142,818,819,822,828],{},[145,820,821],{},"リストからテーマを選ぶ",[145,823,824,825,745],{},"CSS変数をライブ編集する（",[36,826,827],{},"カスタムCSS",[145,829,830],{},"テーマファイルをThemesフォルダにインポートする",{"title":104,"searchDepth":105,"depth":105,"links":832},[833,834,835,836],{"id":728,"depth":105,"text":729},{"id":762,"depth":105,"text":762},{"id":779,"depth":105,"text":779},{"id":811,"depth":105,"text":811},"Theme Creatorで色、フォント、ボタン、タブをデザイン。",{},5,"\u002Ftheme-editor",{"title":714,"description":837},"theme-editor","tGeQE8HatAeqLeJ_3U4A-ac0RfIRzcoq-KghedjPolg",{"id":845,"title":846,"body":847,"description":973,"extension":113,"meta":974,"navigation":115,"order":975,"path":976,"seo":977,"stem":978,"__hash__":979},"content_ja\u002Frecording-editor.md","録音エディター",{"type":7,"value":848,"toc":967},[849,851,857,860,866,886,889,892,917,920,935,939,952,958],[10,850,846],{"id":846},[13,852,853,854,856],{},"SoundNinja内でクリップを録音し、トリムしてタブにインポートします。プレイヤーバーの ",[36,855,498],{}," ボタンでエディターを開きます。",[17,858,859],{"id":859},"入力を選ぶ",[13,861,862,865],{},[36,863,864],{},"設定 → オーディオ"," で：",[142,867,868,874,880],{},[145,869,870,873],{},[36,871,872],{},"入力デバイス"," — マイク",[145,875,876,879],{},[36,877,878],{},"出力デバイス（PCオーディオ）"," — PCが再生している音のループバック",[145,881,882,885],{},[36,883,884],{},"入力音量"," — キャプチャゲイン 0%〜200%",[13,887,888],{},"録音ボタンは、ここで選んだデバイスを使います。",[17,890,891],{"id":891},"テイクを編集",[142,893,894,897,900,908,911,914],{},[145,895,896],{},"録音と停止",[145,898,899],{},"入力レベルメーターを確認",[145,901,902,39,905],{},[36,903,904],{},"ノーマライズ",[36,906,907],{},"ノイズキャンセレーション",[145,909,910],{},"クリップ全体のトリム、選択範囲へのトリム、選択の削除",[145,912,913],{},"元に戻す \u002F やり直し",[145,915,916],{},"ズームインとズームアウト",[17,918,919],{"id":919},"ステージしてインポート",[204,921,922,925,928],{},[145,923,924],{},"選択範囲またはトラック全体をステージングリストに追加します。",[145,926,927],{},"リストは空から始まります。録音、編集、それからクリップを追加。",[145,929,930,39,932,934],{},[36,931,507],{},[36,933,510],{}," で、現在のタブまたは選んだタブに入れます。",[17,936,938],{"id":937},"ステム分離任意","ステム分離（任意）",[13,940,941,942,39,945,948,949,102],{},"Record EditorはBS-RoFormerで ",[36,943,944],{},"ボーカル",[36,946,947],{},"音楽"," を残せます。モデルは約158 MBで、アプリには ",[36,950,951],{},"同梱されていません",[13,953,954,957],{},[36,955,956],{},"設定 → ステム分離"," からダウンロードするか、初回起動のプロンプトを承認します。Windowsインストーラーも初回起動時にモデルのダウンロードを案内できます。",[13,959,960,961,741,964,469],{},"ソースからのステムビルドには追加フラグが必要です（",[321,962,963],{},"tauri:serve:stems",[321,965,966],{},"tauri:build:stems",{"title":104,"searchDepth":105,"depth":105,"links":968},[969,970,971,972],{"id":859,"depth":105,"text":859},{"id":891,"depth":105,"text":891},{"id":919,"depth":105,"text":919},{"id":937,"depth":105,"text":938},"マイクまたはPCオーディオを取り込み、クリップを編集してボードに置く。",{},6,"\u002Frecording-editor",{"title":846,"description":973},"recording-editor","fkw2G1vYZhqRZ8t2Y9irOID6H-BdjzVV8fvv-hE_qbo",{"id":981,"title":982,"body":983,"description":1193,"extension":113,"meta":1194,"navigation":115,"order":1195,"path":1196,"seo":1197,"stem":1198,"__hash__":1199},"content_ja\u002Fremote-control.md","リモートコントロール",{"type":7,"value":984,"toc":1186},[985,987,990,993,1024,1027,1030,1064,1067,1087,1090,1093,1125,1129,1135],[10,986,982],{"id":982},[13,988,989],{},"SoundNinjaはローカルネットワークで待ち受け、Bitfocus Companion（または任意のHTTP\u002FWebSocketクライアント）がサウンドを再生・停止できます。",[17,991,992],{"id":992},"リモートサーバーを有効化",[204,994,995,1001,1008,1015],{},[145,996,997,1000],{},[36,998,999],{},"設定 → リモート"," を開きます。",[145,1002,1003,1004,1007],{},"リモートサーバーを有効にします。デフォルトポートは ",[36,1005,1006],{},"7331"," です。",[145,1009,1010,1011,1014],{},"任意：トークンを設定。クライアントはBearerトークンまたは ",[321,1012,1013],{},"?token="," で送ります。",[145,1016,1017,1020,1021,1023],{},[321,1018,1019],{},"http:\u002F\u002FIP:PORT"," URLをコピーするか、",[36,1022,42],{}," からシステムIPをコピーします。",[13,1025,1026],{},"Windowsはサーバー初回起動時にファイアウォールの確認を出すことがあります。プライベートネットワークのアクセスを許可してください。",[17,1028,182],{"id":1029},"bitfocus-companion",[204,1031,1032,1039,1047,1058],{},[145,1033,1034,1038],{},[26,1035,182],{"href":1036,"rel":1037},"https:\u002F\u002Fbitfocus.io\u002Fcompanion",[30],"をインストールします。",[145,1040,1041,1046],{},[26,1042,1045],{"href":1043,"rel":1044},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Freleases\u002Flatest\u002Fdownload\u002Fcompanion-module-soundninja.tgz",[30],"companion-module-soundninja.tgz"," をダウンロード。Companion Storeのパッケージはまだありません。",[145,1048,1049,1050,1053,1054,1057],{},"Companionで ",[36,1051,1052],{},"Modules → Load module package"," を開き、",[321,1055,1056],{},".tgz"," を選びます。",[145,1059,1060,1063],{},[36,1061,1062],{},"Sound Ninja"," 接続を追加。PCのIP、ポート、設定したトークンを貼り付けます。",[17,1065,1066],{"id":1066},"アクション",[142,1068,1069,1075,1081],{},[145,1070,1071,1074],{},[36,1072,1073],{},"Trigger Sound"," — ライブドロップダウンから選ぶか、8文字のサウンドIDを入力（Companion変数が使えます）",[145,1076,1077,1080],{},[36,1078,1079],{},"Stop Sound"," — IDで再生中のサウンドを1つ停止",[145,1082,1083,1086],{},[36,1084,1085],{},"Stop All"," — 再生中の全サウンドを停止",[13,1088,1089],{},"SoundNinjaでは、ボタンのコンテキストメニューまたは複数選択のIDチップからサウンドIDをコピーします。",[17,1091,1092],{"id":1092},"フィードバックと変数",[142,1094,1095,1101,1113,1119],{},[145,1096,1097,1100],{},[36,1098,1099],{},"Sound Playing"," — そのサウンドIDがアクティブな間はtrue（ボタン色に使う）",[145,1102,1103,1106,1107,741,1110],{},[321,1104,1105],{},"$(soundninja:connected)"," — ",[321,1108,1109],{},"true",[321,1111,1112],{},"false",[145,1114,1115,1118],{},[321,1116,1117],{},"$(soundninja:playing_count)"," — 再生中のサウンド数",[145,1120,1121,1124],{},[321,1122,1123],{},"$(soundninja:last_triggered)"," — 最後にトリガーしたサウンドID",[17,1126,1128],{"id":1127},"http-api上級","HTTP API（上級）",[13,1130,1131,1132],{},"ベースパス：",[321,1133,1134],{},"\u002Fapi\u002Fv1",[142,1136,1137,1143,1149,1155,1165,1171,1180],{},[145,1138,1139,1142],{},[321,1140,1141],{},"GET \u002Finfo"," — アプリ名、バージョン、プロトコル、トークンが必要か",[145,1144,1145,1148],{},[321,1146,1147],{},"GET \u002Fsounds"," — サウンド一覧（id、name、tabs、active）",[145,1150,1151,1154],{},[321,1152,1153],{},"GET \u002Fstate"," — サウンドと現在再生中のID",[145,1156,1157,1160,1161,1164],{},[321,1158,1159],{},"POST \u002Ftrigger"," に ",[321,1162,1163],{},"{ \"id\" }"," — サウンドを再生",[145,1166,1167,1170],{},[321,1168,1169],{},"GET \u002Ftrigger\u002F:id"," — 再生（ブラウザで簡単にテスト）",[145,1172,1173,1176,1177,1179],{},[321,1174,1175],{},"POST \u002Fstop"," に任意の ",[321,1178,1163],{}," — 1つまたはすべて停止",[145,1181,1182,1185],{},[321,1183,1184],{},"GET \u002Fws"," — ライブ状態。trigger\u002Fstopコマンドを受信",{"title":104,"searchDepth":105,"depth":105,"links":1187},[1188,1189,1190,1191,1192],{"id":992,"depth":105,"text":992},{"id":1029,"depth":105,"text":182},{"id":1066,"depth":105,"text":1066},{"id":1092,"depth":105,"text":1092},{"id":1127,"depth":105,"text":1128},"ローカルネットワーク経由でBitfocus CompanionからSoundNinjaを操作。",{},7,"\u002Fremote-control",{"title":982,"description":1193},"remote-control","PoAD2qLfe4cF4Z_a5pIF5291-yAlbNAcy3yNZfTB5RM",{"id":4,"title":5,"body":1201,"description":112,"exte