[{"data":1,"prerenderedAt":1526},["ShallowReactive",2],{"docs-page-ja-\u002Fsupport":3,"docs-nav-ja":121},{"id":4,"title":5,"body":6,"description":112,"extension":113,"meta":114,"navigation":115,"order":116,"path":117,"seo":118,"stem":119,"__hash__":120},"content_ja\u002Fsupport.md","サポート",{"type":7,"value":8,"toc":103},"minimark",[9,12,16,20,23,32,44,47,54,57,74,77,92,95],[10,11,5],"h1",{"id":5},[13,14,15],"p",{},"SoundNinjaは初期ベータのコミュニティプロジェクトです。いちばん早い助けはGitHubです。",[17,18,19],"h2",{"id":19},"バグ報告または質問",[13,21,22],{},"GitHubでissueを開いてください：",[13,24,25],{},[26,27,31],"a",{"href":28,"rel":29},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fissues",[30],"nofollow","github.com\u002Fmarcus-universe\u002FSoundNinja\u002Fissues",[13,33,34,35,39,40,43],{},"OS、SoundNinjaのバージョン（",[36,37,38],"strong",{},"ヘルプ → アップデートを確認"," または ",[36,41,42],{},"設定 → 情報","）、再現手順を書いてください。",[17,45,46],{"id":46},"メール",[13,48,49,50],{},"メンテナー連絡先：",[26,51,53],{"href":52},"mailto:contact@marcus-universe.de","contact@marcus-universe.de",[17,55,56],{"id":56},"アップデート",[13,58,59,60,62,63,67,68,73],{},"アプリ内で ",[36,61,38],{}," を使います。新しいビルドは",[26,64,66],{"href":65},"\u002Fdownload","ダウンロードページ","と",[26,69,72],{"href":70,"rel":71},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Freleases",[30],"GitHub Releases","にも出ます。",[17,75,76],{"id":76},"コントリビュート",[13,78,79,80,85,86,91],{},"プルリクエストを歓迎します。アプリのリポジトリは",[26,81,84],{"href":82,"rel":83},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja",[30],"github.com\u002Fmarcus-universe\u002FSoundNinja","です。プロジェクトは",[26,87,90],{"href":88,"rel":89},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fblob\u002Fmain\u002FLICENSE",[30],"GPL-3.0","ライセンスです。",[17,93,94],{"id":94},"法的情報",[13,96,97,98,102],{},"インプリントと連絡先：",[26,99,101],{"href":100},"\u002Fimpressum","インプリント","。",{"title":104,"searchDepth":105,"depth":105,"links":106},"",2,[107,108,109,110,111],{"id":19,"depth":105,"text":19},{"id":46,"depth":105,"text":46},{"id":56,"depth":105,"text":56},{"id":76,"depth":105,"text":76},{"id":94,"depth":105,"text":94},"ヘルプの入手先とバグ報告。","md",{},true,8,"\u002Fsupport",{"title":5,"description":112},"support","T2BdU-sWENDKBxowzv9wjeevj1bEK3iit1IGD77Vz_M",[122,246,437,578,969,1101,1242,1462],{"id":123,"title":124,"body":125,"description":239,"extension":113,"meta":240,"navigation":115,"order":241,"path":242,"seo":243,"stem":244,"__hash__":245},"content_ja\u002Foverview.md","概要",{"type":7,"value":126,"toc":233},[127,129,132,135,138,141,157,160,199,202,209,212],[10,128,124],{"id":124},[13,130,131],{},"SoundNinjaは、ライブ配信、友だちとのチャット、ポッドキャスト収録向けのオープンソースサウンドボードです。Tauri v2とNuxt 4で構築されており、RAMとディスクの負荷を抑えています。",[13,133,134],{},"目標はシンプルです。巨大なサウンドライブラリをすばやく眺め、目的のクリップをミリ秒で再生すること。UIはVRのダッシュボードとしても使いやすいです。",[13,136,137],{},"SoundNinjaはまだ初期開発段階です。機能は動きますが、すべてのプラットフォームで完全に検証されているわけではありません。",[17,139,140],{"id":140},"対象ユーザー",[142,143,144,148,151,154],"ul",{},[145,146,147],"li",{},"即時のサウンドキューが必要な配信者",[145,149,150],{},"ボイスチャット用の共有ボードが欲しい友だち",[145,152,153],{},"クリップを録ってボードに置くポッドキャスター",[145,155,156],{},"カスタマイズ可能な、ローカル優先のサウンドボードが欲しい人",[17,158,159],{"id":159},"できること",[142,161,162,165,168,171,174,177,180,183,186,193,196],{},[145,163,164],{},"自分の音声ファイルからサウンドボードを作る",[145,166,167],{},"色付きタブ、グループ、タグ、検索で整理する",[145,169,170],{},"タグでフィルター（OR）、名前・日付・長さ・サイズでソート",[145,172,173],{},"マーキーまたはShift範囲で複数選択し、色・移動・削除を一括",[145,175,176],{},"コンテキストメニューでサウンドごとの音量を設定",[145,178,179],{},"Theme Creatorで見た目をデザインする",[145,181,182],{},"Record EditorでPCオーディオまたはマイクを録音する",[145,184,185],{},"個別のサウンドにホットキーを割り当てる",[145,187,188,192],{},[26,189,191],{"href":190},"\u002Fdocs\u002Fremote-control","Bitfocus Companion","からサウンドをトリガーする",[145,194,195],{},"サウンドボード全体をインポート／エクスポートして共有する",[145,197,198],{},"サウンドボタンにGIFや画像を使う — ローカルフォルダライブラリまたはKLIPY",[17,200,201],{"id":201},"ライセンス",[13,203,204,205,208],{},"SoundNinjaは",[26,206,90],{"href":88,"rel":207},[30],"のフリーソフトウェアです。フォーク、改変、共有できます。",[17,210,211],{"id":211},"次のステップ",[213,214,215,221,227],"ol",{},[145,216,217],{},[26,218,220],{"href":219},"\u002Fdocs\u002Finstallation","SoundNinjaをインストール",[145,222,223],{},[26,224,226],{"href":225},"\u002Fdocs\u002Fadding-sounds","サウンドを追加",[145,228,229],{},[26,230,232],{"href":231},"\u002Fdocs\u002Forganizing-sounds","ボードを整理",{"title":104,"searchDepth":105,"depth":105,"links":234},[235,236,237,238],{"id":140,"depth":105,"text":140},{"id":159,"depth":105,"text":159},{"id":201,"depth":105,"text":201},{"id":211,"depth":105,"text":211},"SoundNinjaとは何か、何ができるか。",{},1,"\u002Foverview",{"title":124,"description":239},"overview","c8xWgFwxVyANkJ28nfjNkL8am61Nn8aDvVh7jKzMyKM",{"id":247,"title":248,"body":249,"description":431,"extension":113,"meta":432,"navigation":115,"order":105,"path":433,"seo":434,"stem":435,"__hash__":436},"content_ja\u002Finstallation.md","インストール",{"type":7,"value":250,"toc":424},[251,253,263,267,287,290,294,308,311,315,340,351,353,358,361,375,405,420],[10,252,248],{"id":248},[13,254,255,257,258,262],{},[26,256,66],{"href":65},"または",[26,259,72],{"href":260,"rel":261},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Freleases\u002Flatest",[30],"からビルドを入手してください。SoundNinjaは初期開発中なので、ビルドはベータとして扱ってください。",[17,264,266],{"id":265},"windows","Windows",[142,268,269,278,281,284],{},[145,270,271,272,39,275],{},"64ビットWindows向けの",[36,273,274],{},"インストーラー (.exe)",[36,276,277],{},"MSI (.msi)",[145,279,280],{},"ランディングページの対象：Windows 10以降",[145,282,283],{},"アプリのREADMEはWindows 8以上も記載",[145,285,286],{},"NSISインストーラーはダークテーマ。セットアップ時に言語を選ぶと、次回起動時にSoundNinjaが覚えます。",[13,288,289],{},"インストーラーを実行し、スタートメニューからSoundNinjaを起動します。",[17,291,293],{"id":292},"macos","macOS",[142,295,296,302,305],{},[145,297,298,299],{},"Apple SiliconとIntel向けの",[36,300,301],{},"ユニバーサル .dmg",[145,303,304],{},"ランディングページの対象：macOS 10.14以降",[145,306,307],{},"アプリのREADMEはmacOS 10.15以上を記載",[13,309,310],{},"ディスクイメージを開き、SoundNinjaをアプリケーションにドラッグします。",[17,312,314],{"id":313},"linux","Linux",[142,316,317,323,329,337],{},[145,318,319,320],{},"Ubuntu \u002F Debian向けの",[36,321,322],{},"Debian (.deb)",[145,324,325,326],{},"その他のディストリ向けの",[36,327,328],{},"AppImage",[145,330,331,332,336],{},"リリース公開後、ArchユーザーはAURから",[333,334,335],"code",{},"soundninja-bin","をインストールできます",[145,338,339],{},"Ubuntu 20.04でテスト済み",[13,341,342,343,346,347,350],{},"デスクトップビルドにはWebKitとGTKのパッケージが必要です。Debian\u002FUbuntuでは通常、",[333,344,345],{},"libwebkit2gtk","、",[333,348,349],{},"libgtk-3-0","、app-indicatorライブラリです。",[17,352,56],{"id":56},[13,354,59,355,357],{},[36,356,38],{}," を開きます。設定で起動時にSoundNinjaが確認するようにもできます。",[17,359,360],{"id":360},"ソースからビルド",[13,362,363,364,368,369,374],{},"カスタムビルドが必要なら、",[26,365,367],{"href":82,"rel":366},[30],"リポジトリ","をクローンし、",[26,370,373],{"href":371,"rel":372},"https:\u002F\u002Fv2.tauri.app\u002Fstart\u002Fprerequisites\u002F",[30],"Tauriの前提条件","を入れたうえで：",[376,377,381],"pre",{"className":378,"code":379,"language":380,"meta":104,"style":104},"language-bash shiki shiki-themes github-light github-dark","bun install\nbun run tauri:serve\n","bash",[333,382,383,395],{"__ignoreMap":104},[384,385,387,391],"span",{"class":386,"line":241},"line",[384,388,390],{"class":389},"sScJk","bun",[384,392,394],{"class":393},"sZZnC"," install\n",[384,396,397,399,402],{"class":386,"line":105},[384,398,390],{"class":389},[384,400,401],{"class":393}," run",[384,403,404],{"class":393}," tauri:serve\n",[13,406,407,346,410,346,413,416,417,102],{},[333,408,409],{},"npm",[333,411,412],{},"pnpm",[333,414,415],{},"deno","でも動きます。本番ビルド：",[333,418,419],{},"bun run tauri:build",[421,422,423],"style",{},"html pre.shiki code .sScJk, html code.shiki .sScJk{--shiki-default:#6F42C1;--shiki-dark:#B392F0}html pre.shiki code .sZZnC, html code.shiki .sZZnC{--shiki-default:#032F62;--shiki-dark:#9ECBFF}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html.dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}",{"title":104,"searchDepth":105,"depth":105,"links":425},[426,427,428,429,430],{"id":265,"depth":105,"text":266},{"id":292,"depth":105,"text":293},{"id":313,"depth":105,"text":314},{"id":56,"depth":105,"text":56},{"id":360,"depth":105,"text":360},"Windows、macOS、LinuxにSoundNinjaをインストール。",{},"\u002Finstallation",{"title":248,"description":431},"installation","Y0LyjIaCaa6QDprLZ1KDPjTfWKBUFvFm5ERbBT-RfpY",{"id":438,"title":439,"body":440,"description":571,"extension":113,"meta":572,"navigation":115,"order":573,"path":574,"seo":575,"stem":576,"__hash__":577},"content_ja\u002Fadding-sounds.md","サウンドの追加",{"type":7,"value":441,"toc":563},[442,444,447,450,468,471,502,505,524,527,541,544,547,554,557],[10,443,439],{"id":439},[13,445,446],{},"クリップを追加するまで、ボードは空です。SoundNinjaはファイル、フォルダ全体、録音、共有サウンドボードパックをインポートできます。",[17,448,449],{"id":449},"音声ファイルをインポート",[213,451,452,462,465],{},[145,453,454,457,458,461],{},[36,455,456],{},"ファイル → 音声ファイルをインポート","、またはナビバーの ",[36,459,460],{},"インポート"," を使います。",[145,463,464],{},"1つ以上の音声ファイルを選びます。",[145,466,467],{},"サウンドは現在のタブに入ります。",[17,469,470],{"id":470},"フォルダをインポート",[213,472,473,482,485],{},[145,474,475,478,479,481],{},[36,476,477],{},"ファイル → フォルダをインポート","（またはナビバーの ",[36,480,470],{},"）。",[145,483,484],{},"1つ以上のフォルダを追加。インポート前にドラッグで並べ替えできます。",[145,486,487,488],{},"配置方法を選びます：\n",[142,489,490,496],{},[145,491,492,495],{},[36,493,494],{},"タブとしてインポート"," — 各フォルダが独自のタブになる",[145,497,498,501],{},[36,499,500],{},"現在のタブにインポート"," — すべてのファイルがアクティブなタブに入る",[17,503,504],{"id":504},"クリップを録音",[13,506,507,508,511,512,516,517,39,520,523],{},"プレイヤーバーの ",[36,509,510],{},"録音"," ボタンから",[26,513,515],{"href":514},"\u002Fdocs\u002Frecording-editor","Record Editor","を開きます。キャプチャ、トリムし、",[36,518,519],{},"選択をインポート",[36,521,522],{},"すべてインポート"," で現在のタブまたは選んだタブに入れます。",[17,525,526],{"id":526},"サウンドボードをインポート",[13,528,529,532,533,536,537,540],{},[36,530,531],{},"ファイル → サウンドボードをインポート"," で共有パックを読み込みます。パックは ",[333,534,535],{},"project.sninja"," とサウンドファイルを含む ",[333,538,539],{},".zip"," です。インポート後、プロジェクトを開いて再生します。",[13,542,543],{},"複数のプロジェクト（プロファイル）も保てます。プロジェクトセレクターでボードを切り替えます。",[17,545,546],{"id":546},"見つからないファイルを再リンク",[13,548,549,550,553],{},"ディスク上で音声ファイルが移動すると、SoundNinjaは ",[36,551,552],{},"見つからないサウンドファイル"," ダイアログを表示します。検索するフォルダを選び、クリップを再リンクします。",[17,555,556],{"id":556},"次へ",[13,558,559,560,102],{},"タブ、タグ、フィルター、ホットキーの整理は",[26,561,562],{"href":231},"サウンドの整理",{"title":104,"searchDepth":105,"depth":105,"links":564},[565,566,567,568,569,570],{"id":449,"depth":105,"text":449},{"id":470,"depth":105,"text":470},{"id":504,"depth":105,"text":504},{"id":526,"depth":105,"text":526},{"id":546,"depth":105,"text":546},{"id":556,"depth":105,"text":556},"音声、フォルダ、録音、共有サウンドボードをインポート。",{},3,"\u002Fadding-sounds",{"title":439,"description":571},"adding-sounds","5_cjd2COcPz0pj4ZrBehCZv6ouzBimE8UGjkcfngQjw",{"id":579,"title":562,"body":580,"description":962,"extension":113,"meta":963,"navigation":115,"order":964,"path":965,"seo":966,"stem":967,"__hash__":968},"content_ja\u002Forganizing-sounds.md",{"type":7,"value":581,"toc":947},[582,584,591,594,619,626,629,632,646,653,659,663,673,677,707,710,716,719,753,760,764,767,793,796,800,813,816,821,842,858,865,868,879,882,886,893,903,909,912,920,927,944],[10,583,562],{"id":562},[13,585,586,587,590],{},"SoundNinjaは大規模ライブラリ向けです。",[36,588,589],{},"タグとフィルター","、タブ、検索、複数選択、ホットキーで、必要なクリップをワンクリック（またはワンキー）で出せます。",[17,592,593],{"id":593},"タブ",[142,595,596,602,608],{},[145,597,598,601],{},[36,599,600],{},"タブを追加"," でタブを作り、色を付けてバーをすばやく眺められます。",[145,603,604,607],{},[36,605,606],{},"すべて"," ビューはタブを横断して全サウンドを表示します。",[145,609,610,611,614,615,618],{},"サウンドは ",[36,612,613],{},"1つ以上のタブ"," に所属できます。サウンドを右クリックし、",[36,616,617],{},"タブへ移動"," で割り当てます。",[13,620,621,622,625],{},"タブの切り替え演出は ",[36,623,624],{},"設定 → メイン","：スライド、フェード、ボタンを1つずつ、またはなし。",[17,627,628],{"id":628},"グループ",[13,630,631],{},"v0.5.3以降、セパレーターを名前付きグループにできます：",[142,633,634,637,640,643],{},[145,635,636],{},"コンテキストメニューからグループの追加、名前変更、削除",[145,638,639],{},"グループヘッダーをドラッグ — 子も一緒に動く",[145,641,642],{},"グループにサウンドを入れたり出したり",[145,644,645],{},"グループの枠線色、名前の色、ボタン配置を設定（またはタブのデフォルトを使う）",[13,647,648,649,652],{},"見た目の区切りだけなら、通常の ",[36,650,651],{},"セパレーター"," も追加できます。",[13,654,655,656,102],{},"ボードの空き領域を右クリックして ",[36,657,658],{},"グループを追加",[17,660,662],{"id":661},"タグ-フィルター","タグ \u002F フィルター",[13,664,665,666,669,670,672],{},"タグはタブを横断します。スライドアウトの ",[36,667,668],{},"フィルター"," パネル（サイドバー ",[36,671,668],{},"）で作成し、ボードを絞ります。",[674,675,676],"h3",{"id":676},"タグの作成と編集",[213,678,679,685,695,701],{},[145,680,681,682,684],{},"サイドバーで ",[36,683,668],{}," を開く。",[145,686,687,690,691,694],{},[36,688,689],{},"タグ"," の ",[36,692,693],{},"タグを追加"," — 名前と色を付ける。",[145,696,697,698,102],{},"同じリストで名前変更、色変更、",[36,699,700],{},"タグを削除",[145,702,703,706],{},[36,704,705],{},"タグはまだありません"," と出たら、割り当てる前にここで追加する。",[674,708,709],{"id":709},"サウンドにタグを付ける",[13,711,712,713,715],{},"サウンドを右クリック → ",[36,714,689],{},"（チェックボックス）。1つのサウンドに複数可。タグが無い場合、メニューはフィルターパネルへ案内します。",[674,717,718],{"id":718},"ボードをフィルター",[142,720,721,728,739,750],{},[145,722,723,724,727],{},"フィルターパネル、または ",[36,725,726],{},"検索バー下のチップ"," でタグを切り替え。",[145,729,730,731,734,735,738],{},"一致は ",[36,732,733],{},"OR","：選択したタグの ",[36,736,737],{},"いずれか"," を持つサウンドが表示される。",[145,740,741,742,745,746,749],{},"ナビバーの ",[36,743,744],{},"検索"," は有効なタグフィルターと ",[36,747,748],{},"AND","（入力 + タグ）。",[145,751,752],{},"チップをオフ（またはフィルター解除）でタブ全体を再表示。",[13,754,755,756,759],{},"色付きタグ名をボタンに表示できます。",[36,757,758],{},"設定 → 動作 → タグバッジを表示"," で切り替え。",[17,761,763],{"id":762},"並べ替えソート","並べ替え（ソート）",[13,765,766],{},"フィルターパネルでソートモードを選びます：",[142,768,769,775],{},[145,770,771,774],{},[36,772,773],{},"ユーザー定義"," — タブ順、グループ表示",[145,776,777,346,780,346,783,346,786,789,790],{},[36,778,779],{},"名前",[36,781,782],{},"追加日時",[36,784,785],{},"再生時間",[36,787,788],{},"ファイルサイズ"," — フラットなソート一覧。これらのモードでは ",[36,791,792],{},"グループは非表示",[13,794,795],{},"再生時間ソートは、初回に長さのメタデータを準備することがあります。",[17,797,799],{"id":798},"並べ替えドラッグ","並べ替え（ドラッグ）",[13,801,802,805,806,809,810,812],{},[36,803,804],{},"設定 → 動作"," でドラッグ＆ドロップをオンにします（",[36,807,808],{},"並べ替えを許可","）。その後、サウンドとグループをドラッグして配置します。ドラッグ並べ替えは ",[36,811,773],{}," ソートで有効です。",[17,814,815],{"id":815},"複数選択",[13,817,741,818,820],{},[36,819,815],{}," をオンにして：",[142,822,823,826,832,839],{},[145,824,825],{},"クリックでサウンドをトグル",[145,827,828,831],{},[36,829,830],{},"Shift+クリック"," で直前のアンカーから範囲選択",[145,833,834,835,838],{},"空きボード上で ",[36,836,837],{},"マーキー"," をドラッグ",[145,840,841],{},"空きボード（または外側）をクリックして選択解除",[13,843,844,845,346,848,346,851,346,854,857],{},"一括バーに件数が表示され、",[36,846,847],{},"色",[36,849,850],{},"タブへ移動…",[36,852,853],{},"削除",[36,855,856],{},"完了"," が使えます。",[13,859,860,861,864],{},"複数選択中、各ボタンに ",[36,862,863],{},"8文字のIDチップ"," が出ます。チップを右クリックでコピー。",[17,866,867],{"id":867},"サウンドごとの音量",[13,869,870,871,874,875,878],{},"右クリック → ",[36,872,873],{},"音量","。スライダーを 0%〜100%。",[36,876,877],{},"ダブルクリック"," で 100% にリセット。",[13,880,881],{},"設定のマスター出力音量と重ねて効きます。",[17,883,885],{"id":884},"ホットキーとサウンドid","ホットキーとサウンドID",[13,887,888,889,892],{},"すべてのサウンドには8文字のIDがあります。ボタンのコンテキストメニュー（",[36,890,891],{},"IDをコピー","）、または複数選択のIDチップからコピーします。",[13,894,895,898,899,902],{},[36,896,897],{},"設定 → ホットキー"," を開き、キーをサウンドIDに割り当てます。グローバルホットキーは任意です。コンテキストメニューの ",[36,900,901],{},"ホットキーを割り当て"," は、IDを埋めた状態でそこにジャンプします。",[13,904,905,906,908],{},"同じIDを",[26,907,191],{"href":190},"がクリップのトリガーに使います。",[17,910,911],{"id":911},"背景画像と色",[13,913,914,915,919],{},"サウンドを右クリックして、ボタンごとの色や背景画像を設定します。ボード全体を整える",[26,916,918],{"href":917},"\u002Fdocs\u002Ftheme-editor","Theme Creator","とは別です。",[13,921,922,923,926],{},"ピッカーは ",[36,924,925],{},"背景画像"," ダイアログ（PNG、JPEG、GIF、WebP）：",[142,928,929,935],{},[145,930,931,934],{},[36,932,933],{},"ローカルファイル"," — フォルダ追加、単一ファイル選択、ファイル名検索、グリッドプレビュー、ライブラリからフォルダ削除",[145,936,937,940,941,943],{},[36,938,939],{},"KLIPY"," — オンラインGIFを検索。APIキーは ",[36,942,804],{},"。キーはプロジェクトファイルには保存されません。",[13,945,946],{},"画像を選んだあと、ボタン上でパンとクロップできます。",{"title":104,"searchDepth":105,"depth":105,"links":948},[949,950,951,956,957,958,959,960,961],{"id":593,"depth":105,"text":593},{"id":628,"depth":105,"text":628},{"id":661,"depth":105,"text":662,"children":952},[953,954,955],{"id":676,"depth":573,"text":676},{"id":709,"depth":573,"text":709},{"id":718,"depth":573,"text":718},{"id":762,"depth":105,"text":763},{"id":798,"depth":105,"text":799},{"id":815,"depth":105,"text":815},{"id":867,"depth":105,"text":867},{"id":884,"depth":105,"text":885},{"id":911,"depth":105,"text":911},"タグ、フィルター、タブ、グループ、並べ替え、複数選択、音量、ホットキー。",{},4,"\u002Forganizing-sounds",{"title":562,"description":962},"organizing-sounds","PGqVreiuZb1jRxkXIW9tv66PvwPYs2iRx5-4j_D8sho",{"id":970,"title":971,"body":972,"description":1094,"extension":113,"meta":1095,"navigation":115,"order":1096,"path":1097,"seo":1098,"stem":1099,"__hash__":1100},"content_ja\u002Ftheme-editor.md","テーマエディター",{"type":7,"value":973,"toc":1088},[974,976,983,987,1014,1017,1020,1034,1037,1063,1066,1069,1074],[10,975,971],{"id":971},[13,977,978,979,982],{},"Theme Creatorは、ボードの完全なビジュアルエディターです。",[36,980,981],{},"設定 → メイン → Theme Creator"," から開きます。",[17,984,986],{"id":985},"_3つのタブ","3つのタブ",[213,988,989,1003,1009],{},[145,990,991,994,995,998,999,1002],{},[36,992,993],{},"一般"," — テーマ名、共有色、フォントのアップロード（",[333,996,997],{},".ttf"," \u002F ",[333,1000,1001],{},".otf","）",[145,1004,1005,1008],{},[36,1006,1007],{},"ボタン"," — サウンドボタンの色、書体、レイアウト、GIFオーバーレイ",[145,1010,1011,1013],{},[36,1012,593],{}," — タブバーの色、書体、枠線の太さ",[13,1015,1016],{},"編集中、ライブプレビューがタブとボタンを表示します。",[17,1018,1019],{"id":1019},"変更できる項目",[142,1021,1022,1025,1028,1031],{},[145,1023,1024],{},"プライマリとアクセントの色、背景、ボタン色、タブ色",[145,1026,1027],{},"ボタンとタブのフォントファミリーとサイズ",[145,1029,1030],{},"ボタンの幅、半径、枠線幅、隙間、パディング",[145,1032,1033],{},"GIFオーバーレイの不透明度（通常とホバー）",[17,1035,1036],{"id":1036},"保存と共有",[142,1038,1039,1045,1051,1057],{},[145,1040,1041,1044],{},[36,1042,1043],{},".cssをエクスポート"," — バックアップや友人への送信用テーマファイルを書き出す",[145,1046,1047,1050],{},[36,1048,1049],{},"テーマに追加"," — Themesフォルダに保存して適用",[145,1052,1053,1056],{},[36,1054,1055],{},".cssをインポート"," — 組み込みプリセットまたは保存済みテーマを読み込む",[145,1058,1059,1062],{},[36,1060,1061],{},"リセット"," — SoundNinjaのデフォルトに戻す",[13,1064,1065],{},"未保存の変更があるままウィンドウを閉じると、SoundNinjaが先に保存を求めます。",[17,1067,1068],{"id":1068},"フルエディターなしで",[13,1070,1071,1073],{},[36,1072,624],{}," でも次が可能です：",[142,1075,1076,1079,1085],{},[145,1077,1078],{},"リストからテーマを選ぶ",[145,1080,1081,1082,1002],{},"CSS変数をライブ編集する（",[36,1083,1084],{},"カスタムCSS",[145,1086,1087],{},"テーマファイルをThemesフォルダにインポートする",{"title":104,"searchDepth":105,"depth":105,"links":1089},[1090,1091,1092,1093],{"id":985,"depth":105,"text":986},{"id":1019,"depth":105,"text":1019},{"id":1036,"depth":105,"text":1036},{"id":1068,"depth":105,"text":1068},"Theme Creatorで色、フォント、ボタン、タブをデザイン。",{},5,"\u002Ftheme-editor",{"title":971,"description":1094},"theme-editor","tGeQE8HatAeqLeJ_3U4A-ac0RfIRzcoq-KghedjPolg",{"id":1102,"title":1103,"body":1104,"description":1235,"extension":113,"meta":1236,"navigation":115,"order":1237,"path":1238,"seo":1239,"stem":1240,"__hash__":1241},"content_ja\u002Frecording-editor.md","録音エディター",{"type":7,"value":1105,"toc":1229},[1106,1108,1114,1117,1123,1143,1146,1149,1174,1177,1192,1196,1210,1220],[10,1107,1103],{"id":1103},[13,1109,1110,1111,1113],{},"SoundNinja内でクリップを録音し、トリムしてタブにインポートします。プレイヤーバーの ",[36,1112,510],{}," ボタンでエディターを開きます。",[17,1115,1116],{"id":1116},"入力を選ぶ",[13,1118,1119,1122],{},[36,1120,1121],{},"設定 → オーディオ"," で：",[142,1124,1125,1131,1137],{},[145,1126,1127,1130],{},[36,1128,1129],{},"入力デバイス"," — マイク",[145,1132,1133,1136],{},[36,1134,1135],{},"出力デバイス（PCオーディオ）"," — PCが再生している音のループバック",[145,1138,1139,1142],{},[36,1140,1141],{},"入力音量"," — キャプチャゲイン 0%〜200%",[13,1144,1145],{},"録音ボタンは、ここで選んだデバイスを使います。",[17,1147,1148],{"id":1148},"テイクを編集",[142,1150,1151,1154,1157,1165,1168,1171],{},[145,1152,1153],{},"録音と停止",[145,1155,1156],{},"入力レベルメーターを確認",[145,1158,1159,39,1162],{},[36,1160,1161],{},"ノーマライズ",[36,1163,1164],{},"ノイズキャンセレーション",[145,1166,1167],{},"クリップ全体のトリム、選択範囲へのトリム、選択の削除",[145,1169,1170],{},"元に戻す \u002F やり直し",[145,1172,1173],{},"ズームインとズームアウト",[17,1175,1176],{"id":1176},"ステージしてインポート",[213,1178,1179,1182,1185],{},[145,1180,1181],{},"選択範囲またはトラック全体をステージングリストに追加します。",[145,1183,1184],{},"リストは空から始まります。録音、編集、それからクリップを追加。",[145,1186,1187,39,1189,1191],{},[36,1188,519],{},[36,1190,522],{}," で、現在のタブまたは選んだタブに入れます。",[17,1193,1195],{"id":1194},"ステム分離任意","ステム分離（任意）",[13,1197,1198,1199,1202,1203,39,1206,1209],{},"公式のWindows \u002F macOS \u002F Linuxリリースビルドには ",[36,1200,1201],{},"ステム"," 機能が入ります。Record EditorはBS-RoFormerで ",[36,1204,1205],{},"ボーカル",[36,1207,1208],{},"音楽"," を残せます。",[13,1211,1212,1213,102,1216,1219],{},"モデルは約158 MBで、インストーラーには ",[36,1214,1215],{},"同梱されていません",[36,1217,1218],{},"設定 → ステム分離"," からダウンロードするか、初回起動のプロンプトを承認します。Windowsインストーラーも初回起動時にモデルのダウンロードを案内できます。",[13,1221,1222,1223,998,1226,481],{},"カスタムのソースビルドには追加フラグが必要です（",[333,1224,1225],{},"tauri:serve:stems",[333,1227,1228],{},"tauri:build:stems",{"title":104,"searchDepth":105,"depth":105,"links":1230},[1231,1232,1233,1234],{"id":1116,"depth":105,"text":1116},{"id":1148,"depth":105,"text":1148},{"id":1176,"depth":105,"text":1176},{"id":1194,"depth":105,"text":1195},"マイクまたはPCオーディオを取り込み、クリップを編集してボードに置く。",{},6,"\u002Frecording-editor",{"title":1103,"description":1235},"recording-editor","7_RI-WNd1luOVgn5vTAoyTmO8dKVtHVwkffwMt4LBQc",{"id":1243,"title":1244,"body":1245,"description":1455,"extension":113,"meta":1456,"navigation":115,"order":1457,"path":1458,"seo":1459,"stem":1460,"__hash__":1461},"content_ja\u002Fremote-control.md","リモートコントロール",{"type":7,"value":1246,"toc":1448},[1247,1249,1252,1255,1286,1289,1292,1326,1329,1349,1352,1355,1387,1391,1397],[10,1248,1244],{"id":1244},[13,1250,1251],{},"SoundNinjaはローカルネットワークで待ち受け、Bitfocus Companion（または任意のHTTP\u002FWebSocketクライアント）がサウンドを再生・停止できます。",[17,1253,1254],{"id":1254},"リモートサーバーを有効化",[213,1256,1257,1263,1270,1277],{},[145,1258,1259,1262],{},[36,1260,1261],{},"設定 → リモート"," を開きます。",[145,1264,1265,1266,1269],{},"リモートサーバーを有効にします。デフォルトポートは ",[36,1267,1268],{},"7331"," です。",[145,1271,1272,1273,1276],{},"任意：トークンを設定。クライアントはBearerトークンまたは ",[333,1274,1275],{},"?token="," で送ります。",[145,1278,1279,1282,1283,1285],{},[333,1280,1281],{},"http:\u002F\u002FIP:PORT"," URLをコピーするか、",[36,1284,42],{}," からシステムIPをコピーします。",[13,1287,1288],{},"Windowsはサーバー初回起動時にファイアウォールの確認を出すことがあります。プライベートネットワークのアクセスを許可してください。",[17,1290,191],{"id":1291},"bitfocus-companion",[213,1293,1294,1301,1309,1320],{},[145,1295,1296,1300],{},[26,1297,191],{"href":1298,"rel":1299},"https:\u002F\u002Fbitfocus.io\u002Fcompanion",[30],"をインストールします。",[145,1302,1303,1308],{},[26,1304,1307],{"href":1305,"rel":1306},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Freleases\u002Flatest\u002Fdownload\u002FSoundNinja-Companion.tgz",[30],"SoundNinja-Companion.tgz"," をダウンロード。Companion Storeのパッケージはまだありません。",[145,1310,1311,1312,1315,1316,1319],{},"Companionで ",[36,1313,1314],{},"Modules → Load module package"," を開き、",[333,1317,1318],{},".tgz"," を選びます。",[145,1321,1322,1325],{},[36,1323,1324],{},"Sound Ninja"," 接続を追加。PCのIP、ポート、設定したトークンを貼り付けます。",[17,1327,1328],{"id":1328},"アクション",[142,1330,1331,1337,1343],{},[145,1332,1333,1336],{},[36,1334,1335],{},"Trigger Sound"," — ライブドロップダウンから選ぶか、8文字のサウンドIDを入力（Companion変数が使えます）",[145,1338,1339,1342],{},[36,1340,1341],{},"Stop Sound"," — IDで再生中のサウンドを1つ停止",[145,1344,1345,1348],{},[36,1346,1347],{},"Stop All"," — 再生中の全サウンドを停止",[13,1350,1351],{},"SoundNinjaでは、ボタンのコンテキストメニューまたは複数選択のIDチップからサウンドIDをコピーします。",[17,1353,1354],{"id":1354},"フィードバックと変数",[142,1356,1357,1363,1375,1381],{},[145,1358,1359,1362],{},[36,1360,1361],{},"Sound Playing"," — そのサウンドIDがアクティブな間はtrue（ボタン色に使う）",[145,1364,1365,1368,1369,998,1372],{},[333,1366,1367],{},"$(soundninja:connected)"," — ",[333,1370,1371],{},"true",[333,1373,1374],{},"false",[145,1376,1377,1380],{},[333,1378,1379],{},"$(soundninja:playing_count)"," — 再生中のサウンド数",[145,1382,1383,1386],{},[333,1384,1385],{},"$(soundninja:last_triggered)"," — 最後にトリガーしたサウンドID",[17,1388,1390],{"id":1389},"http-api上級","HTTP API（上級）",[13,1392,1393,1394],{},"ベースパス：",[333,1395,1396],{},"\u002Fapi\u002Fv1",[142,1398,1399,1405,1411,1417,1427,1433,1442],{},[145,1400,1401,1404],{},[333,1402,1403],{},"GET \u002Finfo"," — アプリ名、バージョン、プロトコル、トークンが必要か",[145,1406,1407,1410],{},[333,1408,1409],{},"GET \u002Fsounds"," — サウンド一覧（id、name、tabs、active）",[145,1412,1413,1416],{},[333,1414,1415],{},"GET \u002Fstate"," — サウンドと現在再生中のID",[145,1418,1419,1422,1423,1426],{},[333,1420,1421],{},"POST \u002Ftrigger"," に ",[333,1424,1425],{},"{ \"id\" }"," — サウンドを再生",[145,1428,1429,1432],{},[333,1430,1431],{},"GET \u002Ftrigger\u002F:id"," — 再生（ブラウザで簡単にテスト）",[145,1434,1435,1438,1439,1441],{},[333,1436,1437],{},"POST \u002Fstop"," に任意の ",[333,1440,1425],{}," — 1つまたはすべて停止",[145,1443,1444,1447],{},[333,1445,1446],{},"GET \u002Fws"," — ライブ状態。trigger\u002Fstopコマンドを受信",{"title":104,"searchDepth":105,"depth":105,"links":1449},[1450,1451,1452,1453,1454],{"id":1254,"depth":105,"text":1254},{"id":1291,"depth":105,"text":191},{"id":1328,"depth":105,"text":1328},{"id":1354,"depth":105,"text":1354},{"id":1389,"depth":105,"text":1390},"ローカルネットワーク経由でBitfocus CompanionからSoundNinjaを操作。",{},7,"\u002Fremote-control",{"title":1244,"description":1455},"remote-control","_6T2WMAtPh7L1pRelAkpGazesfqk5Swk4FcTh5g7BTw",{"id":4,"title":5,"body":1463,"description":112,"extension":113,"meta":1524,"navigation":115,"order":116,"path":117,"seo":1525,"stem":119,"__hash__":120},{"type":7,"value":1464,"toc":1517},[1465,1467,1469,1471,1473,1478,1484,1486,1490,1492,1501,1503,151