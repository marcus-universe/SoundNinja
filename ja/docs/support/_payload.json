[{"data":1,"prerenderedAt":1547},["ShallowReactive",2],{"docs-page-ja-\u002Fsupport":3,"docs-nav-ja":121},{"id":4,"title":5,"body":6,"description":112,"extension":113,"meta":114,"navigation":115,"order":116,"path":117,"seo":118,"stem":119,"__hash__":120},"content_ja\u002Fsupport.md","サポート",{"type":7,"value":8,"toc":103},"minimark",[9,12,16,20,23,32,44,47,54,57,74,77,92,95],[10,11,5],"h1",{"id":5},[13,14,15],"p",{},"SoundNinjaは初期ベータのコミュニティプロジェクトです。いちばん早い助けはGitHubです。",[17,18,19],"h2",{"id":19},"バグ報告または質問",[13,21,22],{},"GitHubでissueを開いてください：",[13,24,25],{},[26,27,31],"a",{"href":28,"rel":29},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fissues",[30],"nofollow","github.com\u002Fmarcus-universe\u002FSoundNinja\u002Fissues",[13,33,34,35,39,40,43],{},"OS、SoundNinjaのバージョン（",[36,37,38],"strong",{},"ヘルプ → アップデートを確認"," または ",[36,41,42],{},"設定 → 情報","）、再現手順を書いてください。",[17,45,46],{"id":46},"メール",[13,48,49,50],{},"メンテナー連絡先：",[26,51,53],{"href":52},"mailto:contact@marcus-universe.de","contact@marcus-universe.de",[17,55,56],{"id":56},"アップデート",[13,58,59,60,62,63,67,68,73],{},"アプリ内で ",[36,61,38],{}," を使います。新しいビルドは",[26,64,66],{"href":65},"\u002Fdownload","ダウンロードページ","と",[26,69,72],{"href":70,"rel":71},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Freleases",[30],"GitHub Releases","にも出ます。",[17,75,76],{"id":76},"コントリビュート",[13,78,79,80,85,86,91],{},"プルリクエストを歓迎します。アプリのリポジトリは",[26,81,84],{"href":82,"rel":83},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja",[30],"github.com\u002Fmarcus-universe\u002FSoundNinja","です。プロジェクトは",[26,87,90],{"href":88,"rel":89},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fblob\u002Fmain\u002FLICENSE",[30],"GPL-3.0","ライセンスです。",[17,93,94],{"id":94},"法的情報",[13,96,97,98,102],{},"インプリントと連絡先：",[26,99,101],{"href":100},"\u002Fimpressum","インプリント","。",{"title":104,"searchDepth":105,"depth":105,"links":106},"",2,[107,108,109,110,111],{"id":19,"depth":105,"text":19},{"id":46,"depth":105,"text":46},{"id":56,"depth":105,"text":56},{"id":76,"depth":105,"text":76},{"id":94,"depth":105,"text":94},"ヘルプの入手先とバグ報告。","md",{},true,8,"\u002Fsupport",{"title":5,"description":112},"support","T2BdU-sWENDKBxowzv9wjeevj1bEK3iit1IGD77Vz_M",[122,246,458,599,990,1122,1263,1483],{"id":123,"title":124,"body":125,"description":239,"extension":113,"meta":240,"navigation":115,"order":241,"path":242,"seo":243,"stem":244,"__hash__":245},"content_ja\u002Foverview.md","概要",{"type":7,"value":126,"toc":233},[127,129,132,135,138,141,157,160,199,202,209,212],[10,128,124],{"id":124},[13,130,131],{},"SoundNinjaは、ライブ配信、友だちとのチャット、ポッドキャスト収録向けのオープンソースサウンドボードです。Tauri v2とNuxt 4で構築されており、RAMとディスクの負荷を抑えています。",[13,133,134],{},"目標はシンプルです。巨大なサウンドライブラリをすばやく眺め、目的のクリップをミリ秒で再生すること。UIはVRのダッシュボードとしても使いやすいです。",[13,136,137],{},"SoundNinjaはまだ初期開発段階です。機能は動きますが、すべてのプラットフォームで完全に検証されているわけではありません。",[17,139,140],{"id":140},"対象ユーザー",[142,143,144,148,151,154],"ul",{},[145,146,147],"li",{},"即時のサウンドキューが必要な配信者",[145,149,150],{},"ボイスチャット用の共有ボードが欲しい友だち",[145,152,153],{},"クリップを録ってボードに置くポッドキャスター",[145,155,156],{},"カスタマイズ可能な、ローカル優先のサウンドボードが欲しい人",[17,158,159],{"id":159},"できること",[142,161,162,165,168,171,174,177,180,183,186,193,196],{},[145,163,164],{},"自分の音声ファイルからサウンドボードを作る",[145,166,167],{},"色付きタブ、グループ、タグ、検索で整理する",[145,169,170],{},"タグでフィルター（OR）、名前・日付・長さ・サイズでソート",[145,172,173],{},"マーキーまたはShift範囲で複数選択し、色・移動・削除を一括",[145,175,176],{},"コンテキストメニューでサウンドごとの音量を設定",[145,178,179],{},"Theme Creatorで見た目をデザインする",[145,181,182],{},"Record EditorでPCオーディオまたはマイクを録音する",[145,184,185],{},"個別のサウンドにホットキーを割り当てる",[145,187,188,192],{},[26,189,191],{"href":190},"\u002Fdocs\u002Fremote-control","Bitfocus Companion","からサウンドをトリガーする",[145,194,195],{},"サウンドボード全体をインポート／エクスポートして共有する",[145,197,198],{},"サウンドボタンにGIFや画像を使う — ローカルフォルダライブラリまたはKLIPY",[17,200,201],{"id":201},"ライセンス",[13,203,204,205,208],{},"SoundNinjaは",[26,206,90],{"href":88,"rel":207},[30],"のフリーソフトウェアです。フォーク、改変、共有できます。",[17,210,211],{"id":211},"次のステップ",[213,214,215,221,227],"ol",{},[145,216,217],{},[26,218,220],{"href":219},"\u002Fdocs\u002Finstallation","SoundNinjaをインストール",[145,222,223],{},[26,224,226],{"href":225},"\u002Fdocs\u002Fadding-sounds","サウンドを追加",[145,228,229],{},[26,230,232],{"href":231},"\u002Fdocs\u002Forganizing-sounds","ボードを整理",{"title":104,"searchDepth":105,"depth":105,"links":234},[235,236,237,238],{"id":140,"depth":105,"text":140},{"id":159,"depth":105,"text":159},{"id":201,"depth":105,"text":201},{"id":211,"depth":105,"text":211},"SoundNinjaとは何か、何ができるか。",{},1,"\u002Foverview",{"title":124,"description":239},"overview","c8xWgFwxVyANkJ28nfjNkL8am61Nn8aDvVh7jKzMyKM",{"id":247,"title":248,"body":249,"description":452,"extension":113,"meta":453,"navigation":115,"order":105,"path":454,"seo":455,"stem":456,"__hash__":457},"content_ja\u002Finstallation.md","インストール",{"type":7,"value":250,"toc":445},[251,253,263,267,287,290,294,308,311,315,340,351,353,358,361,375,405,420,441],[10,252,248],{"id":248},[13,254,255,257,258,262],{},[26,256,66],{"href":65},"または",[26,259,72],{"href":260,"rel":261},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Freleases\u002Flatest",[30],"からビルドを入手してください。SoundNinjaは初期開発中なので、ビルドはベータとして扱ってください。",[17,264,266],{"id":265},"windows","Windows",[142,268,269,278,281,284],{},[145,270,271,272,39,275],{},"64ビットWindows向けの",[36,273,274],{},"インストーラー (.exe)",[36,276,277],{},"MSI (.msi)",[145,279,280],{},"ランディングページの対象：Windows 10以降",[145,282,283],{},"アプリのREADMEはWindows 8以上も記載",[145,285,286],{},"NSISインストーラーはダークテーマ。セットアップ時に言語を選ぶと、次回起動時にSoundNinjaが覚えます。",[13,288,289],{},"インストーラーを実行し、スタートメニューからSoundNinjaを起動します。",[17,291,293],{"id":292},"macos","macOS",[142,295,296,302,305],{},[145,297,298,299],{},"Apple SiliconとIntel向けの",[36,300,301],{},"ユニバーサル .dmg",[145,303,304],{},"ランディングページの対象：macOS 10.14以降",[145,306,307],{},"アプリのREADMEはmacOS 10.15以上を記載",[13,309,310],{},"ディスクイメージを開き、SoundNinjaをアプリケーションにドラッグします。",[17,312,314],{"id":313},"linux","Linux",[142,316,317,323,329,337],{},[145,318,319,320],{},"Ubuntu \u002F Debian向けの",[36,321,322],{},"Debian (.deb)",[145,324,325,326],{},"その他のディストリ向けの",[36,327,328],{},"AppImage",[145,330,331,332,336],{},"リリース公開後、ArchユーザーはAURから",[333,334,335],"code",{},"soundninja-bin","をインストールできます",[145,338,339],{},"Ubuntu 20.04でテスト済み",[13,341,342,343,346,347,350],{},"デスクトップビルドにはWebKitとGTKのパッケージが必要です。Debian\u002FUbuntuでは通常、",[333,344,345],{},"libwebkit2gtk","、",[333,348,349],{},"libgtk-3-0","、app-indicatorライブラリです。",[17,352,56],{"id":56},[13,354,59,355,357],{},[36,356,38],{}," を開きます。設定で起動時にSoundNinjaが確認するようにもできます。",[17,359,360],{"id":360},"ソースからビルド",[13,362,363,364,368,369,374],{},"カスタムビルドが必要なら、",[26,365,367],{"href":82,"rel":366},[30],"リポジトリ","をクローンし、",[26,370,373],{"href":371,"rel":372},"https:\u002F\u002Fv2.tauri.app\u002Fstart\u002Fprerequisites\u002F",[30],"Tauriの前提条件","を入れたうえで：",[376,377,381],"pre",{"className":378,"code":379,"language":380,"meta":104,"style":104},"language-bash shiki shiki-themes github-light github-dark","bun install\nbun run tauri:serve\n","bash",[333,382,383,395],{"__ignoreMap":104},[384,385,387,391],"span",{"class":386,"line":241},"line",[384,388,390],{"class":389},"sScJk","bun",[384,392,394],{"class":393},"sZZnC"," install\n",[384,396,397,399,402],{"class":386,"line":105},[384,398,390],{"class":389},[384,400,401],{"class":393}," run",[384,403,404],{"class":393}," tauri:serve\n",[13,406,407,346,410,346,413,416,417,102],{},[333,408,409],{},"npm",[333,411,412],{},"pnpm",[333,414,415],{},"deno","でも動きます。本番ビルド：",[333,418,419],{},"bun run tauri:build",[13,421,422,425,426,431,432,435,436,102],{},[36,423,424],{},"Windowsのみ:"," Windowsビルドはすべて ",[26,427,430],{"href":428,"rel":429},"https:\u002F\u002Fwww.steinberg.net\u002Fasiosdk",[30],"Steinberg ASIO SDK"," 経由でASIOを含めます。一度 ",[333,433,434],{},"bun run setup:asio"," を実行（SDKはgitに含まれません）。Linux \u002F macOSは PipeWire \u002F Core Audio — この手順は不要。詳細: ",[26,437,440],{"href":438,"rel":439},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fblob\u002Fmain\u002Fdocs\u002Fbuild-from-source.md",[30],"build-from-source.md",[442,443,444],"style",{},"html pre.shiki code .sScJk, html code.shiki .sScJk{--shiki-default:#6F42C1;--shiki-dark:#B392F0}html pre.shiki code .sZZnC, html code.shiki .sZZnC{--shiki-default:#032F62;--shiki-dark:#9ECBFF}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html.dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}",{"title":104,"searchDepth":105,"depth":105,"links":446},[447,448,449,450,451],{"id":265,"depth":105,"text":266},{"id":292,"depth":105,"text":293},{"id":313,"depth":105,"text":314},{"id":56,"depth":105,"text":56},{"id":360,"depth":105,"text":360},"Windows、macOS、LinuxにSoundNinjaをインストール。",{},"\u002Finstallation",{"title":248,"description":452},"installation","IjZd1P7FnQS2uqb_Mqyrc5OsF5e06cfW8q5sH_3_mkY",{"id":459,"title":460,"body":461,"description":592,"extension":113,"meta":593,"navigation":115,"order":594,"path":595,"seo":596,"stem":597,"__hash__":598},"content_ja\u002Fadding-sounds.md","サウンドの追加",{"type":7,"value":462,"toc":584},[463,465,468,471,489,492,523,526,545,548,562,565,568,575,578],[10,464,460],{"id":460},[13,466,467],{},"クリップを追加するまで、ボードは空です。SoundNinjaはファイル、フォルダ全体、録音、共有サウンドボードパックをインポートできます。",[17,469,470],{"id":470},"音声ファイルをインポート",[213,472,473,483,486],{},[145,474,475,478,479,482],{},[36,476,477],{},"ファイル → 音声ファイルをインポート","、またはナビバーの ",[36,480,481],{},"インポート"," を使います。",[145,484,485],{},"1つ以上の音声ファイルを選びます。",[145,487,488],{},"サウンドは現在のタブに入ります。",[17,490,491],{"id":491},"フォルダをインポート",[213,493,494,503,506],{},[145,495,496,499,500,502],{},[36,497,498],{},"ファイル → フォルダをインポート","（またはナビバーの ",[36,501,491],{},"）。",[145,504,505],{},"1つ以上のフォルダを追加。インポート前にドラッグで並べ替えできます。",[145,507,508,509],{},"配置方法を選びます：\n",[142,510,511,517],{},[145,512,513,516],{},[36,514,515],{},"タブとしてインポート"," — 各フォルダが独自のタブになる",[145,518,519,522],{},[36,520,521],{},"現在のタブにインポート"," — すべてのファイルがアクティブなタブに入る",[17,524,525],{"id":525},"クリップを録音",[13,527,528,529,532,533,537,538,39,541,544],{},"プレイヤーバーの ",[36,530,531],{},"録音"," ボタンから",[26,534,536],{"href":535},"\u002Fdocs\u002Frecording-editor","Record Editor","を開きます。キャプチャ、トリムし、",[36,539,540],{},"選択をインポート",[36,542,543],{},"すべてインポート"," で現在のタブまたは選んだタブに入れます。",[17,546,547],{"id":547},"サウンドボードをインポート",[13,549,550,553,554,557,558,561],{},[36,551,552],{},"ファイル → サウンドボードをインポート"," で共有パックを読み込みます。パックは ",[333,555,556],{},"project.sninja"," とサウンドファイルを含む ",[333,559,560],{},".zip"," です。インポート後、プロジェクトを開いて再生します。",[13,563,564],{},"複数のプロジェクト（プロファイル）も保てます。プロジェクトセレクターでボードを切り替えます。",[17,566,567],{"id":567},"見つからないファイルを再リンク",[13,569,570,571,574],{},"ディスク上で音声ファイルが移動すると、SoundNinjaは ",[36,572,573],{},"見つからないサウンドファイル"," ダイアログを表示します。検索するフォルダを選び、クリップを再リンクします。",[17,576,577],{"id":577},"次へ",[13,579,580,581,102],{},"タブ、タグ、フィルター、ホットキーの整理は",[26,582,583],{"href":231},"サウンドの整理",{"title":104,"searchDepth":105,"depth":105,"links":585},[586,587,588,589,590,591],{"id":470,"depth":105,"text":470},{"id":491,"depth":105,"text":491},{"id":525,"depth":105,"text":525},{"id":547,"depth":105,"text":547},{"id":567,"depth":105,"text":567},{"id":577,"depth":105,"text":577},"音声、フォルダ、録音、共有サウンドボードをインポート。",{},3,"\u002Fadding-sounds",{"title":460,"description":592},"adding-sounds","5_cjd2COcPz0pj4ZrBehCZv6ouzBimE8UGjkcfngQjw",{"id":600,"title":583,"body":601,"description":983,"extension":113,"meta":984,"navigation":115,"order":985,"path":986,"seo":987,"stem":988,"__hash__":989},"content_ja\u002Forganizing-sounds.md",{"type":7,"value":602,"toc":968},[603,605,612,615,640,647,650,653,667,674,680,684,694,698,728,731,737,740,774,781,785,788,814,817,821,834,837,842,863,879,886,889,900,903,907,914,924,930,933,941,948,965],[10,604,583],{"id":583},[13,606,607,608,611],{},"SoundNinjaは大規模ライブラリ向けです。",[36,609,610],{},"タグとフィルター","、タブ、検索、複数選択、ホットキーで、必要なクリップをワンクリック（またはワンキー）で出せます。",[17,613,614],{"id":614},"タブ",[142,616,617,623,629],{},[145,618,619,622],{},[36,620,621],{},"タブを追加"," でタブを作り、色を付けてバーをすばやく眺められます。",[145,624,625,628],{},[36,626,627],{},"すべて"," ビューはタブを横断して全サウンドを表示します。",[145,630,631,632,635,636,639],{},"サウンドは ",[36,633,634],{},"1つ以上のタブ"," に所属できます。サウンドを右クリックし、",[36,637,638],{},"タブへ移動"," で割り当てます。",[13,641,642,643,646],{},"タブの切り替え演出は ",[36,644,645],{},"設定 → メイン","：スライド、フェード、ボタンを1つずつ、またはなし。",[17,648,649],{"id":649},"グループ",[13,651,652],{},"v0.5.3以降、セパレーターを名前付きグループにできます：",[142,654,655,658,661,664],{},[145,656,657],{},"コンテキストメニューからグループの追加、名前変更、削除",[145,659,660],{},"グループヘッダーをドラッグ — 子も一緒に動く",[145,662,663],{},"グループにサウンドを入れたり出したり",[145,665,666],{},"グループの枠線色、名前の色、ボタン配置を設定（またはタブのデフォルトを使う）",[13,668,669,670,673],{},"見た目の区切りだけなら、通常の ",[36,671,672],{},"セパレーター"," も追加できます。",[13,675,676,677,102],{},"ボードの空き領域を右クリックして ",[36,678,679],{},"グループを追加",[17,681,683],{"id":682},"タグ-フィルター","タグ \u002F フィルター",[13,685,686,687,690,691,693],{},"タグはタブを横断します。スライドアウトの ",[36,688,689],{},"フィルター"," パネル（サイドバー ",[36,692,689],{},"）で作成し、ボードを絞ります。",[695,696,697],"h3",{"id":697},"タグの作成と編集",[213,699,700,706,716,722],{},[145,701,702,703,705],{},"サイドバーで ",[36,704,689],{}," を開く。",[145,707,708,711,712,715],{},[36,709,710],{},"タグ"," の ",[36,713,714],{},"タグを追加"," — 名前と色を付ける。",[145,717,718,719,102],{},"同じリストで名前変更、色変更、",[36,720,721],{},"タグを削除",[145,723,724,727],{},[36,725,726],{},"タグはまだありません"," と出たら、割り当てる前にここで追加する。",[695,729,730],{"id":730},"サウンドにタグを付ける",[13,732,733,734,736],{},"サウンドを右クリック → ",[36,735,710],{},"（チェックボックス）。1つのサウンドに複数可。タグが無い場合、メニューはフィルターパネルへ案内します。",[695,738,739],{"id":739},"ボードをフィルター",[142,741,742,749,760,771],{},[145,743,744,745,748],{},"フィルターパネル、または ",[36,746,747],{},"検索バー下のチップ"," でタグを切り替え。",[145,750,751,752,755,756,759],{},"一致は ",[36,753,754],{},"OR","：選択したタグの ",[36,757,758],{},"いずれか"," を持つサウンドが表示される。",[145,761,762,763,766,767,770],{},"ナビバーの ",[36,764,765],{},"検索"," は有効なタグフィルターと ",[36,768,769],{},"AND","（入力 + タグ）。",[145,772,773],{},"チップをオフ（またはフィルター解除）でタブ全体を再表示。",[13,775,776,777,780],{},"色付きタグ名をボタンに表示できます。",[36,778,779],{},"設定 → 動作 → タグバッジを表示"," で切り替え。",[17,782,784],{"id":783},"並べ替えソート","並べ替え（ソート）",[13,786,787],{},"フィルターパネルでソートモードを選びます：",[142,789,790,796],{},[145,791,792,795],{},[36,793,794],{},"ユーザー定義"," — タブ順、グループ表示",[145,797,798,346,801,346,804,346,807,810,811],{},[36,799,800],{},"名前",[36,802,803],{},"追加日時",[36,805,806],{},"再生時間",[36,808,809],{},"ファイルサイズ"," — フラットなソート一覧。これらのモードでは ",[36,812,813],{},"グループは非表示",[13,815,816],{},"再生時間ソートは、初回に長さのメタデータを準備することがあります。",[17,818,820],{"id":819},"並べ替えドラッグ","並べ替え（ドラッグ）",[13,822,823,826,827,830,831,833],{},[36,824,825],{},"設定 → 動作"," でドラッグ＆ドロップをオンにします（",[36,828,829],{},"並べ替えを許可","）。その後、サウンドとグループをドラッグして配置します。ドラッグ並べ替えは ",[36,832,794],{}," ソートで有効です。",[17,835,836],{"id":836},"複数選択",[13,838,762,839,841],{},[36,840,836],{}," をオンにして：",[142,843,844,847,853,860],{},[145,845,846],{},"クリックでサウンドをトグル",[145,848,849,852],{},[36,850,851],{},"Shift+クリック"," で直前のアンカーから範囲選択",[145,854,855,856,859],{},"空きボード上で ",[36,857,858],{},"マーキー"," をドラッグ",[145,861,862],{},"空きボード（または外側）をクリックして選択解除",[13,864,865,866,346,869,346,872,346,875,878],{},"一括バーに件数が表示され、",[36,867,868],{},"色",[36,870,871],{},"タブへ移動…",[36,873,874],{},"削除",[36,876,877],{},"完了"," が使えます。",[13,880,881,882,885],{},"複数選択中、各ボタンに ",[36,883,884],{},"8文字のIDチップ"," が出ます。チップを右クリックでコピー。",[17,887,888],{"id":888},"サウンドごとの音量",[13,890,891,892,895,896,899],{},"右クリック → ",[36,893,894],{},"音量","。スライダーを 0%〜100%。",[36,897,898],{},"ダブルクリック"," で 100% にリセット。",[13,901,902],{},"設定のマスター出力音量と重ねて効きます。",[17,904,906],{"id":905},"ホットキーとサウンドid","ホットキーとサウンドID",[13,908,909,910,913],{},"すべてのサウンドには8文字のIDがあります。ボタンのコンテキストメニュー（",[36,911,912],{},"IDをコピー","）、または複数選択のIDチップからコピーします。",[13,915,916,919,920,923],{},[36,917,918],{},"設定 → ホットキー"," を開き、キーをサウンドIDに割り当てます。グローバルホットキーは任意です。コンテキストメニューの ",[36,921,922],{},"ホットキーを割り当て"," は、IDを埋めた状態でそこにジャンプします。",[13,925,926,927,929],{},"同じIDを",[26,928,191],{"href":190},"がクリップのトリガーに使います。",[17,931,932],{"id":932},"背景画像と色",[13,934,935,936,940],{},"サウンドを右クリックして、ボタンごとの色や背景画像を設定します。ボード全体を整える",[26,937,939],{"href":938},"\u002Fdocs\u002Ftheme-editor","Theme Creator","とは別です。",[13,942,943,944,947],{},"ピッカーは ",[36,945,946],{},"背景画像"," ダイアログ（PNG、JPEG、GIF、WebP）：",[142,949,950,956],{},[145,951,952,955],{},[36,953,954],{},"ローカルファイル"," — フォルダ追加、単一ファイル選択、ファイル名検索、グリッドプレビュー、ライブラリからフォルダ削除",[145,957,958,961,962,964],{},[36,959,960],{},"KLIPY"," — オンラインGIFを検索。APIキーは ",[36,963,825],{},"。キーはプロジェクトファイルには保存されません。",[13,966,967],{},"画像を選んだあと、ボタン上でパンとクロップできます。",{"title":104,"searchDepth":105,"depth":105,"links":969},[970,971,972,977,978,979,980,981,982],{"id":614,"depth":105,"text":614},{"id":649,"depth":105,"text":649},{"id":682,"depth":105,"text":683,"children":973},[974,975,976],{"id":697,"depth":594,"text":697},{"id":730,"depth":594,"text":730},{"id":739,"depth":594,"text":739},{"id":783,"depth":105,"text":784},{"id":819,"depth":105,"text":820},{"id":836,"depth":105,"text":836},{"id":888,"depth":105,"text":888},{"id":905,"depth":105,"text":906},{"id":932,"depth":105,"text":932},"タグ、フィルター、タブ、グループ、並べ替え、複数選択、音量、ホットキー。",{},4,"\u002Forganizing-sounds",{"title":583,"description":983},"organizing-sounds","PGqVreiuZb1jRxkXIW9tv66PvwPYs2iRx5-4j_D8sho",{"id":991,"title":992,"body":993,"description":1115,"extension":113,"meta":1116,"navigation":115,"order":1117,"path":1118,"seo":1119,"stem":1120,"__hash__":1121},"content_ja\u002Ftheme-editor.md","テーマエディター",{"type":7,"value":994,"toc":1109},[995,997,1004,1008,1035,1038,1041,1055,1058,1084,1087,1090,1095],[10,996,992],{"id":992},[13,998,999,1000,1003],{},"Theme Creatorは、ボードの完全なビジュアルエディターです。",[36,1001,1002],{},"設定 → メイン → Theme Creator"," から開きます。",[17,1005,1007],{"id":1006},"_3つのタブ","3つのタブ",[213,1009,1010,1024,1030],{},[145,1011,1012,1015,1016,1019,1020,1023],{},[36,1013,1014],{},"一般"," — テーマ名、共有色、フォントのアップロード（",[333,1017,1018],{},".ttf"," \u002F ",[333,1021,1022],{},".otf","）",[145,1025,1026,1029],{},[36,1027,1028],{},"ボタン"," — サウンドボタンの色、書体、レイアウト、GIFオーバーレイ",[145,1031,1032,1034],{},[36,1033,614],{}," — タブバーの色、書体、枠線の太さ",[13,1036,1037],{},"編集中、ライブプレビューがタブとボタンを表示します。",[17,1039,1040],{"id":1040},"変更できる項目",[142,1042,1043,1046,1049,1052],{},[145,1044,1045],{},"プライマリとアクセントの色、背景、ボタン色、タブ色",[145,1047,1048],{},"ボタンとタブのフォントファミリーとサイズ",[145,1050,1051],{},"ボタンの幅、半径、枠線幅、隙間、パディング",[145,1053,1054],{},"GIFオーバーレイの不透明度（通常とホバー）",[17,1056,1057],{"id":1057},"保存と共有",[142,1059,1060,1066,1072,1078],{},[145,1061,1062,1065],{},[36,1063,1064],{},".cssをエクスポート"," — バックアップや友人への送信用テーマファイルを書き出す",[145,1067,1068,1071],{},[36,1069,1070],{},"テーマに追加"," — Themesフォルダに保存して適用",[145,1073,1074,1077],{},[36,1075,1076],{},".cssをインポート"," — 組み込みプリセットまたは保存済みテーマを読み込む",[145,1079,1080,1083],{},[36,1081,1082],{},"リセット"," — SoundNinjaのデフォルトに戻す",[13,1085,1086],{},"未保存の変更があるままウィンドウを閉じると、SoundNinjaが先に保存を求めます。",[17,1088,1089],{"id":1089},"フルエディターなしで",[13,1091,1092,1094],{},[36,1093,645],{}," でも次が可能です：",[142,1096,1097,1100,1106],{},[145,1098,1099],{},"リストからテーマを選ぶ",[145,1101,1102,1103,1023],{},"CSS変数をライブ編集する（",[36,1104,1105],{},"カスタムCSS",[145,1107,1108],{},"テーマファイルをThemesフォルダにインポートする",{"title":104,"searchDepth":105,"depth":105,"links":1110},[1111,1112,1113,1114],{"id":1006,"depth":105,"text":1007},{"id":1040,"depth":105,"text":1040},{"id":1057,"depth":105,"text":1057},{"id":1089,"depth":105,"text":1089},"Theme Creatorで色、フォント、ボタン、タブをデザイン。",{},5,"\u002Ftheme-editor",{"title":992,"description":1115},"theme-editor","tGeQE8HatAeqLeJ_3U4A-ac0RfIRzcoq-KghedjPolg",{"id":1123,"title":1124,"body":1125,"description":1256,"extension":113,"meta":1257,"navigation":115,"order":1258,"path":1259,"seo":1260,"stem":1261,"__hash__":1262},"content_ja\u002Frecording-editor.md","録音エディター",{"type":7,"value":1126,"toc":1250},[1127,1129,1135,1138,1144,1164,1167,1170,1195,1198,1213,1217,1231,1241],[10,1128,1124],{"id":1124},[13,1130,1131,1132,1134],{},"SoundNinja内でクリップを録音し、トリムしてタブにインポートします。プレイヤーバーの ",[36,1133,531],{}," ボタンでエディターを開きます。",[17,1136,1137],{"id":1137},"入力を選ぶ",[13,1139,1140,1143],{},[36,1141,1142],{},"設定 → オーディオ"," で：",[142,1145,1146,1152,1158],{},[145,1147,1148,1151],{},[36,1149,1150],{},"入力デバイス"," — マイク",[145,1153,1154,1157],{},[36,1155,1156],{},"出力デバイス（PCオーディオ）"," — PCが再生している音のループバック",[145,1159,1160,1163],{},[36,1161,1162],{},"入力音量"," — キャプチャゲイン 0%〜200%",[13,1165,1166],{},"録音ボタンは、ここで選んだデバイスを使います。",[17,1168,1169],{"id":1169},"テイクを編集",[142,1171,1172,1175,1178,1186,1189,1192],{},[145,1173,1174],{},"録音と停止",[145,1176,1177],{},"入力レベルメーターを確認",[145,1179,1180,39,1183],{},[36,1181,1182],{},"ノーマライズ",[36,1184,1185],{},"ノイズキャンセレーション",[145,1187,1188],{},"クリップ全体のトリム、選択範囲へのトリム、選択の削除",[145,1190,1191],{},"元に戻す \u002F やり直し",[145,1193,1194],{},"ズームインとズームアウト",[17,1196,1197],{"id":1197},"ステージしてインポート",[213,1199,1200,1203,1206],{},[145,1201,1202],{},"選択範囲またはトラック全体をステージングリストに追加します。",[145,1204,1205],{},"リストは空から始まります。録音、編集、それからクリップを追加。",[145,1207,1208,39,1210,1212],{},[36,1209,540],{},[36,1211,543],{}," で、現在のタブまたは選んだタブに入れます。",[17,1214,1216],{"id":1215},"ステム分離任意","ステム分離（任意）",[13,1218,1219,1220,1223,1224,39,1227,1230],{},"公式のWindows \u002F macOS \u002F Linuxリリースビルドには ",[36,1221,1222],{},"ステム"," 機能が入ります。Record EditorはBS-RoFormerで ",[36,1225,1226],{},"ボーカル",[36,1228,1229],{},"音楽"," を残せます。",[13,1232,1233,1234,102,1237,1240],{},"モデルは約158 MBで、インストーラーには ",[36,1235,1236],{},"同梱されていません",[36,1238,1239],{},"設定 → ステム分離"," からダウンロードするか、初回起動のプロンプトを承認します。Windowsインストーラーも初回起動時にモデルのダウンロードを案内できます。",[13,1242,1243,1244,1019,1247,502],{},"カスタムのソースビルドには追加フラグが必要です（",[333,1245,1246],{},"tauri:serve:stems",[333,1248,1249],{},"tauri:build:stems",{"title":104,"searchDepth":105,"depth":105,"links":1251},[1252,1253,1254,1255],{"id":1137,"depth":105,"text":1137},{"id":1169,"depth":105,"text":1169},{"id":1197,"depth":105,"text":1197},{"id":1215,"depth":105,"text":1216},"マイクまたはPCオーディオを取り込み、クリップを編集してボードに置く。",{},6,"\u002Frecording-editor",{"title":1124,"description":1256},"recording-editor","7_RI-WNd1luOVgn5vTAoyTmO8dKVtHVwkffwMt4LBQc",{"id":1264,"title":1265,"body":1266,"description":1476,"extension":113,"meta":1477,"navigation":115,"order":1478,"path":1479,"seo":1480,"stem":1481,"__hash__":1482},"content_ja\u002Fremote-control.md","リモートコントロール",{"type":7,"value":1267,"toc":1469},[1268,1270,1273,1276,1307,1310,1313,1347,1350,1370,1373,1376,1408,1412,1418],[10,1269,1265],{"id":1265},[13,1271,1272],{},"SoundNinjaはローカルネットワークで待ち受け、Bitfocus Companion（または任意のHTTP\u002FWebSocketクライアント）がサウンドを再生・停止できます。",[17,1274,1275],{"id":1275},"リモートサーバーを有効化",[213,1277,1278,1284,1291,1298],{},[145,1279,1280,1283],{},[36,1281,1282],{},"設定 → リモート"," を開きます。",[145,1285,1286,1287,1290],{},"リモートサーバーを有効にします。デフォルトポートは ",[36,1288,1289],{},"7331"," です。",[145,1292,1293,1294,1297],{},"任意：トークンを設定。クライアントはBearerトークンまたは ",[333,1295,1296],{},"?token="," で送ります。",[145,1299,1300,1303,1304,1306],{},[333,1301,1302],{},"http:\u002F\u002FIP:PORT"," URLをコピーするか、",[36,1305,42],{}," からシステムIPをコピーします。",[13,1308,1309],{},"Windowsはサーバー初回起動時にファイアウォールの確認を出すことがあります。プライベートネットワークのアクセスを許可してください。",[17,1311,191],{"id":1312},"bitfocus-companion",[213,1314,1315,1322,1330,1341],{},[145,1316,1317,1321],{},[26,1318,191],{"href":1319,"rel":1320},"https:\u002F\u002Fbitfocus.io\u002Fcompanion",[30],"をインストールします。",[145,1323,1324,1329],{},[26,1325,1328],{"href":1326,"rel":1327},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002Fcompanion-module-soundninja\u002Freleases\u002Flatest",[30],"SoundNinja-Companion.tgz"," をダウンロード。Companion Storeのパッケージはまだありません。",[145,1331,1332,1333,1336,1337,1340],{},"Companionで ",[36,1334,1335],{},"Modules → Load module package"," を開き、",[333,1338,1339],{},".tgz"," を選びます。",[145,1342,1343,1346],{},[36,1344,1345],{},"Sound Ninja"," 接続を追加。PCのIP、ポート、設定したトークンを貼り付けます。",[17,1348,1349],{"id":1349},"アクション",[142,1351,1352,1358,1364],{},[145,1353,1354,1357],{},[36,1355,1356],{},"Trigger Sound"," — ライブドロップダウンから選ぶか、8文字のサウンドIDを入力（Companion変数が使えます）",[145,1359,1360,1363],{},[36,1361,1362],{},"Stop Sound"," — IDで再生中のサウンドを1つ停止",[145,1365,1366,1369],{},[36,1367,1368],{},"Stop All"," — 再生中の全サウンドを停止",[13,1371,1372],{},"SoundNinjaでは、ボタンのコンテキストメニューまたは複数選択のIDチップからサウンドIDをコピーします。",[17,1374,1375],{"id":1375},"フィードバックと変数",[142,1377,1378,1384,1396,1402],{},[145,1379,1380,1383],{},[36,1381,1382],{},"Sound Playing"," — そのサウンドIDがアクティブな間はtrue（ボタン色に使う）",[145,1385,1386,1389,1390,1019,1393],{},[333,1387,1388],{},"$(soundninja:connected)"," — ",[333,1391,1392],{},"true",[333,1394,1395],{},"false",[145,1397,1398,1401],{},[333,1399,1400],{},"$(soundninja:playing_count)"," — 再生中のサウンド数",[145,1403,1404,1407],{},[333,1405,1406],{},"$(soundninja:last_triggered)"," — 最後にトリガーしたサウンドID",[17,1409,1411],{"id":1410},"http-api上級","HTTP API（上級）",[13,1413,1414,1415],{},"ベースパス：",[333,1416,1417],{},"\u002Fapi\u002Fv1",[142,1419,1420,1426,1432,1438,1448,1454,1463],{},[145,1421,1422,1425],{},[333,1423,1424],{},"GET \u002Finfo"," — アプリ名、バージョン、プロトコル、トークンが必要か",[145,1427,1428,1431],{},[333,1429,1430],{},"GET \u002Fsounds"," — サウンド一覧（id、name、tabs、active）",[145,1433,1434,1437],{},[333,1435,1436],{},"GET \u002Fstate"," — サウンドと現在再生中のID",[145,1439,1440,1443,1444,1447],{},[333,1441,1442],{},"POST \u002Ftrigger"," に ",[333,1445,1446],{},"{ \"id\" }"," — サウンドを再生",[145,1449,1450,1453],{},[333,1451,1452],{},"GET \u002Ftrigger\u002F:id"," — 再生（ブラウザで簡単にテスト）",[145,1455,1456,1459,1460,1462],{},[333,1457,1458],{},"POST \u002Fstop"," に任意の ",[333,1461,1446],{}," — 1つまたはすべて停止",[145,1464,1465,1468],{},[333,1466,1467],{},"GET \u002Fws"," — ライブ状態。trigger\u002Fstopコマンドを受信",{"title":104,"searchDepth":105,"depth":105,"links":1470},[1471,1472,1473,1474,1475],{"id":1275,"depth":105,"text":1275},{"id":1312,"depth":105,"text":191