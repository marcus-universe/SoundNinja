[{"data":1,"prerenderedAt":1585},["ShallowReactive",2],{"docs-page-ja-\u002Finstallation":3,"docs-nav-ja":217},{"id":4,"title":5,"body":6,"description":209,"extension":210,"meta":211,"navigation":212,"order":173,"path":213,"seo":214,"stem":215,"__hash__":216},"content_ja\u002Finstallation.md","インストール",{"type":7,"value":8,"toc":202},"minimark",[9,12,28,33,57,60,64,78,81,85,110,121,124,131,134,149,182,198],[10,11,5],"h1",{"id":5},[13,14,15,20,21,27],"p",{},[16,17,19],"a",{"href":18},"\u002Fdownload","ダウンロードページ","または",[16,22,26],{"href":23,"rel":24},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Freleases\u002Flatest",[25],"nofollow","GitHub Releases","からビルドを入手してください。SoundNinjaは初期開発中なので、ビルドはベータとして扱ってください。",[29,30,32],"h2",{"id":31},"windows","Windows",[34,35,36,48,51,54],"ul",{},[37,38,39,40,44,45],"li",{},"64ビットWindows向けの",[41,42,43],"strong",{},"インストーラー (.exe)"," または ",[41,46,47],{},"MSI (.msi)",[37,49,50],{},"ランディングページの対象：Windows 10以降",[37,52,53],{},"アプリのREADMEはWindows 8以上も記載",[37,55,56],{},"NSISインストーラーはダークテーマ。セットアップ時に言語を選ぶと、次回起動時にSoundNinjaが覚えます。",[13,58,59],{},"インストーラーを実行し、スタートメニューからSoundNinjaを起動します。",[29,61,63],{"id":62},"macos","macOS",[34,65,66,72,75],{},[37,67,68,69],{},"Apple SiliconとIntel向けの",[41,70,71],{},"ユニバーサル .dmg",[37,73,74],{},"ランディングページの対象：macOS 10.14以降",[37,76,77],{},"アプリのREADMEはmacOS 10.15以上を記載",[13,79,80],{},"ディスクイメージを開き、SoundNinjaをアプリケーションにドラッグします。",[29,82,84],{"id":83},"linux","Linux",[34,86,87,93,99,107],{},[37,88,89,90],{},"Ubuntu \u002F Debian向けの",[41,91,92],{},"Debian (.deb)",[37,94,95,96],{},"その他のディストリ向けの",[41,97,98],{},"AppImage",[37,100,101,102,106],{},"リリース公開後、ArchユーザーはAURから",[103,104,105],"code",{},"soundninja-bin","をインストールできます",[37,108,109],{},"Ubuntu 20.04でテスト済み",[13,111,112,113,116,117,120],{},"デスクトップビルドにはWebKitとGTKのパッケージが必要です。Debian\u002FUbuntuでは通常、",[103,114,115],{},"libwebkit2gtk","、",[103,118,119],{},"libgtk-3-0","、app-indicatorライブラリです。",[29,122,123],{"id":123},"アップデート",[13,125,126,127,130],{},"アプリ内で ",[41,128,129],{},"ヘルプ → アップデートを確認"," を開きます。設定で起動時にSoundNinjaが確認するようにもできます。",[29,132,133],{"id":133},"ソースからビルド",[13,135,136,137,142,143,148],{},"カスタムビルドが必要なら、",[16,138,141],{"href":139,"rel":140},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja",[25],"リポジトリ","をクローンし、",[16,144,147],{"href":145,"rel":146},"https:\u002F\u002Fv2.tauri.app\u002Fstart\u002Fprerequisites\u002F",[25],"Tauriの前提条件","を入れたうえで：",[150,151,156],"pre",{"className":152,"code":153,"language":154,"meta":155,"style":155},"language-bash shiki shiki-themes github-light github-dark","bun install\nbun run tauri:serve\n","bash","",[103,157,158,171],{"__ignoreMap":155},[159,160,163,167],"span",{"class":161,"line":162},"line",1,[159,164,166],{"class":165},"sScJk","bun",[159,168,170],{"class":169},"sZZnC"," install\n",[159,172,174,176,179],{"class":161,"line":173},2,[159,175,166],{"class":165},[159,177,178],{"class":169}," run",[159,180,181],{"class":169}," tauri:serve\n",[13,183,184,116,187,116,190,193,194,197],{},[103,185,186],{},"npm",[103,188,189],{},"pnpm",[103,191,192],{},"deno","でも動きます。本番ビルド：",[103,195,196],{},"bun run tauri:build","。",[199,200,201],"style",{},"html pre.shiki code .sScJk, html code.shiki .sScJk{--shiki-default:#6F42C1;--shiki-dark:#B392F0}html pre.shiki code .sZZnC, html code.shiki .sZZnC{--shiki-default:#032F62;--shiki-dark:#9ECBFF}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html.dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}",{"title":155,"searchDepth":173,"depth":173,"links":203},[204,205,206,207,208],{"id":31,"depth":173,"text":32},{"id":62,"depth":173,"text":63},{"id":83,"depth":173,"text":84},{"id":123,"depth":173,"text":123},{"id":133,"depth":173,"text":133},"Windows、macOS、LinuxにSoundNinjaをインストール。","md",{},true,"\u002Finstallation",{"title":5,"description":209},"installation","Y0LyjIaCaa6QDprLZ1KDPjTfWKBUFvFm5ERbBT-RfpY",[218,341,464,605,996,1128,1269,1490],{"id":219,"title":220,"body":221,"description":335,"extension":210,"meta":336,"navigation":212,"order":162,"path":337,"seo":338,"stem":339,"__hash__":340},"content_ja\u002Foverview.md","概要",{"type":7,"value":222,"toc":329},[223,225,228,231,234,237,251,254,293,296,305,308],[10,224,220],{"id":220},[13,226,227],{},"SoundNinjaは、ライブ配信、友だちとのチャット、ポッドキャスト収録向けのオープンソースサウンドボードです。Tauri v2とNuxt 4で構築されており、RAMとディスクの負荷を抑えています。",[13,229,230],{},"目標はシンプルです。巨大なサウンドライブラリをすばやく眺め、目的のクリップをミリ秒で再生すること。UIはVRのダッシュボードとしても使いやすいです。",[13,232,233],{},"SoundNinjaはまだ初期開発段階です。機能は動きますが、すべてのプラットフォームで完全に検証されているわけではありません。",[29,235,236],{"id":236},"対象ユーザー",[34,238,239,242,245,248],{},[37,240,241],{},"即時のサウンドキューが必要な配信者",[37,243,244],{},"ボイスチャット用の共有ボードが欲しい友だち",[37,246,247],{},"クリップを録ってボードに置くポッドキャスター",[37,249,250],{},"カスタマイズ可能な、ローカル優先のサウンドボードが欲しい人",[29,252,253],{"id":253},"できること",[34,255,256,259,262,265,268,271,274,277,280,287,290],{},[37,257,258],{},"自分の音声ファイルからサウンドボードを作る",[37,260,261],{},"色付きタブ、グループ、タグ、検索で整理する",[37,263,264],{},"タグでフィルター（OR）、名前・日付・長さ・サイズでソート",[37,266,267],{},"マーキーまたはShift範囲で複数選択し、色・移動・削除を一括",[37,269,270],{},"コンテキストメニューでサウンドごとの音量を設定",[37,272,273],{},"Theme Creatorで見た目をデザインする",[37,275,276],{},"Record EditorでPCオーディオまたはマイクを録音する",[37,278,279],{},"個別のサウンドにホットキーを割り当てる",[37,281,282,286],{},[16,283,285],{"href":284},"\u002Fdocs\u002Fremote-control","Bitfocus Companion","からサウンドをトリガーする",[37,288,289],{},"サウンドボード全体をインポート／エクスポートして共有する",[37,291,292],{},"サウンドボタンにGIFや画像を使う — ローカルフォルダライブラリまたはKLIPY",[29,294,295],{"id":295},"ライセンス",[13,297,298,299,304],{},"SoundNinjaは",[16,300,303],{"href":301,"rel":302},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fblob\u002Fmain\u002FLICENSE",[25],"GPL-3.0","のフリーソフトウェアです。フォーク、改変、共有できます。",[29,306,307],{"id":307},"次のステップ",[309,310,311,317,323],"ol",{},[37,312,313],{},[16,314,316],{"href":315},"\u002Fdocs\u002Finstallation","SoundNinjaをインストール",[37,318,319],{},[16,320,322],{"href":321},"\u002Fdocs\u002Fadding-sounds","サウンドを追加",[37,324,325],{},[16,326,328],{"href":327},"\u002Fdocs\u002Forganizing-sounds","ボードを整理",{"title":155,"searchDepth":173,"depth":173,"links":330},[331,332,333,334],{"id":236,"depth":173,"text":236},{"id":253,"depth":173,"text":253},{"id":295,"depth":173,"text":295},{"id":307,"depth":173,"text":307},"SoundNinjaとは何か、何ができるか。",{},"\u002Foverview",{"title":220,"description":335},"overview","c8xWgFwxVyANkJ28nfjNkL8am61Nn8aDvVh7jKzMyKM",{"id":4,"title":5,"body":342,"description":209,"extension":210,"meta":462,"navigation":212,"order":173,"path":213,"seo":463,"stem":215,"__hash__":216},{"type":7,"value":343,"toc":455},[344,346,353,355,369,371,373,383,385,387,403,409,411,415,417,425,443,453],[10,345,5],{"id":5},[13,347,348,20,350,27],{},[16,349,19],{"href":18},[16,351,26],{"href":23,"rel":352},[25],[29,354,32],{"id":31},[34,356,357,363,365,367],{},[37,358,39,359,44,361],{},[41,360,43],{},[41,362,47],{},[37,364,50],{},[37,366,53],{},[37,368,56],{},[13,370,59],{},[29,372,63],{"id":62},[34,374,375,379,381],{},[37,376,68,377],{},[41,378,71],{},[37,380,74],{},[37,382,77],{},[13,384,80],{},[29,386,84],{"id":83},[34,388,389,393,397,401],{},[37,390,89,391],{},[41,392,92],{},[37,394,95,395],{},[41,396,98],{},[37,398,101,399,106],{},[103,400,105],{},[37,402,109],{},[13,404,112,405,116,407,120],{},[103,406,115],{},[103,408,119],{},[29,410,123],{"id":123},[13,412,126,413,130],{},[41,414,129],{},[29,416,133],{"id":133},[13,418,136,419,142,422,148],{},[16,420,141],{"href":139,"rel":421},[25],[16,423,147],{"href":145,"rel":424},[25],[150,426,427],{"className":152,"code":153,"language":154,"meta":155,"style":155},[103,428,429,435],{"__ignoreMap":155},[159,430,431,433],{"class":161,"line":162},[159,432,166],{"class":165},[159,434,170],{"class":169},[159,436,437,439,441],{"class":161,"line":173},[159,438,166],{"class":165},[159,440,178],{"class":169},[159,442,181],{"class":169},[13,444,445,116,447,116,449,193,451,197],{},[103,446,186],{},[103,448,189],{},[103,450,192],{},[103,452,196],{},[199,454,201],{},{"title":155,"searchDepth":173,"depth":173,"links":456},[457,458,459,460,461],{"id":31,"depth":173,"text":32},{"id":62,"depth":173,"text":63},{"id":83,"depth":173,"text":84},{"id":123,"depth":173,"text":123},{"id":133,"depth":173,"text":133},{},{"title":5,"description":209},{"id":465,"title":466,"body":467,"description":598,"extension":210,"meta":599,"navigation":212,"order":600,"path":601,"seo":602,"stem":603,"__hash__":604},"content_ja\u002Fadding-sounds.md","サウンドの追加",{"type":7,"value":468,"toc":590},[469,471,474,477,495,498,529,532,551,554,568,571,574,581,584],[10,470,466],{"id":466},[13,472,473],{},"クリップを追加するまで、ボードは空です。SoundNinjaはファイル、フォルダ全体、録音、共有サウンドボードパックをインポートできます。",[29,475,476],{"id":476},"音声ファイルをインポート",[309,478,479,489,492],{},[37,480,481,484,485,488],{},[41,482,483],{},"ファイル → 音声ファイルをインポート","、またはナビバーの ",[41,486,487],{},"インポート"," を使います。",[37,490,491],{},"1つ以上の音声ファイルを選びます。",[37,493,494],{},"サウンドは現在のタブに入ります。",[29,496,497],{"id":497},"フォルダをインポート",[309,499,500,509,512],{},[37,501,502,505,506,508],{},[41,503,504],{},"ファイル → フォルダをインポート","（またはナビバーの ",[41,507,497],{},"）。",[37,510,511],{},"1つ以上のフォルダを追加。インポート前にドラッグで並べ替えできます。",[37,513,514,515],{},"配置方法を選びます：\n",[34,516,517,523],{},[37,518,519,522],{},[41,520,521],{},"タブとしてインポート"," — 各フォルダが独自のタブになる",[37,524,525,528],{},[41,526,527],{},"現在のタブにインポート"," — すべてのファイルがアクティブなタブに入る",[29,530,531],{"id":531},"クリップを録音",[13,533,534,535,538,539,543,544,44,547,550],{},"プレイヤーバーの ",[41,536,537],{},"録音"," ボタンから",[16,540,542],{"href":541},"\u002Fdocs\u002Frecording-editor","Record Editor","を開きます。キャプチャ、トリムし、",[41,545,546],{},"選択をインポート",[41,548,549],{},"すべてインポート"," で現在のタブまたは選んだタブに入れます。",[29,552,553],{"id":553},"サウンドボードをインポート",[13,555,556,559,560,563,564,567],{},[41,557,558],{},"ファイル → サウンドボードをインポート"," で共有パックを読み込みます。パックは ",[103,561,562],{},"project.sninja"," とサウンドファイルを含む ",[103,565,566],{},".zip"," です。インポート後、プロジェクトを開いて再生します。",[13,569,570],{},"複数のプロジェクト（プロファイル）も保てます。プロジェクトセレクターでボードを切り替えます。",[29,572,573],{"id":573},"見つからないファイルを再リンク",[13,575,576,577,580],{},"ディスク上で音声ファイルが移動すると、SoundNinjaは ",[41,578,579],{},"見つからないサウンドファイル"," ダイアログを表示します。検索するフォルダを選び、クリップを再リンクします。",[29,582,583],{"id":583},"次へ",[13,585,586,587,197],{},"タブ、タグ、フィルター、ホットキーの整理は",[16,588,589],{"href":327},"サウンドの整理",{"title":155,"searchDepth":173,"depth":173,"links":591},[592,593,594,595,596,597],{"id":476,"depth":173,"text":476},{"id":497,"depth":173,"text":497},{"id":531,"depth":173,"text":531},{"id":553,"depth":173,"text":553},{"id":573,"depth":173,"text":573},{"id":583,"depth":173,"text":583},"音声、フォルダ、録音、共有サウンドボードをインポート。",{},3,"\u002Fadding-sounds",{"title":466,"description":598},"adding-sounds","5_cjd2COcPz0pj4ZrBehCZv6ouzBimE8UGjkcfngQjw",{"id":606,"title":589,"body":607,"description":989,"extension":210,"meta":990,"navigation":212,"order":991,"path":992,"seo":993,"stem":994,"__hash__":995},"content_ja\u002Forganizing-sounds.md",{"type":7,"value":608,"toc":974},[609,611,618,621,646,653,656,659,673,680,686,690,700,704,734,737,743,746,780,787,791,794,820,823,827,840,843,848,869,885,892,895,906,909,913,920,930,936,939,947,954,971],[10,610,589],{"id":589},[13,612,613,614,617],{},"SoundNinjaは大規模ライブラリ向けです。",[41,615,616],{},"タグとフィルター","、タブ、検索、複数選択、ホットキーで、必要なクリップをワンクリック（またはワンキー）で出せます。",[29,619,620],{"id":620},"タブ",[34,622,623,629,635],{},[37,624,625,628],{},[41,626,627],{},"タブを追加"," でタブを作り、色を付けてバーをすばやく眺められます。",[37,630,631,634],{},[41,632,633],{},"すべて"," ビューはタブを横断して全サウンドを表示します。",[37,636,637,638,641,642,645],{},"サウンドは ",[41,639,640],{},"1つ以上のタブ"," に所属できます。サウンドを右クリックし、",[41,643,644],{},"タブへ移動"," で割り当てます。",[13,647,648,649,652],{},"タブの切り替え演出は ",[41,650,651],{},"設定 → メイン","：スライド、フェード、ボタンを1つずつ、またはなし。",[29,654,655],{"id":655},"グループ",[13,657,658],{},"v0.5.3以降、セパレーターを名前付きグループにできます：",[34,660,661,664,667,670],{},[37,662,663],{},"コンテキストメニューからグループの追加、名前変更、削除",[37,665,666],{},"グループヘッダーをドラッグ — 子も一緒に動く",[37,668,669],{},"グループにサウンドを入れたり出したり",[37,671,672],{},"グループの枠線色、名前の色、ボタン配置を設定（またはタブのデフォルトを使う）",[13,674,675,676,679],{},"見た目の区切りだけなら、通常の ",[41,677,678],{},"セパレーター"," も追加できます。",[13,681,682,683,197],{},"ボードの空き領域を右クリックして ",[41,684,685],{},"グループを追加",[29,687,689],{"id":688},"タグ-フィルター","タグ \u002F フィルター",[13,691,692,693,696,697,699],{},"タグはタブを横断します。スライドアウトの ",[41,694,695],{},"フィルター"," パネル（サイドバー ",[41,698,695],{},"）で作成し、ボードを絞ります。",[701,702,703],"h3",{"id":703},"タグの作成と編集",[309,705,706,712,722,728],{},[37,707,708,709,711],{},"サイドバーで ",[41,710,695],{}," を開く。",[37,713,714,717,718,721],{},[41,715,716],{},"タグ"," の ",[41,719,720],{},"タグを追加"," — 名前と色を付ける。",[37,723,724,725,197],{},"同じリストで名前変更、色変更、",[41,726,727],{},"タグを削除",[37,729,730,733],{},[41,731,732],{},"タグはまだありません"," と出たら、割り当てる前にここで追加する。",[701,735,736],{"id":736},"サウンドにタグを付ける",[13,738,739,740,742],{},"サウンドを右クリック → ",[41,741,716],{},"（チェックボックス）。1つのサウンドに複数可。タグが無い場合、メニューはフィルターパネルへ案内します。",[701,744,745],{"id":745},"ボードをフィルター",[34,747,748,755,766,777],{},[37,749,750,751,754],{},"フィルターパネル、または ",[41,752,753],{},"検索バー下のチップ"," でタグを切り替え。",[37,756,757,758,761,762,765],{},"一致は ",[41,759,760],{},"OR","：選択したタグの ",[41,763,764],{},"いずれか"," を持つサウンドが表示される。",[37,767,768,769,772,773,776],{},"ナビバーの ",[41,770,771],{},"検索"," は有効なタグフィルターと ",[41,774,775],{},"AND","（入力 + タグ）。",[37,778,779],{},"チップをオフ（またはフィルター解除）でタブ全体を再表示。",[13,781,782,783,786],{},"色付きタグ名をボタンに表示できます。",[41,784,785],{},"設定 → 動作 → タグバッジを表示"," で切り替え。",[29,788,790],{"id":789},"並べ替えソート","並べ替え（ソート）",[13,792,793],{},"フィルターパネルでソートモードを選びます：",[34,795,796,802],{},[37,797,798,801],{},[41,799,800],{},"ユーザー定義"," — タブ順、グループ表示",[37,803,804,116,807,116,810,116,813,816,817],{},[41,805,806],{},"名前",[41,808,809],{},"追加日時",[41,811,812],{},"再生時間",[41,814,815],{},"ファイルサイズ"," — フラットなソート一覧。これらのモードでは ",[41,818,819],{},"グループは非表示",[13,821,822],{},"再生時間ソートは、初回に長さのメタデータを準備することがあります。",[29,824,826],{"id":825},"並べ替えドラッグ","並べ替え（ドラッグ）",[13,828,829,832,833,836,837,839],{},[41,830,831],{},"設定 → 動作"," でドラッグ＆ドロップをオンにします（",[41,834,835],{},"並べ替えを許可","）。その後、サウンドとグループをドラッグして配置します。ドラッグ並べ替えは ",[41,838,800],{}," ソートで有効です。",[29,841,842],{"id":842},"複数選択",[13,844,768,845,847],{},[41,846,842],{}," をオンにして：",[34,849,850,853,859,866],{},[37,851,852],{},"クリックでサウンドをトグル",[37,854,855,858],{},[41,856,857],{},"Shift+クリック"," で直前のアンカーから範囲選択",[37,860,861,862,865],{},"空きボード上で ",[41,863,864],{},"マーキー"," をドラッグ",[37,867,868],{},"空きボード（または外側）をクリックして選択解除",[13,870,871,872,116,875,116,878,116,881,884],{},"一括バーに件数が表示され、",[41,873,874],{},"色",[41,876,877],{},"タブへ移動…",[41,879,880],{},"削除",[41,882,883],{},"完了"," が使えます。",[13,886,887,888,891],{},"複数選択中、各ボタンに ",[41,889,890],{},"8文字のIDチップ"," が出ます。チップを右クリックでコピー。",[29,893,894],{"id":894},"サウンドごとの音量",[13,896,897,898,901,902,905],{},"右クリック → ",[41,899,900],{},"音量","。スライダーを 0%〜100%。",[41,903,904],{},"ダブルクリック"," で 100% にリセット。",[13,907,908],{},"設定のマスター出力音量と重ねて効きます。",[29,910,912],{"id":911},"ホットキーとサウンドid","ホットキーとサウンドID",[13,914,915,916,919],{},"すべてのサウンドには8文字のIDがあります。ボタンのコンテキストメニュー（",[41,917,918],{},"IDをコピー","）、または複数選択のIDチップからコピーします。",[13,921,922,925,926,929],{},[41,923,924],{},"設定 → ホットキー"," を開き、キーをサウンドIDに割り当てます。グローバルホットキーは任意です。コンテキストメニューの ",[41,927,928],{},"ホットキーを割り当て"," は、IDを埋めた状態でそこにジャンプします。",[13,931,932,933,935],{},"同じIDを",[16,934,285],{"href":284},"がクリップのトリガーに使います。",[29,937,938],{"id":938},"背景画像と色",[13,940,941,942,946],{},"サウンドを右クリックして、ボタンごとの色や背景画像を設定します。ボード全体を整える",[16,943,945],{"href":944},"\u002Fdocs\u002Ftheme-editor","Theme Creator","とは別です。",[13,948,949,950,953],{},"ピッカーは ",[41,951,952],{},"背景画像"," ダイアログ（PNG、JPEG、GIF、WebP）：",[34,955,956,962],{},[37,957,958,961],{},[41,959,960],{},"ローカルファイル"," — フォルダ追加、単一ファイル選択、ファイル名検索、グリッドプレビュー、ライブラリからフォルダ削除",[37,963,964,967,968,970],{},[41,965,966],{},"KLIPY"," — オンラインGIFを検索。APIキーは ",[41,969,831],{},"。キーはプロジェクトファイルには保存されません。",[13,972,973],{},"画像を選んだあと、ボタン上でパンとクロップできます。",{"title":155,"searchDepth":173,"depth":173,"links":975},[976,977,978,983,984,985,986,987,988],{"id":620,"depth":173,"text":620},{"id":655,"depth":173,"text":655},{"id":688,"depth":173,"text":689,"children":979},[980,981,982],{"id":703,"depth":600,"text":703},{"id":736,"depth":600,"text":736},{"id":745,"depth":600,"text":745},{"id":789,"depth":173,"text":790},{"id":825,"depth":173,"text":826},{"id":842,"depth":173,"text":842},{"id":894,"depth":173,"text":894},{"id":911,"depth":173,"text":912},{"id":938,"depth":173,"text":938},"タグ、フィルター、タブ、グループ、並べ替え、複数選択、音量、ホットキー。",{},4,"\u002Forganizing-sounds",{"title":589,"description":989},"organizing-sounds","PGqVreiuZb1jRxkXIW9tv66PvwPYs2iRx5-4j_D8sho",{"id":997,"title":998,"body":999,"description":1121,"extension":210,"meta":1122,"navigation":212,"order":1123,"path":1124,"seo":1125,"stem":1126,"__hash__":1127},"content_ja\u002Ftheme-editor.md","テーマエディター",{"type":7,"value":1000,"toc":1115},[1001,1003,1010,1014,1041,1044,1047,1061,1064,1090,1093,1096,1101],[10,1002,998],{"id":998},[13,1004,1005,1006,1009],{},"Theme Creatorは、ボードの完全なビジュアルエディターです。",[41,1007,1008],{},"設定 → メイン → Theme Creator"," から開きます。",[29,1011,1013],{"id":1012},"_3つのタブ","3つのタブ",[309,1015,1016,1030,1036],{},[37,1017,1018,1021,1022,1025,1026,1029],{},[41,1019,1020],{},"一般"," — テーマ名、共有色、フォントのアップロード（",[103,1023,1024],{},".ttf"," \u002F ",[103,1027,1028],{},".otf","）",[37,1031,1032,1035],{},[41,1033,1034],{},"ボタン"," — サウンドボタンの色、書体、レイアウト、GIFオーバーレイ",[37,1037,1038,1040],{},[41,1039,620],{}," — タブバーの色、書体、枠線の太さ",[13,1042,1043],{},"編集中、ライブプレビューがタブとボタンを表示します。",[29,1045,1046],{"id":1046},"変更できる項目",[34,1048,1049,1052,1055,1058],{},[37,1050,1051],{}