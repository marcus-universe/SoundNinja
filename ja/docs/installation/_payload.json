,[41,128,129],{},"ヘルプ → アップデートを確認"," を開きます。設定で起動時にSoundNinjaが確認するようにもできます。",[29,132,133],{"id":133},"ソースからビルド",[13,135,136,137,142,143,148],{},"カスタムビルドが必要なら、",[16,138,141],{"href":139,"rel":140},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja",[25],"リポジトリ","をクローンし、",[16,144,147],{"href":145,"rel":146},"https:\u002F\u002Fv2.tauri.app\u002Fstart\u002Fprerequisites\u002F",[25],"Tauriの前提条件","を入れたうえで：",[150,151,156],"pre",{"className":152,"code":153,"language":154,"meta":155,"style":155},"language-bash shiki shiki-themes github-light github-dark","bun install\nbun run tauri:serve\n","bash","",[103,157,158,171],{"__ignoreMap":155},[159,160,163,167],"span",{"class":161,"line":162},"line",1,[159,164,166],{"class":165},"sScJk","bun",[159,168,170],{"class":169},"sZZnC"," install\n",[159,172,174,176,179],{"class":161,"line":173},2,[159,175,166],{"class":165},[159,177,178],{"class":169}," run",[159,180,181],{"class":169}," tauri:serve\n",[13,183,184,116,187,116,190,193,194,197],{},[103,185,186],{},"npm",[103,188,189],{},"pnpm",[103,191,192],{},"deno","でも動きます。本番ビルド：",[103,195,196],{},"bun run tauri:build","。",[13,199,200,203,204,209,210,213,214,197],{},[41,201,202],{},"Windowsのみ:"," Windowsビルドはすべて ",[16,205,208],{"href":206,"rel":207},"https:\u002F\u002Fwww.steinberg.net\u002Fasiosdk",[25],"Steinberg ASIO SDK"," 経由でASIOを含めます。一度 ",[103,211,212],{},"bun run setup:asio"," を実行（SDKはgitに含まれません）。Linux \u002F macOSは PipeWire \u002F Core Audio — この手順は不要。詳細: ",[16,215,218],{"href":216,"rel":217},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fblob\u002Fmain\u002Fdocs\u002Fbuild-from-source.md",[25],"build-from-source.md",[220,221,222],"style",{},"html pre.shiki code .sScJk, html code.shiki .sScJk{--shiki-default:#6F42C1;--shiki-dark:#B392F0}html pre.shiki code .sZZnC, html code.shiki .sZZnC{--shiki-default:#032F62;--shiki-dark:#9ECBFF}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html.dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}",{"title":155,"searchDepth":173,"depth":173,"links":224},[225,226,227,228,229],{"id":31,"depth":173,"text":32},{"id":62,"depth":173,"text":63},{"id":83,"depth":173,"text":84},{"id":123,"depth":173,"text":123},{"id":133,"depth":173,"text":133},"Windows、macOS、LinuxにSoundNinjaをインストール。","md",{},true,"\u002Finstallation",{"title":5,"description":230},"installation","IjZd1P7FnQS2uqb_Mqyrc5OsF5e06cfW8q5sH_3_mkY",[239,362,497,638,1029,1161,1302,1523],{"id":240,"title":241,"body":242,"description":356,"extension":231,"meta":357,"navigation":233,"order":162,"path":358,"seo":359,"stem":360,"__hash__":361},"content_ja\u002Foverview.md","概要",{"type":7,"value":243,"toc":350},[244,246,249,252,255,258,272,275,314,317,326,329],[10,245,241],{"id":241},[13,247,248],{},"SoundNinjaは、ライブ配信、友だちとのチャット、ポッドキャスト収録向けのオープンソースサウンドボードです。Tauri v2とNuxt 4で構築されており、RAMとディスクの負荷を抑えています。",[13,250,251],{},"目標はシンプルです。巨大なサウンドライブラリをすばやく眺め、目的のクリップをミリ秒で再生すること。UIはVRのダッシュボードとしても使いやすいです。",[13,253,254],{},"SoundNinjaはまだ初期開発段階です。機能は動きますが、すべてのプラットフォームで完全に検証されているわけではありません。",[29,256,257],{"id":257},"対象ユーザー",[34,259,260,263,266,269],{},[37,261,262],{},"即時のサウンドキューが必要な配信者",[37,264,265],{},"ボイスチャット用の共有ボードが欲しい友だち",[37,267,268],{},"クリップを録ってボードに置くポッドキャスター",[37,270,271],{},"カスタマイズ可能な、ローカル優先のサウンドボードが欲しい人",[29,273,274],{"id":274},"できること",[34,276,277,280,283,286,289,292,295,298,301,308,311],{},[37,278,279],{},"自分の音声ファイルからサウンドボードを作る",[37,281,282],{},"色付きタブ、グループ、タグ、検索で整理する",[37,284,285],{},"タグでフィルター（OR）、名前・日付・長さ・サイズでソート",[37,287,288],{},"マーキーまたはShift範囲で複数選択し、色・移動・削除を一括",[37,290,291],{},"コンテキストメニューでサウンドごとの音量を設定",[37,293,294],{},"Theme Creatorで見た目をデザインする",[37,296,297],{},"Record EditorでPCオーディオまたはマイクを録音する",[37,299,300],{},"個別のサウンドにホットキーを割り当てる",[37,302,303,307],{},[16,304,306],{"href":305},"\u002Fdocs\u002Fremote-control","Bitfocus Companion","からサウンドをトリガーする",[37,309,310],{},"サウンドボード全体をインポート／エクスポートして共有する",[37,312,313],{},"サウンドボタンにGIFや画像を使う — ローカルフォルダライブラリまたはKLIPY",[29,315,316],{"id":316},"ライセンス",[13,318,319,320,325],{},"SoundNinjaは",[16,321,324],{"href":322,"rel":323},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fblob\u002Fmain\u002FLICENSE",[25],"GPL-3.0","のフリーソフトウェアです。フォーク、改変、共有できます。",[29,327,328],{"id":328},"次のステップ",[330,331,332,338,344],"ol",{},[37,333,334],{},[16,335,337],{"href":336},"\u002Fdocs\u002Finstallation","SoundNinjaをインストール",[37,339,340],{},[16,341,343],{"href":342},"\u002Fdocs\u002Fadding-sounds","サウンドを追加",[37,345,346],{},[16,347,349],{"href":348},"\u002Fdocs\u002Forganizing-sounds","ボードを整理",{"title":155,"searchDepth":173,"depth":173,"links":351},[352,353,354,355],{"id":257,"depth":173,"text":257},{"id":274,"depth":173,"text":274},{"id":316,"depth":173,"text":316},{"id":328,"depth":173,"text":328},"SoundNinjaとは何か、何ができるか。",{},"\u002Foverview",{"title":241,"description":356},"overview","c8xWgFwxVyANkJ28nfjNkL8am61Nn8aDvVh7jKzMyKM",{"id":4,"title":5,"body":363,"description":230,"extension":231,"meta":495,"navigation":233,"order":173,"path":234,"seo":496,"stem":236,"__hash__":237},{"type":7,"value":364,"toc":488},[365,367,374,376,390,392,394,404,406,408,424,430,432,436,438,446,464,474,486],[10,366,5],{"id":5},[13,368,369,20,371,27],{},[16,370,19],{"href":18},[16,372,26],{"href":23,"rel":3