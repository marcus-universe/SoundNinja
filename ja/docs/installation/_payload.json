まで、ボードは空です。SoundNinjaはファイル、フォルダ全体、録音、共有サウンドボードパックをインポートできます。",[29,508,509],{"id":509},"音声ファイルをインポート",[330,511,512,522,525],{},[37,513,514,517,518,521],{},[41,515,516],{},"ファイル → 音声ファイルをインポート","、またはナビバーの ",[41,519,520],{},"インポート"," を使います。",[37,523,524],{},"1つ以上の音声ファイルを選びます。",[37,526,527],{},"サウンドは現在のタブに入ります。",[29,529,530],{"id":530},"フォルダをインポート",[330,532,533,542,545],{},[37,534,535,538,539,541],{},[41,536,537],{},"ファイル → フォルダをインポート","（またはナビバーの ",[41,540,530],{},"）。",[37,543,544],{},"1つ以上のフォルダを追加。インポート前にドラッグで並べ替えできます。",[37,546,547,548],{},"配置方法を選びます：\n",[34,549,550,556],{},[37,551,552,555],{},[41,553,554],{},"タブとしてインポート"," — 各フォルダが独自のタブになる",[37,557,558,561],{},[41,559,560],{},"現在のタブにインポート"," — すべてのファイルがアクティブなタブに入る",[29,563,564],{"id":564},"クリップを録音",[13,566,567,568,571,572,576,577,44,580,583],{},"プレイヤーバーの ",[41,569,570],{},"録音"," ボタンから",[16,573,575],{"href":574},"\u002Fdocs\u002Frecording-editor","Record Editor","を開きます。キャプチャ、トリムし、",[41,578,579],{},"選択をインポート",[41,581,582],{},"すべてインポート"," で現在のタブまたは選んだタブに入れます。",[29,585,586],{"id":586},"サウンドボードをインポート",[13,588,589,592,593,596,597,600],{},[41,590,591],{},"ファイル → サウンドボードをインポート"," で共有パックを読み込みます。パックは ",[103,594,595],{},"project.sninja"," とサウンドファイルを含む ",[103,598,599],{},".zip"," です。インポート後、プロジェクトを開いて再生します。",[13,602,603],{},"複数のプロジェクト（プロファイル）も保てます。プロジェクトセレクターでボードを切り替えます。",[29,605,606],{"id":606},"見つからないファイルを再リンク",[13,608,609,610,613],{},"ディスク上で音声ファイルが移動すると、SoundNinjaは ",[41,611,612],{},"見つからないサウンドファイル"," ダイアログを表示します。検索するフォルダを選び、クリップを再リンクします。",[29,615,616],{"id":616},"次へ",[13,618,619,620,197],{},"タブ、タグ、フィルター、ホットキーの整理は",[16,621,622],{"href":348},"サウンドの整理",{"title":155,"searchDepth":173,"depth":173,"links":624},[625,626,627,628,629,630],{"id":509,"depth":173,"text":509},{"id":530,"depth":173,"text":530},{"id":564,"depth":173,"text":564},{"id":586,"depth":173,"text":586},{"id":606,"depth":173,"text":606},{"id":616,"depth":173,"text":616},"音声、フォルダ、録音、共有サウンドボードをインポート。",{},3,"\u002Fadding-sounds",{"title":499,"description":631},"adding-sounds","5_cjd2COcPz0pj4ZrBehCZv6ouzBimE8UGjkcfngQjw",{"id":639,"title":622,"body":640,"description":1022,"extension":231,"meta":1023,"navigation":233,"order":1024,"path":1025,"seo":1026,"stem":1027,"__hash__":1028},"content_ja\u002Forganizing-sounds.md",{"type":7,"value":641,"toc":1007},[642,644,651,654,679,686,689,692,706,713,719,723,733,737,767,770,776,779,813,820,824,827,853,856,860,873,876,881,902,918,925,928,939,942,946,953,963,969,972,980,987,1004],[10,643,622],{"id":622},[13,645,646,647,650],{},"SoundNinjaは大規模ライブラリ向けです。",[41,648,649],{},"タグとフィルター","、タブ、検索、複数選択、ホットキーで、必要なクリップをワンクリック（またはワンキー）で出せます。",[29,652,653],{"id":653},"タブ",[34,655,656,662,668],{},[37,657,658,661],{},[41,659,660],{},"タブを追加"," でタブを作り、色を付けてバーをすばやく眺められます。",[37,663,664,667],{},[41,665,666],{},"すべて"," ビューはタブを横断して全サウンドを表示します。",[37,669,670,671,674,675,678],{},"サウンドは ",[41,672,673],{},"1つ以上のタブ"," に所属できます。サウンドを右クリックし、",[41,676,677],{},"タブへ移動"," で割り当てます。",[13,680,681,682,685],{},"タブの切り替え演出は ",[41,683,684],{},"設定 → メイン","：スライド、フェード、ボタンを1つずつ、またはなし。",[29,687,688],{"id":688},"グループ",[13,690,691],{},"v0.5.3以降、セパレーターを名前付きグループにできます：",[34,693,694,697,700,703],{},[37,695,696],{},"コンテキストメニューからグループの追加、名前変更、削除",[37,698,699],{},"グループヘッダーをドラッグ — 子も一緒に動く",[37,701,702],{},"グループにサウンドを入れたり出したり",[37,704,705],{},"グループの枠線色、名前の色、ボタン配置を設定（またはタブのデフォルトを使う）",[13,707,708,709,712],{},"見た目の区切りだけなら、通常の ",[41,710,711],{},"セパレーター"," も追加できます。",[13,714,715,716,197],{},"ボードの空き領域を右クリックして ",[41,717,718],{},"グループを追加",[29,720,722],{"id":721},"タグ-フィルター","タグ \u002F フィルター",[13,724,725,726,729,730,732],{},"タグはタブを横断します。スライドアウトの ",[41,727,728],{},"フィルター"," パネル（サイドバー ",[41,731,728],{},"）で作成し、ボードを絞ります。",[734,735,736],"h3",{"id":736},"タグの作成と編集",[330,738,739,745,755,761],{},[37,740,741,742,744],{},"サイドバーで ",[41,743,728],{}," を開く。",[37,746,747,750,751,754],{},[41,748,749],{},"タグ"," の ",[41,752,753],{},"タグを追加"," — 名前と色を付ける。",[37,756,757,758,197],{},"同じリストで名前変更、色変更、",[41,759,760],{},"タグを削除",[37,762,763,766],{},[41,764,765],{},"タグはまだありません"," と出たら、割り当てる前にここで追加する。",[734,768,769],{"id":769},"サウンドにタグを付ける",[13,771,772,773,775],{},"サウンドを右クリック → ",[41,774,749],{},"（チェックボックス）。1つのサウンドに複数可。タグが無い場合、メニューはフィルターパネルへ案内します。",[734,777,778],{"id":778},"ボードをフィルター",[34,780,781,788,799,810],{},[37,782,783,784,787],{},"フィルターパネル、または ",[41,785,786],{},"検索バー下のチップ"," でタグを切り替え。",[37,789,790,791,794,795,798],{},"一致は ",[41,792,793],{},"OR","：選択したタグの ",[41,796,797],{},"いずれか"," を持つサウンドが表示される。",[37,800,801,802,805,806,809],{},"ナビバーの ",[41,803,804],{},"検索"," は有効なタグフィルターと ",[41,807,808],{},"AND","（入力 + タグ）。",[37,811,812],{},"チップをオフ（またはフィルター解除）でタブ全体を再表示。",[13,814,815,816,819],{},"色付きタグ名をボタンに表示できます。",[41,817,818],{},"設定 → 動作 → タグバッジを表示"," で切り替え。",[29,821,823],{"id":822},"並べ替えソート","並べ替え（ソート）",[13,825,826],{},"フィルターパネルでソートモードを選びます：",[34,828,829,835],{},[37,830,831,834],{},[41,832,833],{},"ユーザー定義"," — タブ順、グループ表示",[37,836,837,116,840,116,843,116,846,849,850],{},[41,838,839],{},"名前",[41,841,842],{},"追加日時",[41,844,845],{},"再生時間",[41,847,848],{},"ファイルサイズ"," — フラットなソート一覧。これらのモードでは ",[41,851,852],{},"グループは非表示",[13,854,855],{},"再生時間ソートは、初回に長さのメタデータを準備することがあります。",[29,857,859],{"id":858},"並べ替えドラッグ","並べ替え（ドラッグ）",[13,861,862,865,866,869,870,872],{},[41,863,864],{},"設定 → 動作"," でドラッグ＆ドロップをオンにします（",[41,867,868],{},"並べ替えを許可","）。その後、サウンドとグループをドラッグして配置します。ドラッグ並べ替えは ",[41,871,833],{}," ソートで有効です。",[29,874,875],{"id":875},"複数選択",[13,877,801,878,880],{},[41,879,875],{}," をオンにして：",[34,882,883,886,892,899],{},[37,884,885],{},"クリックでサウンドをトグル",[37,887,888,891],{},[41,889,890],{},"Shift+クリック"," で直前のアンカーから範囲選択",[37,893,894,895,898],{},"空きボード上で ",[41,896,897],{},"マーキー"," をドラッグ",[37,900,901],{},"空きボード（または外側）をクリックして選択解除",[13,903,904,905,116,908,116,911,116,914,917],{},"一括バーに件数が表示され、",[41,906,907],{},"色",[41,909,910],{},"タブへ移動…",[41,912,913],{},"削除",[41,915,916],{},"完了"," が使えます。",[13,919,920,921,924],{},"複数選択中、各ボタンに ",[41,922,923],{},"8文字のIDチップ"," が出ます。チップを右クリックでコピー。",[29,926,927],{"id":927},"サウンドごとの音量",[13,929,930,931,934,935,938],{},"右クリック → ",[41,932,933],{},"音量","。スライダーを 0%〜100%。",[41,936,937],{},"ダブルクリック"," で 100% にリセット。",[13,940,941],{},"設定のマスター出力音量と重ねて効きます。",[29,943,945],{"id":944},"ホットキーとサウンドid","ホットキーとサウンドID",[13,947,948,949,952],{},"すべてのサウンドには8文字のIDがあります。ボタンのコンテキストメニュー（",[41,950,951],{},"IDをコピー","）、または複数選択のIDチップからコピーします。",[13,954,955,958,959,962],{},[41,956,957],{},"設定 → ホットキー"," を開き、キーをサウンドIDに割り当てます。グローバルホットキーは任意です。コンテキストメニューの ",[41,960,961],{},"ホットキーを割り当て"," は、IDを埋めた状態でそこにジャンプします。",[13,964,965,966,968],{},"同じIDを",[16,967,306],{"href":305},"がクリップのトリガーに使います。",[29,970,971],{"id":971},"背景画像と色",[13,973,974,975,979],{},"サウンドを右クリックして、ボタンごとの色や背景画像を設定します。ボード全体を整える",[16,976,978],{"href":977},"\u002Fdocs\u002Ftheme-editor","Theme Creator","とは別です。",[13,981,982,983,986],{},"ピッカーは ",[41,984,985],{},"背景画像"," ダイアログ（PNG、JPEG、GIF、WebP）：",[34,988,989,995],{},[37,990,991,994],{},[41,992,993],{},"ローカルファイル"," — フォルダ追加、単一ファイル選択、ファイル名検索、グリッドプレビュー、ライブラリからフォルダ削除",[37,996,997,1000,1001,1003],{},[41,998,999],{},"KLIPY"," — オンラインGIFを検索。APIキーは ",[41,1002,864],{},"。キーはプロジェクトファイルには保存されません。",[13,1005,1006],{},"画像を選んだあと、ボタン上でパンとクロップできます。",{"title":155,"searchDepth":173,"depth":173,"links":1008},[1009,1010,1011,1016,1017,1018,1019,1020,1021],{"id":653,"depth":173,"text":653},{"id":688,"depth":173,"text":688},{"id":721,"depth":173,"text":722,"children":1012},[1013,1014,1015],{"id":736,"depth":633,"text":736},{"id":769,"depth":633,"text":769},{"id":778,"depth":633,"text":778},{"id":822,"depth":173,"text":823},{"id":858,"depth":173,"text":859},{"id":875,"depth":173,"text":875},{"id":927,"depth":173,"text":927},{"id":944,"depth":173,"text":945},{"id":971,"depth":173,"text":971},"タグ、フィルター、タブ、グループ、並べ替え、複数選択、音量、ホットキー。",{},4,"\u002Forganizing-sounds",{"title":622,"description":1022},"organizing-sounds","PGqVreiuZb1jRxkXIW9tv66PvwPYs2iRx5-4j_D8sho",{"id":1030,"title":1031,"body":1032,"description":1154,"extension":231,"meta":1155,"navigation":233,"order":1156,"path":1157,"seo":1158,"stem":1159,"__hash__":1160},"content_ja\u002Ftheme-editor.md","テーマエディター",{"type":7,"value":1033,"toc":1148},[1034,1036,1043,1047,1074,1077,1080,1094,1097,1123,1126,1129,1134],[10,1035,1031],{"id":1031},[13,1037,1038,1039,1042],{},"Theme Creatorは、ボードの完全なビジュアルエディターです。",[41,1040,1041],{},"設定 → メイン → Theme Creator"," から開きます。",[29,1044,1046],{"id":1045},"_3つのタブ","3つのタブ",[330,1048,1049,1063,1069],{},[37,1050,1051,1054,1055,1058,1059,1062],{},[41,1052,1053],{},"一般"," — テーマ名、共有色、フォントのアップロード（",[103,1056,1057],{},".ttf"," \u002F ",[103,1060,1061],{},".otf","）",[37,1064,1065,1068],{},[41,1066,1067],{},"ボタン"," — サウンドボタンの色、書体、レイアウト、GIFオーバーレイ",[37,1070,1071,1073],{},[41,1072,653],{}," — タブバーの色、書体、枠線の太さ",[13,1075,1076],{},"編集中、ライブプレビューがタブとボタンを表示します。",[29,1078,1079],{"id":1079},"変更できる項目",[34,1081,1082,1085,1088,1091],{},[37,1083,1084],{},"プライマリとアクセントの色、背景、ボタン色、タブ色",[37,1086,1087],{},"ボタンとタブのフォントファミリーとサイズ",[37,1089,1090],{},"ボタンの幅、半径、枠線幅、隙間、パディング",[37,1092,1093],{},"GIFオーバーレイの不透明度（通常とホバー）",[29,1095,1096],{"id":1096},"保存と共有",[34,1098,1099,1105,1111,1117],{},[37,1100,1101,1104],{},[41,1102,1103],{},".cssをエクスポート"," — バックアップや友人への送信用テーマファイルを書き出す",[37,1106,1107,1110],{},[41,1108,1109],{},"テーマに追加"," — Themesフォルダに保存して適用",[37,1112,1113,1116],{},[41,1114,1115],{},".cssをインポート"," — 組み込みプリセットまたは保存済みテーマを読み込む",[37,1118,1119,1122],{},[41,1120,1121],{},"リセット"," — SoundNinjaのデフォルトに戻す",[13,1124,1125],{},"未保存の変更があるままウィンドウを閉じると、SoundNinjaが先に保存を求めます。",[29,1127,1128],{"id":1128},"フルエディターなしで",[13,1130,1131,1133],{},[41,1132,684],{}," でも次が可能です：",[34,1135,1136,1139,1145],{},[37,1137,1138],{},"リストからテーマを選ぶ",[37,1140,1141,1142,1062],{},"CSS変数をライブ編集する（",[41,1143,1144],{},"カスタムCSS",[37,1146,1147],{},"テーマファイルをThemesフォルダにインポートする",{"title":155,"searchDepth":173,"depth":173,"links":1149},[1150,1151,1152,1153],{"id":1045,"depth":173,"text":1046},{"id":1079,"depth":173,"text":1079},{"id":1096,"depth":173,"text":1096},{"id":1128,"depth":173,"text":1128},"Theme Creatorで色、フォント、ボタン、タブをデザイン。",{},5,"\u002Ftheme-editor",{"title":1031,"description":1154},"theme-editor","tGeQE8HatAeqLeJ_3U4A-ac0RfIRzcoq-KghedjPolg",{"id":1162,"title":1163,"body":1164,"description":1295,"extension":231,"meta":1296,"navigation":233,"order":1297,"path":1298,"seo":1299,"stem":1300,"__hash__":1301},"content_ja\u002Frecording-editor.md","録音エディター",{"type":7,"value":1165,"toc":1289},[1166,1168,1174,1177,1183,1203,1206,1209,1234,1237,1252,1256,1270,1280],[10,1167,1163],{"id":1163},[13,1169,1170,1171,1173],{},"SoundNinja内でクリップを録音し、トリムしてタブにインポートします。プレイヤーバーの ",[41,1172,570],{}," ボタンでエディターを開きます。",[29,1175,1176],{"id":1176},"入力を選ぶ",[13,1178,1179,1182],{},[41,1180,1181],{},"設定 → オーディオ"," で：",[34,1184,1185,1191,1197],{},[37,1186,1187,1190],{},[41,1188,1189],{},"入力デバイス"," — マイク",[37,1192,1193,1196],{},[41,1194,1195],{},"出力デバイス（PCオーディオ）"," — PCが再生している音のループバック",[37,1198,1199,1202],{},[41,1200,1201],{},"入力音量"," — キャプチャゲイン 0%〜200%",[13,1204,1205],{},"録音ボタンは、ここで選んだデバイスを使います。",[29,1207,1208],{"id":1208},"テイクを編集",[34,1210,1211,1214,1217,1225,1228,1231],{},[37,1212,1213],{},"録音と停止",[37,1215,1216],{},"入力レベルメーターを確認",[37,1218,1219,44,1222],{},[41,1220,1221],{},"ノーマライズ",[41,1223,1224],{},"ノイズキャンセレーション",[37,1226,1227],{},"クリップ全体のトリム、選択範囲へのトリム、選択の削除",[37,1229,1230],{},"元に戻す \u002F やり直し",[37,1232,1233],{},"ズームインとズームアウト",[29,1235,1236],{"id":1236},"ステージしてインポート",[330,1238,1239,1242,1245],{},[37,1240,1241],{},"選択範囲またはトラック全体をステージングリストに追加します。",[37,1243,1244],{},"リストは空から始まります。録音、編集、それからクリップを追加。",[37,1246,1247,44,1249,1251],{},[41,1248,579],{},[41,1250,582],{}," で、現在のタブまたは選んだタブに入れます。",[29,1253,1255],{"id":1254},"ステム分離任意","ステム分離（任意）",[13,1257,1258,1259,1262,1263,44,1266,1269],{},"公式のWindows \u002F macOS \u002F Linuxリリースビルドには ",[41,1260,1261],{},"ステム"," 機能が入ります。Record EditorはBS-RoFormerで ",[41,1264,1265],{},"ボーカル",[41,1267,1268],{},"音楽"," を残せます。",[13,1271,1272,1273,197,1276,1279],{},"モデルは約158 MBで、インストーラーには ",[41,1274,1275],{},"同梱されていません",[41,1277,1278],{},"設定 → ステム分離"," からダウンロードするか、初回起動のプロンプトを承認します。Windowsインストーラーも初回起動時にモデルのダウンロードを案内できます。",[13,1281,1282,1283,1058,1286,541],{},"カスタムのソースビルドには追加フラグが必要です（",[103,1284,1285],{},"tauri:serve:stems",[103,1287,1288],{},"tauri:build:stems",{"title":155,"searchDepth":173,"depth":173,"links":1290},[1291,1292,1293,1294],{"id":1176,"depth":173,"text":1176},{"id":1208,"depth":173,"text":1208},{"id":1236,"depth":173,"text":1236},{"id":1254,"depth":173,"text":1255},"マイクまたはPCオーディオを取り込み、クリップを編集してボードに置く。",{},6,"\u002Frecording-editor",{"title":1163,"description":1295},"recording-editor","7_RI-WNd1luOVgn5vTAoyTmO8dKVtHVwkffwMt4LBQc",{"id":1303,"title":1304,"body":1305,"description":1516,"extension":231,"meta":1517,"navigation":233,"order":1518,"path":1519,"seo":1520,"stem":1521,"__hash__":1522},"content_ja\u002Fremote-control.md","リモートコントロール",{"type":7,"value":1306,"toc":1509},[1307,1309,1312,1315,1347,1350,1353,1387,1390,1410,1413,1416,1448,1452,1458],[10,1308,1304],{"id":1304},[13,1310,1311],{},"SoundNinjaはローカルネットワークで待ち受け、Bitfocus Companion（または任意のHTTP\u002FWebSocketクライアント）がサウンドを再生・停止できます。",[29,1313,1314],{"id":1314},"リモートサーバーを有効化",[330,1316,1317,1323,1330,1337],{},[37,1318,1319,1322],{},[41,1320,1321],{},"設定 → リモート"," を開きます。",[37,1324,1325,1326,1329],{},"リモートサーバーを有効にします。デフォルトポートは ",[41,1327,1328],{},"7331"," です。",[37,1331,1332,1333,1336],{},"任意：トークンを設定。クライアントはBearerトークンまたは ",[103,1334,1335],{},"?token="," で送ります。",[37,1338,1339,1342,1343,1346],{},[103,1340,1341],{},"http:\u002F\u002FIP:PORT"," URLをコピーするか、",[41,1344,1345],{},"設定 → 情報"," からシステムIPをコピーします。",[13,1348,1349],{},"Windowsはサーバー初回起動時にファイアウォールの確認を出すことがあります。プライベートネットワークのアクセスを許可してください。",[29,1351,306],{"id":1352},"bitfocus-companion",[330,1354,1355,1362,1370,1381],{},[37,1356,1357,1361],{},[16,1358,306],{"href":1359,"rel":1360},"https:\u002F\u002Fbitfocus.io\u002Fcompanion",[25],"をインストールします。",[37,1363,1364,1369],{},[16,1365,1368],{"href":1366,"rel":1367},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002Fcompanion-module-soundninja\u002Freleases\u002Flatest",[25],"SoundNinja-Companion.tgz"," をダウンロード。Companion Storeのパッケージはまだありません。",[37,1371,1372,1373,1376,1377,1380],{},"Companionで ",[41,1374,1375],{},"Modules → Load module package"," を開き、",[103,1378,1379],{},".tgz"," を選びます。",[37,1382,1383,1386],{},[41,1384,1385],{},"Sound Ninja"," 接続を追加。PCのIP、ポート、設定したトークンを貼り付けます。",[29,1388,1389],{"id":1389},"アクション",[34,1391,1392,1398,1404],{},[37,1393,1394,1397],{},[41,1395,1396],{},"Trigger Sound"," — ライブドロップダウンから選ぶか、8文字のサウンドIDを入力（Companion変数が使えます）",[37,1399,1400,1403],{},[41,1401,1402],{},"Stop Sound"," — IDで再生中のサウンドを1つ停止",[37,1405,1406,1409],{},[41,1407,1408],{},"Stop All"," — 再生中の全サウンドを停止",[13,1411,1412],{},"SoundNinjaでは、ボタンのコンテキストメニューまたは複数選択のIDチップからサウンドIDをコピーします。",[29,1414,1415],{"id":1415},"フィードバックと変数",[34,1417,1418,1424,1436,1442],{},[37,1419,1420,1423],{},[41,1421,1422],{},"Sound Playing"," — そのサウンドIDがアクティブな間はtrue（ボタン色に使う）",[37,1425,1426,1429,1430,1058,1433],{},[103,1427,1428],{},"$(soundninja:connected)"," — ",[103,1431,1432],{},"true",[103,1434,1435],{},"false",[37,1437,1438,1441],{},[103,1439,1440],{},"$(soundninja:playing_count)"," — 再生中のサウンド数",[37,1443,1444,1447],{},[103,1445,1446],{},"$(soundninja:last_triggered)"," — 最後にトリガーしたサウンドID",[29,1449,1451],{"id":1450},"http-api上級","HTTP API（上級）",[13,1453,1454,1455],{},"ベースパス：",[103,1456,1457],{},"\u002Fapi\u002Fv1",[34,1459,1460,1466,1472,1478,1488,1494,1503],{},[37,1461,1462,1465],{},[103,1463,1464],{},"GET \u002Finfo"," — アプリ名、バージョン、プロトコル、トークンが必要か",[37,1467,1468,1471],{},[103,1469,1470],{},"GET \u002Fsounds"," — サウンド一覧（id、name、tabs、active）",[37,1473,1474,1477],{},[103,1475,1476],{},"GET \u002Fstate"," — サウンドと現在再生中のID",[37,1479,1480,1483,1484,1487],{},[103,1481,1482],{},"POST \u002Ftrigger"," に ",[103,1485,1486],{},"{ \"id\" }"," — サウンドを再生",[37,1489,1490,1493],{},[103,1491,1492],{},"GET \u002Ftrigger\u002F:id"," — 再生（ブラウザで簡単にテスト）",[37,1495,1496,1499,1500,1502],{},[103,1497,1498],{},"POST \u002Fstop"," に任意の ",[103,1501,1486],{}," — 1つまたはすべて停止",[37,1504,1505,1508],{},[103,1506,1507],{},"GET \u002Fws"," — ライブ状態。trigger\u002Fstopコマンドを受信",{"title":155,"searchDepth":173,"depth":173,"links":1510},[1511,1512,1513,1514,1515],{"id":1314,"depth":173,"text":1314},{"id":1352,"depth":173,"text":306},{"id":1389,"depth":173,"text":1389},{"id":1415,"depth":173,"text":1415},{"id":1450,"depth":173,"text":1451},"ローカルネットワーク経由でBitfocus CompanionからSoundNinjaを操作。",{},7,"\u002Fremote-control",{"title":1304,"description":1516},"remote-control","mPFqlRPL-jxRSpdtuwlQQcHhnmsyzKrKdjplGWwWueU",{"id":1524,"title":1525,"body":1526,"description":1611,"extension":231,"meta":1612,"navigation":233,"order":1613,"path":1614,"seo":1615,"stem":1616,"__hash__":1617},"content_ja\u002Fsupport.md","サポート",{"type":7,"value":1527,"toc":1604},[1528,1530,1533,1536,1539,1546,1554,1557,1564,1566,1579,1582,1594,1597],[10,1529,1525],{"id":1525},[13,1531,1532],{},"SoundNinjaは初期ベータのコミュニティプロジェクトです。いちばん早い助けはGitHubです。",[29,1534,1535],{"id":1535},"バグ報告または質問",[13,1537,1538],{},"GitHubでissueを開いてください：",[13,1540,1541],{},[16,1542,1545],{"href":1543,"rel":1544},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fissues",[25],"github.com\u002Fmarcus-universe\u002FSoundNinja\u002Fissues",[13,1547,1548,1549,44,1551,1553],{},"OS、SoundNinjaのバージョン（",[41,1550,129],{},[41,1552,1345],{},"）、再現手順を書いてください。",[29,1555,1556],{"id":1556},"メール",[13,1558,1559,1560],{},"メンテナー連絡先：",[16,1561,1563],{"href":1562},"mailto:contact@marcus-universe.de","contact@marcus-universe.de",[29,1565,123],{"id":123},[13,1567,126,1568,1570,1571,1573,1574,1578],{},[41,1569,129],{}," を使います。新しいビルドは",[16,1572,19],{"href":18},"と",[16,1575,26],{"href":1576,"rel":1577},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Freleases",[25],"にも出ます。",[29,1580,1581],{"id":1581},"コントリビュート",[13,1583,1584,1585,1589,1590,1593],{},"プルリクエストを歓迎します。アプリのリポジトリは",[16,1586,1588],{"href":139,"rel":1587},[25],"github.com\u002Fmarcus-universe\u002FSoundNinja","です。プロジェクトは",[16,1591,324],{"href":322,"rel":1592},[25],"ライセンスです。",[29,1595,1596],{"id":1596},"法的情報",[13,1598,1599,1600,197],{},"インプリントと連絡先：",[16,1601,1603],{"href":1602},"\u002Fimpressum","インプリント",{"title":155,"searchDepth":173,"d