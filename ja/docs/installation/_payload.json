クリップを追加するまで、ボードは空です。SoundNinjaはファイル、フォルダ全体、録音、共有サウンドボードパックをインポートできます。",[29,508,509],{"id":509},"音声ファイルをインポート",[330,511,512,522,525],{},[37,513,514,517,518,521],{},[41,515,516],{},"ファイル → 音声ファイルをインポート","、またはナビバーの ",[41,519,520],{},"インポート"," を使います。",[37,523,524],{},"1つ以上の音声ファイルを選びます。",[37,526,527],{},"サウンドは現在のタブに入ります。",[29,529,530],{"id":530},"フォルダをインポート",[330,532,533,542,545],{},[37,534,535,538,539,541],{},[41,536,537],{},"ファイル → フォルダをインポート","（またはナビバーの ",[41,540,530],{},"）。",[37,543,544],{},"1つ以上のフォルダを追加。インポート前にドラッグで並べ替えできます。",[37,546,547,548],{},"配置方法を選びます：\n",[34,549,550,556],{},[37,551,552,555],{},[41,553,554],{},"タブとしてインポート"," — 各フォルダが独自のタブになる",[37,557,558,561],{},[41,559,560],{},"現在のタブにインポート"," — すべてのファイルがアクティブなタブに入る",[29,563,564],{"id":564},"クリップを録音",[13,566,567,568,571,572,576,577,44,580,583],{},"プレイヤーバーの ",[41,569,570],{},"録音"," ボタンから",[16,573,575],{"href":574},"\u002Fdocs\u002Frecording-editor","Record Editor","を開きます。キャプチャ、トリムし、",[41,578,579],{},"選択をインポート",[41,581,582],{},"すべてインポート"," で現在のタブまたは選んだタブに入れます。",[29,585,586],{"id":586},"サウンドボードをインポート",[13,588,589,592,593,596,597,600],{},[41,590,591],{},"ファイル → サウンドボードをインポート"," で共有パックを読み込みます。パックは ",[103,594,595],{},"project.sninja"," とサウンドファイルを含む ",[103,598,599],{},".zip"," です。インポート後、プロジェクトを開いて再生します。",[13,602,603],{},"複数のプロジェクト（プロファイル）も保てます。プロジェクトセレクターでボードを切り替えます。",[29,605,606],{"id":606},"見つからないファイルを再リンク",[13,608,609,610,613],{},"ディスク上で音声ファイルが移動すると、SoundNinjaは ",[41,611,612],{},"見つからないサウンドファイル"," ダイアログを表示します。検索するフォルダを選び、クリップを再リンクします。",[29,615,616],{"id":616},"次へ",[13,618,619,620,197],{},"タブ、タグ、フィルター、ホットキーの整理は",[16,621,622],{"href":348},"サウンドの整理",{"title":155,"searchDepth":173,"depth":173,"links":624},[625,626,627,628,629,630],{"id":509,"depth":173,"text":509},{"id":530,"depth":173,"text":530},{"id":564,"depth":173,"text":564},{"id":586,"depth":173,"text":586},{"id":606,"depth":173,"text":606},{"id":616,"depth":173,"text":616},"音声、フォルダ、録音、共有サウンドボードをインポート。",{},3,"\u002Fadding-sounds",{"title":499,"description":631},"adding-sounds","5_cjd2COcPz0pj4ZrBehCZv6ouzBimE8UGjkcfngQjw",{"id":639,"title":622,"body":640,"description":1032,"extension":231,"meta":1033,"navigation":233,"order":1034,"path":1035,"seo":1036,"stem":1037,"__hash__":1038},"content_ja\u002Forganizing-sounds.md",{"type":7,"value":641,"toc":1017},[642,644,651,654,679,686,689,692,706,713,719,723,733,737,767,770,776,779,813,820,824,827,853,856,860,873,876,881,902,918,925,928,939,942,946,953,963,969,972,980,987,1014],[10,643,622],{"id":622},[13,645,646,647,650],{},"SoundNinjaは大規模ライブラリ向けです。",[41,648,649],{},"タグとフィルター","、タブ、検索、複数選択、ホットキーで、必要なクリップをワンクリック（またはワンキー）で出せます。",[29,652,653],{"id":653},"タブ",[34,655,656,662,668],{},[37,657,658,661],{},[41,659,660],{},"タブを追加"," でタブを作り、色を付けてバーをすばやく眺められます。",[37,663,664,667],{},[41,665,666],{},"すべて"," ビューはタブを横断して全サウンドを表示します。",[37,669,670,671,674,675,678],{},"サウンドは ",[41,672,673],{},"1つ以上のタブ"," に所属できます。サウンドを右クリックし、",[41,676,677],{},"タブへ移動"," で割り当てます。",[13,680,681,682,685],{},"タブの切り替え演出は ",[41,683,684],{},"設定 → メイン","：スライド、フェード、ボタンを1つずつ、またはなし。",[29,687,688],{"id":688},"グループ",[13,690,691],{},"v0.5.3以降、セパレーターを名前付きグループにできます：",[34,693,694,697,700,703],{},[37,695,696],{},"コンテキストメニューからグループの追加、名前変更、削除",[37,698,699],{},"グループヘッダーをドラッグ — 子も一緒に動く",[37,701,702],{},"グループにサウンドを入れたり出したり",[37,704,705],{},"グループの枠線色、名前の色、ボタン配置を設定（またはタブのデフォルトを使う）",[13,707,708,709,712],{},"見た目の区切りだけなら、通常の ",[41,710,711],{},"セパレーター"," も追加できます。",[13,714,715,716,197],{},"ボードの空き領域を右クリックして ",[41,717,718],{},"グループを追加",[29,720,722],{"id":721},"タグ-フィルター","タグ \u002F フィルター",[13,724,725,726,729,730,732],{},"タグはタブを横断します。スライドアウトの ",[41,727,728],{},"フィルター"," パネル（サイドバー ",[41,731,728],{},"）で作成し、ボードを絞ります。",[734,735,736],"h3",{"id":736},"タグの作成と編集",[330,738,739,745,755,761],{},[37,740,741,742,744],{},"サイドバーで ",[41,743,728],{}," を開く。",[37,746,747,750,751,754],{},[41,748,749],{},"タグ"," の ",[41,752,753],{},"タグを追加"," — 名前と色を付ける。",[37,756,757,758,197],{},"同じリストで名前変更、色変更、",[41,759,760],{},"タグを削除",[37,762,763,766],{},[41,764,765],{},"タグはまだありません"," と出たら、割り当てる前にここで追加する。",[734,768,769],{"id":769},"サウンドにタグを付ける",[13,771,772,773,775],{},"サウンドを右クリック → ",[41,774,749],{},"（チェックボックス）。1つのサウンドに複数可。タグが無い場合、メニューはフィルターパネルへ案内します。",[734,777,778],{"id":778},"ボードをフィルター",[34,780,781,788,799,810],{},[37,782,783,784,787],{},"フィルターパネル、または ",[41,785,786],{},"検索バー下のチップ"," でタグを切り替え。",[37,789,790,791,794,795,798],{},"一致は ",[41,792,793],{},"OR","：選択したタグの ",[41,796,797],{},"いずれか"," を持つサウンドが表示される。",[37,800,801,802,805,806,809],{},"ナビバーの ",[41,803,804],{},"検索"," は有効なタグフィルターと ",[41,807,808],{},"AND","（入力 + タグ）。",[37,811,812],{},"チップをオフ（またはフィルター解除）でタブ全体を再表示。",[13,814,815,816,819],{},"色付きタグ名をボタンに表示できます。",[41,817,818],{},"設定 → 動作 → タグバッジを表示"," で切り替え。",[29,821,823],{"id":822},"並べ替えソート","並べ替え（ソート）",[13,825,826],{},"フィルターパネルでソートモードを選びます：",[34,828,829,835],{},[37,830,831,834],{},[41,832,833],{},"ユーザー定義"," — タブ順、グループ表示",[37,836,837,116,840,116,843,116,846,849,850],{},[41,838,839],{},"名前",[41,841,842],{},"追加日時",[41,844,845],{},"再生時間",[41,847,848],{},"ファイルサイズ"," — フラットなソート一覧。これらのモードでは ",[41,851,852],{},"グループは非表示",[13,854,855],{},"再生時間ソートは、初回に長さのメタデータを準備することがあります。",[29,857,859],{"id":858},"並べ替えドラッグ","並べ替え（ドラッグ）",[13,861,862,865,866,869,870,872],{},[41,863,864],{},"設定 → 動作"," でドラッグ＆ドロップをオンにします（",[41,867,868],{},"並べ替えを許可","）。その後、サウンドとグループをドラッグして配置します。ドラッグ並べ替えは ",[41,871,833],{}," ソートで有効です。",[29,874,875],{"id":875},"複数選択",[13,877,801,878,880],{},[41,879,875],{}," をオンにして：",[34,882,883,886,892,899],{},[37,884,885],{},"クリックでサウンドをトグル",[37,887,888,891],{},[41,889,890],{},"Shift+クリック"," で直前のアンカーから範囲選択",[37,893,894,895,898],{},"空きボード上で ",[41,896,897],{},"マーキー"," をドラッグ",[37,900,901],{},"空きボード（または外側）をクリックして選択解除",[13,903,904,905,116,908,116,911,116,914,917],{},"一括バーに件数が表示され、",[41,906,907],{},"色",[41,909,910],{},"タブへ移動…",[41,912,913],{},"削除",[41,915,916],{},"完了"," が使えます。",[13,919,920,921,924],{},"複数選択中、各ボタンに ",[41,922,923],{},"8文字のIDチップ"," が出ます。チップを右クリックでコピー。",[29,926,927],{"id":927},"サウンドごとの音量",[13,929,930,931,934,935,938],{},"右クリック → ",[41,932,933],{},"音量","。スライダーを 0%〜100%。",[41,936,937],{},"ダブルクリック"," で 100% にリセット。",[13,940,941],{},"設定のマスター出力音量と重ねて効きます。",[29,943,945],{"id":944},"ホットキーとサウンドid","ホットキーとサウンドID",[13,947,948,949,952],{},"すべてのサウンドには8文字のIDがあります。ボタンのコンテキストメニュー（",[41,950,951],{},"IDをコピー","）、または複数選択のIDチップからコピーします。",[13,954,955,958,959,962],{},[41,956,957],{},"設定 → ホットキー"," を開き、キーをサウンドIDに割り当てます。グローバルホットキーは任意です。コンテキストメニューの ",[41,960,961],{},"ホットキーを割り当て"," は、IDを埋めた状態でそこにジャンプします。",[13,964,965,966,968],{},"同じIDを",[16,967,306],{"href":305},"がクリップのトリガーに使います。",[29,970,971],{"id":971},"背景画像と色",[13,973,974,975,979],{},"サウンドを右クリックして、ボタンごとの色や背景画像を設定します。ボード全体を整える",[16,976,978],{"href":977},"\u002Fdocs\u002Ftheme-editor","Theme Creator","とは別です。",[13,981,982,983,986],{},"ピッカーは ",[41,984,985],{},"背景画像"," ダイアログ（PNG、JPEG、GIF、WebP）：",[34,988,989,995,1005],{},[37,990,991,994],{},[41,992,993],{},"ローカルファイル"," — フォルダ追加、単一ファイル選択、ファイル名検索、グリッドプレビュー、ライブラリからフォルダ削除",[37,996,997,1000,1001],{},[41,998,999],{},"GifSnap"," — APIキーなしでオンラインGIFを検索。初回は GifSnap へのリクエスト許可を求めます。検索結果はキャッシュして通信を減らします。",[16,1002,999],{"href":1003,"rel":1004},"https:\u002F\u002Fgifsnap.com",[25],[37,1006,1007,1010,1011,1013],{},[41,1008,1009],{},"KLIPY"," — オンラインGIFを検索。APIキーは ",[41,1012,864],{},"。キーはプロジェクトファイルには保存されません。",[13,1015,1016],{},"画像を選んだあと、ボタン上でパンとクロップできます。",{"title":155,"searchDepth":173,"depth":173,"links":1018},[1019,1020,1021,1026,1027,1028,1029,1030,1031],{"id":653,"depth":173,"text":653},{"id":688,"depth":173,"text":688},{"id":721,"depth":173,"text":722,"children":1022},[1023,1024,1025],{"id":736,"depth":633,"text":736},{"id":769,"depth":633,"text":769},{"id":778,"depth":633,"text":778},{"id":822,"depth":173,"text":823},{"id":858,"depth":173,"text":859},{"id":875,"depth":173,"text":875},{"id":927,"depth":173,"text":927},{"id":944,"depth":173,"text":945},{"id":971,"depth":173,"text":971},"タグ、フィルター、タブ、グループ、並べ替え、複数選択、音量、ホットキー。",{},4,"\u002Forganizing-sounds",{"title":622,"description":1032},"organizing-sounds","7eo3HsiR87FfpmaZ2egiJxhWDKGaOqGKyaXl1gmdAbY",{"id":1040,"title":1041,"body":1042,"description":1164,"extension":231,"meta":1165,"navigation":233,"order":1166,"path":1167,"seo":1168,"stem":1169,"__hash__":1170},"content_ja\u002Ftheme-editor.md","テーマエディター",{"type":7,"value":1043,"toc":1158},[1044,1046,1053,1057,1084,1087,1090,1104,1107,1133,1136,1139,1144],[10,1045,1041],{"id":1041},[13,1047,1048,1049,1052],{},"Theme Creatorは、ボードの完全なビジュアルエディターです。",[41,1050,1051],{},"設定 → メイン → Theme Creator"," から開きます。",[29,1054,1056],{"id":1055},"_3つのタブ","3つのタブ",[330,1058,1059,1073,1079],{},[37,1060,1061,1064,1065,1068,1069,1072],{},[41,1062,1063],{},"一般"," — テーマ名、共有色、フォントのアップロード（",[103,1066,1067],{},".ttf"," \u002F ",[103,1070,1071],{},".otf","）",[37,1074,1075,1078],{},[41,1076,1077],{},"ボタン"," — サウンドボタンの色、書体、レイアウト、GIFオーバーレイ",[37,1080,1081,1083],{},[41,1082,653],{}," — タブバーの色、書体、枠線の太さ",[13,1085,1086],{},"編集中、ライブプレビューがタブとボタンを表示します。",[29,1088,1089],{"id":1089},"変更できる項目",[34,1091,1092,1095,1098,1101],{},[37,1093,1094],{},"プライマリとアクセントの色、背景、ボタン色、タブ色",[37,1096,1097],{},"ボタンとタブのフォントファミリーとサイズ",[37,1099,1100],{},"ボタンの幅、半径、枠線幅、隙間、パディング",[37,1102,1103],{},"GIFオーバーレイの不透明度（通常とホバー）",[29,1105,1106],{"id":1106},"保存と共有",[34,1108,1109,1115,1121,1127],{},[37,1110,1111,1114],{},[41,1112,1113],{},".cssをエクスポート"," — バックアップや友人への送信用テーマファイルを書き出す",[37,1116,1117,1120],{},[41,1118,1119],{},"テーマに追加"," — Themesフォルダに保存して適用",[37,1122,1123,1126],{},[41,1124,1125],{},".cssをインポート"," — 組み込みプリセットまたは保存済みテーマを読み込む",[37,1128,1129,1132],{},[41,1130,1131],{},"リセット"," — SoundNinjaのデフォルトに戻す",[13,1134,1135],{},"未保存の変更があるままウィンドウを閉じると、SoundNinjaが先に保存を求めます。",[29,1137,1138],{"id":1138},"フルエディターなしで",[13,1140,1141,1143],{},[41,1142,684],{}," でも次が可能です：",[34,1145,1146,1149,1155],{},[37,1147,1148],{},"リストからテーマを選ぶ",[37,1150,1151,1152,1072],{},"CSS変数をライブ編集する（",[41,1153,1154],{},"カスタムCSS",[37,1156,1157],{},"テーマファイルをThemesフォルダにインポートする",{"title":155,"searchDepth":173,"depth":173,"links":1159},[1160,1161,1162,1163],{"id":1055,"depth":173,"text":1056},{"id":1089,"depth":173,"text":1089},{"id":1106,"depth":173,"text":1106},{"id":1138,"depth":173,"text":1138},"Theme Creatorで色、フォント、ボタン、タブをデザイン。",{},5,"\u002Ftheme-editor",{"title":1041,"description":1164},"theme-editor","tGeQE8HatAeqLeJ_3U4A-ac0RfIRzcoq-KghedjPolg",{"id":1172,"title":1173,"body":1174,"description":1305,"extension":231,"meta":1306,"navigation":233,"order":1307,"path":1308,"seo":1309,"stem":1310,"__hash__":1311},"content_ja\u002Frecording-editor.md","録音エディター",{"type":7,"value":1175,"toc":1299},[1176,1178,1184,1187,1193,1213,1216,1219,1244,1247,1262,1266,1280,1290],[10,1177,1173],{"id":1173},[13,1179,1180,1181,1183],{},"SoundNinja内でクリップを録音し、トリムしてタブにインポートします。プレイヤーバーの ",[41,1182,570],{}," ボタンでエディターを開きます。",[29,1185,1186],{"id":1186},"入力を選ぶ",[13,1188,1189,1192],{},[41,1190,1191],{},"設定 → オーディオ"," で：",[34,1194,1195,1201,1207],{},[37,1196,1197,1200],{},[41,1198,1199],{},"入力デバイス"," — マイク",[37,1202,1203,1206],{},[41,1204,1205],{},"出力デバイス（PCオーディオ）"," — PCが再生している音のループバック",[37,1208,1209,1212],{},[41,1210,1211],{},"入力音量"," — キャプチャゲイン 0%〜200%",[13,1214,1215],{},"録音ボタンは、ここで選んだデバイスを使います。",[29,1217,1218],{"id":1218},"テイクを編集",[34,1220,1221,1224,1227,1235,1238,1241],{},[37,1222,1223],{},"録音と停止",[37,1225,1226],{},"入力レベルメーターを確認",[37,1228,1229,44,1232],{},[41,1230,1231],{},"ノーマライズ",[41,1233,1234],{},"ノイズキャンセレーション",[37,1236,1237],{},"クリップ全体のトリム、選択範囲へのトリム、選択の削除",[37,1239,1240],{},"元に戻す \u002F やり直し",[37,1242,1243],{},"ズームインとズームアウト",[29,1245,1246],{"id":1246},"ステージしてインポート",[330,1248,1249,1252,1255],{},[37,1250,1251],{},"選択範囲またはトラック全体をステージングリストに追加します。",[37,1253,1254],{},"リストは空から始まります。録音、編集、それからクリップを追加。",[37,1256,1257,44,1259,1261],{},[41,1258,579],{},[41,1260,582],{}," で、現在のタブまたは選んだタブに入れます。",[29,1263,1265],{"id":1264},"ステム分離任意","ステム分離（任意）",[13,1267,1268,1269,1272,1273,44,1276,1279],{},"公式のWindows \u002F macOS \u002F Linuxリリースビルドには ",[41,1270,1271],{},"ステム"," 機能が入ります。Record EditorはBS-RoFormerで ",[41,1274,1275],{},"ボーカル",[41,1277,1278],{},"音楽"," を残せます。",[13,1281,1282,1283,197,1286,1289],{},"モデルは約158 MBで、インストーラーには ",[41,1284,1285],{},"同梱されていません",[41,1287,1288],{},"設定 → ステム分離"," からダウンロードするか、初回起動のプロンプトを承認します。Windowsインストーラーも初回起動時にモデルのダウンロードを案内できます。",[13,1291,1292,1293,1068,1296,541],{},"カスタムのソースビルドには追加フラグが必要です（",[103,1294,1295],{},"tauri:serve:stems",[103,1297,1298],{},"tauri:build:stems",{"title":155,"searchDepth":173,"depth":173,"links":1300},[1301,1302,1303,1304],{"id":1186,"depth":173,"text":1186},{"id":1218,"depth":173,"text":1218},{"id":1246,"depth":173,"text":1246},{"id":1264,"depth":173,"text":1265},"マイクまたはPCオーディオを取り込み、クリップを編集してボードに置く。",{},6,"\u002Frecording-editor",{"title":1173,"description":1305},"recording-editor","7_RI-WNd1luOVgn5vTAoyTmO8dKVtHVwkffwMt4LBQc",{"id":1313,"title":1314,"body":1315,"description":1526,"extension":231,"meta":1527,"navigation":233,"order":1528,"path":1529,"seo":1530,"stem":1531,"__hash__":1532},"content_ja\u002Fremote-control.md","リモートコントロール",{"type":7,"value":1316,"toc":1519},[1317,1319,1322,1325,1357,1360,1363,1397,1400,1420,1423,1426,1458,1462,1468],[10,1318,1314],{"id":1314},[13,1320,1321],{},"SoundNinjaはローカルネットワークで待ち受け、Bitfocus Companion（または任意のHTTP\u002FWebSocketクライアント）がサウンドを再生・停止できます。",[29,1323,1324],{"id":1324},"リモートサーバーを有効化",[330,1326,1327,1333,1340,1347],{},[37,1328,1329,1332],{},[41,1330,1331],{},"設定 → リモート"," を開きます。",[37,1334,1335,1336,1339],{},"リモートサーバーを有効にします。デフォルトポートは ",[41,1337,1338],{},"7331"," です。",[37,1341,1342,1343,1346],{},"任意：トークンを設定。クライアントはBearerトークンまたは ",[103,1344,1345],{},"?token="," で送ります。",[37,1348,1349,1352,1353,1356],{},[103,1350,1351],{},"http:\u002F\u002FIP:PORT"," URLをコピーするか、",[41,1354,1355],{},"設定 → 情報"," からシステムIPをコピーします。",[13,1358,1359],{},"Windowsはサーバー初回起動時にファイアウォールの確認を出すことがあります。プライベートネットワークのアクセスを許可してください。",[29,1361,306],{"id":1362},"bitfocus-companion",[330,1364,1365,1372,1380,1391],{},[37,1366,1367,1371],{},[16,1368,306],{"href":1369,"rel":1370},"https:\u002F\u002Fbitfocus.io\u002Fcompanion",[25],"をインストールします。",[37,1373,1374,1379],{},[16,1375,1378],{"href":1376,"rel":1377},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002Fcompanion-module-soundninja\u002Freleases\u002Flatest",[25],"SoundNinja-Companion.tgz"," をダウンロード。Companion Storeのパッケージはまだありません。",[37,1381,1382,1383,1386,1387,1390],{},"Companionで ",[41,1384,1385],{},"Modules → Load module package"," を開き、",[103,1388,1389],{},".tgz"," を選びます。",[37,1392,1393,1396],{},[41,1394,1395],{},"Sound Ninja"," 接続を追加。PCのIP、ポート、設定したトークンを貼り付けます。",[29,1398,1399],{"id":1399},"アクション",[34,1401,1402,1408,1414],{},[37,1403,1404,1407],{},[41,1405,1406],{},"Trigger Sound"," — ライブドロップダウンから選ぶか、8文字のサウンドIDを入力（Companion変数が使えます）",[37,1409,1410,1413],{},[41,1411,1412],{},"Stop Sound"," — IDで再生中のサウンドを1つ停止",[37,1415,1416,1419],{},[41,1417,1418],{},"Stop All"," — 再生中の全サウンドを停止",[13,1421,1422],{},"SoundNinjaでは、ボタンのコンテキストメニューまたは複数選択のIDチップからサウンドIDをコピーします。",[29,1424,1425],{"id":1425},"フィードバックと変数",[34,1427,1428,1434,1446,1452],{},[37,1429,1430,1433],{},[41,1431,1432],{},"Sound Playing"," — そのサウンドIDがアクティブな間はtrue（ボタン色に使う）",[37,1435,1436,1439,1440,1068,1443],{},[103,1437,1438],{},"$(soundninja:connected)"," — ",[103,1441,1442],{},"true",[103,1444,1445],{},"false",[37,1447,1448,1451],{},[103,1449,1450],{},"$(soundninja:playing_count)"," — 再生中のサウンド数",[37,1453,1454,1457],{},[103,1455,1456],{},"$(soundninja:last_triggered)"," — 最後にトリガーしたサウンドID",[29,1459,1461],{"id":1460},"http-api上級","HTTP API（上級）",[13,1463,1464,1465],{},"ベースパス：",[103,1466,1467],{},"\u002Fapi\u002Fv1",[34,1469,1470,1476,1482,1488,1498,1504,1513],{},[37,1471,1472,1475],{},[103,1473,1474],{},"GET \u002Finfo"," — アプリ名、バージョン、プロトコル、トークンが必要か",[37,1477,1478,1481],{},[103,1479,1480],{},"GET \u002Fsounds"," — サウンド一覧（id、name、tabs、active）",[37,1483,1484,1487],{},[103,1485,1486],{},"GET \u002Fstate"," — サウンドと現在再生中のID",[37,1489,1490,1493,1494,1497],{},[103,1491,1492],{},"POST \u002Ftrigger"," に ",[103,1495,1496],{},"{ \"id\" }"," — サウンドを再生",[37,1499,1500,1503],{},[103,1501,1502],{},"GET \u002Ftrigger\u002F:id"," — 再生（ブラウザで簡単にテスト）",[37,1505,1506,1509,1510,1512],{},[103,1507,1508],{},"POST \u002Fstop"," に任意の ",[103,1511,1496],{}," — 1つまたはすべて停止",[37,1514,1515,1518],{},[103,1516,1517],{},"GET \u002Fws"," — ライブ状態。trigger\u002Fstopコマンドを受信",{"title":155,"searchDepth":173,"depth":173,"links":1520},[1521,1522,1523,1524,1525],{"id":1324,"depth":173,"text":1324},{"id":1362,"depth":173,"text":306},{"id":1399,"depth":173,"text":1399},{"id":1425,"depth":173,"text":1425},{"id":1460,"depth":173,"text":1461},"ローカルネットワーク経由でBitfocus CompanionからSoundNinjaを操作。",{},7,"\u002Fremote-control",{"title":1314,"description":1526},"remote-control","mPFqlRPL-jxRSpdtuwlQQcHhnmsyzKrKdjplGWwWueU",{"id":1534,"title":1535,"body":1536,"description":1621,"extension":231,"meta":1622,"navigation":233,"order":1623,"path":1624,"seo":1625,"stem":1626,"__hash__":1627},"content_ja\u002Fsupport.md","サポート",{"type":7,"value":1537,"toc":1614},[1538,1540,1543,1546,1549,1556,1564,1567,1574,1576,1589,1592,1604,1607],[10,1539,1535],{"id":1535},[13,1541,1542],{},"SoundNinjaは初期ベータのコミュニティプロジェクトです。いちばん早い助けはGitHubです。",[29,1544,1545],{"id":1545},"バグ報告または質問",[13,1547,1548],{},"GitHubでissueを開いてください：",[13,1550,1551],{},[16,1552,1555],{"href":1553,"rel":1554},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fissues",[25],"github.com\u002Fmarcus-universe\u002FSoundNinja\u002Fissues",[13,1557,1558,1559,44,1561,1563],{},"OS、SoundNinjaのバージョン（",[41,1560,129],{},[41,1562,1355],{},"）、再現手順を書いてください。",[29,1565,1566],{"id":1566},"メール",[13,1568,1569,1570],{},"メンテナー連絡先：",[16,1571,1573],{"href":1572},"mailto:contact@marcus-universe.de","contact@marcus-universe.de",[29,1575,123],{"id":123},[13,1577,126,1578,1580,1581,1583,1584,1588],{},[41,1579,129],{}," を使います。新しいビルドは",[16,1582,19],{"href":18},"と",[16,1585,26],{"href":1586,"rel":1587},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Freleases",[25],"にも出ます。",[29,1590,1591],{"id":1591},"コントリビュート",[13,1593,1594,1595,1599,1600,1603],{},"プルリクエストを歓迎します。アプリのリポジトリは",[16,1596,1598],{"href":139,"rel":1597},[25],"github.com\u002Fmarcus-universe\u002FSoundNinja","です。プロジェクトは",[16,1601,324],{"href":322,"rel":1602},[25],"ライセンスです。",[29,1605,1606],{"id":1606},"法的情報",[13,1608,1609,1610,197],{},"インプリントと連絡先：",[16,1611,1613],{"href":1612},"\u002Fimpressum","インプリント",{"title":155,"searchDepth":173,"depth":173,"links":1615},[1616,1617,1618,1619,1620],{"id":1545,"depth":173,"text":1545},{"id":1566,"depth":173,"text":1566},{"id":123,"depth":173,"text":123},{"id":1591,"depth":173,"text":1591},{"id":1606,"depth":173,"text":1606},"ヘルプの入手先とバグ報告。",{},8,"\u002Fsupport",{"title":1535,"description":1621},"support","T2BdU-sWENDKBxowzv9wjeevj1bEK3iit1IGD77Vz_M",1789685089179]