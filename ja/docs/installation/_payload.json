[{"data":1,"prerenderedAt":1325},["ShallowReactive",2],{"docs-page-ja-\u002Finstallation":3,"docs-nav-ja":214},{"id":4,"title":5,"body":6,"description":206,"extension":207,"meta":208,"navigation":209,"order":170,"path":210,"seo":211,"stem":212,"__hash__":213},"content_ja\u002Finstallation.md","インストール",{"type":7,"value":8,"toc":199},"minimark",[9,12,28,33,54,57,61,75,78,82,107,118,121,128,131,146,179,195],[10,11,5],"h1",{"id":5},[13,14,15,20,21,27],"p",{},[16,17,19],"a",{"href":18},"\u002Fdownload","ダウンロードページ","または",[16,22,26],{"href":23,"rel":24},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Freleases\u002Flatest",[25],"nofollow","GitHub Releases","からビルドを入手してください。SoundNinjaは初期開発中なので、ビルドはベータとして扱ってください。",[29,30,32],"h2",{"id":31},"windows","Windows",[34,35,36,48,51],"ul",{},[37,38,39,40,44,45],"li",{},"64ビットWindows向けの",[41,42,43],"strong",{},"インストーラー (.exe)"," または ",[41,46,47],{},"MSI (.msi)",[37,49,50],{},"ランディングページの対象：Windows 10以降",[37,52,53],{},"アプリのREADMEはWindows 8以上も記載",[13,55,56],{},"インストーラーを実行し、スタートメニューからSoundNinjaを起動します。",[29,58,60],{"id":59},"macos","macOS",[34,62,63,69,72],{},[37,64,65,66],{},"Apple SiliconとIntel向けの",[41,67,68],{},"ユニバーサル .dmg",[37,70,71],{},"ランディングページの対象：macOS 10.14以降",[37,73,74],{},"アプリのREADMEはmacOS 10.15以上を記載",[13,76,77],{},"ディスクイメージを開き、SoundNinjaをアプリケーションにドラッグします。",[29,79,81],{"id":80},"linux","Linux",[34,83,84,90,96,104],{},[37,85,86,87],{},"Ubuntu \u002F Debian向けの",[41,88,89],{},"Debian (.deb)",[37,91,92,93],{},"その他のディストリ向けの",[41,94,95],{},"AppImage",[37,97,98,99,103],{},"リリース公開後、ArchユーザーはAURから",[100,101,102],"code",{},"soundninja-bin","をインストールできます",[37,105,106],{},"Ubuntu 20.04でテスト済み",[13,108,109,110,113,114,117],{},"デスクトップビルドにはWebKitとGTKのパッケージが必要です。Debian\u002FUbuntuでは通常、",[100,111,112],{},"libwebkit2gtk","、",[100,115,116],{},"libgtk-3-0","、app-indicatorライブラリです。",[29,119,120],{"id":120},"アップデート",[13,122,123,124,127],{},"アプリ内で ",[41,125,126],{},"ヘルプ → アップデートを確認"," を開きます。設定で起動時にSoundNinjaが確認するようにもできます。",[29,129,130],{"id":130},"ソースからビルド",[13,132,133,134,139,140,145],{},"カスタムビルドが必要なら、",[16,135,138],{"href":136,"rel":137},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja",[25],"リポジトリ","をクローンし、",[16,141,144],{"href":142,"rel":143},"https:\u002F\u002Fv2.tauri.app\u002Fstart\u002Fprerequisites\u002F",[25],"Tauriの前提条件","を入れたうえで：",[147,148,153],"pre",{"className":149,"code":150,"language":151,"meta":152,"style":152},"language-bash shiki shiki-themes github-light github-dark","bun install\nbun run tauri:serve\n","bash","",[100,154,155,168],{"__ignoreMap":152},[156,157,160,164],"span",{"class":158,"line":159},"line",1,[156,161,163],{"class":162},"sScJk","bun",[156,165,167],{"class":166},"sZZnC"," install\n",[156,169,171,173,176],{"class":158,"line":170},2,[156,172,163],{"class":162},[156,174,175],{"class":166}," run",[156,177,178],{"class":166}," tauri:serve\n",[13,180,181,113,184,113,187,190,191,194],{},[100,182,183],{},"npm",[100,185,186],{},"pnpm",[100,188,189],{},"deno","でも動きます。本番ビルド：",[100,192,193],{},"bun run tauri:build","。",[196,197,198],"style",{},"html pre.shiki code .sScJk, html code.shiki .sScJk{--shiki-default:#6F42C1;--shiki-dark:#B392F0}html pre.shiki code .sZZnC, html code.shiki .sZZnC{--shiki-default:#032F62;--shiki-dark:#9ECBFF}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html.dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}",{"title":152,"searchDepth":170,"depth":170,"links":200},[201,202,203,204,205],{"id":31,"depth":170,"text":32},{"id":59,"depth":170,"text":60},{"id":80,"depth":170,"text":81},{"id":120,"depth":170,"text":120},{"id":130,"depth":170,"text":130},"Windows、macOS、LinuxにSoundNinjaをインストール。","md",{},true,"\u002Finstallation",{"title":5,"description":206},"installation","PtsEiD1MtLz3wDVCCGAWac0JxyBztTW1uRBbWQWqSOs",[215,329,450,591,737,869,1005,1230],{"id":216,"title":217,"body":218,"description":323,"extension":207,"meta":324,"navigation":209,"order":159,"path":325,"seo":326,"stem":327,"__hash__":328},"content_ja\u002Foverview.md","概要",{"type":7,"value":219,"toc":317},[220,222,225,228,231,234,248,251,281,284,293,296],[10,221,217],{"id":217},[13,223,224],{},"SoundNinjaは、ライブ配信、友だちとのチャット、ポッドキャスト収録向けのオープンソースサウンドボードです。Tauri v2とNuxt 4で構築されており、RAMとディスクの負荷を抑えています。",[13,226,227],{},"目標はシンプルです。巨大なサウンドライブラリをすばやく眺め、目的のクリップをミリ秒で再生すること。UIはVRのダッシュボードとしても使いやすいです。",[13,229,230],{},"SoundNinjaはまだ初期開発段階です。機能は動きますが、すべてのプラットフォームで完全に検証されているわけではありません。",[29,232,233],{"id":233},"対象ユーザー",[34,235,236,239,242,245],{},[37,237,238],{},"即時のサウンドキューが必要な配信者",[37,240,241],{},"ボイスチャット用の共有ボードが欲しい友だち",[37,243,244],{},"クリップを録ってボードに置くポッドキャスター",[37,246,247],{},"カスタマイズ可能な、ローカル優先のサウンドボードが欲しい人",[29,249,250],{"id":250},"できること",[34,252,253,256,259,262,265,268,275,278],{},[37,254,255],{},"自分の音声ファイルからサウンドボードを作る",[37,257,258],{},"色付きタブ、グループ、検索で整理する",[37,260,261],{},"Theme Creatorで見た目をデザインする",[37,263,264],{},"Record EditorでPCオーディオまたはマイクを録音する",[37,266,267],{},"個別のサウンドにホットキーを割り当てる",[37,269,270,274],{},[16,271,273],{"href":272},"\u002Fdocs\u002Fremote-control","Bitfocus Companion","からサウンドをトリガーする",[37,276,277],{},"サウンドボード全体をインポート／エクスポートして共有する",[37,279,280],{},"サウンドボタンにGIFや画像を使う",[29,282,283],{"id":283},"ライセンス",[13,285,286,287,292],{},"SoundNinjaは",[16,288,291],{"href":289,"rel":290},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fblob\u002Fmain\u002FLICENSE",[25],"GPL-3.0","のフリーソフトウェアです。フォーク、改変、共有できます。",[29,294,295],{"id":295},"次のステップ",[297,298,299,305,311],"ol",{},[37,300,301],{},[16,302,304],{"href":303},"\u002Fdocs\u002Finstallation","SoundNinjaをインストール",[37,306,307],{},[16,308,310],{"href":309},"\u002Fdocs\u002Fadding-sounds","サウンドを追加",[37,312,313],{},[16,314,316],{"href":315},"\u002Fdocs\u002Forganizing-sounds","ボードを整理",{"title":152,"searchDepth":170,"depth":170,"links":318},[319,320,321,322],{"id":233,"depth":170,"text":233},{"id":250,"depth":170,"text":250},{"id":283,"depth":170,"text":283},{"id":295,"depth":170,"text":295},"SoundNinjaとは何か、何ができるか。",{},"\u002Foverview",{"title":217,"description":323},"overview","KJDpLdg7ixvHWAtVFjPRaSTU7NMWgwE__i0PB3mQH3E",{"id":4,"title":5,"body":330,"description":206,"extension":207,"meta":448,"navigation":209,"order":170,"path":210,"seo":449,"stem":212,"__hash__":213},{"type":7,"value":331,"toc":441},[332,334,341,343,355,357,359,369,371,373,389,395,397,401,403,411,429,439],[10,333,5],{"id":5},[13,335,336,20,338,27],{},[16,337,19],{"href":18},[16,339,26],{"href":23,"rel":340},[25],[29,342,32],{"id":31},[34,344,345,351,353],{},[37,346,39,347,44,349],{},[41,348,43],{},[41,350,47],{},[37,352,50],{},[37,354,53],{},[13,356,56],{},[29,358,60],{"id":59},[34,360,361,365,367],{},[37,362,65,363],{},[41,364,68],{},[37,366,71],{},[37,368,74],{},[13,370,77],{},[29,372,81],{"id":80},[34,374,375,379,383,387],{},[37,376,86,377],{},[41,378,89],{},[37,380,92,381],{},[41,382,95],{},[37,384,98,385,103],{},[100,386,102],{},[37,388,106],{},[13,390,109,391,113,393,117],{},[100,392,112],{},[100,394,116],{},[29,396,120],{"id":120},[13,398,123,399,127],{},[41,400,126],{},[29,402,130],{"id":130},[13,404,133,405,139,408,145],{},[16,406,138],{"href":136,"rel":407},[25],[16,409,144],{"href":142,"rel":410},[25],[147,412,413],{"className":149,"code":150,"language":151,"meta":152,"style":152},[100,414,415,421],{"__ignoreMap":152},[156,416,417,419],{"class":158,"line":159},[156,418,163],{"class":162},[156,420,167],{"class":166},[156,422,423,425,427],{"class":158,"line":170},[156,424,163],{"class":162},[156,426,175],{"class":166},[156,428,178],{"class":166},[13,430,431,113,433,113,435,190,437,194],{},[100,432,183],{},[100,434,186],{},[100,436,189],{},[100,438,193],{},[196,440,198],{},{"title":152,"searchDepth":170,"depth":170,"links":442},[443,444,445,446,447],{"id":31,"depth":170,"text":32},{"id":59,"depth":170,"text":60},{"id":80,"depth":170,"text":81},{"id":120,"depth":170,"text":120},{"id":130,"depth":170,"text":130},{},{"title":5,"description":206},{"id":451,"title":452,"body":453,"description":584,"extension":207,"meta":585,"navigation":209,"order":586,"path":587,"seo":588,"stem":589,"__hash__":590},"content_ja\u002Fadding-sounds.md","サウンドの追加",{"type":7,"value":454,"toc":576},[455,457,460,463,481,484,515,518,537,540,554,557,560,567,570],[10,456,452],{"id":452},[13,458,459],{},"クリップを追加するまで、ボードは空です。SoundNinjaはファイル、フォルダ全体、録音、共有サウンドボードパックをインポートできます。",[29,461,462],{"id":462},"音声ファイルをインポート",[297,464,465,475,478],{},[37,466,467,470,471,474],{},[41,468,469],{},"ファイル → 音声ファイルをインポート","、またはナビバーの ",[41,472,473],{},"インポート"," を使います。",[37,476,477],{},"1つ以上の音声ファイルを選びます。",[37,479,480],{},"サウンドは現在のタブに入ります。",[29,482,483],{"id":483},"フォルダをインポート",[297,485,486,495,498],{},[37,487,488,491,492,494],{},[41,489,490],{},"ファイル → フォルダをインポート","（またはナビバーの ",[41,493,483],{},"）。",[37,496,497],{},"1つ以上のフォルダを追加。インポート前にドラッグで並べ替えできます。",[37,499,500,501],{},"配置方法を選びます：\n",[34,502,503,509],{},[37,504,505,508],{},[41,506,507],{},"タブとしてインポート"," — 各フォルダが独自のタブになる",[37,510,511,514],{},[41,512,513],{},"現在のタブにインポート"," — すべてのファイルがアクティブなタブに入る",[29,516,517],{"id":517},"クリップを録音",[13,519,520,521,524,525,529,530,44,533,536],{},"プレイヤーバーの ",[41,522,523],{},"録音"," ボタンから",[16,526,528],{"href":527},"\u002Fdocs\u002Frecording-editor","Record Editor","を開きます。キャプチャ、トリムし、",[41,531,532],{},"選択をインポート",[41,534,535],{},"すべてインポート"," で現在のタブまたは選んだタブに入れます。",[29,538,539],{"id":539},"サウンドボードをインポート",[13,541,542,545,546,549,550,553],{},[41,543,544],{},"ファイル → サウンドボードをインポート"," で共有パックを読み込みます。パックは ",[100,547,548],{},"project.sninja"," とサウンドファイルを含む ",[100,551,552],{},".zip"," です。インポート後、プロジェクトを開いて再生します。",[13,555,556],{},"複数のプロジェクト（プロファイル）も保てます。プロジェクトセレクターでボードを切り替えます。",[29,558,559],{"id":559},"見つからないファイルを再リンク",[13,561,562,563,566],{},"ディスク上で音声ファイルが移動すると、SoundNinjaは ",[41,564,565],{},"見つからないサウンドファイル"," ダイアログを表示します。検索するフォルダを選び、クリップを再リンクします。",[29,568,569],{"id":569},"次へ",[13,571,572,573,194],{},"タブ、グループ、ホットキーの整理は",[16,574,575],{"href":315},"サウンドの整理",{"title":152,"searchDepth":170,"depth":170,"links":577},[578,579,580,581,582,583],{"id":462,"depth":170,"text":462},{"id":483,"depth":170,"text":483},{"id":517,"depth":170,"text":517},{"id":539,"depth":170,"text":539},{"id":559,"depth":170,"text":559},{"id":569,"depth":170,"text":569},"音声、フォルダ、録音、共有サウンドボードをインポート。",{},3,"\u002Fadding-sounds",{"title":452,"description":584},"adding-sounds","Fa08TvxAivFfa2zc5Ab8J5x_IO2j6rzWXGssNBY_HnY",{"id":592,"title":575,"body":593,"description":730,"extension":207,"meta":731,"navigation":209,"order":732,"path":733,"seo":734,"stem":735,"__hash__":736},"content_ja\u002Forganizing-sounds.md",{"type":7,"value":594,"toc":721},[595,597,600,603,628,635,638,641,655,662,665,671,674,684,687,690,694,697,703,709,713],[10,596,575],{"id":575},[13,598,599],{},"SoundNinjaは大規模ライブラリ向けです。タブ、グループ、検索、ホットキーで、必要なクリップをワンクリック（またはワンキー）で出せます。",[29,601,602],{"id":602},"タブ",[34,604,605,611,617],{},[37,606,607,610],{},[41,608,609],{},"タブを追加"," でタブを作り、色を付けてバーをすばやく眺められます。",[37,612,613,616],{},[41,614,615],{},"すべて"," ビューはタブを横断して全サウンドを表示します。",[37,618,619,620,623,624,627],{},"サウンドは ",[41,621,622],{},"1つ以上のタブ"," に所属できます。サウンドを右クリックし、",[41,625,626],{},"タブへ移動"," で割り当てます。",[13,629,630,631,634],{},"タブの切り替え演出は ",[41,632,633],{},"設定 → メイン","：スライド、フェード、ボタンを1つずつ、またはなし。",[29,636,637],{"id":637},"グループ",[13,639,640],{},"v0.5.3以降、セパレーターを名前付きグループにできます：",[34,642,643,646,649,652],{},[37,644,645],{},"コンテキストメニューからグループの追加、名前変更、削除",[37,647,648],{},"グループヘッダーをドラッグ — 子も一緒に動く",[37,650,651],{},"グループにサウンドを入れたり出したり",[37,653,654],{},"グループの枠線色、名前の色、ボタン配置を設定（またはタブのデフォルトを使う）",[13,656,657,658,661],{},"見た目の区切りだけなら、通常の ",[41,659,660],{},"セパレーター"," も追加できます。",[29,663,664],{"id":664},"検索",[13,666,667,668,670],{},"ナビバーの ",[41,669,664],{}," フィールドを使います。入力に合わせて結果が更新されます。",[29,672,673],{"id":673},"並べ替え",[13,675,676,679,680,683],{},[41,677,678],{},"設定 → 動作"," でドラッグ＆ドロップをオンにします（",[41,681,682],{},"並べ替えを許可","）。その後、サウンドとグループをドラッグして配置します。",[29,685,686],{"id":686},"一括編集",[13,688,689],{},"複数のサウンドを選び、色の変更、タブへの移動、削除を一度に行えます。",[29,691,693],{"id":692},"ホットキーとサウンドid","ホットキーとサウンドID",[13,695,696],{},"すべてのサウンドには8文字のIDがあります。ボタンのコンテキストメニュー、または複数選択のIDチップからコピーします。",[13,698,699,702],{},[41,700,701],{},"設定 → ホットキー"," を開き、キーをサウンドIDに割り当てます。グローバルホットキーは任意です。",[13,704,705,706,708],{},"同じIDを",[16,707,273],{"href":272},"がクリップのトリガーに使います。",[29,710,712],{"id":711},"gifと色","GIFと色",[13,714,715,716,720],{},"サウンドを右クリックして、ボタンごとの色やGIF \u002F 画像背景を設定します。ボード全体を整える",[16,717,719],{"href":718},"\u002Fdocs\u002Ftheme-editor","Theme Creator","とは別です。",{"title":152,"searchDepth":170,"depth":170,"links":722},[723,724,725,726,727,728,729],{"id":602,"depth":170,"text":602},{"id":637,"depth":170,"text":637},{"id":664,"depth":170,"text":664},{"id":673,"depth":170,"text":673},{"id":686,"depth":170,"text":686},{"id":692,"depth":170,"text":693},{"id":711,"depth":170,"text":712},"タブ、グループ、検索、一括編集、ホットキー。",{},4,"\u002Forganizing-sounds",{"title":575,"description":730},"organizing-sounds","0mH24BvA7-1dcjELHB8mQnjaQMzT8Ie60aamXtNUZEE",{"id":738,"title":739,"body":740,"description":862,"extension":207,"meta":863,"navigation":209,"order":864,"path":865,"seo":866,"stem":867,"__hash__":868},"content_ja\u002Ftheme-editor.md","テーマエディター",{"type":7,"value":741,"toc":856},[742,744,751,755,782,785,788,802,805,831,834,837,842],[10,743,739],{"id":739},[13,745,746,747,750],{},"Theme Creatorは、ボードの完全なビジュアルエディターです。",[41,748,749],{},"設定 → メイン → Theme Creator"," から開きます。",[29,752,754],{"id":753},"_3つのタブ","3つのタブ",[297,756,757,771,777],{},[37,758,759,762,763,766,767,770],{},[41,760,761],{},"一般"," — テーマ名、共有色、フォントのアップロード（",[100,764,765],{},".ttf"," \u002F ",[100,768,769],{},".otf","）",[37,772,773,776],{},[41,774,775],{},"ボタン"," — サウンドボタンの色、書体、レイアウト、GIFオーバーレイ",[37,778,779,781],{},[41,780,602],{}," — タブバーの色、書体、枠線の太さ",[13,783,784],{},"編集中、ライブプレビューがタブとボタンを表示します。",[29,786,787],{"id":787},"変更できる項目",[34,789,790,793,796,799],{},[37,791,792],{},"プライマリとアクセントの色、背景、ボタン色、タブ色",[37,794,795],{},"ボタンとタブのフォントファミリーとサイズ",[37,797,798],{},"ボタンの幅、半径、枠線幅、隙間、パディング",[37,800,801],{},"GIFオーバーレイの不透明度（通常とホバー）",[29,803,804],{"id":804},"保存と共有",[34,806,807,813,819,825],{},[37,808,809,812],{},[41,810,811],{},".cssをエクスポート"," — バックアップや友人への送信用テーマファイルを書き出す",[37,814,815,818],{},[41,816,817],{},"テーマに追加"," — Themesフォルダに保存して適用",[37,820,821,824],{},[41,822,823],{},".cssをインポート"," — 組み込みプリセットまたは保存済みテーマを読み込む",[37,826,827,830],{},[41,828,829],{},"リセット"," — SoundNinjaのデフォルトに戻す",[13,832,833],{},"未保存の変更があるままウィンドウを閉じると、SoundNinjaが先に保存を求めます。",[29,835,836],{"id":836},"フルエディターなしで",[13,838,839,841],{},[41,840,633],{}," でも次が可能です：",[34,843,844,847,853],{},[37,845,846],{},"リストからテーマを選ぶ",[37,848,849,850,770],{},"CSS変数をライブ編集する（",[41,851,852],{},"カスタムCSS",[37,854,855],{},"テーマファイルをThemesフォルダにインポートする",{"title":152,"searchDepth":170,"depth":170,"links":857},[858,859,860,861],{"id":753,"depth":170,"text":754},{"id":787,"depth":170,"text":787},{"id":804,"depth":170,"text":804},{"id":836,"depth":170,"text":836},"Theme Creatorで色、フォント、ボタン、タブをデザイン。",{},5,"\u002Ftheme-editor",{"title":739,"description":862},"theme-editor","tGeQE8HatAeqLeJ_3U4A-ac0RfIRzcoq-KghedjPolg",{"id":870,"title":871,"body":872,"description":998,"extension":207,"meta":999,"navigation":209,"order":1000,"path":1001,"seo":1002,"stem":1003,"__hash__":1004},"content_ja\u002Frecording-editor.md","録音エディター",{"type":7,"value":873,"toc":992},[874,876,882,885,891,911,914,917,942,945,960,964,977,983],[10,875,871],{"id":871},[13,877,878,879,881],{},"SoundNinja内でクリップを録音し、トリムしてタブにインポートします。プレイヤーバーの ",[41,880,523],{}," ボタンでエディターを開きます。",[29,883,884],{"id":884},"入力を選ぶ",[13,886,887,890],{},[41,888,889],{},"設定 → オーディオ"," で：",[34,892,893,899,905],{},[37,894,895,898],{},[41,896,897],{},"入力デバイス"," — マイク",[37,900,901,904],{},[41,902,903],{},"出力デバイス（PCオーディオ）"," — PCが再生している音のループバック",[37,906,907,910],{},[41,908,909],{},"入力音量"," — キャプチャゲイン 0%〜200%",[13,912,913],{},"録音ボタンは、ここで選んだデバイスを使います。",[29,915,916],{"id":916},"テイクを編集",[34,918,919,922,925,933,936,939],{},[37,920,921],{},"録音と停止",[37,923,924],{},"入力レベルメーターを確認",[37,926,927,44,930],{},[41,928,929],{},"ノーマライズ",[41,931,932],{},"ノイズキャンセレーション",[37,934,935],{},"クリップ全体のトリム、選択範囲へのトリム、選択の削除",[37,937,938],{},"元に戻す \u002F やり直し",[37,940,941],{},"ズームインとズームアウト",[29,943,944],{"id":944},"ステージしてインポート",[297,946,947,950,953],{},[37,948,949],{},"選択範囲またはトラック全体をステージングリストに追加します。",[37,951,952],{},"リストは空から始まります。録音、編集、それからクリップを追加。",[37,954,955,44,957,959],{},[41,956,532],{},[41,958,535],{}," で、現在のタブまたは選んだタブに入れます。",[29,961,963],{"id":962},"ステム分離任意","ステム分離（任意）",[13,965,966,967,44,970,973,974,194],{},"Record EditorはBS-RoFormerで ",[41,968,969],{},"ボーカル",[41,971,972],{},"音楽"," を残せます。モデルは約158 MBで、アプリには ",[41,975,976],{},"同梱されていません",[13,978,979,982],{},[41,980,981],{},"設定 → ステム分離"," からダウンロードするか、初回起動のプロンプトを承認します。Windowsインストーラーも初回起動時にモデルのダウンロードを案内できます。",[13,984,985,986,766,989,494],{},"ソースからのステムビルドには追加フラグが必要です（",[100,987,988],{},"tauri:serve:stems",[100,990,991],{},"tauri:build:stems",{"title":152,"searchDepth":170,"depth":170,"links":993},[994,995,996,997],{"id":884,"depth":170,"text":884},{"id":916,"depth":170,"text":916},{"id":944,"depth":170,"text":944},{"id":962,"depth":170,"text":963},"マイクまたはPCオーディオを取り込み、クリップを編集してボードに置く。",{},6,"\u002Frecording-editor",{"title":871,"description":998},"recording-editor","fkw2G1vYZhqRZ8t2Y9irOID6H-BdjzVV8fvv-hE_qbo",{"id":1006,"title":1007,"body":1008,"description":1223,"extension":207,"meta":1224,"navigation":209,"order":1225,"path":1226,"seo":1227,"stem":1228,"__hash__":1229},"content_ja\u002Fremote-control.md","リモートコントロール",{"type":7,"value":1009,"toc":1216},[1010,1012,1015,1018,1050,1053,1056,1094,1097,1117,1120,1123,1155,1159,1165],[10,1011,1007],{"id":1007},[13,1013,1014],{},"SoundNinjaはローカルネットワークで待ち受け、Bitfocus Companion（または任意のHTTP\u002FWebSocketクライアント）がサウンドを再生・停止できます。",[29,1016,1017],{"id":1017},"リモートサーバーを有効化",[297,1019,1020,1026,1033,1040],{},[37,1021,1022,1025],{},[41,1023,1024],{},"設定 → リモート"," を開きます。",[37,1027,1028,1029,1032],{},"リモートサーバーを有効にします。デフォルトポートは ",[41,1030,1031],{},"7331"," です。",[37,1034,1035,1036,1039],{},"任意：トークンを設定。クライアントはBearerトークンまたは ",[100,1037,1038],{},"?token="," で送ります。",[37,1041,1042,1045,1046,1049],{},[100,1043,1044],{},"http:\u002F\u002FIP:PORT"," URLをコピーするか、",[41,1047,1048],{},"設定 → 情報"," からシステムIPをコピーします。",[13,1051,1052],{},"Windowsはサーバー初回起動時にファイアウォールの確認を出すことがあります。プライベートネットワークのアクセスを許可してください。",[29,1054,273],{"id":1055},"bitfocus-companion",[297,1057,1058,1065,1074,1081,1088],{},[37,1059,1060,1064],{},[16,1061,273],{"href":1062,"rel":1063},"https:\u002F\u002Fbitfocus.io\u002Fcompanion",[25],"をインストールします。",[37,1066,1067,1068,1073],{},"公式フォルダからSoundNinjaモジュールをダウンロード：",[16,1069,1072],{"href":1070,"rel":1071},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Ftree\u002Fmain\u002Fcompanion-module-soundninja",[25],"companion-module-soundninja","。Companion Storeのパッケージはまだありません — このフォルダがダウンロードです。",[37,1075,1076,1077,1080],{},"Companionで ",[41,1078,1079],{},"Developer → Modules"," を開くか、フォルダをCompanionのカスタムモジュールパスに置きます。",[37,1082,1083,1084,1087],{},"モジュールフォルダで ",[100,1085,1086],{},"npm install"," を実行します。",[37,1089,1090,1093],{},[41,1091,1092],{},"Sound Ninja"," 接続を追加。PCのIP、ポート、設定したトークンを貼り付けます。",[29,1095,1096],{"id":1096},"アクション",[34,1098,1099,1105,1111],{},[37,1100,1101,1104],{},[41,1102,1103],{},"Trigger Sound"," — ライブドロップダウンから選ぶか、8文字のサウンドIDを入力（Companion変数が使えます）",[37,1106,1107,1110],{},[41,1108,1109],{},"Stop Sound"," — IDで再生中のサウンドを1つ停止",[37,1112,1113,1116],{},[41,1114,1115],{},"Stop All"," — 再生中の全サウンドを停止",[13,1118,1119],{},"SoundNinjaでは、ボタンのコンテキストメニューまたは複数選択のIDチップからサウンドIDをコピーします。",[29,1121,1122],{"id":1122},"フィードバックと変数",[34,1124,1125,1131,1143,1149],{},[37,1126,1127,1130],{},[41,1128,1129],{},"Sound Playing"," — そのサウンドIDがアクティブな間はtrue（ボタン色に使う）",[37,1132,1133,1136,1137,766,1140],{},[100,1134,1135],{},"$(soundninja:connected)"," — ",[100,1138,1139],{},"true",[100,1141,1142],{},"false",[37,1144,1145,1148],{},[100,1146,1147],{},"$(soundninja:playing_count)"," — 再生中のサウンド数",[37,1150,1151,1154],{},[100,1152,1153],{},"$(soundninja:last_triggered)"," — 最後にトリガーしたサウンドID",[29,1156,1158],{"id":1157},"http-api上級","HTTP API（上級）",[13,1160,1161,1162],{},"ベースパス：",[100,1163,1164],{},"\u002Fapi\u002Fv1",[34,1166,1167,1173,1179,1185,1195,1201,1210],{},[37,1168,1169,1172],{},[100,1170,1171],{},"GET \u002Finfo"," — アプリ名、バージョン、プロトコル、トークンが必要か",[37,1174,1175,1178],{},[100,1176,1177],{},"GET \u002Fsounds"," — サウンド一覧（id、name、tabs、active）",[37,1180,1181,1184],{},[100,1182,1183],{},"GET \u002Fstate"," — サウンドと現在再生中のID",[37,1186,1187,1190,1191,1194],{},[100,1188,1189],{},"POST \u002Ftrigger"," に ",[100,1192,1193],{},"{ \"id\" }"," — サウンドを再生",[37,1196,1197,1200],{},[100,1198,1199],{},"GET \u002Ftrigger\u002F:id"," — 再生（ブラウザで簡単にテスト）",[37,1202,1203,1206,1207,1209],{},[100,1204,1205],{},"POST \u002Fstop"," に任意の ",[100,1208,1193],{}," — 1つまたはすべて停止",[37,1211,1212,1215],{},[100,1213,1214],{},"GET \u002Fws"," — ライブ状態。trigger\u002Fstopコマンドを受信",{"title":152,"searchDepth":170,"depth":170,"links":1217},[1218,1219,1220,1221,1222],{"id":1017,"depth":170,"text":1017},{"id":1055,"depth":170,"text":273},{"id":1096,"depth":170,"text":1096},{"id":1122,"depth":170,"text":1122},{"id":1157,"depth":170,"text":1158},"ローカルネットワーク経由でBitfocus CompanionからSoundNinjaを操作。",{},7,"\u002Fremote-control",{"title":1007,"description":1223},"remote-control","zONoY2nsMS914utdiT4H8vCiez_Sndn4qxbRAolwtHw",{"id":1231,"title":1232,"body":1233,"description":1318,"extension":207,"meta":1319,