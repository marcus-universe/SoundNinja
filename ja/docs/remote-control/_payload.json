[{"data":1,"prerenderedAt":1352},["ShallowReactive",2],{"docs-page-ja-\u002Fremote-control":3,"docs-nav-ja":245},{"id":4,"title":5,"body":6,"description":236,"extension":237,"meta":238,"navigation":239,"order":240,"path":241,"seo":242,"stem":243,"__hash__":244},"content_ja\u002Fremote-control.md","リモートコントロール",{"type":7,"value":8,"toc":227},"minimark",[9,12,16,20,56,59,63,103,106,127,130,133,166,170,176],[10,11,5],"h1",{"id":5},[13,14,15],"p",{},"SoundNinjaはローカルネットワークで待ち受け、Bitfocus Companion（または任意のHTTP\u002FWebSocketクライアント）がサウンドを再生・停止できます。",[17,18,19],"h2",{"id":19},"リモートサーバーを有効化",[21,22,23,31,38,46],"ol",{},[24,25,26,30],"li",{},[27,28,29],"strong",{},"設定 → リモート"," を開きます。",[24,32,33,34,37],{},"リモートサーバーを有効にします。デフォルトポートは ",[27,35,36],{},"7331"," です。",[24,39,40,41,45],{},"任意：トークンを設定。クライアントはBearerトークンまたは ",[42,43,44],"code",{},"?token="," で送ります。",[24,47,48,51,52,55],{},[42,49,50],{},"http:\u002F\u002FIP:PORT"," URLをコピーするか、",[27,53,54],{},"設定 → 情報"," からシステムIPをコピーします。",[13,57,58],{},"Windowsはサーバー初回起動時にファイアウォールの確認を出すことがあります。プライベートネットワークのアクセスを許可してください。",[17,60,62],{"id":61},"bitfocus-companion","Bitfocus Companion",[21,64,65,74,83,90,97],{},[24,66,67,73],{},[68,69,62],"a",{"href":70,"rel":71},"https:\u002F\u002Fbitfocus.io\u002Fcompanion",[72],"nofollow","をインストールします。",[24,75,76,77,82],{},"公式フォルダからSoundNinjaモジュールをダウンロード：",[68,78,81],{"href":79,"rel":80},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Ftree\u002Fmain\u002Fcompanion-module-soundninja",[72],"companion-module-soundninja","。Companion Storeのパッケージはまだありません — このフォルダがダウンロードです。",[24,84,85,86,89],{},"Companionで ",[27,87,88],{},"Developer → Modules"," を開くか、フォルダをCompanionのカスタムモジュールパスに置きます。",[24,91,92,93,96],{},"モジュールフォルダで ",[42,94,95],{},"npm install"," を実行します。",[24,98,99,102],{},[27,100,101],{},"Sound Ninja"," 接続を追加。PCのIP、ポート、設定したトークンを貼り付けます。",[17,104,105],{"id":105},"アクション",[107,108,109,115,121],"ul",{},[24,110,111,114],{},[27,112,113],{},"Trigger Sound"," — ライブドロップダウンから選ぶか、8文字のサウンドIDを入力（Companion変数が使えます）",[24,116,117,120],{},[27,118,119],{},"Stop Sound"," — IDで再生中のサウンドを1つ停止",[24,122,123,126],{},[27,124,125],{},"Stop All"," — 再生中の全サウンドを停止",[13,128,129],{},"SoundNinjaでは、ボタンのコンテキストメニューまたは複数選択のIDチップからサウンドIDをコピーします。",[17,131,132],{"id":132},"フィードバックと変数",[107,134,135,141,154,160],{},[24,136,137,140],{},[27,138,139],{},"Sound Playing"," — そのサウンドIDがアクティブな間はtrue（ボタン色に使う）",[24,142,143,146,147,150,151],{},[42,144,145],{},"$(soundninja:connected)"," — ",[42,148,149],{},"true"," \u002F ",[42,152,153],{},"false",[24,155,156,159],{},[42,157,158],{},"$(soundninja:playing_count)"," — 再生中のサウンド数",[24,161,162,165],{},[42,163,164],{},"$(soundninja:last_triggered)"," — 最後にトリガーしたサウンドID",[17,167,169],{"id":168},"http-api上級","HTTP API（上級）",[13,171,172,173],{},"ベースパス：",[42,174,175],{},"\u002Fapi\u002Fv1",[107,177,178,184,190,196,206,212,221],{},[24,179,180,183],{},[42,181,182],{},"GET \u002Finfo"," — アプリ名、バージョン、プロトコル、トークンが必要か",[24,185,186,189],{},[42,187,188],{},"GET \u002Fsounds"," — サウンド一覧（id、name、tabs、active）",[24,191,192,195],{},[42,193,194],{},"GET \u002Fstate"," — サウンドと現在再生中のID",[24,197,198,201,202,205],{},[42,199,200],{},"POST \u002Ftrigger"," に ",[42,203,204],{},"{ \"id\" }"," — サウンドを再生",[24,207,208,211],{},[42,209,210],{},"GET \u002Ftrigger\u002F:id"," — 再生（ブラウザで簡単にテスト）",[24,213,214,217,218,220],{},[42,215,216],{},"POST \u002Fstop"," に任意の ",[42,219,204],{}," — 1つまたはすべて停止",[24,222,223,226],{},[42,224,225],{},"GET \u002Fws"," — ライブ状態。trigger\u002Fstopコマンドを受信",{"title":228,"searchDepth":229,"depth":229,"links":230},"",2,[231,232,233,234,235],{"id":19,"depth":229,"text":19},{"id":61,"depth":229,"text":62},{"id":105,"depth":229,"text":105},{"id":132,"depth":229,"text":132},{"id":168,"depth":229,"text":169},"ローカルネットワーク経由でBitfocus CompanionからSoundNinjaを操作。","md",{},true,7,"\u002Fremote-control",{"title":5,"description":236},"remote-control","zONoY2nsMS914utdiT4H8vCiez_Sndn4qxbRAolwtHw",[246,359,555,696,842,973,1109,1257],{"id":247,"title":248,"body":249,"description":352,"extension":237,"meta":353,"navigation":239,"order":354,"path":355,"seo":356,"stem":357,"__hash__":358},"content_ja\u002Foverview.md","概要",{"type":7,"value":250,"toc":346},[251,253,256,259,262,265,279,282,311,314,323,326],[10,252,248],{"id":248},[13,254,255],{},"SoundNinjaは、ライブ配信、友だちとのチャット、ポッドキャスト収録向けのオープンソースサウンドボードです。Tauri v2とNuxt 4で構築されており、RAMとディスクの負荷を抑えています。",[13,257,258],{},"目標はシンプルです。巨大なサウンドライブラリをすばやく眺め、目的のクリップをミリ秒で再生すること。UIはVRのダッシュボードとしても使いやすいです。",[13,260,261],{},"SoundNinjaはまだ初期開発段階です。機能は動きますが、すべてのプラットフォームで完全に検証されているわけではありません。",[17,263,264],{"id":264},"対象ユーザー",[107,266,267,270,273,276],{},[24,268,269],{},"即時のサウンドキューが必要な配信者",[24,271,272],{},"ボイスチャット用の共有ボードが欲しい友だち",[24,274,275],{},"クリップを録ってボードに置くポッドキャスター",[24,277,278],{},"カスタマイズ可能な、ローカル優先のサウンドボードが欲しい人",[17,280,281],{"id":281},"できること",[107,283,284,287,290,293,296,299,305,308],{},[24,285,286],{},"自分の音声ファイルからサウンドボードを作る",[24,288,289],{},"色付きタブ、グループ、検索で整理する",[24,291,292],{},"Theme Creatorで見た目をデザインする",[24,294,295],{},"Record EditorでPCオーディオまたはマイクを録音する",[24,297,298],{},"個別のサウンドにホットキーを割り当てる",[24,300,301,304],{},[68,302,62],{"href":303},"\u002Fdocs\u002Fremote-control","からサウンドをトリガーする",[24,306,307],{},"サウンドボード全体をインポート／エクスポートして共有する",[24,309,310],{},"サウンドボタンにGIFや画像を使う",[17,312,313],{"id":313},"ライセンス",[13,315,316,317,322],{},"SoundNinjaは",[68,318,321],{"href":319,"rel":320},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fblob\u002Fmain\u002FLICENSE",[72],"GPL-3.0","のフリーソフトウェアです。フォーク、改変、共有できます。",[17,324,325],{"id":325},"次のステップ",[21,327,328,334,340],{},[24,329,330],{},[68,331,333],{"href":332},"\u002Fdocs\u002Finstallation","SoundNinjaをインストール",[24,335,336],{},[68,337,339],{"href":338},"\u002Fdocs\u002Fadding-sounds","サウンドを追加",[24,341,342],{},[68,343,345],{"href":344},"\u002Fdocs\u002Forganizing-sounds","ボードを整理",{"title":228,"searchDepth":229,"depth":229,"links":347},[348,349,350,351],{"id":264,"depth":229,"text":264},{"id":281,"depth":229,"text":281},{"id":313,"depth":229,"text":313},{"id":325,"depth":229,"text":325},"SoundNinjaとは何か、何ができるか。",{},1,"\u002Foverview",{"title":248,"description":352},"overview","KJDpLdg7ixvHWAtVFjPRaSTU7NMWgwE__i0PB3mQH3E",{"id":360,"title":361,"body":362,"description":549,"extension":237,"meta":550,"navigation":239,"order":229,"path":551,"seo":552,"stem":553,"__hash__":554},"content_ja\u002Finstallation.md","インストール",{"type":7,"value":363,"toc":542},[364,366,379,383,401,404,408,422,425,429,453,464,467,474,477,492,522,538],[10,365,361],{"id":361},[13,367,368,372,373,378],{},[68,369,371],{"href":370},"\u002Fdownload","ダウンロードページ","または",[68,374,377],{"href":375,"rel":376},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Freleases\u002Flatest",[72],"GitHub Releases","からビルドを入手してください。SoundNinjaは初期開発中なので、ビルドはベータとして扱ってください。",[17,380,382],{"id":381},"windows","Windows",[107,384,385,395,398],{},[24,386,387,388,391,392],{},"64ビットWindows向けの",[27,389,390],{},"インストーラー (.exe)"," または ",[27,393,394],{},"MSI (.msi)",[24,396,397],{},"ランディングページの対象：Windows 10以降",[24,399,400],{},"アプリのREADMEはWindows 8以上も記載",[13,402,403],{},"インストーラーを実行し、スタートメニューからSoundNinjaを起動します。",[17,405,407],{"id":406},"macos","macOS",[107,409,410,416,419],{},[24,411,412,413],{},"Apple SiliconとIntel向けの",[27,414,415],{},"ユニバーサル .dmg",[24,417,418],{},"ランディングページの対象：macOS 10.14以降",[24,420,421],{},"アプリのREADMEはmacOS 10.15以上を記載",[13,423,424],{},"ディスクイメージを開き、SoundNinjaをアプリケーションにドラッグします。",[17,426,428],{"id":427},"linux","Linux",[107,430,431,437,443,450],{},[24,432,433,434],{},"Ubuntu \u002F Debian向けの",[27,435,436],{},"Debian (.deb)",[24,438,439,440],{},"その他のディストリ向けの",[27,441,442],{},"AppImage",[24,444,445,446,449],{},"リリース公開後、ArchユーザーはAURから",[42,447,448],{},"soundninja-bin","をインストールできます",[24,451,452],{},"Ubuntu 20.04でテスト済み",[13,454,455,456,459,460,463],{},"デスクトップビルドにはWebKitとGTKのパッケージが必要です。Debian\u002FUbuntuでは通常、",[42,457,458],{},"libwebkit2gtk","、",[42,461,462],{},"libgtk-3-0","、app-indicatorライブラリです。",[17,465,466],{"id":466},"アップデート",[13,468,469,470,473],{},"アプリ内で ",[27,471,472],{},"ヘルプ → アップデートを確認"," を開きます。設定で起動時にSoundNinjaが確認するようにもできます。",[17,475,476],{"id":476},"ソースからビルド",[13,478,479,480,485,486,491],{},"カスタムビルドが必要なら、",[68,481,484],{"href":482,"rel":483},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja",[72],"リポジトリ","をクローンし、",[68,487,490],{"href":488,"rel":489},"https:\u002F\u002Fv2.tauri.app\u002Fstart\u002Fprerequisites\u002F",[72],"Tauriの前提条件","を入れたうえで：",[493,494,498],"pre",{"className":495,"code":496,"language":497,"meta":228,"style":228},"language-bash shiki shiki-themes github-light github-dark","bun install\nbun run tauri:serve\n","bash",[42,499,500,512],{"__ignoreMap":228},[501,502,504,508],"span",{"class":503,"line":354},"line",[501,505,507],{"class":506},"sScJk","bun",[501,509,511],{"class":510},"sZZnC"," install\n",[501,513,514,516,519],{"class":503,"line":229},[501,515,507],{"class":506},[501,517,518],{"class":510}," run",[501,520,521],{"class":510}," tauri:serve\n",[13,523,524,459,527,459,530,533,534,537],{},[42,525,526],{},"npm",[42,528,529],{},"pnpm",[42,531,532],{},"deno","でも動きます。本番ビルド：",[42,535,536],{},"bun run tauri:build","。",[539,540,541],"style",{},"html pre.shiki code .sScJk, html code.shiki .sScJk{--shiki-default:#6F42C1;--shiki-dark:#B392F0}html pre.shiki code .sZZnC, html code.shiki .sZZnC{--shiki-default:#032F62;--shiki-dark:#9ECBFF}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html.dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}",{"title":228,"searchDepth":229,"depth":229,"links":543},[544,545,546,547,548],{"id":381,"depth":229,"text":382},{"id":406,"depth":229,"text":407},{"id":427,"depth":229,"text":428},{"id":466,"depth":229,"text":466},{"id":476,"depth":229,"text":476},"Windows、macOS、LinuxにSoundNinjaをインストール。",{},"\u002Finstallation",{"title":361,"description":549},"installation","PtsEiD1MtLz3wDVCCGAWac0JxyBztTW1uRBbWQWqSOs",{"id":556,"title":557,"body":558,"description":689,"extension":237,"meta":690,"navigation":239,"order":691,"path":692,"seo":693,"stem":694,"__hash__":695},"content_ja\u002Fadding-sounds.md","サウンドの追加",{"type":7,"value":559,"toc":681},[560,562,565,568,586,589,620,623,642,645,659,662,665,672,675],[10,561,557],{"id":557},[13,563,564],{},"クリップを追加するまで、ボードは空です。SoundNinjaはファイル、フォルダ全体、録音、共有サウンドボードパックをインポートできます。",[17,566,567],{"id":567},"音声ファイルをインポート",[21,569,570,580,583],{},[24,571,572,575,576,579],{},[27,573,574],{},"ファイル → 音声ファイルをインポート","、またはナビバーの ",[27,577,578],{},"インポート"," を使います。",[24,581,582],{},"1つ以上の音声ファイルを選びます。",[24,584,585],{},"サウンドは現在のタブに入ります。",[17,587,588],{"id":588},"フォルダをインポート",[21,590,591,600,603],{},[24,592,593,596,597,599],{},[27,594,595],{},"ファイル → フォルダをインポート","（またはナビバーの ",[27,598,588],{},"）。",[24,601,602],{},"1つ以上のフォルダを追加。インポート前にドラッグで並べ替えできます。",[24,604,605,606],{},"配置方法を選びます：\n",[107,607,608,614],{},[24,609,610,613],{},[27,611,612],{},"タブとしてインポート"," — 各フォルダが独自のタブになる",[24,615,616,619],{},[27,617,618],{},"現在のタブにインポート"," — すべてのファイルがアクティブなタブに入る",[17,621,622],{"id":622},"クリップを録音",[13,624,625,626,629,630,634,635,391,638,641],{},"プレイヤーバーの ",[27,627,628],{},"録音"," ボタンから",[68,631,633],{"href":632},"\u002Fdocs\u002Frecording-editor","Record Editor","を開きます。キャプチャ、トリムし、",[27,636,637],{},"選択をインポート",[27,639,640],{},"すべてインポート"," で現在のタブまたは選んだタブに入れます。",[17,643,644],{"id":644},"サウンドボードをインポート",[13,646,647,650,651,654,655,658],{},[27,648,649],{},"ファイル → サウンドボードをインポート"," で共有パックを読み込みます。パックは ",[42,652,653],{},"project.sninja"," とサウンドファイルを含む ",[42,656,657],{},".zip"," です。インポート後、プロジェクトを開いて再生します。",[13,660,661],{},"複数のプロジェクト（プロファイル）も保てます。プロジェクトセレクターでボードを切り替えます。",[17,663,664],{"id":664},"見つからないファイルを再リンク",[13,666,667,668,671],{},"ディスク上で音声ファイルが移動すると、SoundNinjaは ",[27,669,670],{},"見つからないサウンドファイル"," ダイアログを表示します。検索するフォルダを選び、クリップを再リンクします。",[17,673,674],{"id":674},"次へ",[13,676,677,678,537],{},"タブ、グループ、ホットキーの整理は",[68,679,680],{"href":344},"サウンドの整理",{"title":228,"searchDepth":229,"depth":229,"links":682},[683,684,685,686,687,688],{"id":567,"depth":229,"text":567},{"id":588,"depth":229,"text":588},{"id":622,"depth":229,"text":622},{"id":644,"depth":229,"text":644},{"id":664,"depth":229,"text":664},{"id":674,"depth":229,"text":674},"音声、フォルダ、録音、共有サウンドボードをインポート。",{},3,"\u002Fadding-sounds",{"title":557,"description":689},"adding-sounds","Fa08TvxAivFfa2zc5Ab8J5x_IO2j6rzWXGssNBY_HnY",{"id":697,"title":680,"body":698,"description":835,"extension":237,"meta":836,"navigation":239,"order":837,"path":838,"seo":839,"stem":840,"__hash__":841},"content_ja\u002Forganizing-sounds.md",{"type":7,"value":699,"toc":826},[700,702,705,708,733,740,743,746,760,767,770,776,779,789,792,795,799,802,808,814,818],[10,701,680],{"id":680},[13,703,704],{},"SoundNinjaは大規模ライブラリ向けです。タブ、グループ、検索、ホットキーで、必要なクリップをワンクリック（またはワンキー）で出せます。",[17,706,707],{"id":707},"タブ",[107,709,710,716,722],{},[24,711,712,715],{},[27,713,714],{},"タブを追加"," でタブを作り、色を付けてバーをすばやく眺められます。",[24,717,718,721],{},[27,719,720],{},"すべて"," ビューはタブを横断して全サウンドを表示します。",[24,723,724,725,728,729,732],{},"サウンドは ",[27,726,727],{},"1つ以上のタブ"," に所属できます。サウンドを右クリックし、",[27,730,731],{},"タブへ移動"," で割り当てます。",[13,734,735,736,739],{},"タブの切り替え演出は ",[27,737,738],{},"設定 → メイン","：スライド、フェード、ボタンを1つずつ、またはなし。",[17,741,742],{"id":742},"グループ",[13,744,745],{},"v0.5.3以降、セパレーターを名前付きグループにできます：",[107,747,748,751,754,757],{},[24,749,750],{},"コンテキストメニューからグループの追加、名前変更、削除",[24,752,753],{},"グループヘッダーをドラッグ — 子も一緒に動く",[24,755,756],{},"グループにサウンドを入れたり出したり",[24,758,759],{},"グループの枠線色、名前の色、ボタン配置を設定（またはタブのデフォルトを使う）",[13,761,762,763,766],{},"見た目の区切りだけなら、通常の ",[27,764,765],{},"セパレーター"," も追加できます。",[17,768,769],{"id":769},"検索",[13,771,772,773,775],{},"ナビバーの ",[27,774,769],{}," フィールドを使います。入力に合わせて結果が更新されます。",[17,777,778],{"id":778},"並べ替え",[13,780,781,784,785,788],{},[27,782,783],{},"設定 → 動作"," でドラッグ＆ドロップをオンにします（",[27,786,787],{},"並べ替えを許可","）。その後、サウンドとグループをドラッグして配置します。",[17,790,791],{"id":791},"一括編集",[13,793,794],{},"複数のサウンドを選び、色の変更、タブへの移動、削除を一度に行えます。",[17,796,798],{"id":797},"ホットキーとサウンドid","ホットキーとサウンドID",[13,800,801],{},"すべてのサウンドには8文字のIDがあります。ボタンのコンテキストメニュー、または複数選択のIDチップからコピーします。",[13,803,804,807],{},[27,805,806],{},"設定 → ホットキー"," を開き、キーをサウンドIDに割り当てます。グローバルホットキーは任意です。",[13,809,810,811,813],{},"同じIDを",[68,812,62],{"href":303},"がクリップのトリガーに使います。",[17,815,817],{"id":816},"gifと色","GIFと色",[13,819,820,821,825],{},"サウンドを右クリックして、ボタンごとの色やGIF \u002F 画像背景を設定します。ボード全体を整える",[68,822,824],{"href":823},"\u002Fdocs\u002Ftheme-editor","Theme Creator","とは別です。",{"title":228,"searchDepth":229,"depth":229,"links":827},[828,829,830,831,832,833,834],{"id":707,"depth":229,"text":707},{"id":742,"depth":229,"text":742},{"id":769,"depth":229,"text":769},{"id":778,"depth":229,"text":778},{"id":791,"depth":229,"text":791},{"id":797,"depth":229,"text":798},{"id":816,"depth":229,"text":817},"タブ、グループ、検索、一括編集、ホットキー。",{},4,"\u002Forganizing-sounds",{"title":680,"description":835},"organizing-sounds","0mH24BvA7-1dcjELHB8mQnjaQMzT8Ie60aamXtNUZEE",{"id":843,"title":844,"body":845,"description":966,"extension":237,"meta":967,"navigation":239,"order":968,"path":969,"seo":970,"stem":971,"__hash__":972},"content_ja\u002Ftheme-editor.md","テーマエディター",{"type":7,"value":846,"toc":960},[847,849,856,860,886,889,892,906,909,935,938,941,946],[10,848,844],{"id":844},[13,850,851,852,855],{},"Theme Creatorは、ボードの完全なビジュアルエディターです。",[27,853,854],{},"設定 → メイン → Theme Creator"," から開きます。",[17,857,859],{"id":858},"_3つのタブ","3つのタブ",[21,861,862,875,881],{},[24,863,864,867,868,150,871,874],{},[27,865,866],{},"一般"," — テーマ名、共有色、フォントのアップロード（",[42,869,870],{},".ttf",[42,872,873],{},".otf","）",[24,876,877,880],{},[27,878,879],{},"ボタン"," — サウンドボタンの色、書体、レイアウト、GIFオーバーレイ",[24,882,883,885],{},[27,884,707],{}," — タブバーの色、書体、枠線の太さ",[13,887,888],{},"編集中、ライブプレビューがタブとボタンを表示します。",[17,890,891],{"id":891},"変更できる項目",[107,893,894,897,900,903],{},[24,895,896],{},"プライマリとアクセントの色、背景、ボタン色、タブ色",[24,898,899],{},"ボタンとタブのフォントファミリーとサイズ",[24,901,902],{},"ボタンの幅、半径、枠線幅、隙間、パディング",[24,904,905],{},"GIFオーバーレイの不透明度（通常とホバー）",[17,907,908],{"id":908},"保存と共有",[107,910,911,917,923,929],{},[24,912,913,916],{},[27,914,915],{},".cssをエクスポート"," — バックアップや友人への送信用テーマファイルを書き出す",[24,918,919,922],{},[27,920,921],{},"テーマに追加"," — Themesフォルダに保存して適用",[24,924,925,928],{},[27,926,927],{},".cssをインポート"," — 組み込みプリセットまたは保存済みテーマを読み込む",[24,930,931,934],{},[27,932,933],{},"リセット"," — SoundNinjaのデフォルトに戻す",[13,936,937],{},"未保存の変更があるままウィンドウを閉じると、SoundNinjaが先に保存を求めます。",[17,939,940],{"id":940},"フルエディターなしで",[13,942,943,945],{},[27,944,738],{}," でも次が可能です：",[107,947,948,951,957],{},[24,949,950],{},"リストからテーマを選ぶ",[24,952,953,954,874],{},"CSS変数をライブ編集する（",[27,955,956],{},"カスタムCSS",[24,958,959],{},"テーマファイルをThemesフォルダにインポートする",{"title":228,"searchDepth":229,"depth":229,"links":961},[962,963,964,965],{"id":858,"depth":229,"text":859},{"id":891,"depth":229,"text":891},{"id":908,"depth":229,"text":908},{"id":940,"depth":229,"text":940},"Theme Creatorで色、フォント、ボタン、タブをデザイン。",{},5,"\u002Ftheme-editor",{"title":844,"description":966},"theme-editor","tGeQE8HatAeqLeJ_3U4A-ac0RfIRzcoq-KghedjPolg",{"id":974,"title":975,"body":976,"description":1102,"extension":237,"meta":1103,"navigation":239,"order":1104,"path":1105,"seo":1106,"stem":1107,"__hash__":1108},"content_ja\u002Frecording-editor.md","録音エディター",{"type":7,"value":977,"toc":1096},[978,980,986,989,995,1015,1018,1021,1046,1049,1064,1068,1081,1087],[10,979,975],{"id":975},[13,981,982,983,985],{},"SoundNinja内でクリップを録音し、トリムしてタブにインポートします。プレイヤーバーの ",[27,984,628],{}," ボタンでエディターを開きます。",[17,987,988],{"id":988},"入力を選ぶ",[13,990,991,994],{},[27,992,993],{},"設定 → オーディオ"," で：",[107,996,997,1003,1009],{},[24,998,999,1002],{},[27,1000,1001],{},"入力デバイス"," — マイク",[24,1004,1005,1008],{},[27,1006,1007],{},"出力デバイス（PCオーディオ）"," — PCが再生している音のループバック",[24,1010,1011,1014],{},[27,1012,1013],{},"入力音量"," — キャプチャゲイン 0%〜200%",[13,1016,1017],{},"録音ボタンは、ここで選んだデバイスを使います。",[17,1019,1020],{"id":1020},"テイクを編集",[107,1022,1023,1026,1029,1037,1040,1043],{},[24,1024,1025],{},"録音と停止",[24,1027,1028],{},"入力レベルメーターを確認",[24,1030,1031,391,1034],{},[27,1032,1033],{},"ノーマライズ",[27,1035,1036],{},"ノイズキャンセレーション",[24,1038,1039],{},"クリップ全体のトリム、選択範囲へのトリム、選択の削除",[24,1041,1042],{},"元に戻す \u002F やり直し",[24,1044,1045],{},"ズームインとズームアウト",[17,1047,1048],{"id":1048},"ステージしてインポート",[21,1050,1051,1054,1057],{},[24,1052,1053],{},"選択範囲またはトラック全体をステージングリストに追加します。",[24,1055,1056],{},"リストは空から始まります。録音、編集、それからクリップを追加。",[24,1058,1059,391,1061,1063],{},[27,1060,637],{},[27,1062,640],{}," で、現在のタブまたは選んだタブに入れます。",[17,1065,1067],{"id":1066},"ステム分離任意","ステム分離（任意）",[13,1069,1070,1071,391,1074,1077,1078,537],{},"Record EditorはBS-RoFormerで ",[27,1072,1073],{},"ボーカル",[27,1075,1076],{},"音楽"," を残せます。モデルは約158 MBで、アプリには ",[27,1079,1080],{},"同梱されていません",[13,1082,1083,1086],{},[27,1084,1085],{},"設定 → ステム分離"," からダウンロードするか、初回起動のプロンプトを承認します。Windowsインストーラーも初回起動時にモデルのダウンロードを案内できます。",[13,1088,1089,1090,150,1093,599],{},"ソースからのステムビルドには追加フラグが必要です（",[42,1091,1092],{},"tauri:serve:stems",[42,1094,1095],{},"tauri:build:stems",{"title":228,"searchDepth":229,"depth":229,"links":1097},[1098,1099,1100,1101],{"id":988,"depth":229,"text":988},{"id":1020,"depth":229,"text":1020},{"id":1048,"depth":229,"text":1048},{"id":1066,"depth":229,"text":1067},"マイクまたはPCオーディオを取り込み、クリップを編集してボードに置く。",{},6,"\u002Frecording-editor",{"title":975,"description":1102},"recording-editor","fkw2G1vYZhqRZ8t2Y9irOID6H-BdjzVV8fvv-hE_qbo",{"id":4,"title":5,"body":1110,"description":236,"extension":237