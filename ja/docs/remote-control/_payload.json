1260,"description":1345,"extension":237,"meta":1346,"navigation":239,"order":1347,"path":1348,"seo":1349,"stem":1350,"__hash__":1351},"content_ja\u002Fsupport.md","サポート",{"type":7,"value":1261,"toc":1338},[1262,1264,1267,1270,1273,1280,1288,1291,1298,1300,1313,1316,1328,1331],[10,1263,1259],{"id":1259},[13,1265,1266],{},"SoundNinjaは初期ベータのコミュニティプロジェクトです。いちばん早い助けはGitHubです。",[17,1268,1269],{"id":1269},"バグ報告または質問",[13,1271,1272],{},"GitHubでissueを開いてください：",[13,1274,1275],{},[68,1276,1279],{"href":1277,"rel":1278},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fissues",[72],"github.com\u002Fmarcus-universe\u002FSoundNinja\u002Fissues",[13,1281,1282,1283,391,1285,1287],{},"OS、SoundNinjaのバージョン（",[27,1284,472],{},[27,1286,54],{},"）、再現手順を書いてください。",[17,1289,1290],{"id":1290},"メール",[13,1292,1293,1294],{},"メンテナー連絡先：",[68,1295,1297],{"href":1296},"mailto:contact@marcus-universe.de","contact@marcus-universe.de",[17,1299,466],{"id":466},[13,1301,469,1302,1304,1305,1307,1308,1312],{},[27,1303,472],{}," を使います。新しいビルドは",[68,1306,371],{"href":370},"と",[68,1309,377],{"href":1310,"rel":1311},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Freleases",[72],"にも出ます。",[17,1314,1315],{"id":1315},"コントリビュート",[13,1317,1318,1319,1323,1324,1327],{},"プルリクエストを歓迎します。アプリのリポジトリは",[68,1320,1322],{"href":482,"rel":1321},[72],"github.com\u002Fmarcus-universe\u002FSoundNinja","です。プロジェクトは",[68,1325,321],{"href":319,"rel":1326},[72],"ライセンスです。",[17,1329,1330],{"id":1330},"法的情報",[13,1332,1333,1334,537],{},"インプリントと連絡先：",[68,1335,1337],{"href":1336},"\u002Fimpressum","インプリント",{"title":228,"searchDepth":229,"depth":229,"links":1339},[1340,1341,1342,1343,1344],{"id":1269,"depth":229,"text":1269},{"id":1290,"depth":229,"text":1290},{"id":466,"depth":229,"text":466},{"id":1315,"depth":229,"text":1315},{"id":1330,"depth":229,"text":1330},"ヘルプの入手先とバグ報告。",{},8,"\u002Fsupport",{"title":1259,"description":1345},"support","T2BdU-sWENDKBxowzv9wjeevj1bEK3iit1IGD77Vz_M",1788110440