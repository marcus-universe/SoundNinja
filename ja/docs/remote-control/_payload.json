[{"data":1,"prerenderedAt":1608},["ShallowReactive",2],{"docs-page-ja-\u002Fremote-control":3,"docs-nav-ja":241},{"id":4,"title":5,"body":6,"description":232,"extension":233,"meta":234,"navigation":235,"order":236,"path":237,"seo":238,"stem":239,"__hash__":240},"content_ja\u002Fremote-control.md","リモートコントロール",{"type":7,"value":8,"toc":223},"minimark",[9,12,16,20,56,59,63,99,102,123,126,129,162,166,172],[10,11,5],"h1",{"id":5},[13,14,15],"p",{},"SoundNinjaはローカルネットワークで待ち受け、Bitfocus Companion（または任意のHTTP\u002FWebSocketクライアント）がサウンドを再生・停止できます。",[17,18,19],"h2",{"id":19},"リモートサーバーを有効化",[21,22,23,31,38,46],"ol",{},[24,25,26,30],"li",{},[27,28,29],"strong",{},"設定 → リモート"," を開きます。",[24,32,33,34,37],{},"リモートサーバーを有効にします。デフォルトポートは ",[27,35,36],{},"7331"," です。",[24,39,40,41,45],{},"任意：トークンを設定。クライアントはBearerトークンまたは ",[42,43,44],"code",{},"?token="," で送ります。",[24,47,48,51,52,55],{},[42,49,50],{},"http:\u002F\u002FIP:PORT"," URLをコピーするか、",[27,53,54],{},"設定 → 情報"," からシステムIPをコピーします。",[13,57,58],{},"Windowsはサーバー初回起動時にファイアウォールの確認を出すことがあります。プライベートネットワークのアクセスを許可してください。",[17,60,62],{"id":61},"bitfocus-companion","Bitfocus Companion",[21,64,65,74,82,93],{},[24,66,67,73],{},[68,69,62],"a",{"href":70,"rel":71},"https:\u002F\u002Fbitfocus.io\u002Fcompanion",[72],"nofollow","をインストールします。",[24,75,76,81],{},[68,77,80],{"href":78,"rel":79},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Freleases\u002Flatest\u002Fdownload\u002FSoundNinja-Companion.tgz",[72],"SoundNinja-Companion.tgz"," をダウンロード。Companion Storeのパッケージはまだありません。",[24,83,84,85,88,89,92],{},"Companionで ",[27,86,87],{},"Modules → Load module package"," を開き、",[42,90,91],{},".tgz"," を選びます。",[24,94,95,98],{},[27,96,97],{},"Sound Ninja"," 接続を追加。PCのIP、ポート、設定したトークンを貼り付けます。",[17,100,101],{"id":101},"アクション",[103,104,105,111,117],"ul",{},[24,106,107,110],{},[27,108,109],{},"Trigger Sound"," — ライブドロップダウンから選ぶか、8文字のサウンドIDを入力（Companion変数が使えます）",[24,112,113,116],{},[27,114,115],{},"Stop Sound"," — IDで再生中のサウンドを1つ停止",[24,118,119,122],{},[27,120,121],{},"Stop All"," — 再生中の全サウンドを停止",[13,124,125],{},"SoundNinjaでは、ボタンのコンテキストメニューまたは複数選択のIDチップからサウンドIDをコピーします。",[17,127,128],{"id":128},"フィードバックと変数",[103,130,131,137,150,156],{},[24,132,133,136],{},[27,134,135],{},"Sound Playing"," — そのサウンドIDがアクティブな間はtrue（ボタン色に使う）",[24,138,139,142,143,146,147],{},[42,140,141],{},"$(soundninja:connected)"," — ",[42,144,145],{},"true"," \u002F ",[42,148,149],{},"false",[24,151,152,155],{},[42,153,154],{},"$(soundninja:playing_count)"," — 再生中のサウンド数",[24,157,158,161],{},[42,159,160],{},"$(soundninja:last_triggered)"," — 最後にトリガーしたサウンドID",[17,163,165],{"id":164},"http-api上級","HTTP API（上級）",[13,167,168,169],{},"ベースパス：",[42,170,171],{},"\u002Fapi\u002Fv1",[103,173,174,180,186,192,202,208,217],{},[24,175,176,179],{},[42,177,178],{},"GET \u002Finfo"," — アプリ名、バージョン、プロトコル、トークンが必要か",[24,181,182,185],{},[42,183,184],{},"GET \u002Fsounds"," — サウンド一覧（id、name、tabs、active）",[24,187,188,191],{},[42,189,190],{},"GET \u002Fstate"," — サウンドと現在再生中のID",[24,193,194,197,198,201],{},[42,195,196],{},"POST \u002Ftrigger"," に ",[42,199,200],{},"{ \"id\" }"," — サウンドを再生",[24,203,204,207],{},[42,205,206],{},"GET \u002Ftrigger\u002F:id"," — 再生（ブラウザで簡単にテスト）",[24,209,210,213,214,216],{},[42,211,212],{},"POST \u002Fstop"," に任意の ",[42,215,200],{}," — 1つまたはすべて停止",[24,218,219,222],{},[42,220,221],{},"GET \u002Fws"," — ライブ状態。trigger\u002Fstopコマンドを受信",{"title":224,"searchDepth":225,"depth":225,"links":226},"",2,[227,228,229,230,231],{"id":19,"depth":225,"text":19},{"id":61,"depth":225,"text":62},{"id":101,"depth":225,"text":101},{"id":128,"depth":225,"text":128},{"id":164,"depth":225,"text":165},"ローカルネットワーク経由でBitfocus CompanionからSoundNinjaを操作。","md",{},true,7,"\u002Fremote-control",{"title":5,"description":232},"remote-control","_6T2WMAtPh7L1pRelAkpGazesfqk5Swk4FcTh5g7BTw",[242,364,563,704,1095,1226,1367,1513],{"id":243,"title":244,"body":245,"description":357,"extension":233,"meta":358,"navigation":235,"order":359,"path":360,"seo":361,"stem":362,"__hash__":363},"content_ja\u002Foverview.md","概要",{"type":7,"value":246,"toc":351},[247,249,252,255,258,261,275,278,316,319,328,331],[10,248,244],{"id":244},[13,250,251],{},"SoundNinjaは、ライブ配信、友だちとのチャット、ポッドキャスト収録向けのオープンソースサウンドボードです。Tauri v2とNuxt 4で構築されており、RAMとディスクの負荷を抑えています。",[13,253,254],{},"目標はシンプルです。巨大なサウンドライブラリをすばやく眺め、目的のクリップをミリ秒で再生すること。UIはVRのダッシュボードとしても使いやすいです。",[13,256,257],{},"SoundNinjaはまだ初期開発段階です。機能は動きますが、すべてのプラットフォームで完全に検証されているわけではありません。",[17,259,260],{"id":260},"対象ユーザー",[103,262,263,266,269,272],{},[24,264,265],{},"即時のサウンドキューが必要な配信者",[24,267,268],{},"ボイスチャット用の共有ボードが欲しい友だち",[24,270,271],{},"クリップを録ってボードに置くポッドキャスター",[24,273,274],{},"カスタマイズ可能な、ローカル優先のサウンドボードが欲しい人",[17,276,277],{"id":277},"できること",[103,279,280,283,286,289,292,295,298,301,304,310,313],{},[24,281,282],{},"自分の音声ファイルからサウンドボードを作る",[24,284,285],{},"色付きタブ、グループ、タグ、検索で整理する",[24,287,288],{},"タグでフィルター（OR）、名前・日付・長さ・サイズでソート",[24,290,291],{},"マーキーまたはShift範囲で複数選択し、色・移動・削除を一括",[24,293,294],{},"コンテキストメニューでサウンドごとの音量を設定",[24,296,297],{},"Theme Creatorで見た目をデザインする",[24,299,300],{},"Record EditorでPCオーディオまたはマイクを録音する",[24,302,303],{},"個別のサウンドにホットキーを割り当てる",[24,305,306,309],{},[68,307,62],{"href":308},"\u002Fdocs\u002Fremote-control","からサウンドをトリガーする",[24,311,312],{},"サウンドボード全体をインポート／エクスポートして共有する",[24,314,315],{},"サウンドボタンにGIFや画像を使う — ローカルフォルダライブラリまたはKLIPY",[17,317,318],{"id":318},"ライセンス",[13,320,321,322,327],{},"SoundNinjaは",[68,323,326],{"href":324,"rel":325},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fblob\u002Fmain\u002FLICENSE",[72],"GPL-3.0","のフリーソフトウェアです。フォーク、改変、共有できます。",[17,329,330],{"id":330},"次のステップ",[21,332,333,339,345],{},[24,334,335],{},[68,336,338],{"href":337},"\u002Fdocs\u002Finstallation","SoundNinjaをインストール",[24,340,341],{},[68,342,344],{"href":343},"\u002Fdocs\u002Fadding-sounds","サウンドを追加",[24,346,347],{},[68,348,350],{"href":349},"\u002Fdocs\u002Forganizing-sounds","ボードを整理",{"title":224,"searchDepth":225,"depth":225,"links":352},[353,354,355,356],{"id":260,"depth":225,"text":260},{"id":277,"depth":225,"text":277},{"id":318,"depth":225,"text":318},{"id":330,"depth":225,"text":330},"SoundNinjaとは何か、何ができるか。",{},1,"\u002Foverview",{"title":244,"description":357},"overview","c8xWgFwxVyANkJ28nfjNkL8am61Nn8aDvVh7jKzMyKM",{"id":365,"title":366,"body":367,"description":557,"extension":233,"meta":558,"navigation":235,"order":225,"path":559,"seo":560,"stem":561,"__hash__":562},"content_ja\u002Finstallation.md","インストール",{"type":7,"value":368,"toc":550},[369,371,384,388,409,412,416,430,433,437,461,472,475,482,485,500,530,546],[10,370,366],{"id":366},[13,372,373,377,378,383],{},[68,374,376],{"href":375},"\u002Fdownload","ダウンロードページ","または",[68,379,382],{"href":380,"rel":381},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Freleases\u002Flatest",[72],"GitHub Releases","からビルドを入手してください。SoundNinjaは初期開発中なので、ビルドはベータとして扱ってください。",[17,385,387],{"id":386},"windows","Windows",[103,389,390,400,403,406],{},[24,391,392,393,396,397],{},"64ビットWindows向けの",[27,394,395],{},"インストーラー (.exe)"," または ",[27,398,399],{},"MSI (.msi)",[24,401,402],{},"ランディングページの対象：Windows 10以降",[24,404,405],{},"アプリのREADMEはWindows 8以上も記載",[24,407,408],{},"NSISインストーラーはダークテーマ。セットアップ時に言語を選ぶと、次回起動時にSoundNinjaが覚えます。",[13,410,411],{},"インストーラーを実行し、スタートメニューからSoundNinjaを起動します。",[17,413,415],{"id":414},"macos","macOS",[103,417,418,424,427],{},[24,419,420,421],{},"Apple SiliconとIntel向けの",[27,422,423],{},"ユニバーサル .dmg",[24,425,426],{},"ランディングページの対象：macOS 10.14以降",[24,428,429],{},"アプリのREADMEはmacOS 10.15以上を記載",[13,431,432],{},"ディスクイメージを開き、SoundNinjaをアプリケーションにドラッグします。",[17,434,436],{"id":435},"linux","Linux",[103,438,439,445,451,458],{},[24,440,441,442],{},"Ubuntu \u002F Debian向けの",[27,443,444],{},"Debian (.deb)",[24,446,447,448],{},"その他のディストリ向けの",[27,449,450],{},"AppImage",[24,452,453,454,457],{},"リリース公開後、ArchユーザーはAURから",[42,455,456],{},"soundninja-bin","をインストールできます",[24,459,460],{},"Ubuntu 20.04でテスト済み",[13,462,463,464,467,468,471],{},"デスクトップビルドにはWebKitとGTKのパッケージが必要です。Debian\u002FUbuntuでは通常、",[42,465,466],{},"libwebkit2gtk","、",[42,469,470],{},"libgtk-3-0","、app-indicatorライブラリです。",[17,473,474],{"id":474},"アップデート",[13,476,477,478,481],{},"アプリ内で ",[27,479,480],{},"ヘルプ → アップデートを確認"," を開きます。設定で起動時にSoundNinjaが確認するようにもできます。",[17,483,484],{"id":484},"ソースからビルド",[13,486,487,488,493,494,499],{},"カスタムビルドが必要なら、",[68,489,492],{"href":490,"rel":491},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja",[72],"リポジトリ","をクローンし、",[68,495,498],{"href":496,"rel":497},"https:\u002F\u002Fv2.tauri.app\u002Fstart\u002Fprerequisites\u002F",[72],"Tauriの前提条件","を入れたうえで：",[501,502,506],"pre",{"className":503,"code":504,"language":505,"meta":224,"style":224},"language-bash shiki shiki-themes github-light github-dark","bun install\nbun run tauri:serve\n","bash",[42,507,508,520],{"__ignoreMap":224},[509,510,512,516],"span",{"class":511,"line":359},"line",[509,513,515],{"class":514},"sScJk","bun",[509,517,519],{"class":518},"sZZnC"," install\n",[509,521,522,524,527],{"class":511,"line":225},[509,523,515],{"class":514},[509,525,526],{"class":518}," run",[509,528,529],{"class":518}," tauri:serve\n",[13,531,532,467,535,467,538,541,542,545],{},[42,533,534],{},"npm",[42,536,537],{},"pnpm",[42,539,540],{},"deno","でも動きます。本番ビルド：",[42,543,544],{},"bun run tauri:build","。",[547,548,549],"style",{},"html pre.shiki code .sScJk, html code.shiki .sScJk{--shiki-default:#6F42C1;--shiki-dark:#B392F0}html pre.shiki code .sZZnC, html code.shiki .sZZnC{--shiki-default:#032F62;--shiki-dark:#9ECBFF}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html.dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}",{"title":224,"searchDepth":225,"depth":225,"links":551},[552,553,554,555,556],{"id":386,"depth":225,"text":387},{"id":414,"depth":225,"text":415},{"id":435,"depth":225,"text":436},{"id":474,"depth":225,"text":474},{"id":484,"depth":225,"text":484},"Windows、macOS、LinuxにSoundNinjaをインストール。",{},"\u002Finstallation",{"title":366,"description":557},"installation","Y0LyjIaCaa6QDprLZ1KDPjTfWKBUFvFm5ERbBT-RfpY",{"id":564,"title":565,"body":566,"description":697,"extension":233,"meta":698,"navigation":235,"order":699,"path":700,"seo":701,"stem":702,"__hash__":703},"content_ja\u002Fadding-sounds.md","サウンドの追加",{"type":7,"value":567,"toc":689},[568,570,573,576,594,597,628,631,650,653,667,670,673,680,683],[10,569,565],{"id":565},[13,571,572],{},"クリップを追加するまで、ボードは空です。SoundNinjaはファイル、フォルダ全体、録音、共有サウンドボードパックをインポートできます。",[17,574,575],{"id":575},"音声ファイルをインポート",[21,577,578,588,591],{},[24,579,580,583,584,587],{},[27,581,582],{},"ファイル → 音声ファイルをインポート","、またはナビバーの ",[27,585,586],{},"インポート"," を使います。",[24,589,590],{},"1つ以上の音声ファイルを選びます。",[24,592,593],{},"サウンドは現在のタブに入ります。",[17,595,596],{"id":596},"フォルダをインポート",[21,598,599,608,611],{},[24,600,601,604,605,607],{},[27,602,603],{},"ファイル → フォルダをインポート","（またはナビバーの ",[27,606,596],{},"）。",[24,609,610],{},"1つ以上のフォルダを追加。インポート前にドラッグで並べ替えできます。",[24,612,613,614],{},"配置方法を選びます：\n",[103,615,616,622],{},[24,617,618,621],{},[27,619,620],{},"タブとしてインポート"," — 各フォルダが独自のタブになる",[24,623,624,627],{},[27,625,626],{},"現在のタブにインポート"," — すべてのファイルがアクティブなタブに入る",[17,629,630],{"id":630},"クリップを録音",[13,632,633,634,637,638,642,643,396,646,649],{},"プレイヤーバーの ",[27,635,636],{},"録音"," ボタンから",[68,639,641],{"href":640},"\u002Fdocs\u002Frecording-editor","Record Editor","を開きます。キャプチャ、トリムし、",[27,644,645],{},"選択をインポート",[27,647,648],{},"すべてインポート"," で現在のタブまたは選んだタブに入れます。",[17,651,652],{"id":652},"サウンドボードをインポート",[13,654,655,658,659,662,663,666],{},[27,656,657],{},"ファイル → サウンドボードをインポート"," で共有パックを読み込みます。パックは ",[42,660,661],{},"project.sninja"," とサウンドファイルを含む ",[42,664,665],{},".zip"," です。インポート後、プロジェクトを開いて再生します。",[13,668,669],{},"複数のプロジェクト（プロファイル）も保てます。プロジェクトセレクターでボードを切り替えます。",[17,671,672],{"id":672},"見つからないファイルを再リンク",[13,674,675,676,679],{},"ディスク上で音声ファイルが移動すると、SoundNinjaは ",[27,677,678],{},"見つからないサウンドファイル"," ダイアログを表示します。検索するフォルダを選び、クリップを再リンクします。",[17,681,682],{"id":682},"次へ",[13,684,685,686,545],{},"タブ、タグ、フィルター、ホットキーの整理は",[68,687,688],{"href":349},"サウンドの整理",{"title":224,"searchDepth":225,"depth":225,"links":690},[691,692,693,694,695,696],{"id":575,"depth":225,"text":575},{"id":596,"depth":225,"text":596},{"id":630,"depth":225,"text":630},{"id":652,"depth":225,"text":652},{"id":672,"depth":225,"text":672},{"id":682,"depth":225,"text":682},"音声、フォルダ、録音、共有サウンドボードをインポート。",{},3,"\u002Fadding-sounds",{"title":565,"description":697},"adding-sounds","5_cjd2COcPz0pj4ZrBehCZv6ouzBimE8UGjkcfngQjw",{"id":705,"title":688,"body":706,"description":1088,"extension":233,"meta":1089,"navigation":235,"order":1090,"path":1091,"seo":1092,"stem":1093,"__hash__":1094},"content_ja\u002Forganizing-sounds.md",{"type":7,"value":707,"toc":1073},[708,710,717,720,745,752,755,758,772,779,785,789,799,803,833,836,842,845,879,886,890,893,919,922,926,939,942,947,968,984,991,994,1005,1008,1012,1019,1029,1035,1038,1046,1053,1070],[10,709,688],{"id":688},[13,711,712,713,716],{},"SoundNinjaは大規模ライブラリ向けです。",[27,714,715],{},"タグとフィルター","、タブ、検索、複数選択、ホットキーで、必要なクリップをワンクリック（またはワンキー）で出せます。",[17,718,719],{"id":719},"タブ",[103,721,722,728,734],{},[24,723,724,727],{},[27,725,726],{},"タブを追加"," でタブを作り、色を付けてバーをすばやく眺められます。",[24,729,730,733],{},[27,731,732],{},"すべて"," ビューはタブを横断して全サウンドを表示します。",[24,735,736,737,740,741,744],{},"サウンドは ",[27,738,739],{},"1つ以上のタブ"," に所属できます。サウンドを右クリックし、",[27,742,743],{},"タブへ移動"," で割り当てます。",[13,746,747,748,751],{},"タブの切り替え演出は ",[27,749,750],{},"設定 → メイン","：スライド、フェード、ボタンを1つずつ、またはなし。",[17,753,754],{"id":754},"グループ",[13,756,757],{},"v0.5.3以降、セパレーターを名前付きグループにできます：",[103,759,760,763,766,769],{},[24,761,762],{},"コンテキストメニューからグループの追加、名前変更、削除",[24,764,765],{},"グループヘッダーをドラッグ — 子も一緒に動く",[24,767,768],{},"グループにサウンドを入れたり出したり",[24,770,771],{},"グループの枠線色、名前の色、ボタン配置を設定（またはタブのデフォルトを使う）",[13,773,774,775,778],{},"見た目の区切りだけなら、通常の ",[27,776,777],{},"セパレーター"," も追加できます。",[13,780,781,782,545],{},"ボードの空き領域を右クリックして ",[27,783,784],{},"グループを追加",[17,786,788],{"id":787},"タグ-フィルター","タグ \u002F フィルター",[13,790,791,792,795,796,798],{},"タグはタブを横断します。スライドアウトの ",[27,793,794],{},"フィルター"," パネル（サイドバー ",[27,797,794],{},"）で作成し、ボードを絞ります。",[800,801,802],"h3",{"id":802},"タグの作成と編集",[21,804,805,811,821,827],{},[24,806,807,808,810],{},"サイドバーで ",[27,809,794],{}," を開く。",[24,812,813,816,817,820],{},[27,814,815],{},"タグ"," の ",[27,818,819],{},"タグを追加"," — 名前と色を付ける。",[24,822,823,824,545],{},"同じリストで名前変更、色変更、",[27,825,826],{},"タグを削除",[24,828,829,832],{},[27,830,831],{},"タグはまだありません"," と出たら、割り当てる前にここで追加する。",[800,834,835],{"id":835},"サウンドにタグを付ける",[13,837,838,839,841],{},"サウンドを右クリック → ",[27,840,815],{},"（チェックボックス）。1つのサウンドに複数可。タグが無い場合、メニューはフィルターパネルへ案内します。",[800,843,844],{"id":844},"ボードをフィルター",[103,846,847,854,865,876],{},[24,848,849,850,853],{},"フィルターパネル、または ",[27,851,852],{},"検索バー下のチップ"," でタグを切り替え。",[24,855,856,857,860,861,864],{},"一致は ",[27,858,859],{},"OR","：選択したタグの ",[27,862,863],{},"いずれか"," を持つサウンドが表示される。",[24,866,867,868,871,872,875],{},"ナビバーの ",[27,869,870],{},"検索"," は有効なタグフィルターと ",[27,873,874],{},"AND","（入力 + タグ）。",[24,877,878],{},"チップをオフ（またはフィルター解除）でタブ全体を再表示。",[13,880,881,882,885],{},"色付きタグ名をボタンに表示できます。",[27,883,884],{},"設定 → 動作 → タグバッジを表示"," で切り替え。",[17,887,889],{"id":888},"並べ替えソート","並べ替え（ソート）",[13,891,892],{},"フィルターパネルでソートモードを選びます：",[103,894,895,901],{},[24,896,897,900],{},[27,898,899],{},"ユーザー定義"," — タブ順、グループ表示",[24,902,903,467,906,467,909,467,912,915,916],{},[27,904,905],{},"名前",[27,907,908],{},"追加日時",[27,910,911],{},"再生時間",[27,913,914],{},"ファイルサイズ"," — フラットなソート一覧。これらのモードでは ",[27,917,918],{},"グループは非表示",[13,920,921],{},"再生時間ソートは、初回に長さのメタデータを準備することがあります。",[17,923,925],{"id":924},"並べ替えドラッグ","並べ替え（ドラッグ）",[13,927,928,931,932,935,936,938],{},[27,929,930],{},"設定 → 動作"," でドラッグ＆ドロップをオンにします（",[27,933,934],{},"並べ替えを許可","）。その後、サウンドとグループをドラッグして配置します。ドラッグ並べ替えは ",[27,937,899],{}," ソートで有効です。",[17,940,941],{"id":941},"複数選択",[13,943,867,944,946],{},[27,945,941],{}," をオンにして：",[103,948,949,952,958,965],{},[24,950,951],{},"クリックでサウンドをトグル",[24,953,954,957],{},[27,955,956],{},"Shift+クリック"," で直前のアンカーから範囲選択",[24,959,960,961,964],{},"空きボード上で ",[27,962,963],{},"マーキー"," をドラッグ",[24,966,967],{},"空きボード（または外側）をクリックして選択解除",[13,969,970,971,467,974,467,977,467,980,983],{},"一括バーに件数が表示され、",[27,972,973],{},"色",[27,975,976],{},"タブへ移動…",[27,978,979],{},"削除",[27,981,982],{},"完了"," が使えます。",[13,985,986,987,990],{},"複数選択中、各ボタンに ",[27,988,989],{},"8文字のIDチップ"," が出ます。チップを右クリックでコピー。",[17,992,993],{"id":993},"サウンドごとの音量",[13,995,996,997,1000,1001,1004],{},"右クリック → ",[27,998,999],{},"音量","。スライダーを 0%〜100%。",[27,1002,1003],{},"ダブルクリック"," で 100% にリセット。",[13,1006,1007],{},"設定のマスター出力音量と重ねて効きます。",[17,1009,1011],{"id":1010},"ホットキーとサウンドid","ホットキーとサウンドID",[13,1013,1014,1015,1018],{},"すべてのサウンドには8文字のIDがあります。ボタンのコンテキストメニュー（",[27,1016,1017],{},"IDをコピー","）、または複数選択のIDチップからコピーします。",[13,1020,1021,1024,1025,1028],{},[27,1022,1023],{},"設定 → ホットキー"," を開き、キーをサウンドIDに割り当てます。グローバルホットキーは任意です。コンテキストメニューの ",[27,1026,1027],{},"ホットキーを割り当て"," は、IDを埋めた状態でそこにジャンプします。",[13,1030,1031,1032,1034],{},"同じIDを",[68,1033,62],{"href":308},"がクリップのトリガーに使います。",[17,1036,1037],{"id":1037},"背景画像と色",[13,1039,1040,1041,1045],{},"サウンドを右クリックして、ボタンごとの色や背景画像を設定します。ボード全体を整える",[68,1042,1044],{"href":1043},"\u002Fdocs\u002Ftheme-editor","Theme Creator","とは別です。",[13,1047,1048,1049,1052],{},"ピッカーは ",[27,1050,1051],{},"背景画像"," ダイアログ（PNG、JPEG、GIF、WebP）：",[103,1054,1055,1061],{},[24,1056,1057,1060],{},[27,