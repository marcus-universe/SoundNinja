[{"data":1,"prerenderedAt":1639},["ShallowReactive",2],{"docs-page-ja-\u002Fremote-control":3,"docs-nav-ja":241},{"id":4,"title":5,"body":6,"description":232,"extension":233,"meta":234,"navigation":235,"order":236,"path":237,"seo":238,"stem":239,"__hash__":240},"content_ja\u002Fremote-control.md","リモートコントロール",{"type":7,"value":8,"toc":223},"minimark",[9,12,16,20,56,59,63,99,102,123,126,129,162,166,172],[10,11,5],"h1",{"id":5},[13,14,15],"p",{},"SoundNinjaはローカルネットワークで待ち受け、Bitfocus Companion（または任意のHTTP\u002FWebSocketクライアント）がサウンドを再生・停止できます。",[17,18,19],"h2",{"id":19},"リモートサーバーを有効化",[21,22,23,31,38,46],"ol",{},[24,25,26,30],"li",{},[27,28,29],"strong",{},"設定 → リモート"," を開きます。",[24,32,33,34,37],{},"リモートサーバーを有効にします。デフォルトポートは ",[27,35,36],{},"7331"," です。",[24,39,40,41,45],{},"任意：トークンを設定。クライアントはBearerトークンまたは ",[42,43,44],"code",{},"?token="," で送ります。",[24,47,48,51,52,55],{},[42,49,50],{},"http:\u002F\u002FIP:PORT"," URLをコピーするか、",[27,53,54],{},"設定 → 情報"," からシステムIPをコピーします。",[13,57,58],{},"Windowsはサーバー初回起動時にファイアウォールの確認を出すことがあります。プライベートネットワークのアクセスを許可してください。",[17,60,62],{"id":61},"bitfocus-companion","Bitfocus Companion",[21,64,65,74,82,93],{},[24,66,67,73],{},[68,69,62],"a",{"href":70,"rel":71},"https:\u002F\u002Fbitfocus.io\u002Fcompanion",[72],"nofollow","をインストールします。",[24,75,76,81],{},[68,77,80],{"href":78,"rel":79},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002Fcompanion-module-soundninja\u002Freleases\u002Flatest",[72],"SoundNinja-Companion.tgz"," をダウンロード。Companion Storeのパッケージはまだありません。",[24,83,84,85,88,89,92],{},"Companionで ",[27,86,87],{},"Modules → Load module package"," を開き、",[42,90,91],{},".tgz"," を選びます。",[24,94,95,98],{},[27,96,97],{},"Sound Ninja"," 接続を追加。PCのIP、ポート、設定したトークンを貼り付けます。",[17,100,101],{"id":101},"アクション",[103,104,105,111,117],"ul",{},[24,106,107,110],{},[27,108,109],{},"Trigger Sound"," — ライブドロップダウンから選ぶか、8文字のサウンドIDを入力（Companion変数が使えます）",[24,112,113,116],{},[27,114,115],{},"Stop Sound"," — IDで再生中のサウンドを1つ停止",[24,118,119,122],{},[27,120,121],{},"Stop All"," — 再生中の全サウンドを停止",[13,124,125],{},"SoundNinjaでは、ボタンのコンテキストメニューまたは複数選択のIDチップからサウンドIDをコピーします。",[17,127,128],{"id":128},"フィードバックと変数",[103,130,131,137,150,156],{},[24,132,133,136],{},[27,134,135],{},"Sound Playing"," — そのサウンドIDがアクティブな間はtrue（ボタン色に使う）",[24,138,139,142,143,146,147],{},[42,140,141],{},"$(soundninja:connected)"," — ",[42,144,145],{},"true"," \u002F ",[42,148,149],{},"false",[24,151,152,155],{},[42,153,154],{},"$(soundninja:playing_count)"," — 再生中のサウンド数",[24,157,158,161],{},[42,159,160],{},"$(soundninja:last_triggered)"," — 最後にトリガーしたサウンドID",[17,163,165],{"id":164},"http-api上級","HTTP API（上級）",[13,167,168,169],{},"ベースパス：",[42,170,171],{},"\u002Fapi\u002Fv1",[103,173,174,180,186,192,202,208,217],{},[24,175,176,179],{},[42,177,178],{},"GET \u002Finfo"," — アプリ名、バージョン、プロトコル、トークンが必要か",[24,181,182,185],{},[42,183,184],{},"GET \u002Fsounds"," — サウンド一覧（id、name、tabs、active）",[24,187,188,191],{},[42,189,190],{},"GET \u002Fstate"," — サウンドと現在再生中のID",[24,193,194,197,198,201],{},[42,195,196],{},"POST \u002Ftrigger"," に ",[42,199,200],{},"{ \"id\" }"," — サウンドを再生",[24,203,204,207],{},[42,205,206],{},"GET \u002Ftrigger\u002F:id"," — 再生（ブラウザで簡単にテスト）",[24,209,210,213,214,216],{},[42,211,212],{},"POST \u002Fstop"," に任意の ",[42,215,200],{}," — 1つまたはすべて停止",[24,218,219,222],{},[42,220,221],{},"GET \u002Fws"," — ライブ状態。trigger\u002Fstopコマンドを受信",{"title":224,"searchDepth":225,"depth":225,"links":226},"",2,[227,228,229,230,231],{"id":19,"depth":225,"text":19},{"id":61,"depth":225,"text":62},{"id":101,"depth":225,"text":101},{"id":128,"depth":225,"text":128},{"id":164,"depth":225,"text":165},"ローカルネットワーク経由でBitfocus CompanionからSoundNinjaを操作。","md",{},true,7,"\u002Fremote-control",{"title":5,"description":232},"remote-control","mPFqlRPL-jxRSpdtuwlQQcHhnmsyzKrKdjplGWwWueU",[242,364,584,725,1126,1257,1398,1544],{"id":243,"title":244,"body":245,"description":357,"extension":233,"meta":358,"navigation":235,"order":359,"path":360,"seo":361,"stem":362,"__hash__":363},"content_ja\u002Foverview.md","概要",{"type":7,"value":246,"toc":351},[247,249,252,255,258,261,275,278,316,319,328,331],[10,248,244],{"id":244},[13,250,251],{},"SoundNinjaは、ライブ配信、友だちとのチャット、ポッドキャスト収録向けのオープンソースサウンドボードです。Tauri v2とNuxt 4で構築されており、RAMとディスクの負荷を抑えています。",[13,253,254],{},"目標はシンプルです。巨大なサウンドライブラリをすばやく眺め、目的のクリップをミリ秒で再生すること。UIはVRのダッシュボードとしても使いやすいです。",[13,256,257],{},"SoundNinjaはまだ初期開発段階です。機能は動きますが、すべてのプラットフォームで完全に検証されているわけではありません。",[17,259,260],{"id":260},"対象ユーザー",[103,262,263,266,269,272],{},[24,264,265],{},"即時のサウンドキューが必要な配信者",[24,267,268],{},"ボイスチャット用の共有ボードが欲しい友だち",[24,270,271],{},"クリップを録ってボードに置くポッドキャスター",[24,273,274],{},"カスタマイズ可能な、ローカル優先のサウンドボードが欲しい人",[17,276,277],{"id":277},"できること",[103,279,280,283,286,289,292,295,298,301,304,310,313],{},[24,281,282],{},"自分の音声ファイルからサウンドボードを作る",[24,284,285],{},"色付きタブ、グループ、タグ、検索で整理する",[24,287,288],{},"タグでフィルター（OR）、名前・日付・長さ・サイズでソート",[24,290,291],{},"マーキーまたはShift範囲で複数選択し、色・移動・削除を一括",[24,293,294],{},"コンテキストメニューでサウンドごとの音量を設定",[24,296,297],{},"Theme Creatorで見た目をデザインする",[24,299,300],{},"Record EditorでPCオーディオまたはマイクを録音する",[24,302,303],{},"個別のサウンドにホットキーを割り当てる",[24,305,306,309],{},[68,307,62],{"href":308},"\u002Fdocs\u002Fremote-control","からサウンドをトリガーする",[24,311,312],{},"サウンドボード全体をインポート／エクスポートして共有する",[24,314,315],{},"サウンドボタンにGIFや画像を使う — ローカルフォルダライブラリ、GifSnap、またはKLIPY",[17,317,318],{"id":318},"ライセンス",[13,320,321,322,327],{},"SoundNinjaは",[68,323,326],{"href":324,"rel":325},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fblob\u002Fmain\u002FLICENSE",[72],"GPL-3.0","のフリーソフトウェアです。フォーク、改変、共有できます。",[17,329,330],{"id":330},"次のステップ",[21,332,333,339,345],{},[24,334,335],{},[68,336,338],{"href":337},"\u002Fdocs\u002Finstallation","SoundNinjaをインストール",[24,340,341],{},[68,342,344],{"href":343},"\u002Fdocs\u002Fadding-sounds","サウンドを追加",[24,346,347],{},[68,348,350],{"href":349},"\u002Fdocs\u002Forganizing-sounds","ボードを整理",{"title":224,"searchDepth":225,"depth":225,"links":352},[353,354,355,356],{"id":260,"depth":225,"text":260},{"id":277,"depth":225,"text":277},{"id":318,"depth":225,"text":318},{"id":330,"depth":225,"text":330},"SoundNinjaとは何か、何ができるか。",{},1,"\u002Foverview",{"title":244,"description":357},"overview","RKMKM6lywYS2prTGRayXesPcG2_CgQLEmJfr9msg1eE",{"id":365,"title":366,"body":367,"description":578,"extension":233,"meta":579,"navigation":235,"order":225,"path":580,"seo":581,"stem":582,"__hash__":583},"content_ja\u002Finstallation.md","インストール",{"type":7,"value":368,"toc":571},[369,371,384,388,409,412,416,430,433,437,461,472,475,482,485,500,530,546,567],[10,370,366],{"id":366},[13,372,373,377,378,383],{},[68,374,376],{"href":375},"\u002Fdownload","ダウンロードページ","または",[68,379,382],{"href":380,"rel":381},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Freleases\u002Flatest",[72],"GitHub Releases","からビルドを入手してください。SoundNinjaは初期開発中なので、ビルドはベータとして扱ってください。",[17,385,387],{"id":386},"windows","Windows",[103,389,390,400,403,406],{},[24,391,392,393,396,397],{},"64ビットWindows向けの",[27,394,395],{},"インストーラー (.exe)"," または ",[27,398,399],{},"MSI (.msi)",[24,401,402],{},"ランディングページの対象：Windows 10以降",[24,404,405],{},"アプリのREADMEはWindows 8以上も記載",[24,407,408],{},"NSISインストーラーはダークテーマ。セットアップ時に言語を選ぶと、次回起動時にSoundNinjaが覚えます。",[13,410,411],{},"インストーラーを実行し、スタートメニューからSoundNinjaを起動します。",[17,413,415],{"id":414},"macos","macOS",[103,417,418,424,427],{},[24,419,420,421],{},"Apple SiliconとIntel向けの",[27,422,423],{},"ユニバーサル .dmg",[24,425,426],{},"ランディングページの対象：macOS 10.14以降",[24,428,429],{},"アプリのREADMEはmacOS 10.15以上を記載",[13,431,432],{},"ディスクイメージを開き、SoundNinjaをアプリケーションにドラッグします。",[17,434,436],{"id":435},"linux","Linux",[103,438,439,445,451,458],{},[24,440,441,442],{},"Ubuntu \u002F Debian向けの",[27,443,444],{},"Debian (.deb)",[24,446,447,448],{},"その他のディストリ向けの",[27,449,450],{},"AppImage",[24,452,453,454,457],{},"リリース公開後、ArchユーザーはAURから",[42,455,456],{},"soundninja-bin","をインストールできます",[24,459,460],{},"Ubuntu 20.04でテスト済み",[13,462,463,464,467,468,471],{},"デスクトップビルドにはWebKitとGTKのパッケージが必要です。Debian\u002FUbuntuでは通常、",[42,465,466],{},"libwebkit2gtk","、",[42,469,470],{},"libgtk-3-0","、app-indicatorライブラリです。",[17,473,474],{"id":474},"アップデート",[13,476,477,478,481],{},"アプリ内で ",[27,479,480],{},"ヘルプ → アップデートを確認"," を開きます。設定で起動時にSoundNinjaが確認するようにもできます。",[17,483,484],{"id":484},"ソースからビルド",[13,486,487,488,493,494,499],{},"カスタムビルドが必要なら、",[68,489,492],{"href":490,"rel":491},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja",[72],"リポジトリ","をクローンし、",[68,495,498],{"href":496,"rel":497},"https:\u002F\u002Fv2.tauri.app\u002Fstart\u002Fprerequisites\u002F",[72],"Tauriの前提条件","を入れたうえで：",[501,502,506],"pre",{"className":503,"code":504,"language":505,"meta":224,"style":224},"language-bash shiki shiki-themes github-light github-dark","bun install\nbun run tauri:serve\n","bash",[42,507,508,520],{"__ignoreMap":224},[509,510,512,516],"span",{"class":511,"line":359},"line",[509,513,515],{"class":514},"sScJk","bun",[509,517,519],{"class":518},"sZZnC"," install\n",[509,521,522,524,527],{"class":511,"line":225},[509,523,515],{"class":514},[509,525,526],{"class":518}," run",[509,528,529],{"class":518}," tauri:serve\n",[13,531,532,467,535,467,538,541,542,545],{},[42,533,534],{},"npm",[42,536,537],{},"pnpm",[42,539,540],{},"deno","でも動きます。本番ビルド：",[42,543,544],{},"bun run tauri:build","。",[13,547,548,551,552,557,558,561,562,545],{},[27,549,550],{},"Windowsのみ:"," Windowsビルドはすべて ",[68,553,556],{"href":554,"rel":555},"https:\u002F\u002Fwww.steinberg.net\u002Fasiosdk",[72],"Steinberg ASIO SDK"," 経由でASIOを含めます。一度 ",[42,559,560],{},"bun run setup:asio"," を実行（SDKはgitに含まれません）。Linux \u002F macOSは PipeWire \u002F Core Audio — この手順は不要。詳細: ",[68,563,566],{"href":564,"rel":565},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fblob\u002Fmain\u002Fdocs\u002Fbuild-from-source.md",[72],"build-from-source.md",[568,569,570],"style",{},"html pre.shiki code .sScJk, html code.shiki .sScJk{--shiki-default:#6F42C1;--shiki-dark:#B392F0}html pre.shiki code .sZZnC, html code.shiki .sZZnC{--shiki-default:#032F62;--shiki-dark:#9ECBFF}h