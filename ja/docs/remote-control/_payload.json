[{"data":1,"prerenderedAt":1346},["ShallowReactive",2],{"docs-page-ja-\u002Fremote-control":3,"docs-nav-ja":241},{"id":4,"title":5,"body":6,"description":232,"extension":233,"meta":234,"navigation":235,"order":236,"path":237,"seo":238,"stem":239,"__hash__":240},"content_ja\u002Fremote-control.md","リモートコントロール",{"type":7,"value":8,"toc":223},"minimark",[9,12,16,20,56,59,63,99,102,123,126,129,162,166,172],[10,11,5],"h1",{"id":5},[13,14,15],"p",{},"SoundNinjaはローカルネットワークで待ち受け、Bitfocus Companion（または任意のHTTP\u002FWebSocketクライアント）がサウンドを再生・停止できます。",[17,18,19],"h2",{"id":19},"リモートサーバーを有効化",[21,22,23,31,38,46],"ol",{},[24,25,26,30],"li",{},[27,28,29],"strong",{},"設定 → リモート"," を開きます。",[24,32,33,34,37],{},"リモートサーバーを有効にします。デフォルトポートは ",[27,35,36],{},"7331"," です。",[24,39,40,41,45],{},"任意：トークンを設定。クライアントはBearerトークンまたは ",[42,43,44],"code",{},"?token="," で送ります。",[24,47,48,51,52,55],{},[42,49,50],{},"http:\u002F\u002FIP:PORT"," URLをコピーするか、",[27,53,54],{},"設定 → 情報"," からシステムIPをコピーします。",[13,57,58],{},"Windowsはサーバー初回起動時にファイアウォールの確認を出すことがあります。プライベートネットワークのアクセスを許可してください。",[17,60,62],{"id":61},"bitfocus-companion","Bitfocus Companion",[21,64,65,74,82,93],{},[24,66,67,73],{},[68,69,62],"a",{"href":70,"rel":71},"https:\u002F\u002Fbitfocus.io\u002Fcompanion",[72],"nofollow","をインストールします。",[24,75,76,81],{},[68,77,80],{"href":78,"rel":79},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Freleases\u002Flatest\u002Fdownload\u002Fcompanion-module-soundninja.tgz",[72],"companion-module-soundninja.tgz"," をダウンロード。Companion Storeのパッケージはまだありません。",[24,83,84,85,88,89,92],{},"Companionで ",[27,86,87],{},"Modules → Load module package"," を開き、",[42,90,91],{},".tgz"," を選びます。",[24,94,95,98],{},[27,96,97],{},"Sound Ninja"," 接続を追加。PCのIP、ポート、設定したトークンを貼り付けます。",[17,100,101],{"id":101},"アクション",[103,104,105,111,117],"ul",{},[24,106,107,110],{},[27,108,109],{},"Trigger Sound"," — ライブドロップダウンから選ぶか、8文字のサウンドIDを入力（Companion変数が使えます）",[24,112,113,116],{},[27,114,115],{},"Stop Sound"," — IDで再生中のサウンドを1つ停止",[24,118,119,122],{},[27,120,121],{},"Stop All"," — 再生中の全サウンドを停止",[13,124,125],{},"SoundNinjaでは、ボタンのコンテキストメニューまたは複数選択のIDチップからサウンドIDをコピーします。",[17,127,128],{"id":128},"フィードバックと変数",[103,130,131,137,150,156],{},[24,132,133,136],{},[27,134,135],{},"Sound Playing"," — そのサウンドIDがアクティブな間はtrue（ボタン色に使う）",[24,138,139,142,143,146,147],{},[42,140,141],{},"$(soundninja:connected)"," — ",[42,144,145],{},"true"," \u002F ",[42,148,149],{},"false",[24,151,152,155],{},[42,153,154],{},"$(soundninja:playing_count)"," — 再生中のサウンド数",[24,157,158,161],{},[42,159,160],{},"$(soundninja:last_triggered)"," — 最後にトリガーしたサウンドID",[17,163,165],{"id":164},"http-api上級","HTTP API（上級）",[13,167,168,169],{},"ベースパス：",[42,170,171],{},"\u002Fapi\u002Fv1",[103,173,174,180,186,192,202,208,217],{},[24,175,176,179],{},[42,177,178],{},"GET \u002Finfo"," — アプリ名、バージョン、プロトコル、トークンが必要か",[24,181,182,185],{},[42,183,184],{},"GET \u002Fsounds"," — サウンド一覧（id、name、tabs、active）",[24,187,188,191],{},[42,189,190],{},"GET \u002Fstate"," — サウンドと現在再生中のID",[24,193,194,197,198,201],{},[42,195,196],{},"POST \u002Ftrigger"," に ",[42,199,200],{},"{ \"id\" }"," — サウンドを再生",[24,203,204,207],{},[42,205,206],{},"GET \u002Ftrigger\u002F:id"," — 再生（ブラウザで簡単にテスト）",[24,209,210,213,214,216],{},[42,211,212],{},"POST \u002Fstop"," に任意の ",[42,215,200],{}," — 1つまたはすべて停止",[24,218,219,222],{},[42,220,221],{},"GET \u002Fws"," — ライブ状態。trigger\u002Fstopコマンドを受信",{"title":224,"searchDepth":225,"depth":225,"links":226},"",2,[227,228,229,230,231],{"id":19,"depth":225,"text":19},{"id":61,"depth":225,"text":62},{"id":101,"depth":225,"text":101},{"id":128,"depth":225,"text":128},{"id":164,"depth":225,"text":165},"ローカルネットワーク経由でBitfocus CompanionからSoundNinjaを操作。","md",{},true,7,"\u002Fremote-control",{"title":5,"description":232},"remote-control","PoAD2qLfe4cF4Z_a5pIF5291-yAlbNAcy3yNZfTB5RM",[242,355,551,692,838,969,1105,1251],{"id":243,"title":244,"body":245,"description":348,"extension":233,"meta":349,"navigation":235,"order":350,"path":351,"seo":352,"stem":353,"__hash__":354},"content_ja\u002Foverview.md","概要",{"type":7,"value":246,"toc":342},[247,249,252,255,258,261,275,278,307,310,319,322],[10,248,244],{"id":244},[13,250,251],{},"SoundNinjaは、ライブ配信、友だちとのチャット、ポッドキャスト収録向けのオープンソースサウンドボードです。Tauri v2とNuxt 4で構築されており、RAMとディスクの負荷を抑えています。",[13,253,254],{},"目標はシンプルです。巨大なサウンドライブラリをすばやく眺め、目的のクリップをミリ秒で再生すること。UIはVRのダッシュボードとしても使いやすいです。",[13,256,257],{},"SoundNinjaはまだ初期開発段階です。機能は動きますが、すべてのプラットフォームで完全に検証されているわけではありません。",[17,259,260],{"id":260},"対象ユーザー",[103,262,263,266,269,272],{},[24,264,265],{},"即時のサウンドキューが必要な配信者",[24,267,268],{},"ボイスチャット用の共有ボードが欲しい友だち",[24,270,271],{},"クリップを録ってボードに置くポッドキャスター",[24,273,274],{},"カスタマイズ可能な、ローカル優先のサウンドボードが欲しい人",[17,276,277],{"id":277},"できること",[103,279,280,283,286,289,292,295,301,304],{},[24,281,282],{},"自分の音声ファイルからサウンドボードを作る",[24,284,285],{},"色付きタブ、グループ、検索で整理する",[24,287,288],{},"Theme Creatorで見た目をデザインする",[24,290,291],{},"Record EditorでPCオーディオまたはマイクを録音する",[24,293,294],{},"個別のサウンドにホットキーを割り当てる",[24,296,297,300],{},[68,298,62],{"href":299},"\u002Fdocs\u002Fremote-control","からサウンドをトリガーする",[24,302,303],{},"サウンドボード全体をインポート／エクスポートして共有する",[24,305,306],{},"サウンドボタンにGIFや画像を使う",[17,308,309],{"id":309},"ライセンス",[13,311,312,313,318],{},"SoundNinjaは",[68,314,317],{"href":315,"rel":316},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fblob\u002Fmain\u002FLICENSE",[72],"GPL-3.0","のフリーソフトウェアです。フォーク、改変、共有できます。",[17,320,321],{"id":321},"次のステップ",[21,323,324,330,336],{},[24,325,326],{},[68,327,329],{"href":328},"\u002Fdocs\u002Finstallation","SoundNinjaをインストール",[24,331,332],{},[68,333,335],{"href":334},"\u002Fdocs\u002Fadding-sounds","サウンドを追加",[24,337,338],{},[68,339,341],{"href":340},"\u002Fdocs\u002Forganizing-sounds","ボードを整理",{"title":224,"searchDepth":225,"depth":225,"links":343},[344,345,346,347],{"id":260,"depth":225,"text":260},{"id":277,"depth":225,"text":277},{"id":309,"depth":225,"text":309},{"id":321,"depth":225,"text":321},"SoundNinjaとは何か、何ができるか。",{},1,"\u002Foverview",{"title":244,"description":348},"overview","KJDpLdg7ixvHWAtVFjPRaSTU7NMWgwE__i0PB3mQH3E",{"id":356,"title":357,"body":358,"description":545,"extension":233,"meta":546,"navigation":235,"order":225,"path":547,"seo":548,"stem":549,"__hash__":550},"content_ja\u002Finstallation.md","インストール",{"type":7,"value":359,"toc":538},[360,362,375,379,397,400,404,418,421,425,449,460,463,470,473,488,518,534],[10,361,357],{"id":357},[13,363,364,368,369,374],{},[68,365,367],{"href":366},"\u002Fdownload","ダウンロードページ","または",[68,370,373],{"href":371,"rel":372},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Freleases\u002Flatest",[72],"GitHub Releases","からビルドを入手してください。SoundNinjaは初期開発中なので、ビルドはベータとして扱ってください。",[17,376,378],{"id":377},"windows","Windows",[103,380,381,391,394],{},[24,382,383,384,387,388],{},"64ビットWindows向けの",[27,385,386],{},"インストーラー (.exe)"," または ",[27,389,390],{},"MSI (.msi)",[24,392,393],{},"ランディングページの対象：Windows 10以降",[24,395,396],{},"アプリのREADMEはWindows 8以上も記載",[13,398,399],{},"インストーラーを実行し、スタートメニューからSoundNinjaを起動します。",[17,401,403],{"id":402},"macos","macOS",[103,405,406,412,415],{},[24,407,408,409],{},"Apple SiliconとIntel向けの",[27,410,411],{},"ユニバーサル .dmg",[24,413,414],{},"ランディングページの対象：macOS 10.14以降",[24,416,417],{},"アプリのREADMEはmacOS 10.15以上を記載",[13,419,420],{},"ディスクイメージを開き、SoundNinjaをアプリケーションにドラッグします。",[17,422,424],{"id":423},"linux","Linux",[103,426,427,433,439,446],{},[24,428,429,430],{},"Ubuntu \u002F Debian向けの",[27,431,432],{},"Debian (.deb)",[24,434,435,436],{},"その他のディストリ向けの",[27,437,438],{},"AppImage",[24,440,441,442,445],{},"リリース公開後、ArchユーザーはAURから",[42,443,444],{},"soundninja-bin","をインストールできます",[24,447,448],{},"Ubuntu 20.04でテスト済み",[13,450,451,452,455,456,459],{},"デスクトップビルドにはWebKitとGTKのパッケージが必要です。Debian\u002FUbuntuでは通常、",[42,453,454],{},"libwebkit2gtk","、",[42,457,458],{},"libgtk-3-0","、app-indicatorライブラリです。",[17,461,462],{"id":462},"アップデート",[13,464,465,466,469],{},"アプリ内で ",[27,467,468],{},"ヘルプ → アップデートを確認"," を開きます。設定で起動時にSoundNinjaが確認するようにもできます。",[17,471,472],{"id":472},"ソースからビルド",[13,474,475,476,481,482,487],{},"カスタムビルドが必要なら、",[68,477,480],{"href":478,"rel":479},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja",[72],"リポジトリ","をクローンし、",[68,483,486],{"href":484,"rel":485},"https:\u002F\u002Fv2.tauri.app\u002Fstart\u002Fprerequisites\u002F",[72],"Tauriの前提条件","を入れたうえで：",[489,490,494],"pre",{"className":491,"code":492,"language":493,"meta":224,"style":224},"language-bash shiki shiki-themes github-light github-dark","bun install\nbun run tauri:serve\n","bash",[42,495,496,508],{"__ignoreMap":224},[497,498,500,504],"span",{"class":499,"line":350},"line",[497,501,503],{"class":502},"sScJk","bun",[497,505,507],{"class":506},"sZZnC"," install\n",[497,509,510,512,515],{"class":499,"line":225},[497,511,503],{"class":502},[497,513,514],{"class":506}," run",[497,516,517],{"class":506}," tauri:serve\n",[13,519,520,455,523,455,526,529,530,533],{},[42,521,522],{},"npm",[42,524,525],{},"pnpm",[42,527,528],{},"deno","でも動きます。本番ビルド：",[42,531,532],{},"bun run tauri:build","。",[535,536,537],"style",{},"html pre.shiki code .sScJk, html code.shiki .sScJk{--shiki-default:#6F42C1;--shiki-dark:#B392F0}html pre.shiki code .sZZnC, html code.shiki .sZZnC{--shiki-default:#032F62;--shiki-dark:#9ECBFF}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html.dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}",{"title":224,"searchDepth":225,"depth":225,"links":539},[540,541,542,543,544],{"id":377,"depth":225,"text":378},{"id":402,"depth":225,"text":403},{"id":423,"depth":225,"text":424},{"id":462,"depth":225,"text":462},{"id":472,"depth":225,"text":472},"Windows、macOS、LinuxにSoundNinjaをインストール。",{},"\u002Finstallation",{"title":357,"description":545},"installation","PtsEiD1MtLz3wDVCCGAWac0JxyBztTW1uRBbWQWqSOs",{"id":552,"title":553,"body":554,"description":685,"extension":233,"meta":686,"navigation":235,"order":687,"path":688,"seo":689,"stem":690,"__hash__":691},"content_ja\u002Fadding-sounds.md","サウンドの追加",{"type":7,"value":555,"toc":677},[556,558,561,564,582,585,616,619,638,641,655,658,661,668,671],[10,557,553],{"id":553},[13,559,560],{},"クリップを追加するまで、ボードは空です。SoundNinjaはファイル、フォルダ全体、録音、共有サウンドボードパックをインポートできます。",[17,562,563],{"id":563},"音声ファイルをインポート",[21,565,566,576,579],{},[24,567,568,571,572,575],{},[27,569,570],{},"ファイル → 音声ファイルをインポート","、またはナビバーの ",[27,573,574],{},"インポート"," を使います。",[24,577,578],{},"1つ以上の音声ファイルを選びます。",[24,580,581],{},"サウンドは現在のタブに入ります。",[17,583,584],{"id":584},"フォルダをインポート",[21,586,587,596,599],{},[24,588,589,592,593,595],{},[27,590,591],{},"ファイル → フォルダをインポート","（またはナビバーの ",[27,594,584],{},"）。",[24,597,598],{},"1つ以上のフォルダを追加。インポート前にドラッグで並べ替えできます。",[24,600,601,602],{},"配置方法を選びます：\n",[103,603,604,610],{},[24,605,606,609],{},[27,607,608],{},"タブとしてインポート"," — 各フォルダが独自のタブになる",[24,611,612,615],{},[27,613,614],{},"現在のタブにインポート"," — すべてのファイルがアクティブなタブに入る",[17,617,618],{"id":618},"クリップを録音",[13,620,621,622,625,626,630,631,387,634,637],{},"プレイヤーバーの ",[27,623,624],{},"録音"," ボタンから",[68,627,629],{"href":628},"\u002Fdocs\u002Frecording-editor","Record Editor","を開きます。キャプチャ、トリムし、",[27,632,633],{},"選択をインポート",[27,635,636],{},"すべてインポート"," で現在のタブまたは選んだタブに入れます。",[17,639,640],{"id":640},"サウンドボードをインポート",[13,642,643,646,647,650,651,654],{},[27,644,645],{},"ファイル → サウンドボードをインポート"," で共有パックを読み込みます。パックは ",[42,648,649],{},"project.sninja"," とサウンドファイルを含む ",[42,652,653],{},".zip"," です。インポート後、プロジェクトを開いて再生します。",[13,656,657],{},"複数のプロジェクト（プロファイル）も保てます。プロジェクトセレクターでボードを切り替えます。",[17,659,660],{"id":660},"見つからないファイルを再リンク",[13,662,663,664,667],{},"ディスク上で音声ファイルが移動すると、SoundNinjaは ",[27,665,666],{},"見つからないサウンドファイル"," ダイアログを表示します。検索するフォルダを選び、クリップを再リンクします。",[17,669,670],{"id":670},"次へ",[13,672,673,674,533],{},"タブ、グループ、ホットキーの整理は",[68,675,676],{"href":340},"サウンドの整理",{"title":224,"searchDepth":225,"depth":225,"links":678},[679,680,681,682,683,684],{"id":563,"depth":225,"text":563},{"id":584,"depth":225,"text":584},{"id":618,"depth":225,"text":618},{"id":640,"depth":225,"text":640},{"id":660,"depth":225,"text":660},{"id":670,"depth":225,"text":670},"音声、フォルダ、録音、共有サウンドボードをインポート。",{},3,"\u002Fadding-sounds",{"title":553,"description":685},"adding-sounds","Fa08TvxAivFfa2zc5Ab8J5x_IO2j6rzWXGssNBY_HnY",{"id":693,"title":676,"body":694,"description":831,"extension":233,"meta":832,"navigation":235,"order":833,"path":834,"seo":835,"stem":836,"__hash__":837},"content_ja\u002Forganizing-sounds.md",{"type":7,"value":695,"toc":822},[696,698,701,704,729,736,739,742,756,763,766,772,775,785,788,791,795,798,804,810,814],[10,697,676],{"id":676},[13,699,700],{},"SoundNinjaは大規模ライブラリ向けです。タブ、グループ、検索、ホットキーで、必要なクリップをワンクリック（またはワンキー）で出せます。",[17,702,703],{"id":703},"タブ",[103,705,706,712,718],{},[24,707,708,711],{},[27,709,710],{},"タブを追加"," でタブを作り、色を付けてバーをすばやく眺められます。",[24,713,714,717],{},[27,715,716],{},"すべて"," ビューはタブを横断して全サウンドを表示します。",[24,719,720,721,724,725,728],{},"サウンドは ",[27,722,723],{},"1つ以上のタブ"," に所属できます。サウンドを右クリックし、",[27,726,727],{},"タブへ移動"," で割り当てます。",[13,730,731,732,735],{},"タブの切り替え演出は ",[27,733,734],{},"設定 → メイン","：スライド、フェード、ボタンを1つずつ、またはなし。",[17,737,738],{"id":738},"グループ",[13,740,741],{},"v0.5.3以降、セパレーターを名前付きグループにできます：",[103,743,744,747,750,753],{},[24,745,746],{},"コンテキストメニューからグループの追加、名前変更、削除",[24,748,749],{},"グループヘッダーをドラッグ — 子も一緒に動く",[24,751,752],{},"グループにサウンドを入れたり出したり",[24,754,755],{},"グループの枠線色、名前の色、ボタン配置を設定（またはタブのデフォルトを使う）",[13,757,758,759,762],{},"見た目の区切りだけなら、通常の ",[27,760,761],{},"セパレーター"," も追加できます。",[17,764,765],{"id":765},"検索",[13,767,768,769,771],{},"ナビバーの ",[27,770,765],{}," フィールドを使います。入力に合わせて結果が更新されます。",[17,773,774],{"id":774},"並べ替え",[13,776,777,780,781,784],{},[27,778,779],{},"設定 → 動作"," でドラッグ＆ドロップをオンにします（",[27,782,783],{},"並べ替えを許可","）。その後、サウンドとグループをドラッグして配置します。",[17,786,787],{"id":787},"一括編集",[13,789,790],{},"複数のサウンドを選び、色の変更、タブへの移動、削除を一度に行えます。",[17,792,794],{"id":793},"ホットキーとサウンドid","ホットキーとサウンドID",[13,796,797],{},"すべてのサウンドには8文字のIDがあります。ボタンのコンテキストメニュー、または複数選択のIDチップからコピーします。",[13,799,800,803],{},[27,801,802],{},"設定 → ホットキー"," を開き、キーをサウンドIDに割り当てます。グローバルホットキーは任意です。",[13,805,806,807,809],{},"同じIDを",[68,808,62],{"href":299},"がクリップのトリガーに使います。",[17,811,813],{"id":812},"gifと色","GIFと色",[13,815,816,817,821],{},"サウンドを右クリックして、ボタンごとの色やGIF \u002F 画像背景を設定します。ボード全体を整える",[68,818,820],{"href":819},"\u002Fdocs\u002Ftheme-editor","Theme Creator","とは別です。",{"title":224,"searchDepth":225,"depth":225,"links":823},[824,825,826,827,828,829,830],{"id":703,"depth":225,"text":703},{"id":738,"depth":225,"text":738},{"id":765,"depth":225,"text":765},{"id":774,"depth":225,"text":774},{"id":787,"depth":225,"text":787},{"id":793,"depth":225,"text":794},{"id":812,"depth":225,"text":813},"タブ、グループ、検索、一括編集、ホットキー。",{},4,"\u002Forganizing-sounds",{"title":676,"description":831},"organizing-sounds","0mH24BvA7-1dcjELHB8mQnjaQMzT8Ie60aamXtNUZEE",{"id":839,"title":840,"body":841,"description":962,"extension":233,"meta":963,"navigation":235,"order":964,"path":965,"seo":966,"stem":967,"__hash__":968},"content_ja\u002Ftheme-editor.md","テーマエディター",{"type":7,"value":842,"toc":956},[843,845,852,856,882,885,888,902,905,931,934,937,942],[10,844,840],{"id":840},[13,846,847,848,851],{},"Theme Creatorは、ボードの完全なビジュアルエディターです。",[27,849,850],{},"設定 → メイン → Theme Creator"," から開きます。",[17,853,855],{"id":854},"_3つのタブ","3つのタブ",[21,857,858,871,877],{},[24,859,860,863,864,146,867,870],{},[27,861,862],{},"一般"," — テーマ名、共有色、フォントのアップロード（",[42,865,866],{},".ttf",[42,868,869],{},".otf","）",[24,872,873,876],{},[27,874,875],{},"ボタン"," — サウンドボタンの色、書体、レイアウト、GIFオーバーレイ",[24,878,879,881],{},[27,880,703],{}," — タブバーの色、書体、枠線の太さ",[13,883,884],{},"編集中、ライブプレビューがタブとボタンを表示します。",[17,886,887],{"id":887},"変更できる項目",[103,889,890,893,896,899],{},[24,891,892],{},"プライマリとアクセントの色、背景、ボタン色、タブ色",[24,894,895],{},"ボタンとタブのフォントファミリーとサイズ",[24,897,898],{},"ボタンの幅、半径、枠線幅、隙間、パディング",[24,900,901],{},"GIFオーバーレイの不透明度（通常とホバー）",[17,903,904],{"id":904},"保存と共有",[103,906,907,913,919,925],{},[24,908,909,912],{},[27,910,911],{},".cssをエクスポート"," — バックアップや友人への送信用テーマファイルを書き出す",[24,914,915,918],{},[27,916,917],{},"テーマに追加"," — Themesフォルダに保存して適用",[24,920,921,924],{},[27,922,923],{},".cssをインポート"," — 組み込みプリセットまたは保存済みテーマを読み込む",[24,926,927,930],{},[27,928,929],{},"リセット"," — SoundNinjaのデフォルトに戻す",[13,932,933],{},"未保存の変更があるままウィンドウを閉じると、SoundNinjaが先に保存を求めます。",[17,935,936],{"id":936},"フルエディターなしで",[13,938,939,941],{},[27,940,734],{}," でも次が可能です：",[103,943,944,947,953],{},[24,945,946],{},"リストからテーマを選ぶ",[24,948,949,950,870],{},"CSS変数をライブ編集する（",[27,951,952],{},"カスタムCSS",[24,954,955],{},"テーマファイルをThemesフォルダにインポートする",{"title":224,"searchDepth":225,"depth":225,"links":957},[958,959,960,961],{"id":854,"depth":225,"text":855},{"id":887,"depth":225,"text":887},{"id":904,"depth":225,"text":904},{"id":936,"depth":225,"text":936},"Theme Creatorで色、フォント、ボタン、タブをデザイン。",{},5,"\u002Ftheme-editor",{"title":840,"description":962},"theme-editor","tGeQE8HatAeqLeJ_3U4A-ac0RfIRzcoq-KghedjPolg",{"id":970,"title":971,"body":972,"description":1098,"extension":233,"meta":1099,"navigation":235,"order":1100,"path":1101,"seo":1102,"stem":1103,"__hash__":1104},"content_ja\u002Frecording-editor.md","録音エディター",{"type":7,"value":973,"toc":1092},[974,976,982,985,991,1011,1014,1017,1042,1045,1060,1064,1077,1083],[10,975,971],{"id":971},[13,977,978,979,981],{},"SoundNinja内でクリップを録音し、トリムしてタブにインポートします。プレイヤーバーの ",[27,980,624],{}," ボタンでエディターを開きます。",[17,983,984],{"id":984},"入力を選ぶ",[13,986,987,990],{},[27,988,989],{},"設定 → オーディオ"," で：",[103,992,993,999,1005],{},[24,994,995,998],{},[27,996,997],{},"入力デバイス"," — マイク",[24,1000,1001,1004],{},[27,1002,1003],{},"出力デバイス（PCオーディオ）"," — PCが再生している音のループバック",[24,1006,1007,1010],{},[27,1008,1009],{},"入力音量"," — キャプチャゲイン 0%〜200%",[13,1012,1013],{},"録音ボタンは、ここで選んだデバイスを使います。",[17,1015,1016],{"id":1016},"テイクを編集",[103,1018,1019,1022,1025,1033,1036,1039],{},[24,1020,1021],{},"録音と停止",[24,1023,1024],{},"入力レベルメーターを確認",[24,1026,1027,387,1030],{},[27,1028,1029],{},"ノーマライズ",[27,1031,1032],{},"ノイズキャンセレーション",[24,1034,1035],{},"クリップ全体のトリム、選択範囲へのトリム、選択の削除",[24,1037,1038],{},"元に戻す \u002F やり直し",[24,1040,1041],{},"ズームインとズームアウト",[17,1043,1044],{"id":1044},"ステージしてインポート",[21,1046,1047,1050,1053],{},[24,1048,1049],{},"選択範囲またはトラック全体をステージングリストに追加します。",[24,1051,1052],{},"リストは空から始まります。録音、編集、それからクリップを追加。",[24,1054,1055,387,1057,1059],{},[27,1056,633],{},[27,1058,636],{}," で、現在のタブまたは選んだタブに入れます。",[17,1061,1063],{"id":1062},"ステム分離任意","ステム分離（任意）",[13,1065,1066,1067,387,1070,1073,1074,533],{},"Record EditorはBS-RoFormerで ",[27,1068,1069],{},"ボーカル",[27,1071,1072],{},"音楽"," を残せます。モデルは約158 MBで、アプリには ",[27,1075,1076],{},"同梱されていません",[13,1078,1079,1082],{},[27,1080,1081],{},"設定 → ステム分離"," からダウンロードするか、初回起動のプロンプトを承認します。Windowsインストーラーも初回起動時にモデルのダウンロードを案内できます。",[13,1084,1085,1086,146,1089,595],{},"ソースからのステムビルドには追加フラグが必要です（",[42,1087,1088],{},"tauri:serve:stems",[42,1090,1091],{},"tauri:build:stems",{"title":224,"searchDepth":225,"depth":225,"links":1093},[1094,1095,1096,1097],{"id":984,"depth":225,"text":984},{"id":1016,"depth":225,"text":1016},{"id":1044,"depth":225,"text":1044},{"id":1062,"depth":225,"text":1063},"マイクまたはPCオーディオを取り込み、クリップを編集してボードに置く。",{},6,"\u002Frecording-editor",{"title":971,"description":1098},"recording-editor","fkw2G1vYZhqRZ8t2Y9irOID6H-BdjzVV8fvv-hE_qbo",{"id":4,"title":5,"body":1106,"description":232,"extension":233,"meta":1249,"navigation":235,"order":236,"path":237,"seo":1250,"stem":239,"__hash__":240