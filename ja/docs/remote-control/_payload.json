29,632],{},[24,621,622,625,626,628],{},[27,623,624],{},"ファイル → フォルダをインポート","（またはナビバーの ",[27,627,617],{},"）。",[24,630,631],{},"1つ以上のフォルダを追加。インポート前にドラッグで並べ替えできます。",[24,633,634,635],{},"配置方法を選びます：\n",[103,636,637,643],{},[24,638,639,642],{},[27,640,641],{},"タブとしてインポート"," — 各フォルダが独自のタブになる",[24,644,645,648],{},[27,646,647],{},"現在のタブにインポート"," — すべてのファイルがアクティブなタブに入る",[17,650,651],{"id":651},"クリップを録音",[13,653,654,655,658,659,663,664,396,667,670],{},"プレイヤーバーの ",[27,656,657],{},"録音"," ボタンから",[68,660,662],{"href":661},"\u002Fdocs\u002Frecording-editor","Record Editor","を開きます。キャプチャ、トリムし、",[27,665,666],{},"選択をインポート",[27,668,669],{},"すべてインポート"," で現在のタブまたは選んだタブに入れます。",[17,672,673],{"id":673},"サウンドボードをインポート",[13,675,676,679,680,683,684,687],{},[27,677,678],{},"ファイル → サウンドボードをインポート"," で共有パックを読み込みます。パックは ",[42,681,682],{},"project.sninja"," とサウンドファイルを含む ",[42,685,686],{},".zip"," です。インポート後、プロジェクトを開いて再生します。",[13,689,690],{},"複数のプロジェクト（プロファイル）も保てます。プロジェクトセレクターでボードを切り替えます。",[17,692,693],{"id":693},"見つからないファイルを再リンク",[13,695,696,697,700],{},"ディスク上で音声ファイルが移動すると、SoundNinjaは ",[27,698,699],{},"見つからないサウンドファイル"," ダイアログを表示します。検索するフォルダを選び、クリップを再リンクします。",[17,702,703],{"id":703},"次へ",[13,705,706,707,545],{},"タブ、タグ、フィルター、ホットキーの整理は",[68,708,709],{"href":349},"サウンドの整理",{"title":224,"searchDepth":225,"depth":225,"links":711},[712,713,714,715,716,717],{"id":596,"depth":225,"text":596},{"id":617,"depth":225,"text":617},{"id":651,"depth":225,"text":651},{"id":673,"depth":225,"text":673},{"id":693,"depth":225,"text":693},{"id":703,"depth":225,"text":703},"音声、フォルダ、録音、共有サウンドボードをインポート。",{},3,"\u002Fadding-sounds",{"title":586,"description":718},"adding-sounds","5_cjd2COcPz0pj4ZrBehCZv6ouzBimE8UGjkcfngQjw",{"id":726,"title":709,"body":727,"description":1109,"extension":233,"meta":1110,"navigation":235,"order":1111,"path":1112,"seo":1113,"stem":1114,"__hash__":1115},"content_ja\u002Forganizing-sounds.md",{"type":7,"value":728,"toc":1094},[729,731,738,741,766,773,776,779,793,800,806,810,820,824,854,857,863,866,900,907,911,914,940,943,947,960,963,968,989,1005,1012,1015,1026,1029,1033,1040,1050,1056,1059,1067,1074,1091],[10,730,709],{"id":709},[13,732,733,734,737],{},"SoundNinjaは大規模ライブラリ向けです。",[27,735,736],{},"タグとフィルター","、タブ、検索、複数選択、ホットキーで、必要なクリップをワンクリック（またはワンキー）で出せます。",[17,739,740],{"id":740},"タブ",[103,742,743,749,755],{},[24,744,745,748],{},[27,746,747],{},"タブを追加"," でタブを作り、色を付けてバーをすばやく眺められます。",[24,750,751,754],{},[27,752,753],{},"すべて"," ビューはタブを横断して全サウンドを表示します。",[24,756,757,758,761,762,765],{},"サウンドは ",[27,759,760],{},"1つ以上のタブ"," に所属できます。サウンドを右クリックし、",[27,763,764],{},"タブへ移動"," で割り当てます。",[13,767,768,769,772],{},"タブの切り替え演出は ",[27,770,771],{},"設定 → メイン","：スライド、フェード、ボタンを1つずつ、またはなし。",[17,774,775],{"id":775},"グループ",[13,777,778],{},"v0.5.3以降、セパレーターを名前付きグループにできます：",[103,780,781,784,787,790],{},[24,782,783],{},"コンテキストメニューからグループの追加、名前変更、削除",[24,785,786],{},"グループヘッダーをドラッグ — 子も一緒に動く",[24,788,789],{},"グループにサウンドを入れたり出したり",[24,791,792],{},"グループの枠線色、名前の色、ボタン配置を設定（またはタブのデフォルトを使う）",[13,794,795,796,799],{},"見た目の区切りだけなら、通常の ",[27,797,798],{},"セパレーター"," も追加できます。",[13,801,802,803,545],{},"ボードの空き領域を右クリックして ",[27,804,805],{},"グループを追加",[17,807,809],{"id":808},"タグ-フィルター","タグ \u002F フィルター",[13,811,812,813,816,817,819],{},"タグはタブを横断します。スライドアウトの ",[27,814,815],{},"フィルター"," パネル（サイドバー ",[27,818,815],{},"）で作成し、ボードを絞ります。",[821,822,823],"h3",{"id":823},"タグの作成と編集",[21,825,826,832,842,848],{},[24,827,828,829,831],{},"サイドバーで ",[27,830,815],{}," を開く。",[24,833,834,837,838,841],{},[27,835,836],{},"タグ"," の ",[27,839,840],{},"タグを追加"," — 名前と色を付ける。",[24,843,844,845,545],{},"同じリストで名前変更、色変更、",[27,846,847],{},"タグを削除",[24,849,850,853],{},[27,851,852],{},"タグはまだありません"," と出たら、割り当てる前にここで追加する。",[821,855,856],{"id":856},"サウンドにタグを付ける",[13,858,859,860,862],{},"サウンドを右クリック → ",[27,861,836],{},"（チェックボックス）。1つのサウンドに複数可。タグが無い場合、メニューはフィルターパネルへ案内します。",[821,864,865],{"id":865},"ボードをフィルター",[103,867,868,875,886,897],{},[24,869,870,871,874],{},"フィルターパネル、または ",[27,872,873],{},"検索バー下のチップ"," でタグを切り替え。",[24,876,877,878,881,882,885],{},"一致は ",[27,879,880],{},"OR","：選択したタグの ",[27,883,884],{},"いずれか"," を持つサウンドが表示される。",[24,887,888,889,892,893,896],{},"ナビバーの ",[27,890,891],{},"検索"," は有効なタグフィルターと ",[27,894,895],{},"AND","（入力 + タグ）。",[24,898,899],{},"チップをオフ（またはフィルター解除）でタブ全体を再表示。",[13,901,902,903,906],{},"色付きタグ名をボタンに表示できます。",[27,904,905],{},"設定 → 動作 → タグバッジを表示"," で切り替え。",[17,908,910],{"id":909},"並べ替えソート","並べ替え（ソート）",[13,912,913],{},"フィルターパネルでソートモードを選びます：",[103,915,916,922],{},[24,917,918,921],{},[27,919,920],{},"ユーザー定義"," — タブ順、グループ表示",[24,923,924,467,927,467,930,467,933,936,937],{},[27,925,926],{},"名前",[27,928,929],{},"追加日時",[27,931,932],{},"再生時間",[27,934,935],{},"ファイルサイズ"," — フラットなソート一覧。これらのモードでは ",[27,938,939],{},"グループは非表示",[13,941,942],{},"再生時間ソートは、初回に長さのメタデータを準備することがあります。",[17,944,946],{"id":945},"並べ替えドラッグ","並べ替え（ドラッグ）",[13,948,949,952,953,956,957,959],{},[27,950,951],{},"設定 → 動作"," でドラッグ＆ドロップをオンにします（",[27,954,955],{},"並べ替えを許可","）。その後、サウンドとグループをドラッグして配置します。ドラッグ並べ替えは ",[27,958,920],{}," ソートで有効です。",[17,961,962],{"id":962},"複数選択",[13,964,888,965,967],{},[27,966,962],{}," をオンにして：",[103,969,970,973,979,986],{},[24,971,972],{},"クリックでサウンドをトグル",[24,974,975,978],{},[27,976,977],{},"Shift+クリック"," で直前のアンカーから範囲選択",[24,980,981,982,985],{},"空きボード上で ",[27,983,984],{},"マーキー"," をドラッグ",[24,987,988],{},"空きボード（または外側）をクリックして選択解除",[13,990,991,992,467,995,467,998,467,1001,1004],{},"一括バーに件数が表示され、",[27,993,994],{},"色",[27,996,997],{},"タブへ移動…",[27,999,1000],{},"削除",[27,1002,1003],{},"完了"," が使えます。",[13,1006,1007,1008,1011],{},"複数選択中、各ボタンに ",[27,1009,1010],{},"8文字のIDチップ"," が出ます。チップを右クリックでコピー。",[17,1013,1014],{"id":1014},"サウンドごとの音量",[13,1016,1017,1018,1021,1022,1025],{},"右クリック → ",[27,1019,1020],{},"音量","。スライダーを 0%〜100%。",[27,1023,1024],{},"ダブルクリック"," で 100% にリセット。",[13,1027,1028],{},"設定のマスター出力音量と重ねて効きます。",[17,1030,1032],{"id":1031},"ホットキーとサウンドid","ホットキーとサウンドID",[13,1034,1035,1036,1039],{},"すべてのサウンドには8文字のIDがあります。ボタンのコンテキストメニュー（",[27,1037,1038],{},"IDをコピー","）、または複数選択のIDチップからコピーします。",[13,1041,1042,1045,1046,1049],{},[27,1043,1044],{},"設定 → ホットキー"," を開き、キーをサウンドIDに割り当てます。グローバルホットキーは任意です。コンテキストメニューの ",[27,1047,1048],{},"ホットキーを割り当て"," は、IDを埋めた状態でそこにジャンプします。",[13,1051,1052,1053,1055],{},"同じIDを",[68,1054,62],{"href":308},"がクリップのトリガーに使います。",[17,1057,1058],{"id":1058},"背景画像と色",[13,1060,1061,1062,1066],{},"サウンドを右クリックして、ボタンごとの色や背景画像を設定します。ボード全体を整える",[68,1063,1065],{"href":1064},"\u002Fdocs\u002Ftheme-editor","Theme Creator","とは別です。",[13,1068,1069,1070,1073],{},"ピッカーは ",[27,1071,1072],{},"背景画像"," ダイアログ（PNG、JPEG、GIF、WebP）：",[103,1075,1076,1082],{},[24,1077,1078,1081],{},[27,1079,1080],{},"ローカルファイル"," — フォルダ追加、単一ファイル選択、ファイル名検索、グリッドプレビュー、ライブラリからフォルダ削除",[24,1083,1084,1087,1088,1090],{},[27,1085,1086],{},"KLIPY"," — オンラインGIFを検索。APIキーは ",[27,1089,951],{},"。キーはプロジェクトファイルには保存されません。",[13,1092,1093],{},"画像を選んだあと、ボタン上でパンとクロップできます。",{"title":224,"searchDepth":225,"depth":225,"links":1095},[1096,1097,1098,1103,1104,1105,1106,1107,1108],{"id":740,"depth":225,"text":740},{"id":775,"depth":225,"text":775},{"id":808,"depth":225,"text":809,"children":1099},[1100,1101,1102],{"id":823,"depth":720,"text":823},{"id":856,"depth":720,"text":856},{"id":865,"depth":720,"text":865},{"id":909,"depth":225,"text":910},{"id":945,"depth":225,"text":946},{"id":962,"depth":225,"text":962},{"id":1014,"depth":225,"text":1014},{"id":1031,"depth":225,"text":1032},{"id":1058,"depth":225,"text":1058},"タグ、フィルター、タブ、グループ、並べ替え、複数選択、音量、ホットキー。",{},4,"\u002Forganizing-sounds",{"title":709,"description":1109},"organizing-sounds","PGqVreiuZb1jRxkXIW9tv66PvwPYs2iRx5-4j_D8sho",{"id":1117,"title":1118,"body":1119,"description":1240,"extension":233,"meta":1241,"navigation":235,"order":1242,"path":1243,"seo":1244,"stem":1245,"__hash__":1246},"content_ja\u002Ftheme-editor.md","テーマエディター",{"type":7,"value":1120,"toc":1234},[1121,1123,1130,1134,1160,1163,1166,1180,1183,1209,1212,1215,1220],[10,1122,1118],{"id":1118},[13,1124,1125,1126,1129],{},"Theme Creatorは、ボードの完全なビジュアルエディターです。",[27,1127,1128],{},"設定 → メイン → Theme Creator"," から開きます。",[17,1131,1133],{"id":1132},"_3つのタブ","3つのタブ",[21,1135,1136,1149,1155],{},[24,1137,1138,1141,1142,146,1145,1148],{},[27,1139,1140],{},"一般"," — テーマ名、共有色、フォントのアップロード（",[42,1143,1144],{},".ttf",[42,1146,1147],{},".otf","）",[24,1150,1151,1154],{},[27,1152,1153],{},"ボタン"," — サウンドボタンの色、書体、レイアウト、GIFオーバーレイ",[24,1156,1157,1159],{},[27,1158,740],{}," — タブバーの色、書体、枠線の太さ",[13,1161,1162],{},"編集中、ライブプレビューがタブとボタンを表示します。",[17,1164,1165],{"id":1165},"変更できる項目",[103,1167,1168,1171,1174,1177],{},[24,1169,1170],{},"プライマリとアクセントの色、背景、ボタン色、タブ色",[24,1172,1173],{},"ボタンとタブのフォントファミリーとサイズ",[24,1175,1176],{},"ボタンの幅、半径、枠線幅、隙間、パディング",[24,1178,1179],{},"GIFオーバーレイの不透明度（通常とホバー）",[17,1181,1182],{"id":1182},"保存と共有",[103,1184,1185,1191,1197,1203],{},[24,1186,1187,1190],{},[27,1188,1189],{},".cssをエクスポート"," — バックアップや友人への送信用テーマファイルを書き出す",[24,1192,1193,1196],{},[27,1194,1195],{},"テーマに追加"," — Themesフォルダに保存して適用",[24,1198,1199,1202],{},[27,1200,1201],{},".cssをインポート"," — 組み込みプリセットまたは保存済みテーマを読み込む",[24,1204,1205,1208],{},[27,1206,1207],{},"リセット"," — SoundNinjaのデフォルトに戻す",[13,1210,1211],{},"未保存の変更があるままウィンドウを閉じると、SoundNinjaが先に保存を求めます。",[17,1213,1214],{"id":1214},"フルエディターなしで",[13,1216,1217,1219],{},[27,1218,771],{}," でも次が可能です：",[103,1221,1222,1225,1231],{},[24,1223,1224],{},"リストからテーマを選ぶ",[24,1226,1227,1228,1148],{},"CSS変数をライブ編集する（",[27,1229,1230],{},"カスタムCSS",[24,1232,1233],{},"テーマファイルをThemesフォルダにインポートする",{"title":224,"searchDepth":225,"depth":225,"links":1235},[1236,1237,1238,1239],{"id":1132,"depth":225,"text":1133},{"id":1165,"depth":225,"text":1165},{"id":1182,"depth":225,"text":1182},{"id":1214,"depth":225,"text":1214},"Theme Creatorで色、フォント、ボタン、タブをデザイン。",{},5,"\u002Ftheme-editor",{"title":1118,"description":1240},"theme-editor","tGeQE8HatAeqLeJ_3U4A-ac0RfIRzcoq-KghedjPolg",{"id":1248,"title":1249,"body":1250,"description":1381,"extension":233,"meta":1382,"navigation":235,"order":1383,"path":1384,"seo":1385,"stem":1386,"__hash__":1387},"content_ja\u002Frecording-editor.md","録音エディター",{"type":7,"value":1251,"toc":1375},[1252,1254,1260,1263,1269,1289