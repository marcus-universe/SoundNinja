4,"__hash__":1345},"content_ja\u002Fsupport.md","サポート",{"type":7,"value":1255,"toc":1332},[1256,1258,1261,1264,1267,1274,1282,1285,1292,1294,1307,1310,1322,1325],[10,1257,1253],{"id":1253},[13,1259,1260],{},"SoundNinjaは初期ベータのコミュニティプロジェクトです。いちばん早い助けはGitHubです。",[17,1262,1263],{"id":1263},"バグ報告または質問",[13,1265,1266],{},"GitHubでissueを開いてください：",[13,1268,1269],{},[68,1270,1273],{"href":1271,"rel":1272},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fissues",[72],"github.com\u002Fmarcus-universe\u002FSoundNinja\u002Fissues",[13,1275,1276,1277,387,1279,1281],{},"OS、SoundNinjaのバージョン（",[27,1278,468],{},[27,1280,54],{},"）、再現手順を書いてください。",[17,1283,1284],{"id":1284},"メール",[13,1286,1287,1288],{},"メンテナー連絡先：",[68,1289,1291],{"href":1290},"mailto:contact@marcus-universe.de","contact@marcus-universe.de",[17,1293,462],{"id":462},[13,1295,465,1296,1298,1299,1301,1302,1306],{},[27,1297,468],{}," を使います。新しいビルドは",[68,1300,367],{"href":366},"と",[68,1303,373],{"href":1304,"rel":1305},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Freleases",[72],"にも出ます。",[17,1308,1309],{"id":1309},"コントリビュート",[13,1311,1312,1313,1317,1318,1321],{},"プルリクエストを歓迎します。アプリのリポジトリは",[68,1314,1316],{"href":478,"rel":1315},[72],"github.com\u002Fmarcus-universe\u002FSoundNinja","です。プロジェクトは",[68,1319,317],{"href":315,"rel":1320},[72],"ライセンスです。",[17,1323,1324],{"id":1324},"法的情報",[13,1326,1327,1328,533],{},"インプリントと連絡先：",[68,1329,1331],{"href":1330},"\u002Fimpressum","インプリント",{"title":224,"searchDepth":225,"depth":225,"links":1333},[1334,1335,1336,1337,1338],{"id":1263,"depth":225,"text":1263},{"id":1284,"depth":225,"text":1284},{"id":462,"depth":225,"text":462},{"id":1309,"depth":225,"text":1309},{"id":1324,"depth":225,"text":1324},"ヘルプの入手先とバグ報告。",{},8,"\u002Fsupport",{"title":1253,"description":1339},"support","T2BdU-sWENDKBxowzv9wjeevj1bEK3iit1IGD77Vz_M",1788386868355]