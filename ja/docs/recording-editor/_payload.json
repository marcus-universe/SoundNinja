488,"path":1489,"seo":1490,"stem":1491,"__hash__":1492},"content_ja\u002Fremote-control.md","リモートコントロール",{"type":7,"value":1276,"toc":1479},[1277,1279,1282,1285,1317,1320,1323,1357,1360,1380,1383,1386,1418,1422,1428],[10,1278,1274],{"id":1274},[13,1280,1281],{},"SoundNinjaはローカルネットワークで待ち受け、Bitfocus Companion（または任意のHTTP\u002FWebSocketクライアント）がサウンドを再生・停止できます。",[22,1283,1284],{"id":1284},"リモートサーバーを有効化",[89,1286,1287,1293,1300,1307],{},[35,1288,1289,1292],{},[17,1290,1291],{},"設定 → リモート"," を開きます。",[35,1294,1295,1296,1299],{},"リモートサーバーを有効にします。デフォルトポートは ",[17,1297,1298],{},"7331"," です。",[35,1301,1302,1303,1306],{},"任意：トークンを設定。クライアントはBearerトークンまたは ",[139,1304,1305],{},"?token="," で送ります。",[35,1308,1309,1312,1313,1316],{},[139,1310,1311],{},"http:\u002F\u002FIP:PORT"," URLをコピーするか、",[17,1314,1315],{},"設定 → 情報"," からシステムIPをコピーします。",[13,1318,1319],{},"Windowsはサーバー初回起動時にファイアウォールの確認を出すことがあります。プライベートネットワークのアクセスを許可してください。",[22,1321,233],{"id":1322},"bitfocus-companion",[89,1324,1325,1332,1340,1351],{},[35,1326,1327,1331],{},[230,1328,233],{"href":1329,"rel":1330},"https:\u002F\u002Fbitfocus.io\u002Fcompanion",[251],"をインストールします。",[35,1333,1334,1339],{},[230,1335,1338],{"href":1336,"rel":1337},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002Fcompanion-module-soundninja\u002Freleases\u002Flatest",[251],"SoundNinja-Companion.tgz"," をダウンロード。Companion Storeのパッケージはまだありません。",[35,1341,1342,1343,1346,1347,1350],{},"Companionで ",[17,1344,1345],{},"Modules → Load module package"," を開き、",[139,1348,1349],{},".tgz"," を選びます。",[35,1352,1353,1356],{},[17,1354,1355],{},"Sound Ninja"," 接続を追加。PCのIP、ポート、設定したトークンを貼り付けます。",[22,1358,1359],{"id":1359},"アクション",[32,1361,1362,1368,1374],{},[35,1363,1364,1367],{},[17,1365,1366],{},"Trigger Sound"," — ライブドロップダウンから選ぶか、8文字のサウンドIDを入力（Companion変数が使えます）",[35,1369,1370,1373],{},[17,1371,1372],{},"Stop Sound"," — IDで再生中のサウンドを1つ停止",[35,1375,1376,1379],{},[17,1377,1378],{},"Stop All"," — 再生中の全サウンドを停止",[13,1381,1382],{},"SoundNinjaでは、ボタンのコンテキストメニューまたは複数選択のIDチップからサウンドIDをコピーします。",[22,1384,1385],{"id":1385},"フィードバックと変数",[32,1387,1388,1394,1406,1412],{},[35,1389,1390,1393],{},[17,1391,1392],{},"Sound Playing"," — そのサウンドIDがアクティブな間はtrue（ボタン色に使う）",[35,1395,1396,1399,1400,142,1403],{},[139,1397,1398],{},"$(soundninja:connected)"," — ",[139,1401,1402],{},"true",[139,1404,1405],{},"false",[35,1407,1408,1411],{},[139,1409,1410],{},"$(soundninja:playing_count)"," — 再生中のサウンド数",[35,1413,1414,1417],{},[139,1415,1416],{},"$(soundninja:last_triggered)"," — 最後にトリガーしたサウンドID",[22,1419,1421],{"id":1420},"http-api上級","HTTP API（上級）",[13,1423,1424,1425],{},"ベースパス：",[139,1426,1427],{},"\u002Fapi\u002Fv1",[32,1429,1430,1436,1442,1448,1458,1464,1473],{},[35,1431,1432,1435],{},[139,1433,1434],{},"GET \u002Finfo"," — アプリ名、バージョン、プロトコル、トークンが必要か",[35,1437,1438,1441],{},[139,1439,1440],{},"GET \u002Fsounds"," — サウンド一覧（id、name、tabs、active）",[35,1443,1444,1447],{},[139,1445,1446],{},"GET \u002Fstate"," — サウンドと現在再生中のID",[35,1449,1450,1453,1454,1457],{},[139,1451,1452],{},"POST \u002Ftrigger"," に ",[139,1455,1456],{},"{ \"id\" }"," — サウンドを再生",[35,1459,1460,1463],{},[139,1461,1462],{},"GET \u002Ftrigger\u002F:id"," — 再生（ブラウザで簡単にテスト）",[35,1465,1466,1469,1470,1472],{},[139,1467,1468],{},"POST \u002Fstop"," に任意の ",[139,1471,1456],{}," — 1つまたはすべて停止",[35,1474,1475,1478],{},[139,1476,1477],{},"GET \u002Fws"," — ライブ状態。trigger\u002Fstopコマンドを受信",{"title":148,"searchDepth":149,"depth":149,"links":1480},[1481,1482,1483,1484,1485],{"id":1284,"depth":149,"text":1284},{"id":1322,"depth":149,"text":233},{"id":1359,"depth":149,"text":1359},{"id":1385,"depth":149,"text":1385},{"id":1420,"depth":149,"text":1421},"ローカルネットワーク経由でBitfocus CompanionからSoundNinjaを操作。",{},7,"\u002Fremote-control",{"title":1274,"description":1486},"remote-control","mPFqlRPL-jxRSpdtuwlQQcHhnmsyzKrKdjplGWwWueU",{"id":1494,"title":1495,"body":1496,"description":1581,"extension":156,"meta":1582,"navigation":158,"order":1583,"path":1584,"seo":1585,"stem":1586,"__hash__":1587},"content_ja\u002Fsupport.md","サポート",{"