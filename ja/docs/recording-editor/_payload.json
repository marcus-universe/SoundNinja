5],{},"tauri:build:stems","）。",{"title":148,"searchDepth":149,"depth":149,"links":150},"",2,[151,152,153,154],{"id":24,"depth":149,"text":24},{"id":58,"depth":149,"text":58},{"id":87,"depth":149,"text":87},{"id":108,"depth":149,"text":109},"マイクまたはPCオーディオを取り込み、クリップを編集してボードに置く。","md",{},true,6,"\u002Frecording-editor",{"title":5,"description":155},"recording-editor","7_RI-WNd1luOVgn5vTAoyTmO8dKVtHVwkffwMt4LBQc",[165,290,508,645,1046,1177,1272,1493],{"id":166,"title":167,"body":168,"description":283,"extension":156,"meta":284,"navigation":158,"order":285,"path":286,"seo":287,"stem":288,"__hash__":289},"content_ja\u002Foverview.md","概要",{"type":7,"value":169,"toc":277},[170,172,175,178,181,184,198,201,241,244,254,257],[10,171,167],{"id":167},[13,173,174],{},"SoundNinjaは、ライブ配信、友だちとのチャット、ポッドキャスト収録向けのオープンソースサウンドボードです。Tauri v2とNuxt 4で構築されており、RAMとディスクの負荷を抑えています。",[13,176,177],{},"目標はシンプルです。巨大なサウンドライブラリをすばやく眺め、目的のクリップをミリ秒で再生すること。UIはVRのダッシュボードとしても使いやすいです。",[13,179,180],{},"SoundNinjaはまだ初期開発段階です。機能は動きますが、すべてのプラットフォームで完全に検証されているわけではありません。",[22,182,183],{"id":183},"対象ユーザー",[32,185,186,189,192,195],{},[35,187,188],{},"即時のサウンドキューが必要な配信者",[35,190,191],{},"ボイスチャット用の共有ボードが欲しい友だち",[35,193,194],{},"クリップを録ってボードに置くポッドキャスター",[35,196,197],{},"カスタマイズ可能な、ローカル優先のサウンドボードが欲しい人",[22,199,200],{"id":200},"できること",[32,202,203,206,209,212,215,218,221,224,227,235,238],{},[35,204,205],{},"自分の音声ファイルからサウンドボードを作る",[35,207,208],{},"色付きタブ、グループ、タグ、検索で整理する",[35,210,211],{},"タグでフィルター（OR）、名前・日付・長さ・サイズでソート",[35,213,214],{},"マーキーまたはShift範囲で複数選択し、色・移動・削除を一括",[35,216,217],{},"コンテキストメニューでサウンドごとの音量を設定",[35,219,220],{},"Theme Creatorで見た目をデザインする",[35,222,223],{},"Record EditorでPCオーディオまたはマイクを録音する",[35,225,226],{},"個別のサウンドにホットキーを割り当てる",[35,228,229,234],{},[230,231,233],"a",{"href":232},"\u002Fdocs\u002Fremote-control","Bitfocus Companion","からサウンドをトリガーする",[35,236,237],{},"サウンドボード全体をインポート／エクスポートして共有する",[35,239,240],{},"サウンドボタンにGIFや画像を使う — ローカルフォルダライブラリ、GifSnap、またはKLIPY",[22,242,243],{"id":243},"ライセンス",[13,245,246,247,253],{