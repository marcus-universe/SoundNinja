752,762,768],{},[35,747,748,749,751],{},"サイドバーで ",[17,750,735],{}," を開く。",[35,753,754,757,758,761],{},[17,755,756],{},"タグ"," の ",[17,759,760],{},"タグを追加"," — 名前と色を付ける。",[35,763,764,765,130],{},"同じリストで名前変更、色変更、",[17,766,767],{},"タグを削除",[35,769,770,773],{},[17,771,772],{},"タグはまだありません"," と出たら、割り当てる前にここで追加する。",[741,775,776],{"id":776},"サウンドにタグを付ける",[13,778,779,780,782],{},"サウンドを右クリック → ",[17,781,756],{},"（チェックボックス）。1つのサウンドに複数可。タグが無い場合、メニューはフィルターパネルへ案内します。",[741,784,785],{"id":785},"ボードをフィルター",[32,787,788,795,806,817],{},[35,789,790,791,794],{},"フィルターパネル、または ",[17,792,793],{},"検索バー下のチップ"," でタグを切り替え。",[35,796,797,798,801,802,805],{},"一致は ",[17,799,800],{},"OR","：選択したタグの ",[17,803,804],{},"いずれか"," を持つサウンドが表示される。",[35,807,808,809,812,813,816],{},"ナビバーの ",[17,810,811],{},"検索"," は有効なタグフィルターと ",[17,814,815],{},"AND","（入力 + タグ）。",[35,818,819],{},"チップをオフ（またはフィルター解除）でタブ全体を再表示。",[13,821,822,823,826],{},"色付きタグ名をボタンに表示できます。",[17,824,825],{},"設定 → 動作 → タグバッジを表示"," で切り替え。",[22,828,830],{"id":829},"並べ替えソート","並べ替え（ソート）",[13,832,833],{},"フィルターパネルでソートモードを選びます：",[32,835,836,842],{},[35,837,838,841],{},[17,839,840],{},"ユーザー定義"," — タブ順、グループ表示",[35,843,844,392,847,392,850,392,853,856,857],{},[17,845,846],{},"名前",[17,848,849],{},"追加日時",[17,851,852],{},"再生時間",[17,854,855],{},"ファイルサイズ"," — フラットなソート一覧。これらのモードでは ",[17,858,859],{},"グループは非表示",[13,861,862],{},"再生時間ソートは、初回に長さのメタデータを準備することがあります。",[22,864,866],{"id":865},"並べ替えドラッグ","並べ替え（ドラッグ）",[13,868,869,872,873,876,877,879],{},[17,870,871],{},"設定 → 動作"," でドラッグ＆ドロップをオンにします（",[17,874,875],{},"並べ替えを許可","）。その後、サウンドとグループをドラッグして配置します。ドラッグ並べ替えは ",[17,878,840],{}," ソートで有効です。",[22,881,882],{"id":882},"複数選択",[13,884,808,885,887],{},[17,886,882],{}," をオンにして：",[32,889,890,893,899,906],{},[35,891,892],{},"クリックでサウンドをトグル",[35,894,895,898],{},[17,896,897],{},"Shift+クリック"," で直前のアンカーから範囲選択",[35,900,901,902,905],{},"空きボード上で ",[17,903,904],{},"マーキー"," をドラッグ",[35,907,908],{},"空きボード（または外側）をクリックして選択解除",[13,910,911,912,392,915,392,918,392,921,924],{},"一括バーに件数が表示され、",[17,913,914],{},"色",[17,916,917],{},"タブへ移動…",[17,919,920],{},"削除",[17,922,923],{},"完了"," が使えます。",[13,926,927,928,931],{},"複数選択中、各ボタンに ",[17,929,930],{},"8文字のIDチップ"," が出ます。チップを右クリックでコピー。",[22,933,934],{"id":934},"サウンドごとの音量",[13,936,937,938,941,942,945],{},"右クリック → ",[17,939,940],{},"音量","。スライダーを 0%〜100%。",[17,943,944],{},"ダブルクリック"," で 100% にリセット。",[13,947,948],{},"設定のマスター出力音量と重ねて効きます。",[22,950,952],{"id":951},"ホットキーとサウンドid","ホットキーとサウンドID",[13,954,955,956,959],{},"すべてのサウンドには8文字のIDがあります。ボタンのコンテキストメニュー（",[17,957,958],{},"IDをコピー","）、または複数選択のIDチップからコピーします。",[13,961,962,965,966,969],{},[17,963,964],{},"設定 → ホットキー"," を開き、キーをサウンドIDに割り当てます。グローバルホットキーは任意です。コンテキストメニューの ",[17,967,968],{},"ホットキーを割り当て"," は、IDを埋めた状態でそこにジャンプします。",[13,971,972,973,975],{},"同じIDを",[230,974,233],{"href":232},"がクリップのトリガーに使います。",[22,977,978],{"id":978},"背景画像と色",[13,980,981,982,986],{},"サウンドを右クリックして、ボタンごとの色や背景画像を設定します。ボード全体を整える",[230,983,985],{"href":984},"\u002Fdocs\u002Ftheme-editor","Theme Creator","とは別です。",[13,988,989,990,993],{},"ピッカーは ",[17,991,992],{},"背景画像"," ダイアログ（PNG、JPEG、GIF、WebP）：",[32,995,996,1002,1012],{},[35,997,998,1001],{},[17,999,1000],{},"ローカルファイル"," — フォルダ追加、単一ファイル選択、ファイル名検索、グリッドプレビュー、ライブラリからフォルダ削除",[35,1003,1004,1007,1008],{},[17,1005,1006],{},"GifSnap"," — APIキーなしでオンラインGIFを検索。初回は GifSnap へのリクエスト許可を求めます。検索結果はキャッシュして通信を減らします。",[230,1009,1006],{"href":1010,"rel":1011},"https:\u002F\u002Fgifsnap.com",[251],[35,1013,1014,1017,1018,1020],{},[17,1015,1016],{},"KLIPY"," — オンラインGIFを検索。APIキーは ",[17,1019,871],{},"。キーはプロジェクトファイルには保存されません。",[13,1022,1023],{},"画像を選んだあと、ボタン上でパンとクロップできます。",{"title":148,"searchDepth":149,"depth":149,"links":1025},[1026,1027,1028,1033,1034,1035,1036,1037,1038],{"id":660,"depth":149,"text":660},{"id":695,"depth":149,"text":695},{"id":728,"depth":149,"text":729,"children":1029},[1030,1031,1032],{"id":743,"depth":640,"text":743},{"id":776,"depth":640,"text":776},{"id":785,"depth":640,"text":785},{"id":829,"depth":149,"text":830},{"id":865,"depth":149,"text":866},{"id":882,"depth"