ポート"," を使います。",[35,513,514],{},"1つ以上の音声ファイルを選びます。",[35,516,517],{},"サウンドは現在のタブに入ります。",[22,519,520],{"id":520},"フォルダをインポート",[89,522,523,531,534],{},[35,524,525,528,529,146],{},[17,526,527],{},"ファイル → フォルダをインポート","（またはナビバーの ",[17,530,520],{},[35,532,533],{},"1つ以上のフォルダを追加。インポート前にドラッグで並べ替えできます。",[35,535,536,537],{},"配置方法を選びます：\n",[32,538,539,545],{},[35,540,541,544],{},[17,542,543],{},"タブとしてインポート"," — 各フォルダが独自のタブになる",[35,546,547,550],{},[17,548,549],{},"現在のタブにインポート"," — すべてのファイルがアクティブなタブに入る",[22,552,553],{"id":553},"クリップを録音",[13,555,556,557,559,560,564,565,72,567,569],{},"プレイヤーバーの ",[17,558,19],{}," ボタンから",[230,561,563],{"href":562},"\u002Fdocs\u002Frecording-editor","Record Editor","を開きます。キャプチャ、トリムし、",[17,566,101],{},[17,568,104],{}," で現在のタブまたは選んだタブに入れます。",[22,571,572],{"id":572},"サウンドボードをインポート",[13,574,575,578,579,582,583,586],{},[17,576,577],{},"ファイル → サウンドボードをインポート"," で共有パックを読み込みます。パックは ",[139,580,581],{},"project.sninja"," とサウンドファイルを含む ",[139,584,585],{},".zip"," です。インポート後、プロジェクトを開いて再生します。",[13,588,589],{},"複数のプロジェクト（プロファイル）も保てます。プロジェクトセレクターでボードを切り替えます。",[22,591,592],{"id":592},"見つからないファイルを再リンク",[13,594,595,596,599],{},"ディスク上で音声ファイルが移動すると、SoundNinjaは ",[17,597,598],{},"見つからないサウンドファイル"," ダイアログを表示します。検索するフォルダを選び、クリップを再リンクします。",[22,601,602],{"id":602},"次へ",[13,604,605,606,130],{},"タブ、タグ、フィルター、ホットキーの整理は",[230,607,608],{"href":275},"サウンドの整理",{"title":148,"searchDepth":149,"depth":149,"links":610},[611,612,613,614,615,616],{"id":499,"depth":149,"text":499},{"id":520,"depth":149,"text":520},{"id":553,"depth":149,"text":553},{"id":572,"depth":149,"text":572},{"id":592,"depth":149,"text":592},{"id":602,"depth":149,"text":602},"音声、フォルダ、録音、共有サウンドボードをインポート。",{},3,"\u002Fadding-sounds",{"title":489,"description":617},"adding-sounds","5_cjd2COcPz0pj4ZrBehCZv6ouzBimE8UGjkcfngQjw",{"id":625,"title":608,"body":626,"description":1008,"extension":156,"meta":1009,"navigation":158,"order":1010,"path":1011,"seo":1012,"stem":1013,"__hash__":1014},"content_ja\u002Forganizing-sounds.md",{"type":7,"value":627,"toc":993},[628,630,637,640,665,672,675,678,692,699,705,709,719,723,753,756,762,765,799,806,810,813,839,842,846,859,862,867,888,904,911,914,925,928,932,939,949,955,958,966,973,990],[10,629,608],{"id":608},[13,631,632,633,636],{},"SoundNinjaは大規模ライブラリ向けです。",[17,634,635],{},"タグとフィルター","、タブ、検索、複数選択、ホットキーで、必要なクリップをワンクリック（またはワンキー）で出せます。",[22,638,639],{"id":639},"タブ",[32,641,642,648,654],{},[35,643,644,647],{},[17,645,646],{},"タブを追加"," でタブを作り、色を付けてバーをすばやく眺められます。",[35,649,650,653],{},[17,651,652],{},"すべて"," ビューはタブを横断して全サウンドを表示します。",[35,655,656,657,660,661,664],{},"サウンドは ",[17,658,659],{},"1つ以上のタブ"," に所属できます。サウンドを右クリックし、",[17,662,663],{},"タブへ移動"," で割り当てます。",[13,666,667,668,671],{},"タブの切り替え演出は ",[17,669,670],{},"設定 → メイン","：スライド、フェード、ボタンを1つずつ、またはなし。",[22,673,674],{"id":674},"グループ",[13,676,677],{},"v0.5.3以降、セパレーターを名前付きグループにできます：",[32,679,680,683,686,689],{},[35,681,682],{},"コンテキストメニューからグループの追加、名前変更、削除",[35,684,685],{},"グループヘッダーをドラッグ — 子も一緒に動く",[35,687,688],{},"グループにサウンドを入れたり出したり",[35,690,691],{},"グループの枠線色、名前の色、ボタン配置を設定（またはタブのデフォルトを使う）",[13,693,694,695,698],{},"見た目の区切りだけなら、通常の ",[17,696,697],{},"セパレーター"," も追加できます。",[13,700,701,702,130],{},"ボードの空き領域を右クリックして ",[17,703,704],{},"グループを追加",[22,706,708],{"id":707},"タグ-フィルター","タグ \u002F フィルター",[13,710,711,712,715,716,718],{},"タグはタブを横断します。スライドアウトの ",[17,713,714],{},"フィルター"," パネル（サイドバー ",[17,717,714],{},"）で作成し、ボードを絞ります。",[720,721,722],"h3",{"id":722},"タグの作成と編集",[89,724,725,731,741,747],{},[35,726,727,728,730],{},"サイドバーで ",[17,729,714],{}," を開く。",[35,732,733,736,737,740],{},[17,734,735],{},"タグ"," の ",[17,738,739],{},"タグを追加"," — 名前と色を付ける。",[35,742,743,744,130],{},"同じリストで名前変更、色変更、",[17,745,746],{},"タグを削除",[35,748,749,752],{},[17,750,751],{},"タグはまだありません"," と出たら、割り当てる前にここで追加する。",[720,754,755],{"id":755},"サウンドにタグを付ける",[13,757,758,759,761],{},"サウンドを右クリック → ",[17,760,735],{},"（チェックボックス）。1つのサウンドに複数可。タグが無い場合、メニューはフィルターパネルへ案内します。",[720,763,764],{"id":764},"ボードをフィルター",[32,766,767,774,785,796],{},[35,768,769,770,773],{},"フィルターパネル、または ",[17,771,772],{},"検索バー下のチップ"," でタグを切り替え。",[35,775,776,777,780,781,784],{},"一致は ",[17,778,779],{},"OR","：選択したタグの ",[17,782,783],{},"いずれか"," を持つサウンドが表示される。",[35,786,787,788,791,792,795],{},"ナビバーの ",[17,789,790],{},"検索"," は有効なタグフィルターと ",[17,793,794],{},"AND","（入力 + タグ）。",[35,797,798],{},"チップをオフ（またはフィルター解除）でタブ全体を再表示。",[13,800,801,802,805],{},"色付きタグ名をボタンに表示できます。",[17,803,804],{},"設定 → 動作 → タグバッジを表示"," で切り替え。",[22,807,809],{"id":808},"並べ替えソート","並べ替え（ソート）",[13,811,812],{},"フィルターパネルでソートモードを選びます：",[32,814,815,821],{},[35,816,817,820],{},[17,818,819],{},"ユーザー定義"," — タブ順、グループ表示",[35,822,823,392,826,392,829,392,832,835,836],{},[17,824,825],{},"名前",[17,827,828],{},"追加日時",[17,830,831],{},"再生時間",[17,833,834],{},"ファイルサイズ"," — フラットなソート一覧。これらのモードでは ",[17,837,838],{},"グループは非表示",[13,840,841],{},"再生時間ソートは、初回に長さのメタデータを準備することがあります。",[22,843,845],{"id":844},"並べ替えドラッグ","並べ替え（ドラッグ）",[13,847,848,851,852,855,856,858],{},[17,849,850],{},"設定 → 動作"," でドラッグ＆ドロップをオンにします（",[17,853,854],{},"並べ替えを許可","）。その後、サウンドとグループをドラッグして配置します。ドラッグ並べ替えは ",[17,857,819],{}," ソートで有効です。",[22,860,861],{"id":861},"複数選択",[13,863,787,864,866],{},[17,865,861],{}," をオンにして：",[32,868,869,872,878,885],{},[35,870,871],{},"クリックでサウンドをトグル",[35,873,874,877],{},[17,875,876],{},"Shift+クリック"," で直前のアンカーから範囲選択",[35,879,880,881,884],{},"空きボード上で ",[17,882,883],{},"マーキー"," をドラッグ",[35,886,887],{},"空きボード（または外側）をクリックして選択解除",[13,889,890,891,392,894,392,897,392,900,903],{},"一括バーに件数が表示され、",[17,892,893],{},"色",[17,895,896],{},"タブへ移動…",[17,898,899],{},"削除",[17,901,902],{},"完了"," が使えます。",[13,905,906,907,910],{},"複数選択中、各ボタンに ",[17,908,909],{},"8文字のIDチップ"," が出ます。チップを右クリックでコピー。",[22,912,913],{"id":913},"サウンドごとの音量",[13,915,916,917,920,921,924],{},"右クリック → ",[17,918,919],{},"音量","。スライダーを 0%〜100%。",[17,922,923],{},"ダブルクリック"," で 100% にリセット。",[13,926,927],{},"設定のマスター出力音量と重ねて効きます。",[22,929,931],{"id":930},"ホットキーとサウンドid","ホットキーとサウンドID",[13,933,934,935,938],{},"すべてのサウンドには8文字のIDがあります。ボタンのコンテキストメニュー（",[17,936,937],{},"IDをコピー","）、または複数選択のIDチップからコピーします。",[13,940,941,944,945,948],{},[17,942,943],{},"設定 → ホットキー"," を開き、キーをサウンドIDに割り当てます。グローバルホットキーは任意です。コンテキストメニューの ",[17,946,947],{},"ホットキーを割り当て"," は、IDを埋めた状態でそこにジャンプします。",[13,950,951,952,954],{},"同じIDを",[230,953,233],{"href":232},"がクリップのトリガーに使います。",[22,956,957],{"id":957},"背景画像と色",[13,959,960,961,965],{},"サウンドを右クリックして、ボタンごとの色や背景画像を設定します。ボード全体を整える",[230,962,964],{"href":963},"\u002Fdocs\u002Ftheme-editor","Theme Creator","とは別です。",[13,967,968,969,972],{},"ピッカーは ",[17,970,971],{},"背景画像"," ダイアログ（PNG、JPEG、GIF、WebP）：",[32,974,975,981],{},[35,976,977,980],{},[17,978,979],{},"ローカルファイル"," — フォルダ追加、単一ファイル選択、ファイル名検索、グリッドプレビュー、ライブラリからフォルダ削除",[35,982,983,986,987,989],{},[17,984,985],{},"KLIPY"," — オンラインGIFを検索。APIキーは ",[17,988,850],{},"。キーはプロジェクトファイルには保存されません。",[13,991,992],{},"画像を選んだあと、ボタン上でパンとクロップできます。",{"title":148,"searchDepth":149,"depth":149,"links":994},[995,996,997,1002,1003,1004,1005,1006,1007],{"id":639,"depth":149,"text":639},{"id":674,"depth":149,"text":674},{"id":707,"depth":149,"text":708,"children":998},[999,1000,1001],{"id":722,"depth":619,"text":722},{"id":755,"depth":619,"text":755},{"id":764,"depth":619,"text":764},{"id":808,"depth":149,"text":809},{"id":844,"depth":149,"text":845},{"id":861,"depth":149,"text":861},{"id":913,"depth":149,"text":913},{"id":930,"depth":149,"text":931},{"id":957,"depth":149,"text":957},"タグ、フィルター、タブ、グループ、並べ替え、複数選択、音量、ホットキー。",{},4,"\u002Forganizing-sounds",{"title":608,"description":1008},"organizing-sounds","PGqVreiuZb1jRxkXIW9tv66PvwPYs2iRx5-4j_D8sho",{"id":1016,"title":1017,"body":1018,"description":1139,"extension":156,"meta":1140,"navigation":158,"order":1141,"path":1142,"seo":1143,"stem":1144,"__hash__":1145},"content_ja\u002Ftheme-editor.md","テーマエディター",{"type":7,"value":1019,"toc":1133},[1020,1022,1029,1033,1059,1062,1065,1079,1082,1108,1111,1114,1119],[10,1021,1017],{"id":1017},[13,1023,1024,1025,1028],{},"Theme Creatorは、ボードの完全なビジュアルエディターです。",[17,1026,1027],{},"設定 → メイン → Theme Creator"," から開きます。",[22,1030,1032],{"id":1031},"_3つのタブ","3つのタブ",[89,1034,1035,1048,1054],{},[35,1036,1037,1040,1041,142,1044,1047],{},[17,1038,1039],{},"一般"," — テーマ名、共有色、フォントのアップロード（",[139,1042,1043],{},".ttf",[139,1045,1046],{},".otf","）",[35,1049,1050,1053],{},[17,1051,1052],{},"ボタン"," — サウンドボタンの色、書体、レイアウト、GIFオーバーレイ",[35,1055,1056,1058],{},[17,1057,639],{}," — タブバーの色、書体、枠線の太さ",[13,1060,1061],{},"編集中、ライブプレビューがタブとボタンを表示します。",[22,1063,1064],{"id":1064},"変更できる項目",[32,1066,1067,1070,1073,1076],{},[35,1068,1069],{},"プライマリとアクセントの色、背景、ボタン色、タブ色",[35,1071,1072],{},"ボタンとタブのフォントファミリーとサイズ",[35,1074,1075],{},"ボタンの幅、半径、枠線幅、隙間、パディング",[35,1077,1078],{},"GIFオーバーレイの不透明度（通常とホバー）",[22,1080,1081],{"id":1081},"保存と共有",[32,1083,1084,1090,1096,1102],{},[35,1085,1086,1089],{},[17,1087,1088],{},".cssをエクスポート"," — バックアップや友人への送信用テーマファイルを書き出す",[35,1091,1092,1095],{},[17,1093,1094],{},"テーマに追加"," — Themesフォルダに保存して適用",[35,1097,1098,1101],{},[17,1099,1100],{},".cssをインポート"," — 組み込みプリセットまたは保存済みテーマを読み込む",[35,1103,1104,1107],{},[17,1105,1106],{},"リセット"," — SoundNinjaのデフォルトに戻す",[13,1109,1110],{},"未保存の変更があるままウィンドウを閉じると、SoundNinjaが先に保存を求めます。",[22,1112,1113],{"id":1113},"フルエディターなしで",[13,1115,1116,1118],{},[17,1117,670],{}," でも次が可能です：",[32,1120,1121,1124,1130],{},[35,1122,1123],{},"リストからテーマを選ぶ",[35,1125,1126,1127,1047],{},"CSS変数をライブ編集する（",[17,1128,1129],{},"カスタムCSS",[35,1131,1132],{},"テーマファイルをThemesフォルダにインポートする",{"title":148,"searchDepth":149,"depth":149,"links":1134},[1135,1136,1137,1138],{"id":1031,"depth":149,"text":1032},{"id":1064,"depth":149,"text":1064},{"id":1081,"depth":149,"text":1081},{"id":1113,"depth":149,"text":1113},"Theme Creatorで色、フォント、ボタン、タブをデザイン。",{},5,"\u002Ftheme-editor",{"title":1017,"description":1139},"theme-editor","tGeQE8HatAeqLeJ_3U4A-ac0RfIRzcoq-KghedjPolg",{"id":4,"title":5,"body":1147,"description":155,"extension":156,"meta":1239,"navigation":158,"order":159,"path":160,"seo":1240,"stem":162,"__hash__":163},{"type":7,"value":1148,"toc":1233},[1149,1151,1155,1157,1161,1175,1177,1179,1197,1199,1211,1213,1221,1227],[10,1150,5],{"id":5},[13,1152,15,1153,20],{},[17,1154,19],{},[22,1156,24],{"id":24},[13,1158,1159,30],{},[17,1160,29],{},[32,1162,1163,1167,1171],{},[35,1164,1165,40],{},[17,1166,39],{},[35,1168,1169,46],{},[17,1170,45],{},[35,1172,1173,52],{},[17,1174,51],{},[13,1176,55],{},[22,1178,58],{"id":58},[32,1180,1181,1183,1185,1191,1193,1195],{},[35,1182,63],{},[35,1184,66],{},[35,1186,1187,72,1189],{},[17,1188,71],{},[17,1190,75],{},[35,1192,78],{},[35,1194,81],{},[35,1196,84],{},[22,1198,87],{"id":87},[89,1200,1201,1203,1205],{},[35,1202,93],{},[35,1204,96],{},[35,1206,1207,72,1209,105],{},[17,1208,101],{},[17,1210,104],{},[22,1212,109],{"id":108},[13,1214,112,1215,116,1217,72,1219,123],{},[17,1216,115],{},[17,1218,119],{},[17,1220,122],{},[13,1222,126,1223,130,1225,134],{},[17,1224,129],{},[17,1226,133],{},[13,1228,137,1229,142,1231,146],{},[139,1230,141],{},[139,1232,145],{},{"title":148,"searchDepth":149,"depth":149,"links":1234},[1235,1236,1237,1238],{"id":24,"depth":149,"text":24},{"id":58,"depth":149,"text":58},{"id":87,"depth":149,"text":87},{"id":108,"depth":149,"text":109},{},{"title":5,"description":155},{"id":1242,"title":1243,"body":1244,"description":1455,"extension":156,"meta":1456,"navigation":158,"order":1457,"path":1458,"seo":1459,"stem":1460,"__hash__":1461},"content_ja\u002Fremote-control.md","リモートコントロール",{"type":7,"value":1245,"toc":1448},[1246,1248,1251,1254,1286,1289,1292,1326,1329,1349,1352,1355,1387,1391,1397],[10,1247,1243],{"id":1243},[13,1249,1250],{},"SoundNinjaはローカルネットワークで待ち受け、Bitfocus Companion（または任意のHTTP\u002FWebSocketクライアント）がサウンドを再生・停止できます。",[22,1252,1253],{"id":1253},"リモートサーバーを有効化",[89,1255,1256,1262,1269,1276],{},[35,1257,1258,1261],{},[17,1259,1260],{},"設定 → リモート"," を開きます。",[35,1263,1264,1265,1268],{},"リモートサーバーを有効にします。デフォルトポートは ",[17,1266,1267],{},"7331"," です。",[35,1270,1271,1272,1275],{},"任意：トークンを設定。クライアントはBearerトークンまたは ",[139,1273,1274],{},"?token="," で送ります。",[35,1277,1278,1281,1282,1285],{},[139,1279,1280],{},"http:\u002F\u002FIP:PORT"," URLをコピーするか、",[17,1283,1284],{},"設定 → 情報"," からシステムIPをコピーします。",[13,1287,1288],{},"Windowsはサーバー初回起動時にファイアウォールの確認を出すことがあります。プライベートネットワークのアクセスを許可してください。",[22,1290,233],{"id":1291},"bitfocus-companion",[89,1293,1294,1301,1309,1320],{},[35,1295,1296,1300],{},[230,1297,233],{"href":1298,"rel":1299},"https:\u002F\u002Fbitfocus.io\u002Fcompanion",[251],"をインストールします。",[35,1302,1303,1308],{},[230,1304,1307],{"href":1305,"rel":1306},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Freleases\u002Flatest\u002Fdownload\u002FSoundNinja-Companion.tgz",[251],"SoundNinja-Companion.tgz"," をダウンロード。Companion Storeのパッケージはまだありません。",[35,1310,1311,1312,1315,1316,1319],{},"Companionで ",[17,1313,1314],{},"Modules → Load module package"," を開き、",[139,1317,1318],{},".tgz"," を選びます。",[35,1321,1322,1325],{},[17,1323,1324],{},"Sound Ninja"," 接続を追加。PCのIP、ポート、設定したトークンを貼り付けます。",[22,1327,1328],{"id":1328},"アクション",[32,1330,1331,1337,1343],{},[35,1332,1333,1336],{},[17,1334,1335],{},"Trigger Sound"," — ライブドロップダウンから選ぶか、8文字のサウンドIDを入力（Companion変数が使えます）",[35,1338,1339,1342],{},[17,1340,1341],{},"Stop Sound"," — IDで再生中のサウンドを1つ停止",[35,1344,1345,1348],{},[17,1346,1347],{},"Stop All"," — 再生中の全サウンドを停止",[13,1350,1351],{},"SoundNinjaでは、ボタンのコンテキストメニューまたは複数選択のIDチップからサウンドIDをコピーします。",[22,1353,1354],{"id":1354},"フィードバックと変数",[32,1356,1357,1363,1375,1381],{},[35,1358,1359,1362],{},[17,1360,1361],{},"Sound Playing"," — そのサウンドIDがアクティブな間はtrue（ボタン色に使う）",[35,1364,1365,1368,1369,142,1372],{},[139,1366,1367],{},"$(soundninja:connected)"," — ",[139,1370,1371],{},"true",[139,1373,1374],{},"false",[35,1376,1377,1380],{},[139,1378,1379],{},"$(soundninja:playing_count)"," — 再生中のサウンド数",[35,1382,1383,1386],{},[139,1384,1385],{},"$(soundninja:last_triggered)"," — 最後にトリガーしたサウンドID",[22,1388,1390],{"id":1389},"http-api上級","HTTP API（上級）",[13,1392,1393,1394],{},"ベースパス：",[139,1395,1396],{},"\u002Fapi\u002Fv1",[32,1398,1399,1405,1411,1417,1427,1433,1442],{},[35,1400,1401,1404],{},[139,1402,1403],{},"GET \u002Finfo"," — アプリ名、バージョン、プロトコル、トークンが必要か",[35,1406,1407,1410],{},[139,1408,1409],{},"GET \u002Fsounds"," — サウンド一覧（id、name、tabs、active）",[35,1412,1413,1416],{},[139,1414,1415],{},"GET \u002Fstate"," — サウンドと現在再生中のID",[35,1418,1419,1422,1423,1426],{},[139,1420,1421],{},"POST \u002Ftrigger"," に ",[139,1424,1425],{},"{ \"id\" }"," — サウンドを再生",[35,1428,1429,1432],{},[139,1430,1431],{},"GET \u002Ftrigger\u002F:id"," — 再生（ブラウザで簡単にテスト）",[35,1434,1435,1438,1439,1441],{},[139,1436,1437],{},"POST \u002Fstop"," に任意の ",[139,1440,1425],{}," — 1つまたはすべて停止",[35,1443,1444,1447],{},[139,1445,1446],{},"GET \u002Fws"," — ライブ状態。trigger\u002Fstopコマンドを受信",{"title":148,"searchDepth":149,"depth":149,"links":1449},[1450,1451,1452,1453,1454],{"id":1253,"depth":149,"text":1253},{"id":1291,"depth":149,"text":233},{"id":1328,"depth":149,"text":1328},{"id":1354,"depth":149,"text":1354},{"id":1389,"depth":149,"text":1390},"ローカルネットワーク経由でBitfocus CompanionからSoundNinjaを操作。",{},7,"\u002Fremote-control",{"title":1243,"description":1455},"remote-control","_6T2WMAtPh7L1pRelAkpGazesfqk5Swk4FcTh5g7BTw",{"id":1463,"title":1464,"body":1465,"description":1550,"extension":156,"meta":1551,"navigation":158,"order":1552,"path":1553,"seo":1554,"stem":1555,"__hash__":1556},"content_ja\u002Fsupport.md","サポート",{"type":7,"value":1466,"toc":1543},[1467,1469,1472,1475,1478,1485,1493,1496,1503,1505,1518,1521,1533,1536],[10,1468,1464],{"id":1464},[13,1470,1471],{},"SoundNinjaは初期ベータのコミュニティプロジェクトです。いちばん早い助けはGitHubです。",[22,1473,1474],{"id":1474},"バグ報告または質問",[13,1476,1477],{},"GitHubでissueを開いてください：",[13,1479,1480],{},[230,1481,1484],{"href":1482,"rel":1483},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fissues",[251],"github.com\u002Fmarcus-universe\u002FSoundNinja\u002Fissues",[13,1486,1487,1488,72,1490,1492],{},"OS、SoundNinjaのバージョン（",[17,1489,405],{},[17,1491,1284],{},"）、再現手順を書いてください。",[22,1494,1495],{"id":1495},"メール",[13,1497,1498,1499],{},"メンテナー連絡先：",[230,1500,1502],{"href":1501},"mailto:contact@marcus-universe.de","contact@marcus-universe