[{"data":1,"prerenderedAt":1557},["ShallowReactive",2],{"docs-page-ja-\u002Frecording-editor":3,"docs-nav-ja":164},{"id":4,"title":5,"body":6,"description":155,"extension":156,"meta":157,"navigation":158,"order":159,"path":160,"seo":161,"stem":162,"__hash__":163},"content_ja\u002Frecording-editor.md","録音エディター",{"type":7,"value":8,"toc":147},"minimark",[9,12,21,25,31,53,56,59,85,88,106,110,124,135],[10,11,5],"h1",{"id":5},[13,14,15,16,20],"p",{},"SoundNinja内でクリップを録音し、トリムしてタブにインポートします。プレイヤーバーの ",[17,18,19],"strong",{},"録音"," ボタンでエディターを開きます。",[22,23,24],"h2",{"id":24},"入力を選ぶ",[13,26,27,30],{},[17,28,29],{},"設定 → オーディオ"," で：",[32,33,34,41,47],"ul",{},[35,36,37,40],"li",{},[17,38,39],{},"入力デバイス"," — マイク",[35,42,43,46],{},[17,44,45],{},"出力デバイス（PCオーディオ）"," — PCが再生している音のループバック",[35,48,49,52],{},[17,50,51],{},"入力音量"," — キャプチャゲイン 0%〜200%",[13,54,55],{},"録音ボタンは、ここで選んだデバイスを使います。",[22,57,58],{"id":58},"テイクを編集",[32,60,61,64,67,76,79,82],{},[35,62,63],{},"録音と停止",[35,65,66],{},"入力レベルメーターを確認",[35,68,69,72,73],{},[17,70,71],{},"ノーマライズ"," または ",[17,74,75],{},"ノイズキャンセレーション",[35,77,78],{},"クリップ全体のトリム、選択範囲へのトリム、選択の削除",[35,80,81],{},"元に戻す \u002F やり直し",[35,83,84],{},"ズームインとズームアウト",[22,86,87],{"id":87},"ステージしてインポート",[89,90,91,94,97],"ol",{},[35,92,93],{},"選択範囲またはトラック全体をステージングリストに追加します。",[35,95,96],{},"リストは空から始まります。録音、編集、それからクリップを追加。",[35,98,99,72,102,105],{},[17,100,101],{},"選択をインポート",[17,103,104],{},"すべてインポート"," で、現在のタブまたは選んだタブに入れます。",[22,107,109],{"id":108},"ステム分離任意","ステム分離（任意）",[13,111,112,113,116,117,72,120,123],{},"公式のWindows \u002F macOS \u002F Linuxリリースビルドには ",[17,114,115],{},"ステム"," 機能が入ります。Record EditorはBS-RoFormerで ",[17,118,119],{},"ボーカル",[17,121,122],{},"音楽"," を残せます。",[13,125,126,127,130,131,134],{},"モデルは約158 MBで、インストーラーには ",[17,128,129],{},"同梱されていません","。",[17,132,133],{},"設定 → ステム分離"," からダウンロードするか、初回起動のプロンプトを承認します。Windowsインストーラーも初回起動時にモデルのダウンロードを案内できます。",[13,136,137,138,142,143,146],{},"カスタムのソースビルドには追加フラグが必要です（",[139,140,141],"code",{},"tauri:serve:stems"," \u002F ",[139,144,145],{},"tauri:build:stems","）。",{"title":148,"searchDepth":149,"depth":149,"links":150},"",2,[151,152,153,154],{"id":24,"depth":149,"text":24},{"id":58,"depth":149,"text":58},{"id":87,"depth":149,"text":87},{"id":108,"depth":149,"text":109},"マイクまたはPCオーディオを取り込み、クリップを編集してボードに置く。","md",{},true,6,"\u002Frecording-editor",{"title":5,"description":155},"recording-editor","7_RI-WNd1luOVgn5vTAoyTmO8dKVtHVwkffwMt4LBQc",[165,290,487,624,1015,1146,1241,1462],{"id":166,"title":167,"body":168,"description":283,"extension":156,"meta":284,"navigation":158,"order":285,"path":286,"seo":287,"stem":288,"__hash__":289},"content_ja\u002Foverview.md","概要",{"type":7,"value":169,"toc":277},[170,172,175,178,181,184,198,201,241,244,254,257],[10,171,167],{"id":167},[13,173,174],{},"SoundNinjaは、ライブ配信、友だちとのチャット、ポッドキャスト収録向けのオープンソースサウンドボードです。Tauri v2とNuxt 4で構築されており、RAMとディスクの負荷を抑えています。",[13,176,177],{},"目標はシンプルです。巨大なサウンドライブラリをすばやく眺め、目的のクリップをミリ秒で再生すること。UIはVRのダッシュボードとしても使いやすいです。",[13,179,180],{},"SoundNinjaはまだ初期開発段階です。機能は動きますが、すべてのプラットフォームで完全に検証されているわけではありません。",[22,182,183],{"id":183},"対象ユーザー",[32,185,186,189,192,195],{},[35,187,188],{},"即時のサウンドキューが必要な配信者",[35,190,191],{},"ボイスチャット用の共有ボードが欲しい友だち",[35,193,194],{},"クリップを録ってボードに置くポッドキャスター",[35,196,197],{},"カスタマイズ可能な、ローカル優先のサウンドボードが欲しい人",[22,199,200],{"id":200},"できること",[32,202,203,206,209,212,215,218,221,224,227,235,238],{},[35,204,205],{},"自分の音声ファイルからサウンドボードを作る",[35,207,208],{},"色付きタブ、グループ、タグ、検索で整理する",[35,210,211],{},"タグでフィルター（OR）、名前・日付・長さ・サイズでソート",[35,213,214],{},"マーキーまたはShift範囲で複数選択し、色・移動・削除を一括",[35,216,217],{},"コンテキストメニューでサウンドごとの音量を設定",[35,219,220],{},"Theme Creatorで見た目をデザインする",[35,222,223],{},"Record EditorでPCオーディオまたはマイクを録音する",[35,225,226],{},"個別のサウンドにホットキーを割り当てる",[35,228,229,234],{},[230,231,233],"a",{"href":232},"\u002Fdocs\u002Fremote-control","Bitfocus Companion","からサウンドをトリガーする",[35,236,237],{},"サウンドボード全体をインポート／エクスポートして共有する",[35,239,240],{},"サウンドボタンにGIFや画像を使う — ローカルフォルダライブラリまたはKLIPY",[22,242,243],{"id":243},"ライセンス",[13,245,246,247,253],{},"SoundNinjaは",[230,248,252],{"href":249,"rel":250},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fblob\u002Fmain\u002FLICENSE",[251],"nofollow","GPL-3.0","のフリーソフトウェアです。フォーク、改変、共有できます。",[22,255,256],{"id":256},"次のステップ",[89,258,259,265,271],{},[35,260,261],{},[230,262,264],{"href":263},"\u002Fdocs\u002Finstallation","SoundNinjaをインストール",[35,266,267],{},[230,268,270],{"href":269},"\u002Fdocs\u002Fadding-sounds","サウンドを追加",[35,272,273],{},[230,274,276],{"href":275},"\u002Fdocs\u002Forganizing-sounds","ボードを整理",{"title":148,"searchDepth":149,"depth":149,"links":278},[279,280,281,282],{"id":183,"depth":149,"text":183},{"id":200,"depth":149,"text":200},{"id":243,"depth":149,"text":243},{"id":256,"depth":149,"text":256},"SoundNinjaとは何か、何ができるか。",{},1,"\u002Foverview",{"title":167,"description":283},"overview","c8xWgFwxVyANkJ28nfjNkL8am61Nn8aDvVh7jKzMyKM",{"id":291,"title":292,"body":293,"description":481,"extension":156,"meta":482,"navigation":158,"order":149,"path":483,"seo":484,"stem":485,"__hash__":486},"content_ja\u002Finstallation.md","インストール",{"type":7,"value":294,"toc":474},[295,297,310,314,334,337,341,355,358,362,386,397,400,407,410,425,455,470],[10,296,292],{"id":292},[13,298,299,303,304,309],{},[230,300,302],{"href":301},"\u002Fdownload","ダウンロードページ","または",[230,305,308],{"href":306,"rel":307},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Freleases\u002Flatest",[251],"GitHub Releases","からビルドを入手してください。SoundNinjaは初期開発中なので、ビルドはベータとして扱ってください。",[22,311,313],{"id":312},"windows","Windows",[32,315,316,325,328,331],{},[35,317,318,319,72,322],{},"64ビットWindows向けの",[17,320,321],{},"インストーラー (.exe)",[17,323,324],{},"MSI (.msi)",[35,326,327],{},"ランディングページの対象：Windows 10以降",[35,329,330],{},"アプリのREADMEはWindows 8以上も記載",[35,332,333],{},"NSISインストーラーはダークテーマ。セットアップ時に言語を選ぶと、次回起動時にSoundNinjaが覚えます。",[13,335,336],{},"インストーラーを実行し、スタートメニューからSoundNinjaを起動します。",[22,338,340],{"id":339},"macos","macOS",[32,342,343,349,352],{},[35,344,345,346],{},"Apple SiliconとIntel向けの",[17,347,348],{},"ユニバーサル .dmg",[35,350,351],{},"ランディングページの対象：macOS 10.14以降",[35,353,354],{},"アプリのREADMEはmacOS 10.15以上を記載",[13,356,357],{},"ディスクイメージを開き、SoundNinjaをアプリケーションにドラッグします。",[22,359,361],{"id":360},"linux","Linux",[32,363,364,370,376,383],{},[35,365,366,367],{},"Ubuntu \u002F Debian向けの",[17,368,369],{},"Debian (.deb)",[35,371,372,373],{},"その他のディストリ向けの",[17,374,375],{},"AppImage",[35,377,378,379,382],{},"リリース公開後、ArchユーザーはAURから",[139,380,381],{},"soundninja-bin","をインストールできます",[35,384,385],{},"Ubuntu 20.04でテスト済み",[13,387,388,389,392,393,396],{},"デスクトップビルドにはWebKitとGTKのパッケージが必要です。Debian\u002FUbuntuでは通常、",[139,390,391],{},"libwebkit2gtk","、",[139,394,395],{},"libgtk-3-0","、app-indicatorライブラリです。",[22,398,399],{"id":399},"アップデート",[13,401,402,403,406],{},"アプリ内で ",[17,404,405],{},"ヘルプ → アップデートを確認"," を開きます。設定で起動時にSoundNinjaが確認するようにもできます。",[22,408,409],{"id":409},"ソースからビルド",[13,411,412,413,418,419,424],{},"カスタムビルドが必要なら、",[230,414,417],{"href":415,"rel":416},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja",[251],"リポジトリ","をクローンし、",[230,420,423],{"href":421,"rel":422},"https:\u002F\u002Fv2.tauri.app\u002Fstart\u002Fprerequisites\u002F",[251],"Tauriの前提条件","を入れたうえで：",[426,427,431],"pre",{"className":428,"code":429,"language":430,"meta":148,"style":148},"language-bash shiki shiki-themes github-light github-dark","bun install\nbun run tauri:serve\n","bash",[139,432,433,445],{"__ignoreMap":148},[434,435,437,441],"span",{"class":436,"line":285},"line",[434,438,440],{"class":439},"sScJk","bun",[434,442,444],{"class":443},"sZZnC"," install\n",[434,446,447,449,452],{"class":436,"line":149},[434,448,440],{"class":439},[434,450,451],{"class":443}," run",[434,453,454],{"class":443}," tauri:serve\n",[13,456,457,392,460,392,463,466,467,130],{},[139,458,459],{},"npm",[139,461,462],{},"pnpm",[139,464,465],{},"deno","でも動きます。本番ビルド：",[139,468,469],{},"bun run tauri:build",[471,472,473],"style",{},"html pre.shiki code .sScJk, html code.shiki .sScJk{--shiki-default