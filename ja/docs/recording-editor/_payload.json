[{"data":1,"prerenderedAt":1293},["ShallowReactive",2],{"docs-page-ja-\u002Frecording-editor":3,"docs-nav-ja":159},{"id":4,"title":5,"body":6,"description":150,"extension":151,"meta":152,"navigation":153,"order":154,"path":155,"seo":156,"stem":157,"__hash__":158},"content_ja\u002Frecording-editor.md","録音エディター",{"type":7,"value":8,"toc":142},"minimark",[9,12,21,25,31,53,56,59,85,88,106,110,124,130],[10,11,5],"h1",{"id":5},[13,14,15,16,20],"p",{},"SoundNinja内でクリップを録音し、トリムしてタブにインポートします。プレイヤーバーの ",[17,18,19],"strong",{},"録音"," ボタンでエディターを開きます。",[22,23,24],"h2",{"id":24},"入力を選ぶ",[13,26,27,30],{},[17,28,29],{},"設定 → オーディオ"," で：",[32,33,34,41,47],"ul",{},[35,36,37,40],"li",{},[17,38,39],{},"入力デバイス"," — マイク",[35,42,43,46],{},[17,44,45],{},"出力デバイス（PCオーディオ）"," — PCが再生している音のループバック",[35,48,49,52],{},[17,50,51],{},"入力音量"," — キャプチャゲイン 0%〜200%",[13,54,55],{},"録音ボタンは、ここで選んだデバイスを使います。",[22,57,58],{"id":58},"テイクを編集",[32,60,61,64,67,76,79,82],{},[35,62,63],{},"録音と停止",[35,65,66],{},"入力レベルメーターを確認",[35,68,69,72,73],{},[17,70,71],{},"ノーマライズ"," または ",[17,74,75],{},"ノイズキャンセレーション",[35,77,78],{},"クリップ全体のトリム、選択範囲へのトリム、選択の削除",[35,80,81],{},"元に戻す \u002F やり直し",[35,83,84],{},"ズームインとズームアウト",[22,86,87],{"id":87},"ステージしてインポート",[89,90,91,94,97],"ol",{},[35,92,93],{},"選択範囲またはトラック全体をステージングリストに追加します。",[35,95,96],{},"リストは空から始まります。録音、編集、それからクリップを追加。",[35,98,99,72,102,105],{},[17,100,101],{},"選択をインポート",[17,103,104],{},"すべてインポート"," で、現在のタブまたは選んだタブに入れます。",[22,107,109],{"id":108},"ステム分離任意","ステム分離（任意）",[13,111,112,113,72,116,119,120,123],{},"Record EditorはBS-RoFormerで ",[17,114,115],{},"ボーカル",[17,117,118],{},"音楽"," を残せます。モデルは約158 MBで、アプリには ",[17,121,122],{},"同梱されていません","。",[13,125,126,129],{},[17,127,128],{},"設定 → ステム分離"," からダウンロードするか、初回起動のプロンプトを承認します。Windowsインストーラーも初回起動時にモデルのダウンロードを案内できます。",[13,131,132,133,137,138,141],{},"ソースからのステムビルドには追加フラグが必要です（",[134,135,136],"code",{},"tauri:serve:stems"," \u002F ",[134,139,140],{},"tauri:build:stems","）。",{"title":143,"searchDepth":144,"depth":144,"links":145},"",2,[146,147,148,149],{"id":24,"depth":144,"text":24},{"id":58,"depth":144,"text":58},{"id":87,"depth":144,"text":87},{"id":108,"depth":144,"text":109},"マイクまたはPCオーディオを取り込み、クリップを編集してボードに置く。","md",{},true,6,"\u002Frecording-editor",{"title":5,"description":150},"recording-editor","fkw2G1vYZhqRZ8t2Y9irOID6H-BdjzVV8fvv-hE_qbo",[160,276,470,607,753,884,977,1198],{"id":161,"title":162,"body":163,"description":269,"extension":151,"meta":270,"navigation":153,"order":271,"path":272,"seo":273,"stem":274,"__hash__":275},"content_ja\u002Foverview.md","概要",{"type":7,"value":164,"toc":263},[165,167,170,173,176,179,193,196,227,230,240,243],[10,166,162],{"id":162},[13,168,169],{},"SoundNinjaは、ライブ配信、友だちとのチャット、ポッドキャスト収録向けのオープンソースサウンドボードです。Tauri v2とNuxt 4で構築されており、RAMとディスクの負荷を抑えています。",[13,171,172],{},"目標はシンプルです。巨大なサウンドライブラリをすばやく眺め、目的のクリップをミリ秒で再生すること。UIはVRのダッシュボードとしても使いやすいです。",[13,174,175],{},"SoundNinjaはまだ初期開発段階です。機能は動きますが、すべてのプラットフォームで完全に検証されているわけではありません。",[22,177,178],{"id":178},"対象ユーザー",[32,180,181,184,187,190],{},[35,182,183],{},"即時のサウンドキューが必要な配信者",[35,185,186],{},"ボイスチャット用の共有ボードが欲しい友だち",[35,188,189],{},"クリップを録ってボードに置くポッドキャスター",[35,191,192],{},"カスタマイズ可能な、ローカル優先のサウンドボードが欲しい人",[22,194,195],{"id":195},"できること",[32,197,198,201,204,207,210,213,221,224],{},[35,199,200],{},"自分の音声ファイルからサウンドボードを作る",[35,202,203],{},"色付きタブ、グループ、検索で整理する",[35,205,206],{},"Theme Creatorで見た目をデザインする",[35,208,209],{},"Record EditorでPCオーディオまたはマイクを録音する",[35,211,212],{},"個別のサウンドにホットキーを割り当てる",[35,214,215,220],{},[216,217,219],"a",{"href":218},"\u002Fdocs\u002Fremote-control","Bitfocus Companion","からサウンドをトリガーする",[35,222,223],{},"サウンドボード全体をインポート／エクスポートして共有する",[35,225,226],{},"サウンドボタンにGIFや画像を使う",[22,228,229],{"id":229},"ライセンス",[13,231,232,233,239],{},"SoundNinjaは",[216,234,238],{"href":235,"rel":236},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fblob\u002Fmain\u002FLICENSE",[237],"nofollow","GPL-3.0","のフリーソフトウェアです。フォーク、改変、共有できます。",[22,241,242],{"id":242},"次のステップ",[89,244,245,251,257],{},[35,246,247],{},[216,248,250],{"href":249},"\u002Fdocs\u002Finstallation","SoundNinjaをインストール",[35,252,253],{},[216,254,256],{"href":255},"\u002Fdocs\u002Fadding-sounds","サウンドを追加",[35,258,259],{},[216,260,262],{"href":261},"\u002Fdocs\u002Forganizing-sounds","ボードを整理",{"title":143,"searchDepth":144,"depth":144,"links":264},[265,266,267,268],{"id":178,"depth":144,"text":178},{"id":195,"depth":144,"text":195},{"id":229,"depth":144,"text":229},{"id":242,"depth":144,"text":242},"SoundNinjaとは何か、何ができるか。",{},1,"\u002Foverview",{"title":162,"description":269},"overview","KJDpLdg7ixvHWAtVFjPRaSTU7NMWgwE__i0PB3mQH3E",{"id":277,"title":278,"body":279,"description":464,"extension":151,"meta":465,"navigation":153,"order":144,"path":466,"seo":467,"stem":468,"__hash__":469},"content_ja\u002Finstallation.md","インストール",{"type":7,"value":280,"toc":457},[281,283,296,300,317,320,324,338,341,345,369,380,383,390,393,408,438,453],[10,282,278],{"id":278},[13,284,285,289,290,295],{},[216,286,288],{"href":287},"\u002Fdownload","ダウンロードページ","または",[216,291,294],{"href":292,"rel":293},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Freleases\u002Flatest",[237],"GitHub Releases","からビルドを入手してください。SoundNinjaは初期開発中なので、ビルドはベータとして扱ってください。",[22,297,299],{"id":298},"windows","Windows",[32,301,302,311,314],{},[35,303,304,305,72,308],{},"64ビットWindows向けの",[17,306,307],{},"インストーラー (.exe)",[17,309,310],{},"MSI (.msi)",[35,312,313],{},"ランディングページの対象：Windows 10以降",[35,315,316],{},"アプリのREADMEはWindows 8以上も記載",[13,318,319],{},"インストーラーを実行し、スタートメニューからSoundNinjaを起動します。",[22,321,323],{"id":322},"macos","macOS",[32,325,326,332,335],{},[35,327,328,329],{},"Apple SiliconとIntel向けの",[17,330,331],{},"ユニバーサル .dmg",[35,333,334],{},"ランディングページの対象：macOS 10.14以降",[35,336,337],{},"アプリのREADMEはmacOS 10.15以上を記載",[13,339,340],{},"ディスクイメージを開き、SoundNinjaをアプリケーションにドラッグします。",[22,342,344],{"id":343},"linux","Linux",[32,346,347,353,359,366],{},[35,348,349,350],{},"Ubuntu \u002F Debian向けの",[17,351,352],{},"Debian (.deb)",[35,354,355,356],{},"その他のディストリ向けの",[17,357,358],{},"AppImage",[35,360,361,362,365],{},"リリース公開後、ArchユーザーはAURから",[134,363,364],{},"soundninja-bin","をインストールできます",[35,367,368],{},"Ubuntu 20.04でテスト済み",[13,370,371,372,375,376,379],{},"デスクトップビルドにはWebKitとGTKのパッケージが必要です。Debian\u002FUbuntuでは通常、",[134,373,374],{},"libwebkit2gtk","、",[134,377,378],{},"libgtk-3-0","、app-indicatorライブラリです。",[22,381,382],{"id":382},"アップデート",[13,384,385,386,389],{},"アプリ内で ",[17,387,388],{},"ヘルプ → アップデートを確認"," を開きます。設定で起動時にSoundNinjaが確認するようにもできます。",[22,391,392],{"id":392},"ソースからビルド",[13,394,395,396,401,402,407],{},"カスタムビルドが必要なら、",[216,397,400],{"href":398,"rel":399},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja",[237],"リポジトリ","をクローンし、",[216,403,406],{"href":404,"rel":405},"https:\u002F\u002Fv2.tauri.app\u002Fstart\u002Fprerequisites\u002F",[237],"Tauriの前提条件","を入れたうえで：",[409,410,414],"pre",{"className":411,"code":412,"language":413,"meta":143,"style":143},"language-bash shiki shiki-themes github-light github-dark","bun install\nbun run tauri:serve\n","bash",[134,415,416,428],{"__ignoreMap":143},[417,418,420,424],"span",{"class":419,"line":271},"line",[417,421,423],{"class":422},"sScJk","bun",[417,425,427],{"class":426},"sZZnC"," install\n",[417,429,430,432,435],{"class":419,"line":144},[417,431,423],{"class":422},[417,433,434],{"class":426}," run",[417,436,437],{"class":426}," tauri:serve\n",[13,439,440,375,443,375,446,449,450,123],{},[134,441,442],{},"npm",[134,444,445],{},"pnpm",[134,447,448],{},"deno","でも動きます。本番ビルド：",[134,451,452],{},"bun run tauri:build",[454,455,456],"style",{},"html pre.shiki code .sScJk, html code.shiki .sScJk{--shiki-default:#6F42C1;--shiki-dark:#B392F0}html pre.shiki code .sZZnC, html code.shiki .sZZnC{--shiki-default:#032F62;--shiki-dark:#9ECBFF}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html.dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}",{"title":143,"searchDepth":144,"depth":144,"links":458},[459,460,461,462,463],{"id":298,"depth":144,"text":299},{"id":322,"depth":144,"text":323},{"id":343,"depth":144,"text":344},{"id":382,"depth":144,"text":382},{"id":392,"depth":144,"text":392},"Windows、macOS、LinuxにSoundNinjaをインストール。",{},"\u002Finstallation",{"title":278,"description":464},"installation","PtsEiD1MtLz3wDVCCGAWac0JxyBztTW1uRBbWQWqSOs",{"id":471,"title":472,"body":473,"description":600,"extension":151,"meta":601,"navigation":153,"order":602,"path":603,"seo":604,"stem":605,"__hash__":606},"content_ja\u002Fadding-sounds.md","サウンドの追加",{"type":7,"value":474,"toc":592},[475,477,480,483,501,504,534,537,553,556,570,573,576,583,586],[10,476,472],{"id":472},[13,478,479],{},"クリップを追加するまで、ボードは空です。SoundNinjaはファイル、フォルダ全体、録音、共有サウンドボードパックをインポートできます。",[22,481,482],{"id":482},"音声ファイルをインポート",[89,484,485,495,498],{},[35,486,487,490,491,494],{},[17,488,489],{},"ファイル → 音声ファイルをインポート","、またはナビバーの ",[17,492,493],{},"インポート"," を使います。",[35,496,497],{},"1つ以上の音声ファイルを選びます。",[35,499,500],{},"サウンドは現在のタブに入ります。",[22,502,503],{"id":503},"フォルダをインポート",[89,505,506,514,517],{},[35,507,508,511,512,141],{},[17,509,510],{},"ファイル → フォルダをインポート","（またはナビバーの ",[17,513,503],{},[35,515,516],{},"1つ以上のフォルダを追加。インポート前にドラッグで並べ替えできます。",[35,518,519,520],{},"配置方法を選びます：\n",[32,521,522,528],{},[35,523,524,527],{},[17,525,526],{},"タブとしてインポート"," — 各フォルダが独自のタブになる",[35,529,530,533],{},[17,531,532],{},"現在のタブにインポート"," — すべてのファイルがアクティブなタブに入る",[22,535,536],{"id":536},"クリップを録音",[13,538,539,540,542,543,547,548,72,550,552],{},"プレイヤーバーの ",[17,541,19],{}," ボタンから",[216,544,546],{"href":545},"\u002Fdocs\u002Frecording-editor","Record Editor","を開きます。キャプチャ、トリムし、",[17,549,101],{},[17,551,104],{}," で現在のタブまたは選んだタブに入れます。",[22,554,555],{"id":555},"サウンドボードをインポート",[13,557,558,561,562,565,566,569],{},[17,559,560],{},"ファイル → サウンドボードをインポート"," で共有パックを読み込みます。パックは ",[134,563,564],{},"project.sninja"," とサウンドファイルを含む ",[134,567,568],{},".zip"," です。インポート後、プロジェクトを開いて再生します。",[13,571,572],{},"複数のプロジェクト（プロファイル）も保てます。プロジェクトセレクターでボードを切り替えます。",[22,574,575],{"id":575},"見つからないファイルを再リンク",[13,577,578,579,582],{},"ディスク上で音声ファイルが移動すると、SoundNinjaは ",[17,580,581],{},"見つからないサウンドファイル"," ダイアログを表示します。検索するフォルダを選び、クリップを再リンクします。",[22,584,585],{"id":585},"次へ",[13,587,588,589,123],{},"タブ、グループ、ホットキーの整理は",[216,590,591],{"href":261},"サウンドの整理",{"title":143,"searchDepth":144,"depth":144,"links":593},[594,595,596,597,598,599],{"id":482,"depth":144,"text":482},{"id":503,"depth":144,"text":503},{"id":536,"depth":144,"text":536},{"id":555,"depth":144,"text":555},{"id":575,"depth":144,"text":575},{"id":585,"depth":144,"text":585},"音声、フォルダ、録音、共有サウンドボードをインポート。",{},3,"\u002Fadding-sounds",{"title":472,"description":600},"adding-sounds","Fa08TvxAivFfa2zc5Ab8J5x_IO2j6rzWXGssNBY_HnY",{"id":608,"title":591,"body":609,"description":746,"extension":151,"meta":747,"navigation":153,"order":748,"path":749,"seo":750,"stem":751,"__hash__":752},"content_ja\u002Forganizing-sounds.md",{"type":7,"value":610,"toc":737},[611,613,616,619,644,651,654,657,671,678,681,687,690,700,703,706,710,713,719,725,729],[10,612,591],{"id":591},[13,614,615],{},"SoundNinjaは大規模ライブラリ向けです。タブ、グループ、検索、ホットキーで、必要なクリップをワンクリック（またはワンキー）で出せます。",[22,617,618],{"id":618},"タブ",[32,620,621,627,633],{},[35,622,623,626],{},[17,624,625],{},"タブを追加"," でタブを作り、色を付けてバーをすばやく眺められます。",[35,628,629,632],{},[17,630,631],{},"すべて"," ビューはタブを横断して全サウンドを表示します。",[35,634,635,636,639,640,643],{},"サウンドは ",[17,637,638],{},"1つ以上のタブ"," に所属できます。サウンドを右クリックし、",[17,641,642],{},"タブへ移動"," で割り当てます。",[13,645,646,647,650],{},"タブの切り替え演出は ",[17,648,649],{},"設定 → メイン","：スライド、フェード、ボタンを1つずつ、またはなし。",[22,652,653],{"id":653},"グループ",[13,655,656],{},"v0.5.3以降、セパレーターを名前付きグループにできます：",[32,658,659,662,665,668],{},[35,660,661],{},"コンテキストメニューからグループの追加、名前変更、削除",[35,663,664],{},"グループヘッダーをドラッグ — 子も一緒に動く",[35,666,667],{},"グループにサウンドを入れたり出したり",[35,669,670],{},"グループの枠線色、名前の色、ボタン配置を設定（またはタブのデフォルトを使う）",[13,672,673,674,677],{},"見た目の区切りだけなら、通常の ",[17,675,676],{},"セパレーター"," も追加できます。",[22,679,680],{"id":680},"検索",[13,682,683,684,686],{},"ナビバーの ",[17,685,680],{}," フィールドを使います。入力に合わせて結果が更新されます。",[22,688,689],{"id":689},"並べ替え",[13,691,692,695,696,699],{},[17,693,694],{},"設定 → 動作"," でドラッグ＆ドロップをオンにします（",[17,697,698],{},"並べ替えを許可","）。その後、サウンドとグループをドラッグして配置します。",[22,701,702],{"id":702},"一括編集",[13,704,705],{},"複数のサウンドを選び、色の変更、タブへの移動、削除を一度に行えます。",[22,707,709],{"id":708},"ホットキーとサウンドid","ホットキーとサウンドID",[13,711,712],{},"すべてのサウンドには8文字のIDがあります。ボタンのコンテキストメニュー、または複数選択のIDチップからコピーします。",[13,714,715,718],{},[17,716,717],{},"設定 → ホットキー"," を開き、キーをサウンドIDに割り当てます。グローバルホットキーは任意です。",[13,720,721,722,724],{},"同じIDを",[216,723,219],{"href":218},"がクリップのトリガーに使います。",[22,726,728],{"id":727},"gifと色","GIFと色",[13,730,731,732,736],{},"サウンドを右クリックして、ボタンごとの色やGIF \u002F 画像背景を設定します。ボード全体を整える",[216,733,735],{"href":734},"\u002Fdocs\u002Ftheme-editor","Theme Creator","とは別です。",{"title":143,"searchDepth":144,"depth":144,"links":738},[739,740,741,742,743,744,745],{"id":618,"depth":144,"text":618},{"id":653,"depth":144,"text":653},{"id":680,"depth":144,"text":680},{"id":689,"depth":144,"text":689},{"id":702,"depth":144,"text":702},{"id":708,"depth":144,"text":709},{"id":727,"depth":144,"text":728},"タブ、グループ、検索、一括編集、ホットキー。",{},4,"\u002Forganizing-sounds",{"title":591,"description":746},"organizing-sounds","0mH24BvA7-1dcjELHB8mQnjaQMzT8Ie60aamXtNUZEE",{"id":754,"title":755,"body":756,"description":877,"extension":151,"meta":878,"navigation":153,"order":879,"path":880,"seo":881,"stem":882,"__hash__":883},"content_ja\u002Ftheme-editor.md","テーマエディター",{"type":7,"value":757,"toc":871},[758,760,767,771,797,800,803,817,820,846,849,852,857],[10,759,755],{"id":755},[13,761,762,763,766],{},"Theme Creatorは、ボードの完全なビジュアルエディターです。",[17,764,765],{},"設定 → メイン → Theme Creator"," から開きます。",[22,768,770],{"id":769},"_3つのタブ","3つのタブ",[89,772,773,786,792],{},[35,774,775,778,779,137,782,785],{},[17,776,777],{},"一般"," — テーマ名、共有色、フォントのアップロード（",[134,780,781],{},".ttf",[134,783,784],{},".otf","）",[35,787,788,791],{},[17,789,790],{},"ボタン"," — サウンドボタンの色、書体、レイアウト、GIFオーバーレイ",[35,793,794,796],{},[17,795,618],{}," — タブバーの色、書体、枠線の太さ",[13,798,799],{},"編集中、ライブプレビューがタブとボタンを表示します。",[22,801,802],{"id":802},"変更できる項目",[32,804,805,808,811,814],{},[35,806,807],{},"プライマリとアクセントの色、背景、ボタン色、タブ色",[35,809,810],{},"ボタンとタブのフォントファミリーとサイズ",[35,812,813],{},"ボタンの幅、半径、枠線幅、隙間、パディング",[35,815,816],{},"GIFオーバーレイの不透明度（通常とホバー）",[22,818,819],{"id":819},"保存と共有",[32,821,822,828,834,840],{},[35,823,824,827],{},[17,825,826],{},".cssをエクスポート"," — バックアップや友人への送信用テーマファイルを書き出す",[35,829,830,833],{},[17,831,832],{},"テーマに追加"," — Themesフォルダに保存して適用",[35,835,836,839],{},[17,837,838],{},".cssをインポート"," — 組み込みプリセットまたは保存済みテーマを読み込む",[35,841,842,845],{},[17,843,844],{},"リセット"," — SoundNinjaのデフォルトに戻す",[13,847,848],{},"未保存の変更があるままウィンドウを閉じると、SoundNinjaが先に保存を求めます。",[22,850,851],{"id":851},"フルエディターなしで",[13,853,854,856],{},[17,855,649],{}," でも次が可能です：",[32,858,859,862,868],{},[35,860,861],{},"リストからテーマを選ぶ",[35,863,864,865,785],{},"CSS変数をライブ編集する（",[17,866,867],{},"カスタムCSS",[35,869,870],{},"テーマファイルをThemesフォルダにインポートする",{"title":143,"searchDepth":144,"depth":144,"links":872},[873,874,875,876],{"id":769,"depth":144,"text":770},{"id":802,"depth":144,"text":802},{"id":819,"depth":144,"text":819},{"id":851,"depth":144,"text":851},"Theme Creatorで色、フォント、ボタン、タブをデザイン。",{},5,"\u002Ftheme-editor",{"title":755,"description":877},"theme-editor","tGeQE8HatAeqLeJ_3U4A-ac0RfIRzcoq-KghedjPolg",{"id":4,"title":5,"body":885,"description":150,"extension":151,"meta":975,"navigation":153,"order":154,"path":155,"seo":976,"stem":157,"__hash__":158},{"type":7,"value":886,"toc":969},[887,889,893,895,899,913,915,917,935,937,949,951,959,963],[10,888,5],{"id":5},[13,890,15,891,20],{},[17,892,19],{},[22,894,24],{"id":24},[13,896,897,30],{},[17,898,29],{},[32,900,901,905,909],{},[35,902,903,40],{},[17,904,39],{},[35,906,907,46],{},[17,908,45],{},[35,910,911,52],{},[17,912,51],{},[13,914,55],{},[22,916,58],{"id":58},[32,918,919,921,923,929,931,933],{},[35,920,63],{},[35,922,66],{},[35,924,925,72,927],{},[17,926,71],{},[17,928,75],{},[35,930,78],{},[35,932,81],{},[35,934,84],{},[22,936,87],{"id":87},[89,938,939,941,943],{},[35,940,93],{},[35,942,96],{},[35,944,945,72,947,105],{},[17,946,101],{},[17,948,104],{},[22,950,109],{"id":108},[13,952,112,953,72,955,119,957,123],{},[17,954,115],{},[17,956,118],{},[17,958,122],{},[13,960,961,129],{},[17,962,128],{},[13,964,132,965,137,967,141],{},[134,966,136],{},[134,968,140],{},{"title":143,"searchDepth":144,"depth":144,"links":970},[971,972,973,974],{"id":24,"depth":144,"text":24},{"id":58,"depth":144,"text":58},{"id":87,"depth":144,"text":87},{"id":108,"depth":144,"text":109},{},{"title":5,"description":150},{"id":978,"title":979,"body":980,"description":1191,"extension":151,"meta":1192,"navigation":153,"order":1193,"path":1194,"seo":1195,"stem":1196,"__hash__":1197},"content_ja\u002Fremote-control.md","リモートコントロール",{"type":7,"value":981,"toc":1184},[982,984,987,990,1022,1025,1028,1062,1065,1085,1088,1091,1123,1127,1133],[10,983,979],{"id":979},[13,985,986],{},"SoundNinjaはローカルネットワークで待ち受け、Bitfocus Companion（または任意のHTTP\u002FWebSocketクライアント）がサウンドを再生・停止できます。",[22,988,989],{"id":989},"リモートサーバーを有効化",[89,991,992,998,1005,1012],{},[35,993,994,997],{},[17,995,996],{},"設定 → リモート"," を開きます。",[35,999,1000,1001,1004],{},"リモートサーバーを有効にします。デフォルトポートは ",[17,1002,1003],{},"7331"," です。",[35,1006,1007,1008,1011],{},"任意：トークンを設定。クライアントはBearerトークンまたは ",[134,1009,1010],{},"?token="," で送ります。",[35,1013,1014,1017,1018,1021],{},[134,1015,1016],{},"http:\u002F\u002FIP:PORT"," URLをコピーするか、",[17,1019,1020],{},"設定 → 情報"," からシステムIPをコピーします。",[13,1023,1024],{},"Windowsはサーバー初回起動時にファイアウォールの確認を出すことがあります。プライベートネットワークのアクセスを許可してください。",[22,1026,219],{"id":1027},"bitfocus-companion",[89,1029,1030,1037,1045,1056],{},[35,1031,1032,1036],{},[216,1033,219],{"href":1034,"rel":1035},"https:\u002F\u002Fbitfocus.io\u002Fcompanion",[237],"をインストールします。",[35,1038,1039,1044],{},[216,1040,1043],{"href":1041,"rel":1042},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Freleases\u002Flatest\u002Fdownload\u002Fcompanion-module-soundninja.tgz",[237],"companion-module-soundninja.tgz"," をダウンロード。Companion Storeのパッケージはまだありません。",[35,1046,1047,1048,1051,1052,1055],{},"Companionで ",[17,1049,1050],{},"Modules → Load module package"," を開き、",[134,1053,1054],{},".tgz"," を選びます。",[35,1057,1058,1061],{},[17,1059,1060],{},"Sound Ninja"," 接続を追加。PCのIP、ポート、設定したトークンを貼り付けます。",[22,1063,1064],{"id":1064},"アクション",[32,1066,1067,1073,1079],{},[35,1068,1069,1072],{},[17,1070,1071],{},"Trigger Sound"," — ライブドロップダウンから選ぶか、8文字のサウンドIDを入力（Companion変数が使えます）",[35,1074,1075,1078],{},[17,1076,1077],{},"Stop Sound"," — IDで再生中のサウンドを1つ停止",[35,1080,1081,1084],{},[17,1082,1083],{},"Stop All"," — 再生中の全サウンドを停止",[13,1086,1087],{},"SoundNinjaでは、ボタンのコンテキストメニューまたは複数選択のIDチップからサウンドIDをコピーします。",[22,1089,1090],{"id":1090},"フィードバックと変数",[32,1092,1093,1099,1111,1117],{},[35,1094,1095,1098],{},[17,1096,1097],{},"Sound Playing"," — そのサウンドIDがアクティブな間はtrue（ボタン色に使う）",[35,1100,1101,1104,1105,137,1108],{},[134,1102,1103],{},"$(soundninja:connected)"," — ",[134,1106,1107],{},"true",[134,1109,1110],{},"false",[35,1112,1113,1116],{},[134,1114,1115],{},"$(soundninja:playing_count)"," — 再生中のサウンド数",[35,1118,1119,1122],{},[134,1120,1121],{},"$(soundninja:last_triggered)"," — 最後にトリガーしたサウンドID",[22,1124,1126],{"id":1125},"http-api上級","HTTP API（上級）",[13,1128,1129,1130],{},"ベースパス：",[134,1131,1132],{},"\u002Fapi\u002Fv1",[32,1134,1135,1141,1147,1153,1163,1169,1178],{},[35,1136,1137,1140],{},[134,1138,1139],{},"GET \u002Finfo"," — アプリ名、バージョン、プロトコル、トークンが必要か",[35,1142,1143,1146],{},[134,1144,1145],{},"GET \u002Fsounds"," — サウンド一覧（id、name、tabs、active）",[35,1148,1149,1152],{},[134,1150,1151],{},"GET \u002Fstate"," — サウンドと現在再生中のID",[35,1154,1155,1158,1159,1162],{},[134,1156,1157],{},"POST \u002Ftrigger"," に ",[134,1160,1161],{},"{ \"id\" }"," — サウンドを再生",[35,1164,1165,1168],{},[134,1166,1167],{},"GET \u002Ftrigger\u002F:id"," — 再生（ブラウザで簡単にテスト）",[35,1170,1171,1174,1175,1177],{},[134,1172,1173],{},"POST \u002Fstop"," に任意の ",[134,1176,1161],{}," — 1つまたはすべて停止",[35,1179,1180,1183],{},[134,1181,1182],{},"GET \u002Fws"," — ライブ状態。trigger\u002Fstopコマンドを受信",{"title":143,"searchDepth":144,"depth":144,"links":1185},[1186,1187,1188,1189,1190],{"id":989,"depth":144,"text":989},{"id":1027,"depth":144,"text":219},{"id":1064,"depth":144,"text":1064},{"id":1090,"depth":144,"text":1090},{"id":1125,"depth":144,"text":1126},"ローカルネットワーク経由でBitfocus CompanionからSoundNinjaを操作。",{},7,"\u002Fremote-control",{"title":979,"description":1191},"remote-control","PoAD2qLfe4cF4Z_a5pIF5291-yAlbNAcy3yNZfTB5RM",{"id":1199,"title":1200,"body":1201,"description":1286,"extension":151,"meta":1287,"navigation":153,"order":1288,"path":1289,"seo":1290,"stem":1291,"__hash__":1292},"content_ja\u002Fsupport.md","サポート",{"type":7,"value":1202,"toc":1279},[1203,1205,1208,1211,1214,1221,1229,1232,1239,1241,1254,1257,1269,1272],[10,1204,1200],{"id":1200},[13,1206,1207],{},"SoundNinjaは初期ベータのコミュニティプロジェクトです。いちばん早い助けはGitHubです。",[22,1209,1210],{"id":1210},"バグ報告または質問",[13,1212,1213],{},"GitHubでissueを開いてください：",[13,1215,1216],{},[216,1217,1220],{"href":1218,"rel":1219},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fissues",[237],"github.com\u002Fmarcus-universe\u002FSoundNinja\u002Fissues",[13,1222,1223,1224,72,1226,1228],{},"OS、SoundNinjaのバージョン（",[17,1225,388],{},[17,1227,1020],{},"）、再現手順を書いてください。",[22,1230,1231],{"id":1231},"メール",[13,1233,1234,1235],{},"メンテナー連絡先：",[216,1236,1238],{"href":1237},"mailto:contact@marcus-universe.de","contact@marcus-universe.de",[22,1240,382],{"id":382},[13,1242,385,1243,1245,1246,1248,1249,1253],{},[17,1244,388],{}," を使います。新しいビルドは",[216,1247,288],{"href":287},"と",[216,1250,294],{"href":1251,"rel":1252},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Freleases",[237],"にも出ます。",[22,1255,1256],{"id":1256},"コントリビュート",[13,1258,1259,1260,1264,1265,1268],{},"プルリクエストを歓迎します。アプリのリポジトリは",[216,1261,1263],{"href":398,"rel":1262},[237],"github.com\u002Fmarcus-universe\u002FSoundNinja","です。プロジェクトは",[216,1266,238],{"href":235,"rel":1267},[237],"ライセンスです。",[22,1270,1271],{"id":1271},"法的情報",[13,1273,1274,1275,123],{},"インプリントと連絡先：",[216,1276,1278],{"href":1277},"\u002Fimpressum","インプリント",{"title":143,"searchDepth":144,"depth":144,"links":1280},[1281,1282,1283,1284,1285],{"id":1210,"depth":144,"text":1210},{"id":1231,"depth":144,"text":1231},{"id":382,"depth":144,"text":382},{"id":1256,"depth":144,"text":1256},{"id":1271,"depth":144,"text":1271},"ヘルプの入手先とバグ報告。",{},8,"\u002Fsupport",{"title":1200,"description":1286},"support","T2BdU-sWENDKBxowzv9wjeevj1bEK3iit1IGD77Vz_M",1788384660701]