ody":511,"description":638,"extension":156,"meta":639,"navigation":158,"order":640,"path":641,"seo":642,"stem":643,"__hash__":644},"content_ja\u002Fadding-sounds.md","サウンドの追加",{"type":7,"value":512,"toc":630},[513,515,518,521,539,542,572,575,591,594,608,611,614,621,624],[10,514,510],{"id":510},[13,516,517],{},"クリップを追加するまで、ボードは空です。SoundNinjaはファイル、フォルダ全体、録音、共有サウンドボードパックをインポートできます。",[22,519,520],{"id":520},"音声ファイルをインポート",[89,522,523,533,536],{},[35,524,525,528,529,532],{},[17,526,527],{},"ファイル → 音声ファイルをインポート","、またはナビバーの ",[17,530,531],{},"インポート"," を使います。",[35,534,535],{},"1つ以上の音声ファイルを選びます。",[35,537,538],{},"サウンドは現在のタブに入ります。",[22,540,541],{"id":541},"フォルダをインポート",[89,543,544,552,555],{},[35,545,546,549,550,146],{},[17,547,548],{},"ファイル → フォルダをインポート","（またはナビバーの ",[17,551,541],{},[35,553,554],{},"1つ以上のフォルダを追加。インポート前にドラッグで並べ替えできます。",[35,556,557,558],{},"配置方法を選びます：\n",[32,559,560,566],{},[35,561,562,565],{},[17,563,564],{},"タブとしてインポート"," — 各フォルダが独自のタブになる",[35,567,568,571],{},[17,569,570],{},"現在のタブにインポート"," — すべてのファイルがアクティブなタブに入る",[22,573,574],{"id":574},"クリップを録音",[13,576,577,578,580,581,585,586,72,588,590],{},"プレイヤーバーの ",[17,579,19],{}," ボタンから",[230,582,584],{"href":583},"\u002Fdocs\u002Frecording-editor","Record Editor","を開きます。キャプチャ、トリムし、",[17,587,101],{},[17,589,104],{}," で現在のタブまたは選んだタブに入れます。",[22,592,593],{"id":593},"サウンドボードをインポート",[13,595,596,599,600,603,604,607],{},[17,597,598],{},"ファイル → サウンドボードをインポート"," で共有パックを読み込みます。パックは ",[139,601,602],{},"project.sninja"," とサウンドファイルを含む ",[139,605,606],{},".zip"," です。インポート後、プロジェクトを開いて再生します。",[13,609,610],{},"複数のプロジェクト（プロファイル）も保てます。プロジェクトセレクターでボードを切り替えます。",[22,612,613],{"id":613},"見つからないファイルを再リンク",[13,615,616,617,620],{},"ディスク上で音声ファイルが移動すると、SoundNinjaは ",[17,618,619],{},"見つからないサウンドファイル"," ダイアログを表示します。検索するフォルダを選び、クリップを再リンクします。",[22,622,623],{"id":623},"次へ",[13,625,626,627,130],{},"タブ、タグ、フィルター、ホットキーの整理は",[230,628,629],{"href":275},"サウンドの整理",{"title":148,"searchDepth":149,"depth":149,"links":631},[632,633,634,635,636,637],{"id":520,"depth":149,"text":520},{"id":541,"depth":149,"text":541},{"id":574,"depth":149,"text":574},{"id":593,"depth":149,"text":593},{"id":613,"depth":149,"text":613},{"id":623,"depth":149,"text":623},"音声、フォルダ、録音、共有サウンドボードをインポート。",{},3,"\u002Fadding-sounds",{"title":510,"description":638},"adding-sounds","5_cjd2COcPz0pj4ZrBehCZv6ouzBimE8UGjkcfngQjw",{"id":646,"title":629,"body":647,"description":1029,"extension":156,"meta":1030,"navigation":158,"order":1031,"path":1032,"seo":1033,"stem":1034,"__hash__":1035},"content_ja\u002Forganizing-sounds.md",{"type":7,"value":648,"toc":1014},[649,651,658,661,686,693,696,699,713,720,726,730,740,744,774,777,783,786,820,827,831,834,860,863,867,880,883,888,909,925,932,935,946,949,953,960,970,976,979,987,994,1011],[10,650,629],{"id":629},[13,652,653,654,657],{},"SoundNinjaは大規模ライブラリ向けです。",[17,655,656],{},"タグとフィルター","、タブ、検索、複数選択、ホットキーで、必要なクリップをワンクリック（またはワンキー）で出せます。",[22,659,660],{"id":660},"タブ",[32,662,663,669,675],{},[35,664,665,668],{},[17,666,667],{},"タブを追加"," でタブを作り、色を付けてバーをすばやく眺められます。",[35,670,671,674],{},[17,672,673],{},"すべて"," ビューはタブを横断して全サウンドを表示します。",[35,676,677,678,681,682,685],{},"サウンドは ",[17,679,680],{},"1つ以上のタブ"," に所属できます。サウンドを右クリックし、",[17,683,684],{},"タブへ移動"," で割り当てます。",[13,687,688,689,692],{},"タブの切り替え演出は ",[17,690,691],{},"設定 → メイン","：スライド、フェード、ボタンを1つずつ、またはなし。",[22,694,695],{"id":695},"グループ",[13,697,698],{},"v0.5.3以降、セパレーターを名前付きグループにできます：",[32,700,701,704,707,710],{},[35,702,703],{},"コンテキストメニューからグループの追加、名前変更、削除",[35,705,706],{},"グループヘッダーをドラッグ — 子も一緒に動く",[35,708,709],{},"グループにサウンドを入れたり出したり",[35,711,712],{},"グループの枠線色、名前の色、ボタン配置を設定（またはタブのデフォルトを使う）",[13,714,715,716,719],{},"見た目の区切りだけなら、通常の ",[17,717,718],{},"セパレーター"," も追加できます。",[13,721,722,723,130],{},"ボードの空き領域を右クリックして ",[17,724,725],{},"グループを追加",[22,727,729],{"id":728},"タグ-フィルター","タグ \u002F フィルター",[13,731,732,733,736,737,739],{},"タグはタブを横断します。スライドアウトの ",[17,734,735],{},"フィルター"," パネル（サイドバー ",[17,738,735],{},"）で作成し、ボードを絞ります。",[741,742,743],"h3",{"id":743},"タグの作成と編集",[89,745,746,752,762,768],{},[35,747,748,749,751],{},"サイドバーで ",[17,750,735],{}," を開く。",[35,753,754,757,758,761],{},[17,755,756],{},"タグ"," の ",[17,759,760],{},"タグを追加"," — 名前と色を付ける。",[35,763,764,765,130],{},"同じリストで名前変更、色変更、",[17,766,767],{},"タグを削除",[35,769,770,773],{},[17,771,772],{},"タグはまだありません"," と出たら、割り当てる前にここで追加する。",[741,775,776],{"id":776},"サウンドにタグを付ける",[13,778,779,780,782],{},"サウンドを右クリック → ",[17,781,756],{},"（チェックボックス）。1つのサウンドに複数可。タグが無い場合、メニューはフィルターパネルへ案内します。",[741,784,785],{"id":785},"ボードをフィルター",[32,787,788,795,806,817],{},[35,789,790,791,794],{},"フィルターパネル、または ",[17,792,793],{},"検索バー下のチップ"," でタグを切り替え。",[35,796,797,798,801,802,805],{},"一致は ",[17,799,800],{},"OR","：選択したタグの ",[17,803,804],{},"いずれか"," を持つサウンドが表示される。",[35,807,808,809,812,813,816],{},"ナビバーの ",[17,810,811],{},"検索"," は有効なタグフィルターと ",[17,814,815],{},"AND","（入力 + タグ）。",[35,818,819],{},"チップをオフ（またはフィルター解除）でタブ全体を再表示。",[13,821,822,823,826],{},"色付きタグ名をボタンに表示できます。",[17,824,825],{},"設定 → 動作 → タグバッジを表示"," で切り替え。",[22,828,830],{"id":829},"並べ替えソート","並べ替え（ソート）",[13,832,833],{},"フィルターパネルでソートモードを選びます：",[32,835,836,842],{},[35,837,838,841],{},[17,839,840],{},"ユーザー定義"," — タブ順、グループ表示",[35,843,844,392,847,392,850,392,853,856,857],{},[17,845,846],{},"名前",[17,848,849],{},"追加日時",[17,851,852],{},"再生時間",[17,854,855],{},"ファイルサイズ"," — フラットなソート一覧。これらのモードでは ",[17,858,859],{},"グループは非表示",[13,861,862],{},"再生時間ソートは、初回に長さのメタデータを準備することがあります。",[22,864,866],{"id":865},"並べ替えドラッグ","並べ替え（ドラッグ）",[13,868,869,872,873,876,877,879],{},[17,870,871],{},"設定 → 動作"," でドラッグ＆ドロップをオンにします（",[17,874,875],{},"並べ替えを許可","）。その後、サウンドとグループをドラッグして配置します。ドラッグ並べ替えは ",[17,878,840],{}," ソートで有効です。",[22,881,882],{"id":882},"複数選択",[13,884,808,885,887],{},[17,886,882],{}," をオンにして：",[32,889,890,893,899,906],{},[35,891,892],{},"クリックでサウンドをトグル",[35,894,895,898],{},[17,896,897],{},"Shift+クリック"," で直前のアンカーから範囲選択",[35,900,901,902,905],{},"空きボード上で ",[17,903,904],{},"マーキー"," をドラッグ",[35,907,908],{},"空きボード（または外側）をクリックして選択解除",[13,910,911,912,392,915,392,918,392,921,924],{},"一括バーに件数が表示され、",[17,913,914],{},"色",[17,916,917],{},"タブへ移動…",[17,919,920],{},"削除",[17,922,923],{},"完了"," が使えます。",[13,926,927,928,931],{},"複数選択中、各ボタンに ",[17,929,930],{},"8文字のIDチップ"," が出ます。チップを右クリックでコピー。",[22,933,934],{"id":934},"サウンドごとの音量",[13,936,937,938,941,942,945],{},"右クリック → ",[17,939,940],{},"音量","。スライダーを 0%〜100%。",[17,943,944],{},"ダブルクリック"," で 100% にリセット。",[13,947,948],{},"設定のマスター出力音量と重ねて効きます。",[22,950,952],{"id":951},"ホットキーとサウンドid","ホットキーとサウンドID",[13,954,955,956,959],{},"すべてのサウンドには8文字のIDがあります。ボタンのコンテキストメニュー（",[17,957,958],{},"IDをコピー","）、または複数選択のIDチップからコピーします。",[13,961,962,965,966,969],{},[17,963,964],{},"設定 → ホットキー"," を開き、キーをサウンドIDに割り当てます。グローバルホットキーは任意です。コンテキストメニューの ",[17,967,968],{},"ホットキーを割り当て"," は、IDを埋めた状態でそこにジャンプします。",[13,971,972,973,975],{},"同じIDを",[230,974,233],{"href":232},"がクリップのトリガーに使います。",[22,977,978],{"id":978},"背景画像と色",[13,980,981,982,986],{},"サウンドを右クリックして、ボタンごとの色や背景画像を設定します。ボード全体を整える",[230,983,985],{"href":984},"\u002Fdocs\u002Ftheme-editor","Theme Creator","とは別です。",[13,988,989,990,993],{},"ピッカーは ",[17,991,992],{},"背景画像"," ダイアログ（PNG、JPEG、GIF、WebP）：",[32,995,996,1002],{},[35,997,998,1001],{},[17,999,1000],{},"ローカルファイル"," — フォルダ追加、単一ファイル選択、ファイル名検索、グリッドプレビュー、ライブラリからフォルダ削除",[35,1003,1004,1007,1008,1010],{},[17,1005,1006],{},"KLIPY"," — オンラインGIFを検索。APIキーは ",[17,1009,871],{},"。キーはプロジェクトファイルには保存されません。",[13,1012,1013],{},"画像を選んだあと、ボタン上でパンとクロップできます。",{"title":148,"searchDepth":149,"depth":149,"links":1015},[1016,1017,1018,1023,1024,1025,1026,1027,1028],{"id":660,"depth":149,"text":660},{"id":695,"depth":149,"text":695},{"id":728,"depth":149,"text":729,"children":1019},[1020,1021,1022],{"id":743,"depth":640,"text":743},{"id":776,"depth":640,"text":776},{"id":785,"depth":640,"text":785},{"id":829,"depth":149,"text":830},{"id":865,"depth":149,"text":866},{"id":882,"depth":149,"text":882},{"id":934,"depth":149,"text":934},{"id":951,"depth":149,"text":952},{"id":978,"depth":149,"text":978},"タグ、フィルター、タブ、グループ、並べ替え、複数選択、音量、ホットキー。",{},4,"\u002Forganizing-sounds",{"title":629,"description":1029},"