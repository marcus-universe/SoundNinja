68,1264],{"id":1264},[13,1270,1271],{},"SoundNinjaはローカルネットワークで待ち受け、Bitfocus Companion（または任意のHTTP\u002FWebSocketクライアント）がサウンドを再生・停止できます。",[22,1273,1274],{"id":1274},"リモートサーバーを有効化",[89,1276,1277,1283,1290,1297],{},[35,1278,1279,1282],{},[17,1280,1281],{},"設定 → リモート"," を開きます。",[35,1284,1285,1286,1289],{},"リモートサーバーを有効にします。デフォルトポートは ",[17,1287,1288],{},"7331"," です。",[35,1291,1292,1293,1296],{},"任意：トークンを設定。クライアントはBearerトークンまたは ",[139,1294,1295],{},"?token="," で送ります。",[35,1298,1299,1302,1303,1306],{},[139,1300,1301],{},"http:\u002F\u002FIP:PORT"," URLをコピーするか、",[17,1304,1305],{},"設定 → 情報"," からシステムIPをコピーします。",[13,1308,1309],{},"Windowsはサーバー初回起動時にファイアウォールの確認を出すことがあります。プライベートネットワークのアクセスを許可してください。",[22,1311,233],{"id":1312},"bitfocus-companion",[89,1314,1315,1322,1330,1341],{},[35,1316,1317,1321],{},[230,1318,233],{"href":1319,"rel":1320},"https:\u002F\u002Fbitfocus.io\u002Fcompanion",[251],"をインストールします。",[35,1323,1324,1329],{},[230,1325,1328],{"href":1326,"rel":1327},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002Fcompanion-module-soundninja\u002Freleases\u002Flatest",[251],"SoundNinja-Companion.tgz"," をダウンロード。Companion Storeのパッケージはまだありません。",[35,1331,1332,1333,1336,1337,1340],{},"Companionで ",[17,1334,1335],{},"Modules → Load module package"," を開き、",[139,1338,1339],{},".tgz"," を選びます。",[35,1342,1343,1346],{},[17,1344,1345],{},"Sound Ninja"," 接続を追加。PCのIP、ポート、設定したトークンを貼り付けます。",[22,1348,1349],{"id":1349},"アクション",[32,1351,1352,1358,1364],{},[35,1353,1354,1357],{},[17,1355,1356],{},"Trigger Sound"," — ライブドロップダウンから選ぶか、8文字のサウンドIDを入力（Companion変数が使えます）",[35,1359,1360,1363],{},[17,1361,1362],{},"Stop Sound"," — IDで再生中のサウンドを1つ停止",[35,1365,1366,1369],{},[17,1367,1368],{},"Stop All"," — 再生中の全サウンドを停止",[13,1371,1372],{},"SoundNinjaでは、ボタンのコンテキストメニューまたは複数選択のIDチップからサウンドIDをコピーします。",[22,1374,1375],{"id":1375},"フィードバックと変数",[32,1377,1378,1384,1396,1402],{},[35,1379,1380,1383],{},[17,1381,1382],{},"Sound Playing"," — そのサウンドIDがアクティブな間はtrue（ボタン色に使う）",[35,1385,1386,1389,1390,142,1393],{},[139,1387,1388],{},"$(soundninja:connected)"," — ",[139,1391,1392],{},"true",[139,1394,1395],{},"false",[35,1397,1398,1401],{},[139,1399,1400],{},"$(soundninja:playing_count)"," — 再生中のサウンド数",[35,1403,1404,1407],{},[139,1405,1406],{},"$(soundninja:last_triggered)"," — 最後にトリガーしたサウンドID",[22,1409,1411],{"id":1410},"http-api上級","HTTP API（上級）",[13,1413,1414,1415],{},"ベースパス：",[139,1416,1417],{},"\u002Fapi\u002Fv1",[32,1419,1420,1426,1432,1438,1448,1454,1463],{},[35,1421,1422,1425],{},[139,1423,1424],{},"GET \u002Finfo"," — アプリ名、バージョン、プロトコル、トークンが必要か",[35,1427,1428,1431],{},[139,1429,1430],{},"GET \u002Fsounds"," — サウンド一覧（id、name、tabs、active）",[35,1433,1434,1437],{},[139,1435,1436],{},"GET \u002Fstate"," — サウンドと現在再生中のID",[35,1439,1440,1443,1444,1447],{},[139,1441,1442],{},"POST \u002Ftrigger"," に ",[139,1445,1446],{},"{ \"id\" }"," — サウンドを再生",[35,1449,1450,1453],{},[139,1451,1452],{},"GET \u002Ftrigger\u002F:id"," — 再生（ブラウザで簡単にテスト）",[35,1455,1456,1459,1460,1462],{},[139,1457,1458],{},"POST \u002Fstop"," に任意の ",[139,1461,1446],{}," — 1つまたはすべて停止",[35,1464,1465,1468],{},[139,1466,1467],{},"GET \u002Fws"," — ライブ状態。trigger\u002Fstopコマンドを受信",{"title":148,"searchDepth":149,"depth":149,"links":1470},[1471,1472,1473,1474,1475],{"id":1274,"depth":149,"text":1274},{"id":1312,"depth":149,"text":233},{"id":1349,"depth":149,"text":1349},{"id":1375,"depth":149,"text":1375},{"id":1410,"depth":149,"text":1411},"ローカルネットワーク経由でBitfocus CompanionからSoundNinjaを操作。",{},7,"\u002Fremote-control",{"title":1264,"description":1476},"remote-control","mPFqlRPL-jxRSpdtuwlQQcHhnmsyzKrKdjplGWwWueU",{"id":1484,"title":1485,"body":1486,"description":1571,"extension":156,"meta":1572,"navigation":158,"order":1573,"path":1574,"seo":1575,"stem":1576,"__hash__":1577},"content_ja\u002Fsupport.md","サポート",{"type":7,"value":1487,"toc":1564},[1488,1490,1493,1496,1499,1506,1514,1517,1524,1526,1539,1542,1554,1557],[10,1489,1485],{"id":1485},[13,1491,1492],{},"SoundNinjaは初期ベータのコミュニティプロジェクトです。いちばん早い助けはGitHubです。",[22,1494,1495],{"id"