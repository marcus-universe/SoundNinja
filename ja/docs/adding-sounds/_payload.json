[{"data":1,"prerenderedAt":1574},["ShallowReactive",2],{"docs-page-ja-\u002Fadding-sounds":3,"docs-nav-ja":161},{"id":4,"title":5,"body":6,"description":152,"extension":153,"meta":154,"navigation":155,"order":156,"path":157,"seo":158,"stem":159,"__hash__":160},"content_ja\u002Fadding-sounds.md","サウンドの追加",{"type":7,"value":8,"toc":142},"minimark",[9,12,16,20,41,44,76,79,100,103,118,121,124,131,134],[10,11,5],"h1",{"id":5},[13,14,15],"p",{},"クリップを追加するまで、ボードは空です。SoundNinjaはファイル、フォルダ全体、録音、共有サウンドボードパックをインポートできます。",[17,18,19],"h2",{"id":19},"音声ファイルをインポート",[21,22,23,35,38],"ol",{},[24,25,26,30,31,34],"li",{},[27,28,29],"strong",{},"ファイル → 音声ファイルをインポート","、またはナビバーの ",[27,32,33],{},"インポート"," を使います。",[24,36,37],{},"1つ以上の音声ファイルを選びます。",[24,39,40],{},"サウンドは現在のタブに入ります。",[17,42,43],{"id":43},"フォルダをインポート",[21,45,46,55,58],{},[24,47,48,51,52,54],{},[27,49,50],{},"ファイル → フォルダをインポート","（またはナビバーの ",[27,53,43],{},"）。",[24,56,57],{},"1つ以上のフォルダを追加。インポート前にドラッグで並べ替えできます。",[24,59,60,61],{},"配置方法を選びます：\n",[62,63,64,70],"ul",{},[24,65,66,69],{},[27,67,68],{},"タブとしてインポート"," — 各フォルダが独自のタブになる",[24,71,72,75],{},[27,73,74],{},"現在のタブにインポート"," — すべてのファイルがアクティブなタブに入る",[17,77,78],{"id":78},"クリップを録音",[13,80,81,82,85,86,91,92,95,96,99],{},"プレイヤーバーの ",[27,83,84],{},"録音"," ボタンから",[87,88,90],"a",{"href":89},"\u002Fdocs\u002Frecording-editor","Record Editor","を開きます。キャプチャ、トリムし、",[27,93,94],{},"選択をインポート"," または ",[27,97,98],{},"すべてインポート"," で現在のタブまたは選んだタブに入れます。",[17,101,102],{"id":102},"サウンドボードをインポート",[13,104,105,108,109,113,114,117],{},[27,106,107],{},"ファイル → サウンドボードをインポート"," で共有パックを読み込みます。パックは ",[110,111,112],"code",{},"project.sninja"," とサウンドファイルを含む ",[110,115,116],{},".zip"," です。インポート後、プロジェクトを開いて再生します。",[13,119,120],{},"複数のプロジェクト（プロファイル）も保てます。プロジェクトセレクターでボードを切り替えます。",[17,122,123],{"id":123},"見つからないファイルを再リンク",[13,125,126,127,130],{},"ディスク上で音声ファイルが移動すると、SoundNinjaは ",[27,128,129],{},"見つからないサウンドファイル"," ダイアログを表示します。検索するフォルダを選び、クリップを再リンクします。",[17,132,133],{"id":133},"次へ",[13,135,136,137,141],{},"タブ、タグ、フィルター、ホットキーの整理は",[87,138,140],{"href":139},"\u002Fdocs\u002Forganizing-sounds","サウンドの整理","。",{"title":143,"searchDepth":144,"depth":144,"links":145},"",2,[146,147,148,149,150,151],{"id":19,"depth":144,"text":19},{"id":43,"depth":144,"text":43},{"id":78,"depth":144,"text":78},{"id":102,"depth":144,"text":102},{"id":123,"depth":144,"text":123},{"id":133,"depth":144,"text":133},"音声、フォルダ、録音、共有サウンドボードをインポート。","md",{},true,3,"\u002Fadding-sounds",{"title":5,"description":152},"adding-sounds","5_cjd2COcPz0pj4ZrBehCZv6ouzBimE8UGjkcfngQjw",[162,285,503,594,985,1117,1258,1479],{"id":163,"title":164,"body":165,"description":278,"extension":153,"meta":279,"navigation":155,"order":280,"path":281,"seo":282,"stem":283,"__hash__":284},"content_ja\u002Foverview.md","概要",{"type":7,"value":166,"toc":272},[167,169,172,175,178,181,195,198,237,240,250,253],[10,168,164],{"id":164},[13,170,171],{},"SoundNinjaは、ライブ配信、友だちとのチャット、ポッドキャスト収録向けのオープンソースサウンドボードです。Tauri v2とNuxt 4で構築されており、RAMとディスクの負荷を抑えています。",[13,173,174],{},"目標はシンプルです。巨大なサウンドライブラリをすばやく眺め、目的のクリップをミリ秒で再生すること。UIはVRのダッシュボードとしても使いやすいです。",[13,176,177],{},"SoundNinjaはまだ初期開発段階です。機能は動きますが、すべてのプラットフォームで完全に検証されているわけではありません。",[17,179,180],{"id":180},"対象ユーザー",[62,182,183,186,189,192],{},[24,184,185],{},"即時のサウンドキューが必要な配信者",[24,187,188],{},"ボイスチャット用の共有ボードが欲しい友だち",[24,190,191],{},"クリップを録ってボードに置くポッドキャスター",[24,193,194],{},"カスタマイズ可能な、ローカル優先のサウンドボードが欲しい人",[17,196,197],{"id":197},"できること",[62,199,200,203,206,209,212,215,218,221,224,231,234],{},[24,201,202],{},"自分の音声ファイルからサウンドボードを作る",[24,204,205],{},"色付きタブ、グループ、タグ、検索で整理する",[24,207,208],{},"タグでフィルター（OR）、名前・日付・長さ・サイズでソート",[24,210,211],{},"マーキーまたはShift範囲で複数選択し、色・移動・削除を一括",[24,213,214],{},"コンテキストメニューでサウンドごとの音量を設定",[24,216,217],{},"Theme Creatorで見た目をデザインする",[24,219,220],{},"Record EditorでPCオーディオまたはマイクを録音する",[24,222,223],{},"個別のサウンドにホットキーを割り当てる",[24,225,226,230],{},[87,227,229],{"href":228},"\u002Fdocs\u002Fremote-control","Bitfocus Companion","からサウンドをトリガーする",[24,232,233],{},"サウンドボード全体をインポート／エクスポートして共有する",[24,235,236],{},"サウンドボタンにGIFや画像を使う — ローカルフォルダライブラリまたはKLIPY",[17,238,239],{"id":239},"ライセンス",[13,241,242,243,249],{},"SoundNinjaは",[87,244,248],{"href":245,"rel":246},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fblob\u002Fmain\u002FLICENSE",[247],"nofollow","GPL-3.0","のフリーソフトウェアです。フォーク、改変、共有できます。",[17,251,252],{"id":252},"次のステップ",[21,254,255,261,267],{},[24,256,257],{},[87,258,260],{"href":259},"\u002Fdocs\u002Finstallation","SoundNinjaをインストール",[24,262,263],{},[87,264,266],{"href":265},"\u002Fdocs\u002Fadding-sounds","サウンドを追加",[24,268,269],{},[87,270,271],{"href":139},"ボードを整理",{"title":143,"searchDepth":144,"depth":144,"links":273},[274,275,276,277],{"id":180,"depth":144,"text":180},{"id":197,"depth":144,"text":197},{"id":239,"depth":144,"text":239},{"id":252,"depth":144,"text":252},"SoundNinjaとは何か、何ができるか。",{},1,"\u002Foverview",{"title":164,"description":278},"overview","c8xWgFwxVyANkJ28nfjNkL8am61Nn8aDvVh7jKzMyKM",{"id":286,"title":287,"body":288,"description":497,"extension":153,"meta":498,"navigation":155,"order":144,"path":499,"seo":500,"stem":501,"__hash__":502},"content_ja\u002Finstallation.md","インストール",{"type":7,"value":289,"toc":490},[290,292,305,309,329,332,336,350,353,357,381,392,395,402,405,420,450,465,486],[10,291,287],{"id":287},[13,293,294,298,299,304],{},[87,295,297],{"href":296},"\u002Fdownload","ダウンロードページ","または",[87,300,303],{"href":301,"rel":302},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Freleases\u002Flatest",[247],"GitHub Releases","からビルドを入手してください。SoundNinjaは初期開発中なので、ビルドはベータとして扱ってください。",[17,306,308],{"id":307},"windows","Windows",[62,310,311,320,323,326],{},[24,312,313,314,95,317],{},"64ビットWindows向けの",[27,315,316],{},"インストーラー (.exe)",[27,318,319],{},"MSI (.msi)",[24,321,322],{},"ランディングページの対象：Windows 10以降",[24,324,325],{},"アプリのREADMEはWindows 8以上も記載",[24,327,328],{},"NSISインストーラーはダークテーマ。セットアップ時に言語を選ぶと、次回起動時にSoundNinjaが覚えます。",[13,330,331],{},"インストーラーを実行し、スタートメニューからSoundNinjaを起動します。",[17,333,335],{"id":334},"macos","macOS",[62,337,338,344,347],{},[24,339,340,341],{},"Apple SiliconとIntel向けの",[27,342,343],{},"ユニバーサル .dmg",[24,345,346],{},"ランディングページの対象：macOS 10.14以降",[24,348,349],{},"アプリのREADMEはmacOS 10.15以上を記載",[13,351,352],{},"ディスクイメージを開き、SoundNinjaをアプリケーションにドラッグします。",[17,354,356],{"id":355},"linux","Linux",[62,358,359,365,371,378],{},[24,360,361,362],{},"Ubuntu \u002F Debian向けの",[27,363,364],{},"Debian (.deb)",[24,366,367,368],{},"その他のディストリ向けの",[27,369,370],{},"AppImage",[24,372,373,374,377],{},"リリース公開後、ArchユーザーはAURから",[110,375,376],{},"soundninja-bin","をインストールできます",[24,379,380],{},"Ubuntu 20.04でテスト済み",[13,382,383,384,387,388,391],{},"デスクトップビルドにはWebKitとGTKのパッケージが必要です。Debian\u002FUbuntuでは通常、",[110,385,386],{},"libwebkit2gtk","、",[110,389,390],{},"libgtk-3-0","、app-indicatorライブラリです。",[17,393,394],{"id":394},"アップデート",[13,396,397,398,401],{},"アプリ内で ",[27,399,400],{},"ヘルプ → アップデートを確認"," を開きます。設定で起動時にSoundNinjaが確認するようにもできます。",[17,403,404],{"id":404},"ソースからビルド",[13,406,407,408,413,414,419],{},"カスタムビルドが必要なら、",[87,409,412],{"href":410,"rel":411},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja",[247],"リポジトリ","をクローンし、",[87,415,418],{"href":416,"rel":417},"https:\u002F\u002Fv2.tauri.app\u002Fstart\u002Fprerequisites\u002F",[247],"Tauriの前提条件","を入れたうえで：",[421,422,426],"pre",{"className":423,"code":424,"language":425,"meta":143,"style":143},"language-bash shiki shiki-themes github-light github-dark","bun install\nbun run tauri:serve\n","bash",[110,427,428,440],{"__ignoreMap":143},[429,430,432,436],"span",{"class":431,"line":280},"line",[429,433,435],{"class":434},"sScJk","bun",[429,437,439],{"class":438},"sZZnC"," install\n",[429,441,442,444,447],{"class":431,"line":144},[429,443,435],{"class":434},[429,445,446],{"class":438}," run",[429,448,449],{"class":438}," tauri:serve\n",[13,451,452,387,455,387,458,461,462,141],{},[110,453,454],{},"npm",[110,456,457],{},"pnpm",[110,459,460],{},"deno","でも動きます。本番ビルド：",[110,463,464],{},"bun run tauri:build",[13,466,467,470,471,476,477,480,481,141],{},[27,468,469],{},"Windowsのみ:"," Windowsビルドはすべて ",[87,472,475],{"href":473,"rel":474},"https:\u002F\u002Fwww.steinberg.net\u002Fasiosdk",[247],"Steinberg ASIO SDK"," 経由でASIOを含めます。一度 ",[110,478,479],{},"bun run setup:asio"," を実行（SDKはgitに含まれません）。Linux \u002F macOSは PipeWire \u002F Core Audio — この手順は不要。詳細: ",[87,482,485],{"href":483,"rel":484},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fblob\u002Fmain\u002Fdocs\u002Fbuild-from-source.md",[247],"build-from-source.md",[487,488,489],"style",{},"html pre.shiki code .sScJk, html code.shiki .sScJk{--shiki-default:#6F42C1;--shiki-dark:#B392F0}html pre.shiki code .sZZnC, html code.shiki .sZZnC{--shiki-default:#032F62;--shiki-dark:#9ECBFF}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html.dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}",{"title":143,"searchDepth":144,"depth":144,"links":491},[492,493,494,495,496],{"id":307,"depth":144,"text":308},{"id":334,"depth":144,"text":335},{"id":355,"depth":144,"text":356},{"id":394,"depth":144,"text":394},{"id":404,"depth":144,"text":404},"Windows、macOS、LinuxにSoundNinjaをインストール。",{},"\u002Finstallation",{"title":287,"description":497},"installation","IjZd1P7FnQ