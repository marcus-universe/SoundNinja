[{"data":1,"prerenderedAt":1553},["ShallowReactive",2],{"docs-page-ja-\u002Fadding-sounds":3,"docs-nav-ja":161},{"id":4,"title":5,"body":6,"description":152,"extension":153,"meta":154,"navigation":155,"order":156,"path":157,"seo":158,"stem":159,"__hash__":160},"content_ja\u002Fadding-sounds.md","サウンドの追加",{"type":7,"value":8,"toc":142},"minimark",[9,12,16,20,41,44,76,79,100,103,118,121,124,131,134],[10,11,5],"h1",{"id":5},[13,14,15],"p",{},"クリップを追加するまで、ボードは空です。SoundNinjaはファイル、フォルダ全体、録音、共有サウンドボードパックをインポートできます。",[17,18,19],"h2",{"id":19},"音声ファイルをインポート",[21,22,23,35,38],"ol",{},[24,25,26,30,31,34],"li",{},[27,28,29],"strong",{},"ファイル → 音声ファイルをインポート","、またはナビバーの ",[27,32,33],{},"インポート"," を使います。",[24,36,37],{},"1つ以上の音声ファイルを選びます。",[24,39,40],{},"サウンドは現在のタブに入ります。",[17,42,43],{"id":43},"フォルダをインポート",[21,45,46,55,58],{},[24,47,48,51,52,54],{},[27,49,50],{},"ファイル → フォルダをインポート","（またはナビバーの ",[27,53,43],{},"）。",[24,56,57],{},"1つ以上のフォルダを追加。インポート前にドラッグで並べ替えできます。",[24,59,60,61],{},"配置方法を選びます：\n",[62,63,64,70],"ul",{},[24,65,66,69],{},[27,67,68],{},"タブとしてインポート"," — 各フォルダが独自のタブになる",[24,71,72,75],{},[27,73,74],{},"現在のタブにインポート"," — すべてのファイルがアクティブなタブに入る",[17,77,78],{"id":78},"クリップを録音",[13,80,81,82,85,86,91,92,95,96,99],{},"プレイヤーバーの ",[27,83,84],{},"録音"," ボタンから",[87,88,90],"a",{"href":89},"\u002Fdocs\u002Frecording-editor","Record Editor","を開きます。キャプチャ、トリムし、",[27,93,94],{},"選択をインポート"," または ",[27,97,98],{},"すべてインポート"," で現在のタブまたは選んだタブに入れます。",[17,101,102],{"id":102},"サウンドボードをインポート",[13,104,105,108,109,113,114,117],{},[27,106,107],{},"ファイル → サウンドボードをインポート"," で共有パックを読み込みます。パックは ",[110,111,112],"code",{},"project.sninja"," とサウンドファイルを含む ",[110,115,116],{},".zip"," です。インポート後、プロジェクトを開いて再生します。",[13,119,120],{},"複数のプロジェクト（プロファイル）も保てます。プロジェクトセレクターでボードを切り替えます。",[17,122,123],{"id":123},"見つからないファイルを再リンク",[13,125,126,127,130],{},"ディスク上で音声ファイルが移動すると、SoundNinjaは ",[27,128,129],{},"見つからないサウンドファイル"," ダイアログを表示します。検索するフォルダを選び、クリップを再リンクします。",[17,132,133],{"id":133},"次へ",[13,135,136,137,141],{},"タブ、タグ、フィルター、ホットキーの整理は",[87,138,140],{"href":139},"\u002Fdocs\u002Forganizing-sounds","サウンドの整理","。",{"title":143,"searchDepth":144,"depth":144,"links":145},"",2,[146,147,148,149,150,151],{"id":19,"depth":144,"text":19},{"id":43,"depth":144,"text":43},{"id":78,"depth":144,"text":78},{"id":102,"depth":144,"text":102},{"id":123,"depth":144,"text":123},{"id":133,"depth":144,"text":133},"音声、フォルダ、録音、共有サウンドボードをインポート。","md",{},true,3,"\u002Fadding-sounds",{"title":5,"description":152},"adding-sounds","5_cjd2COcPz0pj4ZrBehCZv6ouzBimE8UGjkcfngQjw",[162,285,482,573,964,1096,1237,1458],{"id":163,"title":164,"body":165,"description":278,"extension":153,"meta":279,"navigation":155,"order":280,"path":281,"seo":282,"stem":283,"__hash__":284},"content_ja\u002Foverview.md","概要",{"type":7,"value":166,"toc":272},[167,169,172,175,178,181,195,198,237,240,250,253],[10,168,164],{"id":164},[13,170,171],{},"SoundNinjaは、ライブ配信、友だちとのチャット、ポッドキャスト収録向けのオープンソースサウンドボードです。Tauri v2とNuxt 4で構築されており、RAMとディスクの負荷を抑えています。",[13,173,174],{},"目標はシンプルです。巨大なサウンドライブラリをすばやく眺め、目的のクリップをミリ秒で再生すること。UIはVRのダッシュボードとしても使いやすいです。",[13,176,177],{},"SoundNinjaはまだ初期開発段階です。機能は動きますが、すべてのプラットフォームで完全に検証されているわけではありません。",[17,179,180],{"id":180},"対象ユーザー",[62,182,183,186,189,192],{},[24,184,185],{},"即時のサウンドキューが必要な配信者",[24,187,188],{},"ボイスチャット用の共有ボードが欲しい友だち",[24,190,191],{},"クリップを録ってボードに置くポッドキャスター",[24,193,194],{},"カスタマイズ可能な、ローカル優先のサウンドボードが欲しい人",[17,196,197],{"id":197},"できること",[62,199,200,203,206,209,212,215,218,221,224,231,234],{},[24,201,202],{},"自分の音声ファイルからサウンドボードを作る",[24,204,205],{},"色付きタブ、グループ、タグ、検索で整理する",[24,207,208],{},"タグでフィルター（OR）、名前・日付・長さ・サイズでソート",[24,210,211],{},"マーキーまたはShift範囲で複数選択し、色・移動・削除を一括",[24,213,214],{},"コンテキストメニューでサウンドごとの音量を設定",[24,216,217],{},"Theme Creatorで見た目をデザインする",[24,219,220],{},"Record EditorでPCオーディオまたはマイクを録音する",[24,222,223],{},"個別のサウンドにホットキーを割り当てる",[24,225,226,230],{},[87,227,229],{"href":228},"\u002Fdocs\u002Fremote-control","Bitfocus Companion","からサウンドをトリガーする",[24,232,233],{},"サウンドボード全体をインポート／エクスポートして共有する",[24,235,236],{},"サウンドボタンにGIFや画像を使う — ローカルフォルダライブラリまたはKLIPY",[17,238,239],{"id":239},"ライセンス",[13,241,242,243,249],{},"SoundNinjaは",[87,244,248],{"href":245,"rel":246},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fblob\u002Fmain\u002FLICENSE",[247],"nofollow","GPL-3.0","のフリーソフトウェアです。フォーク、改変、共有できます。",[17,251,252],{"id":252},"次のステップ",[21,254,255,261,267],{},[24,256,257],{},[87,258,260],{"href":259},"\u002Fdocs\u002Finstallation","SoundNinjaをインストール",[24,262,263],{},[87,264,266],{"href":265},"\u002Fdocs\u002Fadding-sounds","サウンドを追加",[24,268,269],{},[87,270,271],{"href":139},"ボードを整理",{"title":143,"searchDepth":144,"depth":144,"links":273},[274,275,276,277],{"id":180,"depth":144,"text":180},{"id":197,"depth":144,"text":197},{"id":239,"depth":144,"text":239},{"id":252,"depth":144,"text":252},"SoundNinjaとは何か、何ができるか。",{},1,"\u002Foverview",{"title":164,"description":278},"overview","c8xWgFwxVyANkJ28nfjNkL8am61Nn8aDvVh7jKzMyKM",{"id":286,"title":287,"body":288,"description":476,"extension":153,"meta":477,"navigation":155,"order":144,"path":478,"seo":479,"stem":480,"__hash__":481},"content_ja\u002Finstallation.md","インストール",{"type":7,"value":289,"toc":469},[290,292,305,309,329,332,336,350,353,357,381,392,395,402,405,420,450,465],[10,291,287],{"id":287},[13,293,294,298,299,304],{},[87,295,297],{"href":296},"\u002Fdownload","ダウンロードページ","または",[87,300,303],{"href":301,"rel":302},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Freleases\u002Flatest",[247],"GitHub Releases","からビルドを入手してください。SoundNinjaは初期開発中なので、ビルドはベータとして扱ってください。",[17,306,308],{"id":307},"windows","Windows",[62,310,311,320,323,326],{},[24,312,313,314,95,317],{},"64ビットWindows向けの",[27,315,316],{},"インストーラー (.exe)",[27,318,319],{},"MSI (.msi)",[24,321,322],{},"ランディングページの対象：Windows 10以降",[24,324,325],{},"アプリのREADMEはWindows 8以上も記載",[24,327,328],{},"NSISインストーラーはダークテーマ。セットアップ時に言語を選ぶと、次回起動時にSoundNinjaが覚えます。",[13,330,331],{},"インストーラーを実行し、スタートメニューからSoundNinjaを起動します。",[17,333,335],{"id":334},"macos","m