,43],{},[24,514,57],{},[24,516,60,517],{},[62,518,519,523],{},[24,520,521,69],{},[27,522,68],{},[24,524,525,75],{},[27,526,74],{},[17,528,78],{"id":78},[13,530,81,531,85,533,91,535,95,537,99],{},[27,532,84],{},[87,534,90],{"href":89},[27,536,94],{},[27,538,98],{},[17,540,102],{"id":102},[13,542,543,108,545,113,547,117],{},[27,544,107],{},[110,546,112],{},[110,548,116],{},[13,550,120],{},[17,552,123],{"id":123},[13,554,126,555,130],{},[27,556,129],{},[17,558,133],{"id":133},[13,560,136,561,141],{},[87,562,140],{"href":139},{"title":143,"searchDepth":144,"depth":144,"links":564},[565,566,567,568,569,570],{"id":19,"depth":144,"text":19},{"id":43,"depth":144,"text":43},{"id":78,"depth":144,"text":78},{"id":102,"depth":144,"text":102},{"id":123,"depth":144,"text":123},{"id":133,"depth":144,"text":133},{},{"title":5,"description":152},{"id":574,"title":140,"body":575,"description":957,"extension":153,"meta":958,"navigation":155,"order":959,"path":960,"seo":961,"stem":962,"__hash__":963},"content_ja\u002Forganizing-sounds.md",{"type":7,"value":576,"toc":942},[577,579,586,589,614,621,624,627,641,648,654,658,668,672,702,705,711,714,748,755,759,762,788,791,795,808,811,816,837,853,860,863,874,877,881,888,898,904,907,915,922,939],[10,578,140],{"id":140},[13,580,581,582,585],{},"SoundNinjaは大規模ライブラリ向けです。",[27,583,584],{},"タグとフィルター","、タブ、検索、複数選択、ホットキーで、必要なクリップをワンクリック（またはワンキー）で出せます。",[17,587,588],{"id":588},"タブ",[62,590,591,597,603],{},[24,592,593,596],{},[27,594,595],{},"タブを追加"," でタブを作り、色を付けてバーをすばやく眺められます。",[24,598,599,602],{},[27,600,601],{},"すべて"," ビューはタブを横断して全サウンドを表示します。",[24,604,605,606,609,610,613],{},"サウンドは ",[27,607,608],{},"1つ以上のタブ"," に所属できます。サウンドを右クリックし、",[27,611,612],{},"タブへ移動"," で割り当てます。",[13,615,616,617,620],{},"タブの切り替え演出は ",[27,618,619],{},"設定 → メイン","：スライド、フェード、ボタンを1つずつ、またはなし。",[17,622,623],{"id":623},"グループ",[13,625,626],{},"v0.5.3以降、セパレーターを名前付きグループにできます：",[62,628,629,632,635,638],{},[24,630,631],{},"コンテキストメニューからグループの追加、名前変更、削除",[24,633,634],{},"グループヘッダーをドラッグ — 子も一緒に動く",[24,636,637],{},"グループにサウンドを入れたり出したり",[24,639,640],{},"グループの枠線色、名前の色、ボタン配置を設定（またはタブのデフォルトを使う）",[13,642,643,644,647],{},"見た目の区切りだけなら、通常の ",[27,645,646],{},"セパレーター"," も追加できます。",[13,649,650,651,141],{},"ボードの空き領域を右クリックして ",[27,652,653],{},"グループを追加",[17,655,657],{"id":656},"タグ-フィルター","タグ \u002F フィルター",[13,659,660,661,664,665,667],{},"タグはタブを横断します。スライドアウトの ",[27,662,663],{},"フィルター"," パネル（サイドバー ",[27,666,663],{},"）で作成し、ボードを絞ります。",[669,670,671],"h3",{"id":671},"タグの作成と編集",[21,673,674,680,690,696],{},[24,675,676,677,679],{},"サイドバーで ",[27,678,663],{}," を開く。",[24,681,682,685,686,689],{},[27,683,684],{},"タグ"," の ",[27,687,688],{},"タグを追加"," — 名前と色を付ける。",[24,691,692,693,141],{},"同じリストで名前変更、色変更、",[27,694,695],{},"タグを削除",[24,697,698,701],{},[27,699,700],{},"タグはまだありません"," と出たら、割り当てる前にここで追加する。",[669,703,704],{"id":704},"サウンドにタグを付ける",[13,706,707,708,710],{},"サウンドを右クリック → ",[27,709,684],{},"（チェックボックス）。1つのサウンドに複数可。タグが無い場合、メニューはフィルターパネルへ案内します。",[669,712,713],{"id":713},"ボードをフィルター",[62,715,716,723,734,745],{},[24,717,718,719,722],{},"フィルターパネル、または ",[27,720,721],{},"検索バー下のチップ"," でタグを切り替え。",[24,724,725,726,729,730,733],{},"一致は ",[27,727,728],{},"OR","：選択したタグの ",[27,731,732],{},"いずれか"," を持つサウンドが表示される。",[24,735,736,737,740,741,744],{},"ナビバーの ",[27,738,739],{},"検索"," は有効なタグフィルターと ",[27,742,743],{},"AND","（入力 + タグ）。",[24,746,747],{},"チップをオフ（またはフィルター解除）でタブ全体を再表示。",[13,749,750,751,754],{},"色付きタグ名をボタンに表示できます。",[27,752,753],{},"設定 → 動作 → タグバッジを表示"," で切り替え。",[17,756,758],{"id":757},"並べ替えソート","並べ替え（ソート）",[13,760,761],{},"フィルターパネルでソートモードを選びます：",[62,763,764,770],{},[24,765,766,769],{},[27,767,768],{},"ユーザー定義"," — タブ順、グループ表示",[24,771,772,387,775,387,778,387,781,784,785],{},[27,773,774],{},"名前",[27,776,777],{},"追加日時",[27,779,780],{},"再生時間",[27,782,783],{},"ファイルサイズ"," — フラットなソート一覧。これらのモードでは ",[27,786,787],{},"グループは非表示",[13,789,790],{},"再生時間ソートは、初回に長さのメタデータを準備することがあります。",[17,792,794],{"id":793},"並べ替えドラッグ","並べ替え（ドラッグ）",[13,796,797,800,801,804,805,807],{},[27,798,799],{},"設定 → 動作"," でドラッグ＆ドロップをオンにします（",[27,802,803],{},"並べ替えを許可","）。その後、サウンドとグループをドラッグして配置します。ドラッグ並べ替えは ",[27,806,768],{}," ソートで有効です。",[17,809,810],{"id":810},"複数選択",[13,812,736,813,815],{},[27,814,810],{}," をオンにして：",[62,817,818,821,827,834],{},[24,819,820],{},"クリックでサウンドをトグル",[24,822,823,826],{},[27,824,825],{},"Shift+クリック"," で直前のアンカーから範囲選択",[24,828,829,830,833],{},"空きボード上で ",[27,831,832],{},"マーキー"," をドラッグ",[24,835,836],{},"空きボード（または外側）をクリックして選択解除",[13,838,839,840,387,843,387,846,387,849,852],{},"一括バーに件数が表示され、",[27,841,842],{},"色",[27,844,845],{},"タブへ移動…",[27,847,848],{},"削除",[27,850,851],{},"完了"," が使えます。",[13,854,855,856,859],{},"複数選択中、各ボタンに ",[27,857,858],{},"8文字のIDチップ"," が出ます。チップを右クリックでコピー。",[17,861,862],{"id":862},"サウンドごとの音量",[13,864,865,866,869,870,873],{},"右クリック → ",[27,867,868],{},"音量","。スライダーを 0%〜100%。",[27,871,872],{},"ダブルクリック"," で 100% にリセット。",[13,875,876],{},"設定のマスター出力音量と重ねて効きます。",[17,878,880],{"id":879},"ホットキーとサウンドid","ホットキーとサウンドID",[13,882,883,884,887],{},"すべてのサウンドには8文字のIDがあります。ボタンのコンテキストメニュー（",[27,885,886],{},"IDをコピー","）、または複数選択のIDチップからコピーします。",[13,889,890,893,894,897],{},[27,891,892],{},"設定 → ホットキー"," を開き、キーをサウンドIDに割り当てます。グローバルホットキーは任意です。コンテキストメニューの ",[27,895,896],{},"ホットキーを割り当て"," は、IDを埋めた状態でそこにジャンプします。",[13,899,900,901,903],{},"同じIDを",[87,902,229],{"href":228},"がクリップのトリガーに使います。",[17,905,906],{"id":906},"背景画像と色",[13,908,909,910,914],{},"サウンドを右クリックして、ボタンごとの色や背景画像を設定します。ボード全体を整える",[87,911,913],{"href":912},"\u002Fdocs\u002Ftheme-editor","Theme Creator","とは別です。",[13,916,917,918,921],{},"ピッカーは ",[27,919,920],{},"背景画像"," ダイアログ（PNG、JPEG、GIF、WebP）：",[62,923,924,930],{},[24,925,926,929],{},[27,927,928],{},"ローカルファイル"," — フォルダ追加、単一ファイル選択、ファイル名検索、グリッドプレビュー、ライブラリからフォルダ削除",[24,931,932,935,936,938],{},[27,933,934],{},"KLIPY"," — オンラインGIFを検索。APIキーは ",[27,937,799],{},"。キーはプロジェクトファイルには保存されません。",[13,940,941],{},"画像を選んだあと、ボタン上でパンとクロップできます。",{"title":143,"searchDepth":144,"depth":144,"links":943},[944,945,946,951,952,953,954,955,956],{"id":588,"depth":144,"text":588},{"id":623,"depth":144,"text":623},{"id":656,"depth":144,"text":657,"children":947},[948,949,950],{"id":671,"depth":156,"text":671},{"id":704,"depth":156,"text":704},{"id":713,"depth":156,"text":713},{"id":757,"depth":144,"text":758},{"id":793,"depth":144,"text":794},{"id":810,"depth":144,"text":810},{"id":862,"depth":144,"text":862},{"id":879,"depth":144,"text":880},{"id":906,"depth":144,"text":906},"タグ、フィルター、タブ、グループ、並べ替え、複数選択、音量、ホットキー。",{},4,"\u002Forganizing-sounds",{"title":140,"description":957},"organizing-sounds","PGqVreiuZb1jRxkXIW9tv66PvwPYs2iRx5-4j_D8sho",{"id":965,"title":966,"body":967,"description":1089,"extension":153,"meta":1090,"navigation":155,"order":1091,"path":1092,"seo":1093,"stem":1094,"__hash__":1095},"content_ja\u002Ftheme-editor.md","テーマエディター",{"type":7,"value":968,"toc":1083},[969,971,978,982,1009,1012,1015,1029,1032,1058,1061,1064,1069],[10,970,966],{"id":966},[13,972,973,974,977],{},"Theme Creatorは、ボードの完全なビジュアルエディターです。",[27,975,976],{},"設定 → メイン → Theme Creator"," から開きます。",[17,979,981],{"id":980},"_3つのタブ","3つのタブ",[21,983,984,998,1004],{},[24,985,986,989,990,993,994,997],{},[27,987,988],{},"一般"," — テーマ名、共有色、フォントのアップロード（",[110,991,992],{},".ttf"," \u002F ",[110,995,996],{},".otf","）",[24,999,1000,1003],{},[27,1001,1002],{},"ボタン"," — サウンドボタンの色、書体、レイアウト、GIFオーバーレイ",[24,1005,1006,1008],{},[27,1007,588],{}," — タブバーの色、書体、枠線の太さ",[13,1010,1011],{},"編集中、ライブプレビューがタブとボタンを表示します。",[17,1013,1014],{"id":1014},"変更できる項目",[62,1016,1017,1020,1023,1026],{},[24,1018,1019],{},"プライマリとアクセントの色、背景、ボタン色、タブ色",[24,1021,1022],{},"ボタンとタブのフォントファミリーとサイズ",[24,1024,1025],{},"ボタンの幅、半径、枠線幅、隙間、パディング",[24,1027,1028],{},"GIFオーバーレイの不透明度（通常とホバー）",[17,1030,1031],{"id":1031},"保存と共有",[62,1033,1034,1040,1046,1052],{},[24,1035,1036,1039],{},[27,1037,1038],{},".cssをエクスポート"," — バックアップや友人への送信用テーマファイルを書き出す",[24,1041,1042,1045],{},[27,1043,1044],{},"テーマに追加"," — Themesフォルダに保存して適用",[24,1047,1048,1051],{},[27,1049,1050],{},".cssをインポート"," — 組み込みプリセットまたは保存済みテーマを読み込む",[24,1053,1054,1057],{},[27,1055,1056],{},"リセット"," — SoundNinjaのデフォルトに戻す",[13,1059,1060],{},"未保存の変更があるままウィンドウを閉じると、SoundNinjaが先に保存を求めます。",[17,1062,1063],{"id":1063},"フルエディターなしで",[13,1065,1066,1068],{},[27,1067,619],{}," でも次が可能です：",[62,1070,1071,1074,1080],{},[24,1072,1073],{},"リストからテーマを選ぶ",[24,1075,1076,1077,997],{},"CSS変数をライブ編集する（",[27,1078,1079],{},"カスタムCSS",[24,1081,1082],{},"テーマファイルをThemesフォルダにインポートする",{"title":143,"searchDepth":144,"depth":144,"links":1084},[1085,1086,1087,1088],{"id":980,"depth":144,"text":981},{"id":1014,"depth":144,"text":1014},{"id":1031,"depth":144,"text":1031},{"id":1063,"depth":144,"text":1063},"Theme Creatorで色、フォント、ボタン、タブをデザイン。",{},5,"\u002Ftheme-editor",{"title":966,"description":1089},"theme-editor","tGeQE8HatAeqLeJ_3U4A-ac0RfIRzcoq-KghedjPolg",{"id":1097,"title":1098,"body":1099,"description":1230,"extension":153,"meta":1231,"navigation":155,"order":1232,"path":1233,"seo":1234,"stem":1235,"__hash__":1236},"content_ja\u002Frecording-editor.md","録音エディター",{"type":7,"value":1100,"toc":1224},[1101,1103,1109,1112,1118,1138,1141,1144,1169,1172,1187,1191,1205,1215],[10,1102,1098],{"id":1098},[13,1104,1105,1106,1108],{},"SoundNinja内でクリップを録音し、トリムしてタブにインポートします。プレイヤーバーの ",[27,1107,84],{}," ボタンでエディターを開きます。",[17,1110,1111],{"id":1111},"入力を選ぶ",[13,1113,1114,1117],{},[27,1115,1116],{},"設定 → オーディオ"," で：",[62,1119,1120,1126,1132],{},[24,1121,1122,1125],{},[27,1123,1124],{},"入力デバイス"," — マイク",[24,1127,1128,1131],{},[27,1129,1130],{},"出力デバイス（PCオーディオ）"," — PCが再生している音のループバック",[24,1133,1134,1137],{},[27,1135,1136],{},"入力音量"," — キャプチャゲイン 0%〜200%",[13,1139,1140],{},"録音ボタンは、ここで選んだデバイスを使います。",[17,1142,1143],{"id":1143},"テイクを編集",[62,1145,1146,1149,1152,1160,1163,1166],{},[24,1147,1148],{},"録音と停止",[24,1150,1151],{},"入力レベルメーターを確認",[24,1153,1154,95,1157],{},[27,1155,1156],{},"ノーマライズ",[27,1158,1159],{},"ノイズキャンセレーション",[24,1161,1162],{},"クリップ全体のトリム、選択範囲へのトリム、選択の削除",[24,1164,1165],{},"元に戻す \u002F やり直し",[24,1167,1168],{},"ズームインとズームアウト",[17,1170,1171],{"id":1171},"ステージしてインポート",[21,1173,1174,1177,1180],{},[24,1175,1176],{},"選択範囲またはトラック全体をステージングリストに追加します。",[24,1178,1179],{},"リストは空から始まります。録音、編集、それからクリップを追加。",[24,1181,1182,95,1184,1186],{},[27,1183,94],{},[27,1185,98],{}," で、現在のタブまたは選んだタブに入れます。",[17,1188,1190],{"id":1189},"ステム分離任意","ステム分離（任意）",[13,1192,1193,1194,1197,1198,95,1201,1204],{},"公式のWindows \u002F macOS \u002F Linuxリリースビルドには ",[27,1195,1196],{},"ステム"," 機能が入ります。Record EditorはBS-RoFormerで ",[27,1199,1200],{},"ボーカル",[27,1202,1203],{},"音楽"," を残せます。",[13,1206,1207,1208,141,1211,1214],{},"モデルは約158 MBで、インストーラーには ",[27,1209,1210],{},"同梱されていません",[27,1212,1213],{},"設定 → ステム分離"," からダウンロードするか、初回起動のプロンプトを承認します。Windowsインストーラーも初回起動時にモデルのダウンロードを案内できます。",[13,1216,1217,1218,993,1221,54],{},"カスタムのソースビルドには追加フラグが必要です（",[110,1219,1220],{},"tauri:serve:stems",[110,1222,1223],{},"tauri:build:stems",{"title":143,"searchDepth":144,"depth":144,"links":1225},[1226,1227,1228,1229],{"id":1111,"depth":144,"text":1111},{"id":1143,"depth":144,"text":1143},{"id":1171,"depth":144,"text":1171},{"id":1189,"depth":144,"text":1190},"マイクまたはPCオーディオを取り込み、クリップを編集してボードに置く。",{},6,"\u002Frecording-editor",{"title":1098,"description":1230},"recording-editor","7_RI-WNd1luOVgn5vTAoyTmO8dKVtHVwkffwMt4LBQc",{"id":1238,"title":1239,"body":1240,"description":1451,"extension":153,"meta":1452,"navigation":155,"order":1453,"path":1454,"seo":1455,"stem":1456,"__hash__":1457},"content_ja\u002Fremote-control.md","リモートコントロール",{"type":7,"value":1241,"toc":1444},[1242,1244,1247,1250,1282,1285,1288,1322,1325,1345,1348,1351,1383,1387,1393],[10,1243,1239],{"id":1239},[13,1245,1246],{},"SoundNinjaはローカルネットワークで待ち受け、Bitfocus Companion（または任意のHTTP\u002FWebSocketクライアント）がサウンドを再生・停止できます。",[17,1248,1249],{"id":1249},"リモートサーバーを有効化",[21,1251,1252,1258,1265,1272],{},[24,1253,1254,1257],{},[27,1255,1256],{},"設定 → リモート"," を開きます。",[24,1259,1260,1261,1264],{},"リモートサーバーを有効にします。デフォルトポートは ",[27,1262,1263],{},"7331"," です。",[24,1266,1267,1268,1271],{},"任意：トークンを設定。クライアントはBearerトークンまたは ",[110,1269,1270],{},"?token="," で送ります。",[24,1273,1274,1277,1278,1281],{},[110,1275,1276],{},"http:\u002F\u002FIP:PORT"," URLをコピーするか、",[27,1279,1280],{},"設定 → 情報"," からシステムIPをコピーします。",[13,1283,1284],{},"Windowsはサーバー初回起動時にファイアウォールの確認を出すことがあります。プライベートネットワークのアクセスを許可してください。",[17,1286,229],{"id":1287},"bitfocus-companion",[21,1289,1290,1297,1305,1316],{},[24,1291,1292,1296],{},[87,1293,229],{"href":1294,"rel":1295},"https:\u002F\u002Fbitfocus.io\u002Fcompanion",[247],"をインストールします。",[24,1298,1299,1304],{},[87,1300,1303],{"href":1301,"rel":1302},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002Fcompanion-module-soundninja\u002Freleases\u002Flatest",[247],"SoundNinja-Companion.tgz"," をダウンロード。Companion Storeのパッケージはまだありません。",[24,1306,1307,1308,1311,1312,1315],{},"Companionで ",[27,1309,1310],{},"Modules → Load module package"," を開き、",[110,1313,1314],{},".tgz"," を選びます。",[24,1317,1318,1321],{},[27,1319,1320],{},"Sound Ninja"," 接続を追加。PCのIP、ポート、設定したトークンを貼り付けます。",[17,1323,1324],{"id":1324},"アクション",[62,1326,1327,1333,1339],{},[24,1328,1329,1332],{},[27,1330,1331],{},"Trigger Sound"," — ライブドロップダウンから選ぶか、8文字のサウンドIDを入力（Companion変数が使えます）",[24,1334,1335,1338],{},[27,1336,1337],{},"Stop Sound"," — IDで再生中のサウンドを1つ停止",[24,1340,1341,1344],{},[27,1342,1343],{},"Stop All"," — 再生中の全サウンドを停止",[13,1346,1347],{},"SoundNinjaでは、ボタンのコンテキストメニューまたは複数選択のIDチップからサウンドIDをコピーします。",[17,1349,1350],{"id":1350},"フィードバックと変数",[62,1352,1353,1359,1371,1377],{},[24,1354,1355,1358],{},[27,1356,1357],{},"Sound Playing"," — そのサウンドIDがアクティブな間はtrue（ボタン色に使う）",[24,1360,1361,1364,1365,993,1368],{},[110,1362,1363],{},"$(soundninja:connected)"," — ",[110,1366,1367],{},"true",[110,1369,1370],{},"false",[24,1372,1373,1376],{},[110,1374,1375],{},"$(soundninja:playing_count)"," — 再生中のサウンド数",[24,1378,1379,1382],{},[110,1380,1381],{},"$(soundninja:last_triggered)"," — 最後にトリガーしたサウンドID",[17,1384,1386],{"id":1385},"http-api上級","HTTP API（上級）",[13,1388,1389,1390],{},"ベースパス：",[110,1391,1392],{},"\u002Fapi\u002Fv1",[62,1394,1395,1401,1407,1413,1423,1429,1438],{},[24,1396,1397,1400],{},[110,1398,1399],{},"GET \u002Finfo"," — アプリ名、バージョン、プロトコル、トークンが必要か",[24,1402,1403,1406],{},[110,1404,1405],{},"GET \u002Fsounds"," — サウンド一覧（id、name、tabs、active）",[24,1408,1409,1412],{},[110,1410,1411],{},"GET \u002Fstate"," — サウンドと現在再生中のID",[24,1414,1415,1418,1419,1422],{},[110,1416,1417],{},"POST \u002Ftrigger"," に ",[110,1420,1421],{},"{ \"id\" }"," — サウンドを再生",[24,1424,1425,1428],{},[110,1426,1427],{},"GET \u002Ftrigger\u002F:id"," — 再生（ブラウザで簡単にテスト）",[24,1430,1431,1434,1435,1437],{},[110,1432,1433],{},"POST \u002Fstop"," に任意の ",[110,1436,1421],{}," — 1つまたはすべて停止",[24,1439,1440,1443],{},[110,1441,1442],{},"GET \u002Fws"," — ライブ状態。trigger\u002Fstopコマンドを受信",{"title":143,"searchDepth":144,"depth":144,"links":1445},[1446,1447,1448,1449,1450],{"id":1249,"depth":144,"text":1249},{"id":1287,"depth":144,"text":229},{"id":1324,"depth":144,"text":1324},{"id":1350,"depth":144,"text":1350},{"id":1385,"depth":144,"text":1386},"ローカルネットワーク経由でBitfocus CompanionからSoundNinjaを操作。",{},7,"\u002Fremote-control",{"title":1239,"description":1451},"remote-control","mPFqlRPL-jxRSpdtuwlQQcHhnmsyzKrKdjplGWwWueU",{"id":1459,"title":1460,"body":1461,"description":1546,"extension":153,"meta":1547,"navigation":155,"order":1548,"path":1549,"seo":1550,"stem":1551,"__hash__":1552},"content_ja\u002Fsupport.md","サポート",{"type":7,"value":1462,"toc":1539},[1463,1465,1468,1471,1474,1481,1489,1492,1499,1501,1514,1517,1529,1532],[10,1464,1460],{"id":1460},[13,1466,1467],{},"SoundNinjaは初期ベータのコミュニティプロジェクトです。いちばん早い助けはGitHubです。",[17,1469,1470],{"id":1470},"バグ報告または質問",[13,1472,1473],{},"GitHubでissueを開いてください：",[13,1475,1476],{},[87,1477,1480],{"href":1478,"rel":1479},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fissues",[247],"github.com\u002Fmarcus-universe\u002FSoundNinja\u002Fissues",[13,1482,1483,1484,95,1486,1488],{},"OS、SoundNinjaのバージョン（",[27,1485,400],{},[27,1487,1280],{},"）、再現手順を書いてください。",[17,1490,1491],{"id":1491},"メール",[13,1493,1494,1495],{},"メンテナー連絡先：",[87,1496,1498],{"href":1497},"mailto:contact@marcus-universe.de","contact@marcus-u