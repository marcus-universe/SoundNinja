7],{},[27,615,616],{},"タブを追加"," でタブを作り、色を付けてバーをすばやく眺められます。",[24,619,620,623],{},[27,621,622],{},"すべて"," ビューはタブを横断して全サウンドを表示します。",[24,625,626,627,630,631,634],{},"サウンドは ",[27,628,629],{},"1つ以上のタブ"," に所属できます。サウンドを右クリックし、",[27,632,633],{},"タブへ移動"," で割り当てます。",[13,636,637,638,641],{},"タブの切り替え演出は ",[27,639,640],{},"設定 → メイン","：スライド、フェード、ボタンを1つずつ、またはなし。",[17,643,644],{"id":644},"グループ",[13,646,647],{},"v0.5.3以降、セパレーターを名前付きグループにできます：",[62,649,650,653,656,659],{},[24,651,652],{},"コンテキストメニューからグループの追加、名前変更、削除",[24,654,655],{},"グループヘッダーをドラッグ — 子も一緒に動く",[24,657,658],{},"グループにサウンドを入れたり出したり",[24,660,661],{},"グループの枠線色、名前の色、ボタン配置を設定（またはタブのデフォルトを使う）",[13,663,664,665,668],{},"見た目の区切りだけなら、通常の ",[27,666,667],{},"セパレーター"," も追加できます。",[13,670,671,672,141],{},"ボードの空き領域を右クリックして ",[27,673,674],{},"グループを追加",[17,676,678],{"id":677},"タグ-フィルター","タグ \u002F フィルター",[13,680,681,682,685,686,688],{},"タグはタブを横断します。スライドアウトの ",[27,683,684],{},"フィルター"," パネル（サイドバー ",[27,687,684],{},"）で作成し、ボードを絞ります。",[690,691,692],"h3",{"id":692},"タグの作成と編集",[21,694,695,701,711,717],{},[24,696,697,698,700],{},"サイドバーで ",[27,699,684],{}," を開く。",[24,702,703,706,707,710],{},[27,704,705],{},"タグ"," の ",[27,708,709],{},"タグを追加"," — 名前と色を付ける。",[24,712,713,714,141],{},"同じリストで名前変更、色変更、",[27,715,716],{},"タグを削除",[24,718,719,722],{},[27,720,721],{},"タグはまだありません"," と出たら、割り当てる前にここで追加する。",[690,724,725],{"id":725},"サウンドにタグを付ける",[13,727,728,729,731],{},"サウンドを右クリック → ",[27,730,705],{},"（チェックボックス）。1つのサウンドに複数可。タグが無い場合、メニューはフィルターパネルへ案内します。",[690,733,734],{"id":734},"ボードをフィルター",[62,736,737,744,755,766],{},[24,738,739,740,743],{},"フィルターパネル、または ",[27,741,742],{},"検索バー下のチップ"," でタグを切り替え。",[24,745,746,747,750,751,754],{},"一致は ",[27,748,749],{},"OR","：選択したタグの ",[27,752,753],{},"いずれか"," を持つサウンドが表示される。",[24,756,757,758,761,762,765],{},"ナビバーの ",[27,759,760],{},"検索"," は有効なタグフィルターと ",[27,763,764],{},"AND","（入力 + タグ）。",[24,767,768],{},"チップをオフ（またはフィルター解除）でタブ全体を再表示。",[13,770,771,772,775],{},"色付きタグ名をボタンに表示できます。",[27,773,774],{},"設定 → 動作 → タグバッジを表示"," で切り替え。",[17,777,779],{"id":778},"並べ替えソート","並べ替え（ソート）",[13,781,782],{},"フィルターパネルでソートモードを選びます：",[62,784,785,791],{},[24,786,787,790],{},[27,788,789],{},"ユーザー定義"," — タブ順、グループ表示",[24,792,793,387,796,387,799,387,802,805,806],{},[27,794,795],{},"名前",[27,797,798],{},"追加日時",[27,800,801],{},"再生時間",[27,803,804],{},"ファイルサイズ"," — フラットなソート一覧。これらのモードでは ",[27,807,808],{},"グループは非表示",[13,810,811],{},"再生時間ソートは、初回に長さのメタデータを準備することがあります。",[17,813,815],{"id":814},"並べ替えドラッグ","並べ替え（ドラッグ）",[13,817,818,821,822,825,826,828],{},[27,819,820],{},"設定 → 動作"," でドラッグ＆ドロップをオンにします（",[27,823,824],{},"並べ替えを許可","）。その後、サウンドとグループをドラッグして配置します。ドラッグ並べ替えは ",[27,827,789],{}," ソートで有効です。",[17,830,831],{"id":831},"複数選択",[13,833,757,834,836],{},[27,835,831],{}," をオンにして：",[62,838,839,842,848,855],{},[24,840,841],{},"クリックでサウンドをトグル",[24,843,844,847],{},[27,845,846],{},"Shift+クリック"," で直前のアンカーから範囲選択",[24,849,850,851,854],{},"空きボード上で ",[27,852,853],{},"マーキー"," をドラッグ",[24,856,857],{},"空きボード（または外側）をクリックして選択解除",[13,859,860,861,387,864,387,867,387,870,873],{},"一括バーに件数が表示され、",[27,862,863],{},"色",[27,865,866],{},"タブへ移動…",[27,868,869],{},"削除",[27,871,872],{},"完了"," が使えます。",[13,875,876,877,880],{},"複数選択中、各ボタンに ",[27,878,879],{},"8文字のIDチップ"," が出ます。チップを右クリックでコピー。",[17,882,883],{"id":883},"サウンドごとの音量",[13,885,886,887,890,891,894],{},"右クリック → ",[27,888,889],{},"音量","。スライダーを 0%〜100%。",[27,892,893],{},"ダブルクリック"," で 100% にリセット。",[13,896,897],{},"設定のマスター出力音量と重ねて効きます。",[17,899,901],{"id":900},"ホットキーとサウンドid","ホットキーとサウンドID",[13,903,904,905,908],{},"すべてのサウンドには8文字のIDがあります。ボタンのコンテキストメニュー（",[27,906,907],{},"IDをコピー","）、または複数選択のIDチップからコピーします。",[13,910,911,914,915,918],{},[27,912,913],{},"設定 → ホットキー"," を開き、キーをサウンドIDに割り当てます。グローバルホットキーは任意です。コンテキストメニューの ",[27,916,917],{},"ホットキーを割り当て"," は、IDを埋めた状態でそこにジャンプします。",[13,920,921,922,924],{},"同じIDを",[87,923,229],{"href":228},"がクリップのトリガーに使います。",[17,926,927],{"id":927},"背景画像と色",[13,929,930,931,935],{},"サウンドを右クリックして、ボタンごとの色や背景画像を設定します。ボード全体を整える",[87,932,934],{"href":933},"\u002Fdocs\u002Ftheme-editor","Theme Creator","とは別です。",[13,937,938,939,942],{},"ピッカーは ",[27,940,941],{},"背景画像"," ダイアログ（PNG、JPEG、GIF、WebP）：",[62,944,945,951],{},[24,946,947,950],{},[27,948,949],{},"ローカルファイル"," — フォルダ追加、単一ファイル選択、ファイル名検索、グリッドプレビュー、ライブラリからフォルダ削除",[24,952,953,956,957,959],{},[27,954,955],{},"KLIPY"," — オンラインGIFを検索。APIキーは ",[27,958,820],{},"。キーはプロジェクトファイルには保存されません。",[13,961,962],{},"画像を選んだあと、ボタン上でパンとクロップできます。",{"title":143,"searchDepth":144,"depth":144,"links":964},[965,966,967,972,973,974,975,976,977],{"id":609,"depth":144,"text":609},{"id":644,"depth":144,"text":644},{"id":677,"depth":144,"text":678,"children":968},[969,970,971],{"id":692,"depth":156,"text":692},{"id":725,"depth":156,"text":725},{"id":734,"depth":156,"text":734},{"id":778,"depth":144,"text":779},{"id":814,"depth":144,"text":815},{"id":831,"depth":144,"text":831},{"id":883,"depth":144,"text":883},{"id":900,"depth":144,"text":901},{"id":927,"depth":144,"text":927},"タグ、フィルター、タブ、グループ、並べ替え、複数選択、音量、ホットキー。",{},4,"\u002Forganizing-sounds",{"title":140,"description":978},"organizing-sounds","PGqVreiuZb1jRxkXIW9tv66PvwPYs2iRx5-4j_D8sho",{"id":986,"title":987,"body":988,"description":1110,"extension":153,"meta":1111,"navigation":155,"order":1112,"path":1113,"seo":1114,"stem":1115,"__hash__":1116},"content_ja\u002Ftheme-editor.md","テーマエディター",{"type":7,"value":989,"toc":1104},[990,992,999,1003,1030,1033,1036,1050,1053,1079,1082,1085,1090],[10,991,987],{"id":987},[13,993,994,995,998],{},"Theme Creatorは、ボードの完全なビジュアルエディターです。",[27,996,997],{},"設定 → メイン → Theme Creator"," から開きます。",[17,1000,1002],{"id":1001},"_3つのタブ","3つのタブ",[21,1004,1005,1019,1025],{},[24,1006,1007,1010,1011,1014,1015,1018],{},[27,1008,1009],{},"一般"," — テーマ名、共有色、フォントのアップロード（",[110,1012,1013],{},".ttf"," \u002F ",[110,1016,1017],{},".otf","）",[24,1020,1021,1024],{},[27,1022,1023],{},"ボタン"," — サウンドボタンの色、書体、レイアウト、GIFオーバーレイ",[24,1026,1027,1029],{},[27,1028,609],{}," — タブバーの色、書体、枠線の太さ",[13,1031,1032],{},"編集中、ライブプレビューがタブとボタンを表示します。",[17,1034,1035],{"id":1035},"変更できる項目",[62,1037,1038,1041,1044,1047],{},[24,1039,1040],{},"プライマリとアクセントの色、背景、ボタン色、タブ色",[24,1042,1043],{},"ボタンとタブのフォントファミリーとサイズ",[24,1045,1046],{},"ボタンの幅、半径、枠線幅、隙間、パディング",[24,1048,1049],{},"GIFオーバーレイの不透明度（通常とホバー）",[17,1051,1052],{"id":1052},"保存と共有",[62,1054,1055,1061,1067,1073],{},[24,1056,1057,1060],{},[27,1058,1059],{},".cssをエクスポート"," — バックアップや友人への送信用テーマファイルを書き出す",[24,1062,1063,1066],{},[27,1064,1065],{},"テーマに追加"," — Themesフォルダに保存して適用",[24,1068,1069,1072],{},[27,1070,1071],{},".cssをインポート"," — 組み込みプリセットまたは保存済みテーマを読み込む",[24,1074,1075,1078],{},[27,1076,1077],{},"リセット"," — SoundNinjaのデフォルトに戻す",[13,1080,1081],{},"未保存の変更があるままウィンドウを閉じると、SoundNinjaが先に保存を求めます。",[17,1083,1084],{"id":1084},"フルエディターなしで",[13,1086,1087,1089],{},[27,1088,640],{}," でも次が可能です：",[62,1091,1092,1095,1101],{},[24,1093,1094],{},"リストからテーマを選ぶ",[24,1096,1097,1098,1018],{},"CSS変数をライブ編集する（",[27,1099,1100],{},"カスタムCSS",[24,1102,1103],{},"テーマファイルをThemesフォルダにインポートする",{"title":143,"searchDepth":144,"depth":144,"links":1105},[1106,1107,1108,1109],{"id":1001,"depth":144,"text":1002},{"id":1035,"depth":144,"text":1035},{"id":1052,"depth":144,"text":1052},{"id":1084,"depth":144,"text":1084},"Theme Creatorで色、フォント、ボタン、タブをデザイン。",{},5,"\u002Ftheme-editor",{"title":987,"description":1110},"theme-editor","tGeQE8HatAeqLeJ_3U4A-ac0RfIRzcoq-KghedjPolg",{"id":1118,"title":1119,"body":1120,"description":1251,"extension":153,"meta":1252,"navigation":155,"order":1253,"path":1254,"seo":1255,"stem":1256,"__hash__":1257},"content_ja\u002Frecording-editor.md","録音エディター",{"type":7,"value":1121,"toc":1245},[1122,1124,1130,1133,1139,1159,1162,1165,1190,1193,1208,1212,1226,1236],[10,1123,1119],{"id":1119},[13,1125,1126,1127,1129],{},"SoundNinja内でクリップを録音し、トリムしてタブにインポートします。プレイヤーバーの ",[27,1128,84],{}," ボタンでエディターを開きます。",[17,1131,1132],{"id":1132},"入力を選ぶ",[13,1134,1135,1138],{},[27,1136,1137],{},"設定 → オーディオ"," で：",[62,1140,1141,1147,1153],{},[24,1142,1143,1146],{},[27,1144,1145],{},"入力デバイス"," — マイク",[24,1148,1149,1152],{},[27,1150,1151],{},"出力デバイス（PCオーディオ）"," — PCが再生している音のループバック",[24,1154,1155,1158],{},[27,1156,1157],{},"入力音量"," — キャプチャゲイン 0%〜200%",[13,1160,1161],{},"録音ボタンは、ここで選んだデバイスを使います。",[17,1163,1164],{"id":1164},"テイクを編集",[62,1166,1167,1170,1173,1181,1184,1187],{},[24,1168,1169],{},"録音と停止",[24,1171,1172],{},"入力レベルメーターを確認",[24,1174,1175,95,1178],{},[27,1176,1177],{},"ノーマライズ",[27,1179,1180],{},"ノイズキャンセレーション",[24,1182,1183],{},"クリップ全体のトリム、選択範囲へのトリム、選択の削除",[24,1185,1186],{},"元に戻す \u002F やり直し",[24,1188,1189],{},"ズームインとズームアウト",[17,1191,1192],{"id":1192},"ステージしてインポート",[21,1194,1195,1198,1201],{},[24,1196,1197],{},"選択範囲またはトラック全体をステージングリストに追加します。",[24,1199,1200],{},"リストは空から始まります。録音、編集、それからクリップを追加。",[24,1202,1203,95,1205,1207],{},[27,1204,94],{},[27,1206,98],{}," で、現在のタブまたは選んだタブに入れます。",[17,1209,1211],{"id":1210},"ステム分離任意","ステム分離（任意）",[13,1213,1214,1215,1218,1219,95,1222,1225],{},"公式のWindows \u002F macOS \u002F Linuxリリースビルドには ",[27,1216,1217],{},"ステム"," 機能が入ります。Record EditorはBS-RoFormerで ",[27,1220,1221],{},"ボーカル",[27,1223,1224],{},"音楽"," を残せます。",[13,1227,1228,1229,141,1232,1235],{},"モデルは約158 MBで、インストーラーには ",[27,1230,1231],{},"同梱されていません",[27,1233,1234],{},"設定 → ステム分離"," からダウンロードするか、初回起動のプロンプトを承認します。Windowsインストーラーも初回起動時にモデルのダウンロードを案内できます。",[13,1237,1238,1239,1014,1242,54],{},"カスタムのソースビルドには追加フラグが必要です（",[110,1240,1241],{},"tauri:serve:stems",[110,1243,1244],{},"tauri:build:stems",{"title":143,"searchDepth":144,"depth":144,"links":1246},[1247,1248,1249,1250],{"id":1132,"depth":144,"text":1132},{"id":1164,"depth":144,"text":1164},{"id":1192,"depth":144,"text":1192},{"id":1210,"depth":144,"text":1211},"マイクまたはPCオーディオを取り込み、クリップを編集してボードに置く。",{},6,"\u002Frecording-editor",{"title":1119,"description":1251},"recording-editor","7_RI-WNd1luOVgn5vTAoyTmO8dKVtHVwkffwMt4LBQc",{"id":1259,"title":1260,"body":1261,"description":1472,"extension":153,"meta":1473,"navigation":155,"order":1474,"path":1475,"seo":1476,"stem":1477,"__hash__":1478},"content_ja\u002Fremote-control.md","リモートコントロール",{"type":7,"value":1262,"toc":1465},[1263,1265,1268,1271,1303,1306,1309,1343,1346,1366,1369,1372,1404,1408,1414],[10,1264,1260],{"id":1260},[13,1266,1267],{},"SoundNinjaはローカルネットワークで待ち受け、Bitfocus Companion（または任意のHTTP\u002FWebSocketクライアント）がサウンドを再生・停止できます。",[17,1269,1270],{"id":1270},"リモートサーバーを有効化",[21,1272,1273,1279,1286,1293],{},[24,1274,1275,1278],{},[27,1276,1277],{},"設定 → リモート"," を開きます。",[24,1280,1281,1282,1285],{},"リモートサーバーを有効にします。デフォルトポートは ",[27,1283,1284],{},"7331"," です。",[24,1287,1288,1289,1292],{},"任意：トークンを設定。クライアントはBearerトークンまたは ",[110,1290,1291],{},"?token="," で送ります。",[24,1294,1295,1298,1299,1302],{},[110,1296,1297],{},"http:\u002F\u002FIP:PORT"," URLをコピーするか、",[27,1300,1301],{},"設定 → 情報"," からシステムIPをコピーします。",[13,1304,1305],{},"Windowsはサーバー初回起動時にファイアウォールの確認を出すことがあります。プライベートネットワークのアクセスを許可してください。",[17,1307,229],{"id":1308},"bitfocus-companion",[21,1310,1311,1318,1326,1337],{},[24,1312,1313,1317],{},[87,1314,229],{"href":1315,"rel":1316},"https:\u002F\u002Fbitfocus.io\u002Fcompanion",[247],"をインストールします。",[24,1319,1320,1325],{},[87,1321,1324],{"href":1322,"rel":1323},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002Fcompanion-module-soundninja\u002Freleases\u002Flatest",[247],"SoundNinja-Companion.tgz"," をダウンロード。Companion Storeのパッケージはまだありません。",[24,1327,1328,1329,1332,1333,1336],{},"Companionで ",[27,1330,1331],{},"Modules → Load module package"," を開き、",[110,1334,1335],{},".tgz"," を選びます。",[24,1338,1339,1342],{},[27,1340,1341],{},"Sound Ninja"," 接続を追加。PCのIP、ポート、設定したトークンを貼り付けます。",[17,1344,1345],{"id":1345},"アクション",[62,1347,1348,1354,1360],{},[24,1349,1350,1353],{},[27,1351,1352],{},"Trigger Sound"," — ライブドロップダウンから選ぶか、8文字のサウンドIDを入力（Companion変数が使えます）",[24,1355,1356,1359],{},[27,1357,1358],{},"Stop Sound"," — IDで再生中のサウンドを1つ停止",[24,1361,1362,1365],{},[27,1363,1364],{},"Stop All"," — 再生中の全サウンドを停止",[13,1367,1368],{},"SoundNinjaでは、ボタンのコンテキストメニューまたは複数選択のIDチップからサウンドIDをコピーします。",[17,1370,1371],{"id":1371},"フィードバックと変数",[62,1373,1374,1380,1392,1398],{},[24,1375,1376,1379],{},[27,1377,1378],{},"Sound Playing"," — そのサウンドIDがアクティブな間はtrue（ボタン色に使う）",[24,1381,1382,1385,1386,1014,1389],{},[110,1383,1384],{},"$(soundninja:connected)"," — ",[110,1387,1388],{},"true",[110,1390,1391],{},"false",[24,1393,1394,1397],{},[110,1395,1396],{},"$(soundninja:playing_count)"," — 再生中のサウンド数",[24,1399,1400,1403],{},[110,1401,1402],{},"$(soundninja:last_triggered)"," — 最後にトリガーしたサウンドID",[17,1405,1407],{"id":1406},"http-api上級","HTTP API（上級）",[13,1409,1410,1411],{},"ベースパス：",[110,1412,1413],{},"\u002Fapi\u002Fv1",[62,1415,1416,1422,1428,1434,1444,1450,1459],{},[24,1417,1418,1421],{},[110,1419,1420],{},"GET \u002Finfo"," — アプリ名、バージョン、プロトコル、トークンが必要か",[24,1423,1424,1427],{},[110,1425,1426],{},"GET \u002Fsounds"," — サウンド一覧（id、name、tabs、active）",[24,1429,1430,1433],{},[110,1431,1432],{},"GET \u002Fstate"," — サウンドと現在再生中のID",[24,1435,1436,1439,1440,1443],{},[110,1437,1438],{},"POST \u002Ftrigger"," に ",[110,1441,1442],{},"{ \"id\" }"," — サウンドを再生",[24,1445,1446,1449],{},[110,1447,1448],{},"GET \u002Ftrigger\u002F:id"," — 再生（ブラウザで簡単にテスト）",[24,1451,1452,1455,1456,1458],{},[110,1453,1454],{},"POST \u002Fstop"," に任意の ",[110,1457,1442],{}," — 1つまたはすべて停止",[24,1460,1461,1464],{},[110,1462,1463],{},"GET \u002Fws"," — ライブ状態。trigger\u002Fstopコマンドを受信",{"title":143,"searchDepth":144,"depth":144,"links":1466},[1467,1468,1469,1470,1471],{"id":1270,"depth":144,"text":1270},{"id":1308,"depth":144,"text":229},{"id":1345,"depth":144,"text":1345},{"id":1371,"depth":144,"text":1371},{"id":1406,"depth":144,"text":1407},"ローカルネットワーク経由でBitfocus CompanionからSoundNinjaを操作。",{},7,"\u002Fremote-control",{"title":1260,"description":1472},"remote-control","mPFqlRPL-jxRSpdtuwlQQcHhnmsyzKrKdjplGWwWueU",{"id":1480,"title":1481,"body":1482,"description":1567,"extension":153,"meta":1568,"navigation":155,"order":1569,"path":1570,"seo":1571,"stem":1572,"__hash__":1573},"content_ja\u002Fsupport.md","サポート",{"type":7,"value":1483,"toc":1560},[1484,1486,1489,1492,1495,1502,1510,1513,1520,1522,1535,1538,1550,1553],[10,1485,1481],{"id":1481},[13,1487,1488],{},"SoundNinjaは初期ベータのコミュニティプロジェクトです。い