[{"data":1,"prerenderedAt":1291},["ShallowReactive",2],{"docs-page-ja-\u002Fadding-sounds":3,"docs-nav-ja":161},{"id":4,"title":5,"body":6,"description":152,"extension":153,"meta":154,"navigation":155,"order":156,"path":157,"seo":158,"stem":159,"__hash__":160},"content_ja\u002Fadding-sounds.md","サウンドの追加",{"type":7,"value":8,"toc":142},"minimark",[9,12,16,20,41,44,76,79,100,103,118,121,124,131,134],[10,11,5],"h1",{"id":5},[13,14,15],"p",{},"クリップを追加するまで、ボードは空です。SoundNinjaはファイル、フォルダ全体、録音、共有サウンドボードパックをインポートできます。",[17,18,19],"h2",{"id":19},"音声ファイルをインポート",[21,22,23,35,38],"ol",{},[24,25,26,30,31,34],"li",{},[27,28,29],"strong",{},"ファイル → 音声ファイルをインポート","、またはナビバーの ",[27,32,33],{},"インポート"," を使います。",[24,36,37],{},"1つ以上の音声ファイルを選びます。",[24,39,40],{},"サウンドは現在のタブに入ります。",[17,42,43],{"id":43},"フォルダをインポート",[21,45,46,55,58],{},[24,47,48,51,52,54],{},[27,49,50],{},"ファイル → フォルダをインポート","（またはナビバーの ",[27,53,43],{},"）。",[24,56,57],{},"1つ以上のフォルダを追加。インポート前にドラッグで並べ替えできます。",[24,59,60,61],{},"配置方法を選びます：\n",[62,63,64,70],"ul",{},[24,65,66,69],{},[27,67,68],{},"タブとしてインポート"," — 各フォルダが独自のタブになる",[24,71,72,75],{},[27,73,74],{},"現在のタブにインポート"," — すべてのファイルがアクティブなタブに入る",[17,77,78],{"id":78},"クリップを録音",[13,80,81,82,85,86,91,92,95,96,99],{},"プレイヤーバーの ",[27,83,84],{},"録音"," ボタンから",[87,88,90],"a",{"href":89},"\u002Fdocs\u002Frecording-editor","Record Editor","を開きます。キャプチャ、トリムし、",[27,93,94],{},"選択をインポート"," または ",[27,97,98],{},"すべてインポート"," で現在のタブまたは選んだタブに入れます。",[17,101,102],{"id":102},"サウンドボードをインポート",[13,104,105,108,109,113,114,117],{},[27,106,107],{},"ファイル → サウンドボードをインポート"," で共有パックを読み込みます。パックは ",[110,111,112],"code",{},"project.sninja"," とサウンドファイルを含む ",[110,115,116],{},".zip"," です。インポート後、プロジェクトを開いて再生します。",[13,119,120],{},"複数のプロジェクト（プロファイル）も保てます。プロジェクトセレクターでボードを切り替えます。",[17,122,123],{"id":123},"見つからないファイルを再リンク",[13,125,126,127,130],{},"ディスク上で音声ファイルが移動すると、SoundNinjaは ",[27,128,129],{},"見つからないサウンドファイル"," ダイアログを表示します。検索するフォルダを選び、クリップを再リンクします。",[17,132,133],{"id":133},"次へ",[13,135,136,137,141],{},"タブ、グループ、ホットキーの整理は",[87,138,140],{"href":139},"\u002Fdocs\u002Forganizing-sounds","サウンドの整理","。",{"title":143,"searchDepth":144,"depth":144,"links":145},"",2,[146,147,148,149,150,151],{"id":19,"depth":144,"text":19},{"id":43,"depth":144,"text":43},{"id":78,"depth":144,"text":78},{"id":102,"depth":144,"text":102},{"id":123,"depth":144,"text":123},{"id":133,"depth":144,"text":133},"音声、フォルダ、録音、共有サウンドボードをインポート。","md",{},true,3,"\u002Fadding-sounds",{"title":5,"description":152},"adding-sounds","Fa08TvxAivFfa2zc5Ab8J5x_IO2j6rzWXGssNBY_HnY",[162,276,470,561,707,839,975,1196],{"id":163,"title":164,"body":165,"description":269,"extension":153,"meta":270,"navigation":155,"order":271,"path":272,"seo":273,"stem":274,"__hash__":275},"content_ja\u002Foverview.md","概要",{"type":7,"value":166,"toc":263},[167,169,172,175,178,181,195,198,228,231,241,244],[10,168,164],{"id":164},[13,170,171],{},"SoundNinjaは、ライブ配信、友だちとのチャット、ポッドキャスト収録向けのオープンソースサウンドボードです。Tauri v2とNuxt 4で構築されており、RAMとディスクの負荷を抑えています。",[13,173,174],{},"目標はシンプルです。巨大なサウンドライブラリをすばやく眺め、目的のクリップをミリ秒で再生すること。UIはVRのダッシュボードとしても使いやすいです。",[13,176,177],{},"SoundNinjaはまだ初期開発段階です。機能は動きますが、すべてのプラットフォームで完全に検証されているわけではありません。",[17,179,180],{"id":180},"対象ユーザー",[62,182,183,186,189,192],{},[24,184,185],{},"即時のサウンドキューが必要な配信者",[24,187,188],{},"ボイスチャット用の共有ボードが欲しい友だち",[24,190,191],{},"クリップを録ってボードに置くポッドキャスター",[24,193,194],{},"カスタマイズ可能な、ローカル優先のサウンドボードが欲しい人",[17,196,197],{"id":197},"できること",[62,199,200,203,206,209,212,215,222,225],{},[24,201,202],{},"自分の音声ファイルからサウンドボードを作る",[24,204,205],{},"色付きタブ、グループ、検索で整理する",[24,207,208],{},"Theme Creatorで見た目をデザインする",[24,210,211],{},"Record EditorでPCオーディオまたはマイクを録音する",[24,213,214],{},"個別のサウンドにホットキーを割り当てる",[24,216,217,221],{},[87,218,220],{"href":219},"\u002Fdocs\u002Fremote-control","Bitfocus Companion","からサウンドをトリガーする",[24,223,224],{},"サウンドボード全体をインポート／エクスポートして共有する",[24,226,227],{},"サウンドボタンにGIFや画像を使う",[17,229,230],{"id":230},"ライセンス",[13,232,233,234,240],{},"SoundNinjaは",[87,235,239],{"href":236,"rel":237},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fblob\u002Fmain\u002FLICENSE",[238],"nofollow","GPL-3.0","のフリーソフトウェアです。フォーク、改変、共有できます。",[17,242,243],{"id":243},"次のステップ",[21,245,246,252,258],{},[24,247,248],{},[87,249,251],{"href":250},"\u002Fdocs\u002Finstallation","SoundNinjaをインストール",[24,253,254],{},[87,255,257],{"href":256},"\u002Fdocs\u002Fadding-sounds","サウンドを追加",[24,259,260],{},[87,261,262],{"href":139},"ボードを整理",{"title":143,"searchDepth":144,"depth":144,"links":264},[265,266,267,268],{"id":180,"depth":144,"text":180},{"id":197,"depth":144,"text":197},{"id":230,"depth":144,"text":230},{"id":243,"depth":144,"text":243},"SoundNinjaとは何か、何ができるか。",{},1,"\u002Foverview",{"title":164,"description":269},"overview","KJDpLdg7ixvHWAtVFjPRaSTU7NMWgwE__i0PB3mQH3E",{"id":277,"title":278,"body":279,"description":464,"extension":153,"meta":465,"navigation":155,"order":144,"path":466,"seo":467,"stem":468,"__hash__":469},"content_ja\u002Finstallation.md","インストール",{"type":7,"value":280,"toc":457},[281,283,296,300,317,320,324,338,341,345,369,380,383,390,393,408,438,453],[10,282,278],{"id":278},[13,284,285,289,290,295],{},[87,286,288],{"href":287},"\u002Fdownload","ダウンロードページ","または",[87,291,294],{"href":292,"rel":293},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Freleases\u002Flatest",[238],"GitHub Releases","からビルドを入手してください。SoundNinjaは初期開発中なので、ビルドはベータとして扱ってください。",[17,297,299],{"id":298},"windows","Windows",[62,301,302,311,314],{},[24,303,304,305,95,308],{},"64ビットWindows向けの",[27,306,307],{},"インストーラー (.exe)",[27,309,310],{},"MSI (.msi)",[24,312,313],{},"ランディングページの対象：Windows 10以降",[24,315,316],{},"アプリのREADMEはWindows 8以上も記載",[13,318,319],{},"インストーラーを実行し、スタートメニューからSoundNinjaを起動します。",[17,321,323],{"id":322},"macos","macOS",[62,325,326,332,335],{},[24,327,328,329],{},"Apple SiliconとIntel向けの",[27,330,331],{},"ユニバーサル .dmg",[24,333,334],{},"ランディングページの対象：macOS 10.14以降",[24,336,337],{},"アプリのREADMEはmacOS 10.15以上を記載",[13,339,340],{},"ディスクイメージを開き、SoundNinjaをアプリケーションにドラッグします。",[17,342,344],{"id":343},"linux","Linux",[62,346,347,353,359,366],{},[24,348,349,350],{},"Ubuntu \u002F Debian向けの",[27,351,352],{},"Debian (.deb)",[24,354,355,356],{},"その他のディストリ向けの",[27,357,358],{},"AppImage",[24,360,361,362,365],{},"リリース公開後、ArchユーザーはAURから",[110,363,364],{},"soundninja-bin","をインストールできます",[24,367,368],{},"Ubuntu 20.04でテスト済み",[13,370,371,372,375,376,379],{},"デスクトップビルドにはWebKitとGTKのパッケージが必要です。Debian\u002FUbuntuでは通常、",[110,373,374],{},"libwebkit2gtk","、",[110,377,378],{},"libgtk-3-0","、app-indicatorライブラリです。",[17,381,382],{"id":382},"アップデート",[13,384,385,386,389],{},"アプリ内で ",[27,387,388],{},"ヘルプ → アップデートを確認"," を開きます。設定で起動時にSoundNinjaが確認するようにもできます。",[17,391,392],{"id":392},"ソースからビルド",[13,394,395,396,401,402,407],{},"カスタムビルドが必要なら、",[87,397,400],{"href":398,"rel":399},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja",[238],"リポジトリ","をクローンし、",[87,403,406],{"href":404,"rel":405},"https:\u002F\u002Fv2.tauri.app\u002Fstart\u002Fprerequisites\u002F",[238],"Tauriの前提条件","を入れたうえで：",[409,410,414],"pre",{"className":411,"code":412,"language":413,"meta":143,"style":143},"language-bash shiki shiki-themes github-light github-dark","bun install\nbun run tauri:serve\n","bash",[110,415,416,428],{"__ignoreMap":143},[417,418,420,424],"span",{"class":419,"line":271},"line",[417,421,423],{"class":422},"sScJk","bun",[417,425,427],{"class":426},"sZZnC"," install\n",[417,429,430,432,435],{"class":419,"line":144},[417,431,423],{"class":422},[417,433,434],{"class":426}," run",[417,436,437],{"class":426}," tauri:serve\n",[13,439,440,375,443,375,446,449,450,141],{},[110,441,442],{},"npm",[110,444,445],{},"pnpm",[110,447,448],{},"deno","でも動きます。本番ビルド：",[110,451,452],{},"bun run tauri:build",[454,455,456],"style",{},"html pre.shiki code .sScJk, html code.shiki .sScJk{--shiki-default:#6F42C1;--shiki-dark:#B392F0}html pre.shiki code .sZZnC, html code.shiki .sZZnC{--shiki-default:#032F62;--shiki-dark:#9ECBFF}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html.dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}",{"title":143,"searchDepth":144,"depth":144,"links":458},[459,460,461,462,463],{"id":298,"depth":144,"text":299},{"id":322,"depth":144,"text":323},{"id":343,"depth":144,"text":344},{"id":382,"depth":144,"text":382},{"id":392,"depth":144,"text":392},"Windows、macOS、LinuxにSoundNinjaをインストール。",{},"\u002Finstallation",{"title":278,"description":464},"installation","PtsEiD1MtLz3wDVCCGAWac0JxyBztTW1uRBbWQWqSOs",{"id":4,"title":5,"body":471,"description":152,"extension":153,"meta":559,"navigation":155,"order":156,"path":157,"seo":560,"stem":159,"__hash__":160},{"type":7,"value":472,"toc":551},[473,475,477,479,491,493,515,517,527,529,537,539,541,545,547],[10,474,5],{"id":5},[13,476,15],{},[17,478,19],{"id":19},[21,480,481,487,489],{},[24,482,483,30,485,34],{},[27,484,29],{},[27,486,33],{},[24,488,37],{},[24,490,40],{},[17,492,43],{"id":43},[21,494,495,501,503],{},[24,496,497,51,499,54],{},[27,498,50],{},[27,500,43],{},[24,502,57],{},[24,504,60,505],{},[62,506,507,511],{},[24,508,509,69],{},[27,510,68],{},[24,512,513,75],{},[27,514,74],{},[17,516,78],{"id":78},[13,518,81,519,85,521,91,523,95,525,99],{},[27,520,84],{},[87,522,90],{"href":89},[27,524,94],{},[27,526,98],{},[17,528,102],{"id":102},[13,530,531,108,533,113,535,117],{},[27,532,107],{},[110,534,112],{},[110,536,116],{},[13,538,120],{},[17,540,123],{"id":123},[13,542,126,543,130],{},[27,544,129],{},[17,546,133],{"id":133},[13,548,136,549,141],{},[87,550,140],{"href":139},{"title":143,"searchDepth":144,"depth":144,"links":552},[553,554,555,556,557,558],{"id":19,"depth":144,"text":19},{"id":43,"depth":144,"text":43},{"id":78,"depth":144,"text":78},{"id":102,"depth":144,"text":102},{"id":123,"depth":144,"text":123},{"id":133,"depth":144,"text":133},{},{"title":5,"description":152},{"id":562,"title":140,"body":563,"description":700,"extension":153,"meta":701,"navigation":155,"order":702,"path":703,"seo":704,"stem":705,"__hash__":706},"content_ja\u002Forganizing-sounds.md",{"type":7,"value":564,"toc":691},[565,567,570,573,598,605,608,611,625,632,635,641,644,654,657,660,664,667,673,679,683],[10,566,140],{"id":140},[13,568,569],{},"SoundNinjaは大規模ライブラリ向けです。タブ、グループ、検索、ホットキーで、必要なクリップをワンクリック（またはワンキー）で出せます。",[17,571,572],{"id":572},"タブ",[62,574,575,581,587],{},[24,576,577,580],{},[27,578,579],{},"タブを追加"," でタブを作り、色を付けてバーをすばやく眺められます。",[24,582,583,586],{},[27,584,585],{},"すべて"," ビューはタブを横断して全サウンドを表示します。",[24,588,589,590,593,594,597],{},"サウンドは ",[27,591,592],{},"1つ以上のタブ"," に所属できます。サウンドを右クリックし、",[27,595,596],{},"タブへ移動"," で割り当てます。",[13,599,600,601,604],{},"タブの切り替え演出は ",[27,602,603],{},"設定 → メイン","：スライド、フェード、ボタンを1つずつ、またはなし。",[17,606,607],{"id":607},"グループ",[13,609,610],{},"v0.5.3以降、セパレーターを名前付きグループにできます：",[62,612,613,616,619,622],{},[24,614,615],{},"コンテキストメニューからグループの追加、名前変更、削除",[24,617,618],{},"グループヘッダーをドラッグ — 子も一緒に動く",[24,620,621],{},"グループにサウンドを入れたり出したり",[24,623,624],{},"グループの枠線色、名前の色、ボタン配置を設定（またはタブのデフォルトを使う）",[13,626,627,628,631],{},"見た目の区切りだけなら、通常の ",[27,629,630],{},"セパレーター"," も追加できます。",[17,633,634],{"id":634},"検索",[13,636,637,638,640],{},"ナビバーの ",[27,639,634],{}," フィールドを使います。入力に合わせて結果が更新されます。",[17,642,643],{"id":643},"並べ替え",[13,645,646,649,650,653],{},[27,647,648],{},"設定 → 動作"," でドラッグ＆ドロップをオンにします（",[27,651,652],{},"並べ替えを許可","）。その後、サウンドとグループをドラッグして配置します。",[17,655,656],{"id":656},"一括編集",[13,658,659],{},"複数のサウンドを選び、色の変更、タブへの移動、削除を一度に行えます。",[17,661,663],{"id":662},"ホットキーとサウンドid","ホットキーとサウンドID",[13,665,666],{},"すべてのサウンドには8文字のIDがあります。ボタンのコンテキストメニュー、または複数選択のIDチップからコピーします。",[13,668,669,672],{},[27,670,671],{},"設定 → ホットキー"," を開き、キーをサウンドIDに割り当てます。グローバルホットキーは任意です。",[13,674,675,676,678],{},"同じIDを",[87,677,220],{"href":219},"がクリップのトリガーに使います。",[17,680,682],{"id":681},"gifと色","GIFと色",[13,684,685,686,690],{},"サウンドを右クリックして、ボタンごとの色やGIF \u002F 画像背景を設定します。ボード全体を整える",[87,687,689],{"href":688},"\u002Fdocs\u002Ftheme-editor","Theme Creator","とは別です。",{"title":143,"searchDepth":144,"depth":144,"links":692},[693,694,695,696,697,698,699],{"id":572,"depth":144,"text":572},{"id":607,"depth":144,"text":607},{"id":634,"depth":144,"text":634},{"id":643,"depth":144,"text":643},{"id":656,"depth":144,"text":656},{"id":662,"depth":144,"text":663},{"id":681,"depth":144,"text":682},"タブ、グループ、検索、一括編集、ホットキー。",{},4,"\u002Forganizing-sounds",{"title":140,"description":700},"organizing-sounds","0mH24BvA7-1dcjELHB8mQnjaQMzT8Ie60aamXtNUZEE",{"id":708,"title":709,"body":710,"description":832,"extension":153,"meta":833,"navigation":155,"order":834,"path":835,"seo":836,"stem":837,"__hash__":838},"content_ja\u002Ftheme-editor.md","テーマエディター",{"type":7,"value":711,"toc":826},[712,714,721,725,752,755,758,772,775,801,804,807,812],[10,713,709],{"id":709},[13,715,716,717,720],{},"Theme Creatorは、ボードの完全なビジュアルエディターです。",[27,718,719],{},"設定 → メイン → Theme Creator"," から開きます。",[17,722,724],{"id":723},"_3つのタブ","3つのタブ",[21,726,727,741,747],{},[24,728,729,732,733,736,737,740],{},[27,730,731],{},"一般"," — テーマ名、共有色、フォントのアップロード（",[110,734,735],{},".ttf"," \u002F ",[110,738,739],{},".otf","）",[24,742,743,746],{},[27,744,745],{},"ボタン"," — サウンドボタンの色、書体、レイアウト、GIFオーバーレイ",[24,748,749,751],{},[27,750,572],{}," — タブバーの色、書体、枠線の太さ",[13,753,754],{},"編集中、ライブプレビューがタブとボタンを表示します。",[17,756,757],{"id":757},"変更できる項目",[62,759,760,763,766,769],{},[24,761,762],{},"プライマリとアクセントの色、背景、ボタン色、タブ色",[24,764,765],{},"ボタンとタブのフォントファミリーとサイズ",[24,767,768],{},"ボタンの幅、半径、枠線幅、隙間、パディング",[24,770,771],{},"GIFオーバーレイの不透明度（通常とホバー）",[17,773,774],{"id":774},"保存と共有",[62,776,777,783,789,795],{},[24,778,779,782],{},[27,780,781],{},".cssをエクスポート"," — バックアップや友人への送信用テーマファイルを書き出す",[24,784,785,788],{},[27,786,787],{},"テーマに追加"," — Themesフォルダに保存して適用",[24,790,791,794],{},[27,792,793],{},".cssをインポート"," — 組み込みプリセットまたは保存済みテーマを読み込む",[24,796,797,800],{},[27,798,799],{},"リセット"," — SoundNinjaのデフォルトに戻す",[13,802,803],{},"未保存の変更があるままウィンドウを閉じると、SoundNinjaが先に保存を求めます。",[17,805,806],{"id":806},"フルエディターなしで",[13,808,809,811],{},[27,810,603],{}," でも次が可能です：",[62,813,814,817,823],{},[24,815,816],{},"リストからテーマを選ぶ",[24,818,819,820,740],{},"CSS変数をライブ編集する（",[27,821,822],{},"カスタムCSS",[24,824,825],{},"テーマファイルをThemesフォルダにインポートする",{"title":143,"searchDepth":144,"depth":144,"links":827},[828,829,830,831],{"id":723,"depth":144,"text":724},{"id":757,"depth":144,"text":757},{"id":774,"depth":144,"text":774},{"id":806,"depth":144,"text":806},"Theme Creatorで色、フォント、ボタン、タブをデザイン。",{},5,"\u002Ftheme-editor",{"title":709,"description":832},"theme-editor","tGeQE8HatAeqLeJ_3U4A-ac0RfIRzcoq-KghedjPolg",{"id":840,"title":841,"body":842,"description":968,"extension":153,"meta":969,"navigation":155,"order":970,"path":971,"seo":972,"stem":973,"__hash__":974},"content_ja\u002Frecording-editor.md","録音エディター",{"type":7,"value":843,"toc":962},[844,846,852,855,861,881,884,887,912,915,930,934,947,953],[10,845,841],{"id":841},[13,847,848,849,851],{},"SoundNinja内でクリップを録音し、トリムしてタブにインポートします。プレイヤーバーの ",[27,850,84],{}," ボタンでエディターを開きます。",[17,853,854],{"id":854},"入力を選ぶ",[13,856,857,860],{},[27,858,859],{},"設定 → オーディオ"," で：",[62,862,863,869,875],{},[24,864,865,868],{},[27,866,867],{},"入力デバイス"," — マイク",[24,870,871,874],{},[27,872,873],{},"出力デバイス（PCオーディオ）"," — PCが再生している音のループバック",[24,876,877,880],{},[27,878,879],{},"入力音量"," — キャプチャゲイン 0%〜200%",[13,882,883],{},"録音ボタンは、ここで選んだデバイスを使います。",[17,885,886],{"id":886},"テイクを編集",[62,888,889,892,895,903,906,909],{},[24,890,891],{},"録音と停止",[24,893,894],{},"入力レベルメーターを確認",[24,896,897,95,900],{},[27,898,899],{},"ノーマライズ",[27,901,902],{},"ノイズキャンセレーション",[24,904,905],{},"クリップ全体のトリム、選択範囲へのトリム、選択の削除",[24,907,908],{},"元に戻す \u002F やり直し",[24,910,911],{},"ズームインとズームアウト",[17,913,914],{"id":914},"ステージしてインポート",[21,916,917,920,923],{},[24,918,919],{},"選択範囲またはトラック全体をステージングリストに追加します。",[24,921,922],{},"リストは空から始まります。録音、編集、それからクリップを追加。",[24,924,925,95,927,929],{},[27,926,94],{},[27,928,98],{}," で、現在のタブまたは選んだタブに入れます。",[17,931,933],{"id":932},"ステム分離任意","ステム分離（任意）",[13,935,936,937,95,940,943,944,141],{},"Record EditorはBS-RoFormerで ",[27,938,939],{},"ボーカル",[27,941,942],{},"音楽"," を残せます。モデルは約158 MBで、アプリには ",[27,945,946],{},"同梱されていません",[13,948,949,952],{},[27,950,951],{},"設定 → ステム分離"," からダウンロードするか、初回起動のプロンプトを承認します。Windowsインストーラーも初回起動時にモデルのダウンロードを案内できます。",[13,954,955,956,736,959,54],{},"ソースからのステムビルドには追加フラグが必要です（",[110,957,958],{},"tauri:serve:stems",[110,960,961],{},"tauri:build:stems",{"title":143,"searchDepth":144,"depth":144,"links":963},[964,965,966,967],{"id":854,"depth":144,"text":854},{"id":886,"depth":144,"text":886},{"id":914,"depth":144,"text":914},{"id":932,"depth":144,"text":933},"マイクまたはPCオーディオを取り込み、クリップを編集してボードに置く。",{},6,"\u002Frecording-editor",{"title":841,"description":968},"recording-editor","fkw2G1vYZhqRZ8t2Y9irOID6H-BdjzVV8fvv-hE_qbo",{"id":976,"title":977,"body":978,"description":1189,"extension":153,"meta":1190,"navigation":155,"order":1191,"path":1192,"seo":1193,"stem":1194,"__hash__":1195},"content_ja\u002Fremote-control.md","リモートコントロール",{"type":7,"value":979,"toc":1182},[980,982,985,988,1020,1023,1026,1060,1063,1083,1086,1089,1121,1125,1131],[10,981,977],{"id":977},[13,983,984],{},"SoundNinjaはローカルネットワークで待ち受け、Bitfocus Companion（または任意のHTTP\u002FWebSocketクライアント）がサウンドを再生・停止できます。",[17,986,987],{"id":987},"リモートサーバーを有効化",[21,989,990,996,1003,1010],{},[24,991,992,995],{},[27,993,994],{},"設定 → リモート"," を開きます。",[24,997,998,999,1002],{},"リモートサーバーを有効にします。デフォルトポートは ",[27,1000,1001],{},"7331"," です。",[24,1004,1005,1006,1009],{},"任意：トークンを設定。クライアントはBearerトークンまたは ",[110,1007,1008],{},"?token="," で送ります。",[24,1011,1012,1015,1016,1019],{},[110,1013,1014],{},"http:\u002F\u002FIP:PORT"," URLをコピーするか、",[27,1017,1018],{},"設定 → 情報"," からシステムIPをコピーします。",[13,1021,1022],{},"Windowsはサーバー初回起動時にファイアウォールの確認を出すことがあります。プライベートネットワークのアクセスを許可してください。",[17,1024,220],{"id":1025},"bitfocus-companion",[21,1027,1028,1035,1043,1054],{},[24,1029,1030,1034],{},[87,1031,220],{"href":1032,"rel":1033},"https:\u002F\u002Fbitfocus.io\u002Fcompanion",[238],"をインストールします。",[24,1036,1037,1042],{},[87,1038,1041],{"href":1039,"rel":1040},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Freleases\u002Flatest\u002Fdownload\u002Fcompanion-module-soundninja.tgz",[238],"companion-module-soundninja.tgz"," をダウンロード。Companion Storeのパッケージはまだありません。",[24,1044,1045,1046,1049,1050,1053],{},"Companionで ",[27,1047,1048],{},"Modules → Load module package"," を開き、",[110,1051,1052],{},".tgz"," を選びます。",[24,1055,1056,1059],{},[27,1057,1058],{},"Sound Ninja"," 接続を追加。PCのIP、ポート、設定したトークンを貼り付けます。",[17,1061,1062],{"id":1062},"アクション",[62,1064,1065,1071,1077],{},[24,1066,1067,1070],{},[27,1068,1069],{},"Trigger Sound"," — ライブドロップダウンから選ぶか、8文字のサウンドIDを入力（Companion変数が使えます）",[24,1072,1073,1076],{},[27,1074,1075],{},"Stop Sound"," — IDで再生中のサウンドを1つ停止",[24,1078,1079,1082],{},[27,1080,1081],{},"Stop All"," — 再生中の全サウンドを停止",[13,1084,1085],{},"SoundNinjaでは、ボタンのコンテキストメニューまたは複数選択のIDチップからサウンドIDをコピーします。",[17,1087,1088],{"id":1088},"フィードバックと変数",[62,1090,1091,1097,1109,1115],{},[24,1092,1093,1096],{},[27,1094,1095],{},"Sound Playing"," — そのサウンドIDがアクティブな間はtrue（ボタン色に使う）",[24,1098,1099,1102,1103,736,1106],{},[110,1100,1101],{},"$(soundninja:connected)"," — ",[110,1104,1105],{},"true",[110,1107,1108],{},"false",[24,1110,1111,1114],{},[110,1112,1113],{},"$(soundninja:playing_count)"," — 再生中のサウンド数",[24,1116,1117,1120],{},[110,1118,1119],{},"$(soundninja:last_triggered)"," — 最後にトリガーしたサウンドID",[17,1122,1124],{"id":1123},"http-api上級","HTTP API（上級）",[13,1126,1127,1128],{},"ベースパス：",[110,1129,1130],{},"\u002Fapi\u002Fv1",[62,1132,1133,1139,1145,1151,1161,1167,1176],{},[24,1134,1135,1138],{},[110,1136,1137],{},"GET \u002Finfo"," — アプリ名、バージョン、プロトコル、トークンが必要か",[24,1140,1141,1144],{},[110,1142,1143],{},"GET \u002Fsounds"," — サウンド一覧（id、name、tabs、active）",[24,1146,1147,1150],{},[110,1148,1149],{},"GET \u002Fstate"," — サウンドと現在再生中のID",[24,1152,1153,1156,1157,1160],{},[110,1154,1155],{},"POST \u002Ftrigger"," に ",[110,1158,1159],{},"{ \"id\" }"," — サウンドを再生",[24,1162,1163,1166],{},[110,1164,1165],{},"GET \u002Ftrigger\u002F:id"," — 再生（ブラウザで簡単にテスト）",[24,1168,1169,1172,1173,1175],{},[110,1170,1171],{},"POST \u002Fstop"," に任意の ",[110,1174,1159],{}," — 1つまたはすべて停止",[24,1177,1178,1181],{},[110,1179,1180],{},"GET \u002Fws"," — ライブ状態。trigger\u002Fstopコマンドを受信",{"title":143,"searchDepth":144,"depth":144,"links":1183},[1184,1185,1186,1187,1188],{"id":987,"depth":144,"text":987},{"id":1025,"depth":144,"text":220},{"id":1062,"depth":144,"text":1062},{"id":1088,"depth":144,"text":1088},{"id":1123,"depth":144,"text":1124},"ローカルネットワーク経由でBitfocus CompanionからSoundNinjaを操作。",{},7,"\u002Fremote-control",{"title":977,"description":1189},"remote-control","PoAD2qLfe4cF4Z_a5pIF5291-yAlbNAcy3yNZfTB5RM",{"id":1197,"title":1198,"body":1199,"description":1284,"extension":153,"meta":1285,"navigation":155,"order":1286,"path":1287,"seo":1288,"stem":1289,"__hash__":1290},"content_ja\u002Fsupport.md","サポート",{"type":7,"value":1200,"toc":1277},[1201,1203,1206,1209,1212,1219,1227,1230,1237,1239,1252,1255,1267,1270],[10,1202,1198],{"id":1198},[13,1204,1205],{},"SoundNinjaは初期ベータのコミュニティプロジェクトです。いちばん早い助けはGitHubです。",[17,1207,1208],{"id":1208},"バグ報告または質問",[13,1210,1211],{},"GitHubでissueを開いてください：",[13,1213,1214],{},[87,1215,1218],{"href":1216,"rel":1217},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fissues",[238],"github.com\u002Fmarcus-universe\u002FSoundNinja\u002Fissues",[13,1220,1221,1222,95,1224,1226],{},"OS、SoundNinjaのバージョン（",[27,1223,388],{},[27,1225,1018],{},"）、再現手順を書いてください。",[17,1228,1229],{"id":1229},"メール",[13,1231,1232,1233],{},"メンテナー連絡先：",[87,1234,1236],{"href":1235},"mailto:contact@marcus-universe.de","contact@marcus-universe.de",[17,1238,382],{"id":382},[13,1240,385,1241,1243,1244,1246,1247,1251],{},[27,1242,388],{}," を使います。新しいビルドは",[87,1245,288],{"href":287},"と",[87,1248,294],{"href":1249,"rel":1250},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Freleases",[238],"にも出ます。",[17,1253,1254],{"id":1254},"コントリビュート",[13,1256,1257,1258,1262,1263,1266],{},"プルリクエストを歓迎します。アプリのリポジトリは",[87,1259,1261],{"href":398,"rel":1260},[238],"github.com\u002Fmarcus-universe\u002FSoundNinja","です。プロジェクトは",[87,1264,239],{"href":236,"rel":1265},[238],"ライセンスです。",[17,1268,1269],{"id":1269},"法的情報",[13,1271,1272,1273,141],{},"インプリントと連絡先：",[87,1274,1276],{"href":1275},"\u002Fimpressum","インプリント",{"title":143,"searchDepth":144,"depth":144,"links":1278},[1279,1280,1281,1282,1283],{"id":1208,"depth":144,"text":1208},{"id":1229,"depth":144,"text":1229},{"id":382,"depth":144,"text":382},{"id":1254,"depth":144,"text":1254},{"id":1269,"depth":144,"text":1269},"ヘルプの入手先とバグ報告。",{},8,"\u002Fsupport",{"title":1198,"description":1284},"support","T2BdU-sWENDKBxowzv9wjeevj1bEK3iit1IGD77Vz_M",1788384660660]