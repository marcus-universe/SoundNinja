[{"data":1,"prerenderedAt":1750},["ShallowReactive",2],{"docs-page-ja-\u002Forganizing-sounds":3,"docs-nav-ja":424},{"id":4,"title":5,"body":6,"description":415,"extension":416,"meta":417,"navigation":418,"order":419,"path":420,"seo":421,"stem":422,"__hash__":423},"content_ja\u002Forganizing-sounds.md","サウンドの整理",{"type":7,"value":8,"toc":397},"minimark",[9,12,21,25,52,59,62,65,79,86,93,97,107,111,142,145,151,154,188,195,199,202,229,232,236,249,252,257,278,294,301,304,315,318,322,329,339,348,351,359,366,394],[10,11,5],"h1",{"id":5},[13,14,15,16,20],"p",{},"SoundNinjaは大規模ライブラリ向けです。",[17,18,19],"strong",{},"タグとフィルター","、タブ、検索、複数選択、ホットキーで、必要なクリップをワンクリック（またはワンキー）で出せます。",[22,23,24],"h2",{"id":24},"タブ",[26,27,28,35,41],"ul",{},[29,30,31,34],"li",{},[17,32,33],{},"タブを追加"," でタブを作り、色を付けてバーをすばやく眺められます。",[29,36,37,40],{},[17,38,39],{},"すべて"," ビューはタブを横断して全サウンドを表示します。",[29,42,43,44,47,48,51],{},"サウンドは ",[17,45,46],{},"1つ以上のタブ"," に所属できます。サウンドを右クリックし、",[17,49,50],{},"タブへ移動"," で割り当てます。",[13,53,54,55,58],{},"タブの切り替え演出は ",[17,56,57],{},"設定 → メイン","：スライド、フェード、ボタンを1つずつ、またはなし。",[22,60,61],{"id":61},"グループ",[13,63,64],{},"v0.5.3以降、セパレーターを名前付きグループにできます：",[26,66,67,70,73,76],{},[29,68,69],{},"コンテキストメニューからグループの追加、名前変更、削除",[29,71,72],{},"グループヘッダーをドラッグ — 子も一緒に動く",[29,74,75],{},"グループにサウンドを入れたり出したり",[29,77,78],{},"グループの枠線色、名前の色、ボタン配置を設定（またはタブのデフォルトを使う）",[13,80,81,82,85],{},"見た目の区切りだけなら、通常の ",[17,83,84],{},"セパレーター"," も追加できます。",[13,87,88,89,92],{},"ボードの空き領域を右クリックして ",[17,90,91],{},"グループを追加","。",[22,94,96],{"id":95},"タグ-フィルター","タグ \u002F フィルター",[13,98,99,100,103,104,106],{},"タグはタブを横断します。スライドアウトの ",[17,101,102],{},"フィルター"," パネル（サイドバー ",[17,105,102],{},"）で作成し、ボードを絞ります。",[108,109,110],"h3",{"id":110},"タグの作成と編集",[112,113,114,120,130,136],"ol",{},[29,115,116,117,119],{},"サイドバーで ",[17,118,102],{}," を開く。",[29,121,122,125,126,129],{},[17,123,124],{},"タグ"," の ",[17,127,128],{},"タグを追加"," — 名前と色を付ける。",[29,131,132,133,92],{},"同じリストで名前変更、色変更、",[17,134,135],{},"タグを削除",[29,137,138,141],{},[17,139,140],{},"タグはまだありません"," と出たら、割り当てる前にここで追加する。",[108,143,144],{"id":144},"サウンドにタグを付ける",[13,146,147,148,150],{},"サウンドを右クリック → ",[17,149,124],{},"（チェックボックス）。1つのサウンドに複数可。タグが無い場合、メニューはフィルターパネルへ案内します。",[108,152,153],{"id":153},"ボードをフィルター",[26,155,156,163,174,185],{},[29,157,158,159,162],{},"フィルターパネル、または ",[17,160,161],{},"検索バー下のチップ"," でタグを切り替え。",[29,164,165,166,169,170,173],{},"一致は ",[17,167,168],{},"OR","：選択したタグの ",[17,171,172],{},"いずれか"," を持つサウンドが表示される。",[29,175,176,177,180,181,184],{},"ナビバーの ",[17,178,179],{},"検索"," は有効なタグフィルターと ",[17,182,183],{},"AND","（入力 + タグ）。",[29,186,187],{},"チップをオフ（またはフィルター解除）でタブ全体を再表示。",[13,189,190,191,194],{},"色付きタグ名をボタンに表示できます。",[17,192,193],{},"設定 → 動作 → タグバッジを表示"," で切り替え。",[22,196,198],{"id":197},"並べ替えソート","並べ替え（ソート）",[13,200,201],{},"フィルターパネルでソートモードを選びます：",[26,203,204,210],{},[29,205,206,209],{},[17,207,208],{},"ユーザー定義"," — タブ順、グループ表示",[29,211,212,215,216,215,219,215,222,225,226],{},[17,213,214],{},"名前","、",[17,217,218],{},"追加日時",[17,220,221],{},"再生時間",[17,223,224],{},"ファイルサイズ"," — フラットなソート一覧。これらのモードでは ",[17,227,228],{},"グループは非表示",[13,230,231],{},"再生時間ソートは、初回に長さのメタデータを準備することがあります。",[22,233,235],{"id":234},"並べ替えドラッグ","並べ替え（ドラッグ）",[13,237,238,241,242,245,246,248],{},[17,239,240],{},"設定 → 動作"," でドラッグ＆ドロップをオンにします（",[17,243,244],{},"並べ替えを許可","）。その後、サウンドとグループをドラッグして配置します。ドラッグ並べ替えは ",[17,247,208],{}," ソートで有効です。",[22,250,251],{"id":251},"複数選択",[13,253,176,254,256],{},[17,255,251],{}," をオンにして：",[26,258,259,262,268,275],{},[29,260,261],{},"クリックでサウンドをトグル",[29,263,264,267],{},[17,265,266],{},"Shift+クリック"," で直前のアンカーから範囲選択",[29,269,270,271,274],{},"空きボード上で ",[17,272,273],{},"マーキー"," をドラッグ",[29,276,277],{},"空きボード（または外側）をクリックして選択解除",[13,279,280,281,215,284,215,287,215,290,293],{},"一括バーに件数が表示され、",[17,282,283],{},"色",[17,285,286],{},"タブへ移動…",[17,288,289],{},"削除",[17,291,292],{},"完了"," が使えます。",[13,295,296,297,300],{},"複数選択中、各ボタンに ",[17,298,299],{},"8文字のIDチップ"," が出ます。チップを右クリックでコピー。",[22,302,303],{"id":303},"サウンドごとの音量",[13,305,306,307,310,311,314],{},"右クリック → ",[17,308,309],{},"音量","。スライダーを 0%〜100%。",[17,312,313],{},"ダブルクリック"," で 100% にリセット。",[13,316,317],{},"設定のマスター出力音量と重ねて効きます。",[22,319,321],{"id":320},"ホットキーとサウンドid","ホットキーとサウンドID",[13,323,324,325,328],{},"すべてのサウンドには8文字のIDがあります。ボタンのコンテキストメニュー（",[17,326,327],{},"IDをコピー","）、または複数選択のIDチップからコピーします。",[13,330,331,334,335,338],{},[17,332,333],{},"設定 → ホットキー"," を開き、キーをサウンドIDに割り当てます。グローバルホットキーは任意です。コンテキストメニューの ",[17,336,337],{},"ホットキーを割り当て"," は、IDを埋めた状態でそこにジャンプします。",[13,340,341,342,347],{},"同じIDを",[343,344,346],"a",{"href":345},"\u002Fdocs\u002Fremote-control","Bitfocus Companion","がクリップのトリガーに使います。",[22,349,350],{"id":350},"背景画像と色",[13,352,353,354,358],{},"サウンドを右クリックして、ボタンごとの色や背景画像を設定します。ボード全体を整える",[343,355,357],{"href":356},"\u002Fdocs\u002Ftheme-editor","Theme Creator","とは別です。",[13,360,361,362,365],{},"ピッカーは ",[17,363,364],{},"背景画像"," ダイアログ（PNG、JPEG、GIF、WebP）：",[26,367,368,374,385],{},[29,369,370,373],{},[17,371,372],{},"ローカルファイル"," — フォルダ追加、単一ファイル選択、ファイル名検索、グリッドプレビュー、ライブラリからフォルダ削除",[29,375,376,379,380],{},[17,377,378],{},"GifSnap"," — APIキーなしでオンラインGIFを検索。初回は GifSnap へのリクエスト許可を求めます。検索結果はキャッシュして通信を減らします。",[343,381,378],{"href":382,"rel":383},"https:\u002F\u002Fgifsnap.com",[384],"nofollow",[29,386,387,390,391,393],{},[17,388,389],{},"KLIPY"," — オンラインGIFを検索。APIキーは ",[17,392,240],{},"。キーはプロジェクトファイルには保存されません。",[13,395,396],{},"画像を選んだあと、ボタン上でパンとクロップできます。",{"title":398,"searchDepth":399,"depth":399,"links":400},"",2,[401,402,403,409,410,411,412,413,414],{"id":24,"depth":399,"text":24},{"id":61,"depth":399,"text":61},{"id":95,"depth":399,"text":96,"children":404},[405,407,408],{"id":110,"depth":406,"text":110},3,{"id":144,"depth":406,"text":144},{"id":153,"depth":406,"text":153},{"id":197,"depth":399,"text":198},{"id":234,"depth":399,"text":235},{"id":251,"depth":399,"text":251},{"id":303,"depth":399,"text":303},{"id":320,"depth":399,"text":321},{"id":350,"depth":399,"text":350},"タグ、フィルター、タブ、グループ、並べ替え、複数選択、音量、ホットキー。","md",{},true,4,"\u002Forganizing-sounds",{"title":5,"description":415},"organizing-sounds","7eo3HsiR87FfpmaZ2egiJxhWDKGaOqGKyaXl1gmdAbY",[425,546,765,904,1161,1293,1434,1655],{"id":426,"title":427,"body":428,"description":539,"extension":416,"meta":540,"navigation":418,"order":541,"path":542,"seo":543,"stem":544,"__hash__":545},"content_ja\u002Foverview.md","概要",{"type":7,"value":429,"toc":533},[430,432,435,438,441,444,458,461,498,501,510,513],[10,431,427],{"id":427},[13,433,434],{},"SoundNinjaは、ライブ配信、友だちとのチャット、ポッドキャスト収録向けのオープンソースサウンドボードです。Tauri v2とNuxt 4で構築されており、RAMとディスクの負荷を抑えています。",[13,436,437],{},"目標はシンプルです。巨大なサウンドライブラリをすばやく眺め、目的のクリップをミリ秒で再生すること。UIはVRのダッシュボードとしても使いやすいです。",[13,439,440],{},"SoundNinjaはまだ初期開発段階です。機能は動きますが、すべてのプラットフォームで完全に検証されているわけではありません。",[22,442,443],{"id":443},"対象ユーザー",[26,445,446,449,452,455],{},[29,447,448],{},"即時のサウンドキューが必要な配信者",[29,450,451],{},"ボイスチャット用の共有ボードが欲しい友だち",[29,453,454],{},"クリップを録ってボードに置くポッドキャスター",[29,456,457],{},"カスタマイズ可能な、ローカル優先のサウンドボードが欲しい人",[22,459,460],{"id":460},"できること",[26,462,463,466,469,472,475,478,481,484,487,492,495],{},[29,464,465],{},"自分の音声ファイルからサウンドボードを作る",[29,467,468],{},"色付きタブ、グループ、タグ、検索で整理する",[29,470,471],{},"タグでフィルター（OR）、名前・日付・長さ・サイズでソート",[29,473,474],{},"マーキーまたはShift範囲で複数選択し、色・移動・削除を一括",[29,476,477],{},"コンテキストメニューでサウンドごとの音量を設定",[29,479,480],{},"Theme Creatorで見た目をデザインする",[29,482,483],{},"Record EditorでPCオーディオまたはマイクを録音する",[29,485,486],{},"個別のサウンドにホットキーを割り当てる",[29,488,489,491],{},[343,490,346],{"href":345},"からサウンドをトリガーする",[29,493,494],{},"サウンドボード全体をインポート／エクスポートして共有する",[29,496,497],{},"サウンドボタンにGIFや画像を使う — ローカルフォルダライブラリ、GifSnap、またはKLIPY",[22,499,500],{"id":500},"ライセンス",[13,502,503,504,509],{},"SoundNinjaは",[343,505,508],{"href":506,"rel":507},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fblob\u002Fmain\u002FLICENSE",[384],"GPL-3.0","のフリーソフトウェアです。フォーク、改変、共有できます。",[22,511,512],{"id":512},"次のステップ",[112,514,515,521,527],{},[29,516,517],{},[343,518,520],{"href":519},"\u002Fdocs\u002Finstallation","SoundNinjaをインストール",[29,522,523],{},[343,524,526],{"href":525},"\u002Fdocs\u002Fadding-sounds","サウンドを追加",[29,528,529],{},[343,530,532],{"href":531},"\u002Fdocs\u002Forganizing-sounds","ボードを整理",{"title":398,"searchDepth":399,"depth":399,"links":534},[535,536,537,538],{"id":443,"depth":399,"text":443},{"id":460,"depth":399,"text":460},{"id":500,"depth":399,"text":500},{"id":512,"depth":399,"text":512},"SoundNinjaとは何か、何ができるか。",{},1,"\u002Foverview",{"title":427,"description":539},"overview","RKMKM6lywYS2prTGRayXesPcG2_CgQLEmJfr9msg1eE",{"id":547,"title":548,"body":549,"description":759,"extension":416,"meta":760,"navigation":418,"order":399,"path":761,"seo":762,"stem":763,"__hash__":764},"content_ja\u002Finstallation.md","インストール",{"type":7,"value":550,"toc":752},[551,553,566,570,591,594,598,612,615,619,644,654,657,664,667,682,712,727,748],[10,552,548],{"id":548},[13,554,555,559,560,565],{},[343,556,558],{"href":557},"\u002Fdownload","ダウンロードページ","または",[343,561,564],{"href":562,"rel":563},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Freleases\u002Flatest",[384],"GitHub Releases","からビルドを入手してください。SoundNinjaは初期開発中なので、ビルドはベータとして扱ってください。",[22,567,569],{"id":568},"windows","Windows",[26,571,572,582,585,588],{},[29,573,574,575,578,579],{},"64ビットWindows向けの",[17,576,577],{},"インストーラー (.exe)"," または ",[17,580,581],{},"MSI (.msi)",[29,583,584],{},"ランディングページの対象：Windows 10以降",[29,586,587],{},"アプリのREADMEはWindows 8以上も記載",[29,589,590],{},"NSISインストーラーはダークテーマ。セットアップ時に言語を選ぶと、次回起動時にSoundNinjaが覚えます。",[13,592,593],{},"インストーラーを実行し、スタートメニューからSoundNinjaを起動します。",[22,595,597],{"id":596},"macos","macOS",[26,599,600,606,609],{},[29,601,602,603],{},"Apple SiliconとIntel向けの",[17,604,605],{},"ユニバーサル .dmg",[29,607,608],{},"ランディングページの対象：macOS 10.14以降",[29,610,611],{},"アプリのREADMEはmacOS 10.15以上を記載",[13,613,614],{},"ディスクイメージを開き、SoundNinjaをアプリケーションにドラッグします。",[22,616,618],{"id":617},"linux","Linux",[26,620,621,627,633,641],{},[29,622,623,624],{},"Ubuntu \u002F Debian向けの",[17,625,626],{},"Debian (.deb)",[29,628,629,630],{},"その他のディストリ向けの",[17,631,632],{},"AppImage",[29,634,635,636,640],{},"リリース公開後、ArchユーザーはAURから",[637,638,639],"code",{},"soundninja-bin","をインストールできます",[29,642,643],{},"Ubuntu 20.04でテスト済み",[13,645,646,647,215,650,653],{},"デスクトップビルドにはWebKitとGTKのパッケージが必要です。Debian\u002FUbuntuでは通常、",[637,648,649],{},"libwebkit2gtk",[637,651,652],{},"libgtk-3-0","、app-indicatorライブラリです。",[22,655,656],{"id":656},"アップデート",[13,658,659,660,663],{},"アプリ内で ",[17,661,662],{},"ヘルプ → アップデートを確認"," を開きます。設定で起動時にSoundNinjaが確認するようにもできます。",[22,665,666],{"id":666},"ソースからビルド",[13,668,669,670,675,676,681],{},"カスタムビルドが必要なら、",[343,671,674],{"href":672,"rel":673},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja",[384],"リポジトリ","をクローンし、",[343,677,680],{"href":678,"rel":679},"https:\u002F\u002Fv2.tauri.app\u002Fstart\u002Fprerequisites\u002F",[384],"Tauriの前提条件","を入れたうえで：",[683,684,688],"pre",{"className":685,"code":686,"language":687,"meta":398,"style":398},"language-bash shiki shiki-themes github-light github-dark","bun install\nbun run tauri:serve\n","bash",[637,689,690,702],{"__ignoreMap":398},[691,692,694,698],"span",{"class":693,"line":541},"line",[691,695,697],{"class":696},"sScJk","bun",[691,699,701],{"class":700},"sZZnC"," install\n",[691,703,704,706,709],{"class":693,"line":399},[691,705,697],{"class":696},[691,707,708],{"class":700}," run",[691,710,711],{"class":700}," tauri:serve\n",[13,713,714,215,717,215,720,723,724,92],{},[637,715,716],{},"npm",[637,718,719],{},"pnpm",[637,721,722],{},"deno","でも動きます。本番ビルド：",[637,725,726],{},"bun run tauri:build",[13,728,729,732,733,738,739,742,743,92],{},[17,730,731],{},"Windowsのみ:"," Windowsビルドはすべて ",[343,734,737],{"href":735,"rel":736},"https:\u002F\u002Fwww.steinberg.net\u002Fasiosdk",[384],"Steinberg ASIO SDK"," 経由でASIOを含めます。一度 ",[637,740,741],{},"bun run setup:asio"," を実行（SDKはgitに含まれません）。Linux \u002F macOSは PipeWire \u002F Core Audio — この手順は不要。詳細: ",[343,744,747],{"href":745,"rel":746},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fblob\u002Fmain\u002Fdocs\u002Fbuild-from-source.md",[384],"build-from-source.md",[749,750,751],"style",{},"html pre.shiki code .sScJk, html code.shiki .sScJk{--shiki-default:#6F42C1;--shiki-dark:#B392F0}html pre.shiki code .sZZnC, html code.shiki .sZZnC{--shiki-default:#032F62;--shiki-dark:#9ECBFF}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html.dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}",{"title":398,"searchDepth":399,"depth":399,"links":753},[754,755,756,757,758],{"id":568,"depth":399,"text":569},{"id":596,"depth":399,"text":597},{"id":617,"depth":399,"text":618},{"id":656,"depth":399,"text":656},{"id":666,"depth":399,"text":666},"Windows、macOS、LinuxにSoundNinjaをインストール。",{},"\u002Finstallation",{"title":548,"description":759},"installation","IjZd1P7FnQS2uqb_Mqyrc5OsF5e06cfW8q5sH_3_mkY",{"id":766,"title":767,"body":768,"description":898,"extension":416,"meta":899,"navigation":418,"order":406,"path":900,"seo":901,"stem":902,"__hash__":903},"content_ja\u002Fadding-sounds.md","サウンドの追加",{"type":7,"value":769,"toc":890},[770,772,775,778,796,799,830,833,852,855,869,872,875,882,885],[10,771,767],{"id":767},[13,773,774],{},"クリップを追加するまで、ボードは空です。SoundNinjaはファイル、フォルダ全体、録音、共有サウンドボードパックをインポートできます。",[22,776,777],{"id":777},"音声ファイルをインポート",[112,779,780,790,793],{},[29,781,782,785,786,789],{},[17,783,784],{},"ファイル → 音声ファイルをインポート","、またはナビバーの ",[17,787,788],{},"インポート"," を使います。",[29,791,792],{},"1つ以上の音声ファイルを選びます。",[29,794,795],{},"サウンドは現在のタブに入ります。",[22,797,798],{"id":798},"フォルダをインポート",[112,800,801,810,813],{},[29,802,803,806,807,809],{},[17,804,805],{},"ファイル → フォルダをインポート","（またはナビバーの ",[17,808,798],{},"）。",[29,811,812],{},"1つ以上のフォルダを追加。インポート前にドラッグで並べ替えできます。",[29,814,815,816],{},"配置方法を選びます：\n",[26,817,818,824],{},[29,819,820,823],{},[17,821,822],{},"タブとしてインポート"," — 各フォルダが独自のタブになる",[29,825,826,829],{},[17,827,828],{},"現在のタブにインポート"," — すべてのファイルがアクティブなタブに入る",[22,831,832],{"id":832},"クリップを録音",[13,834,835,836,839,840,844,845,578,848,851],{},"プレイヤーバーの ",[17,837,838],{},"録音"," ボタンから",[343,841,843],{"href":842},"\u002Fdocs\u002Frecording-editor","Record Editor","を開きます。キャプチャ、トリムし、",[17,846,847],{},"選択をインポート",[17,849,850],{},"すべてインポート"," で現在のタブまたは選んだタブに入れます。",[22,853,854],{"id":854},"サウンドボードをインポート",[13,856,857,860,861,864,865,868],{},[17,858,859],{},"ファイル → サウンドボードをインポート"," で共有パックを読み込みます。パックは ",[637,862,863],{},"project.sninja"," とサウンドファイルを含む ",[637,866,867],{},".zip"," です。インポート後、プロジェクトを開いて再生します。",[13,870,871],{},"複数のプロジェクト（プロファイル）も保てます。プロジェクトセレクターでボードを切り替えます。",[22,873,874],{"id":874},"見つからないファイルを再リンク",[13,876,877,878,881],{},"ディスク上で音声ファイルが移動すると、SoundNinjaは ",[17,879,880],{},"見つからないサウンドファイル"," ダイアログを表示します。検索するフォルダを選び、クリップを再リンクします。",[22,883,884],{"id":884},"次へ",[13,886,887,888,92],{},"タブ、タグ、フィルター、ホットキーの整理は",[343,889,5],{"href":531},{"title":398,"searchDepth":399,"depth":399,"links":891},[892,893,894,895,896,897],{"id":777,"depth":399,"text":777},{"id":798,"depth":399,"text":798},{"id":832,"depth":399,"text":832},{"id":854,"depth":399,"text":854},{"id":874,"depth":399,"text":874},{"id":884,"depth":399,"text":884},"音声、フォルダ、録音、共有サウンドボードをインポート。",{},"\u002Fadding-sounds",{"title":767,"description":898},"adding-sounds","5_cjd2COcPz0pj4ZrBehCZv6ouzBimE8UGjkcfngQjw",{"id":4,"title":5,"body":905,"description":415,"e