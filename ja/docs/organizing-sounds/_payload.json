[{"data":1,"prerenderedAt":1298},["ShallowReactive",2],{"docs-page-ja-\u002Forganizing-sounds":3,"docs-nav-ja":164},{"id":4,"title":5,"body":6,"description":155,"extension":156,"meta":157,"navigation":158,"order":159,"path":160,"seo":161,"stem":162,"__hash__":163},"content_ja\u002Forganizing-sounds.md","サウンドの整理",{"type":7,"value":8,"toc":144},"minimark",[9,12,16,20,48,55,58,61,75,82,85,91,94,104,107,110,114,117,123,132,136],[10,11,5],"h1",{"id":5},[13,14,15],"p",{},"SoundNinjaは大規模ライブラリ向けです。タブ、グループ、検索、ホットキーで、必要なクリップをワンクリック（またはワンキー）で出せます。",[17,18,19],"h2",{"id":19},"タブ",[21,22,23,31,37],"ul",{},[24,25,26,30],"li",{},[27,28,29],"strong",{},"タブを追加"," でタブを作り、色を付けてバーをすばやく眺められます。",[24,32,33,36],{},[27,34,35],{},"すべて"," ビューはタブを横断して全サウンドを表示します。",[24,38,39,40,43,44,47],{},"サウンドは ",[27,41,42],{},"1つ以上のタブ"," に所属できます。サウンドを右クリックし、",[27,45,46],{},"タブへ移動"," で割り当てます。",[13,49,50,51,54],{},"タブの切り替え演出は ",[27,52,53],{},"設定 → メイン","：スライド、フェード、ボタンを1つずつ、またはなし。",[17,56,57],{"id":57},"グループ",[13,59,60],{},"v0.5.3以降、セパレーターを名前付きグループにできます：",[21,62,63,66,69,72],{},[24,64,65],{},"コンテキストメニューからグループの追加、名前変更、削除",[24,67,68],{},"グループヘッダーをドラッグ — 子も一緒に動く",[24,70,71],{},"グループにサウンドを入れたり出したり",[24,73,74],{},"グループの枠線色、名前の色、ボタン配置を設定（またはタブのデフォルトを使う）",[13,76,77,78,81],{},"見た目の区切りだけなら、通常の ",[27,79,80],{},"セパレーター"," も追加できます。",[17,83,84],{"id":84},"検索",[13,86,87,88,90],{},"ナビバーの ",[27,89,84],{}," フィールドを使います。入力に合わせて結果が更新されます。",[17,92,93],{"id":93},"並べ替え",[13,95,96,99,100,103],{},[27,97,98],{},"設定 → 動作"," でドラッグ＆ドロップをオンにします（",[27,101,102],{},"並べ替えを許可","）。その後、サウンドとグループをドラッグして配置します。",[17,105,106],{"id":106},"一括編集",[13,108,109],{},"複数のサウンドを選び、色の変更、タブへの移動、削除を一度に行えます。",[17,111,113],{"id":112},"ホットキーとサウンドid","ホットキーとサウンドID",[13,115,116],{},"すべてのサウンドには8文字のIDがあります。ボタンのコンテキストメニュー、または複数選択のIDチップからコピーします。",[13,118,119,122],{},[27,120,121],{},"設定 → ホットキー"," を開き、キーをサウンドIDに割り当てます。グローバルホットキーは任意です。",[13,124,125,126,131],{},"同じIDを",[127,128,130],"a",{"href":129},"\u002Fdocs\u002Fremote-control","Bitfocus Companion","がクリップのトリガーに使います。",[17,133,135],{"id":134},"gifと色","GIFと色",[13,137,138,139,143],{},"サウンドを右クリックして、ボタンごとの色やGIF \u002F 画像背景を設定します。ボード全体を整える",[127,140,142],{"href":141},"\u002Fdocs\u002Ftheme-editor","Theme Creator","とは別です。",{"title":145,"searchDepth":146,"depth":146,"links":147},"",2,[148,149,150,151,152,153,154],{"id":19,"depth":146,"text":19},{"id":57,"depth":146,"text":57},{"id":84,"depth":146,"text":84},{"id":93,"depth":146,"text":93},{"id":106,"depth":146,"text":106},{"id":112,"depth":146,"text":113},{"id":134,"depth":146,"text":135},"タブ、グループ、検索、一括編集、ホットキー。","md",{},true,4,"\u002Forganizing-sounds",{"title":5,"description":155},"organizing-sounds","0mH24BvA7-1dcjELHB8mQnjaQMzT8Ie60aamXtNUZEE",[165,279,476,616,710,842,978,1203],{"id":166,"title":167,"body":168,"description":272,"extension":156,"meta":273,"navigation":158,"order":274,"path":275,"seo":276,"stem":277,"__hash__":278},"content_ja\u002Foverview.md","概要",{"type":7,"value":169,"toc":266},[170,172,175,178,181,184,198,201,229,232,242,245],[10,171,167],{"id":167},[13,173,174],{},"SoundNinjaは、ライブ配信、友だちとのチャット、ポッドキャスト収録向けのオープンソースサウンドボードです。Tauri v2とNuxt 4で構築されており、RAMとディスクの負荷を抑えています。",[13,176,177],{},"目標はシンプルです。巨大なサウンドライブラリをすばやく眺め、目的のクリップをミリ秒で再生すること。UIはVRのダッシュボードとしても使いやすいです。",[13,179,180],{},"SoundNinjaはまだ初期開発段階です。機能は動きますが、すべてのプラットフォームで完全に検証されているわけではありません。",[17,182,183],{"id":183},"対象ユーザー",[21,185,186,189,192,195],{},[24,187,188],{},"即時のサウンドキューが必要な配信者",[24,190,191],{},"ボイスチャット用の共有ボードが欲しい友だち",[24,193,194],{},"クリップを録ってボードに置くポッドキャスター",[24,196,197],{},"カスタマイズ可能な、ローカル優先のサウンドボードが欲しい人",[17,199,200],{"id":200},"できること",[21,202,203,206,209,212,215,218,223,226],{},[24,204,205],{},"自分の音声ファイルからサウンドボードを作る",[24,207,208],{},"色付きタブ、グループ、検索で整理する",[24,210,211],{},"Theme Creatorで見た目をデザインする",[24,213,214],{},"Record EditorでPCオーディオまたはマイクを録音する",[24,216,217],{},"個別のサウンドにホットキーを割り当てる",[24,219,220,222],{},[127,221,130],{"href":129},"からサウンドをトリガーする",[24,224,225],{},"サウンドボード全体をインポート／エクスポートして共有する",[24,227,228],{},"サウンドボタンにGIFや画像を使う",[17,230,231],{"id":231},"ライセンス",[13,233,234,235,241],{},"SoundNinjaは",[127,236,240],{"href":237,"rel":238},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fblob\u002Fmain\u002FLICENSE",[239],"nofollow","GPL-3.0","のフリーソフトウェアです。フォーク、改変、共有できます。",[17,243,244],{"id":244},"次のステップ",[246,247,248,254,260],"ol",{},[24,249,250],{},[127,251,253],{"href":252},"\u002Fdocs\u002Finstallation","SoundNinjaをインストール",[24,255,256],{},[127,257,259],{"href":258},"\u002Fdocs\u002Fadding-sounds","サウンドを追加",[24,261,262],{},[127,263,265],{"href":264},"\u002Fdocs\u002Forganizing-sounds","ボードを整理",{"title":145,"searchDepth":146,"depth":146,"links":267},[268,269,270,271],{"id":183,"depth":146,"text":183},{"id":200,"depth":146,"text":200},{"id":231,"depth":146,"text":231},{"id":244,"depth":146,"text":244},"SoundNinjaとは何か、何ができるか。",{},1,"\u002Foverview",{"title":167,"description":272},"overview","KJDpLdg7ixvHWAtVFjPRaSTU7NMWgwE__i0PB3mQH3E",{"id":280,"title":281,"body":282,"description":470,"extension":156,"meta":471,"navigation":158,"order":146,"path":472,"seo":473,"stem":474,"__hash__":475},"content_ja\u002Finstallation.md","インストール",{"type":7,"value":283,"toc":463},[284,286,299,303,321,324,328,342,345,349,374,385,388,395,398,413,443,459],[10,285,281],{"id":281},[13,287,288,292,293,298],{},[127,289,291],{"href":290},"\u002Fdownload","ダウンロードページ","または",[127,294,297],{"href":295,"rel":296},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Freleases\u002Flatest",[239],"GitHub Releases","からビルドを入手してください。SoundNinjaは初期開発中なので、ビルドはベータとして扱ってください。",[17,300,302],{"id":301},"windows","Windows",[21,304,305,315,318],{},[24,306,307,308,311,312],{},"64ビットWindows向けの",[27,309,310],{},"インストーラー (.exe)"," または ",[27,313,314],{},"MSI (.msi)",[24,316,317],{},"ランディングページの対象：Windows 10以降",[24,319,320],{},"アプリのREADMEはWindows 8以上も記載",[13,322,323],{},"インストーラーを実行し、スタートメニューからSoundNinjaを起動します。",[17,325,327],{"id":326},"macos","macOS",[21,329,330,336,339],{},[24,331,332,333],{},"Apple SiliconとIntel向けの",[27,334,335],{},"ユニバーサル .dmg",[24,337,338],{},"ランディングページの対象：macOS 10.14以降",[24,340,341],{},"アプリのREADMEはmacOS 10.15以上を記載",[13,343,344],{},"ディスクイメージを開き、SoundNinjaをアプリケーションにドラッグします。",[17,346,348],{"id":347},"linux","Linux",[21,350,351,357,363,371],{},[24,352,353,354],{},"Ubuntu \u002F Debian向けの",[27,355,356],{},"Debian (.deb)",[24,358,359,360],{},"その他のディストリ向けの",[27,361,362],{},"AppImage",[24,364,365,366,370],{},"リリース公開後、ArchユーザーはAURから",[367,368,369],"code",{},"soundninja-bin","をインストールできます",[24,372,373],{},"Ubuntu 20.04でテスト済み",[13,375,376,377,380,381,384],{},"デスクトップビルドにはWebKitとGTKのパッケージが必要です。Debian\u002FUbuntuでは通常、",[367,378,379],{},"libwebkit2gtk","、",[367,382,383],{},"libgtk-3-0","、app-indicatorライブラリです。",[17,386,387],{"id":387},"アップデート",[13,389,390,391,394],{},"アプリ内で ",[27,392,393],{},"ヘルプ → アップデートを確認"," を開きます。設定で起動時にSoundNinjaが確認するようにもできます。",[17,396,397],{"id":397},"ソースからビルド",[13,399,400,401,406,407,412],{},"カスタムビルドが必要なら、",[127,402,405],{"href":403,"rel":404},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja",[239],"リポジトリ","をクローンし、",[127,408,411],{"href":409,"rel":410},"https:\u002F\u002Fv2.tauri.app\u002Fstart\u002Fprerequisites\u002F",[239],"Tauriの前提条件","を入れたうえで：",[414,415,419],"pre",{"className":416,"code":417,"language":418,"meta":145,"style":145},"language-bash shiki shiki-themes github-light github-dark","bun install\nbun run tauri:serve\n","bash",[367,420,421,433],{"__ignoreMap":145},[422,423,425,429],"span",{"class":424,"line":274},"line",[422,426,428],{"class":427},"sScJk","bun",[422,430,432],{"class":431},"sZZnC"," install\n",[422,434,435,437,440],{"class":424,"line":146},[422,436,428],{"class":427},[422,438,439],{"class":431}," run",[422,441,442],{"class":431}," tauri:serve\n",[13,444,445,380,448,380,451,454,455,458],{},[367,446,447],{},"npm",[367,449,450],{},"pnpm",[367,452,453],{},"deno","でも動きます。本番ビルド：",[367,456,457],{},"bun run tauri:build","。",[460,461,462],"style",{},"html pre.shiki code .sScJk, html code.shiki .sScJk{--shiki-default:#6F42C1;--shiki-dark:#B