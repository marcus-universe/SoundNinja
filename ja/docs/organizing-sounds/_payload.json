12],[10,1299,1295],{"id":1295},[13,1301,1302,1303,1305],{},"SoundNinja内でクリップを録音し、トリムしてタブにインポートします。プレイヤーバーの ",[17,1304,838],{}," ボタンでエディターを開きます。",[22,1307,1308],{"id":1308},"入力を選ぶ",[13,1310,1311,1314],{},[17,1312,1313],{},"設定 → オーディオ"," で：",[26,1316,1317,1323,1329],{},[29,1318,1319,1322],{},[17,1320,1321],{},"入力デバイス"," — マイク",[29,1324,1325,1328],{},[17,1326,1327],{},"出力デバイス（PCオーディオ）"," — PCが再生している音のループバック",[29,1330,1331,1334],{},[17,1332,1333],{},"入力音量"," — キャプチャゲイン 0%〜200%",[13,1336,1337],{},"録音ボタンは、ここで選んだデバイスを使います。",[22,1339,1340],{"id":1340},"テイクを編集",[26,1342,1343,1346,1349,1357,1360,1363],{},[29,1344,1345],{},"録音と停止",[29,1347,1348],{},"入力レベルメーターを確認",[29,1350,1351,578,1354],{},[17,1352,1353],{},"ノーマライズ",[17,1355,1356],{},"ノイズキャンセレーション",[29,1358,1359],{},"クリップ全体のトリム、選択範囲へのトリム、選択の削除",[29,1361,1362],{},"元に戻す \u002F やり直し",[29,1364,1365],{},"ズームインとズームアウト",[22,1367,1368],{"id":1368},"ステージしてインポート",[112,1370,1371,1374,1377],{},[29,1372,1373],{},"選択範囲またはトラック全体をステージングリストに追加します。",[29,1375,1376],{},"リストは空から始まります。録音、編集、それからクリップを追加。",[29,1378,1379,578,1381,1383],{},[17,1380,847],{},[17,1382,850],{}," で、現在のタブまたは選んだタブに入れます。",[22,1385,1387],{"id":1386},"ステム分離任意","ステム分離（任意）",[13,1389,1390,1391,1394,1395,578,1398,1401],{},"公式のWindows \u002F macOS \u002F Linuxリリースビルドには ",[17,1392,1393],{},"ステム"," 機能が入ります。Record EditorはBS-RoFormerで ",[17,1396,1397],{},"ボーカル",[17,1399,1400],{},"音楽"," を残せます。",[13,1403,1404,1405,92,1408,1411],{},"モデルは約158 MBで、インストーラーには ",[17,1406,1407],{},"同梱されていません",[17,1409,1410],{},"設定 → ステム分離"," からダウンロードするか、初回起動のプロンプトを承認します。Windowsインストーラーも初回起動時にモデルのダウンロードを案内できます。",[13,1413,1414,1415,1190,1418,809],{},"カスタムのソースビルドには追加フラグが必要です（",[637,1416,1417],{},"tauri:serve:stems",[637,1419,1420],{},"tauri:build:stems",{"title":398,"searchDepth":399,"depth":399,"links":1422},[1423,1424,1425,1426],{"id":1308,"depth":399,"text":1308},{"id":1340,"depth":399,"text":1340},{"id":1368,"depth":399,"text":1368},{"id":1386,"depth":399,"text":1387},"マイクまたはPCオーディオを取り込み、クリップを編集してボードに置く。",{},6,"\u002Frecording-editor",{"title":1295,"description":1427},"recording-editor","7_RI-WNd1luOVgn5vTAoyTmO8dKVtHVwkffwMt4LBQc",{"id":1435,"title":1436,"body":1437,"description":1648,"extension":416,"meta":1649,"navigation":418,"order":1650,"path":1651,"seo":1652,"stem":1653,"__hash__":1654},"content_ja\u002Fremote-control.md","リモートコントロール",{"type":7,"value":1438,"toc":1641},[1439,1441,1444,1447,1479,1482,1485,1519,1522,1542,1545,1548,1580,1584,1590],[10,1440,1436],{"id":1436},[13,1442,1443],{},"SoundNinjaはローカルネットワークで待ち受け、Bitfocus Companion（または任意のHTTP\u002FWebSocketクライアント）がサウンドを再生・停止できます。",[22,1445,1446],{"id":1446},"リモートサーバーを有効化",[112,1448,1449,1455,1462,1469],{},[29,1450,1451,1454],{},[17,1452,1453],{},"設定 → リモート"," を開きます。",[29,1456,1457,1458,1461],{},"リモートサーバーを有効にします。デフォルトポートは ",[17,1459,1460],{},"7331"," です。",[29,1463,1464,1465,1468],{},"任意：トークンを設定。クライアントはBearerトークンまたは ",[637,1466,1467],{},"?token="," で送ります。",[29,1470,1471,1474,1475,1478],{},[637,1472,1473],{},"http:\u002F\u002FIP:PORT"," URLをコピーするか、",[17,1476,1477],{},"設定 → 情報"," からシステムIPをコピーします。",[13,1480,1481],{},"Windowsはサーバー初回起動時にファイアウォールの確認を出すことがあります。プライベートネットワークのアクセスを許可してください。",[22,1483,346],{"id":1484},"bitfocus-companion",[112,1486,1487,1494,1502,1513],{},[29,1488,1489,1493],{},[343,1490,346],{"href":1491,"rel":1492},"https:\u002F\u002Fbitfocus.io\u002Fcompanion",[384],"をインストールします。",[29,1495,1496,1501],{},[343,1497,1500],{"href":1498,"rel":1499},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002Fcompanion-module-soundninja\u002Freleases\u002Flatest",[384],"SoundNinja-Companion.tgz"," をダウンロード。Companion Storeのパッケージはまだありません。",[29,1503,1504,1505,1508,1509,1512],{},"Companionで ",[17,1506,1507],{},"Modules → Load module package"," を開き、",[637,1510,1511],{},".tgz"," を選びます。",[29,1514,1515,1518],{},[17,1516,1517],{},"Sound Ninja"," 接続を追加。PCのIP、ポート、設定したトークンを貼り付けます。",[22,1520,1521],{"id":1521},"アクション",[26,1523,1524,1530,1536],{},[29,1525,1526,1529],{},[17,1527,1528],{},"Trigger Sound"," — ライブドロップダウンから選ぶか、8文字のサウンドIDを入力（Companion変数が使えます）",[29,1531,1532,1535],{},[17,1533,1534],{},"Stop Sound"," — IDで再生中のサウンドを1つ停止",[29,1537,1538,1541],{},[17,1539,1540],{},"Stop All"," — 再生中の全サウンドを停止",[13,1543,1544],{},"SoundNinjaでは、ボタンのコンテキストメニューまたは複数選択のIDチップからサウンドIDをコピーします。",[22,1546,1547],{"id":1547},"フィードバックと変数",[26,1549,1550,1556,1568,1574],{},[29,1551,1552,1555],{},[17,1553,1554],{},"Sound Playing"," — そのサウンドIDがアクティブな間はtrue（ボタン色に使う）",[29,1557,1558,1561,1562,1190,1565],{},[637,1559,1560],{},"$(soundninja:connected)"," — ",[637,1563,1564],{},"true",[637,1566,1567],{},"false",[29,1569,1570,1573],{},[637,1571,1572],{},"$(soundninja:playing_count)"," — 再生中のサウンド数",[29,1575,1576,1579],{},[637,1577,1578],{},"$(soundninja:last_triggered)"," — 最後にトリガーしたサウンドID",[22,1581,1583],{"id":1582},"http-api上級","HTTP API（上級）",[13,1585,1586,1587],{},"ベースパス：",[637,1588,1589],{},"\u002Fapi\u002Fv1",[26,1591,1592,1598,1604,1610,1620,1626,1635],{},[29,1593,1594,1597],{},[637,1595,1596],{},"GET \u002Finfo"," — アプリ名、バージョン、プロトコル、トークンが必要か",[29,1599,1600,1603],{},[637,1601,1602],{},"GET \u002Fsounds"," — サウンド一覧（id、name、tabs、active）",[29,1605,1606,1609],{},[637,1607,1608],{},"GET \u002Fstate"," — サウンドと現在再生中のID",[29,1611,1612,1615,1616,1619],{},[637,1613,1614],{},"POST \u002Ftrigger"," に ",[637,1617,1618],{},"{ \"id\" }"," — サウンドを再生",[29,1621,1622,1625],{},[637,1623,1624],{},"GET \u002Ftrigger\u002F:id"," — 再生（ブラウザで簡単にテスト）",[29,1627,1628,1631,1632,1634],{},[637,1629,1630],{},"POST \u002Fstop"," に任意の ",[637,1633,1618],{}," — 1つまたはすべて停止",[29,1636,1637,1640],{},[637,1638,1639],{},"GET \u002Fws"," — ライブ状態。trigger\u002Fstopコマンドを受信",{"title":398,"searchDepth":399,"depth":399,"links":1642},[1643,1644,1645,1646,1647],{"id":1446,"depth":399,"text":1446},{"id":1484,"depth":399,"text":346},{"id":1521,"depth":399,"text":1521},{"id":1547,"depth":399,"text":1547},{"id":1582,"depth":399,"text":1583},"ローカルネットワーク経由でBitfocus CompanionからSoundNinjaを操作。",{},7,"\u002Fremote-control",{"title":1436,"description":1648},"remote-control","mPFqlRPL-jxRSp