503],{},"1つ以上の音声ファイルを選びます。",[24,505,506],{},"サウンドは現在のタブに入ります。",[17,508,509],{"id":509},"フォルダをインポート",[246,511,512,521,524],{},[24,513,514,517,518,520],{},[27,515,516],{},"ファイル → フォルダをインポート","（またはナビバーの ",[27,519,509],{},"）。",[24,522,523],{},"1つ以上のフォルダを追加。インポート前にドラッグで並べ替えできます。",[24,525,526,527],{},"配置方法を選びます：\n",[21,528,529,535],{},[24,530,531,534],{},[27,532,533],{},"タブとしてインポート"," — 各フォルダが独自のタブになる",[24,536,537,540],{},[27,538,539],{},"現在のタブにインポート"," — すべてのファイルがアクティブなタブに入る",[17,542,543],{"id":543},"クリップを録音",[13,545,546,547,550,551,555,556,311,559,562],{},"プレイヤーバーの ",[27,548,549],{},"録音"," ボタンから",[127,552,554],{"href":553},"\u002Fdocs\u002Frecording-editor","Record Editor","を開きます。キャプチャ、トリムし、",[27,557,558],{},"選択をインポート",[27,560,561],{},"すべてインポート"," で現在のタブまたは選んだタブに入れます。",[17,564,565],{"id":565},"サウンドボードをインポート",[13,567,568,571,572,575,576,579],{},[27,569,570],{},"ファイル → サウンドボードをインポート"," で共有パックを読み込みます。パックは ",[367,573,574],{},"project.sninja"," とサウンドファイルを含む ",[367,577,578],{},".zip"," です。インポート後、プロジェクトを開いて再生します。",[13,581,582],{},"複数のプロジェクト（プロファイル）も保てます。プロジェクトセレクターでボードを切り替えます。",[17,584,585],{"id":585},"見つからないファイルを再リンク",[13,587,588,589,592],{},"ディスク上で音声ファイルが移動すると、SoundNinjaは ",[27,590,591],{},"見つからないサウンドファイル"," ダイアログを表示します。検索するフォルダを選び、クリップを再リンクします。",[17,594,595],{"id":595},"次へ",[13,597,598,599,458],{},"タブ、グループ、ホットキーの整理は",[127,600,5],{"href":264},{"title":145,"searchDepth":146,"depth":146,"links":602},[603,604,605,606,607,608],{"id":488,"depth":146,"text":488},{"id":509,"depth":146,"text":509},{"id":543,"depth":146,"text":543},{"id":565,"depth":146,"text":565},{"id":585,"depth":146,"text":585},{"id":595,"depth":146,"text":595},"音声、フォルダ、録音、共有サウンドボードをインポート。",{},3,"\u002Fadding-sounds",{"title":478,"description":609},"adding-sounds","Fa08TvxAivFfa2zc5Ab8J5x_IO2j6rzWXGssNBY_HnY",{"id":4,"title":5,"body":617,"description":155,"extension":156,"meta":708,"navigation":158,"order":159,"path":160,"seo":709,"stem":162,"__hash__":163},{"type":7,"value":618,"toc":699},[619,621,623,625,641,64