ーがタブとボタンを表示します。",[17,759,760],{"id":760},"変更できる項目",[21,762,763,766,769,772],{},[24,764,765],{},"プライマリとアクセントの色、背景、ボタン色、タブ色",[24,767,768],{},"ボタンとタブのフォントファミリーとサイズ",[24,770,771],{},"ボタンの幅、半径、枠線幅、隙間、パディング",[24,773,774],{},"GIFオーバーレイの不透明度（通常とホバー）",[17,776,777],{"id":777},"保存と共有",[21,779,780,786,792,798],{},[24,781,782,785],{},[27,783,784],{},".cssをエクスポート"," — バックアップや友人への送信用テーマファイルを書き出す",[24,787,788,791],{},[27,789,790],{},"テーマに追加"," — Themesフォルダに保存して適用",[24,793,794,797],{},[27,795,796],{},".cssをインポート"," — 組み込みプリセットまたは保存済みテーマを読み込む",[24,799,800,803],{},[27,801,802],{},"リセット"," — SoundNinjaのデフォルトに戻す",[13,805,806],{},"未保存の変更があるままウィンドウを閉じると、SoundNinjaが先に保存を求めます。",[17,808,809],{"id":809},"フルエディターなしで",[13,811,812,814],{},[27,813,53],{}," でも次が可能です：",[21,816,817,820,826],{},[24,818,819],{},"リストからテーマを選ぶ",[24,821,822,823,743],{},"CSS変数をライブ編集する（",[27,824,825],{},"カスタムCSS",[24,827,828],{},"テーマファイルをThemesフォルダにインポートする",{"title":145,"searchDepth":146,"depth":146,"links":830},[831,832,833,834],{"id":726,"depth":146,"text":727},{"id":760,"depth":146,"text":760},{"id":777,"depth":146,"text":777},{"id":809,"depth":146,"text":809},"Theme Creatorで色、フォント、ボタン、タブをデザイン。",{},5,"\u002Ftheme-editor",{"title":712,"description":835},"theme-editor","tGeQE8HatAeqLeJ_3U4A-ac0RfIRzcoq-KghedjPolg",{"id":843,"title":844,"body":845,"description":971,"extension":156,"meta":972,"navigation":158,"order":973,"path":974,"seo":975,"stem":976,"__hash__":977},"content_ja\u002Frecording-editor.md","録音エディター",{"type":7,"value":846,"toc":965},[847,849,855,858,864,884,887,890,915,918,933,937,950,956],[10,848,844],{"id":844},[13,850,851,852,854],{},"SoundNinja内でクリップを録音し、トリムしてタブにインポートします。プレイヤーバーの ",[27,853,549],{}," ボタンでエディターを開きます。",[17,856,857],{"id":857},"入力を選ぶ",[13,859,860,863],{},[27,861,862],{},"設定 → オーディオ"," で：",[21,865,866,872,878],{},[24,867,868,871],{},[27,869,870],{},"入力デバイス"," — マイク",[24,873,874,877],{},[27,875,876],{},"出力デバイス（PCオーディオ）"," — PCが再生している音のループバック",[24,879,880,883],{},[27,881,882],{},"入力音量"," — キャプチャゲイン 0%〜200%",[13,885,886],{},"録音ボタンは、ここで選んだデバイスを使います。",[17,888,889],{"id":889},"テイクを編集",[21,891,892,895,898,906,909,912],{},[24,893,894],{},"録音と停止",[24,896,897],{},"入力レベルメーターを確認",[24,899,900,311,903],{},[27,901,902],{},"ノーマライズ",[27,904,905],{},"ノイズキャンセレーション",[24,907,908],{},"クリップ全体のトリム、選択範囲へのトリム、選択の削除",[24,910,911],{},"元に戻す \u002F やり直し",[24,913,914],{},"ズームインとズームアウト",[17,916,917],{"id":917},"ステージしてインポート",[246,919,920,923,926],{},[24,921,922],{},"選択範囲またはトラック全体をステージングリストに追加します。",[24,924,925],{},"リストは空から始まります。録音、編集、それからクリップを追加。",[24,927,928,311,930,932],{},[27,929,558],{},[27,931,561],{}," で、現在のタブまたは選んだタブに入れます。",[17,934,936],{"id":935},"ステム分離任意","ステム分離（任意）",[13,938,939,940,311,943,946,947,458],{},"Record EditorはBS-RoFormerで ",[27,941,942],{},"ボーカル",[27,944,945],{},"音楽"," を残せます。モデルは約158 MBで、アプリには ",[27,948,949],{},"同梱されていません",[13,951,952,955],{},[27,953,954],{},"設定 → ステム分離"," からダウンロードするか、初回起動のプロンプトを承認します。Windowsインストーラーも初回起動時にモデルのダウンロードを案内できます。",[13,957,958,959,739,962,520],{},"ソースからのステムビルドには追加フラグが必要です（",[367,960,961],{},"tauri:serve:stems",[367,963,964],{},"tauri:build:stems",{"title":145,"searchDepth":146,"depth":146,"links":966},[967,968,969,970],{"id":857,"depth":146,"text":857},{"id":889,"depth":146,"text":889},{"id":917,"depth":146,"text":917},{"id":935,"depth":146,"text":936},"マイクまたはPCオーディオを取り込み、クリップを編集してボードに置く。",{},6,"\u002Frecording-editor",{"title":844,"description":971},"recording-editor","fkw2G1vYZhqRZ8t2Y9irOID6H-BdjzVV8fvv-hE_qbo",{"id":979,"title":980,"body":981,"description":1196,"extension":156,"meta":1197,"navigation":158,"order":1198,"path":1199,"seo":1200,"stem":1201,"__hash__":1202},"content_ja\u002Fremote-control.md","リモートコントロール",{"type":7,"value":982,"toc":1189},[983,985,988,991,1023,1026,1029,1067,1070,1090,1093,1096,1128,1132,1138],[10,984,980],{"id":980},[13,986,987],{},"SoundNinjaはローカルネットワークで待ち受け、Bitfocus Companion（または任意のHTTP\u002FWebSocketクライアント）がサウンドを再生・停止できます。",[17,989,990],{"id":990},"リモートサーバーを有効化",[246,992,993,999,1006,1013],{},[24,994,995,998],{},[27,996,997],{},"設定 → リモート"," を開きます。",[24,1000,1001,1002,1005],{},"リモートサーバーを有効にします。デフォルトポートは ",[27,1003,1004],{},"7331"," です。",[24,1007,1008,1009,1012],{},"任意：トークンを設定。クライアントはBearerトークンまたは ",[367,1010,1011],{},"?token="," で送ります。",[24,1014,1015,1018,1019,1022],{},[367,1016,1017],{},"http:\u002F\u002FIP:PORT"," URLをコピーするか、",[27,1020,1021],{},"設定 → 情報"," からシステムIPをコピーします。",[13,1024,1025],{},"Windowsはサーバー初回起動時にファイアウォールの確認を出すことがあります。プライベートネットワークのアクセスを許可してください。",[17,1027,130],{"id":1028},"bitfocus-companion",[246,1030,1031,1038,1047,1054,1061],{},[24,1032,1033,1037],{},[127,1034,130],{"href":1035,"rel":1036},"https:\u002F\u002Fbitfocus.io\u002Fcompanion",[239],"をインストールします。",[24,1039,1040,1041,1046],{},"公式フォルダからSoundNinjaモジュールをダウンロード：",[127,1042,1045],{"href":1043,"rel":1044},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Ftree\u002Fmain\u002Fcompanion-module-soundninja",[239],"companion-module-soundninja","。Companion Storeのパッケージはまだありません — このフォルダがダウンロードです。",[24,1048,1049,1050,1053],{},"Companionで ",[27,1051,1052],{},"Developer → Modules"," を開くか、フォルダをCompanionのカスタムモジュールパスに置きます。",[24,1055,1056,1057,1060],{},"モジュールフォルダで ",[367,1058,1059],{},"npm install"," を実行します。",[24,1062,1063,1066],{},[27,1064,1065],{},"Sound Ninja"," 接続を追加。PCのIP、ポート、設定したトークンを貼り付けます。",[17,1068,1069],{"id":1069},"アクション",[21,1071,1072,1078,1084],{},[24,1073,1074,1077],{},[27,1075,1076],{},"Trigger Sound"," — ライブドロップダウンから選ぶか、8文字のサウンドIDを入力（Companion変数が使えます）",[24,1079,1080,1083],{},[27,1081,1082],{},"Stop Sound"," — IDで再生中のサウンドを1つ停止",[24,1085,1086,1089],{},[27,1087,1088],{},"Stop All"," — 再生中の全サウンドを停止",[13,1091,1092],{},"SoundNinjaでは、ボタンのコンテキストメニューまたは複数選択のIDチップからサウンドIDをコピーします。",[17,1094,1095],{"id":1095},"フィードバックと変数",[21,1097,1098,1104,1116,1122],{},[24,1099,1100,1103],{},[27,1101,1102],{},"Sound Playing"," — そのサウンドIDがアクティブな間はtrue（ボタン色に使う）",[24,1105,1106,1109,1110,739,1113],{},[367,1107,1108],{},"$(soundninja:connected)"," — ",[367,1111,1112],{},"true",[367,1114,1115],{},"false",[24,1117,1118,1121],{},[367,1119,1120],{},"$(soundninja:playing_count)"," — 再生中のサウンド数",[24,1123,1124,1127],{},[367,1125,1126],{},"$(soundninja:last_triggered)"," — 最後にトリガーしたサウンドID",[17,1129,1131],{"id":1130},"http-api上級","HTTP API（上級）",[13,1133,1134,1135],{},"ベースパス：",[367,1136,1137],{},"\u002Fapi\u002Fv1",[21,1139,1140,1146,1152,1158,1168,1174,1183],{},[24,1141,1142,1145],{},[367,1143,1144],{},"GET \u002Finfo"," — アプリ名、バージョン、プロトコル、トークンが必要か",[24,1147,1148,1151],{},[367,1149,1150],{},"GET \u002Fsounds"," — サウンド一覧（id、name、tabs、active）",[24,1153,1154,1157],{},[367,1155,1156],{},"GET \u002Fstate"," — サウンドと現在再生中のID",[24,1159,1160,1163,1164,1167],{},[367,1161,1162],{},"POST \u002Ftrigger"," に ",[367,1165,1166],{},"{ \"id\" }"," — サウンドを再生",[24,1169,1170,1173],{},[367,1171,1172],{},"GET \u002Ftrigger\u002F:id"," — 再生（ブラウザで簡単にテスト）",[24,1175,1176,1179,1180,1182],{},[367,1177,1178],{},"POST \u002Fstop"," に任意の ",[367,1181,1166],{}," — 1つまたはすべて停止",[24,1184,1185,1188],{},[367,1186,1187],{},"GET \u002Fws"," — ライブ状態。trigger\u002Fstopコマンドを受信",{"title":145,"searchDepth":146,"depth":146,"links":1190},[1191,1192,1193,1194,1195],{"id":990,"depth":146,"text":990},{"id":1028,"depth":146,"text":130},{"id":1069,"depth":146,"text":1069},{"id":1095,"depth":146,"text":1095},{"id":1130,"depth":146,"text":1131},"ローカルネットワーク経由でBitfocus CompanionからSoundNinjaを操作。",{},7,"\u002Fremote-control",{"title":980,"description":1196},"remote-control","zONoY2nsMS914utdiT4H8vCiez_Sndn4qxbRAolwtHw",{"id":1204,"title":1205,"body":1206,"description":1291,"extension":156,"meta":1292,"navigation":158,"order":1293,"path":1294,"seo":1295,"stem":1296,"__hash__":1297},"content_ja\u002Fsupport.md","サポート",{"type":7,"value":1207,"toc":1284},[1208,1210,1213,1216,1219,1226,1234,1237,1244,1246,1259,1262,1274,1277],[10,1209,1205],{"id":1205},[13,1211,1212],{},"SoundNinjaは初期ベータのコミュニティプロジェクトです。いちばん早い助けはGitHubです。",[17,1214,1215],{"id":1215},"バグ報告または質問",[13,1217,1218],{},"GitHubでissueを開いてください：",[13,1220,1221],{},[127,1222,1225],{"hre