",[343,810,812],{"href":811},"\u002Fdocs\u002Frecording-editor","Record Editor","を開きます。キャプチャ、トリムし、",[17,815,816],{},"選択をインポート",[17,818,819],{},"すべてインポート"," で現在のタブまたは選んだタブに入れます。",[22,822,823],{"id":823},"サウンドボードをインポート",[13,825,826,829,830,833,834,837],{},[17,827,828],{},"ファイル → サウンドボードをインポート"," で共有パックを読み込みます。パックは ",[627,831,832],{},"project.sninja"," とサウンドファイルを含む ",[627,835,836],{},".zip"," です。インポート後、プロジェクトを開いて再生します。",[13,839,840],{},"複数のプロジェクト（プロファイル）も保てます。プロジェクトセレクターでボードを切り替えます。",[22,842,843],{"id":843},"見つからないファイルを再リンク",[13,845,846,847,850],{},"ディスク上で音声ファイルが移動すると、SoundNinjaは ",[17,848,849],{},"見つからないサウンドファイル"," ダイアログを表示します。検索するフォルダを選び、クリップを再リンクします。",[22,852,853],{"id":853},"次へ",[13,855,856,857,92],{},"タブ、タグ、フィルター、ホットキーの整理は",[343,858,5],{"href":521},{"title":387,"searchDepth":388,"depth":388,"links":860},[861,862,863,864,865,866],{"id":746,"depth":388,"text":746},{"id":767,"depth":388,"text":767},{"id":801,"depth":388,"text":801},{"id":823,"depth":388,"text":823},{"id":843,"depth":388,"text":843},{"id":853,"depth":388,"text":853},"音声、フォルダ、録音、共有サウンドボードをインポート。",{},"\u002Fadding-sounds",{"title":736,"description":867},"adding-sounds","5_cjd2COcPz0pj4ZrBehCZv6ouzBimE8UGjkcfngQjw",{"id":4,"title":5,"body":874,"description":404,"extension":405,"meta":1121,"navigation":407,"order":408,"path":409,"seo":1122,"stem":411,"__hash__":412},{"type":7,"value":875,"toc":1106},[876,878,882,884,900,904,906,908,918,922,926,928,934,936,956,958,962,964,984,988,990,992,1010,1012,1014,1022,1024,1028,1042,1052,1056,1058,1064,1066,1068,1072,1078,1082,1084,1088,1092,1104],[10,877,5],{"id":5},[13,879,15,880,20],{},[17,881,19],{},[22,883,24],{"id":24},[26,885,886,890,894],{},[29,887,888,34],{},[17,889,33],{},[29,891,892,40],{},[17,893,39],{},[29,895,43,896,47,898,51],{},[17,897,46],{},[17,899,50],{},[13,901,54,902,58],{},[17,903,57],{},[22,905,61],{"id":61},[13,907,64],{},[26,909,910,912,914,916],{},[29,911,69],{},[29,913,72],{},[29,915,75],{},[29,917,78],{},[13,919,81,920,85],{},[17,921,84],{