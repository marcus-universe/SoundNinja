[{"data":1,"prerenderedAt":1712},["ShallowReactive",2],{"docs-page-ja-\u002Forganizing-sounds":3,"docs-nav-ja":413},{"id":4,"title":5,"body":6,"description":404,"extension":405,"meta":406,"navigation":407,"order":408,"path":409,"seo":410,"stem":411,"__hash__":412},"content_ja\u002Forganizing-sounds.md","サウンドの整理",{"type":7,"value":8,"toc":386},"minimark",[9,12,21,25,52,59,62,65,79,86,93,97,107,111,142,145,151,154,188,195,199,202,229,232,236,249,252,257,278,294,301,304,315,318,322,329,339,348,351,359,366,383],[10,11,5],"h1",{"id":5},[13,14,15,16,20],"p",{},"SoundNinjaは大規模ライブラリ向けです。",[17,18,19],"strong",{},"タグとフィルター","、タブ、検索、複数選択、ホットキーで、必要なクリップをワンクリック（またはワンキー）で出せます。",[22,23,24],"h2",{"id":24},"タブ",[26,27,28,35,41],"ul",{},[29,30,31,34],"li",{},[17,32,33],{},"タブを追加"," でタブを作り、色を付けてバーをすばやく眺められます。",[29,36,37,40],{},[17,38,39],{},"すべて"," ビューはタブを横断して全サウンドを表示します。",[29,42,43,44,47,48,51],{},"サウンドは ",[17,45,46],{},"1つ以上のタブ"," に所属できます。サウンドを右クリックし、",[17,49,50],{},"タブへ移動"," で割り当てます。",[13,53,54,55,58],{},"タブの切り替え演出は ",[17,56,57],{},"設定 → メイン","：スライド、フェード、ボタンを1つずつ、またはなし。",[22,60,61],{"id":61},"グループ",[13,63,64],{},"v0.5.3以降、セパレーターを名前付きグループにできます：",[26,66,67,70,73,76],{},[29,68,69],{},"コンテキストメニューからグループの追加、名前変更、削除",[29,71,72],{},"グループヘッダーをドラッグ — 子も一緒に動く",[29,74,75],{},"グループにサウンドを入れたり出したり",[29,77,78],{},"グループの枠線色、名前の色、ボタン配置を設定（またはタブのデフォルトを使う）",[13,80,81,82,85],{},"見た目の区切りだけなら、通常の ",[17,83,84],{},"セパレーター"," も追加できます。",[13,87,88,89,92],{},"ボードの空き領域を右クリックして ",[17,90,91],{},"グループを追加","。",[22,94,96],{"id":95},"タグ-フィルター","タグ \u002F フィルター",[13,98,99,100,103,104,106],{},"タグはタブを横断します。スライドアウトの ",[17,101,102],{},"フィルター"," パネル（サイドバー ",[17,105,102],{},"）で作成し、ボードを絞ります。",[108,109,110],"h3",{"id":110},"タグの作成と編集",[112,113,114,120,130,136],"ol",{},[29,115,116,117,119],{},"サイドバーで ",[17,118,102],{}," を開く。",[29,121,122,125,126,129],{},[17,123,124],{},"タグ"," の ",[17,127,128],{},"タグを追加"," — 名前と色を付ける。",[29,131,132,133,92],{},"同じリストで名前変更、色変更、",[17,134,135],{},"タグを削除",[29,137,138,141],{},[17,139,140],{},"タグはまだありません"," と出たら、割り当てる前にここで追加する。",[108,143,144],{"id":144},"サウンドにタグを付ける",[13,146,147,148,150],{},"サウンドを右クリック → ",[17,149,124],{},"（チェックボックス）。1つのサウンドに複数可。タグが無い場合、メニューはフィルターパネルへ案内します。",[108,152,153],{"id":153},"ボードをフィルター",[26,155,156,163,174,185],{},[29,157,158,159,162],{},"フィルターパネル、または ",[17,160,161],{},"検索バー下のチップ"," でタグを切り替え。",[29,164,165,166,169,170,173],{},"一致は ",[17,167,168],{},"OR","：選択したタグの ",[17,171,172],{},"いずれか"," を持つサウンドが表示される。",[29,175,176,177,180,181,184],{},"ナビバーの ",[17,178,179],{},"検索"," は有効なタグフィルターと ",[17,182,183],{},"AND","（入力 + タグ）。",[29,186,187],{},"チップをオフ（またはフィルター解除）でタブ全体を再表示。",[13,189,190,191,194],{},"色付きタグ名をボタンに表示できます。",[17,192,193],{},"設定 → 動作 → タグバッジを表示"," で切り替え。",[22,196,198],{"id":197},"並べ替えソート","並べ替え（ソート）",[13,200,201],{},"フィルターパネルでソートモードを選びます：",[26,203,204,210],{},[29,205,206,209],{},[17,207,208],{},"ユーザー定義"," — タブ順、グループ表示",[29,211,212,215,216,215,219,215,222,225,226],{},[17,213,214],{},"名前","、",[17,217,218],{},"追加日時",[17,220,221],{},"再生時間",[17,223,224],{},"ファイルサイズ"," — フラットなソート一覧。これらのモードでは ",[17,227,228],{},"グループは非表示",[13,230,231],{},"再生時間ソートは、初回に長さのメタデータを準備することがあります。",[22,233,235],{"id":234},"並べ替えドラッグ","並べ替え（ドラッグ）",[13,237,238,241,242,245,246,248],{},[17,239,240],{},"設定 → 動作"," でドラッグ＆ドロップをオンにします（",[17,243,244],{},"並べ替えを許可","）。その後、サウンドとグループをドラッグして配置します。ドラッグ並べ替えは ",[17,247,208],{}," ソートで有効です。",[22,250,251],{"id":251},"複数選択",[13,253,176,254,256],{},[17,255,251],{}," をオンにして：",[26,258,259,262,268,275],{},[29,260,261],{},"クリックでサウンドをトグル",[29,263,264,267],{},[17,265,266],{},"Shift+クリック"," で直前のアンカーから範囲選択",[29,269,270,271,274],{},"空きボード上で ",[17,272,273],{},"マーキー"," をドラッグ",[29,276,277],{},"空きボード（または外側）をクリックして選択解除",[13,279,280,281,215,284,215,287,215,290,293],{},"一括バーに件数が表示され、",[17,282,283],{},"色",[17,285,286],{},"タブへ移動…",[17,288,289],{},"削除",[17,291,292],{},"完了"," が使えます。",[13,295,296,297,300],{},"複数選択中、各ボタンに ",[17,298,299],{},"8文字のIDチップ"," が出ます。チップを右クリックでコピー。",[22,302,303],{"id":303},"サウンドごとの音量",[13,305,306,307,310,311,314],{},"右クリック → ",[17,308,309],{},"音量","。スライダーを 0%〜100%。",[17,312,313],{},"ダブルクリック"," で 100% にリセット。",[13,316,317],{},"設定のマスター出力音量と重ねて効きます。",[22,319,321],{"id":320},"ホットキーとサウンドid","ホットキーとサウンドID",[13,323,324,325,328],{},"すべてのサウンドには8文字のIDがあります。ボタンのコンテキストメニュー（",[17,326,327],{},"IDをコピー","）、または複数選択のIDチップからコピーします。",[13,330,331,334,335,338],{},[17,332,333],{},"設定 → ホットキー"," を開き、キーをサウンドIDに割り当てます。グローバルホットキーは任意です。コンテキストメニューの ",[17,336,337],{},"ホットキーを割り当て"," は、IDを埋めた状態でそこにジャンプします。",[13,340,341,342,347],{},"同じIDを",[343,344,346],"a",{"href":345},"\u002Fdocs\u002Fremote-control","Bitfocus Companion","がクリップのトリガーに使います。",[22,349,350],{"id":350},"背景画像と色",[13,352,353,354,358],{},"サウンドを右クリックして、ボタンごとの色や背景画像を設定します。ボード全体を整える",[343,355,357],{"href":356},"\u002Fdocs\u002Ftheme-editor","Theme Creator","とは別です。",[13,360,361,362,365],{},"ピッカーは ",[17,363,364],{},"背景画像"," ダイアログ（PNG、JPEG、GIF、WebP）：",[26,367,368,374],{},[29,369,370,373],{},[17,371,372],{},"ローカルファイル"," — フォルダ追加、単一ファイル選択、ファイル名検索、グリッドプレビュー、ライブラリからフォルダ削除",[29,375,376,379,380,382],{},[17,377,378],{},"KLIPY"," — オンラインGIFを検索。APIキーは ",[17,381,240],{},"。キーはプロジェクトファイルには保存されません。",[13,384,385],{},"画像を選んだあと、ボタン上でパンとクロップできます。",{"title":387,"searchDepth":388,"depth":388,"links":389},"",2,[390,391,392,398,399,400,401,402,403],{"id":24,"depth":388,"text":24},{"id":61,"depth":388,"text":61},{"id":95,"depth":388,"text":96,"children":393},[394,396,397],{"id":110,"depth":395,"text":110},3,{"id":144,"depth":395,"text":144},{"id":153,"depth":395,"text":153},{"id":197,"depth":388,"text":198},{"id":234,"depth":388,"text":235},{"id":251,"depth":388,"text":251},{"id":303,"depth":388,"text":303},{"id":320,"depth":388,"text":321},{"id":350,"depth":388,"text":350},"タグ、フィルター、タブ、グループ、並べ替え、複数選択、音量、ホットキー。","md",{},true,4,"\u002Forganizing-sounds",{"title":5,"description":404},"organizing-sounds","PGqVreiuZb1jRxkXIW9tv66PvwPYs2iRx5-4j_D8sho",[414,536,734,873,1123,1255,1396,1617],{"id":415,"title":416,"body":417,"description":529,"extension":405,"meta":530,"navigation":407,"order":531,"path":532,"seo":533,"stem":534,"__hash__":535},"content_ja\u002Foverview.md","概要",{"type":7,"value":418,"toc":523},[419,421,424,427,430,433,447,450,487,490,500,503],[10,420,416],{"id":416},[13,422,423],{},"SoundNinjaは、ライブ配信、友だちとのチャット、ポッドキャスト収録向けのオープンソースサウンドボードです。Tauri v2とNuxt 4で構築されており、RAMとディスクの負荷を抑えています。",[13,425,426],{},"目標はシンプルです。巨大なサウンドライブラリをすばやく眺め、目的のクリップをミリ秒で再生すること。UIはVRのダッシュボードとしても使いやすいです。",[13,428,429],{},"SoundNinjaはまだ初期開発段階です。機能は動きますが、すべてのプラットフォームで完全に検証されているわけではありません。",[22,431,432],{"id":432},"対象ユーザー",[26,434,435,438,441,444],{},[29,436,437],{},"即時のサウンドキューが必要な配信者",[29,439,440],{},"ボイスチャット用の共有ボードが欲しい友だち",[29,442,443],{},"クリップを録ってボードに置くポッドキャスター",[29,445,446],{},"カスタマイズ可能な、ローカル優先のサウンドボードが欲しい人",[22,448,449],{"id":449},"できること",[26,451,452,455,458,461,464,467,470,473,476,481,484],{},[29,453,454],{},"自分の音声ファイルからサウンドボードを作る",[29,456,457],{},"色付きタブ、グループ、タグ、検索で整理する",[29,459,460],{},"タグでフィルター（OR）、名前・日付・長さ・サイズでソート",[29,462,463],{},"マーキーまたはShift範囲で複数選択し、色・移動・削除を一括",[29,465,466],{},"コンテキストメニューでサウンドごとの音量を設定",[29,468,469],{},"Theme Creatorで見た目をデザインする",[29,471,472],{},"Record EditorでPCオーディオまたはマイクを録音する",[29,474,475],{},"個別のサウンドにホットキーを割り当てる",[29,477,478,480],{},[343,479,346],{"href":345},"からサウンドをトリガーする",[29,482,483],{},"サウンドボード全体をインポート／エクスポートして共有する",[29,485,486],{},"サウンドボタンにGIFや画像を使う — ローカルフォルダライブラリまたはKLIPY",[22,488,489],{"id":489},"ライセンス",[13,491,492,493,499],{},"SoundNinjaは",[343,494,498],{"href":495,"rel":496},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fblob\u002Fmain\u002FLICENSE",[497],"nofollow","GPL-3.0","のフリーソフトウェアです。フォーク、改変、共有できます。",[22,501,502],{"id":502},"次のステップ",[112,504,505,511,517],{},[29,506,507],{},[343,508,510],{"href":509},"\u002Fdocs\u002Finstallation","SoundNinjaをインストール",[29,512,513],{},[343,514,516],{"href":515},"\u002Fdocs\u002Fadding-sounds","サウンドを追加",[29,518,519],{},[343,520,522],{"href":521},"\u002Fdocs\u002Forganizing-sounds","ボードを整理",{"title":387,"searchDepth":388,"depth":388,"links":524},[525,526,527,528],{"id":432,"depth":388,"text":432},{"id":449,"depth":388,"text":449},{"id":489,"depth":388,"text":489},{"id":502,"depth":388,"text":502},"SoundNinjaとは何か、何ができるか。",{},1,"\u002Foverview",{"title":416,"description":529},"overview","c8xWgFwxVyANkJ28nfjNkL8am61Nn8aDvVh7jKzMyKM",{"id":537,"title":538,"body":539,"description":728,"extension":405,"meta":729,"navigation":407,"order":388,"path":730,"seo":731,"stem":732,"__hash__":733},"content_ja\u002Finstallation.md","インストール",{"type":7,"value":540,"toc":721},[541,543,556,560,581,584,588,602,605,609,634,644,647,654,657,672,702,717],[10,542,538],{"id":538},[13,544,545,549,550,555],{},[343,546,548],{"href":547},"\u002Fdownload","ダウンロードページ","または",[343,551,554],{"href":552,"rel":553},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Freleases\u002Flatest",[497],"GitHub Releases","からビルドを入手してください。SoundNinjaは初期開発中なので、ビルドはベータとして扱ってください。",[22,557,559],{"id":558},"windows","Windows",[26,561,562,572,575,578],{},[29,563,564,565,568,569],{},"64ビットWindows向けの",[17,566,567],{},"インストーラー (.exe)"," または ",[17,570,571],{},"MSI (.msi)",[29,573,574],{},"ランディングページの対象：Windows 10以降",[29,576,577],{},"アプリのREADMEはWindows 8以上も記載",[29,579,580],{},"NSISインストーラーはダークテーマ。セットアップ時に言語を選ぶと、次回起動時にSoundNinjaが覚えます。",[13,582,583],{},"インストーラーを実行し、スタートメニューからSoundNinjaを起動します。",[22,585,587],{"id":586},"macos","macOS",[26,589,590,596,599],{},[29,591,592,593],{},"Apple SiliconとIntel向けの",[17,594,595],{},"ユニバーサル .dmg",[29,597,598],{},"ランディングページの対象：macOS 10.14以降",[29,600,601],{},"アプリのREADMEはmacOS 10.15以上を記載",[13,603,604],{},"ディスクイメージを開き、SoundNinjaをアプリケーションにドラッグします。",[22,606,608],{"id":607},"linux","Linux",[26,610,611,617,623,631],{},[29,612,613,614],{},"Ubuntu \u002F Debian向けの",[17,615,616],{},"Debian (.deb)",[29,618,619,620],{},"その他のディストリ向けの",[17,621,622],{},"AppImage",[29,624,625,626,630],{},"リリース公開後、ArchユーザーはAURから",[627,628,629],"code",{},"soundninja-bin","をインストールできます",[29,632,633],{},"Ubuntu 20.04でテスト済み",[13,635,636,637,215,640,643],{},"デスクトップビルドにはWebKitとGTKのパッケージが必要です。Debian\u002FUbunt