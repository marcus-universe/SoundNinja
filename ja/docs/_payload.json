[{"data":1,"prerenderedAt":1575},["ShallowReactive",2],{"docs-page-ja-\u002Foverview":3,"docs-nav-ja":139},{"id":4,"title":5,"body":6,"description":130,"extension":131,"meta":132,"navigation":133,"order":134,"path":135,"seo":136,"stem":137,"__hash__":138},"content_ja\u002Foverview.md","概要",{"type":7,"value":8,"toc":122},"minimark",[9,12,16,19,22,26,42,45,85,88,98,101],[10,11,5],"h1",{"id":5},[13,14,15],"p",{},"SoundNinjaは、ライブ配信、友だちとのチャット、ポッドキャスト収録向けのオープンソースサウンドボードです。Tauri v2とNuxt 4で構築されており、RAMとディスクの負荷を抑えています。",[13,17,18],{},"目標はシンプルです。巨大なサウンドライブラリをすばやく眺め、目的のクリップをミリ秒で再生すること。UIはVRのダッシュボードとしても使いやすいです。",[13,20,21],{},"SoundNinjaはまだ初期開発段階です。機能は動きますが、すべてのプラットフォームで完全に検証されているわけではありません。",[23,24,25],"h2",{"id":25},"対象ユーザー",[27,28,29,33,36,39],"ul",{},[30,31,32],"li",{},"即時のサウンドキューが必要な配信者",[30,34,35],{},"ボイスチャット用の共有ボードが欲しい友だち",[30,37,38],{},"クリップを録ってボードに置くポッドキャスター",[30,40,41],{},"カスタマイズ可能な、ローカル優先のサウンドボードが欲しい人",[23,43,44],{"id":44},"できること",[27,46,47,50,53,56,59,62,65,68,71,79,82],{},[30,48,49],{},"自分の音声ファイルからサウンドボードを作る",[30,51,52],{},"色付きタブ、グループ、タグ、検索で整理する",[30,54,55],{},"タグでフィルター（OR）、名前・日付・長さ・サイズでソート",[30,57,58],{},"マーキーまたはShift範囲で複数選択し、色・移動・削除を一括",[30,60,61],{},"コンテキストメニューでサウンドごとの音量を設定",[30,63,64],{},"Theme Creatorで見た目をデザインする",[30,66,67],{},"Record EditorでPCオーディオまたはマイクを録音する",[30,69,70],{},"個別のサウンドにホットキーを割り当てる",[30,72,73,78],{},[74,75,77],"a",{"href":76},"\u002Fdocs\u002Fremote-control","Bitfocus Companion","からサウンドをトリガーする",[30,80,81],{},"サウンドボード全体をインポート／エクスポートして共有する",[30,83,84],{},"サウンドボタンにGIFや画像を使う — ローカルフォルダライブラリ、GifSnap、またはKLIPY",[23,86,87],{"id":87},"ライセンス",[13,89,90,91,97],{},"SoundNinjaは",[74,92,96],{"href":93,"rel":94},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fblob\u002Fmain\u002FLICENSE",[95],"nofollow","GPL-3.0","のフリーソフトウェアです。フォーク、改変、共有できます。",[23,99,100],{"id":100},"次のステップ",[102,103,104,110,116],"ol",{},[30,105,106],{},[74,107,109],{"href":108},"\u002Fdocs\u002Finstallation","SoundNinjaをインストール",[30,111,112],{},[74,113,115],{"href":114},"\u002Fdocs\u002Fadding-sounds","サウンドを追加",[30,117,118],{},[74,119,121],{"href":120},"\u002Fdocs\u002Forganizing-sounds","ボードを整理",{"title":123,"searchDepth":124,"depth":124,"links":125},"",2,[126,127,128,129],{"id":25,"depth":124,"text":25},{"id":44,"depth":124,"text":44},{"id":87,"depth":124,"text":87},{"id":100,"depth":124,"text":100},"SoundNinjaとは何か、何ができるか。","md",{},true,1,"\u002Foverview",{"title":5,"description":130},"overview","RKMKM6lywYS2prTGRayXesPcG2_CgQLEmJfr9msg1eE",[140,222,444,585,986,1118,1259,1480],{"id":4,"title":5,"body":141,"description":130,"extension":131,"meta":220,"navigation":133,"order":134,"path":135,"seo":221,"stem":137,"__hash__":138},{"type":7,"value":142,"toc":214},[143,145,147,149,151,153,163,165,191,193,198,200],[10,144,5],{"id":5},[13,146,15],{},[13,148,18],{},[13,150,21],{},[23,152,25],{"id":25},[27,154,155,157,159,161],{},[30,156,32],{},[30,158,35],{},[30,160,38],{},[30,162,41],{},[23,164,44],{"id":44},[27,166,167,169,171,173,175,177,179,181,183,187,189],{},[30,168,49],{},[30,170,52],{},[30,172,55],{},[30,174,58],{},[30,176,61],{},[30,178,64],{},[30,180,67],{},[30,182,70],{},[30,184,185,78],{},[74,186,77],{"href":76},[30,188,81],{},[30,190,84],{},[23,192,87],{"id":87},[13,194,90,195,97],{},[74,196,96],{"href":93,"rel":197},[95],[23,199,100],{"id":100},[102,201,202,206,210],{},[30,203,204],{},[74,205,109],{"href":108},[30,207,208],{},[74,209,115],{"href":114},[30,211,212],{},[74,213,121],{"href":120},{"title":123,"searchDepth":124,"depth":124,"links":215},[216,217,218,219],{"id":25,"depth":124,"text":25},{"id":44,"depth":124,"text":44},{"id":87,"depth":124,"text":87},{"id":100,"depth":124,"text":100},{},{"title":5,"description":130},{"id":223,"title":224,"body":225,"description":438,"extension":131,"meta":439,"navigation":133,"order":124,"path":440,"seo":441,"stem":442,"__hash__":443},"content_ja\u002Finstallation.md","インストール",{"type":7,"value":226,"toc":431},[227,229,242,246,268,271,275,289,292,296,321,332,335,342,345,360,390,406,427],[10,228,224],{"id":224},[13,230,231,235,236,241],{},[74,232,234],{"href":233},"\u002Fdownload","ダウンロードページ","または",[74,237,240],{"href":238,"rel":239},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Freleases\u002Flatest",[95],"GitHub Releases","からビルドを入手してください。SoundNinjaは初期開発中なので、ビルドはベータとして扱ってください。",[23,243,245],{"id":244},"windows","Windows",[27,247,248,259,262,265],{},[30,249,250,251,255,256],{},"64ビットWindows向けの",[252,253,254],"strong",{},"インストーラー (.exe)"," または ",[252,257,258],{},"MSI (.msi)",[30,260,261],{},"ランディングページの対象：Windows 10以降",[30,263,264],{},"アプリのREADMEはWindows 8以上も記載",[30,266,267],{},"NSISインストーラーはダークテーマ。セットアップ時に言語を選ぶと、次回起動時にSoundNinjaが覚えます。",[13,269,270],{},"インストーラーを実行し、スタートメニューからSoundNinjaを起動します。",[23,272,274],{"id":273},"macos","macOS",[27,276,277,283,286],{},[30,278,279,280],{},"Apple SiliconとIntel向けの",[252,281,282],{},"ユニバーサル .dmg",[30,284,285],{},"ランディングページの対象：macOS 10.14以降",[30,287,288],{},"アプリのREADMEはmacOS 10.15以上を記載",[13,290,291],{},"ディスクイメージを開き、SoundNinjaをアプリケーションにドラッグします。",[23,293,295],{"id":294},"linux","Linux",[27,297,298,304,310,318],{},[30,299,300,301],{},"Ubuntu \u002F Debian向けの",[252,302,303],{},"Debian (.deb)",[30,305,306,307],{},"その他のディストリ向けの",[252,308,309],{},"AppImage",[30,311,312,313,317],{},"リリース公開後、ArchユーザーはAURから",[314,315,316],"code",{},"soundninja-bin","をインストールできます",[30,319,320],{},"Ubuntu 20.04でテスト済み",[13,322,323,324,327,328,331],{},"デスクトップビルドにはWebKitとGTKのパッケージが必要です。Debian\u002FUbuntuでは通常、",[314,325,326],{},"libwebkit2gtk","、",[314,329,330],{},"libgtk-3-0","、app-indicatorライブラリです。",[23,333,334],{"id":334},"アップデート",[13,336,337,338,341],{},"アプリ内で ",[252,339,340],{},"ヘルプ → アップデートを確認"," を開きます。設定で起動時にSoundNinjaが確認するようにもできます。",[23,343,344],{"id":344},"ソースからビルド",[13,346,347,348,353,354,359],{},"カスタムビルドが必要なら、",[74,349,352],{"href":350,"rel":351},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja",[95],"リポジトリ","をクローンし、",[74,355,358],{"href":356,"rel":357},"https:\u002F\u002Fv2.tauri.app\u002Fstart\u002Fprerequisites\u002F",[95],"Tauriの前提条件","を入れたうえで：",[361,362,366],"pre",{"className":363,"code":364,"language":365,"meta":123,"style":123},"language-bash shiki shiki-themes github-light github-dark","bun install\nbun run tauri:serve\n","bash",[314,367,368,380],{"__ignoreMap":123},[369,370,372,376],"span",{"class":371,"line":134},"line",[369,373,375],{"class":374},"sScJk","bun",[369,377,379],{"class":378},"sZZnC"," install\n",[369,381,382,384,387],{"class":371,"line":124},[369,383,375],{"class":374},[369,385,386],{"class":378}," run",[369,388,389],{"class":378}," tauri:serve\n",[13,391,392,327,395,327,398,401,402,405],{},[314,393,394],{},"npm",[314,396,397],{},"pnpm",[314,399,400],{},"deno","でも動きます。本番ビルド：",[314,403,404],{},"bun run tauri:build","。",[13,407,408,411,412,417,418,421,422,405],{},[252,409,410],{},"Windowsのみ:"," Windowsビルドはすべて ",[74,413,416],{"href":414,"rel":415},"https:\u002F\u002Fwww.steinberg.net\u002Fasiosdk",[95],"Steinberg ASIO SDK"," 経由でASIOを含めます。一度 ",[314,419,420],{},"bun run setup:asio"," を実行（SDKはgitに含まれません）。Linux \u002F macOSは PipeWire \u002F Core Audio — この手順は不要。詳細: ",[74,423,426],{"href":424,"rel":425},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fblob\u002Fmain\u002Fdocs\u002Fbuild-from-source.md",[95],"build-from-source.md",[428,429,430],"style",{},"html pre.shiki code .sScJk, html code.shiki .sScJk{--shiki-default:#6F42C1;--shiki-dark:#B392F0}html pre.shiki code .sZZnC, html code.shiki .sZZnC{--shiki-default:#032F62;--shiki-dark:#9ECBFF}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html.dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}",{"title":123,"searchDepth":124,"depth":124,"links":432},[433,434,435,436,437],{"id":244,"depth":124,"text":245},{"id":273,"depth":124,"text":274},{"id":294,"depth":124,"text":295},{"id":334,"depth":124,"text":334},{"id":344,"depth":124,"text":344},"Windows、macOS、LinuxにSoundNinjaをインストール。",{},"\u002Finstallation",{"title":224,"description":438},"installation","IjZd1P7FnQS2uqb_Mqyrc5OsF5e06cfW8q5sH_3_mkY",{"id":445,"title":446,"body":447,"description":578,"extension":131,"meta":579,"navigation":133,"order":580,"path":581,"seo":582,"stem":583,"__hash__":584},"content_ja\u002Fadding-sounds.md","サウンドの追加",{"type":7,"value":448,"toc":570},[449,451,454,457,475,478,509,512,531,534,548,551,554,561,564],[10,450,446],{"id":446},[13,452,453],{},"クリップを追加するまで、ボードは空です。SoundNinjaはファイル、フォルダ全体、録音、共有サウンドボードパックをインポートできます。",[23,455,456],{"id":456},"音声ファイルをインポート",[102,458,459,469,472],{},[30,460,461,464,465,468],{},[252,462,463],{},"ファイル → 音声ファイルをインポート","、またはナビバーの ",[252,466,467],{},"インポート"," を使います。",[30,470,471],{},"1つ以上の音声ファイルを選びます。",[30,473,474],{},"サウンドは現在のタブに入ります。",[23,476,477],{"id":477},"フォルダをインポート",[102,479,480,489,492],{},[30,481,482,485,486,488],{},[252,483,484],{},"ファイル → フォルダをインポート","（またはナビバーの ",[252,487,477],{},"）。",[30,490,491],{},"1つ以上のフォルダを追加。インポート前にドラッグで並べ替えできます。",[30,493,494,495],{},"配置方法を選びます：\n",[27,496,497,503],{},[30,498,499,502],{},[252,500,501],{},"タブとしてインポート"," — 各フォルダが独自のタブになる",[30,504,505,508],{},[252,506,507],{},"現在のタブにインポート"," — すべてのファイルがアクティブなタブに入る",[23,510,511],{"id":511},"クリップを録音",[13,513,514,515,518,519,523,524,255,527,530],{},"プレイヤーバーの ",[252,516,517],{},"録音"," ボタンから",[74,520,522],{"href":521},"\u002Fdocs\u002Frecording-editor","Record Editor","を開きます。キャプチャ、トリムし、",[252,525,526],{},"選択をインポート",[252,528,529],{},"すべてインポート"," で現在のタブまたは選んだタブに入れます。",[23,532,533],{"id":533},"サウンドボードをインポート",[13,535,536,539,540,543,544,547],{},[252,537,538],{},"ファイル → サウンドボードをインポート"," で共有パックを読み込みます。パックは ",[314,541,542],{},"project.sninja"," とサウンドファイルを含む ",[314,545,546],{},".zip"," です。インポート後、プロジェクトを開いて再生します。",[13,549,550],{},"複数のプロジェクト（プロファイル）も保てます。プロジェクトセレクターでボードを切り替えます。",[23,552,553],{"id":553},"見つからないファイルを再リンク",[13,555,556,557,560],{},"ディスク上で音声ファイルが移動すると、SoundNinjaは ",[252,558,559],{},"見つからないサウンドファイル"," ダイアログを表示します。検索するフォルダを選び、クリップを再リンクします。",[23,562,563],{"id":563},"次へ",[13,565,566,567,405],{},"タブ、タグ、フィルター、ホットキーの整理は",[74,568,569],{"href":120},"サウンドの整理",{"title":123,"searchDepth":124,"depth":124,"links":571},[572,573,574,575,576,577],{"id":456,"depth":124,"text":456},{"id":477,"depth":124,"text":477},{"id":511,"depth":124,"text":511},{"id":533,"depth":124,"text":533},{"id":553,"depth":124,"text":553},{"id":563,"depth":124,"text":563},"音声、フォルダ、録音、共有サウンドボードをインポート。",{},3,"\u002Fadding-sounds",{"title":446,"description":578},"adding-sounds","5_cjd2COcPz0pj4ZrBehCZv6ouzBimE8UGjkcfngQjw",{"id":586,"title":569,"body":587,"description":979,"extension":131,"meta":980,"navigation":133,"order":981,"path":982,"seo":983,"stem":984,"__hash__":985},"content_ja\u002Forganizing-sounds.md",{"type":7,"value":588,"toc":964},[589,591,598,601,626,633,636,639,653,660,666,670,680,684,714,717,723,726,760,767,771,774,800,803,807,820,823,828,849,865,872,875,886,889,893,900,910,916,919,927,934,961],[10,590,569],{"id":569},[13,592,593,594,597],{},"SoundNinjaは大規模ライブラリ向けです。",[252,595,596],{},"タグとフィルター","、タブ、検索、複数選択、ホットキーで、必要なクリップをワンクリック（またはワンキー）で出せます。",[23,599,600],{"id":600},"タブ",[27,602,603,609,615],{},[30,604,605,608],{},[252,606,607],{},"タブを追加"," でタブを作り、色を付けてバーをすばやく眺められます。",[30,610,611,614],{},[252,612,613],{},"すべて"," ビューはタブを横断して全サウンドを表示します。",[30,616,617,618,621,622,625],{},"サウンドは ",[252,619,620],{},"1つ以上のタブ"," に所属できます。サウンドを右クリックし、",[252,623,624],{},"タブへ移動"," で割り当てます。",[13,627,628,629,632],{},"タブの切り替え演出は ",[252,630,631],{},"設定 → メイン","：スライド、フェード、ボタンを1つずつ、またはなし。",[23,634,635],{"id":635},"グループ",[13,637,638],{},"v0.5.3以降、セパレーターを名前付きグループにできます：",[27,640,641,644,647,650],{},[30,642,643],{},"コンテキストメニューからグループの追加、名前変更、削除",[30,645,646],{},"グループヘッダーをドラッグ — 子も一緒に動く",[30,648,649],{},"グループにサウンドを入れたり出したり",[30,651,652],{},"グループの枠線色、名前の色、ボタン配置を設定（またはタブのデフォルトを使う）",[13,654,655,656,659],{},"見た目の区切りだけなら、通常の ",[252,657,658],{},"セパレーター"," も追加できます。",[13,661,662,663,405],{},"ボードの空き領域を右クリックして ",[252,664,665],{},"グループを追加",[23,667,669],{"id":668},"タグ-フィルター","タグ \u002F フィルター",[13,671,672,673,676,677,679],{},"タグはタブを横断します。スライドアウトの ",[252,674,675],{},"フィルター"," パネル（サイドバー ",[252,678,675],{},"）で作成し、ボードを絞ります。",[681,682,683],"h3",{"id":683},"タグの作成と編集",[102,685,686,692,702,708],{},[30,687,688,689,691],{},"サイドバーで ",[252,690,675],{}," を開く。",[30,693,694,697,698,701],{},[252,695,696],{},"タグ"," の ",[252,699,700],{},"タグを追加"," — 名前と色を付ける。",[30,703,704,705,405],{},"同じリストで名前変更、色変更、",[252,706,707],{},"タグを削除",[30,709,710,713],{},[252,711,712],{},"タグはまだありません"," と出たら、割り当てる前にここで追加する。",[681,715,716],{"id":716},"サウンドにタグを付ける",[13,718,719,720,722],{},"サウンドを右クリック → ",[252,721,696],{},"（チェックボックス）。1つのサウンドに複数可。タグが無い場合、メニューはフィルターパネルへ案内します。",[681,724,725],{"id":725},"ボードをフィルター",[27,727,728,735,746,757],{},[30,729,730,731,734],{},"フィルターパネル、または ",[252,732,733],{},"検索バー下のチップ"," でタグを切り替え。",[30,736,737,738,741,742,745],{},"一致は ",[252,739,740],{},"OR","：選択したタグの ",[252,743,744],{},"いずれか"," を持つサウンドが表示される。",[30,747,748,749,752,753,756],{},"ナビバーの ",[252,750,751],{},"検索"," は有効なタグフィルターと ",[252,754,755],{},"AND","（入力 + タグ）。",[30,758,759],{},"チップをオフ（またはフィルター解除）でタブ全体を再表示。",[13,761,762,763,766],{},"色付きタグ名をボタンに表示できます。",[252,764,765],{},"設定 → 動作 → タグバッジを表示"," で切り替え。",[23,768,770],{"id":769},"並べ替えソート","並べ替え（ソート）",[13,772,773],{},"フィルターパネルでソートモードを選びます：",[27,775,776,782],{},[30,777,778,781],{},[252,779,780],{},"ユーザー定義"," — タブ順、グループ表示",[30,783,784,327,787,327,790,327,793,796,797],{},[252,785,786],{},"名前",[252,788,789],{},"追加日時",[252,791,792],{},"再生時間",[252,794,795],{},"ファイルサイズ"," — フラットなソート一覧。これらのモードでは ",[252,798,799],{},"グループは非表示",[13,801,802],{},"再生時間ソートは、初回に長さのメタデータを準備することがあります。",[23,804,806],{"id":805},"並べ替えドラッグ","並べ替え（ドラッグ）",[13,808,809,812,813,816,817,819],{},[252,810,811],{},"設定 → 動作"," でドラッグ＆ドロップをオンにします（",[252,814,815],{},"並べ替えを許可","）。その後、サウンドとグループをドラッグして配置します。ドラッグ並べ替えは ",[252,818,780],{}," ソートで有効です。",[23,821,822],{"id":822},"複数選択",[13,824,748,825,827],{},[252,826,822],{}," をオンにして：",[27,829,830,833,839,846],{},[30,831,832],{},"クリックでサウンドをトグル",[30,834,835,838],{},[252,836,837],{},"Shift+クリック"," で直前のアンカーから範囲選択",[30,840,841,842,845],{},"空きボード上で ",[252,843,844],{},"マーキー"," をドラッグ",[30,847,848],{},"空きボード（または外側）をクリックして選択解除",[13,850,851,852,327,855,327,858,327,861,864],{},"一括バーに件数が表示され、",[252,853,854],{},"色",[252,856,857],{},"タブへ移動…",[252,859,860],{},"削除",[252,862,863],{},"完了"," が使えます。",[13,866,867,868,871],{},"複数選択中、各ボタンに ",[252,869,870],{},"8文字のIDチップ"," が出ます。チップを右クリックでコピー。",[23,873,874],{"id":874},"サウンドごとの音量",[13,876,877,878,881,882,885],{},"右クリック → ",[252,879,880],{},"音量","。スライダーを 0%〜100%。",[252,883,884],{},"ダブルクリック"," で 100% にリセット。",[13,887,888],{},"設定のマスター出力音量と重ねて効きます。",[23,890,892],{"id":891},"ホットキーとサウンドid","ホットキーとサウンドID",[13,894,895,896,899],{},"すべてのサウンドには8文字のIDがあります。ボタンのコンテキストメニュー（",[252,897,898],{},"IDをコピー","）、または複数選択のIDチップからコピーします。",[13,901,902,905,906,909],{},[252,903,904],{},"設定 → ホットキー"," を開き、キーをサウンドIDに割り当てます。グローバルホットキーは任意です。コンテキストメニューの ",[252,907,908],{},"ホットキーを割り当て"," は、IDを埋めた状態でそこにジャンプします。",[13,911,912,913,915],{},"同じIDを",[74,914,77],{"href":76},"がクリップのトリガーに使います。",[23,917,918],{"id":918},"背景画像と色",[13,920,921,922,926],{},"サウンドを右クリックして、ボタンごとの色や背景画像を設定します。ボード全体を整える",[74,923,925],{"href":924},"\u002Fdocs\u002Ftheme-editor","Theme Creator","とは別です。",[13,928,929,930,933],{},"ピッカーは ",[252,931,932],{},"背景画像"," ダイアログ（PNG、JPEG、GIF、WebP）：",[27,935,936,942,952],{},[30,937,938,941],{},[252,939,940],{},"ローカルファイル"," — フォルダ追加、単一ファイル選択、ファイル名検索、グリッドプレビュー、ライブラリからフォルダ削除",[30,943,944,947,948],{},[252,945,946],{},"GifSnap"," — APIキーなしでオンラインGIFを検索。初回は GifSnap へのリクエスト許可を求めます。検索結果はキャッシュして通信を減らします。",[74,949,946],{"href":950,"rel":951},"https:\u002F\u002Fgifsnap.com",[95],[30,953,954,957,958,960],{},[252,955,956],{},"KLIPY"," — オンラインGIFを検索。APIキーは ",[252,959,811],{},"。キーはプロジェクトファイルには保存されません。",[13,962,963],{},"画像を選んだあと、ボタン上でパンとクロップできます。",{"title":123,"searchDepth":124,"depth":124,"links":965},[966,967,968,973,974,975,976,977,978],{"id":600,"depth":124,"text":600},{"id":635,"depth":124,"text":635},{"id":668,"depth":124,"text":669,"children":969},[970,971,972],{"id":683,"depth":580,"text":683},{"id":716,"depth":580,"text":716},{"id":725,"depth":580,"text":725},{"id":769,"depth":124,"text":770},{"id":805,"depth":124,"text":806},{"id":822,"depth":124,"text":822},{"id":874,"depth":124,"text":874},{"id":891,"depth":124,"text":892},{"id":918,"depth":124,"text":918},"タグ、フィルター、タブ、グループ、並べ替え、複数選択、音量、ホットキー。",{},4,"\u002Forganizing-sounds",{"title":569,"description":979},"organizing-sounds","7eo3HsiR87FfpmaZ2egiJxhWDKGaOqGKyaXl1gmdAbY",{"id":987,"title":988,"body":989,"description":1111,"extension":131,"meta":1112,"navigation":133,"order":1113,"path":1114,"seo":1115,"stem":1116,"__hash__":1117},"content_ja\u002Ftheme-editor.md","テーマエディター",{"type":7,"value":990,"toc":1105},[991,993,1000,1004,1031,1034,1037,1051,1054,1080,1083,1086,1091],[10,992,988],{"id":988},[13,994,995,996,999],{},"Theme Creatorは、ボードの完全なビジュアルエディターです。",[252,997,998],{},"設定 → メイン → Theme Creator"," から開きます。",[23,1001,1003],{"id":1002},"_3つのタブ","3つのタブ",[102,1005,1006,1020,1026],{},[30,1007,1008,1011,1012,1015,1016,1019],{},[252,1009,1010],{},"一般"," — テーマ名、共有色、フォントのアップロード（",[314,1013,1014],{},".ttf"," \u002F ",[314,1017,1018],{},".otf","）",[30,1021,1022,1025],{},[252,1023,1024],{},"ボタン"," — サウンドボタンの色、書体、レイアウト、GIFオーバーレイ",[30,1027,1028,1030],{},[252,1029,600],{}," — タブバーの色、書体、枠線の太さ",[13,1032,1033],{},"編集中、ライブプレビューがタブとボタンを表示します。",[23,1035,1036],{"id":1036},"変更できる項目",[27,1038,1039,1042,1045,1048],{},[30,1040,1041],{},"プライマリとアクセントの色、背景、ボタン色、タブ色",[30,1043,1044],{},"ボタンとタブのフォントファミリーとサイズ",[30,1046,1047],{},"ボタンの幅、半径、枠線幅、隙間、パディング",[30,1049,1050],{},"GIFオーバーレイの不透明度（通常とホバー）",[23,1052,1053],{"id":1053},"保存と共有",[27,1055,1056,1062,1068,1074],{},[30,1057,1058,1061],{},[252,1059,1060],{},".cssをエクスポート"," — バックアップや友人への送信用テーマファイルを書き出す",[30,1063,1064,1067],{},[252,1065,1066],{},"テーマに追加"," — Themesフォルダに保存して適用",[30,1069,1070,1073],{},[252,1071,1072],{},".cssをインポート"," — 組み込みプリセットまたは保存済みテーマを読み込む",[30,1075,1076,1079],{},[252,1077,1078],{},"リセット"," — SoundNinjaのデフォルトに戻す",[13,1081,1082],{},"未保存の変更があるままウィンドウを閉じると、SoundNinjaが先に保存を求めます。",[23,1084,1085],{"id":1085},"フルエディターなしで",[13,1087,1088,1090],{},[252,1089,631],{}," でも次が可能です：",[27,1092,1093,1096,1102],{},[30,1094,1095],{},"リストからテーマを選ぶ",[30,1097,1098,1099,1019],{},"CSS変数をライブ編集する（",[252,1100,1101],{},"カスタムCSS",[30,1103,1104],{},"テーマファイルをThemesフォルダにインポートする",{"title":123,"searchDepth":124,"depth":124,"links":1106},[1107,1108,1109,1110],{"id":1002,"depth":124,"text":1003},{"id":1036,"depth":124,"text":1036},{"id":1053,"depth":124,"text":1053},{"id":1085,"depth":124,"text":1085},"Theme Creatorで色、フォント、ボタン、タブをデザイン。",{},5,"\u002Ftheme-editor",{"title":988,"description":1111},"theme-editor","tGeQE8HatAeqLeJ_3U4A-ac0RfIRzcoq-KghedjPolg",{"id":1119,"title":1120,"body":1121,"description":1252,"extension":131,"meta":1253,"navigation":133,"order":1254,"path":1255,"seo":1256,"stem":1257,"__hash__":1258},"content_ja\u002Frecording-editor.md","録音エディター",{"type":7,"value":1122,"toc":1246},[1123,1125,1131,1134,1140,1160,1163,1166,1191,1194,1209,1213,1227,1237],[10,1124,1120],{"id":1120},[13,1126,1127,1128,1130],{},"SoundNinja内でクリップを録音し、トリムしてタブにインポートします。プレイヤーバーの ",[252,1129,517],{}," ボタンでエディターを開きます。",[23,1132,1133],{"id":1133},"入力を選ぶ",[13,1135,1136,1139],{},[252,1137,1138],{},"設定 → オーディオ"," で：",[27,1141,1142,1148,1154],{},[30,1143,1144,1147],{},[252,1145,1146],{},"入力デバイス"," — マイク",[30,1149,1150,1153],{},[252,1151,1152],{},"出力デバイス（PCオーディオ）"," — PCが再生している音のループバック",[30,1155,1156,1159],{},[252,1157,1158],{},"入力音量"," — キャプチャゲイン 0%〜200%",[13,1161,1162],{},"録音ボタンは、ここで選んだデバイスを使います。",[23,1164,1165],{"id":1165},"テイクを編集",[27,1167,1168,1171,1174,1182,1185,1188],{},[30,1169,1170],{},"録音と停止",[30,1172,1173],{},"入力レベルメーターを確認",[30,1175,1176,255,1179],{},[252,1177,1178],{},"ノーマライズ",[252,1180,1181],{},"ノイズキャンセレーション",[30,1183,1184],{},"クリップ全体のトリム、選択範囲へのトリム、選択の削除",[30,1186,1187],{},"元に戻す \u002F やり直し",[30,1189,1190],{},"ズームインとズームアウト",[23,1192,1193],{"id":1193},"ステージしてインポート",[102,1195,1196,1199,1202],{},[30,1197,1198],{},"選択範囲またはトラック全体をステージングリストに追加します。",[30,1200,1201],{},"リストは空から始まります。録音、編集、それからクリップを追加。",[30,1203,1204,255,1206,1208],{},[252,1205,526],{},[252,1207,529],{}," で、現在のタブまたは選んだタブに入れます。",[23,1210,1212],{"id":1211},"ステム分離任意","ステム分離（任意）",[13,1214,1215,1216,1219,1220,255,1223,1226],{},"公式のWindows \u002F macOS \u002F Linuxリリースビルドには ",[252,1217,1218],{},"ステム"," 機能が入ります。Record EditorはBS-RoFormerで ",[252,1221,1222],{},"ボーカル",[252,1224,1225],{},"音楽"," を残せます。",[13,1228,1229,1230,405,1233,1236],{},"モデルは約158 MBで、インストーラーには ",[252,1231,1232],{},"同梱されていません",[252,1234,1235],{},"設定 → ステム分離"," からダウンロードするか、初回起動のプロンプトを承認します。Windowsインストーラーも初回起動時にモデルのダウンロードを案内できます。",[13,1238,1239,1240,1015,1243,488],{},"カスタムのソースビルドには追加フラグが必要です（",[314,1241,1242],{},"tauri:serve:stems",[314,1244,1245],{},"tauri:build:stems",{"title":123,"searchDepth":124,"depth":124,"links":1247},[1248,1249,1250,1251],{"id":1133,"depth":124,"text":1133},{"id":1165,"depth":124,"text":1165},{"id":1193,"depth":124,"text":1193},{"id":1211,"depth":124,"text":1212},"マイクまたはPCオーディオを取り込み、クリップを編集してボードに置く。",{},6,"\u002Frecording-editor",{"title":1120,"description":1252},"recording-editor","7_RI-WNd1luOVgn5vTAoyTmO8dKVtHVwkffwMt4LBQc",{"id":1260,"title":1261,"body":1262,"description":1473,"extension":131,"meta":1474,"navigation":133,"order":1475,"path":1476,"seo":1477,"stem":1478,"__hash__":1479},"content_ja\u002Fremote-control.md","リモートコントロール",{"type":7,"value":1263,"toc":1466},[1264,1266,1269,1272,1304,1307,1310,1344,1347,1367,1370,1373,1405,1409,1415],[10,1265,1261],{"id":1261},[13,1267,1268],{},"SoundNinjaはローカルネットワークで待ち受け、Bitfocus Companion（または任意のHTTP\u002FWebSocketクライアント）がサウンドを再生・停止できます。",[23,1270,1271],{"id":1271},"リモートサーバーを有効化",[102,1273,1274,1280,1287,1294],{},[30,1275,1276,1279],{},[252,1277,1278],{},"設定 → リモート"," を開きます。",[30,1281,1282,1283,1286],{},"リモートサーバーを有効にします。デフォルトポートは ",[252,1284,1285],{},"7331"," です。",[30,1288,1289,1290,1293],{},"任意：トークンを設定。クライアントはBearerトークンまたは ",[314,1291,1292],{},"?token="," で送ります。",[30,1295,1296,1299,1300,1303],{},[314,1297,1298],{},"http:\u002F\u002FIP:PORT"," URLをコピーするか、",[252,1301,1302],{},"設定 → 情報"," からシステムIPをコピーします。",[13,1305,1306],{},"Windowsはサーバー初回起動時にファイアウォールの確認を出すことがあります。プライベートネットワークのアクセスを許可してください。",[23,1308,77],{"id":1309},"bitfocus-companion",[102,1311,1312,1319,1327,1338],{},[30,1313,1314,1318],{},[74,1315,77],{"href":1316,"rel":1317},"https:\u002F\u002Fbitfocus.io\u002Fcompanion",[95],"をインストールします。",[30,1320,1321,1326],{},[74,1322,1325],{"href":1323,"rel":1324},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002Fcompanion-module-soundninja\u002Freleases\u002Flatest",[95],"SoundNinja-Companion.tgz"," をダウンロード。Companion Storeのパッケージはまだありません。",[30,1328,1329,1330,1333,1334,1337],{},"Companionで ",[252,1331,1332],{},"Modules → Load module package"," を開き、",[314,1335,1336],{},".tgz"," を選びます。",[30,1339,1340,1343],{},[252,1341,1342],{},"Sound Ninja"," 接続を追加。PCのIP、ポート、設定したトークンを貼り付けます。",[23,1345,1346],{"id":1346},"アクション",[27,1348,1349,1355,1361],{},[30,1350,1351,1354],{},[252,1352,1353],{},"Trigger Sound"," — ライブドロップダウンから選ぶか、8文字のサウンドIDを入力（Companion変数が使えます）",[30,1356,1357,1360],{},[252,1358,1359],{},"Stop Sound"," — IDで再生中のサウンドを1つ停止",[30,1362,1363,1366],{},[252,1364,1365],{},"Stop All"," — 再生中の全サウンドを停止",[13,1368,1369],{},"SoundNinjaでは、ボタンのコンテキストメニューまたは複数選択のIDチップからサウンドIDをコピーします。",[23,1371,1372],{"id":1372},"フィードバックと変数",[27,1374,1375,1381,1393,1399],{},[30,1376,1377,1380],{},[252,1378,1379],{},"Sound Playing"," — そのサウンドIDがアクティブな間はtrue（ボタン色に使う）",[30,1382,1383,1386,1387,1015,1390],{},[314,1384,1385],{},"$(soundninja:connected)"," — ",[314,1388,1389],{},"true",[314,1391,1392],{},"false",[30,1394,1395,1398],{},[314,1396,1397],{},"$(soundninja:playing_count)"," — 再生中のサウンド数",[30,1400,1401,1404],{},[314,1402,1403],{},"$(soundninja:last_triggered)"," — 最後にトリガーしたサウンドID",[23,1406,1408],{"id":1407},"http-api上級","HTTP API（上級）",[13,1410,1411,1412],{},"ベースパス：",[314,1413,1414],{},"\u002Fapi\u002Fv1",[27,1416,1417,1423,1429,1435,1445,1451,1460],{},[30,1418,1419,1422],{},[314,1420,1421],{},"GET \u002Finfo"," — アプリ名、バージョン、プロトコル、トークンが必要か",[30,1424,1425,1428],{},[314,1426,1427],{},"GET \u002Fsounds"," — サウンド一覧（id、name、tabs、active）",[30,1430,1431,1434],{},[314,1432,1433],{},"GET \u002Fstate"," — サウンドと現在再生中のID",[30,1436,1437,1440,1441,1444],{},[314,1438,1439],{},"POST \u002Ftrigger"," に ",[314,1442,1443],{},"{ \"id\" }"," — サウンドを再生",[30,1446,1447,1450],{},[314,1448,1449],{},"GET \u002Ftrigger\u002F:id"," — 再生（ブラウザで簡単にテスト）",[30,1452,1453,1456,1457,1459],{},[314,1454,1455],{},"POST \u002Fstop"," に任意の ",[314,1458,1443],{}," — 1つまたはすべて停止",[30,1461,1462,1465],{},[314,1463,1464],{},"GET \u002Fws"," — ライブ状態。trigger\u002Fstopコマンドを受信",{"title":123,"searchDepth":124,"depth":124,"links":1467},[1468,1469,1470,1471,1472],{"id":1271,"depth":124,"text":1271},{"id":1309,"depth":124,"text":77},{"id":1346,"depth":124,"text":1346},{"id":1372,"depth":124,"text":1372},{"id":1407,"depth":124,"text":1408},"ローカルネットワーク経由でBitfocus CompanionからSoundNinjaを操作。",{},7,"\u002Fremote-control",{"title":1261,"description":1473},"remote-control","mPFqlRPL-jxRSpdtuwlQQcHhnmsyzKrKdjplGWwWueU",{"id":1481,"title":1482,"body":1483,"description":1568,"extension":131,"meta":1569,"navigation":133,"order":1570,"path":1571,"seo":1572,"stem":1573,"__hash__":1574},"content_ja\u002Fsupport.md","サポート",{"type":7,"value":1484,"toc":1561},[1485,1487,1490