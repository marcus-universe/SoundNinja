[{"data":1,"prerenderedAt":1276},["ShallowReactive",2],{"docs-page-ja-\u002Foverview":3,"docs-nav-ja":130},{"id":4,"title":5,"body":6,"description":121,"extension":122,"meta":123,"navigation":124,"order":125,"path":126,"seo":127,"stem":128,"__hash__":129},"content_ja\u002Foverview.md","概要",{"type":7,"value":8,"toc":113},"minimark",[9,12,16,19,22,26,42,45,76,79,89,92],[10,11,5],"h1",{"id":5},[13,14,15],"p",{},"SoundNinjaは、ライブ配信、友だちとのチャット、ポッドキャスト収録向けのオープンソースサウンドボードです。Tauri v2とNuxt 4で構築されており、RAMとディスクの負荷を抑えています。",[13,17,18],{},"目標はシンプルです。巨大なサウンドライブラリをすばやく眺め、目的のクリップをミリ秒で再生すること。UIはVRのダッシュボードとしても使いやすいです。",[13,20,21],{},"SoundNinjaはまだ初期開発段階です。機能は動きますが、すべてのプラットフォームで完全に検証されているわけではありません。",[23,24,25],"h2",{"id":25},"対象ユーザー",[27,28,29,33,36,39],"ul",{},[30,31,32],"li",{},"即時のサウンドキューが必要な配信者",[30,34,35],{},"ボイスチャット用の共有ボードが欲しい友だち",[30,37,38],{},"クリップを録ってボードに置くポッドキャスター",[30,40,41],{},"カスタマイズ可能な、ローカル優先のサウンドボードが欲しい人",[23,43,44],{"id":44},"できること",[27,46,47,50,53,56,59,62,70,73],{},[30,48,49],{},"自分の音声ファイルからサウンドボードを作る",[30,51,52],{},"色付きタブ、グループ、検索で整理する",[30,54,55],{},"Theme Creatorで見た目をデザインする",[30,57,58],{},"Record EditorでPCオーディオまたはマイクを録音する",[30,60,61],{},"個別のサウンドにホットキーを割り当てる",[30,63,64,69],{},[65,66,68],"a",{"href":67},"\u002Fdocs\u002Fremote-control","Bitfocus Companion","からサウンドをトリガーする",[30,71,72],{},"サウンドボード全体をインポート／エクスポートして共有する",[30,74,75],{},"サウンドボタンにGIFや画像を使う",[23,77,78],{"id":78},"ライセンス",[13,80,81,82,88],{},"SoundNinjaは",[65,83,87],{"href":84,"rel":85},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fblob\u002Fmain\u002FLICENSE",[86],"nofollow","GPL-3.0","のフリーソフトウェアです。フォーク、改変、共有できます。",[23,90,91],{"id":91},"次のステップ",[93,94,95,101,107],"ol",{},[30,96,97],{},[65,98,100],{"href":99},"\u002Fdocs\u002Finstallation","SoundNinjaをインストール",[30,102,103],{},[65,104,106],{"href":105},"\u002Fdocs\u002Fadding-sounds","サウンドを追加",[30,108,109],{},[65,110,112],{"href":111},"\u002Fdocs\u002Forganizing-sounds","ボードを整理",{"title":114,"searchDepth":115,"depth":115,"links":116},"",2,[117,118,119,120],{"id":25,"depth":115,"text":25},{"id":44,"depth":115,"text":44},{"id":78,"depth":115,"text":78},{"id":91,"depth":115,"text":91},"SoundNinjaとは何か、何ができるか。","md",{},true,1,"\u002Foverview",{"title":5,"description":121},"overview","KJDpLdg7ixvHWAtVFjPRaSTU7NMWgwE__i0PB3mQH3E",[131,207,405,546,692,824,960,1181],{"id":4,"title":5,"body":132,"description":121,"extension":122,"meta":205,"navigation":124,"order":125,"path":126,"seo":206,"stem":128,"__hash__":129},{"type":7,"value":133,"toc":199},[134,136,138,140,142,144,154,156,176,178,183,185],[10,135,5],{"id":5},[13,137,15],{},[13,139,18],{},[13,141,21],{},[23,143,25],{"id":25},[27,145,146,148,150,152],{},[30,147,32],{},[30,149,35],{},[30,151,38],{},[30,153,41],{},[23,155,44],{"id":44},[27,157,158,160,162,164,166,168,172,174],{},[30,159,49],{},[30,161,52],{},[30,163,55],{},[30,165,58],{},[30,167,61],{},[30,169,170,69],{},[65,171,68],{"href":67},[30,173,72],{},[30,175,75],{},[23,177,78],{"id":78},[13,179,81,180,88],{},[65,181,87],{"href":84,"rel":182},[86],[23,184,91],{"id":91},[93,186,187,191,195],{},[30,188,189],{},[65,190,100],{"href":99},[30,192,193],{},[65,194,106],{"href":105},[30,196,197],{},[65,198,112],{"href":111},{"title":114,"searchDepth":115,"depth":115,"links":200},[201,202,203,204],{"id":25,"depth":115,"text":25},{"id":44,"depth":115,"text":44},{"id":78,"depth":115,"text":78},{"id":91,"depth":115,"text":91},{},{"title":5,"description":121},{"id":208,"title":209,"body":210,"description":399,"extension":122,"meta":400,"navigation":124,"order":115,"path":401,"seo":402,"stem":403,"__hash__":404},"content_ja\u002Finstallation.md","インストール",{"type":7,"value":211,"toc":392},[212,214,227,231,250,253,257,271,274,278,303,314,317,324,327,342,372,388],[10,213,209],{"id":209},[13,215,216,220,221,226],{},[65,217,219],{"href":218},"\u002Fdownload","ダウンロードページ","または",[65,222,225],{"href":223,"rel":224},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Freleases\u002Flatest",[86],"GitHub Releases","からビルドを入手してください。SoundNinjaは初期開発中なので、ビルドはベータとして扱ってください。",[23,228,230],{"id":229},"windows","Windows",[27,232,233,244,247],{},[30,234,235,236,240,241],{},"64ビットWindows向けの",[237,238,239],"strong",{},"インストーラー (.exe)"," または ",[237,242,243],{},"MSI (.msi)",[30,245,246],{},"ランディングページの対象：Windows 10以降",[30,248,249],{},"アプリのREADMEはWindows 8以上も記載",[13,251,252],{},"インストーラーを実行し、スタートメニューからSoundNinjaを起動します。",[23,254,256],{"id":255},"macos","macOS",[27,258,259,265,268],{},[30,260,261,262],{},"Apple SiliconとIntel向けの",[237,263,264],{},"ユニバーサル .dmg",[30,266,267],{},"ランディングページの対象：macOS 10.14以降",[30,269,270],{},"アプリのREADMEはmacOS 10.15以上を記載",[13,272,273],{},"ディスクイメージを開き、SoundNinjaをアプリケーションにドラッグします。",[23,275,277],{"id":276},"linux","Linux",[27,279,280,286,292,300],{},[30,281,282,283],{},"Ubuntu \u002F Debian向けの",[237,284,285],{},"Debian (.deb)",[30,287,288,289],{},"その他のディストリ向けの",[237,290,291],{},"AppImage",[30,293,294,295,299],{},"リリース公開後、ArchユーザーはAURから",[296,297,298],"code",{},"soundninja-bin","をインストールできます",[30,301,302],{},"Ubuntu 20.04でテスト済み",[13,304,305,306,309,310,313],{},"デスクトップビルドにはWebKitとGTKのパッケージが必要です。Debian\u002FUbuntuでは通常、",[296,307,308],{},"libwebkit2gtk","、",[296,311,312],{},"libgtk-3-0","、app-indicatorライブラリです。",[23,315,316],{"id":316},"アップデート",[13,318,319,320,323],{},"アプリ内で ",[237,321,322],{},"ヘルプ → アップデートを確認"," を開きます。設定で起動時にSoundNinjaが確認するようにもできます。",[23,325,326],{"id":326},"ソースからビルド",[13,328,329,330,335,336,341],{},"カスタムビルドが必要なら、",[65,331,334],{"href":332,"rel":333},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja",[86],"リポジトリ","をクローンし、",[65,337,340],{"href":338,"rel":339},"https:\u002F\u002Fv2.tauri.app\u002Fstart\u002Fprerequisites\u002F",[86],"Tauriの前提条件","を入れたうえで：",[343,344,348],"pre",{"className":345,"code":346,"language":347,"meta":114,"style":114},"language-bash shiki shiki-themes github-light github-dark","bun install\nbun run tauri:serve\n","bash",[296,349,350,362],{"__ignoreMap":114},[351,352,354,358],"span",{"class":353,"line":125},"line",[351,355,357],{"class":356},"sScJk","bun",[351,359,361],{"class":360},"sZZnC"," install\n",[351,363,364,366,369],{"class":353,"line":115},[351,365,357],{"class":356},[351,367,368],{"class":360}," run",[351,370,371],{"class":360}," tauri:serve\n",[13,373,374,309,377,309,380,383,384,387],{},[296,375,376],{},"npm",[296,378,379],{},"pnpm",[296,381,382],{},"deno","でも動きます。本番ビルド：",[296,385,386],{},"bun run tauri:build","。",[389,390,391],"style",{},"html pre.shiki code .sScJk, html code.shiki .sScJk{--shiki-default:#6F42C1;--shiki-dark:#B392F0}html pre.shiki code .sZZnC, html code.shiki .sZZnC{--shiki-default:#032F62;--shiki-dark:#9ECBFF}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html.dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}",{"title":114,"searchDepth":115,"depth":115,"links":393},[394,395,396,397,398],{"id":229,"depth":115,"text":230},{"id":255,"depth":115,"text":256},{"id":276,"depth":115,"text":277},{"id":316,"depth":115,"text":316},{"id":326,"depth":115,"text":326},"Windows、macOS、LinuxにSoundNinjaをインストール。",{},"\u002Finstallation",{"title":209,"description":399},"installation","PtsEiD1MtLz3wDVCCGAWac0JxyBztTW1uRBbWQWqSOs",{"id":406,"title":407,"body":408,"description":539,"extension":122,"meta":540,"navigation":124,"order":541,"path":542,"seo":543,"stem":544,"__hash__":545},"content_ja\u002Fadding-sounds.md","サウンドの追加",{"type":7,"value":409,"toc":531},[410,412,415,418,436,439,470,473,492,495,509,512,515,522,525],[10,411,407],{"id":407},[13,413,414],{},"クリップを追加するまで、ボードは空です。SoundNinjaはファイル、フォルダ全体、録音、共有サウンドボードパックをインポートできます。",[23,416,417],{"id":417},"音声ファイルをインポート",[93,419,420,430,433],{},[30,421,422,425,426,429],{},[237,423,424],{},"ファイル → 音声ファイルをインポート","、またはナビバーの ",[237,427,428],{},"インポート"," を使います。",[30,431,432],{},"1つ以上の音声ファイルを選びます。",[30,434,435],{},"サウンドは現在のタブに入ります。",[23,437,438],{"id":438},"フォルダをインポート",[93,440,441,450,453],{},[30,442,443,446,447,449],{},[237,444,445],{},"ファイル → フォルダをインポート","（またはナビバーの ",[237,448,438],{},"）。",[30,451,452],{},"1つ以上のフォルダを追加。インポート前にドラッグで並べ替えできます。",[30,454,455,456],{},"配置方法を選びます：\n",[27,457,458,464],{},[30,459,460,463],{},[237,461,462],{},"タブとしてインポート"," — 各フォルダが独自のタブになる",[30,465,466,469],{},[237,467,468],{},"現在のタブにインポート"," — すべてのファイルがアクティブなタブに入る",[23,471,472],{"id":472},"クリップを録音",[13,474,475,476,479,480,484,485,240,488,491],{},"プレイヤーバーの ",[237,477,478],{},"録音"," ボタンから",[65,481,483],{"href":482},"\u002Fdocs\u002Frecording-editor","Record Editor","を開きます。キャプチャ、トリムし、",[237,486,487],{},"選択をインポート",[237,489,490],{},"すべてインポート"," で現在のタブまたは選んだタブに入れます。",[23,493,494],{"id":494},"サウンドボードをインポート",[13,496,497,500,501,504,505,508],{},[237,498,499],{},"ファイル → サウンドボードをインポート"," で共有パックを読み込みます。パックは ",[296,502,503],{},"project.sninja"," とサウンドファイルを含む ",[296,506,507],{},".zip"," です。インポート後、プロジェクトを開いて再生します。",[13,510,511],{},"複数のプロジェクト（プロファイル）も保てます。プロジェクトセレクターでボードを切り替えます。",[23,513,514],{"id":514},"見つからないファイルを再リンク",[13,516,517,518,521],{},"ディスク上で音声ファイルが移動すると、SoundNinjaは ",[237,519,520],{},"見つからないサウンドファイル"," ダイアログを表示します。検索するフォルダを選び、クリップを再リンクします。",[23,523,524],{"id":524},"次へ",[13,526,527,528,387],{},"タブ、グループ、ホットキーの整理は",[65,529,530],{"href":111},"サウンドの整理",{"title":114,"searchDepth":115,"depth":115,"links":532},[533,534,535,536,537,538],{"id":417,"depth":115,"text":417},{"id":438,"depth":115,"text":438},{"id":472,"depth":115,"text":472},{"id":494,"depth":115,"text":494},{"id":514,"depth":115,"text":514},{"id":524,"depth":115,"text":524},"音声、フォルダ、録音、共有サウンドボードをインポート。",{},3,"\u002Fadding-sounds",{"title":407,"description":539},"adding-sounds","Fa08TvxAivFfa2zc5Ab8J5x_IO2j6rzWXGssNBY_HnY",{"id":547,"title":530,"body":548,"description":685,"extension":122,"meta":686,"navigation":124,"order":687,"path":688,"seo":689,"stem":690,"__hash__":691},"content_ja\u002Forganizing-sounds.md",{"type":7,"value":549,"toc":676},[550,552,555,558,583,590,593,596,610,617,620,626,629,639,642,645,649,652,658,664,668],[10,551,530],{"id":530},[13,553,554],{},"SoundNinjaは大規模ライブラリ向けです。タブ、グループ、検索、ホットキーで、必要なクリップをワンクリック（またはワンキー）で出せます。",[23,556,557],{"id":557},"タブ",[27,559,560,566,572],{},[30,561,562,565],{},[237,563,564],{},"タブを追加"," でタブを作り、色を付けてバーをすばやく眺められます。",[30,567,568,571],{},[237,569,570],{},"すべて"," ビューはタブを横断して全サウンドを表示します。",[30,573,574,575,578,579,582],{},"サウンドは ",[237,576,577],{},"1つ以上のタブ"," に所属できます。サウンドを右クリックし、",[237,580,581],{},"タブへ移動"," で割り当てます。",[13,584,585,586,589],{},"タブの切り替え演出は ",[237,587,588],{},"設定 → メイン","：スライド、フェード、ボタンを1つずつ、またはなし。",[23,591,592],{"id":592},"グループ",[13,594,595],{},"v0.5.3以降、セパレーターを名前付きグループにできます：",[27,597,598,601,604,607],{},[30,599,600],{},"コンテキストメニューからグループの追加、名前変更、削除",[30,602,603],{},"グループヘッダーをドラッグ — 子も一緒に動く",[30,605,606],{},"グループにサウンドを入れたり出したり",[30,608,609],{},"グループの枠線色、名前の色、ボタン配置を設定（またはタブのデフォルトを使う）",[13,611,612,613,616],{},"見た目の区切りだけなら、通常の ",[237,614,615],{},"セパレーター"," も追加できます。",[23,618,619],{"id":619},"検索",[13,621,622,623,625],{},"ナビバーの ",[237,624,619],{}," フィールドを使います。入力に合わせて結果が更新されます。",[23,627,628],{"id":628},"並べ替え",[13,630,631,634,635,638],{},[237,632,633],{},"設定 → 動作"," でドラッグ＆ドロップをオンにします（",[237,636,637],{},"並べ替えを許可","）。その後、サウンドとグループをドラッグして配置します。",[23,640,641],{"id":641},"一括編集",[13,643,644],{},"複数のサウンドを選び、色の変更、タブへの移動、削除を一度に行えます。",[23,646,648],{"id":647},"ホットキーとサウンドid","ホットキーとサウンドID",[13,650,651],{},"すべてのサウンドには8文字のIDがあります。ボタンのコンテキストメニュー、または複数選択のIDチップからコピーします。",[13,653,654,657],{},[237,655,656],{},"設定 → ホットキー"," を開き、キーをサウンドIDに割り当てます。グローバルホットキーは任意です。",[13,659,660,661,663],{},"同じIDを",[65,662,68],{"href":67},"がクリップのトリガーに使います。",[23,665,667],{"id":666},"gifと色","GIFと色",[13,669,670,671,675],{},"サウンドを右クリックして、ボタンごとの色やGIF \u002F 画像背景を設定します。ボード全体を整える",[65,672,674],{"href":673},"\u002Fdocs\u002Ftheme-editor","Theme Creator","とは別です。",{"title":114,"searchDepth":115,"depth":115,"links":677},[678,679,680,681,682,683,684],{"id":557,"depth":115,"text":557},{"id":592,"depth":115,"text":592},{"id":619,"depth":115,"text":619},{"id":628,"depth":115,"text":628},{"id":641,"depth":115,"text":641},{"id":647,"depth":115,"text":648},{"id":666,"depth":115,"text":667},"タブ、グループ、検索、一括編集、ホットキー。",{},4,"\u002Forganizing-sounds",{"title":530,"description":685},"organizing-sounds","0mH24BvA7-1dcjELHB8mQnjaQMzT8Ie60aamXtNUZEE",{"id":693,"title":694,"body":695,"description":817,"extension":122,"meta":818,"navigation":124,"order":819,"path":820,"seo":821,"stem":822,"__hash__":823},"content_ja\u002Ftheme-editor.md","テーマエディター",{"type":7,"value":696,"toc":811},[697,699,706,710,737,740,743,757,760,786,789,792,797],[10,698,694],{"id":694},[13,700,701,702,705],{},"Theme Creatorは、ボードの完全なビジュアルエディターです。",[237,703,704],{},"設定 → メイン → Theme Creator"," から開きます。",[23,707,709],{"id":708},"_3つのタブ","3つのタブ",[93,711,712,726,732],{},[30,713,714,717,718,721,722,725],{},[237,715,716],{},"一般"," — テーマ名、共有色、フォントのアップロード（",[296,719,720],{},".ttf"," \u002F ",[296,723,724],{},".otf","）",[30,727,728,731],{},[237,729,730],{},"ボタン"," — サウンドボタンの色、書体、レイアウト、GIFオーバーレイ",[30,733,734,736],{},[237,735,557],{}," — タブバーの色、書体、枠線の太さ",[13,738,739],{},"編集中、ライブプレビューがタブとボタンを表示します。",[23,741,742],{"id":742},"変更できる項目",[27,744,745,748,751,754],{},[30,746,747],{},"プライマリとアクセントの色、背景、ボタン色、タブ色",[30,749,750],{},"ボタンとタブのフォントファミリーとサイズ",[30,752,753],{},"ボタンの幅、半径、枠線幅、隙間、パディング",[30,755,756],{},"GIFオーバーレイの不透明度（通常とホバー）",[23,758,759],{"id":759},"保存と共有",[27,761,762,768,774,780],{},[30,763,764,767],{},[237,765,766],{},".cssをエクスポート"," — バックアップや友人への送信用テーマファイルを書き出す",[30,769,770,773],{},[237,771,772],{},"テーマに追加"," — Themesフォルダに保存して適用",[30,775,776,779],{},[237,777,778],{},".cssをインポート"," — 組み込みプリセットまたは保存済みテーマを読み込む",[30,781,782,785],{},[237,783,784],{},"リセット"," — SoundNinjaのデフォルトに戻す",[13,787,788],{},"未保存の変更があるままウィンドウを閉じると、SoundNinjaが先に保存を求めます。",[23,790,791],{"id":791},"フルエディターなしで",[13,793,794,796],{},[237,795,588],{}," でも次が可能です：",[27,798,799,802,808],{},[30,800,801],{},"リストからテーマを選ぶ",[30,803,804,805,725],{},"CSS変数をライブ編集する（",[237,806,807],{},"カスタムCSS",[30,809,810],{},"テーマファイルをThemesフォルダにインポートする",{"title":114,"searchDepth":115,"depth":115,"links":812},[813,814,815,816],{"id":708,"depth":115,"text":709},{"id":742,"depth":115,"text":742},{"id":759,"depth":115,"text":759},{"id":791,"depth":115,"text":791},"Theme Creatorで色、フォント、ボタン、タブをデザイン。",{},5,"\u002Ftheme-editor",{"title":694,"description":817},"theme-editor","tGeQE8HatAeqLeJ_3U4A-ac0RfIRzcoq-KghedjPolg",{"id":825,"title":826,"body":827,"description":953,"extension":122,"meta":954,"navigation":124,"order":955,"path":956,"seo":957,"stem":958,"__hash__":959},"content_ja\u002Frecording-editor.md","録音エディター",{"type":7,"value":828,"toc":947},[829,831,837,840,846,866,869,872,897,900,915,919,932,938],[10,830,826],{"id":826},[13,832,833,834,836],{},"SoundNinja内でクリップを録音し、トリムしてタブにインポートします。プレイヤーバーの ",[237,835,478],{}," ボタンでエディターを開きます。",[23,838,839],{"id":839},"入力を選ぶ",[13,841,842,845],{},[237,843,844],{},"設定 → オーディオ"," で：",[27,847,848,854,860],{},[30,849,850,853],{},[237,851,852],{},"入力デバイス"," — マイク",[30,855,856,859],{},[237,857,858],{},"出力デバイス（PCオーディオ）"," — PCが再生している音のループバック",[30,861,862,865],{},[237,863,864],{},"入力音量"," — キャプチャゲイン 0%〜200%",[13,867,868],{},"録音ボタンは、ここで選んだデバイスを使います。",[23,870,871],{"id":871},"テイクを編集",[27,873,874,877,880,888,891,894],{},[30,875,876],{},"録音と停止",[30,878,879],{},"入力レベルメーターを確認",[30,881,882,240,885],{},[237,883,884],{},"ノーマライズ",[237,886,887],{},"ノイズキャンセレーション",[30,889,890],{},"クリップ全体のトリム、選択範囲へのトリム、選択の削除",[30,892,893],{},"元に戻す \u002F やり直し",[30,895,896],{},"ズームインとズームアウト",[23,898,899],{"id":899},"ステージしてインポート",[93,901,902,905,908],{},[30,903,904],{},"選択範囲またはトラック全体をステージングリストに追加します。",[30,906,907],{},"リストは空から始まります。録音、編集、それからクリップを追加。",[30,909,910,240,912,914],{},[237,911,487],{},[237,913,490],{}," で、現在のタブまたは選んだタブに入れます。",[23,916,918],{"id":917},"ステム分離任意","ステム分離（任意）",[13,920,921,922,240,925,928,929,387],{},"Record EditorはBS-RoFormerで ",[237,923,924],{},"ボーカル",[237,926,927],{},"音楽"," を残せます。モデルは約158 MBで、アプリには ",[237,930,931],{},"同梱されていません",[13,933,934,937],{},[237,935,936],{},"設定 → ステム分離"," からダウンロードするか、初回起動のプロンプトを承認します。Windowsインストーラーも初回起動時にモデルのダウンロードを案内できます。",[13,939,940,941,721,944,449],{},"ソースからのステムビルドには追加フラグが必要です（",[296,942,943],{},"tauri:serve:stems",[296,945,946],{},"tauri:build:stems",{"title":114,"searchDepth":115,"depth":115,"links":948},[949,950,951,952],{"id":839,"depth":115,"text":839},{"id":871,"depth":115,"text":871},{"id":899,"depth":115,"text":899},{"id":917,"depth":115,"text":918},"マイクまたはPCオーディオを取り込み、クリップを編集してボードに置く。",{},6,"\u002Frecording-editor",{"title":826,"description":953},"recording-editor","fkw2G1vYZhqRZ8t2Y9irOID6H-BdjzVV8fvv-hE_qbo",{"id":961,"title":962,"body":963,"description":1174,"extension":122,"meta":1175,"navigation":124,"order":1176,"path":1177,"seo":1178,"stem":1179,"__hash__":1180},"content_ja\u002Fremote-control.md","リモートコントロール",{"type":7,"value":964,"toc":1167},[965,967,970,973,1005,1008,1011,1045,1048,1068,1071,1074,1106,1110,1116],[10,966,962],{"id":962},[13,968,969],{},"SoundNinjaはローカルネットワークで待ち受け、Bitfocus Companion（または任意のHTTP\u002FWebSocketクライアント）がサウンドを再生・停止できます。",[23,971,972],{"id":972},"リモートサーバーを有効化",[93,974,975,981,988,995],{},[30,976,977,980],{},[237,978,979],{},"設定 → リモート"," を開きます。",[30,982,983,984,987],{},"リモートサーバーを有効にします。デフォルトポートは ",[237,985,986],{},"7331"," です。",[30,989,990,991,994],{},"任意：トークンを設定。クライアントはBearerトークンまたは ",[296,992,993],{},"?token="," で送ります。",[30,996,997,1000,1001,1004],{},[296,998,999],{},"http:\u002F\u002FIP:PORT"," URLをコピーするか、",[237,1002,1003],{},"設定 → 情報"," からシステムIPをコピーします。",[13,1006,1007],{},"Windowsはサーバー初回起動時にファイアウォールの確認を出すことがあります。プライベートネットワークのアクセスを許可してください。",[23,1009,68],{"id":1010},"bitfocus-companion",[93,1012,1013,1020,1028,1039],{},[30,1014,1015,1019],{},[65,1016,68],{"href":1017,"rel":1018},"https:\u002F\u002Fbitfocus.io\u002Fcompanion",[86],"をインストールします。",[30,1021,1022,1027],{},[65,1023,1026],{"href":1024,"rel":1025},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Freleases\u002Flatest\u002Fdownload\u002Fcompanion-module-soundninja.tgz",[86],"companion-module-soundninja.tgz"," をダウンロード。Companion Storeのパッケージはまだありません。",[30,1029,1030,1031,1034,1035,1038],{},"Companionで ",[237,1032,1033],{},"Modules → Load module package"," を開き、",[296,1036,1037],{},".tgz"," を選びます。",[30,1040,1041,1044],{},[237,1042,1043],{},"Sound Ninja"," 接続を追加。PCのIP、ポート、設定したトークンを貼り付けます。",[23,1046,1047],{"id":1047},"アクション",[27,1049,1050,1056,1062],{},[30,1051,1052,1055],{},[237,1053,1054],{},"Trigger Sound"," — ライブドロップダウンから選ぶか、8文字のサウンドIDを入力（Companion変数が使えます）",[30,1057,1058,1061],{},[237,1059,1060],{},"Stop Sound"," — IDで再生中のサウンドを1つ停止",[30,1063,1064,1067],{},[237,1065,1066],{},"Stop All"," — 再生中の全サウンドを停止",[13,1069,1070],{},"SoundNinjaでは、ボタンのコンテキストメニューまたは複数選択のIDチップからサウンドIDをコピーします。",[23,1072,1073],{"id":1073},"フィードバックと変数",[27,1075,1076,1082,1094,1100],{},[30,1077,1078,1081],{},[237,1079,1080],{},"Sound Playing"," — そのサウンドIDがアクティブな間はtrue（ボタン色に使う）",[30,1083,1084,1087,1088,721,1091],{},[296,1085,1086],{},"$(soundninja:connected)"," — ",[296,1089,1090],{},"true",[296,1092,1093],{},"false",[30,1095,1096,1099],{},[296,1097,1098],{},"$(soundninja:playing_count)"," — 再生中のサウンド数",[30,1101,1102,1105],{},[296,1103,1104],{},"$(soundninja:last_triggered)"," — 最後にトリガーしたサウンドID",[23,1107,1109],{"id":1108},"http-api上級","HTTP API（上級）",[13,1111,1112,1113],{},"ベースパス：",[296,1114,1115],{},"\u002Fapi\u002Fv1",[27,1117,1118,1124,1130,1136,1146,1152,1161],{},[30,1119,1120,1123],{},[296,1121,1122],{},"GET \u002Finfo"," — アプリ名、バージョン、プロトコル、トークンが必要か",[30,1125,1126,1129],{},[296,1127,1128],{},"GET \u002Fsounds"," — サウンド一覧（id、name、tabs、active）",[30,1131,1132,1135],{},[296,1133,1134],{},"GET \u002Fstate"," — サウンドと現在再生中のID",[30,1137,1138,1141,1142,1145],{},[296,1139,1140],{},"POST \u002Ftrigger"," に ",[296,1143,1144],{},"{ \"id\" }"," — サウンドを再生",[30,1147,1148,1151],{},[296,1149,1150],{},"GET \u002Ftrigger\u002F:id"," — 再生（ブラウザで簡単にテスト）",[30,1153,1154,1157,1158,1160],{},[296,1155,1156],{},"POST \u002Fstop"," に任意の ",[296,1159,1144],{}," — 1つまたはすべて停止",[30,1162,1163,1166],{},[296,1164,1165],{},"GET \u002Fws"," — ライブ状態。trigger\u002Fstopコマンドを受信",{"title":114,"searchDepth":115,"depth":115,"links":1168},[1169,1170,1171,1172,1173],{"id":972,"depth":115,"text":972},{"id":1010,"depth":115,"text":68},{"id":1047,"depth":115,"text":1047},{"id":1073,"depth":115,"text":1073},{"id":1108,"depth":115,"text":1109},"ローカルネットワーク経由でBitfocus CompanionからSoundNinjaを操作。",{},7,"\u002Fremote-control",{"title":962,"description":1174},"remote-control","PoAD2qLfe4cF4Z_a5pIF5291-yAlbNAcy3yNZfTB5RM",{"id":1182,"title":1183,"body":1184,"description":1269,"extension":122,"meta":1270,"navigation":124,"order":1271,"path":1272,"seo":1273,"stem":1274,"__hash__":1275},"content_ja\u002Fsupport.md","サポート",{"type":7,"value":1185,"toc":1262},[1186,1188,1191,1194,1197,1204,1212,1215,1222,1224,1237,1240,1252,1255],[10,1187,1183],{"id":1183},[13,1189,1190],{},"SoundNinjaは初期ベータのコミュニティプロジェクトです。いちばん早い助けはGitHubです。",[23,1192,1193],{"id":1193},"バグ報告または質問",[13,1195,1196],{},"GitHubでissueを開いてください：",[13,1198,1199],{},[65,1200,1203],{"href":1201,"rel":1202},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fissues",[86],"github.com\u002Fmarcus-universe\u002FSoundNinja\u002Fissues",[13,1205,1206,1207,240,1209,1211],{},"OS、SoundNinjaのバージョン（",[237,1208,322],{},[237,1210,1003],{},"）、再現手順を書いてください。",[23,1213,1214],{"id":1214},"メール",[13,1216,1217,1218],{},"メンテナー連絡先：",[65,1219,1221],{"href":1220},"mailto:contact@marcus-universe.de","contact@marcus-universe.de",[23,1223,316],{"id":316},[13,1225,319,1226,1228,1229,1231,1232,1236],{},[237,1227,322],{}," を使います。新しいビルドは",[65,1230,219],{"href":218},"と",[65,1233,225],{"href":1234,"rel":1235},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Freleases",[86],"にも出ます。",[23,1238,1239],{"id":1239},"コントリビュート",[13,1241,1242,1243,1247,1248,1251],{},"プルリクエストを歓迎します。アプリのリポジトリは",[65,1244,1246],{"href":332,"rel":1245},[86],"github.com\u002Fmarcus-universe\u002FSoundNinja","です。プロジェクトは",[65,1249,87],{"href":84,"rel":1250},[86],"ライセンスです。",[23,1253,1254],{"id":1254},"法的情報",[13,1256,1257,1258,387],{},"インプリントと連絡先：",[65,1259,1261],{"href":1260},"\u002Fimpressum","インプリント",{"title":114,"searchDepth":115,"depth":115,"links":1263},[1264,1265,1266,1267,1268],{"id":1193,"depth":115,"text":1193},{"id":1214,"depth":115,"text":1214},{"id":316,"depth":115,"text":316},{"id":1239,"depth":115,"text":1239},{"id":1254,"depth":115,"text":1254},"ヘルプの入手先とバグ報告。",{},8,"\u002Fsupport",{"title":1183,"description":1269},"support","T2BdU-sWENDKBxowzv9wjeevj1bEK3iit1IGD77Vz_M",1788384660630]