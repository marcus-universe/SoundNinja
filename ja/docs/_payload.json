[{"data":1,"prerenderedAt":1544},["ShallowReactive",2],{"docs-page-ja-\u002Foverview":3,"docs-nav-ja":139},{"id":4,"title":5,"body":6,"description":130,"extension":131,"meta":132,"navigation":133,"order":134,"path":135,"seo":136,"stem":137,"__hash__":138},"content_ja\u002Foverview.md","概要",{"type":7,"value":8,"toc":122},"minimark",[9,12,16,19,22,26,42,45,85,88,98,101],[10,11,5],"h1",{"id":5},[13,14,15],"p",{},"SoundNinjaは、ライブ配信、友だちとのチャット、ポッドキャスト収録向けのオープンソースサウンドボードです。Tauri v2とNuxt 4で構築されており、RAMとディスクの負荷を抑えています。",[13,17,18],{},"目標はシンプルです。巨大なサウンドライブラリをすばやく眺め、目的のクリップをミリ秒で再生すること。UIはVRのダッシュボードとしても使いやすいです。",[13,20,21],{},"SoundNinjaはまだ初期開発段階です。機能は動きますが、すべてのプラットフォームで完全に検証されているわけではありません。",[23,24,25],"h2",{"id":25},"対象ユーザー",[27,28,29,33,36,39],"ul",{},[30,31,32],"li",{},"即時のサウンドキューが必要な配信者",[30,34,35],{},"ボイスチャット用の共有ボードが欲しい友だち",[30,37,38],{},"クリップを録ってボードに置くポッドキャスター",[30,40,41],{},"カスタマイズ可能な、ローカル優先のサウンドボードが欲しい人",[23,43,44],{"id":44},"できること",[27,46,47,50,53,56,59,62,65,68,71,79,82],{},[30,48,49],{},"自分の音声ファイルからサウンドボードを作る",[30,51,52],{},"色付きタブ、グループ、タグ、検索で整理する",[30,54,55],{},"タグでフィルター（OR）、名前・日付・長さ・サイズでソート",[30,57,58],{},"マーキーまたはShift範囲で複数選択し、色・移動・削除を一括",[30,60,61],{},"コンテキストメニューでサウンドごとの音量を設定",[30,63,64],{},"Theme Creatorで見た目をデザインする",[30,66,67],{},"Record EditorでPCオーディオまたはマイクを録音する",[30,69,70],{},"個別のサウンドにホットキーを割り当てる",[30,72,73,78],{},[74,75,77],"a",{"href":76},"\u002Fdocs\u002Fremote-control","Bitfocus Companion","からサウンドをトリガーする",[30,80,81],{},"サウンドボード全体をインポート／エクスポートして共有する",[30,83,84],{},"サウンドボタンにGIFや画像を使う — ローカルフォルダライブラリまたはKLIPY",[23,86,87],{"id":87},"ライセンス",[13,89,90,91,97],{},"SoundNinjaは",[74,92,96],{"href":93,"rel":94},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fblob\u002Fmain\u002FLICENSE",[95],"nofollow","GPL-3.0","のフリーソフトウェアです。フォーク、改変、共有できます。",[23,99,100],{"id":100},"次のステップ",[102,103,104,110,116],"ol",{},[30,105,106],{},[74,107,109],{"href":108},"\u002Fdocs\u002Finstallation","SoundNinjaをインストール",[30,111,112],{},[74,113,115],{"href":114},"\u002Fdocs\u002Fadding-sounds","サウンドを追加",[30,117,118],{},[74,119,121],{"href":120},"\u002Fdocs\u002Forganizing-sounds","ボードを整理",{"title":123,"searchDepth":124,"depth":124,"links":125},"",2,[126,127,128,129],{"id":25,"depth":124,"text":25},{"id":44,"depth":124,"text":44},{"id":87,"depth":124,"text":87},{"id":100,"depth":124,"text":100},"SoundNinjaとは何か、何ができるか。","md",{},true,1,"\u002Foverview",{"title":5,"description":130},"overview","c8xWgFwxVyANkJ28nfjNkL8am61Nn8aDvVh7jKzMyKM",[140,222,423,564,955,1087,1228,1449],{"id":4,"title":5,"body":141,"description":130,"extension":131,"meta":220,"navigation":133,"order":134,"path":135,"seo":221,"stem":137,"__hash__":138},{"type":7,"value":142,"toc":214},[143,145,147,149,151,153,163,165,191,193,198,200],[10,144,5],{"id":5},[13,146,15],{},[13,148,18],{},[13,150,21],{},[23,152,25],{"id":25},[27,154,155,157,159,161],{},[30,156,32],{},[30,158,35],{},[30,160,38],{},[30,162,41],{},[23,164,44],{"id":44},[27,166,167,169,171,173,175,177,179,181,183,187,189],{},[30,168,49],{},[30,170,52],{},[30,172,55],{},[30,174,58],{},[30,176,61],{},[30,178,64],{},[30,180,67],{},[30,182,70],{},[30,184,185,78],{},[74,186,77],{"href":76},[30,188,81],{},[30,190,84],{},[23,192,87],{"id":87},[13,194,90,195,97],{},[74,196,96],{"href":93,"rel":197},[95],[23,199,100],{"id":100},[102,201,202,206,210],{},[30,203,204],{},[74,205,109],{"href":108},[30,207,208],{},[74,209,115],{"href":114},[30,211,212],{},[74,213,121],{"href":120},{"title":123,"searchDepth":124,"depth":124,"links":215},[216,217,218,219],{"id":25,"depth":124,"text":25},{"id":44,"depth":124,"text":44},{"id":87,"depth":124,"text":87},{"id":100,"depth":124,"text":100},{},{"title":5,"description":130},{"id":223,"title":224,"body":225,"description":417,"extension":131,"meta":418,"navigation":133,"order":124,"path":419,"seo":420,"stem":421,"__hash__":422},"content_ja\u002Finstallation.md","インストール",{"type":7,"value":226,"toc":410},[227,229,242,246,268,271,275,289,292,296,321,332,335,342,345,360,390,406],[10,228,224],{"id":224},[13,230,231,235,236,241],{},[74,232,234],{"href":233},"\u002Fdownload","ダウンロードページ","または",[74,237,240],{"href":238,"rel":239},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Freleases\u002Flatest",[95],"GitHub Releases","からビルドを入手してください。SoundNinjaは初期開発中なので、ビルドはベータとして扱ってください。",[23,243,245],{"id":244},"windows","Windows",[27,247,248,259,262,265],{},[30,249,250,251,255,256],{},"64ビットWindows向けの",[252,253,254],"strong",{},"インストーラー (.exe)"," または ",[252,257,258],{},"MSI (.msi)",[30,260,261],{},"ランディングページの対象：Windows 10以降",[30,263,264],{},"アプリのREADMEはWindows 8以上も記載",[30,266,267],{},"NSISインストーラーはダークテーマ。セットアップ時に言語を選ぶと、次回起動時にSoundNinjaが覚えます。",[13,269,270],{},"インストーラーを実行し、スタートメニューからSoundNinjaを起動します。",[23,272,274],{"id":273},"macos","macOS",[27,276,277,283,286],{},[30,278,279,280],{},"Apple SiliconとIntel向けの",[252,281,282],{},"ユニバーサル .dmg",[30,284,285],{},"ランディングページの対象：macOS 10.14以降",[30,287,288],{},"アプリのREADMEはmacOS 10.15以上を記載",[13,290,291],{},"ディスクイメージを開き、SoundNinjaをアプリケーションにドラッグします。",[23,293,295],{"id":294},"linux","Linux",[27,297,298,304,310,318],{},[30,299,300,301],{},"Ubuntu \u002F Debian向けの",[252,302,303],{},"Debian (.deb)",[30,305,306,307],{},"その他のディストリ向けの",[252,308,309],{},"AppImage",[30,311,312,313,317],{},"リリース公開後、ArchユーザーはAURから",[314,315,316],"code",{},"soundninja-bin","をインストールできます",[30,319,320],{},"Ubuntu 20.04でテスト済み",[13,322,323,324,327,328,331],{},"デスクトップビルドにはWebKitとGTKのパッケージが必要です。Debian\u002FUbuntuでは通常、",[314,325,326],{},"libwebkit2gtk","、",[314,329,330],{},"libgtk-3-0","、app-indicatorライブラリです。",[23,333,334],{"id":334},"アップデート",[13,336,337,338,341],{},"アプリ内で ",[252,339,340],{},"ヘルプ → アップデートを確認"," を開きます。設定で起動時にSoundNinjaが確認するようにもできます。",[23,343,344],{"id":344},"ソースからビルド",[13,346,347,348,353,354,359],{},"カスタムビルドが必要なら、",[74,349,352],{"href":350,"rel":351},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja",[95],"リポジトリ","をクローンし、",[74,355,358],{"href":356,"rel":357},"https:\u002F\u002Fv2.tauri.app\u002Fstart\u002Fprerequisites\u002F",[95],"Tauriの前提条件","を入れたうえで：",[361,362,366],"pre",{"className":363,"code":364,"language":365,"meta":123,"style":123},"language-bash shiki shiki-themes github-light github-dark","bun install\nbun run tauri:serve\n","bash",[314,367,368,380],{"__ignoreMap":123},[369,370,372,376],"span",{"class":371,"line":134},"line",[369,373,375],{"class":374},"sScJk","bun",[369,377,379],{"class":378},"sZZnC"," install\n",[369,381,382,384,387],{"class":371,"line":124},[369,383,375],{"class":374},[369,385,386],{"class":378}," run",[369,388,389],{"class":378}," tauri:serve\n",[13,391,392,327,395,327,398,401,402,405],{},[314,393,394],{},"npm",[314,396,397],{},"pnpm",[314,399,400],{},"deno","でも動きます。本番ビルド：",[314,403,404],{},"bun run tauri:build","。",[407,408,409],"style",{},"html pre.shiki code .sScJk, html code.shiki .sScJk{--shiki-default:#6F42C1;--shiki-dark:#B392F0}html pre.shiki code .sZZnC, html code.shiki .sZZnC{--shiki-default:#032F62;--shiki-dark:#9ECBFF}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html.dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}",{"title":123,"searchDepth":124,"depth":124,"links":411},[412,413,414,415,416],{"id":244,"depth":124,"text":245},{"id":273,"depth":124,"text":274},{"id":294,"depth":124,"text":295},{"id":334,"depth":124,"text":334},{"id":344,"depth":124,"text":344},"Windows、macOS、LinuxにSoundNinjaをインストール。",{},"\u002Finstallation",{"title":224,"description":417},"installation","Y0LyjIaCaa6QDprLZ1KDPjTfWKBUFvFm5ERbBT-RfpY",{"id":424,"title":425,"body":426,"description":557,"extension":131,"meta":558,"navigation":133,"order":559,"path":560,"seo":561,"stem":562,"__hash__":563},"content_ja\u002Fadding-sounds.md","サウンドの追加",{"type":7,"value":427,"toc":549},[428,430,433,436,454,457,488,491,510,513,527,530,533,540,543],[10,429,425],{"id":425},[13,431,432],{},"クリップを追加するまで、ボードは空です。SoundNinjaはファイル、フォルダ全体、録音、共有サウンドボードパックをインポートできます。",[23,434,435],{"id":435},"音声ファイルをインポート",[102,437,438,448,451],{},[30,439,440,443,444,447],{},[252,441,442],{},"ファイル → 音声ファイルをインポート","、またはナビバーの ",[252,445,446],{},"インポート"," を使います。",[30,449,450],{},"1つ以上の音声ファイルを選びます。",[30,452,453],{},"サウンドは現在のタブに入ります。",[23,455,456],{"id":456},"フォルダをインポート",[102,458,459,468,471],{},[30,460,461,464,465,467],{},[252,462,463],{},"ファイル → フォルダをインポート","（またはナビバーの ",[252,466,456],{},"）。",[30,469,470],{},"1つ以上のフォルダを追加。インポート前にドラッグで並べ替えできます。",[30,472,473,474],{},"配置方法を選びます：\n",[27,475,476,482],{},[30,477,478,481],{},[252,479,480],{},"タブとしてインポート"," — 各フォルダが独自のタブになる",[30,483,484,487],{},[252,485,486],{},"現在のタブにインポート"," — すべてのファイルがアクティブなタブに入る",[23,489,490],{"id":490},"クリップを録音",[13,492,493,494,497,498,502,503,255,506,509],{},"プレイヤーバーの ",[252,495,496],{},"録音"," ボタンから",[74,499,501],{"href":500},"\u002Fdocs\u002Frecording-editor","Record Editor","を開きます。キャプチャ、トリムし、",[252,504,505],{},"選択をインポート",[252,507,508],{},"すべてインポート"," で現在のタブまたは選んだタブに入れます。",[23,511,512],{"id":512},"サウンドボードをインポート",[13,514,515,518,519,522,523,526],{},[252,516,517],{},"ファイル → サウンドボードをインポート"," で共有パックを読み込みます。パックは ",[314,520,521],{},"project.sninja"," とサウンドファイルを含む ",[314,524,525],{},".zip"," です。インポート後、プロジェクトを開いて再生します。",[13,528,529],{},"複数のプロジェクト（プロファイル）も保てます。プロジェクトセレクターでボードを切り替えます。",[23,531,532],{"id":532},"見つからないファイルを再リンク",[13,534,535,536,539],{},"ディスク上で音声ファイルが移動すると、SoundNinjaは ",[252,537,538],{},"見つからないサウンドファイル"," ダイアログを表示します。検索するフォルダを選び、クリップを再リンクします。",[23,541,542],{"id":542},"次へ",[13,544,545,546,405],{},"タブ、タグ、フィルター、ホットキーの整理は",[74,547,548],{"href":120},"サウンドの整理",{"title":123,"searchDepth":124,"depth":124,"links":550},[551,552,553,554,555,556],{"id":435,"depth":124,"text":435},{"id":456,"depth":124,"text":456},{"id":490,"depth":124,"text":490},{"id":512,"depth":124,"text":512},{"id":532,"depth":124,"text":532},{"id":542,"depth":124,"text":542},"音声、フォルダ、録音、共有サウンドボードをインポート。",{},3,"\u002Fadding-sounds",{"title":425,"description":557},"adding-sounds","5_cjd2COcPz0pj4ZrBehCZv6ouzBimE8UGjkcfngQjw",{"id":565,"title":548,"body":566,"description":948,"extension":131,"meta":949,"navigation":133,"order":950,"path":951,"seo":952,"stem":953,"__hash__":954},"content_ja\u002Forganizing-sounds.md",{"type":7,"value":567,"toc":933},[568,570,577,580,605,612,615,618,632,639,645,649,659,663,693,696,702,705,739,746,750,753,779,782,786,799,802,807,828,844,851,854,865,868,872,879,889,895,898,906,913,930],[10,569,548],{"id":548},[13,571,572,573,576],{},"SoundNinjaは大規模ライブラリ向けです。",[252,574,575],{},"タグとフィルター","、タブ、検索、複数選択、ホットキーで、必要なクリップをワンクリック（またはワンキー）で出せます。",[23,578,579],{"id":579},"タブ",[27,581,582,588,594],{},[30,583,584,587],{},[252,585,586],{},"タブを追加"," でタブを作り、色を付けてバーをすばやく眺められます。",[30,589,590,593],{},[252,591,592],{},"すべて"," ビューはタブを横断して全サウンドを表示します。",[30,595,596,597,600,601,604],{},"サウンドは ",[252,598,599],{},"1つ以上のタブ"," に所属できます。サウンドを右クリックし、",[252,602,603],{},"タブへ移動"," で割り当てます。",[13,606,607,608,611],{},"タブの切り替え演出は ",[252,609,610],{},"設定 → メイン","：スライド、フェード、ボタンを1つずつ、またはなし。",[23,613,614],{"id":614},"グループ",[13,616,617],{},"v0.5.3以降、セパレーターを名前付きグループにできます：",[27,619,620,623,626,629],{},[30,621,622],{},"コンテキストメニューからグループの追加、名前変更、削除",[30,624,625],{},"グループヘッダーをドラッグ — 子も一緒に動く",[30,627,628],{},"グループにサウンドを入れたり出したり",[30,630,631],{},"グループの枠線色、名前の色、ボタン配置を設定（またはタブのデフォルトを使う）",[13,633,634,635,638],{},"見た目の区切りだけなら、通常の ",[252,636,637],{},"セパレーター"," も追加できます。",[13,640,641,642,405],{},"ボードの空き領域を右クリックして ",[252,643,644],{},"グループを追加",[23,646,648],{"id":647},"タグ-フィルター","タグ \u002F フィルター",[13,650,651,652,655,656,658],{},"タグはタブを横断します。スライドアウトの ",[252,653,654],{},"フィルター"," パネル（サイドバー ",[252,657,654],{},"）で作成し、ボードを絞ります。",[660,661,662],"h3",{"id":662},"タグの作成と編集",[102,664,665,671,681,687],{},[30,666,667,668,670],{},"サイドバーで ",[252,669,654],{}," を開く。",[30,672,673,676,677,680],{},[252,674,675],{},"タグ"," の ",[252,678,679],{},"タグを追加"," — 名前と色を付ける。",[30,682,683,684,405],{},"同じリストで名前変更、色変更、",[252,685,686],{},"タグを削除",[30,688,689,692],{},[252,690,691],{},"タグはまだありません"," と出たら、割り当てる前にここで追加する。",[660,694,695],{"id":695},"サウンドにタグを付ける",[13,697,698,699,701],{},"サウンドを右クリック → ",[252,700,675],{},"（チェックボックス）。1つのサウンドに複数可。タグが無い場合、メニューはフィルターパネルへ案内します。",[660,703,704],{"id":704},"ボードをフィルター",[27,706,707,714,725,736],{},[30,708,709,710,713],{},"フィルターパネル、または ",[252,711,712],{},"検索バー下のチップ"," でタグを切り替え。",[30,715,716,717,720,721,724],{},"一致は ",[252,718,719],{},"OR","：選択したタグの ",[252,722,723],{},"いずれか"," を持つサウンドが表示される。",[30,726,727,728,731,732,735],{},"ナビバーの ",[252,729,730],{},"検索"," は有効なタグフィルターと ",[252,733,734],{},"AND","（入力 + タグ）。",[30,737,738],{},"チップをオフ（またはフィルター解除）でタブ全体を再表示。",[13,740,741,742,745],{},"色付きタグ名をボタンに表示できます。",[252,743,744],{},"設定 → 動作 → タグバッジを表示"," で切り替え。",[23,747,749],{"id":748},"並べ替えソート","並べ替え（ソート）",[13,751,752],{},"フィルターパネルでソートモードを選びます：",[27,754,755,761],{},[30,756,757,760],{},[252,758,759],{},"ユーザー定義"," — タブ順、グループ表示",[30,762,763,327,766,327,769,327,772,775,776],{},[252,764,765],{},"名前",[252,767,768],{},"追加日時",[252,770,771],{},"再生時間",[252,773,774],{},"ファイルサイズ"," — フラットなソート一覧。これらのモードでは ",[252,777,778],{},"グループは非表示",[13,780,781],{},"再生時間ソートは、初回に長さのメタデータを準備することがあります。",[23,783,785],{"id":784},"並べ替えドラッグ","並べ替え（ドラッグ）",[13,787,788,791,792,795,796,798],{},[252,789,790],{},"設定 → 動作"," でドラッグ＆ドロップをオンにします（",[252,793,794],{},"並べ替えを許可","）。その後、サウンドとグループをドラッグして配置します。ドラッグ並べ替えは ",[252,797,759],{}," ソートで有効です。",[23,800,801],{"id":801},"複数選択",[13,803,727,804,806],{},[252,805,801],{}," をオンにして：",[27,808,809,812,818,825],{},[30,810,811],{},"クリックでサウンドをトグル",[30,813,814,817],{},[252,815,816],{},"Shift+クリック"," で直前のアンカーから範囲選択",[30,819,820,821,824],{},"空きボード上で ",[252,822,823],{},"マーキー"," をドラッグ",[30,826,827],{},"空きボード（または外側）をクリックして選択解除",[13,829,830,831,327,834,327,837,327,840,843],{},"一括バーに件数が表示され、",[252,832,833],{},"色",[252,835,836],{},"タブへ移動…",[252,838,839],{},"削除",[252,841,842],{},"完了"," が使えます。",[13,845,846,847,850],{},"複数選択中、各ボタンに ",[252,848,849],{},"8文字のIDチップ"," が出ます。チップを右クリックでコピー。",[23,852,853],{"id":853},"サウンドごとの音量",[13,855,856,857,860,861,864],{},"右クリック → ",[252,858,859],{},"音量","。スライダーを 0%〜100%。",[252,862,863],{},"ダブルクリック"," で 100% にリセット。",[13,866,867],{},"設定のマスター出力音量と重ねて効きます。",[23,869,871],{"id":870},"ホットキーとサウンドid","ホットキーとサウンドID",[13,873,874,875,878],{},"すべてのサウンドには8文字のIDがあります。ボタンのコンテキストメニュー（",[252,876,877],{},"IDをコピー","）、または複数選択のIDチップからコピーします。",[13,880,881,884,885,888],{},[252,882,883],{},"設定 → ホットキー"," を開き、キーをサウンドIDに割り当てます。グローバルホットキーは任意です。コンテキストメニューの ",[252,886,887],{},"ホットキーを割り当て"," は、IDを埋めた状態でそこにジャンプします。",[13,890,891,892,894],{},"同じIDを",[74,893,77],{"href":76},"がクリップのトリガーに使います。",[23,896,897],{"id":897},"背景画像と色",[13,899,900,901,905],{},"サウンドを右クリックして、ボタンごとの色や背景画像を設定します。ボード全体を整える",[74,902,904],{"href":903},"\u002Fdocs\u002Ftheme-editor","Theme Creator","とは別です。",[13,907,908,909,912],{},"ピッカーは ",[252,910,911],{},"背景画像"," ダイアログ（PNG、JPEG、GIF、WebP）：",[27,914,915,921],{},[30,916,917,920],{},[252,918,919],{},"ローカルファイル"," — フォルダ追加、単一ファイル選択、ファイル名検索、グリッドプレビュー、ライブラリからフォルダ削除",[30,922,923,926,927,929],{},[252,924,925],{},"KLIPY"," — オンラインGIFを検索。APIキーは ",[252,928,790],{},"。キーはプロジェクトファイルには保存されません。",[13,931,932],{},"画像を選んだあと、ボタン上でパンとクロップできます。",{"title":123,"searchDepth":124,"depth":124,"links":934},[935,936,937,942,943,944,945,946,947],{"id":579,"depth":124,"text":579},{"id":614,"depth":124,"text":614},{"id":647,"depth":124,"text":648,"children":938},[939,940,941],{"id":662,"depth":559,"text":662},{"id":695,"depth":559,"text":695},{"id":704,"depth":559,"text":704},{"id":748,"depth":124,"text":749},{"id":784,"depth":124,"text":785},{"id":801,"depth":124,"text":801},{"id":853,"depth":124,"text":853},{"id":870,"depth":124,"text":871},{"id":897,"depth":124,"text":897},"タグ、フィルター、タブ、グループ、並べ替え、複数選択、音量、ホットキー。",{},4,"\u002Forganizing-sounds",{"title":548,"description":948},"organizing-sounds","PGqVreiuZb1jRxkXIW9tv66PvwPYs2iRx5-4j_D8sho",{"id":956,"title":957,"body":958,"description":1080,"extension":131,"meta":1081,"navigation":133,"order":1082,"path":1083,"seo":1084,"stem":1085,"__hash__":1086},"content_ja\u002Ftheme-editor.md","テーマエディター",{"type":7,"value":959,"toc":1074},[960,962,969,973,1000,1003,1006,1020,1023,1049,1052,1055,1060],[10,961,957],{"id":957},[13,963,964,965,968],{},"Theme Creatorは、ボードの完全なビジュアルエディターです。",[252,966,967],{},"設定 → メイン → Theme Creator"," から開きます。",[23,970,972],{"id":971},"_3つのタブ","3つのタブ",[102,974,975,989,995],{},[30,976,977,980,981,984,985,988],{},[252,978,979],{},"一般"," — テーマ名、共有色、フォントのアップロード（",[314,982,983],{},".ttf"," \u002F ",[314,986,987],{},".otf","）",[30,990,991,994],{},[252,992,993],{},"ボタン"," — サウンドボタンの色、書体、レイアウト、GIFオーバーレイ",[30,996,997,999],{},[252,998,579],{}," — タブバーの色、書体、枠線の太さ",[13,1001,1002],{},"編集中、ライブプレビューがタブとボタンを表示します。",[23,1004,1005],{"id":1005},"変更できる項目",[27,1007,1008,1011,1014,1017],{},[30,1009,1010],{},"プライマリとアクセントの色、背景、ボタン色、タブ色",[30,1012,1013],{},"ボタンとタブのフォントファミリーとサイズ",[30,1015,1016],{},"ボタンの幅、半径、枠線幅、隙間、パディング",[30,1018,1019],{},"GIFオーバーレイの不透明度（通常とホバー）",[23,1021,1022],{"id":1022},"保存と共有",[27,1024,1025,1031,1037,1043],{},[30,1026,1027,1030],{},[252,1028,1029],{},".cssをエクスポート"," — バックアップや友人への送信用テーマファイルを書き出す",[30,1032,1033,1036],{},[252,1034,1035],{},"テーマに追加"," — Themesフォルダに保存して適用",[30,1038,1039,1042],{},[252,1040,1041],{},".cssをインポート"," — 組み込みプリセットまたは保存済みテーマを読み込む",[30,1044,1045,1048],{},[252,1046,1047],{},"リセット"," — SoundNinjaのデフォルトに戻す",[13,1050,1051],{},"未保存の変更があるままウィンドウを閉じると、SoundNinjaが先に保存を求めます。",[23,1053,1054],{"id":1054},"フルエディターなしで",[13,1056,1057,1059],{},[252,1058,610],{}," でも次が可能です：",[27,1061,1062,1065,1071],{},[30,1063,1064],{},"リストからテーマを選ぶ",[30,1066,1067,1068,988],{},"CSS変数をライブ編集する（",[252,1069,1070],{},"カスタムCSS",[30,1072,1073],{},"テーマファイルをThemesフォルダにインポートする",{"title":123,"searchDepth":124,"depth":124,"links":1075},[1076,1077,1078,1079],{"id":971,"depth":124,"text":972},{"id":1005,"depth":124,"text":1005},{"id":1022,"depth":124,"text":1022},{"id":1054,"depth":124,"text":1054},"Theme Creatorで色、フォント、ボタン、タブをデザイン。",{},5,"\u002Ftheme-editor",{"title":957,"description":1080},"theme-editor","tGeQE8HatAeqLeJ_3U4A-ac0RfIRzcoq-KghedjPolg",{"id":1088,"title":1089,"body":1090,"description":1221,"extension":131,"meta":1222,"navigation":133,"order":1223,"path":1224,"seo":1225,"stem":1226,"__hash__":1227},"content_ja\u002Frecording-editor.md","録音エディター",{"type":7,"value":1091,"toc":1215},[1092,1094,1100,1103,1109,1129,1132,1135,1160,1163,1178,1182,1196,1206],[10,1093,1089],{"id":1089},[13,1095,1096,1097,1099],{},"SoundNinja内でクリップを録音し、トリムしてタブにインポートします。プレイヤーバーの ",[252,1098,496],{}," ボタンでエディターを開きます。",[23,1101,1102],{"id":1102},"入力を選ぶ",[13,1104,1105,1108],{},[252,1106,1107],{},"設定 → オーディオ"," で：",[27,1110,1111,1117,1123],{},[30,1112,1113,1116],{},[252,1114,1115],{},"入力デバイス"," — マイク",[30,1118,1119,1122],{},[252,1120,1121],{},"出力デバイス（PCオーディオ）"," — PCが再生している音のループバック",[30,1124,1125,1128],{},[252,1126,1127],{},"入力音量"," — キャプチャゲイン 0%〜200%",[13,1130,1131],{},"録音ボタンは、ここで選んだデバイスを使います。",[23,1133,1134],{"id":1134},"テイクを編集",[27,1136,1137,1140,1143,1151,1154,1157],{},[30,1138,1139],{},"録音と停止",[30,1141,1142],{},"入力レベルメーターを確認",[30,1144,1145,255,1148],{},[252,1146,1147],{},"ノーマライズ",[252,1149,1150],{},"ノイズキャンセレーション",[30,1152,1153],{},"クリップ全体のトリム、選択範囲へのトリム、選択の削除",[30,1155,1156],{},"元に戻す \u002F やり直し",[30,1158,1159],{},"ズームインとズームアウト",[23,1161,1162],{"id":1162},"ステージしてインポート",[102,1164,1165,1168,1171],{},[30,1166,1167],{},"選択範囲またはトラック全体をステージングリストに追加します。",[30,1169,1170],{},"リストは空から始まります。録音、編集、それからクリップを追加。",[30,1172,1173,255,1175,1177],{},[252,1174,505],{},[252,1176,508],{}," で、現在のタブまたは選んだタブに入れます。",[23,1179,1181],{"id":1180},"ステム分離任意","ステム分離（任意）",[13,1183,1184,1185,1188,1189,255,1192,1195],{},"公式のWindows \u002F macOS \u002F Linuxリリースビルドには ",[252,1186,1187],{},"ステム"," 機能が入ります。Record EditorはBS-RoFormerで ",[252,1190,1191],{},"ボーカル",[252,1193,1194],{},"音楽"," を残せます。",[13,1197,1198,1199,405,1202,1205],{},"モデルは約158 MBで、インストーラーには ",[252,1200,1201],{},"同梱されていません",[252,1203,1204],{},"設定 → ステム分離"," からダウンロードするか、初回起動のプロンプトを承認します。Windowsインストーラーも初回起動時にモデルのダウンロードを案内できます。",[13,1207,1208,1209,984,1212,467],{},"カスタムのソースビルドには追加フラグが必要です（",[314,1210,1211],{},"tauri:serve:stems",[314,1213,1214],{},"tauri:build:stems",{"title":123,"searchDepth":124,"depth":124,"links":1216},[1217,1218,1219,1220],{"id":1102,"depth":124,"text":1102},{"id":1134,"depth":124,"text":1134},{"id":1162,"depth":124,"text":1162},{"id":1180,"depth":124,"text":1181},"マイクまたはPCオーディオを取り込み、クリップを編集してボードに置く。",{},6,"\u002Frecording-editor",{"title":1089,"description":1221},"recording-editor","7_RI-WNd1luOVgn5vTAoyTmO8dKVtHVwkffwMt4LBQc",{"id":1229,"title":1230,"body":1231,"description":1442,"extension":131,"meta":1443,"navigation":133,"order":1444,"path":1445,"seo":1446,"stem":1447,"__hash__":1448},"content_ja\u002Fremote-control.md","リモートコントロール",{"type":7,"value":1232,"toc":1435},[1233,1235,1238,1241,1273,1276,1279,1313,1316,1336,1339,1342,1374,1378,1384],[10,1234,1230],{"id":1230},[13,1236,1237],{},"SoundNinjaはローカルネットワークで待ち受け、Bitfocus Companion（または任意のHTTP\u002FWebSocketクライアント）がサウンドを再生・停止できます。",[23,1239,1240],{"id":1240},"リモートサーバーを有効化",[102,1242,1243,1249,1256,1263],{},[30,1244,1245,1248],{},[252,1246,1247],{},"設定 → リモート"," を開きます。",[30,1250,1251,1252,1255],{},"リモートサーバーを有効にします。デフォルトポートは ",[252,1253,1254],{},"7331"," です。",[30,1257,1258,1259,1262],{},"任意：トークンを設定。クライアントはBearerトークンまたは ",[314,1260,1261],{},"?token="," で送ります。",[30,1264,1265,1268,1269,1272],{},[314,1266,1267],{},"http:\u002F\u002FIP:PORT"," URLをコピーするか、",[252,1270,1271],{},"設定 → 情報"," からシステムIPをコピーします。",[13,1274,1275],{},"Windowsはサーバー初回起動時にファイアウォールの確認を出すことがあります。プライベートネットワークのアクセスを許可してください。",[23,1277,77],{"id":1278},"bitfocus-companion",[102,1280,1281,1288,1296,1307],{},[30,1282,1283,1287],{},[74,1284,77],{"href":1285,"rel":1286},"https:\u002F\u002Fbitfocus.io\u002Fcompanion",[95],"をインストールします。",[30,1289,1290,1295],{},[74,1291,1294],{"href":1292,"rel":1293},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Freleases\u002Flatest\u002Fdownload\u002FSoundNinja-Companion.tgz",[95],"SoundNinja-Companion.tgz"," をダウンロード。Companion Storeのパッケージはまだありません。",[30,1297,1298,1299,1302,1303,1306],{},"Companionで ",[252,1300,1301],{},"Modules → Load module package"," を開き、",[314,1304,1305],{},".tgz"," を選びます。",[30,1308,1309,1312],{},[252,1310,1311],{},"Sound Ninja"," 接続を追加。PCのIP、ポート、設定したトークンを貼り付けます。",[23,1314,1315],{"id":1315},"アクション",[27,1317,1318,1324,1330],{},[30,1319,1320,1323],{},[252,1321,1322],{},"Trigger Sound"," — ライブドロップダウンから選ぶか、8文字のサウンドIDを入力（Companion変数が使えます）",[30,1325,1326,1329],{},[252,1327,1328],{},"Stop Sound"," — IDで再生中のサウンドを1つ停止",[30,1331,1332,1335],{},[252,1333,1334],{},"Stop All"," — 再生中の全サウンドを停止",[13,1337,1338],{},"SoundNinjaでは、ボタンのコンテキストメニューまたは複数選択のIDチップからサウンドIDをコピーします。",[23,1340,1341],{"id":1341},"フィードバックと変数",[27,1343,1344,1350,1362,1368],{},[30,1345,1346,1349],{},[252,1347,1348],{},"Sound Playing"," — そのサウンドIDがアクティブな間はtrue（ボタン色に使う）",[30,1351,1352,1355,1356,984,1359],{},[314,1353,1354],{},"$(soundninja:connected)"," — ",[314,1357,1358],{},"true",[314,1360,1361],{},"false",[30,1363,1364,1367],{},[314,1365,1366],{},"$(soundninja:playing_count)"," — 再生中のサウンド数",[30,1369,1370,1373],{},[314,1371,1372],{},"$(soundninja:last_triggered)"," — 最後にトリガーしたサウンドID",[23,1375,1377],{"id":1376},"http-api上級","HTTP API（上級）",[13,1379,1380,1381],{},"ベースパス：",[314,1382,1383],{},"\u002Fapi\u002Fv1",[27,1385,1386,1392,1398,1404,1414,1420,1429],{},[30,1387,1388,1391],{},[314,1389,1390],{},"GET \u002Finfo"," — アプリ名、バージョン、プロトコル、トークンが必要か",[30,1393,1394,1397],{},[314,1395,1396],{},"GET \u002Fsounds"," — サウンド一覧（id、name、tabs、active）",[30,1399,1400,1403],{},[314,1401,1402],{},"GET \u002Fstate"," — サウンドと現在再生中のID",[30,1405,1406,1409,1410,1413],{},[314,1407,1408],{},"POST \u002Ftrigger"," に ",[314,1411,1412],{},"{ \"id\" }"," — サウンドを再生",[30,1415,1416,1419],{},[314,1417,1418],{},"GET \u002Ftrigger\u002F:id"," — 再生（ブラウザで簡単にテスト）",[30,1421,1422,1425,1426,1428],{},[314,1423,1424],{},"POST \u002Fstop"," に任意の ",[314,1427,1412],{}," — 1つまたはすべて停止",[30,1430,1431,1434],{},[314,1432,1433],{},"GET \u002Fws"," — ライブ状態。trigger\u002Fstopコマンドを受信",{"title":123,"searchDepth":124,"depth":124,"links":1436},[1437,1438,1439,1440,1441],{"id":1240,"depth":124,"text":1240},{"id":1278,"depth":124,"text":77},{"id":1315,"depth":124,"text":1315},{"id":1341,"depth":124,"text":1341},{"id":1376,"depth":124,"text":1377},"ローカルネットワーク経由でBitfocus CompanionからSoundNinjaを操作。",{},7,"\u002Fremote-control",{"title":1230,"description":1442},"remote-control","_6T2WMAtPh7L1pRelAkpGazesfqk5Swk4FcTh5g7BTw",{"id":1450,"title":1451,"body":1452,"description":1537,"extension":131,"meta":1538,"navigation":133,"order":1539,"path":1540,"seo":1541,"stem":1542,"__hash__":1543},"content_ja\u002Fsupport.md","サポート",{"type":7,"value":1453,"toc":1530},[1454,1456,1459,1462,1465,1472,1480,1483,1490,1492,1505,1508,1520,1523],[10,1455,1451],{"id":1451},[13,1457,1458],{},"SoundNinjaは初期ベータのコミュニティプロジェクトです。いちばん早い助けはGitHubです。",[23,1460,1461],{"id":1461},"バグ報告または質問",[13,1463,1464],{},"GitHubでissueを開いてください：",[13,1466,1467],{},[74,1468,1471],{"href":1469,"rel":1470},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fissues",[95],"github.com\u002Fmarcus-universe\u002FSoundNinja\u002Fissues",[13,1473,1474,1475,255,1477,1479],{},"OS、SoundNinjaのバージョン（",[252,1476,340],{},[252,1478,1271],{},"）、再現手順を書いてください。",[23,1481,1482],{"id":1482},"メール",[13,1484,1485,1486],{},"メンテナー連絡先：",[74,1487,1489],{"href":1488},"mailto:contact@marcus-universe.de","contact@marcus-universe.de",[23,1491,334],{"id":334},[13,1493,337,1494,