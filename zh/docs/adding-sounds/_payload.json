5,"text":134},{},{"title":5,"description":153},{"id":562,"title":141,"body":563,"description":700,"extension":154,"meta":701,"navigation":156,"order":702,"path":703,"seo":704,"stem":705,"__hash__":706},"content_zh\u002Forganizing-sounds.md",{"type":7,"value":564,"toc":691},[565,567,570,573,599,606,609,612,626,632,635,641,644,655,658,661,665,668,674,679,683],[10,566,141],{"id":141},[13,568,569],{},"SoundNinja 面向大型音效库。用标签页、分组、搜索和快捷键，让需要的片段只需一点（或一键）。",[17,571,572],{"id":572},"标签页",[63,574,575,582,588],{},[24,576,577,578,581],{},"用 ",[28,579,580],{},"添加标签页"," 新增，并指定颜色，便于快速扫视标签栏。",[24,583,584,587],{},[28,585,586],{},"全部"," 视图显示跨标签页的所有音效。",[24,589,590,591,594,595,598],{},"一个音效可以属于 ",[28,592,593],{},"一个或多个标签页","。右键音效，用 ",[28,596,597],{},"移动到标签页"," 进行分配。",[13,600,601,602,605],{},"标签页过渡在 ",[28,603,604],{},"设置 → 主要","：滑动、淡入淡出、逐个按钮，或无。",[17,607,608],{"id":608},"分组",[13,610,611],{},"自 v0.5.3 起，分隔符可以变成命名分组：",[63,613,614,617,620,623],{},[24,615,616],{},"从上下文菜单添加、重命名或删除分组",[24,618,619],{},"拖动分组标题 — 子项一起移动",[24,621,622],{},"将音效拖入或拖出分组",[24,624,625],{},"设置分组边框颜色、名称颜色和按钮对齐（或使用标签页默认）",[13,627,628,629,35],{},"如果只需要视觉分隔，仍可添加普通 ",[28,630,631],{},"分隔符",[17,633,634],{"id":634},"搜索",[13,636,637,638,640],{},"使用导航栏中的 ",[28,639,634],{}," 字段。结果会随输入更新。",[17,642,643],{"id":643},"重新排序",[13,645,646,647,650,651,654],{},"在 ",[28,648,649],{},"设置 → 行为"," 中打开拖放（",[28,652,653],{},"允许重新排序","）。然后拖动音效和分组到目标位置。",[17,656,657],{"id":657},"批量编辑",[13,659,660],{},"多选音效，然后一次性改颜色、移到标签页或删除。",[17,662,664],{"id":663},"快捷键和音效-id","快捷键和音效 ID",[13,666,667],{},"每个音效都有 8 位 ID。从按钮上下文菜单或多选 ID 芯片复制。",[13,669,26,670,673],{},[28,671,672],{},"设置 → 快捷键","，将按键绑定到音效 ID。全局快捷键可选。",[13,675,676,678],{},[88,677,222],{"href":221}," 用同一个 ID 触发片段。",[17,680,682],{"id":681},"gif-和颜色","GIF 和颜色",[13,684,685,686,690],{},"右键音效可设置单按钮颜色或 GIF \u002F 图片背景。这与为整块音板设置样式的 ",[88,687,689],{"href":688},"\u002Fdocs\u002Ftheme-editor","Theme Creator"," 是分开的。",{"title":144,"searchDepth":145,"depth":145,"links":692},[693,694,695,696,697,698,699],{"id":572,"dep