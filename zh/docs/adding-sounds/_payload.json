用 Companion 变量）",[24,1350,1351,1354],{},[28,1352,1353],{},"Stop Sound"," — 按 ID 停止一个正在播放的音效",[24,1356,1357,1360],{},[28,1358,1359],{},"Stop All"," — 停止所有正在播放的音效",[13,1362,1363],{},"在 SoundNinja 中，从按钮上下文菜单或多选 ID 芯片复制音效 ID。",[17,1365,1366],{"id":1366},"反馈和变量",[63,1368,1369,1375,1387,1393],{},[24,1370,1371,1374],{},[28,1372,1373],{},"Sound Playing"," — 该音效 ID 处于活动状态时为 true（用于按钮颜色）",[24,1376,1377,1380,1381,1010,1384],{},[111,1378,1379],{},"$(soundninja:connected)"," — ",[111,1382,1383],{},"true",[111,1385,1386],{},"false",[24,1388,1389,1392],{},[111,1390,1391],{},"$(soundninja:playing_count)"," — 正在播放的音效数量",[24,1394,1395,1398],{},[111,1396,1397],{},"$(soundninja:last_triggered)"," — 上次触发的音效 ID",[17,1400,1402],{"id":1401},"http-api高级","HTTP API（高级）",[13,1404,1405,1406],{},"基础路径：",[111,1407,1408],{},"\u002Fapi\u002Fv1",[63,1410,1411,1417,1423,1429,1439,1445,1454],{},[24,1412,1413,1416],{},[111,1414,1415],{},"GET \u002Finfo"," — 应用名称、版本、协议、是否需要令牌",[24,1418,1419,1422],{},[111,1420,1421],{},"GET \u002Fsounds"," — 音效列表（id、name、tabs、active）",[24,1424,1425,1428],{},[111,1426,1427],{},"GET \u002Fstate"," — 音效以及当前正在播放的 ID",[24,1430,1431,1434,1435,1438],{},[111,1432,1433],{},"POST \u002Ftrigger"," 带 ",[111,1436,1437],{},"{ \"id\" }"," — 播放音效",[24,1440,1441,1444],{},[111,1442,1443],{},"GET \u002Ftrigger\u002F:id"," — 播放（便于在浏览器中测试）",[24,1446,1447,1450,1451,1453],{},[111,1448,1449],{},"POST \u002Fstop"," 带可选 ",[111,1452,1437],{}," — 停止一个或全部",[24,1455,1456,1459],{},[111,1457,1458],{},"GET \u002Fws"," — 实时状态；接收 trigger\u002Fstop 命令",{"title":144,"searchDepth":145,"depth":145,"links":1461},[1462,1463,1464,1465,1466],{"id":1265,"depth":145,"text":1265},{"id":1302,"depth":145,"text":231},{"id":1340,"depth":145,"text":1340},{"id":1366,"depth":145,"text":1366},{"id":1401,"depth":145,"text":1402},"通过本地网络用 Bitfocus Companion 触发 SoundNinja。",{},7,"\u002Fremote-control",{"title":1255,"description":1467},"remote-control","vmbwJuuS_NPHmhdnPs1__cpURph6ocjN-FjLeevtpLE",{"id":1475,"title":1476,"body