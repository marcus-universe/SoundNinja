":145,"links":826},[827,828,829,830],{"id":723,"depth":145,"text":723},{"id":756,"depth":145,"text":756},{"id":773,"depth":145,"text":773},{"id":805,"depth":145,"text":805},"在 Theme Creator 中设计颜色、字体、按钮和标签页。",{},5,"\u002Ftheme-editor",{"title":709,"description":831},"theme-editor","Mu4ghPBGL1w-XCpoVZlYs-uJo8X2WLz8pVTLxGchO7c",{"id":839,"title":840,"body":841,"description":968,"extension":154,"meta":969,"navigation":156,"order":970,"path":971,"seo":972,"stem":973,"__hash__":974},"content_zh\u002Frecording-editor.md","录音编辑器",{"type":7,"value":842,"toc":962},[843,845,851,854,860,880,883,886,911,914,928,932,946,953],[10,844,840],{"id":840},[13,846,847,848,850],{},"在 SoundNinja 内录制片段、裁剪，然后导入到标签页。用播放栏中的 ",[28,849,85],{}," 按钮打开编辑器。",[17,852,853],{"id":853},"选择输入",[13,855,646,856,859],{},[28,857,858],{},"设置 → 音频"," 中：",[63,861,862,868,874],{},[24,863,864,867],{},[28,865,866],{},"输入设备"," — 麦克风",[24,869,870,873],{},[28,871,872],{},"输出设备（电脑音频）"," — 电脑正在播放内容的环回",[24,875,876,879],{},[28,877,878],{},"输入音量"," — 采集增益，0% 到 200%",[13,881,882],{},"录音按钮使用你在此处选择的设备。",[17,884,885],{"id":885},"编辑这次录音",[63,887,888,891,894,902,905,908],{},[24,889,890],{},"开始和停止录音",[24,892,893],{},"查看输入电平表",[24,895,896,96,899],{},[28,897,898],{},"标准化",[28,900,901],{},"降噪",[24,903,904],{},"裁剪整段、裁剪到选区，或删除选区",[24,906,907],{},"撤销 \u002F 重做",[24,909,910],{},"放大和缩小",[17,912,913],{"id":913},"暂存并导入",[21,915,916,919,922],{},[24,917,918],{},"将选区或整条轨道加入暂存列表。",[24,920,921],{},"列表一开始是空的：先录音、编辑，再添加片段。",[24,923,924,96,926,100],{},[28,925,95],{},[28,927,99],{},[17,929,931],{"id":930},"音轨分离可选","音轨分离（可选）",[13,933,934,935,96,938,941,942,945],{},"Record Editor 可用 BS-RoFormer 保留 ",[28,936,937],{},"人声",[28,939,940],{},"音乐","。模型约 158 MB，",[28,943,944],{},"不会","随应用捆绑。",[13,947,948,949,952],{},"从 ",[28,950,951],{},"设置 → 音轨分离"," 下载，或接受首次运行提示。Windows 安装程序也可以在首次启动时提供下载该模型。",[13,954,955,956,735,959,55],{},"从源码构建音轨功能需要额外标志（",[111,957,958],{},"tauri:serve:stems",[111,960,961],{},"tauri:build:stems",{"title":144,"searchDepth":145,"depth":145,"links":963},[964,965,966,967],{"id":853,"depth":145,"text":853},{"id":885,"depth":145,"text":885},{"id":913,"depth":145,"text":913},{"id":930,"depth":145,"text":931},"采集麦克风或电脑音频，编辑片段，放到音板上。",{},6,"\u002Frecording-editor",{"title":840,"description":968},"recording-editor","S-gCpjKU7QogYpmkhWgDj-Jous_SbZfZkzGLqO3TQYo",{"id":976,"title":977,"body":978,"description":1189,"extension":154,"meta":1190,"navigation":156,"order":1191,"path":1192,"seo":1193,"stem":1194,"__hash__":1195},"content_zh\u002Fremote-control.md","远程控制",{"type":7,"value":979,"toc":1182},[980,982,985,988,1019,1022,1025,1060,1063,1083,1086,1089,1121,1125,1131],[10,981,977],{"id":977},[13,983,984],{},"SoundNinja 可以在本地网络上监听，让 Bitfocus Companion（或任何 HTTP\u002FWebSocket 客户端）播放和停止音效。",[17,986,987],{"id":987},"启用远程服务器",[21,989,990,995,1001,1008],{},[24,991,26,992,35],{},[28,993,994],{},"设置 → 远程",[24,996,997,998,35],{},"启用远程服务器。默认端口为 ",[28,999,1000],{},"7331",[24,1002,1003,1004,1007],{},"可选：设置令牌。客户端必须以 Bearer 令牌或 ",[111,1005,1006],{},"?token="," 发送。",[24,1009,1010,1011,1014,1015,1018],{},"复制 ",[111,1012,1013],{},"http:\u002F\u002FIP:PORT"," URL，或从 ",[28,1016,1017],{},"设置 → 关于"," 复制系统 IP。",[13,1020,1021],{},"Windows 可能在服务器首次启动时显示防火墙提示。请允许专用网络访问。",[17,1023,222],{"id":1024},"bitfocus-companion",[21,1026,1027,1034,1043,1053],{},[24,1028,1029,1030,35],{},"安装 ",[88,1031,222],{"href":1032,"rel":1033},"https:\u002F\u002Fbitfocus.io\u002Fcompanion",[240],[24,1035,1036,1037,1042],{},"下载 ",[88,1038,1041],{"href":1039,"rel":1040},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Freleases\u002Flatest\u002Fdownload\u002Fcompanion-module-soundninja.tgz",[240],"companion-module-soundninja.tgz","。尚无 Companion Store 软件包。",[24,1044,1045,1046,1049,1050,35],{},"在 Companion 中：",[28,1047,1048],{},"Modules → Load module package","，选择 ",[111,1051,1052],{},".tgz",[24,1054,1055,1056,1059],{},"添加一个 ",[28,1057,1058],{},"Sound Ninja"," 连接。粘贴电脑 IP、端口，以及你设置的令牌。",[17,1061,1062],{"id":1062},"动作",[63,1064,1065,1071,1077],{},[24,1066,1067,1070],{},[28,1068,1069],{},"Trigger Sound"," — 从实时下拉列表选择，或输入 8 位音效 ID（可使用 Companion 变量）",[24,1072,1073,1076],{},[28,1074,1075],{},"Stop Sound"," — 按 ID 停止一个正在播放的音效",[24,1078,1079,1082],{},[28,1080,1081],{},"Stop All"," — 停止所有正在播放的音效",[13,1084,1085],{},"在 SoundNinja 中，从按钮上下文菜单或多选 ID 芯片复制音效 ID。",[17,1087,1088],{"id":1088},"反馈和变量",[63,1090,1091,1097,1109,1115],{},[24,1092,1093,1096],{},[28,1094,1095],{},"Sound Playing"," — 该音效 ID 处于活动状态时为 true（用于按钮颜色）",[24,1098,1099,1102,1103,735,1106],{},[111,1100,1101],{},"$(soundninja:connected)"," — ",[111,1104,1105],{},"true",[111,1107,1108],{},"false",[24,1110,1111,1114],{},[111,1112,1113],{},"$(soundninja:playing_count)"," — 正在播放的音效数量",[24,1116,1117,1120],{},[111,1118,1119],{},"$(soundninja:last_triggered)"," — 上次触发的音效 ID",[17,1122,1124],{"id":1123},"http-api高级","HTTP API（高级）",[13,1126,1127,1128],{},"基础路径：",[111,1129,1130],{},"\u002Fapi\u002Fv1",[63,1132,1133,1139,1145,1151,1161,1167,1176],{},[24,1134,1135,1138],{},[111,1136,1137],{},"GET \u002Finfo"," — 应用名称、版本、协议、是否需要令牌",[24,1140,1141,1144],{},[111,1142,1143],{},"GET \u002Fsounds"," — 音效列表（id、name、tabs、active）",[24,1146,1147,1150],{},[111,1148,1149],{},"GET \u002Fstate"," — 音效以及当前正在播放的 ID",[24,1152,1153,1156,1157,1160],{},[111,1154,1155],{},"POST \u002Ftrigger"," 带 ",[111,1158,1159],{},"{ \"id\" }"," — 播放音效",[24,1162,1163,1166],{},[111,1164,1165],{},"GET \u002Ftrigger\u002F:id"," — 播放（便于在浏览器中测试）",[24,1168,1169,1172,1173,1175],{},[111,1170,1171],{},"POST \u002Fstop"," 带可选 ",[111,1174,1159],{}," — 停止一个或全部",[24,1177,1178,1181],{},[111,1179,1180],{},"GET \u002Fws"," — 实时状态；接收 trigger\u002Fstop 命令",{"title":144,"searchDepth":145,"depth":145,"links":1183},[1184,1185,1186,1187,1188],{"id":987,"depth":145,"text":987},{"id":1024,"depth":145,"text":222},{"id":1062,"depth":145,"text":1062},{"id":1088,"depth":145,"text":1088},{"id":1123,"depth":145,"text":1124},"通过本地网络用 Bitfocus Companion 触发 SoundNinja。",{},7,"\u002Fremote-control",{"title":977,"description":1189},"remot