[{"data":1,"prerenderedAt":1346},["ShallowReactive",2],{"docs-page-zh-\u002Fremote-control":3,"docs-nav-zh":243},{"id":4,"title":5,"body":6,"description":234,"extension":235,"meta":236,"navigation":237,"order":238,"path":239,"seo":240,"stem":241,"__hash__":242},"content_zh\u002Fremote-control.md","远程控制",{"type":7,"value":8,"toc":225},"minimark",[9,12,16,20,57,60,64,101,104,125,128,131,164,168,174],[10,11,5],"h1",{"id":5},[13,14,15],"p",{},"SoundNinja 可以在本地网络上监听，让 Bitfocus Companion（或任何 HTTP\u002FWebSocket 客户端）播放和停止音效。",[17,18,19],"h2",{"id":19},"启用远程服务器",[21,22,23,32,38,46],"ol",{},[24,25,26,27,31],"li",{},"打开 ",[28,29,30],"strong",{},"设置 → 远程","。",[24,33,34,35,31],{},"启用远程服务器。默认端口为 ",[28,36,37],{},"7331",[24,39,40,41,45],{},"可选：设置令牌。客户端必须以 Bearer 令牌或 ",[42,43,44],"code",{},"?token="," 发送。",[24,47,48,49,52,53,56],{},"复制 ",[42,50,51],{},"http:\u002F\u002FIP:PORT"," URL，或从 ",[28,54,55],{},"设置 → 关于"," 复制系统 IP。",[13,58,59],{},"Windows 可能在服务器首次启动时显示防火墙提示。请允许专用网络访问。",[17,61,63],{"id":62},"bitfocus-companion","Bitfocus Companion",[21,65,66,75,84,94],{},[24,67,68,69,31],{},"安装 ",[70,71,63],"a",{"href":72,"rel":73},"https:\u002F\u002Fbitfocus.io\u002Fcompanion",[74],"nofollow",[24,76,77,78,83],{},"下载 ",[70,79,82],{"href":80,"rel":81},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Freleases\u002Flatest\u002Fdownload\u002Fcompanion-module-soundninja.tgz",[74],"companion-module-soundninja.tgz","。尚无 Companion Store 软件包。",[24,85,86,87,90,91,31],{},"在 Companion 中：",[28,88,89],{},"Modules → Load module package","，选择 ",[42,92,93],{},".tgz",[24,95,96,97,100],{},"添加一个 ",[28,98,99],{},"Sound Ninja"," 连接。粘贴电脑 IP、端口，以及你设置的令牌。",[17,102,103],{"id":103},"动作",[105,106,107,113,119],"ul",{},[24,108,109,112],{},[28,110,111],{},"Trigger Sound"," — 从实时下拉列表选择，或输入 8 位音效 ID（可使用 Companion 变量）",[24,114,115,118],{},[28,116,117],{},"Stop Sound"," — 按 ID 停止一个正在播放的音效",[24,120,121,124],{},[28,122,123],{},"Stop All"," — 停止所有正在播放的音效",[13,126,127],{},"在 SoundNinja 中，从按钮上下文菜单或多选 ID 芯片复制音效 ID。",[17,129,130],{"id":130},"反馈和变量",[105,132,133,139,152,158],{},[24,134,135,138],{},[28,136,137],{},"Sound Playing"," — 该音效 ID 处于活动状态时为 true（用于按钮颜色）",[24,140,141,144,145,148,149],{},[42,142,143],{},"$(soundninja:connected)"," — ",[42,146,147],{},"true"," \u002F ",[42,150,151],{},"false",[24,153,154,157],{},[42,155,156],{},"$(soundninja:playing_count)"," — 正在播放的音效数量",[24,159,160,163],{},[42,161,162],{},"$(soundninja:last_triggered)"," — 上次触发的音效 ID",[17,165,167],{"id":166},"http-api高级","HTTP API（高级）",[13,169,170,171],{},"基础路径：",[42,172,173],{},"\u002Fapi\u002Fv1",[105,175,176,182,188,194,204,210,219],{},[24,177,178,181],{},[42,179,180],{},"GET \u002Finfo"," — 应用名称、版本、协议、是否需要令牌",[24,183,184,187],{},[42,185,186],{},"GET \u002Fsounds"," — 音效列表（id、name、tabs、active）",[24,189,190,193],{},[42,191,192],{},"GET \u002Fstate"," — 音效以及当前正在播放的 ID",[24,195,196,199,200,203],{},[42,197,198],{},"POST \u002Ftrigger"," 带 ",[42,201,202],{},"{ \"id\" }"," — 播放音效",[24,205,206,209],{},[42,207,208],{},"GET \u002Ftrigger\u002F:id"," — 播放（便于在浏览器中测试）",[24,211,212,215,216,218],{},[42,213,214],{},"POST \u002Fstop"," 带可选 ",[42,217,202],{}," — 停止一个或全部",[24,220,221,224],{},[42,222,223],{},"GET \u002Fws"," — 实时状态；接收 trigger\u002Fstop 命令",{"title":226,"searchDepth":227,"depth":227,"links":228},"",2,[229,230,231,232,233],{"id":19,"depth":227,"text":19},{"id":62,"depth":227,"text":63},{"id":103,"depth":227,"text":103},{"id":130,"depth":227,"text":130},{"id":166,"depth":227,"text":167},"通过本地网络用 Bitfocus Companion 触发 SoundNinja。","md",{},true,7,"\u002Fremote-control",{"title":5,"description":234},"remote-control","x1ZbQxhZlgv5nZpoJp-PXqBhj0rh7Pf1JCJEK2nhwsE",[244,358,553,692,838,968,1105,1251],{"id":245,"title":246,"body":247,"description":351,"extension":235,"meta":352,"navigation":237,"order":353,"path":354,"seo":355,"stem":356,"__hash__":357},"content_zh\u002Foverview.md","概览",{"type":7,"value":248,"toc":345},[249,251,254,257,260,263,277,280,310,313,322,325],[10,250,246],{"id":246},[13,252,253],{},"SoundNinja 是面向直播、好友聊天和播客录制的开源音效板。基于 Tauri v2 和 Nuxt 4 构建，内存和磁盘占用都很轻。",[13,255,256],{},"目标很简单：让庞大的音效库易于浏览，并在毫秒内播放正确的片段。界面也适合作为 VR 仪表盘使用。",[13,258,259],{},"SoundNinja 仍处于早期开发。功能可用，但并非每个平台都经过完整测试。",[17,261,262],{"id":262},"适合谁",[105,264,265,268,271,274],{},[24,266,267],{},"需要即时音效提示的主播",[24,269,270],{},"想在语音聊天中共用一块音板的朋友",[24,272,273],{},"录片段并放到音板上的播客作者",[24,275,276],{},"想要可定制、本地优先音效板的任何人",[17,278,279],{"id":279},"你能做什么",[105,281,282,285,288,291,294,297,304,307],{},[24,283,284],{},"用自己的音频文件搭建音效板",[24,286,287],{},"用彩色标签页、分组和搜索整理音效",[24,289,290],{},"用 Theme Creator 设计外观",[24,292,293],{},"在 Record Editor 中录制电脑音频或麦克风",[24,295,296],{},"为单个音效分配快捷键",[24,298,299,300,303],{},"通过 ",[70,301,63],{"href":302},"\u002Fdocs\u002Fremote-control"," 触发音效",[24,305,306],{},"导入导出完整音效板以便分享",[24,308,309],{},"在音效按钮上使用 GIF 或图片",[17,311,312],{"id":312},"许可证",[13,314,315,316,321],{},"SoundNinja 是采用 ",[70,317,320],{"href":318,"rel":319},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fblob\u002Fmain\u002FLICENSE",[74],"GPL-3.0"," 的自由软件。可以 fork、修改、分享。",[17,323,324],{"id":324},"下一步",[21,326,327,333,339],{},[24,328,329],{},[70,330,332],{"href":331},"\u002Fdocs\u002Finstallation","安装 SoundNinja",[24,334,335],{},[70,336,338],{"href":337},"\u002Fdocs\u002Fadding-sounds","添加音效",[24,340,341],{},[70,342,344],{"href":343},"\u002Fdocs\u002Forganizing-sounds","整理你的音板",{"title":226,"searchDepth":227,"depth":227,"links":346},[347,348,349,350],{"id":262,"depth":227,"text":262},{"id":279,"depth":227,"text":279},{"id":312,"depth":227,"text":312},{"id":324,"depth":227,"text":324},"SoundNinja 是什么，以及你能用它做什么。",{},1,"\u002Foverview",{"title":246,"description":351},"overview","KvvHO_GqjgVzbzlxkFb-6HqjE00ZT3hZwSKUzhwinxQ",{"id":359,"title":360,"body":361,"description":547,"extension":235,"meta":548,"navigation":237,"order":227,"path":549,"seo":550,"stem":551,"__hash__":552},"content_zh\u002Finstallation.md","安装",{"type":7,"value":362,"toc":540},[363,365,379,383,401,404,408,422,425,429,452,463,466,4