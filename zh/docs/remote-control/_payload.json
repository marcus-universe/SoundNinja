105,132,133,139,152,158],{},[24,134,135,138],{},[28,136,137],{},"Sound Playing"," — 该音效 ID 处于活动状态时为 true（用于按钮颜色）",[24,140,141,144,145,148,149],{},[42,142,143],{},"$(soundninja:connected)"," — ",[42,146,147],{},"true"," \u002F ",[42,150,151],{},"false",[24,153,154,157],{},[42,155,156],{},"$(soundninja:playing_count)"," — 正在播放的音效数量",[24,159,160,163],{},[42,161,162],{},"$(soundninja:last_triggered)"," — 上次触发的音效 ID",[17,165,167],{"id":166},"http-api高级","HTTP API（高级）",[13,169,170,171],{},"基础路径：",[42,172,173],{},"\u002Fapi\u002Fv1",[105,175,176,182,188,194,204,210,219],{},[24,177,178,181],{},[42,179,180],{},"GET \u002Finfo"," — 应用名称、版本、协议、是否需要令牌",[24,183,184,187],{},[42,185,186],{},"GET \u002Fsounds"," — 音效列表（id、name、tabs、active）",[24,189,190,193],{},[42,191,192],{},"GET \u002Fstate"," — 音效以及当前正在播放的 ID",[24,195,196,199,200,203],{},[42,197,198],{},"POST \u002Ftrigger"," 带 ",[42,201,202],{},"{ \"id\" }"," — 播放音效",[24,205,206,209],{},[42,207,208],{},"GET \u002Ftrigger\u002F:id"," — 播放（便于在浏览器中测试）",[24,211,212,215,216,218],{},[42,213,214],{},"POST \u002Fstop"," 带可选 ",[42,217,202],{}," — 停止一个或全部",[24,220,221,224],{},[42,222,223],{},"GET \u002Fws"," — 实时状态；接收 trigger\u002Fstop 命令",{"title":226,"searchDepth":227,"depth":227,"links":228},"",2,[229,230,231,232,233],{"id":19,"depth":227,"text":19},{"id":62,"depth":227,"text":63},{"id":103,"depth":227,"text":103},{"id":130,"depth":227,"text":130},{"id":166,"depth":227,"text":167},"通过本地网络用 Bitfocus Companion 触发 SoundNinja。","md",{},true,7,"\u002Fremote-control",{"title":5,"description":234},"remote-control","vmbwJuuS_NPHmhdnPs1__cpURph6ocjN-FjLeevtpLE",[244,367,586,725,1123,1253,1393,1539],{"id":245,"title":246,"body":247,"description":360,"extension":235,"meta":361,"navigation":237,"order":362,"path":363,"seo":364,"stem":365,"__hash__":366},"content_zh\u002Foverview.md","概览",{"type":7,"value":248,"toc":354},[249,251,254,257,260,263,277,280,319,322,331,334],[10,250,246],{"id":246},[13,252,253],{},"SoundNinja 是面向直播、好友聊天和播客录制的开源音效板。基于 Tauri v2 和 Nuxt 4 构建，内存和磁盘占用都很轻。",[13,255,256],{},"目标很简单：让庞大的音效库易于浏览，并在毫秒内播放正确的片段。界面也适合作为 VR 仪表盘使用。",[13,258,259],{},"SoundNinja 仍处于早期开发。功能可用，但并非每个平台都经过完整测试。",[17,261,262],{"id":262},"适合谁",[105,264,265,268,271,274],{},[24,266,267],{},"需要即时音效提示的主播",[24,269,270],{},"想在语音聊天中共用一块音板的朋友",[24,272,273],{},"录片段并放到音板上的播客作者",[24,275,276],{},"想要可定制、本地优先音效板的任何人",[17,278,279],{"id":279},"你能做什么",[105,281,282,285,288,291,294,297,300,303,306,313,316],{},[24,283,284],{},"用自己的音频文件搭建音效板",[24,286,287],{},"用彩色标签页、分组、标签和搜索整理音效",[24,289,290],{},"按标签筛选（OR），并按名称、日期、时长或大小排序",[24,292,293],{},"用框选或 Shift 范围多选，然后批量改色、移动或删除",[24,295,296],{},"在上下文菜单中设置单音效音量",[24,298,299],{},"用 Theme Creator 设计外观",[24,301,302],{},"在 Record Editor 中录制电脑音频或麦克风",[24,304,305],{},"为单个音效分配快捷键",[24,307,308,309,312],{},"通过 ",[70,310,63],{"href":311},"\u002Fdocs\u002Fremote-control"," 触发音效",[24,314,315],{},"导入导出完整音效板以便分享",[24,317,318],{},"在音效按钮上使用 GIF 或图片 — 本地文件夹库、GifSnap 或 KLIPY",[17,320,321],{"id":321},"许可证",[13,323,324,325,330],{},"SoundNinja 是采用 ",[70,326,329],{"href":327,"rel":328},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fblob\u002Fmain\u002FLICENSE",[74],"GPL-3.0"," 的自由软件。可以 fork、修改、分享。",[17,332,333],{"id":333},"下一步",[21,335,336,342,348],{},[24,337,338],{},[70,339,341],{"href":340},"\u002Fdocs\u002Finstallation","安装 SoundNinja",[24,343,344],{},[70,345,347],{"href":346},"\u002Fdocs\u002Fadding-sounds","添加音效",[24,349,350],{},[70,351,353],{"href":352},"\u002Fdocs\u002Forganizing-sounds","整理你的音板",{"title":226,"searchDepth":227,"depth":227,"links":355},[356,357,358,359],{"id":262,"depth":227,"text":262},{"id":279,"depth":227,"text":279},{"id":321,"depth":227,"text":321},{"id":333,"depth":227,"text":333},"SoundNinja 是什么，以及你能用它做什么。",{},1,"\u002Foverview",{"title":246,"description":360},"overview","wnwwum_AekPzS_yuj5xYL5pepe5P_4HhMqiaaqFeJ6I",{"id":368,"title":369,"body":370,"description":580,"extension":235,"meta":581,"navigation":237,"order":227,"path":582,"seo":583,"stem":584,"__hash__":585},"