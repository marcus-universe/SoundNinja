[{"data":1,"prerenderedAt":1351},["ShallowReactive",2],{"docs-page-zh-\u002Fremote-control":3,"docs-nav-zh":246},{"id":4,"title":5,"body":6,"description":237,"extension":238,"meta":239,"navigation":240,"order":241,"path":242,"seo":243,"stem":244,"__hash__":245},"content_zh\u002Fremote-control.md","远程控制",{"type":7,"value":8,"toc":228},"minimark",[9,12,16,20,57,60,64,104,107,128,131,134,167,171,177],[10,11,5],"h1",{"id":5},[13,14,15],"p",{},"SoundNinja 可以在本地网络上监听，让 Bitfocus Companion（或任何 HTTP\u002FWebSocket 客户端）播放和停止音效。",[17,18,19],"h2",{"id":19},"启用远程服务器",[21,22,23,32,38,46],"ol",{},[24,25,26,27,31],"li",{},"打开 ",[28,29,30],"strong",{},"设置 → 远程","。",[24,33,34,35,31],{},"启用远程服务器。默认端口为 ",[28,36,37],{},"7331",[24,39,40,41,45],{},"可选：设置令牌。客户端必须以 Bearer 令牌或 ",[42,43,44],"code",{},"?token="," 发送。",[24,47,48,49,52,53,56],{},"复制 ",[42,50,51],{},"http:\u002F\u002FIP:PORT"," URL，或从 ",[28,54,55],{},"设置 → 关于"," 复制系统 IP。",[13,58,59],{},"Windows 可能在服务器首次启动时显示防火墙提示。请允许专用网络访问。",[17,61,63],{"id":62},"bitfocus-companion","Bitfocus Companion",[21,65,66,75,84,91,97],{},[24,67,68,69,31],{},"安装 ",[70,71,63],"a",{"href":72,"rel":73},"https:\u002F\u002Fbitfocus.io\u002Fcompanion",[74],"nofollow",[24,76,77,78,83],{},"从官方文件夹下载 SoundNinja 模块：",[70,79,82],{"href":80,"rel":81},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Ftree\u002Fmain\u002Fcompanion-module-soundninja",[74],"companion-module-soundninja","。尚无 Companion Store 软件包 — 这个文件夹就是下载内容。",[24,85,86,87,90],{},"在 Companion 中打开 ",[28,88,89],{},"Developer → Modules","，或将文件夹放到 Companion 的自定义模块路径。",[24,92,93,94,31],{},"在模块文件夹中运行 ",[42,95,96],{},"npm install",[24,98,99,100,103],{},"添加一个 ",[28,101,102],{},"Sound Ninja"," 连接。粘贴电脑 IP、端口，以及你设置的令牌。",[17,105,106],{"id":106},"动作",[108,109,110,116,122],"ul",{},[24,111,112,115],{},[28,113,114],{},"Trigger Sound"," — 从实时下拉列表选择，或输入 8 位音效 ID（可使用 Companion 变量）",[24,117,118,121],{},[28,119,120],{},"Stop Sound"," — 按 ID 停止一个正在播放的音效",[24,123,124,127],{},[28,125,126],{},"Stop All"," — 停止所有正在播放的音效",[13,129,130],{},"在 SoundNinja 中，从按钮上下文菜单或多选 ID 芯片复制音效 ID。",[17,132,133],{"id":133},"反馈和变量",[108,135,136,142,155,161],{},[24,137,138,141],{},[28,139,140],{},"Sound Playing"," — 该音效 ID 处于活动状态时为 true（用于按钮颜色）",[24,143,144,147,148,151,152],{},[42,145,146],{},"$(soundninja:connected)"," — ",[42,149,150],{},"true"," \u002F ",[42,153,154],{},"false",[24,156,157,160],{},[42,158,159],{},"$(soundninja:playing_count)"," — 正在播放的音效数量",[24,162,163,166],{},[42,164,165],{},"$(soundninja:last_triggered)"," — 上次触发的音效 ID",[17,168,170],{"id":169},"http-api高级","HTTP API（高级）",[13,172,173,174],{},"基础路径：",[42,175,176],{},"\u002Fapi\u002Fv1",[108,178,179,185,191,197,207,213,222],{},[24,180,181,184],{},[42,182,183],{},"GET \u002Finfo"," — 应用名称、版本、协议、是否需要令牌",[24,186,187,190],{},[42,188,189],{},"GET \u002Fsounds"," — 音效列表（id、name、tabs、active）",[24,192,193,196],{},[42,194,195],{},"GET \u002Fstate"," — 音效以及当前正在播放的 ID",[24,198,199,202,203,206],{},[42,200,201],{},"POST \u002Ftrigger"," 带 ",[42,204,205],{},"{ \"id\" }"," — 播放音效",[24,208,209,212],{},[42,210,211],{},"GET \u002Ftrigger\u002F:id"," — 播放（便于在浏览器中测试）",[24,214,215,218,219,221],{},[42,216,217],{},"POST \u002Fstop"," 带可选 ",[42,220,205],{}," — 停止一个或全部",[24,223,224,227],{},[42,225,226],{},"GET \u002Fws"," — 实时状态；接收 trigger\u002Fstop 命令",{"title":229,"searchDepth":230,"depth":230,"links":231},"",2,[232,233,234,235,236],{"id":19,"depth":230,"text":19},{"id":62,"depth":230,"text":63},{"id":106,"depth":230,"text":106},{"id":133,"depth":230,"text":133},{"id":169,"depth":230,"text":170},"通过本地网络用 Bitfocus Companion 触发 SoundNinja。","md",{},true,7,"\u002Fremote-control",{"title":5,"description":237},"remote-control","FB_IBT42vaoGnthGdCszSV2p2tt6TkEQOPbd55XNGhA",[247,361,556,695,841,971,1108,1256],{"id":248,"title":249,"body":250,"description":354,"extension":238,"meta":355,"navigation":240,"order":356,"path":357,"seo":358,"stem":359,"__hash__":360},"content_zh\u002Foverview.md","概览",{"type":7,"value":251,"toc":348},[252,254,257,260,263,266,280,283,313,316,325,328],[10,253,249],{"id":249},[13,255,256],{},"SoundNinja 是面向直播、好友聊天和播客录制的开源音效板。基于 Tauri v2 和 Nuxt 4 构建，内存和磁盘占用都很轻。",[13,258,259],{},"目标很简单：让庞大的音效库易于浏览，并在毫秒内播放正确的片段。界面也适合作为 VR 仪表盘使用。",[13,261,262],{},"SoundNinja 仍处于早期开发。功能可用，但并非每个平台都经过完整测试。",[17,264,265],{"id":265},"适合谁",[108,267,268,271,274,277],{},[24,269,270],{},"需要即时音效提示的主播",[24,272,273],{},"想在语音聊天中共用一块音板的朋友",[24,275,276],{},"录片段并放到音板上的播客作者",[24,278,279],{},"想要可定制、本地优先音效板的任何人",[17,281,282],{"id":282},"你能做什么",[108,284,285,288,291,294,297,300,307,310],{},[24,286,287],{},"用自己的音频文件搭建音效板",[24,289,290],{},"用彩色标签页、分组和搜索整理音效",[24,292,293],{},"用 Theme Creator 设计外观",[24,295,296],{},"在 Record Editor 中录制电脑音频或麦克风",[24,298,299],{},"为单个音效分配快捷键",[24,301,302,303,306],{},"通过 ",[70,304,63],{"href":305},"\u002Fdocs\u002Fremote-control"," 触发音效",[24,308,309],{},"导入导出完整音效板以便分享",[24,311,312],{},"在音效按钮上使用 GIF 或图片",[17,314,315],{"id":315},"许可证",[13,317,318,319,324],{},"SoundNinja 是采用 ",[70,320,323],{"href":321,"rel":322},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fblob\u002Fmain\u002FLICENSE",[74],"GPL-3.0"," 的自由软件。可以 fork、修改、分享。",[17,326,327],{"id":327},"下一步",[21,329,330,336,342],{},[24,331,332],{},[70,333,335],{"href":334},"\u002Fdocs\u002Finstallation","安装 SoundNinja",[24,337,338],{},[70,339,341],{"href":340},"\u002Fdocs\u002Fadding-sounds","添加音效",[24,343,344],{},[70,345,347],{"href":346},"\u002Fdocs\u002Forganizing-sounds","整理你的音板",{"title":229,"searchDepth":230,"depth":230,"links":349},[350,351,352,353],{"id":265,"depth":230,"text":265},{"id":282,"depth":230,"text":282},{"id":315,"depth":230,"text":315},{"id":327,"depth":230,"text":327},"SoundNinja 是什么，以及你能用它做什么。",{},1,"\u002Foverview",{"title":249,"description":354},"overview","KvvHO_GqjgVzbzlxkFb-6HqjE00ZT3hZwSKUzhwinxQ",{"id":362,"title":363,"body":364,"description":550,"extension":238,"meta":551,"navigation":240,"order":230,"path":552,"seo":553,"stem":554,"__hash__":555},"content_zh\u002Finstallation.md","安装",{"type":7,"value":365,"to