76},{"id":94,"depth":104,"text":94},"如何获取帮助和报告问题。","md",{},true,8,"\u002Fsupport",{"title":5,"description":111},"support","VwBwQbdCHoT7TrVGmqzJJD8OpJ6oQQwBjq9OoCG2eWY",[121,246,459,599,987,1118,1258,1478],{"id":122,"title":123,"body":124,"description":239,"extension":112,"meta":240,"navigation":114,"order":241,"path":242,"seo":243,"stem":244,"__hash__":245},"content_zh\u002Foverview.md","概览",{"type":7,"value":125,"toc":233},[126,128,131,134,137,140,156,159,199,202,209,212],[10,127,123],{"id":123},[13,129,130],{},"SoundNinja 是面向直播、好友聊天和播客录制的开源音效板。基于 Tauri v2 和 Nuxt 4 构建，内存和磁盘占用都很轻。",[13,132,133],{},"目标很简单：让庞大的音效库易于浏览，并在毫秒内播放正确的片段。界面也适合作为 VR 仪表盘使用。",[13,135,136],{},"SoundNinja 仍处于早期开发。功能可用，但并非每个平台都经过完整测试。",[17,138,139],{"id":139},"适合谁",[141,142,143,147,150,153],"ul",{},[144,145,146],"li",{},"需要即时音效提示的主播",[144,148,149],{},"想在语音聊天中共用一块音板的朋友",[144,151,152],{},"录片段并放到音板上的播客作者",[144,154,155],{},"想要可定制、本地优先音效板的任何人",[17,157,158],{"id":158},"你能做什么",[141,160,161,164,167,170,173,176,179,182,185,193,196],{},[144,162,163],{},"用自己的音频文件搭建音效板",[144,165,166],{},"用彩色标签页、分组、标签和搜索整理音效",[144,168,169],{},"按标签筛选（OR），并按名称、日期、时长或大小排序",[144,171,172],{},"用框选或 Shift 范围多选，然后批量改色、移动或删除",[144,174,175],{},"在上下文菜单中设置单音效音量",[144,177,178],{},"用 Theme Creator 设计外观",[144,180,181],{},"在 Record Editor 中录制电脑音频或麦克风",[144,183,184],{},"为单个音效分配快捷键",[144,186,187,188,192],{},"通过 ",[26,189,191],{"href":190},"\u002Fdocs\u002Fremote-control","Bitfocus Companion"," 触发音效",[144,194,195],{},"导入导出完整音效板以便分享",[144,197,198],{},"在音效按钮上使用 GIF 或图片 — 本地文件夹库或 KLIPY",[17,200,201],{"id":201},"许可证",[13,203,204,205,208],{},"SoundNinja 是采用 ",[26,206,90],{"href":88,"rel":207},[30]," 的自由软件。可以 fork、修改、分享。",[17,210,211],{"id":211},"下一步",[213,214,215,221,227],"ol",{},[144,216,217],{},[26,218,220],{"href":219},"\u002Fdocs\u002Finstallation","安装 SoundNinja",[144,222,223],{},[26,224,226],{"href":225},"\u002Fdocs\u002Fadding-sounds","添加音效",[144,228,229],{},[26,230,232],{"href":231},"\u002Fdocs\u002Forganizing-sounds","整理你的音板",{"title":103,"s