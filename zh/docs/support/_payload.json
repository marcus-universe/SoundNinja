","、",[334,348,349],{},"libgtk-3-0"," 以及 app-indicator 库。",[17,352,56],{"id":56},[13,354,355,356,358],{},"在应用中打开 ",[36,357,38],{},"。也可以在设置中让 SoundNinja 启动时检查。",[17,360,361],{"id":361},"从源码构建",[13,363,364,365,369,370,375],{},"需要自定义构建？克隆",[26,366,368],{"href":82,"rel":367},[30],"仓库","，安装 ",[26,371,374],{"href":372,"rel":373},"https:\u002F\u002Fv2.tauri.app\u002Fstart\u002Fprerequisites\u002F",[30],"Tauri 前置条件","，然后：",[377,378,382],"pre",{"className":379,"code":380,"language":381,"meta":103,"style":103},"language-bash shiki shiki-themes github-light github-dark","bun install\nbun run tauri:serve\n","bash",[334,383,384,396],{"__ignoreMap":103},[385,386,388,392],"span",{"class":387,"line":241},"line",[385,389,391],{"class":390},"sScJk","bun",[385,393,395],{"class":394},"sZZnC"," install\n",[385,397,398,400,403],{"class":387,"line":104},[385,399,391],{"class":390},[385,401,402],{"class":394}," run",[385,404,405],{"class":394}," tauri:serve\n",[13,407,408,346,411,39,414,417,418,73],{},[334,409,410],{},"npm",[334,412,413],{},"pnpm",[334,415,416],{},"deno"," 也可以。生产构建：",[334,419,420],{},"bun run tauri:build",[422,423,424],"style",{},"html pre.shiki code .sScJk, html code.shiki .sScJk{--shiki-default:#6F42C1;--shiki-dark:#B392F0}html pre.shiki code .sZZnC, html code.shiki .sZZnC{--shiki-default:#032F62;--shiki-dark:#9ECBFF}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-tex