76},{"id":94,"depth":104,"text":94},"如何获取帮助和报告问题。","md",{},true,8,"\u002Fsupport",{"title":5,"description":111},"support","VwBwQbdCHoT7TrVGmqzJJD8OpJ6oQQwBjq9OoCG2eWY",[121,237,426,566,712,843,980,1200],{"id":122,"title":123,"body":124,"description":230,"extension":112,"meta":231,"navigation":114,"order":232,"path":233,"seo":234,"stem":235,"__hash__":236},"content_zh\u002Foverview.md","概览",{"type":7,"value":125,"toc":224},[126,128,131,134,137,140,156,159,190,193,200,203],[10,127,123],{"id":123},[13,129,130],{},"SoundNinja 是面向直播、好友聊天和播客录制的开源音效板。基于 Tauri v2 和 Nuxt 4 构建，内存和磁盘占用都很轻。",[13,132,133],{},"目标很简单：让庞大的音效库易于浏览，并在毫秒内播放正确的片段。界面也适合作为 VR 仪表盘使用。",[13,135,136],{},"SoundNinja 仍处于早期开发。功能可用，但并非每个平台都经过完整测试。",[17,138,139],{"id":139},"适合谁",[141,142,143,147,150,153],"ul",{},[144,145,146],"li",{},"需要即时音效提示的主播",[144,148,149],{},"想在语音聊天中共用一块音板的朋友",[144,151,152],{},"录片段并放到音板上的播客作者",[144,154,155],{},"想要可定制、本地优先音效板的任何人",[17,157,158],{"id":158},"你能做什么",[141,160,161,164,167,170,173,176,184,187],{},[144,162,163],{},"用自己的音频文件搭建音效板",[144,165,166],{},"用彩色标签页、分组和搜索整理音效",[144,168,169],{},"用 Theme Creator 设计外观",[144,171,172],{},"在 Record Editor 中录制电脑音频或麦克风",[144,174,175],{},"为单个音效分配快捷键",[144,177,178,179,183],{},"通过 ",[26,180,182],{"href":181},"\u002Fdocs\u002Fremote-control","Bitfocus Companion"," 触发音效",[144,185,186],{},"导入导出完整音效板以便分享",[144,188,189],{},"在音效按钮上使用 GIF 或图片",[17,191,192],{"id":192},"许可证",[13,194,195,196,199],{},"SoundNinja 是采用 ",[26,197,90],{"href":88,"rel":198},[30]," 的自由软件。可以 fork、修改、分享。",[17,201,202],{"id":202},"下一步",[204,205,206,212,218],"ol",{},[144,207,208],{},[26,209,211],{"href":210},"\u002Fdocs\u002Finstallation","安装 SoundNinja",[144,213,214],{},[26,215,217],{"href":216},"\u002Fdocs\u002Fadding-sounds","添加音效",[144,219,220],{},[26,221,223],{"href":222},"\u002Fdocs\u002Forganizing-sounds","整理你的音板",{"title":103,"searchDepth":104,"depth":104,"links":225},[226,227,228,229],{"id":139,"depth":104,"text":139},{"id":158,"depth":104,"text":158},{"id":192,"depth":104,"text":192},{"id":202,"depth":104,"text":202},"SoundNinja 是什么，以及你能用它做什么。",{},1,"\u002Foverview",{"title":123,"description":230},"overview","KvvHO_GqjgVzbzlxkFb-6HqjE00ZT3hZwSKUzhwinxQ",{"id":238,"title":239,"body":240,"description":420,"extension":112,"meta":421,"navigation":114,"order":104,"path":422,"seo":423,"stem":424,"__hash__":425},"content_zh\u002Finstallation.md","安装",{"type":7,"value":241,"toc":413},[242,244,255,259,276,279,283,297,300,304,328,339,341,347,350,364,394,409],[10,243,239],{"id":239},[13,245,246,247,249,250,254],{},"从",[26,248,66],{"href":65},"或 ",[26,251,72],{"href":252,"rel":253},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Freleases\u002Flatest",[30]," 获取构建。SoundNinja 处于早期开发，请将构建视为测试版。",[17,256,258],{"id":257},"windows","Windows",[141,260,261,270,273],{},[144,262,263,264,39,267],{},"64 位 Windows 的 ",[36,265,266],{},"安装程序 (.exe)",[36,268,269],{},"MSI (.msi)",[144,271,272],{},"落地页目标：Windows 10 及更新",[144,274,275],{},"应用 README 也列出 Windows 8 及以上",[13,277,278],{},"运行安装程序，然后从开始菜单启动 SoundNinja。",[17,280,282],{"id":281},"macos","macOS",[141,284,285,291,294],{},[144,286,287,288],{},"适用于 Apple Silicon 和 Intel 的 ",[36,289,290],{},"通用 .dmg",[144,292,293],{},"落地页目标：macOS 10.14 及更新",[144,295,296],{},"应用 README 列出 macOS 10.15 及以上",[13,298,299],{},"打开磁盘映像，将 SoundNinja 拖到“应用程序”。",[17,301,303],{"id":302},"linux","Linux",[141,305,306,312,318,325],{},[144,307,308,309],{},"Ubuntu \u002F Debian 的 ",[36,310,311],{},"Debian (.deb)",[144,313,314,315],{},"其他发行版的 ",[36,316,317],{},"AppImage",[144,319,320,321],{},"发布后，Arch 用户可从 AUR 安装 ",[322,323,324],"code",{},"soundninja-bin",[144,326,327],{},"已在 Ubuntu 20.04 上测试",[13,329,330,331,334,335,338],{},"桌面构建需要 WebKit 和 GTK 软件包。在 Debian\u002FUbuntu 上通常是 ",[322,332,333],{},"libwebkit2gtk","、",[322,336,337],{},"libgtk-3-0"," 以及 app-indicator 库。",[17,340,56],{"id":56},[13,342,343,344,346],{},"在应用中打开 ",[36,345,38],{},"。也可以在设置中让 SoundNinja 启动时检查。",[17,348,349],{"id":349},"从源码构建",[13,351,352,353,357,358,363],{},"需要自定义