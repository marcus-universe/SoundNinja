,1355,1358],{},[17,1356,1357],{},"Stop Sound"," — 按 ID 停止一个正在播放的音效",[36,1360,1361,1364],{},[17,1362,1363],{},"Stop All"," — 停止所有正在播放的音效",[13,1366,1367],{},"在 SoundNinja 中，从按钮上下文菜单或多选 ID 芯片复制音效 ID。",[22,1369,1370],{"id":1370},"反馈和变量",[33,1372,1373,1379,1391,1397],{},[36,1374,1375,1378],{},[17,1376,1377],{},"Sound Playing"," — 该音效 ID 处于活动状态时为 true（用于按钮颜色）",[36,1380,1381,1384,1385,143,1388],{},[140,1382,1383],{},"$(soundninja:connected)"," — ",[140,1386,1387],{},"true",[140,1389,1390],{},"false",[36,1392,1393,1396],{},[140,1394,1395],{},"$(soundninja:playing_count)"," — 正在播放的音效数量",[36,1398,1399,1402],{},[140,1400,1401],{},"$(soundninja:last_triggered)"," — 上次触发的音效 ID",[22,1404,1406],{"id":1405},"http-api高级","HTTP API（高级）",[13,1408,1409,1410],{},"基础路径：",[140,1411,1412],{},"\u002Fapi\u002Fv1",[33,1414,1415,1421,1427,1433,1443,1449,1458],{},[36,1416,1417,1420],{},[140,1418,1419],{},"GET \u002Finfo"," — 应用名称、版本、协议、是否需要令牌",[36,1422,1423,1426],{},[140,1424,1425],{},"GET \u002Fsounds"," — 音效列表（id、name、tabs、active）",[36,1428,1429,1432],{},[140,1430,1431],{},"GET \u002Fstate"," — 音效以及当前正在播放的 ID",[36,1434,1435,1438,1439,1442],{},[140,1436,1437],{},"POST \u002Ftrigger"," 带 ",[140,1440,1441],{},"{ \"id\" }"," — 播放音效",[36,1444,1445,1448],{},[140,1446,1447],{},"GET \u002Ftrigger\u002F:id"," — 播放（便于在浏览器中测试）",[36,1450,1451,1454,1455,1457],{},[140,1452,1453],{},"POST \u002Fstop"," 带可选 ",[140,1456,1441],{}," — 停止一个或全部",[36,1459,1460,1463],{},[140,1461,1462],{},"GET \u002Fws"," — 实时状态；接收 trigger\u002Fstop 命令",{"title":149,"searchDepth":150,"depth":150,"links":1465},[1466,1467,1468,1469,1470],{"id":1269,"depth":150,"text":1269},{"id":1306,"depth":150,"text":235},{"id":1344,"depth":150,"text":1344},{"id":1370,"depth":150,"text":1370},{"id":1405,"depth":150,"text":1406},"通过本地网络用 Bitfocus Companion 触发 SoundNinja。",{},7,"\u002Fremote-control",{"title":1259,"description":1471},"remote-control","vmbwJuuS_NPHmhdnPs1__cpURph6ocjN-FjLeevtpLE",{"id":1479,"title":1480,"body":1481,"description":1566,