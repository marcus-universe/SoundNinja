不透明度（正常和悬停）",[22,818,819],{"id":819},"保存与分享",[33,821,822,828,834,840],{},[36,823,824,827],{},[17,825,826],{},"导出 .css"," — 写出可备份或发给朋友的主题文件",[36,829,830,833],{},[17,831,832],{},"添加到主题"," — 保存到 Themes 文件夹并应用",[36,835,836,839],{},[17,837,838],{},"导入 .css"," — 加载内置预设或已保存的主题",[36,841,842,845],{},[17,843,844],{},"重置"," — 恢复 SoundNinja 默认值",[13,847,848],{},"若关闭窗口时有未保存更改，SoundNinja 会先询问是否保存。",[22,850,851],{"id":851},"不用完整编辑器",[13,853,27,854,856],{},[17,855,652],{}," 中你仍然可以：",[33,858,859,862,868],{},[36,860,861],{},"从列表中选择主题",[36,863,864,865,785],{},"实时编辑 CSS 变量（",[17,866,867],{},"自定义 CSS",[36,869,870],{},"将主题文件导入 Themes 文件夹",{"title":145,"searchDepth":146,"depth":146,"links":872},[873,874,875,876],{"id":770,"depth":146,"text":770},{"id":802,"depth":146,"text":802},{"id":819,"depth":146,"text":819},{"id":851,"depth":146,"text":851},"在 Theme Creator 中设计颜色、字体、按钮和标签页。",{},5,"\u002Ftheme-editor",{"title":756,"description":877},"theme-editor","Mu4ghPBGL1w-XCpoVZlYs-uJo8X2WLz8pVTLxGchO7c",{"id":4,"title":5,"body":885,"description":152,"extension":153,"meta":975,"navigation":155,"order":156,"path":157,"seo":976,"stem":159,"__hash__":160},{"type":7,"value":886,"toc":969},[887,889,893,895,899,913,915,917,935,937,949,951,959,963],[10,888,5],{"id":5},[13,890,15,891,20],{},[17,892,19],{},[22,894,24],{"id":24},[13,896,27,897,31],{},[17,898,30],{},[33,900,901,905,909],{},[36,902,903,41],{},[17,904,40],{},[36,906,907,47],{},[17,908,46],{},[36,910,911,53],{},[17,912,52],{},[13,914,56],{},[22,916,59],{"id":59},[33,918,919,921,923,929,931,933],{},[36,920,64],{},[36,922,67],{},[36,924,925,73,927],{},[17,926,72],{},[17,928,76],{},[36,930,79],{},[36,932,82],{},[36,934,85],{},[22,936,88],{"id":88},[90,938,939,941,943],{},[36,940,94],{},[36,942,97],{},[36,944,945,73,947,106],{},[17,946,102],{},[17,948,105],{},[22,950,110],{"id":109},[13,952,113,953,73,955,120,957,124],{},[17,954,116],{},[17,956,119],{},[17,958,123],{},[13,960,127,961,131],{},[17,962,130],{},[13,964,134,965,139,967,143],{},[136,966,138],{},[136,968,142],{},{"title":145,"searchDepth":146,"depth":146,"links":970},[971,972,973,974],{"id":24,"depth":146,"text":24},{"id":59,"depth":146,"text":59},{"id":88,"depth":146,"text":88},{"id":109,"depth":146,"text":110},{},{"title":5,"description":152},{"id":978,"title":979,"body":980,"description":1194,"extension":153,"meta":1195,"navigation":155,"order":1196,"path":1197,"seo":1198,"stem":1199,"__hash__":1200},"content_zh\u002Fremote-control.md","远程控制",{"type":7,"value":981,"toc":1187},[982,984,987,990,1021,1024,1027,1065,1068,1088,1091,1094,1126,1130,1136],[10,983,979],{"id":979},[13,985,986],{},"SoundNinja 可以在本地网络上监听，让 Bitfocus Companion（或任何 HTTP\u002FWebSocket 客户端）播放和停止音效。",[22,988,989],{"id":989},"启用远程服务器",[90,991,992,997,1003,1010],{},[36,993,490,994,456],{},[17,995,996],{},"设置 → 远程",[36,998,999,1000,456],{},"启用远程服务器。默认端口为 ",[17,1001,1002],{},"7331",[36,1004,1005,1006,1009],{},"可选：设置令牌。客户端必须以 Bearer 令牌或 ",[136,1007,1008],{},"?token="," 发送。",[36,1011,1012,1013,1016,1017,1020],{},"复制 ",[136,1014,1015],{},"http:\u002F\u002FIP:PORT"," URL，或从 ",[17,1018,1019],{},"设置 → 关于"," 复制系统 IP。",[13,1022,1023],{},"Windows 可能在服务器首次启动时显示防火墙提示。请允许专用网络访问。",[22,1025,222],{"id":1026},"bitfocus-companion",[90,1028,1029,1036,1045,1052,1058],{},[36,1030,1031,1032,456],{},"安装 ",[219,1033,222],{"href":1034,"rel":1035},"https:\u002F\u002Fbitfocus.io\u002Fcompanion",[240],[36,1037,1038,1039,1044],{},"从官方文件夹下载 SoundNinja 模块：",[219,1040,1043],{"href":1041,"rel":1042},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Ftree\u002Fmain\u002Fcompanion-module-soundninja",[240],"companion-module-soundninja","。尚无 Companion Store 软件包 — 这个文件夹就是下载内容。",[36,1046,1047,1048,1051],{},"在 Companion 中打开 ",[17,1049,1050],{},"Developer → Modules","，或将文件夹放到 Companion 的自定义模块路径。",[36,1053,1054,1055,456],{},"在模块文件夹中运行 ",[136,1056,1057],{},"npm install",[36,1059,1060,1061,1064],{},"添加一个 ",[17,1062,1063],{},"Sound Ninja"," 连接。粘贴电脑 IP、端口，以及你设置的令牌。",[22,1066,1067],{"id":1067},"动作",[33,1069,1070,1076,1082],{},[36,1071,1072,1075],{},[17,1073,1074],{},"Trigger Sound"," — 从实时下拉列表选择，或输入 8 位音效 ID（可使用 Companion 变量）",[36,1077,1078,1081],{},[17,1079,1080],{},"Stop Sound"," — 按 ID 停止一个正在播放的音效",[36,1083,1084,1087],{},[17,1085,1086],{},"Stop All"," — 停止所有正在播放的音效",[13,1089,1090],{},"在 SoundNinja 中，从按钮上下文菜单或多选 ID 芯片复制音效 ID。",[22,1092,1093],{"id":1093},"反馈和变量",[33,1095,1096,1102,1114,1120],{},[36,1097,1098,1101],{},[17,1099,1100],{},"Sound Playing"," — 该音效 ID 处于活动状态时为 true（用于按钮颜色）",[36,1103,1104,1107,1108,139,1111],{},[136,1105,1106],{},"$(soundninja:connected)"," — ",[136,1109,1110],{},"true",[136,1112,1113],{},"false",[36,1115,1116,1119],{},[136,1117,1118],{},"$(soundninja:playing_count)"," — 正在播放的音效数量",[36,1121,1122,1125],{},[136,1123,1124],{},"$(soundninja:last_triggered)"," — 上次触发的音效 ID",[22,1127,1129],{"id":1128},"http-api高级","HTTP API（高级）",[13,1131,1132,1133],{},"基础路径：",[136,1134,1135],{},"\u002Fapi\u002Fv1",[33,1137,1138,1144,1150,1156,1166,1172,1181],{},[36,1139,1140,1143],{},[136,1141,1142],{},"GET \u002Finfo"," — 应用名称、版本、协议、是否需要令牌",[36,1145,1146,1149],{},[136,1147,1148],{},"GET \u002Fsounds"," — 音效列表（id、name、tabs、active）",[36,1151,1152,1155],{},[136,1153,1154],{},"GET \u002Fstate"," — 音效以及当前正在播放的 ID",[36,1157,1158,1161,1162,1165],{},[136,1159,1160],{},"POST \u002Ftrigger"," 带 ",[136,1163,1164],{},"{ \"id\" }"," — 播放音效",[36,1167,1168,1171],{},[136,1169,1170],{},"GET \u002Ftrigger\u002F:id"," — 播放（便于在浏览器中测试）",[36,1173,1174,1177,1178,1180],{},[136,1175,1176],{},"POST \u002Fstop"," 带可选 ",[136,1179,1164],{}," — 停止一个或全部",[36,1182,1183,1186],{},[136,1184,1185],{},"GET \u002Fws"," — 实时状态；接收 trigger\u002Fstop 命令",{"title":145,"searchDepth":146,"depth":146,"links":1188},[1189,1190,1191,1192,1193],{"id":989,"depth":146,"text":989},{"id":1026,"depth":146,"text":222},{"id":1067,"depth":146,"text":1067},{"id":1093,"depth":146,"text":1093},{"id":1128,"depth":146,"text":1129},"通过本地网络用 Bitfocus Companion 触发 SoundNinja。",{},7,"\u002Fremote-control",{"title":979,"descripti