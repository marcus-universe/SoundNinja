下拉列表选择，或输入 8 位音效 ID（可使用 Companion 变量）",[29,1073,1074,1077],{},[17,1075,1076],{},"Stop Sound"," — 按 ID 停止一个正在播放的音效",[29,1079,1080,1083],{},[17,1081,1082],{},"Stop All"," — 停止所有正在播放的音效",[13,1085,1086],{},"在 SoundNinja 中，从按钮上下文菜单或多选 ID 芯片复制音效 ID。",[22,1088,1089],{"id":1089},"反馈和变量",[63,1091,1092,1098,1110,1116],{},[29,1093,1094,1097],{},[17,1095,1096],{},"Sound Playing"," — 该音效 ID 处于活动状态时为 true（用于按钮颜色）",[29,1099,1100,1103,1104,39,1107],{},[36,1101,1102],{},"$(soundninja:connected)"," — ",[36,1105,1106],{},"true",[36,1108,1109],{},"false",[29,1111,1112,1115],{},[36,1113,1114],{},"$(soundninja:playing_count)"," — 正在播放的音效数量",[29,1117,1118,1121],{},[36,1119,1120],{},"$(soundninja:last_triggered)"," — 上次触发的音效 ID",[22,1123,1125],{"id":1124},"http-api高级","HTTP API（高级）",[13,1127,1128,1129],{},"基础路径：",[36,1130,1131],{},"\u002Fapi\u002Fv1",[63,1133,1134,1140,1146,1152,1162,1168,1177],{},[29,1135,1136,1139],{},[36,1137,1138],{},"GET \u002Finfo"," — 应用名称、版本、协议、是否需要令牌",[29,1141,1142,1145],{},[36,1143,1144],{},"GET \u002Fsounds"," — 音效列表（id、name、tabs、active）",[29,1147,1148,1151],{},[36,1149,1150],{},"GET \u002Fstate"," — 音效以及当前正在播放的 ID",[29,1153,1154,1157,1158,1161],{},[36,1155,1156],{},"POST \u002Ftrigger"," 带 ",[36,1159,1160],{},"{ \"id\" }"," — 播放音效",[29,1163,1164,1167],{},[36,1165,1166],{},"GET \u002Ftrigger\u002F:id"," — 播放（便于在浏览器中测试）",[29,1169,1170,1173,1174,1176],{},[36,1171,1172],{},"POST \u002Fstop"," 带可选 ",[36,1175,1160],{}," — 停止一个或全部",[29,1178,1179,1182],{},[36,1180,1181],{},"GET \u002Fws"," — 实时状态；接收 trigger\u002Fstop 命令",{"title":134,"searchDepth":135,"depth":135,"links":1184},[1185,1186,1187,1188,1189],{"id":985,"depth":135,"text":985},{"id":1022,"depth":135,"text":211},{"id":1063,"depth":135,"text":1063},{"id":1089,"depth":135,"text":1089},{"id":1124,"depth":135,"text":1125},"通过本地网络用 Bitfocus Companion 触发 SoundNinja。",{},7,"\u002Fremote-control",{"title":975,"description":1190},"remote-control","FB_IBT42vaoGnthGdCszSV2p2tt6TkEQOPbd55XNGhA",{"id":1198,"title":1199,"bo