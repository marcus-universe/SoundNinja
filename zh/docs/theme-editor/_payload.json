,697],{"id":697},"批量编辑",[13,699,700],{},"多选音效，然后一次性改颜色、移到标签页或删除。",[22,702,704],{"id":703},"快捷键和音效-id","快捷键和音效 ID",[13,706,707],{},"每个音效都有 8 位 ID。从按钮上下文菜单或多选 ID 芯片复制。",[13,709,480,710,713],{},[17,711,712],{},"设置 → 快捷键","，将按键绑定到音效 ID。全局快捷键可选。",[13,715,716,718],{},[208,717,211],{"href":210}," 用同一个 ID 触发片段。",[22,720,722],{"id":721},"gif-和颜色","GIF 和颜色",[13,724,725,726,730],{},"右键音效可设置单按钮颜色或 GIF \u002F 图片背景。这与为整块音板设置样式的 ",[208,727,729],{"href":728},"\u002Fdocs\u002Ftheme-editor","Theme Creator"," 是分开的。",{"title":134,"searchDepth":135,"depth":135,"links":732},[733,734,735,736,737,738,739],{"id":54,"depth":135,"text":54},{"id":649,"depth":135,"text":649},{"id":675,"depth":135,"text":675},{"id":684,"depth":135,"text":684},{"id":697,"depth":135,"text":697},{"id":703,"depth":135,"text":704},{"id":721,"depth":135,"text":722},"标签页、分组、搜索、批量编辑和快捷键。",{},4,"\u002Forganizing-sounds",{"title":587,"description":740},"organizing-sounds","HsYzNxoixSByGrrBc25kUWlGkW9g_qo-epDyg_qNpXM",{"id":4,"title":5,"body":748,"description":141,"extension":142,"meta":834,"navigation":144,"order":145,"path":146,"seo":835,"stem":148,"__hash__":149},{"type":7,"value":749,"toc":828},[750,752,756,758,776,778,780,790,792,810,812,814,818],[10,751,5],{"id":5},[13,753,15,754,20],{},[17,755,19],{},[22,757,24],{"id":24},[26,759,760,768,772],{},[29,761,762,34,764,39,766,43],{},[17,763,33],{},[36,765,38],{},[36,767,42],{},[29,769,770,49],{},[17,771,48],{},[29,773,774,55],{},[17,775,54],{},[13,777,58],{},[22,779,61],{"id":61},[63,781,782,784,786,788],{},[29,783,67],{},[29,785,70],{},[29,787,73],{},[29,789,76],{},[22,791,79],{"id":79},[63,793,794,798,802,806],{},[29,795,796,87],{},[17,797,86],{},[29,799,800,93],{},[17,801,92],{},[29,803,804,99],{},[17,805,98],{},[29,807,808,105],{},[17,809,104],{},[13,811,108],{},[22,813,111],{"id":111},[13,815,114,816,118],{},[17,817,117],{},[63,819,820,822,826],{},[29,821,123],{},[29,823,126,824,43],{},[17,825,129],{},[29,827,132],{},{"title":134,"searchDepth":135,"depth":135,"links