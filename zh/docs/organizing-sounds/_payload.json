d Ninja"," 连接。粘贴电脑 IP、端口，以及你设置的令牌。",[17,1064,1065],{"id":1065},"动作",[21,1067,1068,1074,1080],{},[24,1069,1070,1073],{},[28,1071,1072],{},"Trigger Sound"," — 从实时下拉列表选择，或输入 8 位音效 ID（可使用 Companion 变量）",[24,1075,1076,1079],{},[28,1077,1078],{},"Stop Sound"," — 按 ID 停止一个正在播放的音效",[24,1081,1082,1085],{},[28,1083,1084],{},"Stop All"," — 停止所有正在播放的音效",[13,1087,1088],{},"在 SoundNinja 中，从按钮上下文菜单或多选 ID 芯片复制音效 ID。",[17,1090,1091],{"id":1091},"反馈和变量",[21,1093,1094,1100,1112,1118],{},[24,1095,1096,1099],{},[28,1097,1098],{},"Sound Playing"," — 该音效 ID 处于活动状态时为 true（用于按钮颜色）",[24,1101,1102,1105,1106,738,1109],{},[371,1103,1104],{},"$(soundninja:connected)"," — ",[371,1107,1108],{},"true",[371,1110,1111],{},"false",[24,1113,1114,1117],{},[371,1115,1116],{},"$(soundninja:playing_count)"," — 正在播放的音效数量",[24,1119,1120,1123],{},[371,1121,1122],{},"$(soundninja:last_triggered)"," — 上次触发的音效 ID",[17,1125,1127],{"id":1126},"http-api高级","HTTP API（高级）",[13,1129,1130,1131],{},"基础路径：",[371,1132,1133],{},"\u002Fapi\u002Fv1",[21,1135,1136,1142,1148,1154,1164,1170,1179],{},[24,1137,1138,1141],{},[371,1139,1140],{},"GET \u002Finfo"," — 应用名称、版本、协议、是否需要令牌",[24,1143,1144,1147],{},[371,1145,1146],{},"GET \u002Fsounds"," — 音效列表（id、name、tabs、active）",[24,1149,1150,1153],{},[371,1151,1152],{},"GET \u002Fstate"," — 音效以及当前正在播放的 ID",[24,1155,1156,1159,1160,1163],{},[371,1157,1158],{},"POST \u002Ftrigger"," 带 ",[371,1161,1162],{},"{ \"id\" }"," — 播放音效",[24,1165,1166,1169],{},[371,1167,1168],{},"GET \u002Ftrigger\u002F:id"," — 播放（便于在浏览器中测试）",[24,1171,1172,1175,1176,1178],{},[371,1173,1174],{},"POST \u002Fstop"," 带可选 ",[371,1177,1162],{}," — 停止一个或全部",[24,1180,1181,1184],{},[371,1182,1183],{},"GET \u002Fws"," — 实时状态；接收 trigger\u002Fstop 命令",{"title":147,"searchDepth":148,"depth":148,"links":1186},[1187,1188,1189,1190,1191],{"id":990,"depth":148,"text":990},{"id":1027,"depth":148,"text":132},{"id":1065,"depth":148,"text":1065},{"id":1091,"depth":148,"text":1091},{"id":1126,"depth":148,"text":1127},"通过本地网络用 Bitfocus C