,154],{"id":154},"筛选音板",[26,156,157,164,175,186],{},[29,158,159,160,163],{},"在筛选面板或 ",[17,161,162],{},"搜索栏下方的芯片"," 中切换标签。",[29,165,166,167,170,171,174],{},"匹配为 ",[17,168,169],{},"OR","：音效带有 ",[17,172,173],{},"任一"," 已选标签就会显示。",[29,176,177,178,181,182,185],{},"导航栏 ",[17,179,180],{},"搜索"," 与当前标签筛选做 ",[17,183,184],{},"AND","（输入 + 标签一起）。",[29,187,188],{},"关掉芯片（或清空筛选）即可再看到整个标签页。",[13,190,191,192,195],{},"按钮上可显示彩色标签名。在 ",[17,193,194],{},"设置 → 行为 → 显示标签徽章"," 中开关。",[22,197,198],{"id":198},"排序",[13,200,201],{},"打开筛选面板并选择排序方式：",[26,203,204,210],{},[29,205,206,209],{},[17,207,208],{},"用户定义"," — 你的标签页顺序，分组可见",[29,211,212,215,216,215,219,222,223,226,227],{},[17,213,214],{},"名称","、",[17,217,218],{},"添加时间",[17,220,221],{},"播放时长"," 或 ",[17,224,225],{},"文件大小"," — 扁平排序列表；这些模式下 ",[17,228,229],{},"分组会隐藏",[13,231,232],{},"按时长排序时，首次可能会预热时长元数据。",[22,234,235],{"id":235},"重新排序",[13,237,121,238,241,242,245,246,248],{},[17,239,240],{},"设置 → 行为"," 中打开拖放（",[17,243,244],{},"允许重新排序","）。然后拖动音效和分组到目标位置。重新排序在 ",[17,247,208],{}," 排序下生效。",[22,250,251],{"id":251},"多选",[13,253,254,255,257],{},"在导航栏打开 ",[17,256,251],{},"，然后：",[26,259,260,263,269,275],{},[29,261,262],{},"单击切换音效",[29,264,265,268],{},[17,266,267],{},"Shift+单击"," 从上次锚点选范围",[29,270,271,272],{},"在音板空白处拖出 ",[17,273,274],{},"框选",[29,276,277],{},"单击空白（或外部）清除选择",[13,279,280,281,215,284,215,287,290,291,86],{},"批量栏会显示数量，以及 ",[17,282,283],{},"颜色",[17,285,286],{},"移动到标签页…",[17,288,289],{},"删除"," 和 ",[17,292,293],{},"完成",[13,295,296,297,300],{},"多选时，每个按钮显示 ",[17,298,299],{},"8 位 ID 芯片","。右键芯片即可复制。",[22,302,303],{"id":303},"单音效音量",[13,305,306,307,310,311,314],{},"右键 → ",[17,308,309],{},"音量","。将滑块从 0% 拖到 100%。",[17,312,313],{},"双击"," 重置为 100%。",[13,316,317],{},"会与设置中的主输出音量叠加。",[22,319,321],{"id":320},"快捷键和音效-id","快捷键和音效 ID",[13,323,324,325,328],{},"每个音效都有 8 位 ID。从按钮上下文菜单（",[17,326,327],{},"复制 ID","）或多选 ID 芯片复制。",[13,330,331,332,335,336,339],{},"打开 ",[17,333,334],{},"设置 → 快捷键","，将按键绑定到音效 ID。全局快捷键可选。上下文菜单的 ",[17,337,338],{},"分配快捷键"," 会跳转过去并预填 ID。",[13,341,342,347],{},[343,344,346],"a",{"href":345},"\u002Fdocs\u002Fremote-control","Bitfocus Companion"," 用同一个 ID 触发片段。",[22,349,350],{"id":350},"背景图和颜色",[13,352,353,354,358],{},"右键音效可设置单按钮颜色或背景图。这与为整块音板设置样式的 ",[343,355,357],{"href":356},"\u002Fdocs\u002Ftheme-editor","Theme Creator"," 是分开的。",[13,360,361,362,365],{},"选择器是 ",[17,363,364],{},"背景图"," 对话框（PNG、JPEG、GIF、WebP）：",[26,367,368,374],{},[29,369,370,373],{},[17,371,372],{},"本地文件"," — 添加文件夹、选单个文件、按文件名搜索、网格预览，或从库中移除文件夹",[29,375,376,379,380,382],{},[17,377,378],{},"KLIPY"," — 在线搜索 GIF。在 ",[17,381,240],{}," 中填入自己的 API 密钥。密钥不会存进项目文件。",[13,384,385],{},"选图后，可在按钮上平移和裁剪。",{"title":387,"searchDepth":388,"depth":388,"links":389},"",2,[390,391,392,398,399,400,401,402,403],{"id":24,"depth":388,"text":24},{"id":62,"depth":388,"text":62},{"id":95,"depth":388,"text":96,"children":393},[394,396,397],{"id":110,"depth":395,"text":110},3,{"id":145,"depth":395,"text":145},{"id":154,"depth":395,"text":154},{"id":198,"depth":388,"text":198},{"id":235,"depth":388,"text":235},{"id":251,"depth":388,"text":251},{"id":303,"depth":388,"text":303},{"id":320,"depth":388,"text":321},{"id":350,"depth":388,"text":350},"标签、筛选、标签页、分组、排序、多选、音量和快捷键。","md",{},true,4,"\u002Forganizing-sounds",{"title":5,"description":404},"organizing-sounds","3-vWJzQztTr0V-48i1q6x6RdCgOiL2mLWZH8ANBuuDc",[414,537,754,891,1141,1272,1412,1633],{"id":415,"title":416,"body":417,"description":530,"extension":405,"meta":531,"navigation":407,"order":532,"path":533,"seo":534,"stem":535,"__hash__":536},"content_zh\u002Foverview.md","概览",{"type":7,"value":418,"toc":524},[419,421,424,427,430,433,447,450,488,491,501,504],[10,420,416],{"id":416},[13,422,423],{},"SoundNinja 是面向直播、好友聊天和播客录制的开源音效板。基于 Tauri v2 和 Nuxt 4 构建，内存和磁盘占用都很轻。",[13,425,426],{},"目标很简单：让庞大的音效库易于浏览，并在毫秒内播放正确的片段。界面也适合作为 VR 仪表盘使用。",[13,428,429],{},"SoundNinja 仍处于早期开发。功能可用，但并非每个平台都经过完整测试。",[22,431,432],{"id":432},"适合谁",[26,434,435,438,441,444],{},[29,436,437],{},"需要即时音效提示的主播",[29,439,440],{},"想在语音聊天中共用一块音板的朋友",[29,442,443],{}