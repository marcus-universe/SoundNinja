,673,676,677,679],{},"标签可跨标签页使用。滑出的 ",[254,674,675],{},"筛选"," 面板（侧边栏 ",[254,678,675],{},"）用来创建标签并筛选音板。",[681,682,683],"h3",{"id":683},"创建和编辑标签",[103,685,686,691,702,708],{},[30,687,688,689,406],{},"打开侧边栏的 ",[254,690,675],{},[30,692,693,694,697,698,701],{},"在 ",[254,695,696],{},"标签"," 下用 ",[254,699,700],{},"添加标签"," — 填写名称和颜色。",[30,703,704,705,406],{},"在同一列表中重命名、改色或 ",[254,706,707],{},"删除标签",[30,709,710,711,714],{},"若显示 ",[254,712,713],{},"还没有标签","，先在这里添加再分配。",[681,716,717],{"id":717},"给音效打标签",[13,719,720,721,723],{},"右键音效 → ",[254,722,696],{},"（复选框）。一个音效可以有多个标签。若还没有标签，菜单会指向筛选面板。",[681,725,726],{"id":726},"筛选音板",[27,728,729,736,747,758],{},[30,730,731,732,735],{},"在筛选面板或 ",[254,733,734],{},"搜索栏下方的芯片"," 中切换标签。",[30,737,738,739,742,743,746],{},"匹配为 ",[254,740,741],{},"OR","：音效带有 ",[254,744,745],{},"任一"," 已选标签就会显示。",[30,748,749,750,753,754,757],{},"导航栏 ",[254,751,752],{},"搜索"," 与当前标签筛选做 ",[254,755,756],{},"AND","（输入 + 标签一起）。",[30,759,760],{},"关掉芯片（或清空筛选）即可再看到整个标签页。",[13,762,763,764,767],{},"按钮上可显示彩色标签名。在 ",[254,765,766],{},"设置 → 行为 → 显示标签徽章"," 中开关。",[23,769,770],{"id":770},"排序",[13,772,773],{},"打开筛选面板并选择排序方式：",[27,775,776,782],{},[30,777,778,781],{},[254,779,780],{},"用户定义"," — 你的标签页顺序，分组可见",[30,783,784,328,787,328,790,257,793,796,797],{},[254,785,786],{},"名称",[254,788,789],{},"添加时间",[254,791,792],{},"播放时长",[254,794,795],{},"文件大小"," — 扁平排序列表；这些模式下 ",[254,798,799],{},"分组会隐藏",[13,801,802],{},"按时长排序时，首次可能会预热时长元数据。",[23,804,805],{"id":805},"重新排序",[13,807,693,808,811,812,815,816,818],{},[254,809,810],{},"设置 → 行为"," 中打开拖放（",[254,813,814],{},"允许重新排序","）。然后拖动音效和分组到目标位置。重新排序在 ",[254,817,780],{}," 排序下生效。",[23,820,821],{"id":821},"多选",[13,823,824,825,360],{},"在导航栏打开 ",[254,826,821],{},[27,828,829,832,838,844],{},[30,830,831],{},"单击切换音效",[30,833,834,837],{},[254,835,836],{},"Shift+单击"," 从上次锚点选范围",[30,839,840,841],{},"在音板空白处拖出 ",[254,842,843],{},"框选",[30,845,846],{},"单击空白（或外部）清除选择",[13,848,849,850,328,853,328,856,859,860,406],{},"批量栏会显示数量，以及 ",[254,851,852],{},"颜色",[254,854,855],{},"移