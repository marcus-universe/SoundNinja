[{"data":1,"prerenderedAt":1279},["ShallowReactive",2],{"docs-page-zh-\u002Foverview":3,"docs-nav-zh":131},{"id":4,"title":5,"body":6,"description":122,"extension":123,"meta":124,"navigation":125,"order":126,"path":127,"seo":128,"stem":129,"__hash__":130},"content_zh\u002Foverview.md","概览",{"type":7,"value":8,"toc":114},"minimark",[9,12,16,19,22,26,42,45,77,80,90,93],[10,11,5],"h1",{"id":5},[13,14,15],"p",{},"SoundNinja 是面向直播、好友聊天和播客录制的开源音效板。基于 Tauri v2 和 Nuxt 4 构建，内存和磁盘占用都很轻。",[13,17,18],{},"目标很简单：让庞大的音效库易于浏览，并在毫秒内播放正确的片段。界面也适合作为 VR 仪表盘使用。",[13,20,21],{},"SoundNinja 仍处于早期开发。功能可用，但并非每个平台都经过完整测试。",[23,24,25],"h2",{"id":25},"适合谁",[27,28,29,33,36,39],"ul",{},[30,31,32],"li",{},"需要即时音效提示的主播",[30,34,35],{},"想在语音聊天中共用一块音板的朋友",[30,37,38],{},"录片段并放到音板上的播客作者",[30,40,41],{},"想要可定制、本地优先音效板的任何人",[23,43,44],{"id":44},"你能做什么",[27,46,47,50,53,56,59,62,71,74],{},[30,48,49],{},"用自己的音频文件搭建音效板",[30,51,52],{},"用彩色标签页、分组和搜索整理音效",[30,54,55],{},"用 Theme Creator 设计外观",[30,57,58],{},"在 Record Editor 中录制电脑音频或麦克风",[30,60,61],{},"为单个音效分配快捷键",[30,63,64,65,70],{},"通过 ",[66,67,69],"a",{"href":68},"\u002Fdocs\u002Fremote-control","Bitfocus Companion"," 触发音效",[30,72,73],{},"导入导出完整音效板以便分享",[30,75,76],{},"在音效按钮上使用 GIF 或图片",[23,78,79],{"id":79},"许可证",[13,81,82,83,89],{},"SoundNinja 是采用 ",[66,84,88],{"href":85,"rel":86},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fblob\u002Fmain\u002FLICENSE",[87],"nofollow","GPL-3.0"," 的自由软件。可以 fork、修改、分享。",[23,91,92],{"id":92},"下一步",[94,95,96,102,108],"ol",{},[30,97,98],{},[66,99,101],{"href":100},"\u002Fdocs\u002Finstallation","安装 SoundNinja",[30,103,104],{},[66,105,107],{"href":106},"\u002Fdocs\u002Fadding-sounds","添加音效",[30,109,110],{},[66,111,113],{"href":112},"\u002Fdocs\u002Forganizing-sounds","整理你的音板",{"title":115,"searchDepth":116,"depth":116,"links":117},"",2,[118,119,120,121],{"id":25,"depth":116,"text":25},{"id":44,"depth":116,"text":44},{"id":79,"depth":116,"text":79},{"id":92,"depth":116,"text":92},"SoundNinja 是什么，以及你能用它做什么。","