[{"data":1,"prerenderedAt":1560},["ShallowReactive",2],{"docs-page-zh-\u002Foverview":3,"docs-nav-zh":140},{"id":4,"title":5,"body":6,"description":131,"extension":132,"meta":133,"navigation":134,"order":135,"path":136,"seo":137,"stem":138,"__hash__":139},"content_zh\u002Foverview.md","概览",{"type":7,"value":8,"toc":123},"minimark",[9,12,16,19,22,26,42,45,86,89,99,102],[10,11,5],"h1",{"id":5},[13,14,15],"p",{},"SoundNinja 是面向直播、好友聊天和播客录制的开源音效板。基于 Tauri v2 和 Nuxt 4 构建，内存和磁盘占用都很轻。",[13,17,18],{},"目标很简单：让庞大的音效库易于浏览，并在毫秒内播放正确的片段。界面也适合作为 VR 仪表盘使用。",[13,20,21],{},"SoundNinja 仍处于早期开发。功能可用，但并非每个平台都经过完整测试。",[23,24,25],"h2",{"id":25},"适合谁",[27,28,29,33,36,39],"ul",{},[30,31,32],"li",{},"需要即时音效提示的主播",[30,34,35],{},"想在语音聊天中共用一块音板的朋友",[30,37,38],{},"录片段并放到音板上的播客作者",[30,40,41],{},"想要可定制、本地优先音效板的任何人",[23,43,44],{"id":44},"你能做什么",[27,46,47,50,53,56,59,62,65,68,71,80,83],{},[30,48,49],{},"用自己的音频文件搭建音效板",[30,51,52],{},"用彩色标签页、分组、标签和搜索整理音效",[30,54,55],{},"按标签筛选（OR），并按名称、日期、时长或大小排序",[30,57,58],{},"用框选或 Shift 范围多选，然后批量改色、移动或删除",[30,60,61],{},"在上下文菜单中设置单音效音量",[30,63,64],{},"用 Theme Creator 设计外观",[30,66,67],{},"在 Record Editor 中录制电脑音频或麦克风",[30,69,70],{},"为单个音效分配快捷键",[30,72,73,74,79],{},"通过 ",[75,76,78],"a",{"href":77},"\u002Fdocs\u002Fremote-control","Bitfocus Companion"," 触发音效",[30,81,82],{},"导入导出完整音效板以便分享",[30,84,85],{},"在音效按钮上使用 GIF 或图片 — 本地文件夹库或 KLIPY",[23,87,88],{"id":88},"许可证",[13,90,91,92,98],{},"SoundNinja 是采用 ",[75,93,97],{"href":94,"rel":95},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fblob\u002Fmain\u002FLICENSE",[96],"nofollow","GPL-3.0"," 的自由软件。可以 fork、修改、分享。",[23,100,101],{"id":101},"下一步",[103,104,105,111,117],"ol",{},[30,106,107],{},[75,108,110],{"href":109},"\u002Fdocs\u002Finstallation","安装 SoundNinja",[30,112,113],{},[75,114,116],{"href":115},"\u002Fdocs\u002Fadding-sounds","添加音效",[30,118,119],{},[75,120,122],{"href":121},"\u002Fdocs\u002Forganizing-sounds","整理你的音板",{"title":124,"searchDepth":125,"depth":125,"links":126},"",2,[127,128,129,130],{