287,288],{},"用框选或 Shift 范围多选，然后批量改色、移动或删除",[38,290,291],{},"在上下文菜单中设置单音效音量",[38,293,294],{},"用 Theme Creator 设计外观",[38,296,297],{},"在 Record Editor 中录制电脑音频或麦克风",[38,299,300],{},"为单个音效分配快捷键",[38,302,303,304,308],{},"通过 ",[17,305,307],{"href":306},"\u002Fdocs\u002Fremote-control","Bitfocus Companion"," 触发音效",[38,310,311],{},"导入导出完整音效板以便分享",[38,313,314],{},"在音效按钮上使用 GIF 或图片 — 本地文件夹库或 KLIPY",[30,316,317],{"id":317},"许可证",[13,319,320,321,326],{},"SoundNinja 是采用 ",[17,322,325],{"href":323,"rel":324},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fblob\u002Fmain\u002FLICENSE",[26],"GPL-3.0"," 的自由软件。可以 fork、修改、分享。",[30,328,329],{"id":329},"下一步",[331,332,333,339,345],"ol",{},[38,334,335],{},[17,336,338],{"href":337},"\u002Fdocs\u002Finstallation","安装 SoundNinja",[38,340,341],{},[17,342,344],{"href":343},"\u002Fdocs\u002Fadding-sounds","添加音效",[38,346,347],{},[17,348,350],{"href":349},"\u002Fdocs\u002Forganizing-sounds","整理你的音板",{"title":155,"searchDepth":173,"depth":173,"links":352},[353,354,355,356],{"id":257,"depth":173,"text":257},{"id":274,"depth":173,"text":274},{"id":317,"depth":173,"text":317},{"id":329,"depth":173,"text":329},"SoundNinja 是什么，以及你能用它做什么。",{},"\u002Foverview",{"title":241,"description":357},"overview","r8dygjH6Yh-cCEFH6gGLl4SD0gk-ufDMKPy2LalB7f8",{"id":4,"title":5,"body":364,"description":230,"extension":231,"meta":496,"navigation":233,"order":173,"path":234,"seo":497,"stem":236,"__hash__":237},{"type":7,"value":365,"toc":489},[366,368,375,377,391,393,395,405,407,409,425,431,433,437,439,447,465,475,487],[10,367,5],{"id":5},[13,369,15,370,21,372,28],{},[17,371,20],{"href":19},[17,373,27],{"href":24,"rel":374},[26],[30,376,33],{"id":32},[35,378,379,385,387,389],{},[38,380,40,381,45,383],{},[42,382,44],{},[42,384,48],{},[38,386,51],{},[38,388,54],{},[38,390,57],{},[13,392,60],{},[30,394,64],{"id":63},[35,396,397,401,403],{},[38,398,69,399],{},[42,400,72],{},[38,402,75],{},[38,404,78],{},[13,406,81],{},[30,408,85],{"id":84},[35,410,41