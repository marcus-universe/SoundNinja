[{"data":1,"prerenderedAt":1658},["ShallowReactive",2],{"docs-page-es-\u002Finstallation":3,"docs-nav-es":242},{"id":4,"title":5,"body":6,"description":234,"extension":235,"meta":236,"navigation":237,"order":177,"path":238,"seo":239,"stem":240,"__hash__":241},"content_es\u002Finstallation.md","Instalación",{"type":7,"value":8,"toc":227},"minimark",[9,13,30,35,59,62,66,80,83,87,112,123,127,134,138,153,186,202,223],[10,11,5],"h1",{"id":12},"instalación",[14,15,16,17,22,23,29],"p",{},"Consigue una build en la ",[18,19,21],"a",{"href":20},"\u002Fdownload","página de descarga"," o en ",[18,24,28],{"href":25,"rel":26},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Freleases\u002Flatest",[27],"nofollow","GitHub Releases",". SoundNinja está en desarrollo temprano, así que trata las builds como beta.",[31,32,34],"h2",{"id":33},"windows","Windows",[36,37,38,50,53,56],"ul",{},[39,40,41,45,46,49],"li",{},[42,43,44],"strong",{},"Instalador (.exe)"," o ",[42,47,48],{},"MSI (.msi)"," para Windows de 64 bits",[39,51,52],{},"Objetivo de la landing: Windows 10 y posterior",[39,54,55],{},"El README de la app también lista Windows 8 y superior",[39,57,58],{},"El instalador NSIS usa tema oscuro. Elige idioma en el setup — SoundNinja lo recuerda en el siguiente arranque.",[14,60,61],{},"Ejecuta el instalador y luego abre SoundNinja desde el menú Inicio.",[31,63,65],{"id":64},"macos","macOS",[36,67,68,74,77],{},[39,69,70,73],{},[42,71,72],{},".dmg universal"," para Apple Silicon e Intel",[39,75,76],{},"Objetivo de la landing: macOS 10.14 y posterior",[39,78,79],{},"El README de la app lista macOS 10.15 y superior",[14,81,82],{},"Abre la imagen de disco y arrastra SoundNinja a Aplicaciones.",[31,84,86],{"id":85},"linux","Linux",[36,88,89,95,101,109],{},[39,90,91,94],{},[42,92,93],{},"Debian (.deb)"," para Ubuntu \u002F Debian",[39,96,97,100],{},[42,98,99],{},"AppImage"," para otras distros",[39,102,103,104,108],{},"Tras publicar una release, los usuarios de Arch pueden instalar ",[105,106,107],"code",{},"soundninja-bin"," desde el AUR",[39,110,111],{},"Probado en Ubuntu 20.04",[14,113,114,115,118,119,122],{},"Las builds de escritorio necesitan paquetes WebKit y GTK. En Debian\u002FUbuntu eso suele ser ",[105,116,117],{},"libwebkit2gtk",", ",[105,120,121],{},"libgtk-3-0"," y una biblioteca app-indicator.",[31,124,126],{"id":125},"actualizaciones","Actualizaciones",[14,128,129,130,133],{},"En la app, abre ",[42,131,132],{},"Ayuda → Buscar actualizaciones",". También puedes dejar que SoundNinja compruebe al arrancar en Ajustes.",[31,135,137],{"id":136},"compilar-desde-el-código","Compilar desde el código",[14,139,140,141,146,147,152],{},"¿Necesitas una build personalizada? Clona ",[18,142,145],{"href":143,"rel":144},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja",[27],"el repo",", instala los ",[18,148,151],{"href":149,"rel":150},"https:\u002F\u002Fv2.tauri.app\u002Fstart\u002Fprerequisites\u002F",[27],"requisitos de Tauri"," y luego:",[154,155,160],"pre",{"className":156,"code":157,"language":158,"meta":159,"style":159},"language-bash shiki shiki-themes github-light github-dark","bun install\nbun run tauri:serve\n","bash","",[105,161,162,175],{"__ignoreMap":159},[163,164,167,171],"span",{"class":165,"line":166},"line",1,[163,168,170],{"class":169},"sScJk","bun",[163,172,174],{"class":173},"sZZnC"," install\n",[163,176,178,180,183],{"class":165,"line":177},2,[163,179,170],{"class":169},[163,181,182],{"class":173}," run",[163,184,185],{"class":173}," tauri:serve\n",[14,187,188,118,191,45,194,197,198,201],{},[105,189,190],{},"npm",[105,192,193],{},"pnpm",[105,195,196],{},"deno"," también sirven. Build de producción: ",[105,199,200],{},"bun run tauri:build",".",[14,203,204,207,208,213,214,217,218,201],{},[42,205,206],{},"Solo Windows:"," cada compile de Windows incluye ASIO con el ",[18,209,212],{"href":210,"rel":211},"https:\u002F\u002Fwww.steinberg.net\u002Fasiosdk",[27],"Steinberg ASIO SDK",". Ejecuta ",[105,215,216],{},"bun run setup:asio"," una vez (el SDK no está en git). Linux y macOS usan PipeWire \u002F Core Audio — omite ese paso. Detalles: ",[18,219,222],{"href":220,"rel":221},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fblob\u002Fmain\u002Fdocs\u002Fbuild-from-source.md",[27],"build-from-source.md",[224,225,226],"style",{},"html pre.shiki code .sScJk, html code.shiki .sScJk{--shiki-default:#6F42C1;--shiki-dark:#B392F0}html pre.shiki code .sZZnC, html code.shiki .sZZnC{--shiki-default:#032F62;--shiki-dark:#9ECBFF}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html.dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}",{"title":159,"searchDepth":177,"depth":177,"links":228},[229,230,231,232,233],{"id":33,"depth":177,"text":34},{"id":64,"depth":177,"text":65},{"id":85,"depth":177,"text":86},{"id":125,"depth":177,"text":126},{"id":136,"depth":177,"text":137},"Instala SoundNinja en Windows, macOS o Linux.","md",{},true,"\u002Finstallation",{"title":5,"description":234},"installation","6QKa3OcTs0sq8JVvjceX-ugwL8mdPc4h6O-JOoo1Qd8",[243,371,506,654,1057,1192,1338,1560],{"id":244,"title":245,"body":246,"description":365,"extension":235,"meta":366,"navigation":237,"order":166,"path":367,"seo":368,"stem":369,"__hash__":370},"content_es\u002Foverview.md","Resumen",{"type":7,"value":247,"toc":359},[248,251,254,257,260,264,278,282,321,325,334,338],[10,249,245],{"id":250},"resumen",[14,252,253],{},"SoundNinja es un soundboard de código abierto para streaming en directo, charlas con amigos y grabación de podcasts. Está construido con Tauri v2 y Nuxt 4 para que sea ligero en RAM y disco.",[14,255,256],{},"El objetivo es simple: mantener una biblioteca enorme fácil de recorrer y reproducir el clip correcto en milisegundos. La interfaz también funciona bien como panel en VR.",[14,258,259],{},"SoundNinja sigue en desarrollo temprano. Las funciones marchan, pero no todas las plataformas están del todo probadas.",[31,261,263],{"id":262},"para-quién","Para quién",[36,265,266,269,272,275],{},[39,267,268],{},"Streamers que necesitan cues de sonido al instante",[39,270,271],{},"Amigos que quieren un tablero compartido para el chat de voz",[39,273,274],{},"Podcasters que graban clips y los sueltan en un tablero",[39,276,277],{},"Quien quiera un soundboard personalizable y local-first",[31,279,281],{"id":280},"qué-puedes-hacer","Qué puedes hacer",[36,283,284,287,290,293,296,299,302,305,308,315,318],{},[39,285,286],{},"Montar un soundboard con tus propios archivos de audio",[39,288,289],{},"Organizar sonidos en pestañas de colores, grupos, etiquetas y búsqueda",[39,291,292],{},"Filtrar por etiquetas (OR) y ordenar por nombre, fecha, duración o tamaño",[39,294,295],{},"Selección múltiple con marco o rango Mayús, luego color, mover o borrar en lote",[39,297,298],{},"Ajustar el volumen por sonido desde el menú contextual",[39,300,301],{},"Diseñar el aspecto con el Theme Creator",[39,303,304],{},"Grabar audio del PC o un micrófono en el Record Editor",[39,306,307],{},"Asignar atajos a sonidos individuales",[39,309,310,311],{},"Disparar sonidos desde ",[18,312,314],{"href":313},"\u002Fdocs\u002Fremote-control","Bitfocus Companion",[39,316,317],{},"Importar y exportar un soundboard completo para compartirlo",[39,319,320],{},"Usar GIFs o imágenes en los botones — biblioteca local de carpetas o KLIPY",[31,322,324],{"id":323},"licencia","Licencia",[14,326,327,328,333],{},"SoundNinja es software libre bajo ",[18,329,332],{"href":330,"rel":331},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fblob\u002Fmain\u002FLICENSE",[27],"GPL-3.0",". Haz fork, cámbialo, compártelo.",[31,335,337],{"id":336},"siguientes-pasos","Siguientes pasos",[339,340,341,347,353],"ol",{},[39,342,343],{},[18,344,346],{"href":345},"\u002Fdocs\u002Finstallation","Instalar SoundNinja",[39,348,349],{},[18,350,352],{"href":351},"\u002Fdocs\u002Fadding-sounds","Añadir sonidos",[39,354,355],{},[18,356,358],{"href":357},"\u002Fdocs\u002Forganizing-sounds","Organizar tu tablero",{"title":159,"searchDepth":177,"depth":177,"links":360},[361,362,363,364],{"id":262,"depth":177,"text":263},{"id":280,"depth":177,"text":281},{"id":323,"depth":177,"text":324},{"id":336,"depth":177,"text":337},"Qué es SoundNinja y qué puedes hacer con él.",{},"\u002Foverview",{"title":245,"description":365},"overview","XWpBFvtyid6BLXO3HByHppTxfsOo0i7DlSOMew5tq2g",{"id":4,"title":5,"body":372,"description":234,"extension":235,"meta":504,"navigation":237,"order":177,"path":238,"seo":505,"stem":240,"__hash__":241},{"type":7,"value":373,"toc":497},[374,376,383,385,399,401,403,413,415,417,433,439,441,445,447,455,473,483,495],[10,375,5],{"id":12},[14,377,16,378,22,380,29],{},[18,379,21],{"href":20},[18,381,28],{"href":25,"rel":382},[27],[31,384,34],{"id":33},[36,386,387,393,395,397],{},[39,388,389,45,391,49],{},[42,390,44],{},[42,392,48],{},[39,394,52],{},[39,396,55],{},[39,398,58],{},[14,400,61],{},[31,402,65],{"id":64},[36,404,405,409,411],{},[39,406,407,73],{},[42,408,72],{},[39,410,76],{},[39,412,79],{},[14,414,82],{},[31,416,86],{"id":85},[36,418,419,423,427,431],{},[39,420,421,94],{},[42,422,93],{},[39,424,425,100],{},[42,426,99],{},[39,428,103,429,108],{},[105,430,107],{},[39,432,111],{},[14,434,114,435,118,437,122],{},[105,436,117],{},[105,438,121],{},[31,440,126],{"id":125},[14,442,129,443,133],{},[42,444,132],{},[31,446,137],{"id":136},[14,448,140,449,146,452,152],{},[18,450,145],{"href":143,"rel":451},[27],[18,453,151],{"href":149,"rel":454},[27],[154,456,457],{"className":156,"code":157,"language":158,"meta":159,"style":159},[105,458,459,465],{"__ignoreMap":159},[163,460,461,463],{"class":165,"line":166},[163,462,170],{"class":169},[163,464,174],{"class":173},[163,466,467,469,471],{"class":165,"line":177},[163,468,170],{"class":169},[163,470,182],{"class":173},[163,472,185],{"class":173},[14,474,475,118,477,45,479,197,481,201],{},[105,476,190],{},[105,478,193],{},[105,480,196],{},[105,482,200],{},[14,484,485,207,487,213,490,217,492,201],{},[42,486,206],{},[18,488,212],{"href":210,"rel":489},[27],[105,491,216],{},[18,493,222],{"href":220,"rel":494},[27],[224,496,226],{},{"title":159,"searchDepth":177,"depth":177,"links":498},[499,500,501,502,503],{"id":33,"depth":177,"text":34},{"id":64,"depth":177,"text":65},{"id":85,"depth":177,"text":86},{"id":125,"depth":177,"text":126},{"id":136,"depth":177,"text":137},{},{"title":5,"description":234},{"id":507,"title":352,"body":508,"description":647,"extension":235,"meta":648,"navigation":237,"order":649,"path":650,"seo":651,"stem":652,"__hash__":653},"content_es\u002Fadding-sounds.md",{"type":7,"value":509,"toc":639},[510,513,516,520,539,543,574,578,597,601,615,618,622,629,633],[10,511,352],{"id":512},"añadir-sonidos",[14,514,515],{},"Un tablero está vacío hasta que añades clips. SoundNinja puede importar archivos, carpetas enteras, una grabación o un pack de soundboard compartido.",[31,517,519],{"id":518},"importar-archivos-de-audio","Importar archivos de audio",[339,521,522,533,536],{},[39,523,524,525,528,529,532],{},"Abre ",[42,526,527],{},"Archivo → Importar archivos de audio",", o usa ",[42,530,531],{},"Importar"," en la barra de navegación.",[39,534,535],{},"Elige uno o más archivos de audio.",[39,537,538],{},"Los sonidos llegan a la pestaña actual.",[31,540,542],{"id":541},"importar-carpetas","Importar carpetas",[339,544,545,554,557],{},[39,546,524,547,550,551,553],{},[42,548,549],{},"Archivo → Importar carpetas"," (o ",[42,552,542],{}," en la barra de navegación).",[39,555,556],{},"Añade una o más carpetas. Arrastra para reordenarlas antes de importar.",[39,558,559,560],{},"Elige cómo llegan:\n",[36,561,562,568],{},[39,563,564,567],{},[42,565,566],{},"Importar como pestañas"," — cada carpeta se convierte en su propia pestaña",[39,569,570,573],{},[42,571,572],{},"Importar a la pestaña actual"," — cada archivo va a la pestaña activa",[31,575,577],{"id":576},"grabar-un-clip","Grabar un clip",[14,579,580,581,585,586,589,590,45,593,596],{},"Abre el ",[18,582,584],{"href":583},"\u002Fdocs\u002Frecording-editor","Record Editor"," desde el botón ",[42,587,588],{},"Grabar"," en la barra del reproductor. Captura, recorta y luego ",[42,591,592],{},"Importar selección",[42,594,595],{},"Importar todo"," en la pestaña actual o en una pestaña que elijas.",[31,598,600],{"id":599},"importar-un-soundboard","Importar un soundboard",[14,602,603,606,607,610,611,614],{},[42,604,605],{},"Archivo → Importar soundboard"," carga un pack compartido. Los packs son un ",[105,608,609],{},".zip"," que contiene ",[105,612,613],{},"project.sninja"," más los archivos de sonido. Tras importar, abre el proyecto y reproduce.",[14,616,617],{},"También puedes tener varios proyectos (perfiles). Usa el selector de proyecto para cambiar de tablero.",[31,619,621],{"id":620},"reenlazar-archivos-faltantes","Reenlazar archivos faltantes",[14,623,624,625,628],{},"Si los archivos de audio se mueven en el disco, SoundNinja muestra ",[42,626,627],{},"Archivos de sonido faltantes",". Elige una carpeta para buscar y reenlazar los clips.",[31,630,632],{"id":631},"siguiente","Siguiente",[14,634,635,636,201],{},"Organiza pestañas, etiquetas, filtros y atajos en ",[18,637,638],{"href":357},"Organizar sonidos",{"title":159,"searchDepth":177,"depth":177,"links":640},[641,642,643,644,645,646],{"id":518,"depth":177,"text":519},{"id":541,"depth":177,"text":542},{"id":576,"depth":177,"text":577},{"id":599,"depth":177,"text":600},{"id":620,"depth":177,"text":621},{"id":631,"depth":177,"text":632},"Importa audio, carpetas, grabaciones y soundboards compartidos.",{},3,"\u002Fadding-sounds",{"title":352,"description":647},"adding-sounds","O5nOJGNq2FL6jafUxqoGYNKJDVbb2UrZRjfKpK21LlQ",{"id":655,"title":638,"body":656,"description":1050,"extension":235,"meta":1051,"navigation":237,"order":1052,"path":1053,"seo":1054,"stem":1055,"__hash__":1056},"content_es\u002Forganizing-sounds.md",{"type":7,"value":657,"toc":1035},[658,661,668,672,699,706,710,713,727,734,740,744,754,759,791,795,801,805,838,844,848,851,877,880,884,897,901,907,928,944,951,955,966,969,973,980,990,996,1000,1008,1015,1032],[10,659,638],{"id":660},"organizar-sonidos",[14,662,663,664,667],{},"SoundNinja está hecho para bibliotecas grandes. ",[42,665,666],{},"Etiquetas y filtros",", pestañas, búsqueda, selección múltiple y atajos — el clip que necesitas está a un clic (o una tecla).",[31,669,671],{"id":670},"pestañas","Pestañas",[36,673,674,681,688],{},[39,675,676,677,680],{},"Añade una pestaña con ",[42,678,679],{},"Añadir pestaña",". Dale un color para escanear la barra rápido.",[39,682,683,684,687],{},"La vista ",[42,685,686],{},"Todos"," muestra cada sonido de todas las pestañas.",[39,689,690,691,694,695,698],{},"Un sonido puede pertenecer a ",[42,692,693],{},"una o más pestañas",". Clic derecho en un sonido y usa ",[42,696,697],{},"Mover a pestaña"," para asignarlo.",[14,700,701,702,705],{},"Las transiciones de pestaña están en ",[42,703,704],{},"Ajustes → General",": Slide, Fade, Botones uno a uno, o Ninguna.",[31,707,709],{"id":708},"grupos","Grupos",[14,711,712],{},"Desde la v0.5.3, los separadores pueden convertirse en grupos con nombre:",[36,714,715,718,721,724],{},[39,716,717],{},"Añadir, renombrar o quitar un grupo desde el menú contextual",[39,719,720],{},"Arrastra la cabecera del grupo — los hijos se mueven con ella",[39,722,723],{},"Suelta sonidos dentro o fuera de un grupo",[39,725,726],{},"Define color de borde, color del nombre y alineación de botones (o usa el valor por defecto de la pestaña)",[14,728,729,730,733],{},"Sigue pudiendo añadir un ",[42,731,732],{},"Separador"," simple si solo necesitas un corte visual.",[14,735,736,737,201],{},"Clic derecho en el espacio vacío del tablero para ",[42,738,739],{},"Añadir grupo",[31,741,743],{"id":742},"etiquetas-filtros","Etiquetas \u002F Filtros",[14,745,746,747,750,751,753],{},"Las etiquetas cruzan las pestañas. El panel ",[42,748,749],{},"Filtro"," (barra lateral ",[42,752,749],{},") es donde las creas y filtras el tablero.",[755,756,758],"h3",{"id":757},"crear-y-editar-etiquetas","Crear y editar etiquetas",[339,760,761,766,777,784],{},[39,762,524,763,765],{},[42,764,749],{}," en la barra lateral.",[39,767,768,769,772,773,776],{},"En ",[42,770,771],{},"Etiquetas",", usa ",[42,774,775],{},"Añadir etiqueta"," — nombre y color.",[39,778,779,780,783],{},"Renombra, recolorea o ",[42,781,782],{},"Eliminar etiqueta"," en la misma lista.",[39,785,786,787,790],{},"Si ves ",[42,788,789],{},"Aún no hay etiquetas",", crea una aquí antes de asignar.",[755,792,794],{"id":793},"asignar-etiquetas-a-sonidos","Asignar etiquetas a sonidos",[14,796,797,798,800],{},"Clic derecho en un sonido → ",[42,799,771],{}," (casillas). Un sonido puede tener varias. Si aún no hay ninguna, el menú te lleva al panel de filtro.",[755,802,804],{"id":803},"filtrar-el-tablero","Filtrar el tablero",[36,806,807,813,824,835],{},[39,808,809,810,201],{},"Activa etiquetas en el panel Filtro o como ",[42,811,812],{},"chips bajo la barra de búsqueda",[39,814,815,816,819,820,823],{},"La coincidencia es ",[42,817,818],{},"OR",": un sonido sigue visible si tiene ",[42,821,822],{},"cualquiera"," de las etiquetas seleccionadas.",[39,825,826,827,830,831,834],{},"El campo ",[42,828,829],{},"Buscar"," combina con ",[42,832,833],{},"AND"," el filtro de etiquetas activo (texto + etiquetas juntos).",[39,836,837],{},"Apaga los chips (o limpia el filtro) para ver de nuevo toda la pestaña.",[14,839,840,841,201],{},"Los nombres de etiqueta en color pueden aparecer en los botones. Actívalos en ",[42,842,843],{},"Ajustes → Comportamiento → Mostrar badges de etiquetas",[31,845,847],{"id":846},"orden","Orden",[14,849,850],{},"Abre el panel de filtro y elige un modo:",[36,852,853,859],{},[39,854,855,858],{},[42,856,857],{},"Definido por el usuario"," — tu orden de pestaña, grupos visibles",[39,860,861,118,864,118,867,45,870,873,874],{},[42,862,863],{},"Nombre",[42,865,866],{},"Fecha de añadido",[42,868,869],{},"Tiempo de reproducción",[42,871,872],{},"Tamaño de archivo"," — lista plana ordenada; ",[42,875,876],{},"los grupos se ocultan",[14,878,879],{},"Ordenar por duración puede precargar los metadatos de duración la primera vez.",[31,881,883],{"id":882},"reordenar","Reordenar",[14,885,886,887,890,891,894,895,201],{},"Activa arrastrar y soltar en ",[42,888,889],{},"Ajustes → Comportamiento"," (",[42,892,893],{},"Permitir reordenar","). Luego arrastra sonidos y grupos a su sitio. Reordenar aplica en el orden ",[42,896,857],{},[31,898,900],{"id":899},"selección-múltiple","Selección múltiple",[14,902,903,904,906],{},"Activa ",[42,905,900],{}," en la barra de navegación, luego:",[36,908,909,912,918,925],{},[39,910,911],{},"Clic para alternar un sonido",[39,913,914,917],{},[42,915,916],{},"Mayús+clic"," para un rango desde el último ancla",[39,919,920,921,924],{},"Arrastra un ",[42,922,923],{},"marco"," en el espacio vacío del tablero",[39,926,927],{},"Clic en el tablero vacío (o fuera) para limpiar la selección",[14,929,930,931,118,934,118,937,940,941,201],{},"Una barra masiva muestra el recuento, más ",[42,932,933],{},"Color",[42,935,936],{},"Mover a pestaña…",[42,938,939],{},"Eliminar"," y ",[42,942,943],{},"Hecho",[14,945,946,947,950],{},"En selección múltiple, cada botón muestra un ",[42,948,949],{},"chip de ID de 8 caracteres",". Clic derecho en el chip para copiarlo.",[31,952,954],{"id":953},"volumen-por-sonido","Volumen por sonido",[14,956,957,958,961,962,965],{},"Clic derecho → ",[42,959,960],{},"Volumen",". Arrastra el control de 0 % a 100 %. ",[42,963,964],{},"Doble clic"," lo restablece a 100 %.",[14,967,968],{},"Se acumula con el volumen de salida maestro en Ajustes.",[31,970,972],{"id":971},"atajos-e-ids-de-sonido","Atajos e IDs de sonido",[14,974,975,976,979],{},"Cada sonido tiene un ID de 8 caracteres. Cópialo desde el menú contextual del botón (",[42,977,978],{},"Copiar ID",") o el chip de ID de la selección múltiple.",[14,981,524,982,985,986,989],{},[42,983,984],{},"Ajustes → Atajos"," para vincular una tecla a un ID de sonido. Los atajos globales son opcionales. ",[42,987,988],{},"Asignar atajo"," en el menú contextual salta allí con el ID rellenado.",[14,991,992,993,995],{},"El mismo ID es el que ",[18,994,314],{"href":313}," usa para disparar un clip.",[31,997,999],{"id":998},"imágenes-de-fondo-y-colores","Imágenes de fondo y colores",[14,1001,1002,1003,1007],{},"Clic derecho en un sonido para definir colores por botón o una imagen de fondo. Eso es independiente del ",[18,1004,1006],{"href":1005},"\u002Fdocs\u002Ftheme-editor","Theme Creator",", que da estilo a todo el tablero.",[14,1009,1010,1011,1014],{},"El selector es un diálogo ",[42,1012,1013],{},"Imagen de fondo"," (PNG, JPEG, GIF, WebP):",[36,1016,1017,1023],{},[39,1018,1019,1022],{},[42,1020,1021],{},"Archivos locales"," — añade carpetas, elige un archivo, busca por nombre, previsualiza la cuadrícula o quita una carpeta de la biblioteca",[39,1024,1025,1028,1029,1031],{},[42,1026,1027],{},"KLIPY"," — busca GIFs en línea. Pon tu propia clave API en ",[42,1030,889],{},". La clave no se guarda en los archivos del proyecto.",[14,1033,1034],{},"Tras elegir, mueve y recorta la imagen en el botón.",{"title":159,"searchDepth":177,"depth":177,"links":1036},[1037,1038,1039,1044,1045,1046,1047,1048,1049],{"id":670,"depth":177,"text":671},{"id":708,"depth":177,"text":709},{"id":742,"depth":177,"text":743,"children":1040},[1041,1042,1043],{"id":757,"depth":649,"text":758},{"id":793,"depth":649,"text":794},{"id":803,"depth":649,"text":804},{"id":846,"depth":177,"text":847},{"id":882,"depth":177,"text":883},{"id":899,"depth":177,"text":900},{"id":953,"depth":177,"text":954},{"id":971,"depth":177,"text":972},{"id":998,"depth":177,"text":999},"Etiquetas, filtros, pestañas, grupos, orden, selección múltiple, volumen y atajos.",{},4,"\u002Forganizing-sounds",{"title":638,"description":1050},"organizing-sounds","0TCdzxC5d9uOHlnFnD2ygCuD63pFk5yy3tK0Xgbpa7M",{"id":1058,"title":1059,"body":1060,"description":1185,"extension":235,"meta":1186,"navigation":237,"order":1187,"path":1188,"seo":1189,"stem":1190,"__hash__":1191},"content_es\u002Ftheme-editor.md","Editor de temas",{"type":7,"value":1061,"toc":1179},[1062,1065,1071,1075,1102,1105,1109,1123,1127,1153,1156,1160,1165],[10,1063,1059],{"id":1064},"editor-de-temas",[14,1066,1067,1068,201],{},"El Theme Creator es el editor visual completo de tu tablero. Ábrelo desde ",[42,1069,1070],{},"Ajustes → General → Theme Creator",[31,1072,1074],{"id":1073},"tres-pestañas","Tres pestañas",[339,1076,1077,1091,1097],{},[39,1078,1079,1082,1083,1086,1087,1090],{},[42,1080,1081],{},"General"," — nombre del tema, colores compartidos y carga de fuentes (",[105,1084,1085],{},".ttf"," \u002F ",[105,1088,1089],{},".otf",")",[39,1092,1093,1096],{},[42,1094,1095],{},"Botones"," — colores, tipo, diseño y overlay GIF de los botones de sonido",[39,1098,1099,1101],{},[42,1100,671],{}," — colores, tipo y grosor de borde de la barra de pestañas",[14,1103,1104],{},"Una vista previa en vivo muestra pestañas y botones mientras editas.",[31,1106,1108],{"id":1107},"qué-puedes-cambiar","Qué puedes cambiar",[36,1110,1111,1114,1117,1120],{},[39,1112,1113],{},"Colores primario y de acento, fondos, colores de botones, colores de pestañas",[39,1115,1116],{},"Familia y tamaño de fuente de botones y pestañas",[39,1118,1119],{},"Ancho, radio, borde, huecos y padding de los botones",[39,1121,1122],{},"Opacidad del overlay GIF (normal y hover)",[31,1124,1126],{"id":1125},"guardar-y-compartir","Guardar y compartir",[36,1128,1129,1135,1141,1147],{},[39,1130,1131,1134],{},[42,1132,1133],{},"Exportar .css"," — escribe un archivo de tema para respaldar o enviar a un amigo",[39,1136,1137,1140],{},[42,1138,1139],{},"Añadir a temas"," — guarda el archivo en tu carpeta Themes y aplícalo",[39,1142,1143,1146],{},[42,1144,1145],{},"Importar .css"," — carga un preset integrado o un tema guardado",[39,1148,1149,1152],{},[42,1150,1151],{},"Restablecer"," — vuelve a los valores por defecto de SoundNinja",[14,1154,1155],{},"Si cierras la ventana con cambios sin guardar, SoundNinja te pide que guardes primero.",[31,1157,1159],{"id":1158},"sin-el-editor-completo","Sin el editor completo",[14,1161,768,1162,1164],{},[42,1163,704],{}," aún puedes:",[36,1166,1167,1170,1176],{},[39,1168,1169],{},"Elegir un tema de la lista",[39,1171,1172,1173,1090],{},"Editar variables CSS en vivo (",[42,1174,1175],{},"CSS personalizado",[39,1177,1178],{},"Importar un archivo de tema a la carpeta Themes",{"title":159,"searchDepth":177,"depth":177,"links":1180},[1181,1182,1183,1184],{"id":1073,"depth":177,"text":1074},{"id":1107,"depth":177,"text":1108},{"id":1125,"depth":177,"text":1126},{"id":1158,"depth":177,"text":1159},"Diseña colores, fuentes, botones y pestañas en el Theme Creator.",{},5,"\u002Ftheme-editor",{"title":1059,"description":1185},"theme-editor","bPcJP7OLtBsnNMYJ-S1J6DmB6nngULo1_Q1hBJMNZAQ",{"id":1193,"title":1194,"body":1195,"description":1331,"extension":235,"meta":1332,"navigation":237,"order":1333,"path":1334,"seo":1335,"stem":1336,"__hash__":1337},"content_es\u002Frecording-editor.md","Editor de grabación",{"type":7,"value":1196,"toc":1325},[1197,1200,1206,1210,1216,1236,1239,1243,1268,1272,1286,1290,1304,1315],[10,1198,1194],{"id":1199},"editor-de-grabación",[14,1201,1202,1203,1205],{},"Graba un clip dentro de SoundNinja, recórtalo e impórtalo a una pestaña. Abre el editor con el botón ",[42,1204,588],{}," en la barra del reproductor.",[31,1207,1209],{"id":1208},"elegir-una-entrada","Elegir una entrada",[14,1211,768,1212,1215],{},[42,1213,1214],{},"Ajustes → Audio",":",[36,1217,1218,1224,1230],{},[39,1219,1220,1223],{},[42,1221,1222],{},"Dispositivos de entrada"," — micrófono",[39,1225,1226,1229],{},[42,1227,1228],{},"Dispositivos de salida (audio del PC)"," — loopback de lo que reproduce el PC",[39,1231,1232,1235],{},[42,1233,1234],{},"Volumen de entrada"," — ganancia de captura del 0 % al 200 %",[14,1237,1238],{},"El botón Grabar usa el dispositivo que eliges aquí.",[31,1240,1242],{"id":1241},"editar-la-toma","Editar la toma",[36,1244,1245,1248,1251,1259,1262,1265],{},[39,1246,1247],{},"Grabar y detener",[39,1249,1250],{},"Observar el medidor de nivel de entrada",[39,1252,1253,45,1256],{},[42,1254,1255],{},"Normalizar",[42,1257,1258],{},"Cancelación de ruido",[39,1260,1261],{},"Recortar todo el clip, recortar a una selección o borrar una selección",[39,1263,1264],{},"Deshacer \u002F rehacer",[39,1266,1267],{},"Acercar y alejar",[31,1269,1271],{"id":1270},"preparar-e-importar","Preparar e importar",[339,1273,1274,1277,1280],{},[39,1275,1276],{},"Añade la selección o la pista completa a la lista de staging.",[39,1278,1279],{},"La lista empieza vacía: graba, edita y luego añade un clip.",[39,1281,1282,45,1284,596],{},[42,1283,592],{},[42,1285,595],{},[31,1287,1289],{"id":1288},"separación-de-stems-opcional","Separación de stems (opcional)",[14,1291,1292,1293,1296,1297,45,1300,1303],{},"Las builds oficiales de Windows, macOS y Linux incluyen la función ",[42,1294,1295],{},"stems",". El Record Editor puede conservar ",[42,1298,1299],{},"voces",[42,1301,1302],{},"música"," con BS-RoFormer.",[14,1305,1306,1307,1310,1311,1314],{},"El modelo pesa unos 158 MB y ",[42,1308,1309],{},"no"," viene en el instalador. Descárgalo desde ",[42,1312,1313],{},"Ajustes → Separación de stems",", o acepta el aviso del primer arranque. El instalador de Windows también puede ofrecer descargar el modelo al primer inicio.",[14,1316,1317,1318,1086,1321,1324],{},"Las builds personalizadas desde código necesitan un flag extra (",[105,1319,1320],{},"tauri:serve:stems",[105,1322,1323],{},"tauri:build:stems",").",{"title":159,"searchDepth":177,"depth":177,"links":1326},[1327,1328,1329,1330],{"id":1208,"depth":177,"text":1209},{"id":1241,"depth":177,"text":1242},{"id":1270,"depth":177,"text":1271},{"id":1288,"depth":177,"text":1289},"Captura micrófono o audio del PC, edita el clip y suéltalo en tu tablero.",{},6,"\u002Frecording-editor",{"title":1194,"description":1331},"recording-editor","89aDSCp7hE8To2TNFwdWaImQVsHH2-xNcOyltCPP5IY",{"id":1339,"title":1340,"body":1341,"description":1553,"extension":235,"meta":1554,"navigation":237,"order":1555,"path":1556,"seo":1557,"stem":1558,"__hash__":1559},"content_es\u002Fremote-control.md","Control remoto",{"type":7,"value":1342,"toc":1546},[1343,1346,1349,1353,1382,1385,1388,1423,1427,1447,1450,1454,1486,1490,1496],[10,1344,1340],{"id":1345},"control-remoto",[14,1347,1348],{},"SoundNinja puede escuchar en tu red local para que Bitfocus Companion (o cualquier cliente HTTP\u002FWebSocket) reproduzca y detenga sonidos.",[31,1350,1352],{"id":1351},"activar-el-servidor-remoto","Activar el servidor remoto",[339,1354,1355,1360,1366,1372],{},[39,1356,524,1357,201],{},[42,1358,1359],{},"Ajustes → Remoto",[39,1361,1362,1363,201],{},"Activa el servidor remoto. El puerto por defecto es ",[42,1364,1365],{},"7331",[39,1367,1368,1369,201],{},"Opcional: define un token. Los clientes deben enviarlo como Bearer token o ",[105,1370,1371],{},"?token=",[39,1373,1374,1375,1378,1379,201],{},"Copia la URL ",[105,1376,1377],{},"http:\u002F\u002FIP:PORT",", o copia la IP del sistema desde ",[42,1380,1381],{},"Ajustes → Acerca de",[14,1383,1384],{},"Windows puede mostrar un aviso del firewall la primera vez que arranca el servidor. Permite el acceso a la red privada.",[31,1386,314],{"id":1387},"bitfocus-companion",[339,1389,1390,1397,1406,1416],{},[39,1391,1392,1393,201],{},"Instala ",[18,1394,314],{"href":1395,"rel":1396},"https:\u002F\u002Fbitfocus.io\u002Fcompanion",[27],[39,1398,1399,1400,1405],{},"Descarga ",[18,1401,1404],{"href":1402,"rel":1403},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002Fcompanion-module-soundninja\u002Freleases\u002Flatest",[27],"SoundNinja-Companion.tgz",". Aún no hay paquete en Companion Store.",[39,1407,1408,1409,1412,1413,201],{},"En Companion: ",[42,1410,1411],{},"Modules → Load module package"," y elige el ",[105,1414,1415],{},".tgz",[39,1417,1418,1419,1422],{},"Añade una conexión ",[42,1420,1421],{},"Sound Ninja",". Pega la IP del PC, el puerto y el token si definiste uno.",[31,1424,1426],{"id":1425},"acciones","Acciones",[36,1428,1429,1435,1441],{},[39,1430,1431,1434],{},[42,1432,1433],{},"Trigger Sound"," — elige en el menú desplegable en vivo, o escribe un ID de sonido de 8 caracteres (las variables de Companion funcionan)",[39,1436,1437,1440],{},[42,1438,1439],{},"Stop Sound"," — detiene un sonido en reproducción por ID",[39,1442,1443,1446],{},[42,1444,1445],{},"Stop All"," — detiene todos los sonidos en reproducción",[14,1448,1449],{},"Copia un ID de sonido en SoundNinja desde el menú contextual del botón o el chip de ID de la selección múltiple.",[31,1451,1453],{"id":1452},"feedbacks-y-variables","Feedbacks y variables",[36,1455,1456,1462,1474,1480],{},[39,1457,1458,1461],{},[42,1459,1460],{},"Sound Playing"," — verdadero mientras ese ID de sonido está activo (úsalo para el color del botón)",[39,1463,1464,1467,1468,1086,1471],{},[105,1465,1466],{},"$(soundninja:connected)"," — ",[105,1469,1470],{},"true",[105,1472,1473],{},"false",[39,1475,1476,1479],{},[105,1477,1478],{},"$(soundninja:playing_count)"," — 