[{"data":1,"prerenderedAt":1361},["ShallowReactive",2],{"docs-page-es-\u002Finstallation":3,"docs-nav-es":218},{"id":4,"title":5,"body":6,"description":210,"extension":211,"meta":212,"navigation":213,"order":174,"path":214,"seo":215,"stem":216,"__hash__":217},"content_es\u002Finstallation.md","Instalación",{"type":7,"value":8,"toc":203},"minimark",[9,13,30,35,56,59,63,77,80,84,109,120,124,131,135,150,183,199],[10,11,5],"h1",{"id":12},"instalación",[14,15,16,17,22,23,29],"p",{},"Consigue una build en la ",[18,19,21],"a",{"href":20},"\u002Fdownload","página de descarga"," o en ",[18,24,28],{"href":25,"rel":26},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Freleases\u002Flatest",[27],"nofollow","GitHub Releases",". SoundNinja está en desarrollo temprano, así que trata las builds como beta.",[31,32,34],"h2",{"id":33},"windows","Windows",[36,37,38,50,53],"ul",{},[39,40,41,45,46,49],"li",{},[42,43,44],"strong",{},"Instalador (.exe)"," o ",[42,47,48],{},"MSI (.msi)"," para Windows de 64 bits",[39,51,52],{},"Objetivo de la landing: Windows 10 y posterior",[39,54,55],{},"El README de la app también lista Windows 8 y superior",[14,57,58],{},"Ejecuta el instalador y luego abre SoundNinja desde el menú Inicio.",[31,60,62],{"id":61},"macos","macOS",[36,64,65,71,74],{},[39,66,67,70],{},[42,68,69],{},".dmg universal"," para Apple Silicon e Intel",[39,72,73],{},"Objetivo de la landing: macOS 10.14 y posterior",[39,75,76],{},"El README de la app lista macOS 10.15 y superior",[14,78,79],{},"Abre la imagen de disco y arrastra SoundNinja a Aplicaciones.",[31,81,83],{"id":82},"linux","Linux",[36,85,86,92,98,106],{},[39,87,88,91],{},[42,89,90],{},"Debian (.deb)"," para Ubuntu \u002F Debian",[39,93,94,97],{},[42,95,96],{},"AppImage"," para otras distros",[39,99,100,101,105],{},"Tras publicar una release, los usuarios de Arch pueden instalar ",[102,103,104],"code",{},"soundninja-bin"," desde el AUR",[39,107,108],{},"Probado en Ubuntu 20.04",[14,110,111,112,115,116,119],{},"Las builds de escritorio necesitan paquetes WebKit y GTK. En Debian\u002FUbuntu eso suele ser ",[102,113,114],{},"libwebkit2gtk",", ",[102,117,118],{},"libgtk-3-0"," y una biblioteca app-indicator.",[31,121,123],{"id":122},"actualizaciones","Actualizaciones",[14,125,126,127,130],{},"En la app, abre ",[42,128,129],{},"Ayuda → Buscar actualizaciones",". También puedes dejar que SoundNinja compruebe al arrancar en Ajustes.",[31,132,134],{"id":133},"compilar-desde-el-código","Compilar desde el código",[14,136,137,138,143,144,149],{},"¿Necesitas una build personalizada? Clona ",[18,139,142],{"href":140,"rel":141},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja",[27],"el repo",", instala los ",[18,145,148],{"href":146,"rel":147},"https:\u002F\u002Fv2.tauri.app\u002Fstart\u002Fprerequisites\u002F",[27],"requisitos de Tauri"," y luego:",[151,152,157],"pre",{"className":153,"code":154,"language":155,"meta":156,"style":156},"language-bash shiki shiki-themes github-light github-dark","bun install\nbun run tauri:serve\n","bash","",[102,158,159,172],{"__ignoreMap":156},[160,161,164,168],"span",{"class":162,"line":163},"line",1,[160,165,167],{"class":166},"sScJk","bun",[160,169,171],{"class":170},"sZZnC"," install\n",[160,173,175,177,180],{"class":162,"line":174},2,[160,176,167],{"class":166},[160,178,179],{"class":170}," run",[160,181,182],{"class":170}," tauri:serve\n",[14,184,185,115,188,45,191,194,195,198],{},[102,186,187],{},"npm",[102,189,190],{},"pnpm",[102,192,193],{},"deno"," también sirven. Build de producción: ",[102,196,197],{},"bun run tauri:build",".",[200,201,202],"style",{},"html pre.shiki code .sScJk, html code.shiki .sScJk{--shiki-default:#6F42C1;--shiki-dark:#B392F0}html pre.shiki code .sZZnC, html code.shiki .sZZnC{--shiki-default:#032F62;--shiki-dark:#9ECBFF}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html.dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}",{"title":156,"searchDepth":174,"depth":174,"links":204},[205,206,207,208,209],{"id":33,"depth":174,"text":34},{"id":61,"depth":174,"text":62},{"id":82,"depth":174,"text":83},{"id":122,"depth":174,"text":123},{"id":133,"depth":174,"text":134},"Instala SoundNinja en Windows, macOS o Linux.","md",{},true,"\u002Finstallation",{"title":5,"description":210},"installation","DZ0nnkuNJ5bWc2nnZMQjtBcj72EEzzogekGEbJUmx80",[219,338,459,607,763,899,1041,1263],{"id":220,"title":221,"body":222,"description":332,"extension":211,"meta":333,"navigation":213,"order":163,"path":334,"seo":335,"stem":336,"__hash__":337},"content_es\u002Foverview.md","Resumen",{"type":7,"value":223,"toc":326},[224,227,230,233,236,240,254,258,288,292,301,305],[10,225,221],{"id":226},"resumen",[14,228,229],{},"SoundNinja es un soundboard de código abierto para streaming en directo, charlas con amigos y grabación de podcasts. Está construido con Tauri v2 y Nuxt 4 para que sea ligero en RAM y disco.",[14,231,232],{},"El objetivo es simple: mantener una biblioteca enorme fácil de recorrer y reproducir el clip correcto en milisegundos. La interfaz también funciona bien como panel en VR.",[14,234,235],{},"SoundNinja sigue en desarrollo temprano. Las funciones marchan, pero no todas las plataformas están del todo probadas.",[31,237,239],{"id":238},"para-quién","Para quién",[36,241,242,245,248,251],{},[39,243,244],{},"Streamers que necesitan cues de sonido al instante",[39,246,247],{},"Amigos que quieren un tablero compartido para el chat de voz",[39,249,250],{},"Podcasters que graban clips y los sueltan en un tablero",[39,252,253],{},"Quien quiera un soundboard personalizable y local-first",[31,255,257],{"id":256},"qué-puedes-hacer","Qué puedes hacer",[36,259,260,263,266,269,272,275,282,285],{},[39,261,262],{},"Montar un soundboard con tus propios archivos de audio",[39,264,265],{},"Organizar sonidos en pestañas de colores, grupos y búsqueda",[39,267,268],{},"Diseñar el aspecto con el Theme Creator",[39,270,271],{},"Grabar audio del PC o un micrófono en el Record Editor",[39,273,274],{},"Asignar atajos a sonidos individuales",[39,276,277,278],{},"Disparar sonidos desde ",[18,279,281],{"href":280},"\u002Fdocs\u002Fremote-control","Bitfocus Companion",[39,283,284],{},"Importar y exportar un soundboard completo para compartirlo",[39,286,287],{},"Usar GIFs o imágenes en los botones de sonido",[31,289,291],{"id":290},"licencia","Licencia",[14,293,294,295,300],{},"SoundNinja es software libre bajo ",[18,296,299],{"href":297,"rel":298},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fblob\u002Fmain\u002FLICENSE",[27],"GPL-3.0",". Haz fork, cámbialo, compártelo.",[31,302,304],{"id":303},"siguientes-pasos","Siguientes pasos",[306,307,308,314,320],"ol",{},[39,309,310],{},[18,311,313],{"href":312},"\u002Fdocs\u002Finstallation","Instalar SoundNinja",[39,315,316],{},[18,317,319],{"href":318},"\u002Fdocs\u002Fadding-sounds","Añadir sonidos",[39,321,322],{},[18,323,325],{"href":324},"\u002Fdocs\u002Forganizing-sounds","Organizar tu tablero",{"title":156,"searchDepth":174,"depth":174,"links":327},[328,329,330,331],{"id":238,"depth":174,"text":239},{"id":256,"depth":174,"text":257},{"id":290,"depth":174,"text":291},{"id":303,"depth":174,"text":304},"Qué es SoundNinja y qué puedes hacer con él.",{},"\u002Foverview",{"title":221,"description":332},"overview","_jbFAqK9Ea28XfzNs3a2S9mJrWOMez_Uxtm9qlYTevc",{"id":4,"title":5,"body":339,"description":210,"extension":211,"meta":457,"navigation":213,"order":174,"path":214,"seo":458,"stem":216,"__hash__":217},{"type":7,"value":340,"toc":450},[341,343,350,352,364,366,368,378,380,382,398,404,406,410,412,420,438,448],[10,342,5],{"id":12},[14,344,16,345,22,347,29],{},[18,346,21],{"href":20},[18,348,28],{"href":25,"rel":349},[27],[31,351,34],{"id":33},[36,353,354,360,362],{},[39,355,356,45,358,49],{},[42,357,44],{},[42,359,48],{},[39,361,52],{},[39,363,55],{},[14,365,58],{},[31,367,62],{"id":61},[36,369,370,374,376],{},[39,371,372,70],{},[42,373,69],{},[39,375,73],{},[39,377,76],{},[14,379,79],{},[31,381,83],{"id":82},[36,383,384,388,392,396],{},[39,385,386,91],{},[42,387,90],{},[39,389,390,97],{},[42,391,96],{},[39,393,100,394,105],{},[102,395,104],{},[39,397,108],{},[14,399,111,400,115,402,119],{},[102,401,114],{},[102,403,118],{},[31,405,123],{"id":122},[14,407,126,408,130],{},[42,409,129],{},[31,411,134],{"id":133},[14,413,137,414,143,417,149],{},[18,415,142],{"href":140,"rel":416},[27],[18,418,148],{"href":146,"rel":419},[27],[151,421,422],{"className":153,"code":154,"language":155,"meta":156,"style":156},[102,423,424,430],{"__ignoreMap":156},[160,425,426,428],{"class":162,"line":163},[160,427,167],{"class":166},[160,429,171],{"class":170},[160,431,432,434,436],{"class":162,"line":174},[160,433,167],{"class":166},[160,435,179],{"class":170},[160,437,182],{"class":170},[14,439,440,115,442,45,444,194,446,198],{},[102,441,187],{},[102,443,190],{},[102,445,193],{},[102,447,197],{},[200,449,202],{},{"title":156,"searchDepth":174,"depth":174,"links":451},[452,453,454,455,456],{"id":33,"depth":174,"text":34},{"id":61,"depth":174,"text":62},{"id":82,"depth":174,"text":83},{"id":122,"depth":174,"text":123},{"id":133,"depth":174,"text":134},{},{"title":5,"description":210},{"id":460,"title":319,"body":461,"description":600,"extension":211,"meta":601,"navigation":213,"order":602,"path":603,"seo":604,"stem":605,"__hash__":606},"content_es\u002Fadding-sounds.md",{"type":7,"value":462,"toc":592},[463,466,469,473,492,496,527,531,550,554,568,571,575,582,586],[10,464,319],{"id":465},"añadir-sonidos",[14,467,468],{},"Un tablero está vacío hasta que añades clips. SoundNinja puede importar archivos, carpetas enteras, una grabación o un pack de soundboard compartido.",[31,470,472],{"id":471},"importar-archivos-de-audio","Importar archivos de audio",[306,474,475,486,489],{},[39,476,477,478,481,482,485],{},"Abre ",[42,479,480],{},"Archivo → Importar archivos de audio",", o usa ",[42,483,484],{},"Importar"," en la barra de navegación.",[39,487,488],{},"Elige uno o más archivos de audio.",[39,490,491],{},"Los sonidos llegan a la pestaña actual.",[31,493,495],{"id":494},"importar-carpetas","Importar carpetas",[306,497,498,507,510],{},[39,499,477,500,503,504,506],{},[42,501,502],{},"Archivo → Importar carpetas"," (o ",[42,505,495],{}," en la barra de navegación).",[39,508,509],{},"Añade una o más carpetas. Arrastra para reordenarlas antes de importar.",[39,511,512,513],{},"Elige cómo llegan:\n",[36,514,515,521],{},[39,516,517,520],{},[42,518,519],{},"Importar como pestañas"," — cada carpeta se convierte en su propia pestaña",[39,522,523,526],{},[42,524,525],{},"Importar a la pestaña actual"," — cada archivo va a la pestaña activa",[31,528,530],{"id":529},"grabar-un-clip","Grabar un clip",[14,532,533,534,538,539,542,543,45,546,549],{},"Abre el ",[18,535,537],{"href":536},"\u002Fdocs\u002Frecording-editor","Record Editor"," desde el botón ",[42,540,541],{},"Grabar"," en la barra del reproductor. Captura, recorta y luego ",[42,544,545],{},"Importar selección",[42,547,548],{},"Importar todo"," en la pestaña actual o en una pestaña que elijas.",[31,551,553],{"id":552},"importar-un-soundboard","Importar un soundboard",[14,555,556,559,560,563,564,567],{},[42,557,558],{},"Archivo → Importar soundboard"," carga un pack compartido. Los packs son un ",[102,561,562],{},".zip"," que contiene ",[102,565,566],{},"project.sninja"," más los archivos de sonido. Tras importar, abre el proyecto y reproduce.",[14,569,570],{},"También puedes tener varios proyectos (perfiles). Usa el selector de proyecto para cambiar de tablero.",[31,572,574],{"id":573},"reenlazar-archivos-faltantes","Reenlazar archivos faltantes",[14,576,577,578,581],{},"Si los archivos de audio se mueven en el disco, SoundNinja muestra ",[42,579,580],{},"Archivos de sonido faltantes",". Elige una carpeta para buscar y reenlazar los clips.",[31,583,585],{"id":584},"siguiente","Siguiente",[14,587,588,589,198],{},"Organiza pestañas, grupos y atajos en ",[18,590,591],{"href":324},"Organizar sonidos",{"title":156,"searchDepth":174,"depth":174,"links":593},[594,595,596,597,598,599],{"id":471,"depth":174,"text":472},{"id":494,"depth":174,"text":495},{"id":529,"depth":174,"text":530},{"id":552,"depth":174,"text":553},{"id":573,"depth":174,"text":574},{"id":584,"depth":174,"text":585},"Importa audio, carpetas, grabaciones y soundboards compartidos.",{},3,"\u002Fadding-sounds",{"title":319,"description":600},"adding-sounds","Pp2z7pkBymoeTp058Pu8gOujI6GqQLoQ-Go0ZA2L1F4",{"id":608,"title":591,"body":609,"description":756,"extension":211,"meta":757,"navigation":213,"order":758,"path":759,"seo":760,"stem":761,"__hash__":762},"content_es\u002Forganizing-sounds.md",{"type":7,"value":610,"toc":747},[611,614,617,621,648,655,659,662,676,683,687,694,698,709,713,716,720,723,729,735,739],[10,612,591],{"id":613},"organizar-sonidos",[14,615,616],{},"SoundNinja está hecho para bibliotecas grandes. Usa pestañas, grupos, búsqueda y atajos para que el clip que necesitas esté a un clic (o una tecla) de distancia.",[31,618,620],{"id":619},"pestañas","Pestañas",[36,622,623,630,637],{},[39,624,625,626,629],{},"Añade una pestaña con ",[42,627,628],{},"Añadir pestaña",". Dale un color para escanear la barra rápido.",[39,631,632,633,636],{},"La vista ",[42,634,635],{},"Todos"," muestra cada sonido de todas las pestañas.",[39,638,639,640,643,644,647],{},"Un sonido puede pertenecer a ",[42,641,642],{},"una o más pestañas",". Clic derecho en un sonido y usa ",[42,645,646],{},"Mover a pestaña"," para asignarlo.",[14,649,650,651,654],{},"Las transiciones de pestaña están en ",[42,652,653],{},"Ajustes → General",": Slide, Fade, Botones uno a uno, o Ninguna.",[31,656,658],{"id":657},"grupos","Grupos",[14,660,661],{},"Desde la v0.5.3, los separadores pueden convertirse en grupos con nombre:",[36,663,664,667,670,673],{},[39,665,666],{},"Añadir, renombrar o quitar un grupo desde el menú contextual",[39,668,669],{},"Arrastra la cabecera del grupo — los hijos se mueven con ella",[39,671,672],{},"Suelta sonidos dentro o fuera de un grupo",[39,674,675],{},"Define color de borde, color del nombre y alineación de botones (o usa el valor por defecto de la pestaña)",[14,677,678,679,682],{},"Sigue pudiendo añadir un ",[42,680,681],{},"Separador"," simple si solo necesitas un corte visual.",[31,684,686],{"id":685},"búsqueda","Búsqueda",[14,688,689,690,693],{},"Usa el campo ",[42,691,692],{},"Buscar"," en la barra de navegación. Los resultados se actualizan mientras escribes.",[31,695,697],{"id":696},"reordenar","Reordenar",[14,699,700,701,704,705,708],{},"Activa arrastrar y soltar en ",[42,702,703],{},"Ajustes → Comportamiento"," (",[42,706,707],{},"Permitir reordenar","). Luego arrastra sonidos y grupos a su sitio.",[31,710,712],{"id":711},"edición-masiva","Edición masiva",[14,714,715],{},"Selecciona varios sonidos y cambia el color, muévelos a una pestaña o elimínalos de una vez.",[31,717,719],{"id":718},"atajos-e-ids-de-sonido","Atajos e IDs de sonido",[14,721,722],{},"Cada sonido tiene un ID de 8 caracteres. Cópialo desde el menú contextual del botón o el chip de ID de la selección múltiple.",[14,724,477,725,728],{},[42,726,727],{},"Ajustes → Atajos"," para vincular una tecla a un ID de sonido. Los atajos globales son opcionales.",[14,730,731,732,734],{},"El mismo ID es el que ",[18,733,281],{"href":280}," usa para disparar un clip.",[31,736,738],{"id":737},"gifs-y-colores","GIFs y colores",[14,740,741,742,746],{},"Clic derecho en un sonido para definir colores por botón o un fondo GIF \u002F imagen. Eso es independiente del ",[18,743,745],{"href":744},"\u002Fdocs\u002Ftheme-editor","Theme Creator",", que da estilo a todo el tablero.",{"title":156,"searchDepth":174,"depth":174,"links":748},[749,750,751,752,753,754,755],{"id":619,"depth":174,"text":620},{"id":657,"depth":174,"text":658},{"id":685,"depth":174,"text":686},{"id":696,"depth":174,"text":697},{"id":711,"depth":174,"text":712},{"id":718,"depth":174,"text":719},{"id":737,"depth":174,"text":738},"Pestañas, grupos, búsqueda, edición masiva y atajos.",{},4,"\u002Forganizing-sounds",{"title":591,"description":756},"organizing-sounds","L2-ttc1gCTlJQIkJYckTzh-JzPPPTLU4m0uGjwPApXk",{"id":764,"title":765,"body":766,"description":892,"extension":211,"meta":893,"navigation":213,"order":894,"path":895,"seo":896,"stem":897,"__hash__":898},"content_es\u002Ftheme-editor.md","Editor de temas",{"type":7,"value":767,"toc":886},[768,771,777,781,808,811,815,829,833,859,862,866,872],[10,769,765],{"id":770},"editor-de-temas",[14,772,773,774,198],{},"El Theme Creator es el editor visual completo de tu tablero. Ábrelo desde ",[42,775,776],{},"Ajustes → General → Theme Creator",[31,778,780],{"id":779},"tres-pestañas","Tres pestañas",[306,782,783,797,803],{},[39,784,785,788,789,792,793,796],{},[42,786,787],{},"General"," — nombre del tema, colores compartidos y carga de fuentes (",[102,790,791],{},".ttf"," \u002F ",[102,794,795],{},".otf",")",[39,798,799,802],{},[42,800,801],{},"Botones"," — colores, tipo, diseño y overlay GIF de los botones de sonido",[39,804,805,807],{},[42,806,620],{}," — colores, tipo y grosor de borde de la barra de pestañas",[14,809,810],{},"Una vista previa en vivo muestra pestañas y botones mientras editas.",[31,812,814],{"id":813},"qué-puedes-cambiar","Qué puedes cambiar",[36,816,817,820,823,826],{},[39,818,819],{},"Colores primario y de acento, fondos, colores de botones, colores de pestañas",[39,821,822],{},"Familia y tamaño de fuente de botones y pestañas",[39,824,825],{},"Ancho, radio, borde, huecos y padding de los botones",[39,827,828],{},"Opacidad del overlay GIF (normal y hover)",[31,830,832],{"id":831},"guardar-y-compartir","Guardar y compartir",[36,834,835,841,847,853],{},[39,836,837,840],{},[42,838,839],{},"Exportar .css"," — escribe un archivo de tema para respaldar o enviar a un amigo",[39,842,843,846],{},[42,844,845],{},"Añadir a temas"," — guarda el archivo en tu carpeta Themes y aplícalo",[39,848,849,852],{},[42,850,851],{},"Importar .css"," — carga un preset integrado o un tema guardado",[39,854,855,858],{},[42,856,857],{},"Restablecer"," — vuelve a los valores por defecto de SoundNinja",[14,860,861],{},"Si cierras la ventana con cambios sin guardar, SoundNinja te pide que guardes primero.",[31,863,865],{"id":864},"sin-el-editor-completo","Sin el editor completo",[14,867,868,869,871],{},"En ",[42,870,653],{}," aún puedes:",[36,873,874,877,883],{},[39,875,876],{},"Elegir un tema de la lista",[39,878,879,880,796],{},"Editar variables CSS en vivo (",[42,881,882],{},"CSS personalizado",[39,884,885],{},"Importar un archivo de tema a la carpeta Themes",{"title":156,"searchDepth":174,"depth":174,"links":887},[888,889,890,891],{"id":779,"depth":174,"text":780},{"id":813,"depth":174,"text":814},{"id":831,"depth":174,"text":832},{"id":864,"depth":174,"text":865},"Diseña colores, fuentes, botones y pestañas en el Theme Creator.",{},5,"\u002Ftheme-editor",{"title":765,"description":892},"theme-editor","bPcJP7OLtBsnNMYJ-S1J6DmB6nngULo1_Q1hBJMNZAQ",{"id":900,"title":901,"body":902,"description":1034,"extension":211,"meta":1035,"navigation":213,"order":1036,"path":1037,"seo":1038,"stem":1039,"__hash__":1040},"content_es\u002Frecording-editor.md","Edit