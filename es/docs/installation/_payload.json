[{"data":1,"prerenderedAt":1625},["ShallowReactive",2],{"docs-page-es-\u002Finstallation":3,"docs-nav-es":221},{"id":4,"title":5,"body":6,"description":213,"extension":214,"meta":215,"navigation":216,"order":177,"path":217,"seo":218,"stem":219,"__hash__":220},"content_es\u002Finstallation.md","Instalación",{"type":7,"value":8,"toc":206},"minimark",[9,13,30,35,59,62,66,80,83,87,112,123,127,134,138,153,186,202],[10,11,5],"h1",{"id":12},"instalación",[14,15,16,17,22,23,29],"p",{},"Consigue una build en la ",[18,19,21],"a",{"href":20},"\u002Fdownload","página de descarga"," o en ",[18,24,28],{"href":25,"rel":26},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Freleases\u002Flatest",[27],"nofollow","GitHub Releases",". SoundNinja está en desarrollo temprano, así que trata las builds como beta.",[31,32,34],"h2",{"id":33},"windows","Windows",[36,37,38,50,53,56],"ul",{},[39,40,41,45,46,49],"li",{},[42,43,44],"strong",{},"Instalador (.exe)"," o ",[42,47,48],{},"MSI (.msi)"," para Windows de 64 bits",[39,51,52],{},"Objetivo de la landing: Windows 10 y posterior",[39,54,55],{},"El README de la app también lista Windows 8 y superior",[39,57,58],{},"El instalador NSIS usa tema oscuro. Elige idioma en el setup — SoundNinja lo recuerda en el siguiente arranque.",[14,60,61],{},"Ejecuta el instalador y luego abre SoundNinja desde el menú Inicio.",[31,63,65],{"id":64},"macos","macOS",[36,67,68,74,77],{},[39,69,70,73],{},[42,71,72],{},".dmg universal"," para Apple Silicon e Intel",[39,75,76],{},"Objetivo de la landing: macOS 10.14 y posterior",[39,78,79],{},"El README de la app lista macOS 10.15 y superior",[14,81,82],{},"Abre la imagen de disco y arrastra SoundNinja a Aplicaciones.",[31,84,86],{"id":85},"linux","Linux",[36,88,89,95,101,109],{},[39,90,91,94],{},[42,92,93],{},"Debian (.deb)"," para Ubuntu \u002F Debian",[39,96,97,100],{},[42,98,99],{},"AppImage"," para otras distros",[39,102,103,104,108],{},"Tras publicar una release, los usuarios de Arch pueden instalar ",[105,106,107],"code",{},"soundninja-bin"," desde el AUR",[39,110,111],{},"Probado en Ubuntu 20.04",[14,113,114,115,118,119,122],{},"Las builds de escritorio necesitan paquetes WebKit y GTK. En Debian\u002FUbuntu eso suele ser ",[105,116,117],{},"libwebkit2gtk",", ",[105,120,121],{},"libgtk-3-0"," y una biblioteca app-indicator.",[31,124,126],{"id":125},"actualizaciones","Actualizaciones",[14,128,129,130,133],{},"En la app, abre ",[42,131,132],{},"Ayuda → Buscar actualizaciones",". También puedes dejar que SoundNinja compruebe al arrancar en Ajustes.",[31,135,137],{"id":136},"compilar-desde-el-código","Compilar desde el código",[14,139,140,141,146,147,152],{},"¿Necesitas una build personalizada? Clona ",[18,142,145],{"href":143,"rel":144},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja",[27],"el repo",", instala los ",[18,148,151],{"href":149,"rel":150},"https:\u002F\u002Fv2.tauri.app\u002Fstart\u002Fprerequisites\u002F",[27],"requisitos de Tauri"," y luego:",[154,155,160],"pre",{"className":156,"code":157,"language":158,"meta":159,"style":159},"language-bash shiki shiki-themes github-light github-dark","bun install\nbun run tauri:serve\n","bash","",[105,161,162,175],{"__ignoreMap":159},[163,164,167,171],"span",{"class":165,"line":166},"line",1,[163,168,170],{"class":169},"sScJk","bun",[163,172,174],{"class":173},"sZZnC"," install\n",[163,176,178,180,183],{"class":165,"line":177},2,[163,179,170],{"class":169},[163,181,182],{"class":173}," run",[163,184,185],{"class":173}," tauri:serve\n",[14,187,188,118,191,45,194,197,198,201],{},[105,189,190],{},"npm",[105,192,193],{},"pnpm",[105,195,196],{},"deno"," también sirven. Build de producción: ",[105,199,200],{},"bun run tauri:build",".",[203,204,205],"style",{},"html pre.shiki code .sScJk, html code.shiki .sScJk{--shiki-default:#6F42C1;--shiki-dark:#B392F0}html pre.shiki code .sZZnC, html code.shiki .sZZnC{--shiki-default:#032F62;--shiki-dark:#9ECBFF}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html.dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}",{"title":159,"searchDepth":177,"depth":177,"links":207},[208,209,210,211,212],{"id":33,"depth":177,"text":34},{"id":64,"depth":177,"text":65},{"id":85,"depth":177,"text":86},{"id":125,"depth":177,"text":126},{"id":136,"depth":177,"text":137},"Instala SoundNinja en Windows, macOS o Linux.","md",{},true,"\u002Finstallation",{"title":5,"description":213},"installation","zTwxz-vo_-k3K7RGGSHRG4ObTS6FkM9sbuxQPVMKTtY",[222,350,473,621,1024,1159,1305,1527],{"id":223,"title":224,"body":225,"description":344,"extension":214,"meta":345,"navigation":216,"order":166,"path":346,"seo":347,"stem":348,"__hash__":349},"content_es\u002Foverview.md","Resumen",{"type":7,"value":226,"toc":338},[227,230,233,236,239,243,257,261,300,304,313,317],[10,228,224],{"id":229},"resumen",[14,231,232],{},"SoundNinja es un soundboard de código abierto para streaming en directo, charlas con amigos y grabación de podcasts. Está construido con Tauri v2 y Nuxt 4 para que sea ligero en RAM y disco.",[14,234,235],{},"El objetivo es simple: mantener una biblioteca enorme fácil de recorrer y reproducir el clip correcto en milisegundos. La interfaz también funciona bien como panel en VR.",[14,237,238],{},"SoundNinja sigue en desarrollo temprano. Las funciones marchan, pero no todas las plataformas están del todo probadas.",[31,240,242],{"id":241},"para-quién","Para quién",[36,244,245,248,251,254],{},[39,246,247],{},"Streamers que necesitan cues de sonido al instante",[39,249,250],{},"Amigos que quieren un tablero compartido para el chat de voz",[39,252,253],{},"Podcasters que graban clips y los sueltan en un tablero",[39,255,256],{},"Quien quiera un soundboard personalizable y local-first",[31,258,260],{"id":259},"qué-puedes-hacer","Qué puedes hacer",[36,262,263,266,269,272,275,278,281,284,287,294,297],{},[39,264,265],{},"Montar un soundboard con tus propios archivos de audio",[39,267,268],{},"Organizar sonidos en pestañas de colores, grupos, etiquetas y búsqueda",[39,270,271],{},"Filtrar por etiquetas (OR) y ordenar por nombre, fecha, duración o tamaño",[39,273,274],{},"Selección múltiple con marco o rango Mayús, luego color, mover o borrar en lote",[39,276,277],{},"Ajustar el volumen por sonido desde el menú contextual",[39,279,280],{},"Diseñar el aspecto con el Theme Creator",[39,282,283],{},"Grabar audio del PC o un micrófono en el Record Editor",[39,285,286],{},"Asignar atajos a sonidos individuales",[39,288,289,290],{},"Disparar sonidos desde ",[18,291,293],{"href":292},"\u002Fdocs\u002Fremote-control","Bitfocus Companion",[39,295,296],{},"Importar y exportar un soundboard completo para compartirlo",[39,298,299],{},"Usar GIFs o imágenes en los botones — biblioteca local de carpetas o KLIPY",[31,301,303],{"id":302},"licencia","Licencia",[14,305,306,307,312],{},"SoundNinja es software libre bajo ",[18,308,311],{"href":309,"rel":310},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fblob\u002Fmain\u002FLICENSE",[27],"GPL-3.0",". Haz fork, cámbialo, compártelo.",[31,314,316],{"id":315},"siguientes-pasos","Siguientes pasos",[318,319,320,326,332],"ol",{},[39,321,322],{},[18,323,325],{"href":324},"\u002Fdocs\u002Finstallation","Instalar SoundNinja",[39,327,328],{},[18,329,331],{"href":330},"\u002Fdocs\u002Fadding-sounds","Añadir sonidos",[39,333,334],{},[18,335,337],{"href":336},"\u002Fdocs\u002Forganizing-sounds","Organizar tu tablero",{"title":159,"searchDepth":177,"depth":177,"links":339},[340,341,342,343],{"id":241,"depth":177,"text":242},{"id":259,"depth":177,"text":260},{"id":302,"depth":177,"text":303},{"id":315,"depth":177,"text":316},"Qué es SoundNinja y qué puedes hacer con él.",{},"\u002Foverview",{"title":224,"description":344},"overview","XWpBFvtyid6BLXO3HByHppTxfsOo0i7DlSOMew5tq2g",{"id":4,"title":5,"body":351,"description":213,"extension":214,"meta":471,"navigation":216,"order":177,"path":217,"seo":472,"stem":219,"__hash__":220},{"type":7,"value":352,"toc":464},[353,355,362,364,378,380,382,392,394,396,412,418,420,424,426,434,452,462],[10,354,5],{"id":12},[14,356,16,357,22,359,29],{},[18,358,21],{"href":20},[18,360,28],{"href":25,"rel":361},[27],[31,363,34],{"id":33},[36,365,366,372,374,376],{},[39,367,368,45,370,49],{},[42,369,44],{},[42,371,48],{},[39,373,52],{},[39,375,55],{},[39,377,58],{},[14,379,61],{},[31,381,65],{"id":64},[36,383,384,388,390],{},[39,385,386,73],{},[42,387,72],{},[39,389,76],{},[39,391,79],{},[14,393,82],{},[31,395,86],{"id":85},[36,397,398,402,406,410],{},[39,399,400,94],{},[42,401,93],{},[39,403,404,100],{},[42,405,99],{},[39,407,103,408,108],{},[105,409,107],{},[39,411,111],{},[14,413,114,414,118,416,122],{},[105,415,117],{},[105,417,121],{},[31,419,126],{"id":125},[14,421,129,422,133],{},[42,423,132],{},[31,425,137],{"id":136},[14,427,140,428,146,431,152],{},[18,429,145],{"href":143,"rel":430},[27],[18,432,151],{"href":149,"rel":433},[27],[154,435,436],{"className":156,"code":157,"language":158,"meta":159,"style":159},[105,437,438,444],{"__ignoreMap":159},[163,439,440,442],{"class":165,"line":166},[163,441,170],{"class":169},[163,443,174],{"class":173},[163,445,446,448,450],{"class":165,"line":177},[163,447,170],{"class":169},[163,449,182],{"class":173},[163,451,185],{"class":173},[14,453,454,118,456,45,458,197,460,201],{},[105,455,190],{},[105,457,193],{},[105,459,196],{},[105,461,200],{},[203,463,205],{},{"title":159,"searchDepth":177,"depth":177,"links":465},[466,467,468,469,470],{"id":33,"depth":177,"text":34},{"id":64,"depth":177,"text":65},{"id":85,"depth":177,"text":86},{"id":125,"depth":177,"text":126},{"id":136,"depth":177,"text":137},{},{"title":5,"description":213},{"id":474,"title":331,"body":475,"description":614,"extension":214,"meta":615,"navigation":216,"order":616,"path":617,"seo":618,"stem":619,"__hash__":620},"content_es\u002Fadding-sounds.md",{"type":7,"value":476,"toc":606},[477,480,483,487,506,510,541,545,564,568,582,585,589,596,600],[10,478,331],{"id":479},"añadir-sonidos",[14,481,482],{},"Un tablero está vacío hasta que añades clips. SoundNinja puede importar archivos, carpetas enteras, una grabación o un pack de soundboard compartido.",[31,484,486],{"id":485},"importar-archivos-de-audio","Importar archivos de audio",[318,488,489,500,503],{},[39,490,491,492,495,496,499],{},"Abre ",[42,493,494],{},"Archivo → Importar archivos de audio",", o usa ",[42,497,498],{},"Importar"," en la barra de navegación.",[39,501,502],{},"Elige uno o más archivos de audio.",[39,504,505],{},"Los sonidos llegan a la pestaña actual.",[31,507,509],{"id":508},"importar-carpetas","Importar carpetas",[318,511,512,521,524],{},[39,513,491,514,517,518,520],{},[42,515,516],{},"Archivo → Importar carpetas"," (o ",[42,519,509],{}," en la barra de navegación).",[39,522,523],{},"Añade una o más carpetas. Arrastra para reordenarlas antes de importar.",[39,525,526,527],{},"Elige cómo llegan:\n",[36,528,529,535],{},[39,530,531,534],{},[42,532,533],{},"Importar como pestañas"," — cada carpeta se convierte en su propia pestaña",[39,536,537,540],{},[42,538,539],{},"Importar a la pestaña actual"," — cada archivo va a la pestaña activa",[31,542,544],{"id":543},"grabar-un-clip","Grabar un clip",[14,546,547,548,552,553,556,557,45,560,563],{},"Abre el ",[18,549,551],{"href":550},"\u002Fdocs\u002Frecording-editor","Record Editor"," desde el botón ",[42,554,555],{},"Grabar"," en la barra del reproductor. Captura, recorta y luego ",[42,558,559],{},"Importar selección",[42,561,562],{},"Importar todo"," en la pestaña actual o en una pestaña que elijas.",[31,565,567],{"id":566},"importar-un-soundboard","Importar un soundboard",[14,569,570,573,574,577,578,581],{},[42,571,572],{},"Archivo → Importar soundboard"," carga un pack compartido. Los packs son un ",[105,575,576],{},".zip"," que contiene ",[105,579,580],{},"project.sninja"," más los archivos de sonido. Tras importar, abre el proyecto y reproduce.",[14,583,584],{},"También puedes tener varios proyectos (perfiles). Usa el selector de proyecto para cambiar de tablero.",[31,586,588],{"id":587},"reenlazar-archivos-faltantes","Reenlazar archivos faltantes",[14,590,591,592,595],{},"Si los archivos de audio se mueven en el disco, SoundNinja muestra ",[42,593,594],{},"Archivos de sonido faltantes",". Elige una carpeta para buscar y reenlazar los clips.",[31,597,599],{"id":598},"siguiente","Siguiente",[14,601,602,603,201],{},"Organiza pestañas, etiquetas, filtros y atajos en ",[18,604,605],{"href":336},"Organizar sonidos",{"title":159,"searchDepth":177,"depth":177,"links":607},[608,609,610,611,612,613],{"id":485,"depth":177,"text":486},{"id":508,"depth":177,"text":509},{"id":543,"depth":177,"text":544},{"id":566,"depth":177,"text":567},{"id":587,"depth":177,"text":588},{"id":598,"depth":177,"text":599},"Importa audio, carpetas, grabaciones y soundboards compartidos.",{},3,"\u002Fadding-sounds",{"title":331,"description":614},"adding-sounds","O5nOJGNq2FL6jafUxqoGYNKJDVbb2UrZRjfKpK21LlQ",{"id":622,"title":605,"body":623,"description":1017,"extension":214,"meta":1018,"navigation":216,"order":1019,"path":1020,"seo":1021,"stem":1022,"__hash__":1023},"content_es\u002Forganizing-sounds.md",{"type":7,"value":624,"toc":1002},[625,628,635,639,666,673,677,680,694,701,707,711,721,726,758,762,768,772,805,811,815,818,844,847,851,864,868,874,895,911,918,922,933,936,940,947,957,963,967,975,982,999],[10,626,605],{"id":627},"organizar-sonidos",[14,629,630,631,634],{},"SoundNinja está hecho para bibliotecas grandes. ",[42,632,633],{},"Etiquetas y filtros",", pestañas, búsqueda, selección múltiple y atajos — el clip que necesitas está a un clic (o una tecla).",[31,636,638],{"id":637},"pestañas","Pestañas",[36,640,641,648,655],{},[39,642,643,644,647],{},"Añade una pestaña con ",[42,645,646],{},"Añadir pestaña",". Dale un color para escanear la barra rápido.",[39,649,650,651,654],{},"La vista ",[42,652,653],{},"Todos"," muestra cada sonido de todas las pestañas.",[39,656,657,658,661,662,665],{},"Un sonido puede pertenecer a ",[42,659,660],{},"una o más pestañas",". Clic derecho en un sonido y usa ",[42,663,664],{},"Mover a pestaña"," para asignarlo.",[14,667,668,669,672],{},"Las transiciones de pestaña están en ",[42,670,671],{},"Ajustes → General",": Slide, Fade, Botones uno a uno, o Ninguna.",[31,674,676],{"id":675},"grupos","Grupos",[14,678,679],{},"Desde la v0.5.3, los separadores pueden convertirse en grupos con nombre:",[36,681,682,685,688,691],{},[39,683,684],{},"Añadir, renombrar o quitar un grupo desde el menú contextual",[39,686,687],{},"Arrastra la cabecera del grupo — los hijos se mueven con ella",[39,689,690],{},"Suelta sonidos dentro o fuera de un grupo",[39,692,693],{},"Define color de borde, color del nombre y alineación de botones (o usa el valor por defecto de la pestaña)",[14,695,696,697,700],{},"Sigue pudiendo añadir un ",[42,698,699],{},"Separador"," simple si solo necesitas un corte visual.",[14,702,703,704,201],{},"Clic derecho en el espacio vacío del tablero para ",[42,705,706],{},"Añadir grupo",[31,708,710],{"id":709},"etiquetas-filtros","Etiquetas \u002F Filtros",[14,712,713,714,717,718,720],{},"Las etiquetas cruzan las pestañas. El panel ",[42,715,716],{},"Filtro"," (barra lateral ",[42,719,716],{},") es donde las creas y filtras el tablero.",[722,723,725],"h3",{"id":724},"crear-y-editar-etiquetas","Crear y editar etiquetas",[318,727,728,733,744,751],{},[39,729,491,730,732],{},[42,731,716],{}," en la barra lateral.",[39,734,735,736,739,740,743],{},"En ",[42,737,738],{},"Etiquetas",", usa ",[42,741,742],{},"Añadir etiqueta"," — nombre y color.",[39,745,746,747,750],{},"Renombra, recolorea o ",[42,748,749],{},"Eliminar etiqueta"," en la misma lista.",[39,752,753,754,757],{},"Si ves ",[42,755,756],{},"Aún no hay etiquetas",", crea una aquí antes de asignar.",[722,759,761],{"id":760},"asignar-etiquetas-a-sonidos","Asignar etiquetas a sonidos",[14,763,764,765,767],{},"Clic derecho en un sonido → ",[42,766,738],{}," (casillas). Un sonido puede tener varias. Si aún no hay ninguna, el menú te lleva al panel de filtro.",[722,769,771],{"id":770},"filtrar-el-tablero","Filtrar el tablero",[36,773,774,780,791,802],{},[39,775,776,777,201],{},"Activa etiquetas en el panel Filtro o como ",[42,778,779],{},"chips bajo la barra de búsqueda",[39,781,782,783,786,787,790],{},"La coincidencia es ",[42,784,785],{},"OR",": un sonido sigue visible si tiene ",[42,788,789],{},"cualquiera"," de las etiquetas seleccionadas.",[39,792,793,794,797,798,801],{},"El campo ",[42,795,796],{},"Buscar"," combina con ",[42,799,800],{},"AND"," el filtro de etiquetas activo (texto + etiquetas juntos).",[39,803,804],{},"Apaga los chips (o limpia el filtro) para ver de nuevo toda la pestaña.",[14,806,807,808,201],{},"Los nombres de etiqueta en color pueden aparecer en los botones. Actívalos en ",[42,809,810],{},"Ajustes → Comportamiento → Mostrar badges de etiquetas",[31,812,814],{"id":813},"orden","Orden",[14,816,817],{},"Abre el panel de filtro y elige un modo:",[36,819,820,826],{},[39,821,822,825],{},[42,823,824],{},"Definido por el usuario"," — tu orden de pestaña, grupos visibles",[39,827,828,118,831,118,834,45,837,840,841],{},[42,829,830],{},"Nombre",[42,832,833],{},"Fecha de añadido",[42,835,836],{},"Tiempo de reproducción",[42,838,839],{},"Tamaño de archivo"," — lista plana ordenada; ",[42,842,843],{},"los grupos se ocultan",[14,845,846],{},"Ordenar por duración puede precargar los metadatos de duración la primera vez.",[31,848,850],{"id":849},"reordenar","Reordenar",[14,852,853,854,857,858,861,862,201],{},"Activa arrastrar y soltar en ",[42,855,856],{},"Ajustes → Comportamiento"," (",[42,859,860],{},"Permitir reordenar","). Luego arrastra sonidos y grupos a su sitio. Reordenar aplica en el orden ",[42,863,824],{},[31,865,867],{"id":866},"selección-múltiple","Selección múltiple",[14,869,870,871,873],{},"Activa ",[42,872,867],{}," en la barra de navegación, luego:",[36,875,876,879,885,892],{},[39,877,878],{},"Clic para alternar un sonido",[39,880,881,884],{},[42,882,883],{},"Mayús+clic"," para un rango desde el último ancla",[39,886,887,888,891],{},"Arrastra un ",[42,889,890],{},"marco"," en el espacio vacío del tablero",[39,893,894],{},"Clic en el tablero vacío (o fuera) para limpiar la selección",[14,896,897,898,118,901,118,904,907,908,201],{},"Una barra masiva muestra el recuento, más ",[42,899,900],{},"Color",[42,902,903],{},"Mover a pestaña…",[42,905,906],{},"Eliminar"," y ",[42,909,910],{},"Hecho",[14,912,913,914,917],{},"En selección múltiple, cada botón muestra un ",[42,915,916],{},"chip de ID de 8 caracteres",". Clic derecho en el chip para copiarlo.",[31,919,921],{"id":920},"volumen-por-sonido","Volumen por sonido",[14,923,924,925,928,929,932],{},"Clic derecho → ",[42,926,927],{},"Volumen",". Arrastra el control de 0 % a 100 %. ",[42,930,931],{},"Doble clic"," lo restablece a 100 %.",[14,934,935],{},"Se acumula con el volumen de salida maestro en Ajustes.",[31,937,939],{"id":938},"atajos-e-ids-de-sonido","Atajos e IDs de sonido",[14,941,942,943,946],{},"Cada sonido tiene un ID de 8 caracteres. Cópialo desde el menú contextual del botón (",[42,944,945],{},"Copiar ID",") o el chip de ID de la selección múltiple.",[14,948,491,949,952,953,956],{},[42,950,951],{},"Ajustes → Atajos"," para vincular una tecla a un ID de sonido. Los atajos globales son opcionales. ",[42,954,955],{},"Asignar atajo"," en el menú contextual salta allí con el ID rellenado.",[14,958,959,960,962],{},"El mismo ID es el que ",[18,961,293],{"href":292}," usa para disparar un clip.",[31,964,966],{"id":965},"imágenes-de-fondo-y-colores","Imágenes de fondo y colores",[14,968,969,970,974],{},"Clic derecho en un sonido para definir colores por botón o una imagen de fondo. Eso es independiente del ",[18,971,973],{"href":972},"\u002Fdocs\u002Ftheme-editor","Theme Creator",", que da estilo a todo el tablero.",[14,976,977,978,981],{},"El selector es un diálogo ",[42,979,980],{},"Imagen de fondo"," (PNG, JPEG, GIF, WebP):",[36,983,984,990],{},[39,985,986,989],{},[42,987,988],{},"Archivos locales"," — añade carpetas, elige un archivo, busca por nombre, previsualiza la cuadrícula o quita una carpeta de la biblioteca",[39,991,992,995,996,998],{},[42,993,994],{},"KLIPY"," — busca GIFs en línea. Pon tu propia clave API en ",[42,997,856],{},". La clave no se guarda en los archivos del proyecto.",[14,1000,1001],{},"Tras elegir, mueve y recorta la imagen en el botón.",{"title":159,"searchDepth":177,"depth":177,"links":1003},[1004,1005,1006,1011,1012,1013,1014,1015,1016],{"id":637,"depth":177,"text":638},{"id":675,"depth":177,"text":676},{"id":709,"depth":177,"text":710,"children":1007},[1008,1009,1010],{"id":724,"depth":616,"text":725},{"id":760,"depth":616,"text":761},{"id":770,"depth":616,"text":771},{"id":813,"depth":177,"text":814},{"id":849,"depth":177,"text":850},{"id":866,"depth":177,"text":867},{"id":920,"depth":177,"text":921},{"id":938,"depth":177,"text":939},{"id":965,"depth":177,"text":966},"Etiquetas, filtros, pestañas, grupos, orden, selección múltiple, volumen y atajos.",{},4,"\u002Forganizing-sounds",{"title":605,"description":1017},"organizing-sounds","0TCdzxC5d9uOHlnFnD2ygCuD63pFk5yy3tK0Xgbpa7M",{"id":1025,"title":1026,"body":1027,"description":1152,"extension":214,"meta":1153,"navigation":216,"order":1154,"path":1155,"seo":1156,"stem":1157,"__hash__":1158},"content_es\u002Ftheme-editor.md","Editor de temas",{"type":7,"value":1028,"toc":1146},[1029,1032,1038,1042,1069,1072,1076,1090,1094,1120,1123,1127,1132],[10,1030,1026],{"id":1031},"editor-de-temas",[14,1033,1034,1035,201],{},"El Theme Creator es el editor visual completo de tu tablero. Ábrelo desde ",[42,1036,1037],{},"Ajustes → General → Theme Creator",[31,1039,1041],{"id":1040},"tres-pestañas","Tres pestañas",[318,1043,1044,1058,1064],{},[39,1045,1046,1049,1050,1053,1054,1057],{},[42,1047,1048],{},"General"," — nombre del tema, colores compartidos y carga de fuentes (",[105,1051,1052],{},".ttf"," \u002F ",[105,1055,1056],{},".otf",")",[39,1059,1060,1063],{},[42,1061,1062],{},"Botones"," — colores, tipo, diseño y overlay GIF de los botones de sonido",[39,1065,1066,1068],{},[42,1067,638],{}," — colores, tipo y grosor de borde de la barra de pestañas",[14,1070,1071],{},"Una vista previa en vivo muestra pestañas y botones mientras editas.",[31,1073,1075],{"id":1074},"qué-puedes-cambiar","Qué puedes cambiar",[36,1077,1078,1081,1084,1087],{},[39,1079,1080],{},"Colores primario y de acento, fondos, colores de botones, colores de pestañas",[39,1082,1083],{},"Familia y tamaño de fuente de botones y pestañas",[39,1085,1086],{},"Ancho, radio, borde, huecos y padding de los botones",[39,1088,1089],{},"Opacidad del overlay GIF (normal y hover)",[31,1091,1093],{"id":1092},"guardar-y-compartir","Guardar y compartir",[36,1095,1096,1102,1108,1114],{},[39,1097,1098,1101],{},[42,1099,1100],{},"Exportar .css"," — escribe un archivo de tema para respaldar o enviar a un amigo",[39,1103,1104,1107],{},[42,1105,1106],{},"Añadir a temas"," — guarda el archivo en tu carpeta Themes y aplícalo",[39,1109,1110,1113],{},[42,1111,1112],{},"Importar .css"," — carga un preset integrado o un tema guardado",[39,1115,1116,1119],{},[42,1117,1118],{},"Restablecer"," — vuelve a los valores por defecto de SoundNinja",[14,1121,1122],{},"Si cierras la ventana con cambios sin guardar, SoundNinja te pide que guardes primero.",[31,1124,1126],{"id":1125},"sin-el-editor-completo","Sin el editor completo",[14,1128,735,1129,1131],{},[42,1130,671],{}," aún puedes:",[36,1133,1134,1137,1143],{},[39,1135,1136],{},"Elegir un tema de la lista",[39,1138,1139,1140,1057],{},"Editar variables CSS en vivo (",[42,1141,1142],{},"CSS personalizado",[39,1144,1145],{},"Importar un archivo de tema a la carpeta Themes",{"title":159,"searchDepth":177,"depth":177,"links":1147},[1148,1149,1150,1151],{"id":1040,"depth":177,"text":1041},{"id":1074,"depth":177,"text":1075},{"id":1092,"depth":177,"text":1093},{"id":1125,"depth":177,"text":1126},"Diseña colores, fuentes, botones y pestañas en el Theme Creator.",{},5,"\u002Ftheme-editor",{"title":1026,"description":1152},"theme-editor","bPcJP7OLtBsnNMYJ-S1J6DmB6nngULo1_Q1hBJMNZAQ",{"id":1160,"title":1161,"body":1162,"description":1298,"extension":214,"meta":1299,"navigation":216,"order":1300,"path":1301,"seo":1302,"stem":1303,"__hash__":1304},"content_es\u002Frecording-editor.md","Editor de grabación",{"type":7,"value":1163,"toc":1292},[1164,1167,1173,1177,1183,1203,1206,1210,1235,1239,1253,1257,1271,1282],[10,1165,1161],{"id":1166},"editor-de-grabación",[14,1168,1169,1170,1172],{},"Graba un clip dentro de SoundNinja, recórtalo e impórtalo a una pestaña. Abre el editor con el botón ",[42,1171,555],{}," en la barra del reproductor.",[31,1174,1176],{"id":1175},"elegir-una-entrada","Elegir una entrada",[14,1178,735,1179,1182],{},[42,1180,1181],{},"Ajustes → Audio",":",[36,1184,1185,1191,1197],{},[39,1186,1187,1190],{},[42,1188,1189],{},"Dispositivos de entrada"," — micrófono",[39,1192,1193,1196],{},[42,1194,1195],{},"Dispositivos de salida (audio del PC)"," — loopback de lo que reproduce el PC",[39,1198,1199,1202],{},[42,1200,1201],{},"Volumen de entrada"," — ganancia de captura del 0 % al 200 %",[14,1204,1205],{},"El botón Grabar usa el dispositivo que eliges aquí.",[31,1207,1209],{"id":1208},"editar-la-toma","Editar la toma",[36,1211,1212,1215,1218,1226,1229,1232],{},[39,1213,1214],{},"Grabar y detener",[39,1216,1217],{},"Observar el medidor de nivel de entrada",[39,1219,1220,45,1223],{},[42,1221,1222],{},"Normalizar",[42,1224,1225],{},"Cancelación de ruido",[39,1227,1228],{},"Recortar todo el clip, recortar a una selección o borrar una selección",[39,1230,1231],{},"Deshacer \u002F rehacer",[39,1233,1234],{},"Acercar y alejar",[31,1236,1238],{"id":1237},"preparar-e-importar","Preparar e importar",[318,1240,1241,1244,1247],{},[39,1242,1243],{},"Añade la selección o la pista completa a la lista de staging.",[39,1245,1246],{},"La lista empieza vacía: graba, edita y luego añade un clip.",[39,1248,1249,45,1251,563],{},[42,1250,559],{},[42,1252,562],{},[31,1254,1256],{"id":1255},"separación-de-stems-opcional","Separación de stems (opcional)",[14,1258,1259,1260,1263,1264,45,1267,1270],{},"Las builds oficiales de Windows, macOS y Linux incluyen la función ",[42,1261,1262],{},"stems",". El Record Editor puede conservar ",[42,1265,1266],{},"voces",[42,1268,1269],{},"música"," con BS-RoFormer.",[14,1272,1273,1274,1277,1278,1281],{},"El modelo pesa unos 158 MB y ",[42,1275,1276],{},"no"," viene en el instalador. Descárgalo desde ",[42,1279,1280],{},"Ajustes → Separación de stems",", o acepta el aviso del primer arranque. El instalador de Windows también puede ofrecer descargar el modelo al primer inicio.",[14,1283,1284,1285,1053,1288,1291],{},"Las builds personalizadas desde código necesitan un flag extra (",[105,1286,1287],{},"tauri:serve:stems",[105,1289,1290],{},"tauri:build:stems",").",{"title":159,"searchDepth":177,"depth":177,"links":1293},[1294,1295,1296,1297],{"id":1175,"depth":177,"text":1176},{"id":1208,"depth":177,"text":1209},{"id":1237,"depth":177,"text":1238},{"id":1255,"depth":177,"text":1256},"Captura micrófono o audio del PC, edita el clip y suéltalo en tu tablero.",{},6,"\u002Frecording-editor",{"title":1161,"description":1298},"recording-editor","89aDSCp7hE8To2TNFwdWaImQVsHH2-xNcOyltCPP5IY",{"id":1306,"title":1307,"body":1308,"description":1520,"extension":214,"meta":1521,"navigation":216,"order":1522,"path":1523,"seo":1524,"stem":1525,"__hash__":1526},"content_es\u002Fremote-control.md","Control remoto",{"type":7,"value":1309,"toc":1513},[1310,1313,1316,1320,1349,1352,1355,1390,1394,1414,1417,1421,1453,1457,1463],[10,1311,1307],{"id":1312},"control-remoto",[14,1314,1315],{},"SoundNinja puede escuchar en tu red local para que Bitfocus Companion (o cualquier cliente HTTP\u002FWebSocket) reproduzca y detenga sonidos.",[31,1317,1319],{"id":1318},"activar-el-servidor-remoto","Activar el servidor remoto",[318,1321,1322,1327,1333,1339],{},[39,1323,491,1324,201],{},[42,1325,1326],{},"Ajustes → Remoto",[39,1328,1329,1330,201],{},"Activa el servidor remoto. El puerto por defecto es ",[42,1331,1332],{},"7331",[39,1334,1335,1336,201],{},"Opcional: define un token. Los clientes deben enviarlo como Bearer token o ",[105,1337,1338],{},"?token=",[39,1340,1341,1342,1345,1346,201],{},"Copia la URL ",[105,1343,1344],{},"http:\u002F\u002FIP:PORT",", o copia la IP del sistema desde ",[42,1347,1348],{},"Ajustes → Acerca de",[14,1350,1351],{},"Windows puede mostrar un aviso del firewall la primera vez que arranca el servidor. Permite el acceso a la red privada.",[31,1353,293],{"id":1354},"bitfocus-companion",[318,1356,1357,1364,1373,1383],{},[39,1358,1359,1360,201],{},"Instala ",[18,1361,293],{"href":1362,"rel":1363},"https:\u002F\u002Fbitfocus.io\u002Fcompanion",[27],[39,1365,1366,1367,1372],{},"Descarga ",[18,1368,1371],{"href":1369,"rel":1370},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002Fcompanion-module-soundninja\u002Freleases\u002Flatest",[27],"SoundNinja-Companion.tgz",". Aún no hay paquete en Companion Store.",[39,1374,1375,1376,1379,1380,201],{},"En Companion: ",[42,1377,1378],{},"Modules → Load module package"," y elige el ",[105,1381,1382],{},".tgz",[39,1384,1385,1386,1389],{},"Añade una conexión ",[42,1387,1388],{},"Sound Ninja",". Pega la IP del PC, el puerto y el token si definiste uno.",[31,1391,1393],{"id":1392},"acciones","Acciones",[36,1395,1396,1402,1408],{},[39,1397,1398,1401],{},[42,1399,1400],{},"Trigger Sound"," — elige en el menú desplegable en vivo, o escribe un ID de sonido de 8 caracteres (las variables de Companion funcionan)",[39,1403,1404,1407],{},[42,1405,1406],{},"Stop Sound"," — detiene un sonido en reproducción por ID",[39,1409,1410,1413],{},[42,1411,1412],{},"Stop All"," — detiene todos los sonidos en reproducción",[14,1415,1416],{},"Copia un ID de sonido en SoundNinja desde el menú contextual del botón o el chip de ID de la selección múltiple.",[31,1418,1420],{"id":1419},"feedbacks-y-variables","Feedbacks y variables",[36,1422,1423,1429,1441,1447],{},[39,1424,1425,1428],{},[42,1426,1427],{},"Sound Playing"," — verdadero mientras ese ID de sonido está activo (úsalo para el color del botón)",[39,1430,1431,1434,1435,1053,1438],{},[105,1432,1433],{},"$(soundninja:connected)"," — ",[105,1436,1437],{},"true",[105,1439,1440],{},"false",[39,1442,1443,1446],{},[105,1444,1445],{},"$(soundninja:playing_count)"," — cuántos sonidos suenan",[39,1448,1449,1452],{},[105,1450,1451],{},"$(soundninja:last_triggered)"," — último ID de sonido disparado",[31,1454,1456],{"id":1455},"api-http-avanzado","API HTTP (avanzado)",[14,1458,1459,1460],{},"Ruta base: ",[105,1461,1462],{},"\u002Fapi\u002Fv1",[36,1464,1465,1471,1477,1483,1493,1499,1507],{},[39,1466,1467,1470],{},[105,1468,1469],{},"GET \u002Finfo"," — nombre de la app, versión, protocolo, si se requiere un token",[39,1472,1473,1476],{},[105,1474,1475],{},"GET \u002Fsounds"," — lista de sonidos (id, name, tabs, active)",[39,1478,1479,1482],{},[105,1480,1481],{},"GET \u002Fstate"," — sonidos más IDs que suenan ahora",[39,1484,1485,1488,1489,1492],{},[105,1486,1487],{},"POST \u002Ftrigger"," con ",[105,1490,1491],{},"{ \"id\" }"," — reproducir un