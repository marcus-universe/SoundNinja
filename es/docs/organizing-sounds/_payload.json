[{"data":1,"prerenderedAt":1773},["ShallowReactive",2],{"docs-page-es-\u002Forganizing-sounds":3,"docs-nav-es":427},{"id":4,"title":5,"body":6,"description":418,"extension":419,"meta":420,"navigation":421,"order":422,"path":423,"seo":424,"stem":425,"__hash__":426},"content_es\u002Forganizing-sounds.md","Organizar sonidos",{"type":7,"value":8,"toc":400},"minimark",[9,13,22,27,56,63,67,70,84,91,98,102,112,117,151,155,161,165,198,204,208,211,239,242,246,259,263,269,290,306,313,317,328,331,335,342,352,361,365,373,380,397],[10,11,5],"h1",{"id":12},"organizar-sonidos",[14,15,16,17,21],"p",{},"SoundNinja está hecho para bibliotecas grandes. ",[18,19,20],"strong",{},"Etiquetas y filtros",", pestañas, búsqueda, selección múltiple y atajos — el clip que necesitas está a un clic (o una tecla).",[23,24,26],"h2",{"id":25},"pestañas","Pestañas",[28,29,30,38,45],"ul",{},[31,32,33,34,37],"li",{},"Añade una pestaña con ",[18,35,36],{},"Añadir pestaña",". Dale un color para escanear la barra rápido.",[31,39,40,41,44],{},"La vista ",[18,42,43],{},"Todos"," muestra cada sonido de todas las pestañas.",[31,46,47,48,51,52,55],{},"Un sonido puede pertenecer a ",[18,49,50],{},"una o más pestañas",". Clic derecho en un sonido y usa ",[18,53,54],{},"Mover a pestaña"," para asignarlo.",[14,57,58,59,62],{},"Las transiciones de pestaña están en ",[18,60,61],{},"Ajustes → General",": Slide, Fade, Botones uno a uno, o Ninguna.",[23,64,66],{"id":65},"grupos","Grupos",[14,68,69],{},"Desde la v0.5.3, los separadores pueden convertirse en grupos con nombre:",[28,71,72,75,78,81],{},[31,73,74],{},"Añadir, renombrar o quitar un grupo desde el menú contextual",[31,76,77],{},"Arrastra la cabecera del grupo — los hijos se mueven con ella",[31,79,80],{},"Suelta sonidos dentro o fuera de un grupo",[31,82,83],{},"Define color de borde, color del nombre y alineación de botones (o usa el valor por defecto de la pestaña)",[14,85,86,87,90],{},"Sigue pudiendo añadir un ",[18,88,89],{},"Separador"," simple si solo necesitas un corte visual.",[14,92,93,94,97],{},"Clic derecho en el espacio vacío del tablero para ",[18,95,96],{},"Añadir grupo",".",[23,99,101],{"id":100},"etiquetas-filtros","Etiquetas \u002F Filtros",[14,103,104,105,108,109,111],{},"Las etiquetas cruzan las pestañas. El panel ",[18,106,107],{},"Filtro"," (barra lateral ",[18,110,107],{},") es donde las creas y filtras el tablero.",[113,114,116],"h3",{"id":115},"crear-y-editar-etiquetas","Crear y editar etiquetas",[118,119,120,126,137,144],"ol",{},[31,121,122,123,125],{},"Abre ",[18,124,107],{}," en la barra lateral.",[31,127,128,129,132,133,136],{},"En ",[18,130,131],{},"Etiquetas",", usa ",[18,134,135],{},"Añadir etiqueta"," — nombre y color.",[31,138,139,140,143],{},"Renombra, recolorea o ",[18,141,142],{},"Eliminar etiqueta"," en la misma lista.",[31,145,146,147,150],{},"Si ves ",[18,148,149],{},"Aún no hay etiquetas",", crea una aquí antes de asignar.",[113,152,154],{"id":153},"asignar-etiquetas-a-sonidos","Asignar etiquetas a sonidos",[14,156,157,158,160],{},"Clic derecho en un sonido → ",[18,159,131],{}," (casillas). Un sonido puede tener varias. Si aún no hay ninguna, el menú te lleva al panel de filtro.",[113,162,164],{"id":163},"filtrar-el-tablero","Filtrar el tablero",[28,166,167,173,184,195],{},[31,168,169,170,97],{},"Activa etiquetas en el panel Filtro o como ",[18,171,172],{},"chips bajo la barra de búsqueda",[31,174,175,176,179,180,183],{},"La coincidencia es ",[18,177,178],{},"OR",": un sonido sigue visible si tiene ",[18,181,182],{},"cualquiera"," de las etiquetas seleccionadas.",[31,185,186,187,190,191,194],{},"El campo ",[18,188,189],{},"Buscar"," combina con ",[18,192,193],{},"AND"," el filtro de etiquetas activo (texto + etiquetas juntos).",[31,196,197],{},"Apaga los chips (o limpia el filtro) para ver de nuevo toda la pestaña.",[14,199,200,201,97],{},"Los nombres de etiqueta en color pueden aparecer en los botones. Actívalos en ",[18,202,203],{},"Ajustes → Comportamiento → Mostrar badges de etiquetas",[23,205,207],{"id":206},"orden","Orden",[14,209,210],{},"Abre el panel de filtro y elige un modo:",[28,212,213,219],{},[31,214,215,218],{},[18,216,217],{},"Definido por el usuario"," — tu orden de pestaña, grupos visibles",[31,220,221,224,225,224,228,231,232,235,236],{},[18,222,223],{},"Nombre",", ",[18,226,227],{},"Fecha de añadido",[18,229,230],{},"Tiempo de reproducción"," o ",[18,233,234],{},"Tamaño de archivo"," — lista plana ordenada; ",[18,237,238],{},"los grupos se ocultan",[14,240,241],{},"Ordenar por duración puede precargar los metadatos de duración la primera vez.",[23,243,245],{"id":244},"reordenar","Reordenar",[14,247,248,249,252,253,256,257,97],{},"Activa arrastrar y soltar en ",[18,250,251],{},"Ajustes → Comportamiento"," (",[18,254,255],{},"Permitir reordenar","). Luego arrastra sonidos y grupos a su sitio. Reordenar aplica en el orden ",[18,258,217],{},[23,260,262],{"id":261},"selección-múltiple","Selección múltiple",[14,264,265,266,268],{},"Activa ",[18,267,262],{}," en la barra de navegación, luego:",[28,270,271,274,280,287],{},[31,272,273],{},"Clic para alternar un sonido",[31,275,276,279],{},[18,277,278],{},"Mayús+clic"," para un rango desde el último ancla",[31,281,282,283,286],{},"Arrastra un ",[18,284,285],{},"marco"," en el espacio vacío del tablero",[31,288,289],{},"Clic en el tablero vacío (o fuera) para limpiar la selección",[14,291,292,293,224,296,224,299,302,303,97],{},"Una barra masiva muestra el recuento, más ",[18,294,295],{},"Color",[18,297,298],{},"Mover a pestaña…",[18,300,301],{},"Eliminar"," y ",[18,304,305],{},"Hecho",[14,307,308,309,312],{},"En selección múltiple, cada botón muestra un ",[18,310,311],{},"chip de ID de 8 caracteres",". Clic derecho en el chip para copiarlo.",[23,314,316],{"id":315},"volumen-por-sonido","Volumen por sonido",[14,318,319,320,323,324,327],{},"Clic derecho → ",[18,321,322],{},"Volumen",". Arrastra el control de 0 % a 100 %. ",[18,325,326],{},"Doble clic"," lo restablece a 100 %.",[14,329,330],{},"Se acumula con el volumen de salida maestro en Ajustes.",[23,332,334],{"id":333},"atajos-e-ids-de-sonido","Atajos e IDs de sonido",[14,336,337,338,341],{},"Cada sonido tiene un ID de 8 caracteres. Cópialo desde el menú contextual del botón (",[18,339,340],{},"Copiar ID",") o el chip de ID de la selección múltiple.",[14,343,122,344,347,348,351],{},[18,345,346],{},"Ajustes → Atajos"," para vincular una tecla a un ID de sonido. Los atajos globales son opcionales. ",[18,349,350],{},"Asignar atajo"," en el menú contextual salta allí con el ID rellenado.",[14,353,354,355,360],{},"El mismo ID es el que ",[356,357,359],"a",{"href":358},"\u002Fdocs\u002Fremote-control","Bitfocus Companion"," usa para disparar un clip.",[23,362,364],{"id":363},"imágenes-de-fondo-y-colores","Imágenes de fondo y colores",[14,366,367,368,372],{},"Clic derecho en un sonido para definir colores por botón o una imagen de fondo. Eso es independiente del ",[356,369,371],{"href":370},"\u002Fdocs\u002Ftheme-editor","Theme Creator",", que da estilo a todo el tablero.",[14,374,375,376,379],{},"El selector es un diálogo ",[18,377,378],{},"Imagen de fondo"," (PNG, JPEG, GIF, WebP):",[28,381,382,388],{},[31,383,384,387],{},[18,385,386],{},"Archivos locales"," — añade carpetas, elige un archivo, busca por nombre, previsualiza la cuadrícula o quita una carpeta de la biblioteca",[31,389,390,393,394,396],{},[18,391,392],{},"KLIPY"," — busca GIFs en línea. Pon tu propia clave API en ",[18,395,251],{},". La clave no se guarda en los archivos del proyecto.",[14,398,399],{},"Tras elegir, mueve y recorta la imagen en el botón.",{"title":401,"searchDepth":402,"depth":402,"links":403},"",2,[404,405,406,412,413,414,415,416,417],{"id":25,"depth":402,"text":26},{"id":65,"depth":402,"text":66},{"id":100,"depth":402,"text":101,"children":407},[408,410,411],{"id":115,"depth":409,"text":116},3,{"id":153,"depth":409,"text":154},{"id":163,"depth":409,"text":164},{"id":206,"depth":402,"text":207},{"id":244,"depth":402,"text":245},{"id":261,"depth":402,"text":262},{"id":315,"depth":402,"text":316},{"id":333,"depth":402,"text":334},{"id":363,"depth":402,"text":364},"Etiquetas, filtros, pestañas, grupos, orden, selección múltiple, volumen y atajos.","md",{},true,4,"\u002Forganizing-sounds",{"title":5,"description":418},"organizing-sounds","0TCdzxC5d9uOHlnFnD2ygCuD63pFk5yy3tK0Xgbpa7M",[428,555,777,922,1172,1307,1453,1675],{"id":429,"title":430,"body":431,"description":548,"extension":419,"meta":549,"navigation":421,"order":550,"path":551,"seo":552,"stem":553,"__hash__":554},"content_es\u002Foverview.md","Resumen",{"type":7,"value":432,"toc":542},[433,436,439,442,445,449,463,467,504,508,518,522],[10,434,430],{"id":435},"resumen",[14,437,438],{},"SoundNinja es un soundboard de código abierto para streaming en directo, charlas con amigos y grabación de podcasts. Está construido con Tauri v2 y Nuxt 4 para que sea ligero en RAM y disco.",[14,440,441],{},"El objetivo es simple: mantener una biblioteca enorme fácil de recorrer y reproducir el clip correcto en milisegundos. La interfaz también funciona bien como panel en VR.",[14,443,444],{},"SoundNinja sigue en desarrollo temprano. Las funciones marchan, pero no todas las plataformas están del todo probadas.",[23,446,448],{"id":447},"para-quién","Para quién",[28,450,451,454,457,460],{},[31,452,453],{},"Streamers que necesitan cues de sonido al instante",[31,455,456],{},"Amigos que quieren un tablero compartido para el chat de voz",[31,458,459],{},"Podcasters que graban clips y los sueltan en un tablero",[31,461,462],{},"Quien quiera un soundboard personalizable y local-first",[23,464,466],{"id":465},"qué-puedes-hacer","Qué puedes hacer",[28,468,469,472,475,478,481,484,487,490,493,498,501],{},[31,470,471],{},"Montar un soundboard con tus propios archivos de audio",[31,473,474],{},"Organizar sonidos en pestañas de colores, grupos, etiquetas y búsqueda",[31,476,477],{},"Filtrar por etiquetas (OR) y ordenar por nombre, fecha, duración o tamaño",[31,479,480],{},"Selección múltiple con marco o rango Mayús, luego color, mover o borrar en lote",[31,482,483],{},"Ajustar el volumen por sonido desde el menú contextual",[31,485,486],{},"Diseñar el aspecto con el Theme Creator",[31,488,489],{},"Grabar audio del PC o un micrófono en el Record Editor",[31,491,492],{},"Asignar atajos a sonidos individuales",[31,494,495,496],{},"Disparar sonidos desde ",[356,497,359],{"href":358},[31,499,500],{},"Importar y exportar un soundboard completo para compartirlo",[31,502,503],{},"Usar GIFs o imágenes en los botones — biblioteca local de carpetas o KLIPY",[23,505,507],{"id":506},"licencia","Licencia",[14,509,510,511,517],{},"SoundNinja es software libre bajo ",[356,512,516],{"href":513,"rel":514},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fblob\u002Fmain\u002FLICENSE",[515],"nofollow","GPL-3.0",". Haz fork, cámbialo, compártelo.",[23,519,521],{"id":520},"siguientes-pasos","Siguientes pasos",[118,523,524,530,536],{},[31,525,526],{},[356,527,529],{"href":528},"\u002Fdocs\u002Finstallation","Instalar SoundNinja",[31,531,532],{},[356,533,535],{"href":534},"\u002Fdocs\u002Fadding-sounds","Añadir sonidos",[31,537,538],{},[356,539,541],{"href":540},"\u002Fdocs\u002Forganizing-sounds","Organizar tu tablero",{"title":401,"searchDepth":402,"depth":402,"links":543},[544,545,546,547],{"id":447,"depth":402,"text":448},{"id":465,"depth":402,"text":466},{"id":506,"depth":402,"text":507},{"id":520,"depth":402,"text":521},"Qué es SoundNinja y qué puedes hacer con él.",{},1,"\u002Foverview",{"title":430,"description":548},"overview","XWpBFvtyid6BLXO3HByHppTxfsOo0i7DlSOMew5tq2g",{"id":556,"title":557,"body":558,"description":771,"extension":419,"meta":772,"navigation":421,"order":402,"path":773,"seo":774,"stem":775,"__hash__":776},"content_es\u002Finstallation.md","Instalación",{"type":7,"value":559,"toc":764},[560,563,577,581,601,604,608,622,625,629,654,664,668,675,679,694,724,739,760],[10,561,557],{"id":562},"instalación",[14,564,565,566,570,571,576],{},"Consigue una build en la ",[356,567,569],{"href":568},"\u002Fdownload","página de descarga"," o en ",[356,572,575],{"href":573,"rel":574},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Freleases\u002Flatest",[515],"GitHub Releases",". SoundNinja está en desarrollo temprano, así que trata las builds como beta.",[23,578,580],{"id":579},"windows","Windows",[28,582,583,592,595,598],{},[31,584,585,231,588,591],{},[18,586,587],{},"Instalador (.exe)",[18,589,590],{},"MSI (.msi)"," para Windows de 64 bits",[31,593,594],{},"Objetivo de la landing: Windows 10 y posterior",[31,596,597],{},"El README de la app también lista Windows 8 y superior",[31,599,600],{},"El instalador NSIS usa tema oscuro. Elige idioma en el setup — SoundNinja lo recuerda en el siguiente arranque.",[14,602,603],{},"Ejecuta el instalador y luego abre SoundNinja desde el menú Inicio.",[23,605,607],{"id":606},"macos","macOS",[28,609,610,616,619],{},[31,611,612,615],{},[18,613,614],{},".dmg universal"," para Apple Silicon e Intel",[31,617,618],{},"Objetivo de la landing: macOS 10.14 y posterior",[31,620,621],{},"El README de la app lista macOS 10.15 y superior",[14,623,624],{},"Abre la imagen de disco y arrastra SoundNinja a Aplicaciones.",[23,626,628],{"id":627},"linux","Linux",[28,630,631,637,643,651],{},[31,632,633,636],{},[18,634,635],{},"Debian (.deb)"," para Ubuntu \u002F Debian",[31,638,639,642],{},[18,640,641],{},"AppImage"," para otras distros",[31,644,645,646,650],{},"Tras publicar una release, los usuarios de Arch pueden instalar ",[647,648,649],"code",{},"soundninja-bin"," desde el AUR",[31,652,653],{},"Probado en Ubuntu 20.04",[14,655,656,657,224,660,663],{},"Las builds de escritorio necesitan paquetes WebKit y GTK. En Debian\u002FUbuntu eso suele ser ",[647,658,659],{},"libwebkit2gtk",[647,661,662],{},"libgtk-3-0"," y una biblioteca app-indicator.",[23,665,667],{"id":666},"actualizaciones","Actualizaciones",[14,669,670,671,674],{},"En la app, abre ",[18,672,673],{},"Ayuda → Buscar actualizaciones",". También puedes dejar que SoundNinja compruebe al arrancar en Ajustes.",[23,676,678],{"id":677},"compilar-desde-el-código","Compilar desde el código",[14,680,681,682,687,688,693],{},"¿Necesitas una build personalizada? Clona ",[356,683,686],{"href":684,"rel":685},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja",[515],"el repo",", instala los ",[356,689,692],{"href":690,"rel":691},"https:\u002F\u002Fv2.tauri.app\u002Fstart\u002Fprerequisites\u002F",[515],"requisitos de Tauri"," y luego:",[695,696,700],"pre",{"className":697,"code":698,"language":699,"meta":401,"style":401},"language-bash shiki shiki-themes github-light github-dark","bun install\nbun run tauri:serve\n","bash",[647,701,702,714],{"__ignoreMap":401},[703,704,706,710],"span",{"class":705,"line":550},"line",[703,707,709],{"class":708},"sScJk","bun",[703,711,713],{"class":712},"sZZnC"," install\n",[703,715,716,718,721],{"class":705,"line":402},[703,717,709],{"class":708},[703,719,720],{"class":712}," run",[703,722,723],{"class":712}," tauri:serve\n",[14,725,726,224,729,231,732,735,736,97],{},[647,727,728],{},"npm",[647,730,731],{},"pnpm",[647,733,734],{},"deno"," también sirven. Build de producción: ",[647,737,738],{},"bun run tauri:build",[14,740,741,744,745,750,751,754,755,97],{},[18,742,743],{},"Solo Windows:"," cada compile de Windows incluye ASIO con el ",[356,746,749],{"href":747,"rel":748},"https:\u002F\u002Fwww.steinberg.net\u002Fasiosdk",[515],"Steinberg ASIO SDK",". Ejecuta ",[647,752,753],{},"bun run setup:asio"," una vez (el SDK no está en git). Linux y macOS usan PipeWire \u002F Core Audio — omite ese paso. Detalles: ",[356,756,759],{"href":757,"rel":758},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fblob\u002Fmain\u002Fdocs\u002Fbuild-from-source.md",[515],"build-from-source.md",[761,762,763],"style",{},"html pre.shiki code .sScJk, html code.shiki .sScJk{--shiki-default:#6F42C1;--shiki-dark:#B392F0}html pre.shiki code .sZZnC, html code.shiki .sZZnC{--shiki-default:#032F62;--shiki-dark:#9ECBFF}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html.dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}",{"title":401,"searchDepth":402,"depth":402,"links":765},[766,767,768,769,770],{"id":579,"depth":402,"text":580},{"id":606,"depth":402,"text":607},{"id":627,"depth":402,"text":628},{"id":666,"depth":402,"text":667},{"id":677,"depth":402,"text":678},"Instala SoundNinja en Windows, macOS o Linux.",{},"\u002Finstallation",{"title":557,"description":771},"installation","6QKa3OcTs0sq8JVvjceX-ugwL8mdPc4h6O-JOoo1Qd8",{"id":778,"title":535,"body":779,"description":916,"extension":419,"meta":917,"navigation":421,"order":409,"path":918,"seo":919,"stem":920,"__hash__":921},"content_es\u002Fadding-sounds.md",{"type":7,"value":780,"toc":908},[781,784,787,791,809,813,844,848,867,871,885,888,892,899,903],[10,782,535],{"id":783},"añadir-sonidos",[14,785,786],{},"Un tablero está vacío hasta que añades clips. SoundNinja puede importar archivos, carpetas enteras, una grabación o un pack de soundboard compartido.",[23,788,790],{"id":789},"importar-archivos-de-audio","Importar archivos de audio",[118,792,793,803,806],{},[31,794,122,795,798,799,802],{},[18,796,797],{},"Archivo → Importar archivos de audio",", o usa ",[18,800,801],{},"Importar"," en la barra de navegación.",[31,804,805],{},"Elige uno o más archivos de audio.",[31,807,808],{},"Los sonidos llegan a la pestaña actual.",[23,810,812],{"id":811},"importar-carpetas","Importar carpetas",[118,814,815,824,827],{},[31,816,122,817,820,821,823],{},[18,818,819],{},"Archivo → Importar carpetas"," (o ",[18,822,812],{}," en la barra de navegación).",[31,825,826],{},"Añade una o más carpetas. Arrastra para reordenarlas antes de importar.",[31,828,829,830],{},"Elige cómo llegan:\n",[28,831,832,838],{},[31,833,834,837],{},[18,835,836],{},"Importar como pestañas"," — cada carpeta se convierte en su propia pestaña",[31,839,840,843],{},[18,841,842],{},"Importar a la pestaña actual"," — cada archivo va a la pestaña activa",[23,845,847],{"id":846},"grabar-un-clip","Grabar un clip",[14,849,850,851,855,856,859,860,231,863,866],{},"Abre el ",[356,852,854],{"href":853},"\u002Fdocs\u002Frecording-editor","Record Editor"," desde el botón ",[18,857,858],{},"Grabar"," en la barra del reproductor. Captura, recorta y luego ",[18,861,862],{},"Importar selección",[18,864,865],{},"Importar todo"," en la pestaña actual o en una pestaña que elijas.",[23,868,870],{"id":869},"importar-un-soundboard","Importar un soundboard",[14,872,873,876,877,880,881,884],{},[18,874,875],{},"Archivo → Importar soundboard"," carga un pack compartido. Los packs son un ",[647,878,879],{},".zip"," que contiene ",[647,882,883],{},"project.sninja"," más los archivos de sonido. Tras importar, abre el proyecto y reproduce.",[14,886,887],{},"También puedes tener varios proyectos (perfiles). Usa el selector de proyecto para cambiar de tablero.",[23,889,891],{"id":890},"reenlazar-archivos-faltantes","Reenlazar archivos faltantes",[14,893,894,895,898],{},"Si los archivos de audio se mueven en el disco, SoundNinja muestra ",[18,896,897],{},"Archivos de sonido faltantes",". Elige una carpeta para buscar y reenlazar los clips.",[23,900,902],{"id":901},"siguiente","Siguiente",[14,904,905,906,97],{},"Organiza pestañas, etiquetas, filtros y atajos en ",[356,907,5],{"href":540},{"title":401,"searchDepth":402,"depth":402,"links":909},[910,911,912,913,914,915],{"id":789,"depth":402,"text":790},{"id":811,"depth":402,"text":812},{"id":846,"depth":402,"text":847},{"id":869,"depth":402,"text":870},{"id":890,"depth":402,"text":891},{"id":901,"depth":402,"text":902},"Importa audio, carpetas, grabaciones y soundboards compartidos.",{},"\u002Fadding-sounds",{"title":535,"description":916},"adding-sounds","O5nOJGNq2FL6jafUxqoGYNKJDVbb2UrZRjfKpK21LlQ",{"id":4,"title":5,"body":923,"description":418,"extension":419,"meta":1170,"navigation":421,"order":422,"path":423,"seo":1171,"stem":425,"__hash__":426},{"type":7,"value":924,"toc":1155},[925,927,931,933,949,953,955,957,967,971,975,977,983,985,1005,1007,1011,1013,1033,1037,1039,1041,1059,1061,1063,1071,1073,1077,1091,1101,1105,1107,1113,1115,1117,1121,1127,1131,1133,1137,1141,1153],[10,926,5],{"id":12},[14,928,16,929,21],{},[18,930,20],{},[23,932,26],{"id":25},[28,934,935,939,943],{},[31,936,33,937,37],{},[18,938,36],{},[31,940,40,941,44],{},[18,942,43],{},[31,944,47,945,51,947,55],{},[18,946,50],{},[18,948,54],{},[14,950,58,951,62],{},[18,952,61],{},[23,954,66],{"id":65},[14,956,69],{},[28,958,959,961,963,965],{},[31,960,74],{},[31,962,77],{},[31,964,80],{},[31,966,83],{},[14,968,86,969,90],{},[18,970,89],{},[14,972,93,973,97],{},[18,974,96],{},[23,976,101],{"id":100},[14,978,104,979,108,981,111],{},[18,980,107],{},[18,982,107],{},[113,984,116],{"id":115},[118,986,987,991,997,1001],{},[31,988,122,989,125],{},[18,990,107],{},[31,992,128,993,132,995,136],{},[18,994,131],{},[18,996,135],{},[31,998,139,999,143],{},[18,1000,142],{},[31,1002,146,1003,150],{},[18,1004,149],{},[113,1006,154],{"id":153},[14,1008,157,1009,160],{},[18,1010,131],{},[113,1012,164],{"id":163},[28,1014,1015,1019,1025,