[{"data":1,"prerenderedAt":1790},["ShallowReactive",2],{"docs-page-es-\u002Forganizing-sounds":3,"docs-nav-es":438},{"id":4,"title":5,"body":6,"description":429,"extension":430,"meta":431,"navigation":432,"order":433,"path":434,"seo":435,"stem":436,"__hash__":437},"content_es\u002Forganizing-sounds.md","Organizar sonidos",{"type":7,"value":8,"toc":411},"minimark",[9,13,22,27,56,63,67,70,84,91,98,102,112,117,151,155,161,165,198,204,208,211,239,242,246,259,263,269,290,306,313,317,328,331,335,342,352,361,365,373,380,408],[10,11,5],"h1",{"id":12},"organizar-sonidos",[14,15,16,17,21],"p",{},"SoundNinja está hecho para bibliotecas grandes. ",[18,19,20],"strong",{},"Etiquetas y filtros",", pestañas, búsqueda, selección múltiple y atajos — el clip que necesitas está a un clic (o una tecla).",[23,24,26],"h2",{"id":25},"pestañas","Pestañas",[28,29,30,38,45],"ul",{},[31,32,33,34,37],"li",{},"Añade una pestaña con ",[18,35,36],{},"Añadir pestaña",". Dale un color para escanear la barra rápido.",[31,39,40,41,44],{},"La vista ",[18,42,43],{},"Todos"," muestra cada sonido de todas las pestañas.",[31,46,47,48,51,52,55],{},"Un sonido puede pertenecer a ",[18,49,50],{},"una o más pestañas",". Clic derecho en un sonido y usa ",[18,53,54],{},"Mover a pestaña"," para asignarlo.",[14,57,58,59,62],{},"Las transiciones de pestaña están en ",[18,60,61],{},"Ajustes → General",": Slide, Fade, Botones uno a uno, o Ninguna.",[23,64,66],{"id":65},"grupos","Grupos",[14,68,69],{},"Desde la v0.5.3, los separadores pueden convertirse en grupos con nombre:",[28,71,72,75,78,81],{},[31,73,74],{},"Añadir, renombrar o quitar un grupo desde el menú contextual",[31,76,77],{},"Arrastra la cabecera del grupo — los hijos se mueven con ella",[31,79,80],{},"Suelta sonidos dentro o fuera de un grupo",[31,82,83],{},"Define color de borde, color del nombre y alineación de botones (o usa el valor por defecto de la pestaña)",[14,85,86,87,90],{},"Sigue pudiendo añadir un ",[18,88,89],{},"Separador"," simple si solo necesitas un corte visual.",[14,92,93,94,97],{},"Clic derecho en el espacio vacío del tablero para ",[18,95,96],{},"Añadir grupo",".",[23,99,101],{"id":100},"etiquetas-filtros","Etiquetas \u002F Filtros",[14,103,104,105,108,109,111],{},"Las etiquetas cruzan las pestañas. El panel ",[18,106,107],{},"Filtro"," (barra lateral ",[18,110,107],{},") es donde las creas y filtras el tablero.",[113,114,116],"h3",{"id":115},"crear-y-editar-etiquetas","Crear y editar etiquetas",[118,119,120,126,137,144],"ol",{},[31,121,122,123,125],{},"Abre ",[18,124,107],{}," en la barra lateral.",[31,127,128,129,132,133,136],{},"En ",[18,130,131],{},"Etiquetas",", usa ",[18,134,135],{},"Añadir etiqueta"," — nombre y color.",[31,138,139,140,143],{},"Renombra, recolorea o ",[18,141,142],{},"Eliminar etiqueta"," en la misma lista.",[31,145,146,147,150],{},"Si ves ",[18,148,149],{},"Aún no hay etiquetas",", crea una aquí antes de asignar.",[113,152,154],{"id":153},"asignar-etiquetas-a-sonidos","Asignar etiquetas a sonidos",[14,156,157,158,160],{},"Clic derecho en un sonido → ",[18,159,131],{}," (casillas). Un sonido puede tener varias. Si aún no hay ninguna, el menú te lleva al panel de filtro.",[113,162,164],{"id":163},"filtrar-el-tablero","Filtrar el tablero",[28,166,167,173,184,195],{},[31,168,169,170,97],{},"Activa etiquetas en el panel Filtro o como ",[18,171,172],{},"chips bajo la barra de búsqueda",[31,174,175,176,179,180,183],{},"La coincidencia es ",[18,177,178],{},"OR",": un sonido sigue visible si tiene ",[18,181,182],{},"cualquiera"," de las etiquetas seleccionadas.",[31,185,186,187,190,191,194],{},"El campo ",[18,188,189],{},"Buscar"," combina con ",[18,192,193],{},"AND"," el filtro de etiquetas activo (texto + etiquetas juntos).",[31,196,197],{},"Apaga los chips (o limpia el filtro) para ver de nuevo toda la pestaña.",[14,199,200,201,97],{},"Los nombres de etiqueta en color pueden aparecer en los botones. Actívalos en ",[18,202,203],{},"Ajustes → Comportamiento → Mostrar badges de etiquetas",[23,205,207],{"id":206},"orden","Orden",[14,209,210],{},"Abre el panel de filtro y elige un modo:",[28,212,213,219],{},[31,214,215,218],{},[18,216,217],{},"Definido por el usuario"," — tu orden de pestaña, grupos visibles",[31,220,221,224,225,224,228,231,232,235,236],{},[18,222,223],{},"Nombre",", ",[18,226,227],{},"Fecha de añadido",[18,229,230],{},"Tiempo de reproducción"," o ",[18,233,234],{},"Tamaño de archivo"," — lista plana ordenada; ",[18,237,238],{},"los grupos se ocultan",[14,240,241],{},"Ordenar por duración puede precargar los metadatos de duración la primera vez.",[23,243,245],{"id":244},"reordenar","Reordenar",[14,247,248,249,252,253,256,257,97],{},"Activa arrastrar y soltar en ",[18,250,251],{},"Ajustes → Comportamiento"," (",[18,254,255],{},"Permitir reordenar","). Luego arrastra sonidos y grupos a su sitio. Reordenar aplica en el orden ",[18,258,217],{},[23,260,262],{"id":261},"selección-múltiple","Selección múltiple",[14,264,265,266,268],{},"Activa ",[18,267,262],{}," en la barra de navegación, luego:",[28,270,271,274,280,287],{},[31,272,273],{},"Clic para alternar un sonido",[31,275,276,279],{},[18,277,278],{},"Mayús+clic"," para un rango desde el último ancla",[31,281,282,283,286],{},"Arrastra un ",[18,284,285],{},"marco"," en el espacio vacío del tablero",[31,288,289],{},"Clic en el tablero vacío (o fuera) para limpiar la selección",[14,291,292,293,224,296,224,299,302,303,97],{},"Una barra masiva muestra el recuento, más ",[18,294,295],{},"Color",[18,297,298],{},"Mover a pestaña…",[18,300,301],{},"Eliminar"," y ",[18,304,305],{},"Hecho",[14,307,308,309,312],{},"En selección múltiple, cada botón muestra un ",[18,310,311],{},"chip de ID de 8 caracteres",". Clic derecho en el chip para copiarlo.",[23,314,316],{"id":315},"volumen-por-sonido","Volumen por sonido",[14,318,319,320,323,324,327],{},"Clic derecho → ",[18,321,322],{},"Volumen",". Arrastra el control de 0 % a 100 %. ",[18,325,326],{},"Doble clic"," lo restablece a 100 %.",[14,329,330],{},"Se acumula con el volumen de salida maestro en Ajustes.",[23,332,334],{"id":333},"atajos-e-ids-de-sonido","Atajos e IDs de sonido",[14,336,337,338,341],{},"Cada sonido tiene un ID de 8 caracteres. Cópialo desde el menú contextual del botón (",[18,339,340],{},"Copiar ID",") o el chip de ID de la selección múltiple.",[14,343,122,344,347,348,351],{},[18,345,346],{},"Ajustes → Atajos"," para vincular una tecla a un ID de sonido. Los atajos globales son opcionales. ",[18,349,350],{},"Asignar atajo"," en el menú contextual salta allí con el ID rellenado.",[14,353,354,355,360],{},"El mismo ID es el que ",[356,357,359],"a",{"href":358},"\u002Fdocs\u002Fremote-control","Bitfocus Companion"," usa para disparar un clip.",[23,362,364],{"id":363},"imágenes-de-fondo-y-colores","Imágenes de fondo y colores",[14,366,367,368,372],{},"Clic derecho en un sonido para definir colores por botón o una imagen de fondo. Eso es independiente del ",[356,369,371],{"href":370},"\u002Fdocs\u002Ftheme-editor","Theme Creator",", que da estilo a todo el tablero.",[14,374,375,376,379],{},"El selector es un diálogo ",[18,377,378],{},"Imagen de fondo"," (PNG, JPEG, GIF, WebP):",[28,381,382,388,399],{},[31,383,384,387],{},[18,385,386],{},"Archivos locales"," — añade carpetas, elige un archivo, busca por nombre, previsualiza la cuadrícula o quita una carpeta de la biblioteca",[31,389,390,393,394,97],{},[18,391,392],{},"GifSnap"," — busca GIFs en línea sin clave API. La primera visita pide aceptar las peticiones a GifSnap; los resultados se cachean para reducir tráfico. Ver ",[356,395,392],{"href":396,"rel":397},"https:\u002F\u002Fgifsnap.com",[398],"nofollow",[31,400,401,404,405,407],{},[18,402,403],{},"KLIPY"," — busca GIFs en línea. Pon tu propia clave API en ",[18,406,251],{},". La clave no se guarda en los archivos del proyecto.",[14,409,410],{},"Tras elegir, mueve y recorta la imagen en el botón.",{"title":412,"searchDepth":413,"depth":413,"links":414},"",2,[415,416,417,423,424,425,426,427,428],{"id":25,"depth":413,"text":26},{"id":65,"depth":413,"text":66},{"id":100,"depth":413,"text":101,"children":418},[419,421,422],{"id":115,"depth":420,"text":116},3,{"id":153,"depth":420,"text":154},{"id":163,"depth":420,"text":164},{"id":206,"depth":413,"text":207},{"id":244,"depth":413,"text":245},{"id":261,"depth":413,"text":262},{"id":315,"depth":413,"text":316},{"id":333,"depth":413,"text":334},{"id":363,"depth":413,"text":364},"Etiquetas, filtros, pestañas, grupos, orden, selección múltiple, volumen y atajos.","md",{},true,4,"\u002Forganizing-sounds",{"title":5,"description":429},"organizing-sounds","v2Vh-pefsaiWoUdwQrv4wMerfeXZbtLIa6iq8beVync",[439,565,787,932,1189,1324,1470,1692],{"id":440,"title":441,"body":442,"description":558,"extension":430,"meta":559,"navigation":432,"order":560,"path":561,"seo":562,"stem":563,"__hash__":564},"content_es\u002Foverview.md","Resumen",{"type":7,"value":443,"toc":552},[444,447,450,453,456,460,474,478,515,519,528,532],[10,445,441],{"id":446},"resumen",[14,448,449],{},"SoundNinja es un soundboard de código abierto para streaming en directo, charlas con amigos y grabación de podcasts. Está construido con Tauri v2 y Nuxt 4 para que sea ligero en RAM y disco.",[14,451,452],{},"El objetivo es simple: mantener una biblioteca enorme fácil de recorrer y reproducir el clip correcto en milisegundos. La interfaz también funciona bien como panel en VR.",[14,454,455],{},"SoundNinja sigue en desarrollo temprano. Las funciones marchan, pero no todas las plataformas están del todo probadas.",[23,457,459],{"id":458},"para-quién","Para quién",[28,461,462,465,468,471],{},[31,463,464],{},"Streamers que necesitan cues de sonido al instante",[31,466,467],{},"Amigos que quieren un tablero compartido para el chat de voz",[31,469,470],{},"Podcasters que graban clips y los sueltan en un tablero",[31,472,473],{},"Quien quiera un soundboard personalizable y local-first",[23,475,477],{"id":476},"qué-puedes-hacer","Qué puedes hacer",[28,479,480,483,486,489,492,495,498,501,504,509,512],{},[31,481,482],{},"Montar un soundboard con tus propios archivos de audio",[31,484,485],{},"Organizar sonidos en pestañas de colores, grupos, etiquetas y búsqueda",[31,487,488],{},"Filtrar por etiquetas (OR) y ordenar por nombre, fecha, duración o tamaño",[31,490,491],{},"Selección múltiple con marco o rango Mayús, luego color, mover o borrar en lote",[31,493,494],{},"Ajustar el volumen por sonido desde el menú contextual",[31,496,497],{},"Diseñar el aspecto con el Theme Creator",[31,499,500],{},"Grabar audio del PC o un micrófono en el Record Editor",[31,502,503],{},"Asignar atajos a sonidos individuales",[31,505,506,507],{},"Disparar sonidos desde ",[356,508,359],{"href":358},[31,510,511],{},"Importar y exportar un soundboard completo para compartirlo",[31,513,514],{},"Usar GIFs o imágenes en los botones — biblioteca local de carpetas, GifSnap o KLIPY",[23,516,518],{"id":517},"licencia","Licencia",[14,520,521,522,527],{},"SoundNinja es software libre bajo ",[356,523,526],{"href":524,"rel":525},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fblob\u002Fmain\u002FLICENSE",[398],"GPL-3.0",". Haz fork, cámbialo, compártelo.",[23,529,531],{"id":530},"siguientes-pasos","Siguientes pasos",[118,533,534,540,546],{},[31,535,536],{},[356,537,539],{"href":538},"\u002Fdocs\u002Finstallation","Instalar SoundNinja",[31,541,542],{},[356,543,545],{"href":544},"\u002Fdocs\u002Fadding-sounds","Añadir sonidos",[31,547,548],{},[356,549,551],{"href":550},"\u002Fdocs\u002Forganizing-sounds","Organizar tu tablero",{"title":412,"searchDepth":413,"depth":413,"links":553},[554,555,556,557],{"id":458,"depth":413,"text":459},{"id":476,"depth":413,"text":477},{"id":517,"depth":413,"text":518},{"id":530,"depth":413,"text":531},"Qué es SoundNinja y qué puedes hacer con él.",{},1,"\u002Foverview",{"title":441,"description":558},"overview","aVQIpArgBh8Yx660xBvwTxx-97ukf5Chr1A7jNPd3UE",{"id":566,"title":567,"body":568,"description":781,"extension":430,"meta":782,"navigation":432,"order":413,"path":783,"seo":784,"stem":785,"__hash__":786},"content_es\u002Finstallation.md","Instalación",{"type":7,"value":569,"toc":774},[570,573,587,591,611,614,618,632,635,639,664,674,678,685,689,704,734,749,770],[10,571,567],{"id":572},"instalación",[14,574,575,576,580,581,586],{},"Consigue una build en la ",[356,577,579],{"href":578},"\u002Fdownload","página de descarga"," o en ",[356,582,585],{"href":583,"rel":584},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Freleases\u002Flatest",[398],"GitHub Releases",". SoundNinja está en desarrollo temprano, así que trata las builds como beta.",[23,588,590],{"id":589},"windows","Windows",[28,592,593,602,605,608],{},[31,594,595,231,598,601],{},[18,596,597],{},"Instalador (.exe)",[18,599,600],{},"MSI (.msi)"," para Windows de 64 bits",[31,603,604],{},"Objetivo de la landing: Windows 10 y posterior",[31,606,607],{},"El README de la app también lista Windows 8 y superior",[31,609,610],{},"El instalador NSIS usa tema oscuro. Elige idioma en el setup — SoundNinja lo recuerda en el siguiente arranque.",[14,612,613],{},"Ejecuta el instalador y luego abre SoundNinja desde el menú Inicio.",[23,615,617],{"id":616},"macos","macOS",[28,619,620,626,629],{},[31,621,622,625],{},[18,623,624],{},".dmg universal"," para Apple Silicon e Intel",[31,627,628],{},"Objetivo de la landing: macOS 10.14 y posterior",[31,630,631],{},"El README de la app lista macOS 10.15 y superior",[14,633,634],{},"Abre la imagen de disco y arrastra SoundNinja a Aplicaciones.",[23,636,638],{"id":637},"linux","Linux",[28,640,641,647,653,661],{},[31,642,643,646],{},[18,644,645],{},"Debian (.deb)"," para Ubuntu \u002F Debian",[31,648,649,652],{},[18,650,651],{},"AppImage"," para otras distros",[31,654,655,656,660],{},"Tras publicar una release, los usuarios de Arch pueden instalar ",[657,658,659],"code",{},"soundninja-bin"," desde el AUR",[31,662,663],{},"Probado en Ubuntu 20.04",[14,665,666,667,224,670,673],{},"Las builds de escritorio necesitan paquetes WebKit y GTK. En Debian\u002FUbuntu eso suele ser ",[657,668,669],{},"libwebkit2gtk",[657,671,672],{},"libgtk-3-0"," y una biblioteca app-indicator.",[23,675,677],{"id":676},"actualizaciones","Actualizaciones",[14,679,680,681,684],{},"En la app, abre ",[18,682,683],{},"Ayuda → Buscar actualizaciones",". También puedes dejar que SoundNinja compruebe al arrancar en Ajustes.",[23,686,688],{"id":687},"compilar-desde-el-código","Compilar desde el código",[14,690,691,692,697,698,703],{},"¿Necesitas una build personalizada? Clona ",[356,693,696],{"href":694,"rel":695},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja",[398],"el repo",", instala los ",[356,699,702],{"href":700,"rel":701},"https:\u002F\u002Fv2.tauri.app\u002Fstart\u002Fprerequisites\u002F",[398],"requisitos de Tauri"," y luego:",[705,706,710],"pre",{"className":707,"code":708,"language":709,"meta":412,"style":412},"language-bash shiki shiki-themes github-light github-dark","bun install\nbun run tauri:serve\n","bash",[657,711,712,724],{"__ignoreMap":412},[713,714,716,720],"span",{"class":715,"line":560},"line",[713,717,719],{"class":718},"sScJk","bun",[713,721,723],{"class":722},"sZZnC"," install\n",[713,725,726,728,731],{"class":715,"line":413},[713,727,719],{"class":718},[713,729,730],{"class":722}," run",[713,732,733],{"class":722}," tauri:serve\n",[14,735,736,224,739,231,742,745,746,97],{},[657,737,738],{},"npm",[657,740,741],{},"pnpm",[657,743,744],{},"deno"," también sirven. Build de producción: ",[657,747,748],{},"bun run tauri:build",[14,750,751,754,755,760,761,764,765,97],{},[18,752,753],{},"Solo Windows:"," cada compile de Windows incluye ASIO con el ",[356,756,759],{"href":757,"rel":758},"https:\u002F\u002Fwww.steinberg.net\u002Fasiosdk",[398],"Steinberg ASIO SDK",". Ejecuta ",[657,762,763],{},"bun run setup:asio"," una vez (el SDK no está en git). Linux y macOS usan PipeWire \u002F Core Audio — omite ese paso. Detalles: ",[356,766,769],{"href":767,"rel":768},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fblob\u002Fmain\u002Fdocs\u002Fbuild-from-source.md",[398],"build-from-source.md",[771,772,773],"style",{},"html pre.shiki code .sScJk, html code.shiki .sScJk{--shiki-default:#6F42C1;--shiki-dark:#B392F0}html pre.shiki code .sZZnC, html code.shiki .sZZnC{--shiki-default:#032F62;--shiki-dark:#9ECBFF}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html.dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}",{"title":412,"searchDepth":413,"depth":413,"links":775},[776,777,778,779,780],{"id":589,"depth":413,"text":590},{"id":616,"depth":413,"text":617},{"id":637,"depth":413,"text":638},{"id":676,"depth":413,"text":677},{"id":687,"depth":413,"text":688},"Instala SoundNinja en Windows, macOS o Linux.",{},"\u002Finstallation",{"title":567,"description":781},"installation","6QKa3OcTs0sq8JVvjceX-ugwL8mdPc4h6O-JOoo1Qd8",{"id":788,"title":545,"body":789,"description":926,"extension":430,"meta":927,"navigation":432,"order":420,"path":928,"seo":929,"stem":930,"__hash__":931},"content_es\u002Fadding-sounds.md",{"type":7,"value":790,"toc":918},[791,794,797,801,819,823,854,858,877,881,895,898,902,909,913],[10,792,545],{"id":793},"añadir-sonidos",[14,795,796],{},"Un tablero está vacío hasta que añades clips. SoundNinja puede importar archivos, carpetas enteras, una grabación o un pack de soundboard compartido.",[23,798,800],{"id":799},"importar-archivos-de-audio","Importar archivos de audio",[118,802,803,813,816],{},[31,804,122,805,808,809,812],{},[18,806,807],{},"Archivo → Importar archivos de audio",", o usa ",[18,810,811],{},"Importar"," en la barra de navegación.",[31,814,815],{},"Elige uno o más archivos de audio.",[31,817,818],{},"Los sonidos llegan a la pestaña actual.",[23,820,822],{"id":821},"importar-carpetas","Importar carpetas",[118,824,825,834,837],{},[31,826,122,827,830,831,833],{},[18,828,829],{},"Archivo → Importar carpetas"," (o ",[18,832,822],{}," en la barra de navegación).",[31,835,836],{},"Añade una o más carpetas. Arrastra para reordenarlas antes de importar.",[31,838,839,840],{},"Elige cómo llegan:\n",[28,841,842,848],{},[31,843,844,847],{},[18,845,846],{},"Importar como pestañas"," — cada carpeta se convierte en su propia pestaña",[31,849,850,853],{},[18,851,852],{},"Importar a la pestaña actual"," — cada archivo va a la pestaña activa",[23,855,857],{"id":856},"grabar-un-clip","Grabar un clip",[14,859,860,861,865,866,869,870,231,873,876],{},"Abre el ",[356,862,864],{"href":863},"\u002Fdocs\u002Frecording-editor","Record Editor"," desde el botón ",[18,867,868],{},"Grabar"," en la barra del reproductor. Captura, recorta y luego ",[18,871,872],{},"Importar selección",[18,874,875],{},"Importar todo"," en la pestaña actual o en una pestaña que elijas.",[23,878,880],{"id":879},"importar-un-soundboard","Importar un soundboard",[14,882,883,886,887,890,891,894],{},[18,884,885],{},"Archivo → Importar soundboard"," carga un pack compartido. Los packs son un ",[657,888,889],{},".zip"," que contiene ",[657,892,893],{},"project.sninja"," más los archivos de sonido. Tras importar, abre el proyecto y reproduce.",[14,896,897],{},"También puedes tener varios proyectos (perfiles). Usa el selector de proyecto para cambiar de tablero.",[23,899,901],{"id":900},"reenlazar-archivos-faltantes","Reenlazar archivos faltantes",[14,903,904,905,908],{},"Si los archivos de audio se mueven en el disco, SoundNinja muestra ",[18,906,907],{},"Archivos de sonido faltantes",". Elige una carpeta para buscar y reenlazar los clips.",[23,910,912],{"id":911},"siguiente","Siguiente",[14,914,915,916,97],{},"Organiza pestañas, etiquetas, filtros y atajos en ",[356,917,5],{"href":550},{"title":412,"searchDepth":413,"depth":413,"links":919},[920,921,922,923,924,925],{"id":799,"depth":413,"text":800},{"id":821,"depth":413,"text":822},{"id":856,"depth":413,"text":857},{"id":879,"depth":413,"text":880},{"id":900,"depth":413,"text":901},{"id":911,"depth":413,"text":912},"Importa audio, carpetas, grabaciones y soundboards compartidos.",{},"\u002Fadding-sounds",{"title":545,"description":926},"adding-sounds","O5nOJGNq2FL6jafUxqoGYNKJDVbb2UrZRjfKpK21LlQ",{"id":4,"title":5,"body":933,"description":429,"extension":430,"meta":1187,"navigation":432,"order":433,"path":434,"seo":1188,"stem":436,"__hash__":437},{"type":7,"value":934,"toc":1172},[935,937,941,943,959,963,965,967,977,981,985,987,993,995,1015,1017,1021,1023,1043,1047,1049,1051,1069,1071,1073,1081,1083,1087,1101,1111,1115,1117,1123,1125,1127,1131,1137,1141,1143,1147,1151,1170],[10,936,5],{"id":12},[14,938,16,939,21],{},[18,940,20],{},[23,942,26],{"id":25},[28,944,945,949,953],{},[31,946,33,947,37],{},[18,948,36],{},[31,950,40,951,44],{},[18,952,43],{},[31,954,47,955,51,957,55],{},[18,956,50],{},[18,958,54],{},[14,960,58,961,62],{},[18,962,61],{},[23,964,66],{"id":65},[14,966,69],{},[28,968,969,971,973,975],{},[31,970,74],{},[31,972,77],{},[31,974,80],{},[31,976,83],{},[14,978,86,979,90],{},[18,980,89],{},[14,982,93,983,97],{},[18,984,96],{},[23,986,101],{"id":100},[14,988,104,989,108,991,111],{},[18,990,107],{},[18,992,107],{},[113,994,116],{"id":115},[118,996,997,1001,1007,1011],{},[31,998,122,99