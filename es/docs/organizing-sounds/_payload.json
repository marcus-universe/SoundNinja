nes",[31,1253,1254],{},"Opacidad del overlay GIF (normal y hover)",[23,1256,1258],{"id":1257},"guardar-y-compartir","Guardar y compartir",[28,1260,1261,1267,1273,1279],{},[31,1262,1263,1266],{},[18,1264,1265],{},"Exportar .css"," — escribe un archivo de tema para respaldar o enviar a un amigo",[31,1268,1269,1272],{},[18,1270,1271],{},"Añadir a temas"," — guarda el archivo en tu carpeta Themes y aplícalo",[31,1274,1275,1278],{},[18,1276,1277],{},"Importar .css"," — carga un preset integrado o un tema guardado",[31,1280,1281,1284],{},[18,1282,1283],{},"Restablecer"," — vuelve a los valores por defecto de SoundNinja",[14,1286,1287],{},"Si cierras la ventana con cambios sin guardar, SoundNinja te pide que guardes primero.",[23,1289,1291],{"id":1290},"sin-el-editor-completo","Sin el editor completo",[14,1293,128,1294,1296],{},[18,1295,61],{}," aún puedes:",[28,1298,1299,1302,1308],{},[31,1300,1301],{},"Elegir un tema de la lista",[31,1303,1304,1305,1222],{},"Editar variables CSS en vivo (",[18,1306,1307],{},"CSS personalizado",[31,1309,1310],{},"Importar un archivo de tema a la carpeta Themes",{"title":412,"searchDepth":413,"depth":413,"links":1312},[1313,1314,1315,1316],{"id":1205,"depth":413,"text":1206},{"id":1239,"depth":413,"text":1240},{"id":1257,"depth":413,"text":1258},{"id":1290,"depth":413,"text":1291},"Diseña colores, fuentes, botones y pestañas en el Theme Creator.",{},5,"\u002Ftheme-editor",{"title":1191,"description":1317},"theme-editor","bPcJP7OLtBsnNMYJ-S1J6DmB6nngULo1_Q1hBJMNZAQ",{"id":1325,"title":1326,"body":1327,"description":1463,"extension":430,"meta":1464,"navigation":432,"order":1465,"path":1466,"seo":1467,"stem":1468,"__hash__":1469},"content_es\u002Frecording-editor.md","Editor de grabación",{"type":7,"value":1328,"toc":1457},[1329,1332,1338,1342,1348,1368,1371,1375,1400,1404,1418,1422,1436,1447],[10,1330,1326],{"id":1331},"editor-de-grabación",[14,1333,1334,1335,1337],{},"Graba un clip dentro de SoundNinja, recórtalo e impórtalo a una pestaña. Abre el editor con el botón ",[18,1336,868],{}," en la barra del reproductor.",[23,1339,1341],{"id":1340},"elegir-una-entrada","Elegir una entrada",[14,1343,128,1344,1347],{},[18,1345,1346],{},"Ajustes → Audio",":",[28,1349,1350,1356,1362],{},[31,1351,1352,1355],{},[18,1353,1354],{},"Dispositivos de entrada"," — micrófono",[31,1357,1358,1361],{},[18,1359,1360],{},"Dispositivos de salida (audio del PC)"," — loopback de lo que reproduce el PC",[31,1363,1364,1367],{},[18,1365,1366],{},"Volumen de entrada"," — ganancia de captura del 0 % al 200 %",[14,1369,1370],{},"El botón Grabar usa el dispositivo que eliges aquí.",[23,1372,1374],{"id":1373},"editar-la-toma","Editar la toma",[28,1376,1377,1380,1383,1391,1394,1397],{},[31,1378,1379],{},"Grabar y detener",[31,1381,1382],{},"Observar el medidor de nivel de entrada",[31,1384,1385,231,1388],{},[18,1386,1387],{},"Normalizar",[18,1389,1390],{},"Cancelación de ruido",[31,1392,1393],{},"Recortar todo el clip, recortar a una selección o borrar una selección",[31,1395,1396],{},"Deshacer \u002F rehacer",[31,1398,1399],{},"Acercar y alejar",[23,1401,1403],{"id":1402},"preparar-e-importar","Preparar e importar",[118,1405,1406,1409,1412],{},[31,1407,1408],{},"Añade la selección o la pista completa a la lista de staging.",[31,1410,1411],{},"La lista empieza vacía: graba, edita y luego añade un clip.",[31,1413,1414,231,1416,876],{},[18,1415,872],{},[18,1417,875],{},[23,1419,1421],{"id":1420},"separación-de-stems-opcional","Separación de stems (opcional)",[14,1423,1424,1425,1428,1429,231,1432,1435],{},"Las builds oficiales de Windows, macOS y Linux incluyen la función ",[18,1426,1427],{},"stems",". El Record Editor puede conservar ",[18,1430,1431],{},"voces",[18,1433,1434],{},"música"," con BS-RoFormer.",[14,1437,1438,1439,1442,1443,1446],{},"El modelo pesa unos 158 MB y ",[18,1440,1441],{},"no"," viene en el instalador. Descárgalo desde ",[18,1444,1445],{},"Ajustes → Separación de stems",", o acepta el aviso del primer arranque. El i