[{"data":1,"prerenderedAt":1334},["ShallowReactive",2],{"docs-page-es-\u002Forganizing-sounds":3,"docs-nav-es":175},{"id":4,"title":5,"body":6,"description":166,"extension":167,"meta":168,"navigation":169,"order":170,"path":171,"seo":172,"stem":173,"__hash__":174},"content_es\u002Forganizing-sounds.md","Organizar sonidos",{"type":7,"value":8,"toc":155},"minimark",[9,13,17,22,52,59,63,66,80,87,91,98,102,113,117,120,124,127,134,143,147],[10,11,5],"h1",{"id":12},"organizar-sonidos",[14,15,16],"p",{},"SoundNinja está hecho para bibliotecas grandes. Usa pestañas, grupos, búsqueda y atajos para que el clip que necesitas esté a un clic (o una tecla) de distancia.",[18,19,21],"h2",{"id":20},"pestañas","Pestañas",[23,24,25,34,41],"ul",{},[26,27,28,29,33],"li",{},"Añade una pestaña con ",[30,31,32],"strong",{},"Añadir pestaña",". Dale un color para escanear la barra rápido.",[26,35,36,37,40],{},"La vista ",[30,38,39],{},"Todos"," muestra cada sonido de todas las pestañas.",[26,42,43,44,47,48,51],{},"Un sonido puede pertenecer a ",[30,45,46],{},"una o más pestañas",". Clic derecho en un sonido y usa ",[30,49,50],{},"Mover a pestaña"," para asignarlo.",[14,53,54,55,58],{},"Las transiciones de pestaña están en ",[30,56,57],{},"Ajustes → General",": Slide, Fade, Botones uno a uno, o Ninguna.",[18,60,62],{"id":61},"grupos","Grupos",[14,64,65],{},"Desde la v0.5.3, los separadores pueden convertirse en grupos con nombre:",[23,67,68,71,74,77],{},[26,69,70],{},"Añadir, renombrar o quitar un grupo desde el menú contextual",[26,72,73],{},"Arrastra la cabecera del grupo — los hijos se mueven con ella",[26,75,76],{},"Suelta sonidos dentro o fuera de un grupo",[26,78,79],{},"Define color de borde, color del nombre y alineación de botones (o usa el valor por defecto de la pestaña)",[14,81,82,83,86],{},"Sigue pudiendo añadir un ",[30,84,85],{},"Separador"," simple si solo necesitas un corte visual.",[18,88,90],{"id":89},"búsqueda","Búsqueda",[14,92,93,94,97],{},"Usa el campo ",[30,95,96],{},"Buscar"," en la barra de navegación. Los resultados se actualizan mientras escribes.",[18,99,101],{"id":100},"reordenar","Reordenar",[14,103,104,105,108,109,112],{},"Activa arrastrar y soltar en ",[30,106,107],{},"Ajustes → Comportamiento"," (",[30,110,111],{},"Permitir reordenar","). Luego arrastra sonidos y grupos a su sitio.",[18,114,116],{"id":115},"edición-masiva","Edición masiva",[14,118,119],{},"Selecciona varios sonidos y cambia el color, muévelos a una pestaña o elimínalos de una vez.",[18,121,123],{"id":122},"atajos-e-ids-de-sonido","Atajos e IDs de sonido",[14,125,126],{},"Cada sonido tiene un ID de 8 caracteres. Cópialo desde el menú contextual del botón o el chip de ID de la selección múltiple.",[14,128,129,130,133],{},"Abre ",[30,131,132],{},"Ajustes → Atajos"," para vincular una tecla a un ID de sonido. Los atajos globales son opcionales.",[14,135,136,137,142],{},"El mismo ID es el que ",[138,139,141],"a",{"href":140},"\u002Fdocs\u002Fremote-control","Bitfocus Companion"," usa para disparar un clip.",[18,144,146],{"id":145},"gifs-y-colores","GIFs y colores",[14,148,149,150,154],{},"Clic derecho en un sonido para definir colores por botón o un fondo GIF \u002F imagen. Eso es independiente del ",[138,151,153],{"href":152},"\u002Fdocs\u002Ftheme-editor","Theme Creator",", que da estilo a todo el tablero.",{"title":156,"searchDepth":157,"depth":157,"links":158},"",2,[159,160,161,162,163,164,165],{"id":20,"depth":157,"text":21},{"id":61,"depth":157,"text":62},{"id":89,"depth":157,"text":90},{"id":100,"depth":157,"text":101},{"id":115,"depth":157,"text":116},{"id":122,"depth":157,"text":123},{"id":145,"depth":157,"text":146},"Pestañas, grupos, búsqueda, edición masiva y atajos.","md",{},true,4,"\u002Forganizing-sounds",{"title":5,"description":166},"organizing-sounds","L2-ttc1gCTlJQIkJYckTzh-JzPPPTLU4m0uGjwPApXk",[176,295,496,642,736,872,1014,1236],{"id":177,"title":178,"body":179,"description":288,"extension":167,"meta":289,"navigation":169,"order":290,"path":291,"seo":292,"stem":293,"__hash__":294},"content_es\u002Foverview.md","Resumen",{"type":7,"value":180,"toc":282},[181,184,187,190,193,197,211,215,243,247,257,261],[10,182,178],{"id":183},"resumen",[14,185,186],{},"SoundNinja es un soundboard de código abierto para streaming en directo, charlas con amigos y grabación de podcasts. Está construido con Tauri v2 y Nuxt 4 para que sea ligero en RAM y disco.",[14,188,189],{},"El objetivo es simple: mantener una biblioteca enorme fácil de recorrer y reproducir el clip correcto en milisegundos. La interfaz también funciona bien como panel en VR.",[14,191,192],{},"SoundNinja sigue en desarrollo temprano. Las funciones marchan, pero no todas las plataformas están del todo probadas.",[18,194,196],{"id":195},"para-quién","Para quién",[23,198,199,202,205,208],{},[26,200,201],{},"Streamers que necesitan cues de sonido al instante",[26,203,204],{},"Amigos que quieren un tablero compartido para el chat de voz",[26,206,207],{},"Podcasters que graban clips y los sueltan en un tablero",[26,209,210],{},"Quien quiera un soundboard personalizable y local-first",[18,212,214],{"id":213},"qué-puedes-hacer","Qué puedes hacer",[23,216,217,220,223,226,229,232,237,240],{},[26,218,219],{},"Montar un soundboard con tus propios archivos de audio",[26,221,222],{},"Organizar sonidos en pestañas de colores, grupos y búsqueda",[26,224,225],{},"Diseñar el aspecto con el Theme Creator",[26,227,228],{},"Grabar audio del PC o un micrófono en el Record Editor",[26,230,231],{},"Asignar atajos a sonidos individuales",[26,233,234,235],{},"Disparar sonidos desde ",[138,236,141],{"href":140},[26,238,239],{},"Importar y exportar un soundboard completo para compartirlo",[26,241,242],{},"Usar GIFs o imágenes en los botones de sonido",[18,244,246],{"id":245},"licencia","Licencia",[14,248,249,250,256],{},"SoundNinja es software libre bajo ",[138,251,255],{"href":252,"rel":253},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fblob\u002Fmain\u002FLICENSE",[254],"nofollow","GPL-3.0",". Haz fork, cámbialo, compártelo.",[18,258,260],{"id":259},"siguientes-pasos","Siguientes pasos",[262,263,264,270,276],"ol",{},[26,265,266],{},[138,267,269],{"href":268},"\u002Fdocs\u002Finstallation","Instalar SoundNinja",[26,271,272],{},[138,273,275],{"href":274},"\u002Fdocs\u002Fadding-sounds","Añadir sonidos",[26,277,278],{},[138,279,281],{"href":280},"\u002Fdocs\u002Forganizing-sounds","Organizar tu tablero",{"title":156,"searchDepth":157,"depth":157,"links":283},[284,285,286,287],{"id":195,"depth":157,"text":196},{"id":213,"depth":157,"text":214},{"id":245,"depth":157,"text":246},{"id":259,"depth":157,"text":260},"Qué es SoundNinja y qué puedes hacer con él.",{},1,"\u002Foverview",{"title":178,"description":288},"overview","_jbFAqK9Ea28XfzNs3a2S9mJrWOMez_Uxtm9qlYTevc",{"id":296,"title":297,"body":298,"description":490,"extension":167,"meta":491,"navigation":169,"order":157,"path":492,"seo":493,"stem":494,"__hash__":495},"content_es\u002Finstallation.md","Instalación",{"type":7,"value":299,"toc":483},[300,303,317,321,339,342,346,360,363,367,392,403,407,414,418,433,463,479],[10,301,297],{"id":302},"instalación",[14,304,305,306,310,311,316],{},"Consigue una build en la ",[138,307,309],{"href":308},"\u002Fdownload","página de descarga"," o en ",[138,312,315],{"href":313,"rel":314},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Freleases\u002Flatest",[254],"GitHub Releases",". SoundNinja está en desarrollo temprano, así que trata las builds como beta.",[18,318,320],{"id":319},"windows","Windows",[23,322,323,333,336],{},[26,324,325,328,329,332],{},[30,326,327],{},"Instalador (.exe)"," o ",[30,330,331],{},"MSI (.msi)"," para Windows de 64 bits",[26,334,335],{},"Objetivo de la landing: Windows 10 y posterior",[26,337,338],{},"El README de la app también lista Windows 8 y superior",[14,340,341],{},"Ejecuta el instalador y luego abre SoundNinja desde el menú Inicio.",[18,343,345],{"id":344},"macos","macOS",[23,347,348,354,357],{},[26,349,350,353],{},[30,351,352],{},".dmg universal"," para Apple Silicon e Intel",[26,355,356],{},"Objetivo de la landing: macOS 10.14 y posterior",[26,358,359],{},"El README de la app lista macOS 10.15 y superior",[14,361,362],{},"Abre la imagen de disco y arrastra SoundNinja a Aplicaciones.",[18,364,366],{"id":365},"linux","Linux",[23,368,369,375,381,389],{},[26,370,371,374],{},[30,372,373],{},"Debian (.deb)"," para Ubuntu \u002F Debian",[26,376,377,380],{},[30,378,379],{},"AppImage"," para otras distros",[26,382,383,384,388],{},"Tras publicar una release, los usuarios de Arch pueden instalar ",[385,386,387],"code",{},"soundninja-bin"," desde el AUR",[26,390,391],{},"Probado en Ubuntu 20.04",[14,393,394,395,398,399,402],{},"Las builds de escritorio necesitan paquetes WebKit y GTK. En Debian\u002FUbuntu eso suele ser ",[385,396,397],{},"libwebkit2gtk",", ",[385,400,401],{},"libgtk-3-0"," y una biblioteca app-indicator.",[18,404,406],{"id":405},"actualizaciones","Actualizaciones",[14,408,409,410,413],{},"En la app, abre ",[30,411,412],{},"Ayuda → Buscar actualizaciones",". También puedes dejar que SoundNinja compruebe al arrancar en Ajustes.",[18,415,417],{"id":416},"compilar-desde-el-código","Compilar desde el código",[14,419,420,421,426,427,432],{},"¿Necesitas una build personalizada? Clona ",[138,422,425],{"href":423,"rel":424},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja",[254],"el repo",", instala los ",[138,428,431],{"href":429,"rel":430},"https:\u002F\u002Fv2.tauri.app\u002Fstart\u002Fprerequisites\u002F",[254],"requisitos de Tauri"," y luego:",[434,435,439],"pre",{"className":436,"code":437,"language":438,"meta":156,"style":156},"language-bash shiki shiki-themes github-light github-dark","bun install\nbun run tauri:serve\n","bash",[385,440,441,453],{"__ignoreMap":156},[442,443,445,449],"span",{"class":444,"line":290},"line",[442,446,448],{"class":447},"sScJk","bun",[442,450,452],{"class":451},"sZZnC"," install\n",[442,454,455,457,460],{"class":444,"line":157},[442,456,448],{"class":447},[442,458,459],{"class":451}," run",[442,461,462],{"class":451}," tauri:serve\n",[14,464,465,398,468,328,471,474,475,478],{},[385,466,467],{},"npm",[385,469,470],{},"pnpm",[385,472,473],{},"deno"," también sirven. Build de producción: ",[385,476,477],{},"bun run tauri:build",".",[480,481,482],"style",{},"html pre.shiki code .sScJk, html code.shiki .sScJk{--shiki-default:#6F42C1;--shiki-dark:#B392F0}html pre.shiki code .sZZnC, html code.shiki .sZZnC{--shiki-default:#032F62;--shiki-dark:#9ECBFF}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html.dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}",{"title":156,"searchDepth":157,"depth":157,"links":484},[485,486,487,488,489],{"id":319,"depth":157,"text":320},{"id":344,"depth":157,"text":345},{"id":365,"depth":157,"text":366},{"id":405,"depth":157,"text":406},{"id":416,"depth":157,"text":417},"Instala SoundNinja en Windows, macOS o Linux.",{},"\u002Finstallation",{"title":297,"description":490},"installation","DZ0nnkuNJ5bWc2nnZMQjtBcj72EEzzogekGEbJUmx80",{"id":497,"title":275,"body":498,"description":635,"extension":167,"meta":636,"navigation":169,"order":637,"path":638,"seo":639,"stem":640,"__hash__":641},"content_es\u002Fadding-sounds.md",{"type":7,"value":499,"toc":627},[500,503,506,510,528,532,563,567,586,590,604,607,611,618,622],[10,501,275],{"id":502},"añadir-sonidos",[14,504,505],{},"Un tablero está vacío hasta que añades clips. SoundNinja puede importar archivos, carpetas enteras, una grabación o un pack de soundboard compartido.",[18,507,509],{"id":508},"importar-archivos-de-audio","Importar archivos de audio",[262,511,512,522,525],{},[26,513,129,514,517,518,521],{},[30,515,516],{},"Archivo → Importar archivos de audio",", o usa ",[30,519,520],{},"Importar"," en la barra de navegación.",[26,523,524],{},"Elige uno o más archivos de audio.",[26,526,527],{},"Los sonidos llegan a la pestaña actual.",[18,529,531],{"id":530},"importar-carpetas","Importar carpetas",[262,533,534,543,546],{},[26,535,129,536,539,540,542],{},[30,537,538],{},"Archivo → Importar carpetas"," (o ",[30,541,531],{}," en la barra de navegación).",[26,544,545],{},"Añade una o más carpetas. Arrastra para reordenarlas antes de importar.",[26,547,548,549],{},"Elige cómo llegan:\n",[23,550,551,557],{},[26,552,553,556],{},[30,554,555],{},"Importar como pestañas"," — cada carpeta se convierte en su propia pestaña",[26,558,559,562],{},[30,560,561],{},"Importar a la pestaña actual"," — cada archivo va a la pestaña activa",[18,564,566],{"id":565},"grabar-un-clip","Grabar un clip",[14,568,569,570,574,575,578,579,328,582,585],{},"Abre el ",[138,571,573],{"href":572},"\u002Fdocs\u002Frecording-editor","Record Editor"," desde el botón ",[30,576,577],{},"Grabar"," en la barra del reproductor. Captura, recorta y luego ",[30,580,581],{},"Importar selección",[30,583,584],{},"Importar todo"," en la pestaña actual o en una pestaña que elijas.",[18,587,589],{"id":588},"importar-un-soundboard","Importar un soundboard",[14,591,592,595,596,599,600,603],{},[30,593,594],{},"Archivo → Importar soundboard"," carga un pack compartido. Los packs son un ",[385,597,598],{},".zip"," que contiene ",[385,601,602],{},"project.sninja"," más los archivos de sonido. Tras importar, abre el proyecto y reproduce.",[14,605,606],{},"También puedes tener varios proyectos (perfiles). Usa el selector de proyecto para cambiar de tablero.",[18,608,610],{"id":609},"reenlazar-archivos-faltantes","Reenlazar archivos faltantes",[14,612,613,614,617],{},"Si los archivos de audio se mueven en el disco, SoundNinja muestra ",[30,615,616],{},"Archivos de sonido faltantes",". Elige una carpeta para buscar y reenlazar los clips.",[18,619,621],{"id":620},"siguiente","Siguiente",[14,623,624,625,478],{},"Organiza pestañas, grupos y atajos en ",[138,626,5],{"href":280},{"title":156,"searchDepth":157,"depth":157,"links":628},[629,630,631,632,633,634],{"id":508,"depth":157,"text":509},{"id":530,"depth":157,"text":531},{"id":565,"depth":157,"text":566},{"id":588,"depth":157,"text":589},{"id":609,"depth":157,"text":610},{"id":620,"depth":157,"text":621},"Importa audio, carpetas, grabaciones y soundboards compartidos.",{},3,"\u002Fadding-sounds",{"title":275,"description":635},"adding-sounds","Pp2z7pkBymoeTp058Pu8gOujI6GqQLoQ-Go0ZA2L1F4",{"id":4,"title":5,"body":643,"description":166,"extension":167,"meta":734,"navigation":169,"order":170,"path":171,"seo":735,"stem":173,"__hash__":174},{"type":7,"value":644,"toc":725},[645,647,649,651,667,671,673,675,685,689,691,695,697,703,705,707,709,711,715,719,721],[10,646,5],{"id":12},[14,648,16],{},[18,650,21],{"id":20},[23,652,653,657,661],{},[26,654,28,655,33],{},[30,656,32],{},[26,658,36,659,40],{},[30,660,39],{},[26,662,43,663,47,665,51],{},[30,664,46],{},[30,666,50],{},[14,668,54,669,58],{},[30,670,57],{},[18,672,62],{"id":61},[14,674,65],{},[23,676,677,679,681,683],{},[26,678,70],{},[26,680,73],{},[26,682,76],{},[26,684,79],{},[14,686,82,687,86],{},[30,688,85],{},[18,690,90],{"id":89},[14,692,93,693,97],{},[30,694,96],{},[18,696,101],{"id":100},[14,698,104,699,108,701,112],{},[30,700,107],{},[30,702,111],{},[18,704,116],{"id":115},[