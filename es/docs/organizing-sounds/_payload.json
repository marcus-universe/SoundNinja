],{},"CSS personalizado",[31,1271,1272],{},"Importar un archivo de tema a la carpeta Themes",{"title":401,"searchDepth":402,"depth":402,"links":1274},[1275,1276,1277,1278],{"id":1167,"depth":402,"text":1168},{"id":1201,"depth":402,"text":1202},{"id":1219,"depth":402,"text":1220},{"id":1252,"depth":402,"text":1253},"Diseña colores, fuentes, botones y pestañas en el Theme Creator.",{},5,"\u002Ftheme-editor",{"title":1153,"description":1279},"theme-editor","bPcJP7OLtBsnNMYJ-S1J6DmB6nngULo1_Q1hBJMNZAQ",{"id":1287,"title":1288,"body":1289,"description":1425,"extension":419,"meta":1426,"navigation":421,"order":1427,"path":1428,"seo":1429,"stem":1430,"__hash__":1431},"content_es\u002Frecording-editor.md","Editor de grabación",{"type":7,"value":1290,"toc":1419},[1291,1294,1300,1304,1310,1330,1333,1337,1362,1366,1380,1384,1398,1409],[10,1292,1288],{"id":1293},"editor-de-grabación",[14,1295,1296,1297,1299],{},"Graba un clip dentro de SoundNinja, recórtalo e impórtalo a una pestaña. Abre el editor con el botón ",[18,1298,837],{}," en la barra del reproductor.",[23,1301,1303],{"id":1302},"elegir-una-entrada","Elegir una entrada",[14,1305,128,1306,1309],{},[18,1307,1308],{},"Ajustes → Audio",":",[28,1311,1312,1318,1324],{},[31,1313,1314,1317],{},[18,1315,1316],{},"Dispositivos de entrada"," — micrófono",[31,1319,1320,1323],{},[18,1321,1322],{},"Dispositivos de salida (audio del PC)"," — loopback de lo que reproduce el PC",[31,1325,1326,1329],{},[18,1327,1328],{},"Volumen de entrada"," — ganancia de captura del 0 % al 200 %",[14,1331,1332],{},"El botón Grabar usa el dispositivo que eliges aquí.",[23,1334,1336],{"id":1335},"editar-la-toma","Editar la toma",[28,1338,1339,1342,1345,1353,1356,1359],{},[31,1340,1341],{},"Grabar y detener",[31,1343,1344],{},"Observar el medidor de nivel de entrada",[31,1346,1347,231,1350],{},[18,1348,1349],{},"Normalizar",[18,1351,1352],{},"Cancelación de ruido",[31,1354,1355],{},"Recortar todo el clip, recortar a una selección o borrar una selección",[31,1357,1358],{},"Deshacer \u002F rehacer",[31,1360,1361],{},"Acercar y alejar",[23,1363,1365],{"id":1364},"preparar-e-importar","Preparar e importar",[118,1367,1368,1371,1374],{},[31,1369,1370],{},"Añade la selección o la pista completa a la lista de staging.",[31,1372,1373],{},"La lista empieza vacía: graba, edita y luego añade un clip.",[31,1375,1376,231,1378,845],{},[18,1377,841],{},[18,1379,844],{},[23,1381,1383],{"id":1382},"separación-de-stems-opcional","Separación de stems (opcional)",[14,1385,1386,1387,1390,1391,231,1394,1397],{},"Las builds oficiales de Windows, macOS y Linux incluyen la función ",[18,1388,1389],{},"stems",". El Record Editor puede conservar ",[18,1392,1393],{},"voces",[18,1395,1396],{},"música"," con BS-RoFormer.",[14,1399,1400,1401,1404,1405,1408],{},"El modelo pesa unos 158 MB y ",[18,1402,1403],{},"no"," viene en el instalador. Descárgalo desde ",[18,1406,1407],{},"Ajustes → Separación de stems",", o acepta el aviso del primer arranque. El instalador de Windows también puede ofrecer descargar el modelo al primer inicio.",[14,1410,1411,1412,1180,1415,1418],{},"Las builds personalizadas desde código necesitan un flag extra (",[647,1413,1414],{},"tauri:serve:stems",[647,1416,1417],{},"tauri:build:stems",").",{"title":401,"searchDepth":402,"depth":402,"links":1420},[1421,1422,1423,1424],{"id":1302,"depth":402,"text":1303},{"id":1335,"depth":402,"text":1336},{"id":1364,"depth":402,"text":1365},{"id":1382,"depth":402,"text":1383},"Captura micrófono o audio del PC, edita el clip y suéltalo en tu tablero.",{},6,"\u002Frecording-editor",{"title":1288,"description":1425},"recording-editor","89aDSCp7hE8To2TNFwdWaImQVsHH2-xNcOyltCPP5IY",{"id":1433,"title":1434,"body":1435,"description":1647,"extension":419,"meta":1648,"navigation":421,"order":1649,"path":1650,"seo":1651,"stem":1652,"__hash__":1653},"content_es\u002Fremote-control.md","Control remoto",{"type":7,"value":1436,"toc":1640},[1437,1440,1443,1447,1476,1479,1482,1517,1521,1541,1544,1548,1