de sonidos (id, name, tabs, active)",[26,1187,1188,1191],{},[385,1189,1190],{},"GET \u002Fstate"," — sonidos más IDs que suenan ahora",[26,1193,1194,1197,1198,1201],{},[385,1195,1196],{},"POST \u002Ftrigger"," con ",[385,1199,1200],{},"{ \"id\" }"," — reproducir un sonido",[26,1203,1204,1207],{},[385,1205,1206],{},"GET \u002Ftrigger\u002F:id"," — reproducir (fácil de probar en el navegador)",[26,1209,1210,1197,1213,1215],{},[385,1211,1212],{},"POST \u002Fstop",[385,1214,1200],{}," opcional — detener un sonido o todos",[26,1217,1218,1221],{},[385,1219,1220],{},"GET \u002Fws"," — estado en vivo; enviar comandos trigger\u002Fstop de entrada",{"title":156,"searchDepth":157,"depth":157,"links":1223},[1224,1225,1226,1227,1228],{"id":1027,"depth":157,"text":1028},{"id":1063,"depth":157,"text":141},{"id":1101,"depth":157,"text":1102},{"id":1128,"depth":157,"text":1129},{"id":1164,"depth":157,"text":1165},"Dispara SoundNinja desde Bitfocus Companion en la red local.",{},7,"\u002Fremote-control",{"title":1016,"description":1229},"remote-control","FXZNdlLVwqBTHCjLmpjNr2ZHY0S5NmW5TzHr5uUtI7U",{"id":1237,"title":1238,"body":1239,"description":1327,"extension":167,"meta":1328,"navigation":169,"order":1329,"path":1330,"seo":1331,"stem":1332,"__hash__":1333},"content_es\u002Fsupport.md","Soporte",{"type":7,"value":1240,"toc":1320},[1241,1244,1247,1251,1254,1261,1269,1273,1280,1282,1295,1299,1310,1314],[10,1242,1238],{"id":1243},"soporte",[14,1245,1246],{},"SoundNinja es un proyecto comunitario en beta temprana. La forma más rápida de pedir ayuda es GitHub.",[18,1248,1250],{"id":1249},"reportar-un-error-o-hacer-una-pregunta","Reportar un error o hacer una pregunta",[14,1252,1253],{},"Abre un issue en GitHub:",[14,1255,1256],{},[138,1257,1260],{"href":1258,"rel":1259},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fissues",[254],"github.com\u002Fmarcus-universe\u002FSoundNinja\u002Fissues",[14,1262,1263,1264,328,1266,1268],{},"Incluye tu SO, la versión de Soun