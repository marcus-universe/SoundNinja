al y hover)",[18,803,805],{"id":804},"guardar-y-compartir","Guardar y compartir",[23,807,808,814,820,826],{},[26,809,810,813],{},[30,811,812],{},"Exportar .css"," — escribe un archivo de tema para respaldar o enviar a un amigo",[26,815,816,819],{},[30,817,818],{},"Añadir a temas"," — guarda el archivo en tu carpeta Themes y aplícalo",[26,821,822,825],{},[30,823,824],{},"Importar .css"," — carga un preset integrado o un tema guardado",[26,827,828,831],{},[30,829,830],{},"Restablecer"," — vuelve a los valores por defecto de SoundNinja",[14,833,834],{},"Si cierras la ventana con cambios sin guardar, SoundNinja te pide que guardes primero.",[18,836,838],{"id":837},"sin-el-editor-completo","Sin el editor completo",[14,840,841,842,844],{},"En ",[30,843,57],{}," aún puedes:",[23,846,847,850,856],{},[26,848,849],{},"Elegir un tema de la lista",[26,851,852,853,769],{},"Editar variables CSS en vivo (",[30,854,855],{},"CSS personalizado",[26,857,858],{},"Importar un archivo de tema a la carpeta Themes",{"title":156,"searchDepth":157,"depth":157,"links":860},[861,862,863,864],{"id":752,"depth":157,"text":753},{"id":786,"depth":157,"text":787},{"id":804,"depth":157,"text":805},{"id":837,"depth":157,"text":838},"Diseña colores, fuentes, botones y pestañas en el Theme Creator.",{},5,"\u002Ftheme-editor",{"title":738,"description":865},"theme-editor","bPcJP7OLtBsnNMYJ-S1J6DmB6nngULo1_Q1hBJMNZAQ",{"id":873,"title":874,"body":875,"description":1007,"extension":167,"meta":1008,"navigation":169,"order":1009,"path":1010,"seo":1011,"stem":1012,"__hash__":1013},"content_es\u002Frecording-editor.md","Editor de grabación",{"type":7,"value":876,"toc":1001},[877,880,886,890,896,916,919,923,948,952,966,970,984,991],[10,878,874],{"id":879},"editor-de-grabación",[14,881,882,883,885],{},"Graba un clip dentro de SoundNinja, recórtalo e impórtalo a una pestaña. Abre el editor con el botón ",[30,884,577],{}," en la barra del reproductor.",[18,887,889],{"id":888},"elegir-una-entrada","Elegir una entrada",[14,891,841,892,895],{},[30,893,894],{},"Ajustes → Audio",":",[23,897,898,904,910],{},[26,899,900,903],{},[30,901,902],{},"Dispositivos de entrada"," — micrófono",[26,905,906,909],{},[30,907,908],{},"Dispositivos de salida (audio del PC)"," — loopback de lo que reproduce el PC",[26,911,912,915],{},[30,913,914],{},"Volumen de entrada"," — ganancia de captura del 0 % al 200 %",[14,917,918],{},"El botón Grabar usa el dispositivo que eliges aquí.",[18,920,922],{"id":921},"editar-la-toma","Editar la toma",[23,924,925,928,931,939,942,945],{},[26,926,927],{},"Grabar y detener",[26,929,930],{},"Observar el medidor de nivel de entrada",[26,932,933,328,936],{},[30,934,935],{},"Normalizar",[30,937,938],{},"Cancelación de ruido",[26,940,941],{},"Recortar todo el clip, recortar a una selección o borrar una selección",[26,943,944],{},"Deshacer \u002F rehacer",[26,946,947],{},"Acercar y alejar",[18,949,951],{"id":950},"preparar-e-importar","Preparar e importar",[262,953,954,957,960],{},[26,955,956],{},"Añade la selección o la pista completa a la lista de staging.",[26,958,959],{},"La lista empieza vacía: graba, edita y luego añade un clip.",[26,961,962,328,964,585],{},[30,963,581],{},[30,965,584],{},[18,967,969],{"id":968},"separación-de-stems-opcional","Separación de stems (opcional)",[14,971,972,973,328,976,979,980,983],{},"El Record Editor puede conservar ",[30,974,975],{},"voces",[30,977,978],{},"música"," con BS-RoFormer. El modelo pesa unos 158 MB y ",[30,981,982],{},"no"," viene incluido con la app.",[14,985,986,987,990],{},"Descárgalo desde ",[30,988,989],{},"Ajustes → Separación de stems",", o acepta el aviso del primer arranque. El instalador de Windows también puede ofrecer descargar el modelo al primer inicio.",[14,992,993,994,765,997,1000],{},"Las builds desde código con stems necesitan un flag extra (",[385,995,996],{},"tauri:serve:stems",[385,998,999],{},"tauri:build:stems",").",{"title":156,"searchDepth":157,"depth":157,"links":1002},[1003,1004,1005,1006],{"id