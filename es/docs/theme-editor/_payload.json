[{"data":1,"prerenderedAt":1622},["ShallowReactive",2],{"docs-page-es-\u002Ftheme-editor":3,"docs-nav-es":155},{"id":4,"title":5,"body":6,"description":146,"extension":147,"meta":148,"navigation":149,"order":150,"path":151,"seo":152,"stem":153,"__hash__":154},"content_es\u002Ftheme-editor.md","Editor de temas",{"type":7,"value":8,"toc":138},"minimark",[9,13,22,27,58,61,65,80,84,110,113,117,124],[10,11,5],"h1",{"id":12},"editor-de-temas",[14,15,16,17,21],"p",{},"El Theme Creator es el editor visual completo de tu tablero. Ábrelo desde ",[18,19,20],"strong",{},"Ajustes → General → Theme Creator",".",[23,24,26],"h2",{"id":25},"tres-pestañas","Tres pestañas",[28,29,30,46,52],"ol",{},[31,32,33,36,37,41,42,45],"li",{},[18,34,35],{},"General"," — nombre del tema, colores compartidos y carga de fuentes (",[38,39,40],"code",{},".ttf"," \u002F ",[38,43,44],{},".otf",")",[31,47,48,51],{},[18,49,50],{},"Botones"," — colores, tipo, diseño y overlay GIF de los botones de sonido",[31,53,54,57],{},[18,55,56],{},"Pestañas"," — colores, tipo y grosor de borde de la barra de pestañas",[14,59,60],{},"Una vista previa en vivo muestra pestañas y botones mientras editas.",[23,62,64],{"id":63},"qué-puedes-cambiar","Qué puedes cambiar",[66,67,68,71,74,77],"ul",{},[31,69,70],{},"Colores primario y de acento, fondos, colores de botones, colores de pestañas",[31,72,73],{},"Familia y tamaño de fuente de botones y pestañas",[31,75,76],{},"Ancho, radio, borde, huecos y padding de los botones",[31,78,79],{},"Opacidad del overlay GIF (normal y hover)",[23,81,83],{"id":82},"guardar-y-compartir","Guardar y compartir",[66,85,86,92,98,104],{},[31,87,88,91],{},[18,89,90],{},"Exportar .css"," — escribe un archivo de tema para respaldar o enviar a un amigo",[31,93,94,97],{},[18,95,96],{},"Añadir a temas"," — guarda el archivo en tu carpeta Themes y aplícalo",[31,99,100,103],{},[18,101,102],{},"Importar .css"," — carga un preset integrado o un tema guardado",[31,105,106,109],{},[18,107,108],{},"Restablecer"," — vuelve a los valores por defecto de SoundNinja",[14,111,112],{},"Si cierras la ventana con cambios sin guardar, SoundNinja te pide que guardes primero.",[23,114,116],{"id":115},"sin-el-editor-completo","Sin el editor completo",[14,118,119,120,123],{},"En ",[18,121,122],{},"Ajustes → General"," aún puedes:",[66,125,126,129,135],{},[31,127,128],{},"Elegir un tema de la lista",[31,130,131,132,45],{},"Editar variables CSS en vivo (",[18,133,134],{},"CSS personalizado",[31,136,137],{},"Importar un archivo de tema a la carpeta Themes",{"title":139,"searchDepth":140,"depth":140,"links":141},"",2,[142,143,144,145],{"id":25,"depth":140,"text":26},{"id":63,"depth":140,"text":64},{"id":82,"depth":140,"text":83},{"id":115,"depth":140,"text":116},"Diseña colores, fuentes, botones y pestañas en el Theme Creator.","md",{},true,5,"\u002Ftheme-editor",{"title":5,"description":146},"theme-editor","bPcJP7OLtBsnNMYJ-S1J6DmB6nngULo1_Q1hBJMNZAQ",[156,286,509,657,1067,1156,1302,1524],{"id":157,"title":158,"body":159,"description":279,"extension":147,"meta":280,"navigation":149,"order":281,"path":282,"seo":283,"stem":284,"__hash__":285},"content_es\u002Foverview.md","Resumen",{"type":7,"value":160,"toc":273},[161,164,167,170,173,177,191,195,235,239,249,253],[10,162,158],{"id":163},"resumen",[14,165,166],{},"SoundNinja es un soundboard de código abierto para streaming en directo, charlas con amigos y grabación de podcasts. Está construido con Tauri v2 y Nuxt 4 para que sea ligero en RAM y disco.",[14,168,169],{},"El objetivo es simple: mantener una biblioteca enorme fácil de recorrer y reproducir el clip correcto en milisegundos. La interfaz también funciona bien como panel en VR.",[14,171,172],{},"SoundNinja sigue en desarrollo temprano. Las funciones marchan, pero no todas las plataformas están del todo probadas.",[23,174,176],{"id":175},"para-quién","Para quién",[66,178,179,182,185,188],{},[31,180,181],{},"Streamers que necesitan cues de sonido al instante",[31,183,184],{},"Amigos que quieren un tablero compartido para el chat de voz",[31,186,187],{},"Podcasters que graban clips y los sueltan en un tablero",[31,189,190],{},"Quien quiera un soundboard personalizable y local-first",[23,192,194],{"id":193},"qué-puedes-hacer","Qué puedes hacer",[66,196,197,200,203,206,209,212,215,218,221,229,232],{},[31,198,199],{},"Montar un soundboard con tus propios archivos de audio",[31,201,202],{},"Organizar sonidos en pestañas de colores, grupos, etiquetas y búsqueda",[31,204,205],{},"Filtrar por etiquetas (OR) y ordenar por nombre, fecha, duración o tamaño",[31,207,208],{},"Selección múltiple con marco o rango Mayús, luego color, mover o borrar en lote",[31,210,211],{},"Ajustar el volumen por sonido desde el menú contextual",[31,213,214],{},"Diseñar el aspecto con el Theme Creator",[31,216,217],{},"Grabar audio del PC o un micrófono en el Record Editor",[31,219,220],{},"Asignar atajos a sonidos individuales",[31,222,223,224],{},"Disparar sonidos desde ",[225,226,228],"a",{"href":227},"\u002Fdocs\u002Fremote-control","Bitfocus Companion",[31,230,231],{},"Importar y exportar un soundboard completo para compartirlo",[31,233,234],{},"Usar GIFs o imágenes en los botones — biblioteca local de carpetas, GifSnap o KLIPY",[23,236,238],{"id":237},"licencia","Licencia",[14,240,241,242,248],{},"SoundNinja es software libre bajo ",[225,243,247],{"href":244,"rel":245},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fblob\u002Fmain\u002FLICENSE",[246],"nofollow","GPL-3.0",". Haz fork, cámbialo, compártelo.",[23,250,252],{"id":251},"siguientes-pasos","Siguientes pasos",[28,254,255,261,267],{},[31,256,257],{},[225,258,260],{"href":259},"\u002Fdocs\u002Finstallation","Instalar SoundNinja",[31,262,263],{},[225,264,266],{"href":265},"\u002Fdocs\u002Fadding-sounds","Añadir sonidos",[31,268,269],{},[225,270,272],{"href":271},"\u002Fdocs\u002Forganizing-sounds","Organizar tu tablero",{"title":139,"searchDepth":140,"depth":140,"links":274},[275,276,277,278],{"id":175,"depth":140,"text":176},{"id":193,"depth":140,"text":194},{"id":237,"depth":140,"text":238},{"id":251,"depth":140,"text":252},"Qué es SoundNinja y qué puedes hacer con él.",{},1,"\u002Foverview",{"title":158,"description":279},"overview","aVQIpArgBh8Yx660xBvwTxx-97ukf5Chr1A7jNPd3UE",{"id":287,"title":288,"body":289,"description":503,"extension":147,"meta":504,"navigation":149,"order":140,"path":505,"seo":506,"stem":507,"__hash__":508},"content_es\u002Finstallation.md","Instalación",{"type":7,"value":290,"toc":496},[291,294,308,312,333,336,340,354,357,361,385,396,400,407,411,426,456,471,492],[10,292,288],{"id":293},"instalación",[14,295,296,297,301,302,307],{},"Consigue una build en la ",[225,298,300],{"href":299},"\u002Fdownload","página de descarga"," o en ",[225,303,306],{"href":304,"rel":305},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Freleases\u002Flatest",[246],"GitHub Releases",". SoundNinja está en desarrollo temprano, así que trata las builds como beta.",[23,309,311],{"id":310},"windows","Windows",[66,313,314,324,327,330],{},[31,315,316,319,320,323],{},[18,317,318],{},"Instalador (.exe)"," o ",[18,321,322],{},"MSI (.msi)"," para Windows de 64 bits",[31,325,326],{},"Objetivo de la landing: Windows 10 y posterior",[31,328,329],{},"El README de la app también lista Windows 8 y superior",[31,331,332],{},"El instalador NSIS usa tema oscuro. Elige idioma en el setup — SoundNinja lo recuerda en el siguiente arranque.",[14,334,335],{},"Ejecuta el instalador y luego abre SoundNinja desde el menú Inicio.",[23,337,339],{"id":338},"macos","macOS",[66,341,342,348,351],{},[31,343,344,347],{},[18,345,346],{},".dmg universal"," para Apple Silicon e Intel",[31,349,350],{},"Objetivo de la landing: macOS 10.14 y posterior",[31,352,353],{},"El README de la app lista macOS 10.15 y superior",[14,355,356],{},"Abre la imagen de disco y arrastra SoundNinja a Aplicaciones.",[23,358,360],{"id":359},"linux","Linux",[66,362,363,369,375,382],{},[31,364,365,368],{},[18,366,367],{},"Debian (.deb)"," para Ubuntu \u002F Debian",[31,370,371,374],{},[18,372,373],{},"AppImage"," para otras distros",[31,376,377,378,381],{},"Tras publicar una release, los usuarios de Arch pueden instalar ",[38,379,380],{},"soundninja-bin"," desde el AUR",[31,383,384],{},"Probado en Ubuntu 20.04",[14,386,387,388,391,392,395],{},"Las builds de escritorio necesitan paquetes WebKit y GTK. En Debian\u002FUbuntu eso suele ser ",[38,389,390],{},"libwebkit2gtk",", ",[38,393,394],{},"libgtk-3-0"," y una biblioteca app-indicator.",[23,397,399],{"id":398},"actualizaciones","Actualizaciones",[14,401,402,403,406],{},"En la app, abre ",[18,404,405],{},"Ayuda → Buscar actualizaciones",". También puedes dejar que SoundNinja compruebe al arrancar en Ajustes.",[23,408,410],{"id":409},"compilar-desde-el-código","Compilar desde el código",[14,412,413,414,419,420,425],{},"¿Necesitas una build personalizada? Clona ",[225,415,418],{"href":416,"rel":417},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja",[246],"el repo",", instala los ",[225,421,424],{"href":422,"rel":423},"https:\u002F\u002Fv2.tauri.app\u002Fstart\u002Fprerequisites\u002F",[246],"requisitos de Tauri"," y luego:",[427,428,432],"pre",{"className":429,"code":430,"language":431,"meta":139,"style":139},"language-bash shiki shiki-themes github-light github-dark","bun install\nbun run tauri:serve\n","bash",[38,433,434,446],{"__ignoreMap":139},[435,436,438,442],"span",{"class":437,"line":281},"line",[435,439,441],{"class":440},"sScJk","bun",[435,443,445],{"class":444},"sZZnC"," install\n",[435,447,448,450,453],{"class":437,"line":140},[435,449,441],{"class":440},[435,451,452],{"class":444}," run",[435,454,455],{"class":444}," tauri:serve\n",[14,457,458,391,461,319,464,467,468,21],{},[38,459,460],{},"npm",[38,462,463],{},"pnpm",[38,465,466],{},"deno"," también sirven. Build de producción: ",[38,469,470],{},"bun run tauri:build",[14,472,473,476,477,482,483,486,487,21],{},[18,474,475],{},"Solo Windows:"," cada compile de Windows incluye ASIO con el ",[225,478,481],{"href":479,"rel":480},"https:\u002F\u002Fwww.steinberg.net\u002Fasiosdk",[246],"Steinberg ASIO SDK",". Ejecuta ",[38,484,485],{},"bun run setup:asio"," una vez (el SDK no está en git). Linux y macOS usan PipeWire \u002F Core Audio — omite ese paso. Detalles: ",[225,488,491],{"href":489,"rel":490},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fblob\u002Fmain\u002Fdocs\u002Fbuild-from-source.md",[246],"build-from-source.md",[493,494,495],"style",{},"html pre.shiki code .sScJk, html code.shiki .sScJk{--shiki-default:#6F42C1;--shiki-dark:#B392F0}html pre.shiki code .sZZnC, html code.shiki .sZZnC{--shiki-default:#032F62;--shiki-dark:#9ECBFF}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html.dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}",{"title":139,"searchDepth":140,"depth":140,"links":497},[498,499,500,501,502],{"id":310,"depth":140,"text":311},{"id":338,"depth":140,"text":339},{"id":359,"depth":140,"text":360},{"id":398,"depth":140,"text":399},{"id":409,"depth":140,"text":410},"Instala SoundNinja en Windows, macOS o Linux.",{},"\u002Finstallation",{"title":288,"description":503},"installation","6QKa3OcTs0sq8JVvjceX-ugwL8mdPc4h6O-JOoo1Qd8",{"id":510,"title":266,"body":511,"description":650,"extension":147,"meta":651,"navigation":149,"order":652,"path":653,"seo":654,"stem":655,"__hash__":656},"content_es\u002Fadding-sounds.md",{"type":7,"value":512,"toc":642},[513,516,519,523,542,546,577,581,600,604,618,621,625,632,636],[10,514,266],{"id":515},"añadir-sonidos",[14,517,518],{},"Un tablero está vacío hasta que añades clips. SoundNinja puede importar archivos, carpetas enteras, una grabación o un pack de soundboard compartido.",[23,520,522],{"id":521},"importar-archivos-de-audio","Importar archivos de audio",[28,524,525,536,539],{},[31,526,527,528,531,532,535],{},"Abre ",[18,529,530],{},"Archivo → Importar archivos de audio",", o usa ",[18,533,534],{},"Importar"," en la barra de navegación.",[31,537,538],{},"Elige uno o más archivos de audio.",[31,540,541],{},"Los sonidos llegan a la pestaña actual.",[23,543,545],{"id":544},"importar-carpetas","Importar carpetas",[28,547,548,557,560],{},[31,549,527,550,553,554,556],{},[18,551,552],{},"Archivo → Importar carpetas"," (o ",[18,555,545],{}," en la barra de navegación).",[31,558,559],{},"Añade una o más carpetas. Arrastra para reordenarlas antes de importar.",[31,561,562,563],{},"Elige cómo llegan:\n",[66,564,565,571],{},[31,566,567,570],{},[18,568,569],{},"Importar como pestañas"," — cada carpeta se convierte en su propia pestaña",[31,572,573,576],{},[18,574,575],{},"Importar a la pestaña actual"," — cada archivo va a la pestaña activa",[23,578,580],{"id":579},"grabar-un-clip","Grabar un clip",[14,582,583,584,588,589,592,593,319,596,599],{},"Abre el ",[225,585,587],{"href":586},"\u002Fdocs\u002Frecording-editor","Record Editor"," desde el botón ",[18,590,591],{},"Grabar"," en la barra del reproductor. Captura, recorta y luego ",[18,594,595],{},"Importar selección",[18,597,598],{},"Importar todo"," en la pestaña actual o en una pestaña que elijas.",[23,601,603],{"id":602},"importar-un-soundboard","Importar un soundboard",[14,605,606,609,610,613,614,617],{},[18,607,608],{},"Archivo → Importar soundboard"," carga un pack compartido. Los packs son un ",[38,611,612],{},".zip"," que contiene ",[38,615,616],{},"project.sninja"," más los archivos de sonido. Tras importar, abre el proyecto y reproduce.",[14,619,620],{},"También puedes tener varios proyectos (perfiles). Usa el selector de proyecto para cambiar de tablero.",[23,622,624],{"id":623},"reenlazar-archivos-faltantes","Reenlazar archivos faltantes",[14,626,627,628,631],{},"Si los archivos de audio se mueven en el disco, SoundNinja muestra ",[18,629,630],{},"Archivos de sonido faltantes",". Elige una carpeta para buscar y reenlazar los clips.",[23,633,635],{"id":634},"siguiente","Siguiente",[14,637,638,639,21],{},"Organiza pestañas, etiquetas, filtros y atajos en ",[225,640,641],{"href":271},"Organizar sonidos",{"title":139,"searchDepth":140,"depth":140,"links":643},[644,645,646,647,648,649],{"id":521,"depth":140,"text":522},{"id":544,"depth":140,"text":545},{"id":579,"depth":140,"text":580},{"id":602,"depth":140,"text":603},{"id":623,"depth":140,"text":624},{"id":634,"depth":140,"text":635},"Importa audio, carpetas, grabaciones y soundboards compartidos.",{},3,"\u002Fadding-sounds",{"title":266,"description":650},"adding-sounds","O5nOJGNq2FL6jafUxqoGYNKJDVbb2UrZRjfKpK21LlQ",{"id":658,"title":641,"body":659,"description":1060,"extension":147,"meta":1061,"navigation":149,"order":1062,"path":1063,"seo":1064,"stem":1065,"__hash__":1066},"content_es\u002Forganizing-sounds.md",{"type":7,"value":660,"toc":1045},[661,664,671,674,701,707,711,714,728,735,741,745,755,760,791,795,801,805,838,844,848,851,877,880,884,897,901,907,928,944,951,955,966,969,973,980,990,996,1000,1008,1015,1042],[10,662,641],{"id":663},"organizar-sonidos",[14,665,666,667,670],{},"SoundNinja está hecho para bibliotecas grandes. ",[18,668,669],{},"Etiquetas y filtros",", pestañas, búsqueda, selección múltiple y atajos — el clip que necesitas está a un clic (o una tecla).",[23,672,56],{"id":673},"pestañas",[66,675,676,683,690],{},[31,677,678,679,682],{},"Añade una pestaña con ",[18,680,681],{},"Añadir pestaña",". Dale un color para escanear la barra rápido.",[31,684,685,686,689],{},"La vista ",[18,687,688],{},"Todos"," muestra cada sonido de todas las pestañas.",[31,691,692,693,696,697,700],{},"Un sonido puede pertenecer a ",[18,694,695],{},"una o más pestañas",". Clic derecho en un sonido y usa ",[18,698,699],{},"Mover a pestaña"," para asignarlo.",[14,702,703,704,706],{},"Las transiciones de pestaña están en ",[18,705,122],{},": Slide, Fade, Botones uno a uno, o Ninguna.",[23,708,710],{"id":709},"grupos","Grupos",[14,712,713],{},"Desde la v0.5.3, los separadores pueden convertirse en grupos con nombre:",[66,715,716,719,722,725],{},[31,717,718],{},"Añadir, renombrar o quitar un grupo desde el menú contextual",[31,720,721],{},"Arrastra la cabecera del grupo — los hijos se mueven con ella",[31,723,724],{},"Suelta sonidos dentro o fuera de un grupo",[31,726,727],{},"Define color de borde, color del nombre y alineación de botones (o usa el valor por defecto de la pestaña)",[14,729,730,731,734],{},"Sigue pudiendo añadir un ",[18,732,733],{},"Separador"," simple si solo necesitas un corte visual.",[14,736,737,738,21],{},"Clic derecho en el espacio vacío del tablero para ",[18,739,740],{},"Añadir grupo",[23,742,744],{"id":743},"etiquetas-filtros","Etiquetas \u002F Filtros",[14,746,747,748,751,752,754],{},"Las etiquetas cruzan las pestañas. El panel ",[18,749,750],{},"Filtro"," (barra lateral ",[18,753,750],{},") es donde las creas y filtras el tablero.",[756,757,759],"h3",{"id":758},"crear-y-editar-etiquetas","Crear y editar etiquetas",[28,761,762,767,777,784],{},[31,763,527,764,766],{},[18,765,750],{}," en la barra lateral.",[31,768,119,769,772,773,776],{},[18,770,771],{},"Etiquetas",", usa ",[18,774,775],{},"Añadir etiqueta"," — nombre y color.",[31,778,779,780,783],{},"Renombra, recolorea o ",[18,781,782],{},"Eliminar etiqueta"," en la misma lista.",[31,785,786,787,790],{},"Si ves ",[18,788,789],{},"Aún no hay etiquetas",", crea una aquí antes de asignar.",[756,792,794],{"id":793},"asignar-etiquetas-a-sonidos","Asignar etiquetas a sonidos",[14,796,797,798,800],{},"Clic derecho en un sonido → ",[18,799,771],{}," (casillas). Un sonido puede tener varias. Si aún no hay ninguna, el menú te lleva al panel de filtro.",[756,802,804],{"id":803},"filtrar-el-tablero","Filtrar el tablero",[66,806,807,813,824,835],{},[31,808,809,810,21],{},"Activa etiquetas en el panel Filtro o como ",[18,811,812],{},"chips bajo la barra de búsqueda",[31,814,815,816,819,820,823],{},"La coincidencia es ",[18,817,818],{},"OR",": un sonido sigue visible si tiene ",[18,821,822],{},"cualquiera"," de las etiquetas seleccionadas.",[31,825,826,827,830,831,834],{},"El campo ",[18,828,829],{},"Buscar"," combina con ",[18,832,833],{},"AND"," el filtro de etiquetas activo (texto + etiquetas juntos).",[31,836,837],{},"Apaga los chips (o limpia el filtro) para ver de nuevo toda la pestaña.",[14,839,840,841,21],{},"Los nombres de etiqueta en color pueden aparecer en los botones. Actívalos en ",[18,842,843],{},"Ajustes → Comportamiento → Mostrar badges de etiquetas",[23,845,847],{"id":846},"orden","Orden",[14,849,850],{},"Abre el panel de filtro y elige un modo:",[66,852,853,859],{},[31,854,855,858],{},[18,856,857],{},"Definido por el usuario"," — tu orden de pestaña, grupos visibles",[31,860,861,391,864,391,867,319,870,873,874],{},[18,862,863],{},"Nombre",[18,865,866],{},"Fecha de añadido",[18,868,869],{},"Tiempo de reproducción",[18,871,872],{},"Tamaño de archivo"," — lista plana ordenada; ",[18,875,876],{},"los grupos se ocultan",[14,878,879],{},"Ordenar por duración puede precargar los metadatos de duración la primera vez.",[23,881,883],{"id":882},"reordenar","Reordenar",[14,885,886,887,890,891,894,895,21],{},"Activa arrastrar y soltar en ",[18,888,889],{},"Ajustes → Comportamiento"," (",[18,892,893],{},"Permitir reordenar","). Luego arrastra sonidos y grupos a su sitio. Reordenar aplica en el orden ",[18,896,857],{},[23,898,900],{"id":899},"selección-múltiple","Selección múltiple",[14,902,903,904,906],{},"Activa ",[18,905,900],{}," en la barra de navegación, luego:",[66,908,909,912,918,925],{},[31,910,911],{},"Clic para alternar un sonido",[31,913,914,917],{},[18,915,916],{},"Mayús+clic"," para un rango desde el último ancla",[31,919,920,921,924],{},"Arrastra un ",[18,922,923],{},"marco"," en el espacio vacío del tablero",[31,926,927],{},"Clic en el tablero vacío (o fuera) para limpiar la selección",[14,929,930,931,391,934,391,937,940,941,21],{},"Una barra masiva muestra el recuento, más ",[18,932,933],{},"Color",[18,935,936],{},"Mover a pestaña…",[18,938,939],{},"Eliminar"," y ",[18,942,943],{},"Hecho",[14,945,946,947,950],{},"En selección múltiple, cada botón muestra un ",[18,948,949],{},"chip de ID de 8 caracteres",". Clic derecho en el chip para copiarlo.",[23,952,954],{"id":953},"volumen-por-sonido","Volumen por sonido",[14,956,957,958,961,962,965],{},"Clic derecho → ",[18,959,960],{},"Volumen",". Arrastra el control de 0 % a 100 %. ",[18,963,964],{},"Doble clic"," lo restablece a 100 %.",[14,967,968],{},"Se acumula con el volumen de salida maestro en Ajustes.",[23,970,972],{"id":971},"atajos-e-ids-de-sonido","Atajos e IDs de sonido",[14,974,975,976,979],{},"Cada sonido tiene un ID de 8 caracteres. Cópialo desde el menú contextual del botón (",[18,977,978],{},"Copiar ID",") o el chip de ID de la selección múltiple.",[14,981,527,982,985,986,989],{},[18,983,984],{},"Ajustes → Atajos"," para vincular una tecla a un ID de sonido. Los atajos globales son opcionales. ",[18,987,988],{},"Asignar atajo"," en el menú contextual salta allí con el ID rellenado.",[14,991,992,993,995],{},"El mismo ID es el que ",[225,994,228],{"href":227}," usa para disparar un clip.",[23,997,999],{"id":998},"imágenes-de-fondo-y-colores","Imágenes de fondo y colores",[14,1001,1002,1003,1007],{},"Clic derecho en un sonido para definir colores por botón o una imagen de fondo. Eso es independiente del ",[225,1004,1006],{"href":1005},"\u002Fdocs\u002Ftheme-editor","Theme Creator",", que da estilo a todo el tablero.",[14,1009,1010,1011,1014],{},"El selector es un diálogo ",[18,1012,1013],{},"Imagen de fondo"," (PNG, JPEG, GIF, WebP):",[66,1016,1017,1023,1033],{},[31,1018,1019,1022],{},[18,1020,1021],{},"Archivos locales"," — añade carpetas, elige un archivo, busca por nombre, previsualiza la cuadrícula o quita una carpeta de la biblioteca",[31,1024,1025,1028,1029,21],{},[18,1026,1027],{},"GifSnap"," — busca GIFs en línea sin clave API. La primera visita pide aceptar las peticiones a GifSnap; los resultados se cachean para reducir tráfico. Ver ",[225,1030,1027],{"href":1031,"rel":1032},"https:\u002F\u002Fgifsnap.com",[246],[31,1034,1035,1038,1039,1041],{},[18,1036,1037],{},"KLIPY"," — busca GIFs en línea. Pon tu propia clave API en ",[18,1040,889],{},". La clave no se guarda en los archivos del proyecto.",[14,1043,1044],{},"Tras elegir, mueve y recorta la imagen en el botón.",{"title":139,"searchDepth":140,"depth":140,"links":1046},[1047,1048,1049,1054,1055,1056,1057,1058,1059],{"id":673,"depth":140,"text":56},{"id":709,"depth":140,"text":710},{"id":743,"depth":140,"text":744,"children":1050},[1051,1052,1053],{"id":758,"depth":652,"text":759},{"id":793,"depth":652,"text":794},{"id":803,"depth":652,"text":804},{"id":846,"depth":140,"text":847},{"id":882,"depth":140,"text":883},{"id":899,"depth":140,"text":900},{"id":953,"depth":140,"text":954},{"id":971,"depth":140,"text":972},{"id":998,"depth":140,"text":999},"Etiquetas, filtros, pestañas, grupos, orden, selección múltiple, volumen y atajos.",{},4,"\u002Forganizing-sounds",{"title":641,"description":1060},"organizing-sounds","v2Vh-pefsaiWoUdwQrv4wMerfeXZbtLIa6iq8beVync",{"id":4,"title":5,"body":1068,"description":146,"extension":147,"meta":1154,"navigation":149,"order":150,"path":151,"seo":1155,"stem":153,"__hash__":154},{"type":7,"value":1069,"toc":1148},[1070,1072,1076,1078,1096,1098,1100,1110,1112,1130,1132,1134,1138],[10,1071,5],{"id":12},[14,1073,16,1074,21],{},[18,1075,20],{},[23,1077,26],{"id":25},[28,1079,1080,1088,1092],{},[31,1081,1082,36,1084,41,1086,45],{},[18,1083,35],{},[38,1085,40],{},[38,1087,44],{},[31,1089,1090,51],{},[18,1091,50],{},[31,1093,1094,57],{},[18,1095,56],{},[14,1097,60],{},[23,1099,64],{"id":63},[66,1101,1102,1104,1106,1108],{},[31,1103,70],{},[31,1105,73],{},[31,1107,76],{},[31,1109,79],{},[23,1111,83],{"id":82},[66,1113,1114,1118,1122,1126],{},[31,1115,1116,91],{},[18,1117,90],{},[31,1119,1120,97],{},[18,1121,96],{},[31,1123,1124,103],{},[18,1125,102],{},[31,1127,1128,109],{},[18,1129,108],{},[14,1131,112],{},[23,1133,116],{"id":115},[14,1135,119,1136,123],{},[18,1137,122],{},[66,1139,1140,1142,1146],{},[31,1141,128],{},[31,1143,131,1144,45],{},[18,1145,134],{},[31,1147,137],{},{"title":139,"searchDepth":140,"depth":140,"links":1149},[1150,1151,1152,1153],{"id":25,"depth":140,"text":26},{"id":63,"depth":140,"text":64},{"id":82,"depth":140,"text":83},{"id":115,"depth":140,"text":116},{},{"title":5,"description":146},{"id":1157,"title":1158,"body":1159,"description":1295,"extension":147,"meta":1296,"navigation":149,"order":1297,"path":1298,"seo":1299,"stem":1300,"__hash__":1301},"content_es\u002Frecording-editor.md","Editor de grabación",{"type":7,"value":1160,"toc":1289},[1161,1164,1170,1174,1180,1200,1203,1207,1232,1236,1250,1254,1268,1279],[10,1162,1158],{"id":1163},"editor-de-grabación",[14,1165,1166,1167,1169],{},"Graba un clip dentro de SoundNinja, recórtalo e impórtalo a una pestaña. Abre el editor con el botón ",[18,1168,591],{}," en la barra del reproductor.",[23,1171,1173],{"id":1172},"elegir-una-entrada","Elegir una entrada",[14,1175,119,1176,1179],{},[18,1177,1178],{},"Ajustes → Audio",":",[66,1181,1182,1188,1194],{},[31,1183,1184,1187],{},[18,1185,1186],{},"Dispositivos de entrada"," — micrófono",[31,1189,1190,1193],{},[18,1191,1192],{},"Dispositivos de salida (audio del PC)"," — loopback de lo que reproduce el PC",[31,1195,1196,1199],{},[18,1197,1198],{},"Volumen de entrada"," — ganancia de captura del 0 % al 200 %",[14,1201,1202],{},"El botón Grabar usa el dispositivo que eliges aquí.",[23,1204,1206],{"id":1205},"editar-la-toma","Editar la toma",[66,1208,1209,1212,1215,1223,1226,1229],{},[31,1210,1211],{},"Grabar y detener",[31,1213,1214],{},"Observar el medidor de nivel de entrada",[31,1216,1217,319,1220],{},[18,1218,1219],{},"Normalizar",[18,1221,1222],{},"Cancelación de ruido",[31,1224,1225],{},"Recortar todo el clip, recortar a una selección o borrar una selección",[31,1227,1228],{},"Deshacer \u002F rehacer",[31,1230,1231],{},"Acercar y alejar",[23,1233,1235],{"id":1234},"preparar-e-importar","Preparar e importar",[28,1237,1238,1241,1244],{},[31,1239,1240],{},"Añade la selección o la pista completa a la lista de staging.",[31,1242,1243],{},"La lista empieza vacía: graba, edita y luego añade un clip.",[31,1245,1246,319,1248,599],{},[18,1247,595],{},[18,1249,598],{},[23,1251,1253],{"id":1252},"separación-de-stems-opcional","Separación de stems (opcional)",[14,1255,1256,1257,1260,1261,319,1264,1267],{},"Las builds oficiales de Windows, macOS y Linux incluyen la función ",[18,1258,1259],{},"stems",". El Record Editor puede conservar ",[18,1262,1263],{},"voces",[18,1265,1266],{},"música"," con BS-RoFormer.",[14,1269,1270,1271,1274,1275,1278],{},"El modelo pesa unos 158 MB y ",[18,1272,1273],{},"no"," viene en el instalador. Descárgalo desde ",[18,1276,1277],{},"Ajustes → Separación de stems",", o acepta el aviso del primer arranque. El instalador de Windows también puede ofrecer descargar el modelo al primer inicio.",[14,1280,1281,1282,41,1285,1288],{},"Las builds personalizadas desde código necesitan un flag extra (",[38,1283,1284],{},"tauri:serve:stems",[38,1286,1287],{},"tauri:build:stems",").",{"title":139,"searchDepth":140,"depth":140,"links":1290},[1291,1292,1293,1294],{"id":1172,"depth":140,"text":1173},{"id":1205,"depth":140,"text":1206},{"id":1234,"depth":140,"text":1235},{"id":1252,"depth":140,"text":1253},"Captura micrófono o audio del PC, edita el clip y suéltalo en tu tablero.",{},6,"\u002Frecording-editor",{"title":1158,"description":1295},"recording-editor","89aDSCp7hE8To2TNFwdWaImQVsHH2-xNcOyltCPP5IY",{"id":1303,"title":1304,"body":1305,"description":1517,"extension":147,"meta":1518,"navigation":149,"order":1519,"path":1520,"seo":1521,"stem":1522,"__hash__":1523},"content_es\u002Fremote-control.md","Control remoto",{"type":7,"value":1306,"toc":1510},[1307,1310,1313,1317,1346,1349,1352,1387,1391,1411,1414,1418,1450,1454,1460],[10,1308,1304],{"id":1309},"control-remoto",[14,1311,1312],{},"SoundNinja puede escuchar en tu red local para que Bitfocus Companion (o cualquier cliente HTTP\u002FWebSocket) reproduzca y detenga sonidos.",[23,1314,1316],{"id":1315},"activar-el-servidor-remoto","Activar el servidor remoto",[28,1318,1319,1324,1330,1336],{},[31,1320,527,1321,21],{},[18,1322,1323],{},"Ajustes → Remoto",[31,1325,1326,1327,21],{},"Activa el servidor remoto. El puerto por defecto es ",[18,1328,1329],{},"7331",[31,1331,1332,1333,21],{},"Opcional: define un token. Los clientes deben enviarlo como Bearer token o ",[38,1334,1335],{},"?token=",[31,1337,1338,1339,1342,1343,21],{},"Copia la URL ",[38,1340,1341],{},"http:\u002F\u002FIP:PORT",", o copia la IP del sistema desde ",[18,1344,1345],{},"Ajustes → Acerca de",[14,1347,1348],{},"Windows puede mostrar un aviso del firewall la primera vez que arranca el servidor. Permite el acceso a la red privada.",[23,1350,228],{"id":1351},"bitfocus-companion",[28,1353,1354,1361,1370,1380],{},[31,1355,1356,1357,21],{},"Instala ",[225,1358,228],{"href":1359,"rel":1360},"https:\u002F\u002Fbitfocus.io\u002Fcompanion",[246],[31,1362,1363,1364,1369],{},"Descarga ",[225,1365,1368],{"href":1366,"rel":1367},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002Fcompanion-module-soundninja\u002Freleases\u002Flatest",[246],"SoundNinja-Companion.tgz",". Aún no hay paquete en Companion Store.",[31,1371,1372,1373,1376,1377,21],{},"En Companion: ",[18,1374,1375],{},"Modules → Load module package"," y elige el ",[38,1378,1379],{},".tgz",[31,1381,1382,1383,1386],{},"Añade una conexión ",[18,1384,1385],{},"Sound Ninja",". Pega la IP del PC, el puerto y el token si definiste uno.",[23,1388,1390],{"id":1389},"acciones","Acciones",[66,1392,1393,1399,1405],{},[31,1394,1395,1398],{},[18,1396,1397],{},"Trigger Sound"," — elige en el menú desplegable en vivo, o escribe un ID de sonido de 8 caracteres (las variables de Companion funcionan)",[31,1400,1401,1404],{},[18,1402,1403],{},"Stop Sound"," — detiene un sonido en reproducción por ID",[31,1406,1407,1410],{},[18,1408,1409],{},"Stop All"," — detiene todos los sonidos en reproducción",[14,1412,1413],{},"Copia un ID de sonido en SoundNinja desde el menú contextual del botón o el chip de ID de la selección múltiple.",[23,1415,1417],{"id":1416},"feedbacks-y-variables","Feedbacks y variables",[66,1419,1420,1426,1438,1444],{},[31,1421,1422,1425],{},[18,1423,1424],{},"Sound Playing"," — verdadero mientras ese ID de sonido está activo (úsalo para el color del botón)",[31,1427,1428,1431,1432,41,1435],{},[38,1429,1430],{},"$(soundninja:connected)"," — ",[38,1433,1434],{},"true",[38,1436,1437],{},"false",[31,1439,1440,1443],{},[38,1441,1442],{},"$(soundninja:playing_count)"," — cuántos sonidos suenan",[31,1445,1446,1449],{},[38,1447,1448],{},"$(soundninja:last_triggered)"," — último ID de sonido disparado",[23,1451,1453],{"id":1452},"api-http-avanzado","API HTTP (avanzado)",[14,1455,1456,1457],{},"Ruta base: ",[38,1458,1459],{},"\u002Fapi\u002Fv1",[66,1461,1462,1468,1474,1480,1490,1496,1504],{},[31,1463,1464,1467],{},[38,1465,1466],{},"GET \u002Finfo"," — nombre de la app, versión, protocolo, si se requiere un token",[31,1469,1470,1473],{},[38,1471,1472],{},"GET \u002Fsounds"," — lista de sonidos (id, name, tabs, active)",[31,1475,1476,1479],{},[38,