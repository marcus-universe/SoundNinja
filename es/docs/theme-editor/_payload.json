[{"data":1,"prerenderedAt":1329},["ShallowReactive",2],{"docs-page-es-\u002Ftheme-editor":3,"docs-nav-es":155},{"id":4,"title":5,"body":6,"description":146,"extension":147,"meta":148,"navigation":149,"order":150,"path":151,"seo":152,"stem":153,"__hash__":154},"content_es\u002Ftheme-editor.md","Editor de temas",{"type":7,"value":8,"toc":138},"minimark",[9,13,22,27,58,61,65,80,84,110,113,117,124],[10,11,5],"h1",{"id":12},"editor-de-temas",[14,15,16,17,21],"p",{},"El Theme Creator es el editor visual completo de tu tablero. Ábrelo desde ",[18,19,20],"strong",{},"Ajustes → General → Theme Creator",".",[23,24,26],"h2",{"id":25},"tres-pestañas","Tres pestañas",[28,29,30,46,52],"ol",{},[31,32,33,36,37,41,42,45],"li",{},[18,34,35],{},"General"," — nombre del tema, colores compartidos y carga de fuentes (",[38,39,40],"code",{},".ttf"," \u002F ",[38,43,44],{},".otf",")",[31,47,48,51],{},[18,49,50],{},"Botones"," — colores, tipo, diseño y overlay GIF de los botones de sonido",[31,53,54,57],{},[18,55,56],{},"Pestañas"," — colores, tipo y grosor de borde de la barra de pestañas",[14,59,60],{},"Una vista previa en vivo muestra pestañas y botones mientras editas.",[23,62,64],{"id":63},"qué-puedes-cambiar","Qué puedes cambiar",[66,67,68,71,74,77],"ul",{},[31,69,70],{},"Colores primario y de acento, fondos, colores de botones, colores de pestañas",[31,72,73],{},"Familia y tamaño de fuente de botones y pestañas",[31,75,76],{},"Ancho, radio, borde, huecos y padding de los botones",[31,78,79],{},"Opacidad del overlay GIF (normal y hover)",[23,81,83],{"id":82},"guardar-y-compartir","Guardar y compartir",[66,85,86,92,98,104],{},[31,87,88,91],{},[18,89,90],{},"Exportar .css"," — escribe un archivo de tema para respaldar o enviar a un amigo",[31,93,94,97],{},[18,95,96],{},"Añadir a temas"," — guarda el archivo en tu carpeta Themes y aplícalo",[31,99,100,103],{},[18,101,102],{},"Importar .css"," — carga un preset integrado o un tema guardado",[31,105,106,109],{},[18,107,108],{},"Restablecer"," — vuelve a los valores por defecto de SoundNinja",[14,111,112],{},"Si cierras la ventana con cambios sin guardar, SoundNinja te pide que guardes primero.",[23,114,116],{"id":115},"sin-el-editor-completo","Sin el editor completo",[14,118,119,120,123],{},"En ",[18,121,122],{},"Ajustes → General"," aún puedes:",[66,125,126,129,135],{},[31,127,128],{},"Elegir un tema de la lista",[31,130,131,132,45],{},"Editar variables CSS en vivo (",[18,133,134],{},"CSS personalizado",[31,136,137],{},"Importar un archivo de tema a la carpeta Themes",{"title":139,"searchDepth":140,"depth":140,"links":141},"",2,[142,143,144,145],{"id":25,"depth":140,"text":26},{"id":63,"depth":140,"text":64},{"id":82,"depth":140,"text":83},{"id":115,"depth":140,"text":116},"Diseña colores, fuentes, botones y pestañas en el Theme Creator.","md",{},true,5,"\u002Ftheme-editor",{"title":5,"description":146},"theme-editor","bPcJP7OLtBsnNMYJ-S1J6DmB6nngULo1_Q1hBJMNZAQ",[156,277,476,624,778,867,1009,1231],{"id":157,"title":158,"body":159,"description":270,"extension":147,"meta":271,"navigation":149,"order":272,"path":273,"seo":274,"stem":275,"__hash__":276},"content_es\u002Foverview.md","Resumen",{"type":7,"value":160,"toc":264},[161,164,167,170,173,177,191,195,226,230,240,244],[10,162,158],{"id":163},"resumen",[14,165,166],{},"SoundNinja es un soundboard de código abierto para streaming en directo, charlas con amigos y grabación de podcasts. Está construido con Tauri v2 y Nuxt 4 para que sea ligero en RAM y disco.",[14,168,169],{},"El objetivo es simple: mantener una biblioteca enorme fácil de recorrer y reproducir el clip correcto en milisegundos. La interfaz también funciona bien como panel en VR.",[14,171,172],{},"SoundNinja sigue en desarrollo temprano. Las funciones marchan, pero no todas las plataformas están del todo probadas.",[23,174,176],{"id":175},"para-quién","Para quién",[66,178,179,182,185,188],{},[31,180,181],{},"Streamers que necesitan cues de sonido al instante",[31,183,184],{},"Amigos que quieren un tablero compartido para el chat de voz",[31,186,187],{},"Podcasters que graban clips y los sueltan en un tablero",[31,189,190],{},"Quien quiera un soundboard personalizable y local-first",[23,192,194],{"id":193},"qué-puedes-hacer","Qué puedes hacer",[66,196,197,200,203,206,209,212,220,223],{},[31,198,199],{},"Montar un soundboard con tus propios archivos de audio",[31,201,202],{},"Organizar sonidos en pestañas de colores, grupos y búsqueda",[31,204,205],{},"Diseñar el aspecto con el Theme Creator",[31,207,208],{},"Grabar audio del PC o un micrófono en el Record Editor",[31,210,211],{},"Asignar atajos a sonidos individuales",[31,213,214,215],{},"Disparar sonidos desde ",[216,217,219],"a",{"href":218},"\u002Fdocs\u002Fremote-control","Bitfocus Companion",[31,221,222],{},"Importar y exportar un soundboard completo para compartirlo",[31,224,225],{},"Usar GIFs o imágenes en los botones de sonido",[23,227,229],{"id":228},"licencia","Licencia",[14,231,232,233,239],{},"SoundNinja es software libre bajo ",[216,234,238],{"href":235,"rel":236},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fblob\u002Fmain\u002FLICENSE",[237],"nofollow","GPL-3.0",". Haz fork, cámbialo, compártelo.",[23,241,243],{"id":242},"siguientes-pasos","Siguientes pasos",[28,245,246,252,258],{},[31,247,248],{},[216,249,251],{"href":250},"\u002Fdocs\u002Finstallation","Instalar SoundNinja",[31,253,254],{},[216,255,257],{"href":256},"\u002Fdocs\u002Fadding-sounds","Añadir sonidos",[31,259,260],{},[216,261,263],{"href":262},"\u002Fdocs\u002Forganizing-sounds","Organizar tu tablero",{"title":139,"searchDepth":140,"depth":140,"links":265},[266,267,268,269],{"id":175,"depth":140,"text":176},{"id":193,"depth":140,"text":194},{"id":228,"depth":140,"text":229},{"id":242,"depth":140,"text":243},"Qué es SoundNinja y qué puedes hacer con él.",{},1,"\u002Foverview",{"title":158,"description":270},"overview","_jbFAqK9Ea28XfzNs3a2S9mJrWOMez_Uxtm9qlYTevc",{"id":278,"title":279,"body":280,"description":470,"extension":147,"meta":471,"navigation":149,"order":140,"path":472,"seo":473,"stem":474,"__hash__":475},"content_es\u002Finstallation.md","Instalación",{"type":7,"value":281,"toc":463},[282,285,299,303,321,324,328,342,345,349,373,384,388,395,399,414,444,459],[10,283,279],{"id":284},"instalación",[14,286,287,288,292,293,298],{},"Consigue una build en la ",[216,289,291],{"href":290},"\u002Fdownload","página de descarga"," o en ",[216,294,297],{"href":295,"rel":296},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Freleases\u002Flatest",[237],"GitHub Releases",". SoundNinja está en desarrollo temprano, así que trata las builds como beta.",[23,300,302],{"id":301},"windows","Windows",[66,304,305,315,318],{},[31,306,307,310,311,314],{},[18,308,309],{},"Instalador (.exe)"," o ",[18,312,313],{},"MSI (.msi)"," para Windows de 64 bits",[31,316,317],{},"Objetivo de la landing: Windows 10 y posterior",[31,319,320],{},"El README de la app también lista Windows 8 y superior",[14,322,323],{},"Ejecuta el instalador y luego abre SoundNinja desde el menú Inicio.",[23,325,327],{"id":326},"macos","macOS",[66,329,330,336,339],{},[31,331,332,335],{},[18,333,334],{},".dmg universal"," para Apple Silicon e Intel",[31,337,338],{},"Objetivo de la landing: macOS 10.14 y posterior",[31,340,341],{},"El README de la app lista macOS 10.15 y superior",[14,343,344],{},"Abre la imagen de disco y arrastra SoundNinja a Aplicaciones.",[23,346,348],{"id":347},"linux","Linux",[66,350,351,357,363,370],{},[31,352,353,356],{},[18,354,355],{},"Debian (.deb)"," para Ubuntu \u002F Debian",[31,358,359,362],{},[18,360,361],{},"AppImage"," para otras distros",[31,364,365,366,369],{},"Tras publicar una release, los usuarios de Arch pueden instalar ",[38,367,368],{},"soundninja-bin"," desde el AUR",[31,371,372],{},"Probado en Ubuntu 20.04",[14,374,375,376,379,380,383],{},"Las builds de escritorio necesitan paquetes WebKit y GTK. En Debian\u002FUbuntu eso suele ser ",[38,377,378],{},"libwebkit2gtk",", ",[38,381,382],{},"libgtk-3-0"," y una biblioteca app-indicator.",[23,385,387],{"id":386},"actualizaciones","Actualizaciones",[14,389,390,391,394],{},"En la app, abre ",[18,392,393],{},"Ayuda → Buscar actualizaciones",". También puedes dejar que SoundNinja compruebe al arrancar en Ajustes.",[23,396,398],{"id":397},"compilar-desde-el-código","Compilar desde el código",[14,400,401,402,407,408,413],{},"¿Necesitas una build personalizada? Clona ",[216,403,406],{"href":404,"rel":405},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja",[237],"el repo",", instala los ",[216,409,412],{"href":410,"rel":411},"https:\u002F\u002Fv2.tauri.app\u002Fstart\u002Fprerequisites\u002F",[237],"requisitos de Tauri"," y luego:",[415,416,420],"pre",{"className":417,"code":418,"language":419,"meta":139,"style":139},"language-bash shiki shiki-themes github-light github-dark","bun install\nbun run tauri:serve\n","bash",[38,421,422,434],{"__ignoreMap":139},[423,424,426,430],"span",{"class":425,"line":272},"line",[423,427,429],{"class":428},"sScJk","bun",[423,431,433],{"class":432},"sZZnC"," install\n",[423,435,436,438,441],{"class":425,"line":140},[423,437,429],{"class":428},[423,439,440],{"class":432}," run",[423,442,443],{"class":432}," tauri:serve\n",[14,445,446,379,449,310,452,455,456,21],{},[38,447,448],{},"npm",[38,450,451],{},"pnpm",[38,453,454],{},"deno"," también sirven. Build de producción: ",[38,457,458],{},"bun run tauri:build",[460,461,462],"style",{},"html pre.shiki code .sScJk, html code.shiki .sScJk{--shiki-default:#6F42C1;--shiki-dark:#B392F0}html pre.shiki code .sZZnC, html code.shiki .sZZnC{--shiki-default:#032F62;--shiki-dark:#9ECBFF}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html.dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}",{"title":139,"searchDepth":140,"depth":140,"links":464},[465,466,467,468,469],{"id":301,"depth":140,"text":302},{"id":326,"depth":140,"text":327},{"id":347,"depth":140,"text":348},{"id":386,"depth":140,"text":387},{"id":397,"depth":140,"text":398},"Instala SoundNinja en Windows, macOS o Linux.",{},"\u002Finstallation",{"title":279,"description":470},"installation","DZ0nnkuNJ5bWc2nnZMQjtBcj72EEzzogekGEbJUmx80",{"id":477,"title":257,"body":478,"description":617,"extension":147,"meta":618,"navigation":149,"order":619,"path":620,"seo":621,"stem":622,"__hash__":623},"content_es\u002Fadding-sounds.md",{"type":7,"value":479,"toc":609},[480,483,486,490,509,513,544,548,567,571,585,588,592,599,603],[10,481,257],{"id":482},"añadir-sonidos",[14,484,485],{},"Un tablero está vacío hasta que añades clips. SoundNinja puede importar archivos, carpetas enteras, una grabación o un pack de soundboard compartido.",[23,487,489],{"id":488},"importar-archivos-de-audio","Importar archivos de audio",[28,491,492,503,506],{},[31,493,494,495,498,499,502],{},"Abre ",[18,496,497],{},"Archivo → Importar archivos de audio",", o usa ",[18,500,501],{},"Importar"," en la barra de navegación.",[31,504,505],{},"Elige uno o más archivos de audio.",[31,507,508],{},"Los sonidos llegan a la pestaña actual.",[23,510,512],{"id":511},"importar-carpetas","Importar carpetas",[28,514,515,524,527],{},[31,516,494,517,520,521,523],{},[18,518,519],{},"Archivo → Importar carpetas"," (o ",[18,522,512],{}," en la barra de navegación).",[31,525,526],{},"Añade una o más carpetas. Arrastra para reordenarlas antes de importar.",[31,528,529,530],{},"Elige cómo llegan:\n",[66,531,532,538],{},[31,533,534,537],{},[18,535,536],{},"Importar como pestañas"," — cada carpeta se convierte en su propia pestaña",[31,539,540,543],{},[18,541,542],{},"Importar a la pestaña actual"," — cada archivo va a la pestaña activa",[23,545,547],{"id":546},"grabar-un-clip","Grabar un clip",[14,549,550,551,555,556,559,560,310,563,566],{},"Abre el ",[216,552,554],{"href":553},"\u002Fdocs\u002Frecording-editor","Record Editor"," desde el botón ",[18,557,558],{},"Grabar"," en la barra del reproductor. Captura, recorta y luego ",[18,561,562],{},"Importar selección",[18,564,565],{},"Importar todo"," en la pestaña actual o en una pestaña que elijas.",[23,568,570],{"id":569},"importar-un-soundboard","Importar un soundboard",[14,572,573,576,577,580,581,584],{},[18,574,575],{},"Archivo → Importar soundboard"," carga un pack compartido. Los packs son un ",[38,578,579],{},".zip"," que contiene ",[38,582,583],{},"project.sninja"," más los archivos de sonido. Tras importar, abre el proyecto y reproduce.",[14,586,587],{},"También puedes tener varios proyectos (perfiles). Usa el selector de proyecto para cambiar de tablero.",[23,589,591],{"id":590},"reenlazar-archivos-faltantes","Reenlazar archivos faltantes",[14,593,594,595,598],{},"Si los archivos de audio se mueven en el disco, SoundNinja muestra ",[18,596,597],{},"Archivos de sonido faltantes",". Elige una carpeta para buscar y reenlazar los clips.",[23,600,602],{"id":601},"siguiente","Siguiente",[14,604,605,606,21],{},"Organiza pestañas, grupos y atajos en ",[216,607,608],{"href":262},"Organizar sonidos",{"title":139,"searchDepth":140,"depth":140,"links":610},[611,612,613,614,615,616],{"id":488,"depth":140,"text":489},{"id":511,"depth":140,"text":512},{"id":546,"depth":140,"text":547},{"id":569,"depth":140,"text":570},{"id":590,"depth":140,"text":591},{"id":601,"depth":140,"text":602},"Importa audio, carpetas, grabaciones y soundboards compartidos.",{},3,"\u002Fadding-sounds",{"title":257,"description":617},"adding-sounds","Pp2z7pkBymoeTp058Pu8gOujI6GqQLoQ-Go0ZA2L1F4",{"id":625,"title":608,"body":626,"description":771,"extension":147,"meta":772,"navigation":149,"order":773,"path":774,"seo":775,"stem":776,"__hash__":777},"content_es\u002Forganizing-sounds.md",{"type":7,"value":627,"toc":762},[628,631,634,637,664,670,674,677,691,698,702,709,713,724,728,731,735,738,744,750,754],[10,629,608],{"id":630},"organizar-sonidos",[14,632,633],{},"SoundNinja está hecho para bibliotecas grandes. Usa pestañas, grupos, búsqueda y atajos para que el clip que necesitas esté a un clic (o una tecla) de distancia.",[23,635,56],{"id":636},"pestañas",[66,638,639,646,653],{},[31,640,641,642,645],{},"Añade una pestaña con ",[18,643,644],{},"Añadir pestaña",". Dale un color para escanear la barra rápido.",[31,647,648,649,652],{},"La vista ",[18,650,651],{},"Todos"," muestra cada sonido de todas las pestañas.",[31,654,655,656,659,660,663],{},"Un sonido puede pertenecer a ",[18,657,658],{},"una o más pestañas",". Clic derecho en un sonido y usa ",[18,661,662],{},"Mover a pestaña"," para asignarlo.",[14,665,666,667,669],{},"Las transiciones de pestaña están en ",[18,668,122],{},": Slide, Fade, Botones uno a uno, o Ninguna.",[23,671,673],{"id":672},"grupos","Grupos",[14,675,676],{},"Desde la v0.5.3, los separadores pueden convertirse en grupos con nombre:",[66,678,679,682,685,688],{},[31,680,681],{},"Añadir, renombrar o quitar un grupo desde el menú contextual",[31,683,684],{},"Arrastra la cabecera del grupo — los hijos se mueven con ella",[31,686,687],{},"Suelta sonidos dentro o fuera de un grupo",[31,689,690],{},"Define color de borde, color del nombre y alineación de botones (o usa el valor por defecto de la pestaña)",[14,692,693,694,697],{},"Sigue pudiendo añadir un ",[18,695,696],{},"Separador"," simple si solo necesitas un corte visual.",[23,699,701],{"id":700},"búsqueda","Búsqueda",[14,703,704,705,708],{},"Usa el campo ",[18,706,707],{},"Buscar"," en la barra de navegación. Los resultados se actualizan mientras escribes.",[23,710,712],{"id":711},"reordenar","Reordenar",[14,714,715,716,719,720,723],{},"Activa arrastrar y soltar en ",[18,717,718],{},"Ajustes → Comportamiento"," (",[18,721,722],{},"Permitir reordenar","). Luego arrastra sonidos y grupos a su sitio.",[23,725,727],{"id":726},"edición-masiva","Edición masiva",[14,729,730],{},"Selecciona varios sonidos y cambia el color, muévelos a una pestaña o elimínalos de una vez.",[23,732,734],{"id":733},"atajos-e-ids-de-sonido","Atajos e IDs de sonido",[14,736,737],{},"Cada sonido tiene un ID de 8 caracteres. Cópialo desde el menú contextual del botón o el chip de ID de la selección múltiple.",[14,739,494,740,743],{},[18,741,742],{},"Ajustes → Atajos"," para vincular una tecla a un ID de sonido. Los atajos globales son opcionales.",[14,745,746,747,749],{},"El mismo ID es el que ",[216,748,219],{"href":218}," usa para disparar un clip.",[23,751,753],{"id":752},"gifs-y-colores","GIFs y colores",[14,755,756,757,761],{},"Clic derecho en un sonido para definir colores por botón o un fondo GIF \u002F imagen. Eso es independiente del ",[216,758,760],{"href":759},"\u002Fdocs\u002Ftheme-editor","Theme Creator",", que da estilo a todo el tablero.",{"title":139,"searchDepth":140,"depth":140,"links":763},[764,765,766,767,768,769,770],{"id":636,"depth":140,"text":56},{"id":672,"depth":140,"text":673},{"id":700,"depth":140,"text":701},{"id":711,"depth":140,"text":712},{"id":726,"depth":140,"text":727},{"id":733,"depth":140,"text":734},{"id":752,"depth":140,"text":753},"Pestañas, grupos, búsqueda, edición masiva y atajos.",{},4,"\u002Forganizing-sounds",{"title":608,"description":771},"organizing-sounds","L2-ttc1gCTlJQIkJYckTzh-JzPPPTLU4m0uGjwPApXk",{"id":4,"title":5,"body":779,"description":14