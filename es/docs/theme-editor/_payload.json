[{"data":1,"prerenderedAt":1591},["ShallowReactive",2],{"docs-page-es-\u002Ftheme-editor":3,"docs-nav-es":155},{"id":4,"title":5,"body":6,"description":146,"extension":147,"meta":148,"navigation":149,"order":150,"path":151,"seo":152,"stem":153,"__hash__":154},"content_es\u002Ftheme-editor.md","Editor de temas",{"type":7,"value":8,"toc":138},"minimark",[9,13,22,27,58,61,65,80,84,110,113,117,124],[10,11,5],"h1",{"id":12},"editor-de-temas",[14,15,16,17,21],"p",{},"El Theme Creator es el editor visual completo de tu tablero. Ábrelo desde ",[18,19,20],"strong",{},"Ajustes → General → Theme Creator",".",[23,24,26],"h2",{"id":25},"tres-pestañas","Tres pestañas",[28,29,30,46,52],"ol",{},[31,32,33,36,37,41,42,45],"li",{},[18,34,35],{},"General"," — nombre del tema, colores compartidos y carga de fuentes (",[38,39,40],"code",{},".ttf"," \u002F ",[38,43,44],{},".otf",")",[31,47,48,51],{},[18,49,50],{},"Botones"," — colores, tipo, diseño y overlay GIF de los botones de sonido",[31,53,54,57],{},[18,55,56],{},"Pestañas"," — colores, tipo y grosor de borde de la barra de pestañas",[14,59,60],{},"Una vista previa en vivo muestra pestañas y botones mientras editas.",[23,62,64],{"id":63},"qué-puedes-cambiar","Qué puedes cambiar",[66,67,68,71,74,77],"ul",{},[31,69,70],{},"Colores primario y de acento, fondos, colores de botones, colores de pestañas",[31,72,73],{},"Familia y tamaño de fuente de botones y pestañas",[31,75,76],{},"Ancho, radio, borde, huecos y padding de los botones",[31,78,79],{},"Opacidad del overlay GIF (normal y hover)",[23,81,83],{"id":82},"guardar-y-compartir","Guardar y compartir",[66,85,86,92,98,104],{},[31,87,88,91],{},[18,89,90],{},"Exportar .css"," — escribe un archivo de tema para respaldar o enviar a un amigo",[31,93,94,97],{},[18,95,96],{},"Añadir a temas"," — guarda el archivo en tu carpeta Themes y aplícalo",[31,99,100,103],{},[18,101,102],{},"Importar .css"," — carga un preset integrado o un tema guardado",[31,105,106,109],{},[18,107,108],{},"Restablecer"," — vuelve a los valores por defecto de SoundNinja",[14,111,112],{},"Si cierras la ventana con cambios sin guardar, SoundNinja te pide que guardes primero.",[23,114,116],{"id":115},"sin-el-editor-completo","Sin el editor completo",[14,118,119,120,123],{},"En ",[18,121,122],{},"Ajustes → General"," aún puedes:",[66,125,126,129,135],{},[31,127,128],{},"Elegir un tema de la lista",[31,130,131,132,45],{},"Editar variables CSS en vivo (",[18,133,134],{},"CSS personalizado",[31,136,137],{},"Importar un archivo de tema a la carpeta Themes",{"title":139,"searchDepth":140,"depth":140,"links":141},"",2,[142,143,144,145],{"id":25,"depth":140,"text":26},{"id":63,"depth":140,"text":64},{"id":82,"depth":140,"text":83},{"id":115,"depth":140,"text":116},"Diseña colores, fuentes, botones y pestañas en el Theme Creator.","md",{},true,5,"\u002Ftheme-editor",{"title":5,"description":146},"theme-editor","bPcJP7OLtBsnNMYJ-S1J6DmB6nngULo1_Q1hBJMNZAQ",[156,286,488,636,1036,1125,1271,1493],{"id":157,"title":158,"body":159,"description":279,"extension":147,"meta":280,"navigation":149,"order":281,"path":282,"seo":283,"stem":284,"__hash__":285},"content_es\u002Foverview.md","Resumen",{"type":7,"value":160,"toc":273},[161,164,167,170,173,177,191,195,235,239,249,253],[10,162,158],{"id":163},"resumen",[14,165,166],{},"SoundNinja es un soundboard de código abierto para streaming en directo, charlas con amigos y grabación de podcasts. Está construido con Tauri v2 y Nuxt 4 para que sea ligero en RAM y disco.",[14,168,169],{},"El objetivo es simple: mantener una biblioteca enorme fácil de recorrer y reproducir el clip correcto en milisegundos. La interfaz también funciona bien como panel en VR.",[14,171,172],{},"SoundNinja sigue en desarrollo temprano. Las funciones marchan, pero no todas las plataformas están del todo probadas.",[23,174,176],{"id":175},"para-quién","Para quién",[66,178,179,182,185,188],{},[31,180,181],{},"Streamers que necesitan cues de sonido al instante",[31,183,184],{},"Amigos que quieren un tablero compartido para el chat de voz",[31,186,187],{},"Podcasters que graban clips y los sueltan en un tablero",[31,189,190],{},"Quien quiera un soundboard personalizable y local-first",[23,192,194],{"id":193},"qué-puedes-hacer","Qué puedes hacer",[66,196,197,200,203,206,209,212,215,218,221,229,232],{},[31,198,199],{},"Montar un soundboard con tus propios archivos de audio",[31,201,202],{},"Organizar sonidos en pestañas de colores, grupos, etiquetas y búsqueda",[31,204,205],{},"Filtrar por etiquetas (OR) y ordenar por nombre, fecha, duración o tamaño",[31,207,208],{},"Selección múltiple con marco o rango Mayús, luego color, mover o borrar en lote",[31,210,211],{},"Ajustar el volumen por sonido desde el menú contextual",[31,213,214],{},"Diseñar el aspecto con el Theme Creator",[31,216,217],{},"Grabar audio del PC o un micrófono en el Record Editor",[31,219,220],{},"Asignar atajos a sonidos individuales",[31,222,223,224],{},"Disparar sonidos desde ",[225,226,228],"a",{"href":227},"\u002Fdocs\u002Fremote-control","Bitfocus Companion",[31,230,231],{},"Importar y exportar un soundboard completo para compartirlo",[31,233,234],{},"Usar GIFs o imágenes en los botones — biblioteca local de carpetas o KLIPY",[23,236,238],{"id":237},"licencia","Licencia",[14,240,241,242,248],{},"SoundNinja es software libre bajo ",[225,243,247],{"href":244,"rel":245},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fblob\u002Fmain\u002FLICENSE",[246],"nofollow","GPL-3.0",". Haz fork, cámbialo, compártelo.",[23,250,252],{"id":251},"siguientes-pasos","Siguientes pasos",[28,254,255,261,267],{},[31,256,257],{},[225,258,260],{"href":259},"\u002Fdocs\u002Finstallation","Instalar SoundNinja",[31,262,263],{},[225,264,266],{"href":265},"\u002Fdocs\u002Fadding-sounds","Añadir sonidos",[31,268,269],{},[225,270,272],{"href":271},"\u002Fdocs\u002Forganizing-sounds","Organizar tu tablero",{"title":139,"searchDepth":140,"depth":140,"links":274},[275,276,277,278],{"id":175,"depth":140,"text":176},{"id":193,"depth":140,"text":194},{"id":237,"depth":140,"text":238},{"id":251,"depth":140,"text":252},"Qué es SoundNinja y qué puedes hacer con él.",{},1,"\u002Foverview",{"title":158,"description":279},"overview","XWpBFvtyid6BLXO3HByHppTxfsOo0i7DlSOMew5tq2g",{"id":287,"title":288,"body":289,"description":482,"extension":147,"meta":483,"navigation":149,"order":140,"path":484,"seo":485,"stem":486,"__hash__":487},"content_es\u002Finstallation.md","Instalación",{"type":7,"value":290,"toc":475},[291,294,308,312,333,336,340,354,357,361,385,396,400,407,411,426,456,471],[10,292,288],{"id":293},"instalación",[14,295,296,297,301,302,307],{},"Consigue una build en la ",[225,298,300],{"href":299},"\u002Fdownload","página de descarga"," o en ",[225,303,306],{"href":304,"rel":305},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Freleases\u002Flatest",[246],"GitHub Releases",". SoundNinja está en desarrollo temprano, así que trata las builds como beta.",[23,309,311],{"id":310},"windows","Windows",[66,313,314,324,327,330],{},[31,315,316,319,320,323],{},[18,317,318],{},"Instalador (.exe)"," o ",[18,321,322],{},"MSI (.msi)"," para Windows de 64 bits",[31,325,326],{},"Objetivo de la landing: Windows 10 y posterior",[31,328,329],{},"El README de la app también lista Windows 8 y superior",[31,331,332],{},"El instalador NSIS usa tema oscuro. Elige idioma en el setup — SoundNinja lo recuerda en el siguiente arranque.",[14,334,335],{},"Ejecuta el instalador y luego abre SoundNinja desde el menú Inicio.",[23,337,339],{"id":338},"macos","macOS",[66,341,342,348,351],{},[31,343,344,347],{},[18,345,346],{},".dmg universal"," para Apple Silicon e Intel",[31,349,350],{},"Objetivo de la landing: macOS 10.14 y posterior",[31,352,353],{},"El README de la app lista macOS 10.15 y superior",[14,355,356],{},"Abre la imagen de disco y arrastra SoundNinja a Aplicaciones.",[23,358,360],{"id":359},"linux","Linux",[66,362,363,369,375,382],{},[31,364,365,368],{},[18,366,367],{},"Debian (.deb)"," para Ubuntu \u002F Debian",[31,370,371,374],{},[18,372,373],{},"AppImage"," para otras distros",[31,376,377,378,381],{},"Tras publicar una release, los usuarios de Arch pueden instalar ",[38,379,380],{},"soundninja-bin"," desde el AUR",[31,383,384],{},"Probado en Ubuntu 20.04",[14,386,387,388,391,392,395],{},"Las builds de escritorio necesitan paquetes WebKit y GTK. En Debian\u002FUbuntu eso suele ser ",[38,389,390],{},"libwebkit2gtk",", ",[38,393,394],{},"libgtk-3-0"," y una biblioteca app-indicator.",[23,397,399],{"id":398},"actualizaciones","Actualizaciones",[14,401,402,403,406],{},"En la app, abre ",[18,404,405],{},"Ayuda → Buscar actualizaciones",". También puedes dejar que SoundNinja compruebe al arrancar en Ajustes.",[23,408,410],{"id":409},"compilar-desde-el-código","Compilar desde el código",[14,412,413,414,419,420,425],{},"¿Necesitas una build personalizada? Clona ",[225,415,418],{"href":416,"rel":417},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja",[246],"el repo",", instala los ",[225,421,424],{"href":422,"rel":423},"https:\u002F\u002Fv2.tauri.app\u002Fstart\u002Fprerequisites\u002F",[246],"requisitos de Tauri"," y luego:",[427,428,432],"pre",{"className":429,"code":430,"language":431,"meta":139,"style":139},"language-bash shiki shiki-themes github-light github-dark","bun install\nbun run tauri:serve\n","bash",[38,433,434,446],{"__ignoreMap":139},[435,436,438,442],"span",{"class":437,"line":281},"line",[435,439,441],{"class":440},"sScJk","bun",[435,443,445],{"class":444},"sZZnC"," install\n",[435,447,448,450,453],{"class":437,"line":140},[435,449,441],{"class":440},[435,451,452],{"class":444}," run",[435,454,455],{"class":444}," tauri:serve\n",[14,457,458,391,461,319,464,467,468,21],{},[38,459,460],{},"npm",[38,462,463],{},"pnpm",[38,465,466],{},"deno"," también sirven. Build de producción: ",[38,469,470],{},"bun run tauri:build",[472,473,474],"style",{},"html pre.shiki code .sScJk, html code.shiki .sScJk{--shiki-default:#6F42C1;--shiki-dark:#B392F0}html pre.shiki code .sZZnC, html code.shiki .sZZnC{--shiki-default:#032F62;--shiki-dark:#9ECBFF}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html.dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}",{"title":139,"searchDepth":140,"depth":140,"links":476},[477,478,479,480,481],{"id":310,"depth":140,"text":311},{"id":338,"depth":140,"text":339},{"id":359,"depth":140,"text":360},{"id":398,"depth":140,"text":399},{"id":409,"depth":140,"text":410},"Instala SoundNinja en Windows, macOS o Linux.",{},"\u002Finstallation",{"title":288,"description":482},"installation","zTwxz-vo_-k3K7RGGSHRG4ObTS6FkM9sbuxQPVMKTtY",{"id":489,"title":266,"body":490,"description":629,"extension":147,"meta":630,"navigation":149,"order":631,"path":632,"seo":633,"stem":634,"__hash__":635},"content_es\u002Fadding-sounds.md",{"type":7,"value":491,"toc":621},[492,495,498,502,521,525,556,560,579,583,597,600,604,611,615],[10,493,266],{"id":494},"añadir-sonidos",[14,496,497],{},"Un tablero está vacío hasta que añades clips. SoundNinja puede importar archivos, carpetas enteras, una grabación o un pack de soundboard compartido.",[23,499,501],{"id":500},"importar-archivos-de-audio","Importar archivos de audio",[28,503,504,515,518],{},[31,505,506,507,510,511,514],{},"Abre ",[18,508,509],{},"Archivo → Importar archivos de audio",", o usa ",[18,512,513],{},"Importar"," en la barra de navegación.",[31,516,517],{},"Elige uno o más archivos de audio.",[31,519,520],{},"Los sonidos llegan a la pestaña actual.",[23,522,524],{"id":523},"importar-carpetas","Importar carpetas",[28,526,527,536,539],{},[31,528,506,529,532,533,535],{},[18,530,531],{},"Archivo → Importar carpetas"," (o ",[18,534,524],{}," en la barra de navegación).",[31,537,538],{},"Añade una o más carpetas. Arrastra para reordenarlas antes de importar.",[31,540,541,542],{},"Elige cómo llegan:\n",[66,543,544,550],{},[31,545,546,549],{},[18,547,548],{},"Importar como pestañas"," — cada carpeta se convierte en su propia pestaña",[31,551,552,555],{},[18,553,554],{},"Importar a la pestaña actual"," — cada archivo va a la pestaña activa",[23,557,559],{"id":558},"grabar-un-clip","Grabar un clip",[14,561,562,563,567,568,571,572,319,575,578],{},"Abre el ",[225,564,566],{"href":565},"\u002Fdocs\u002Frecording-editor","Record Editor"," desde el botón ",[18,569,570],{},"Grabar"," en la barra del reproductor. Captura, recorta y luego ",[18,573,574],{},"Importar selección",[18,576,577],{},"Importar todo"," en la pestaña actual o en una pestaña que elijas.",[23,580,582],{"id":581},"importar-un-soundboard","Importar un soundboard",[14,584,585,588,589,592,593,596],{},[18,586,587],{},"Archivo → Importar soundboard"," carga un pack compartido. Los packs son un ",[38,590,591],{},".zip"," que contiene ",[38,594,595],{},"project.sninja"," más los archivos de sonido. Tras importar, abre el proyecto y reproduce.",[14,598,599],{},"También puedes tener varios proyectos (perfiles). Usa el selector de proyecto para cambiar de tablero.",[23,601,603],{"id":602},"reenlazar-archivos-faltantes","Reenlazar archivos faltantes",[14,605,606,607,610],{},"Si los archivos de audio se mueven en el disco, SoundNinja muestra ",[18,608,609],{},"Archivos de sonido faltantes",". Elige una carpeta para buscar y reenlazar los clips.",[23,612,614],{"id":613},"siguiente","Siguiente",[14,616,617,618,21],{},"Organiza pestañas, etiquetas, filtros y atajos en ",[225,619,620],{"href":271},"Organizar sonidos",{"title":139,"searchDepth":140,"depth":140,"links":622},[623,624,625,626,627,628],{"id":500,"depth":140,"text":501},{"id":523,"depth":140,"text":524},{"id":558,"depth":140,"text":559},{"id":581,"depth":140,"text":582},{"id":602,"depth":140,"text":603},{"id":613,"depth":140,"text":614},"Importa audio, carpetas, grabaciones y soundboards compartidos.",{},3,"\u002Fadding-sounds",{"title":266,"description":629},"adding-sounds","O5nOJGNq2FL6jafUxqoGYNKJDVbb2UrZRjfKpK21LlQ",{"id":637,"title":620,"body":638,"description":1029,"extension":147,"meta":1030,"navigation":149,"order":1031,"path":1032,"seo":1033,"stem":1034,"__hash__":1035},"content_es\u002Forganizing-sounds.md",{"type":7,"value":639,"toc":1014},[640,643,650,653,680,686,690,693,707,714,720,724,734,739,770,774,780,784,817,823,827,830,856,859,863,876,880,886,907,923,930,934,945,948,952,959,969,975,979,987,994,1011],[10,641,620],{"id":642},"organizar-sonidos",[14,644,645,646,649],{},"SoundNinja está hecho para bibliotecas grandes. ",[18,647,648],{},"Etiquetas y filtros",", pestañas, búsqueda, selección múltiple y atajos — el clip que necesitas está a un clic (o una tecla).",[23,651,56],{"id":652},"pestañas",[66,654,655,662,669],{},[31,656,657,658,661],{},"Añade una pestaña con ",[18,659,660],{},"Añadir pestaña",". Dale un color para escanear la barra rápido.",[31,663,664,665,668],{},"La vista ",[18,666,667],{},"Todos"," muestra cada sonido de todas las pestañas.",[31,670,671,672,675,676,679],{},"Un sonido puede pertenecer a ",[18,673,674],{},"una o más pestañas",". Clic derecho en un sonido y usa ",[18,677,678],{},"Mover a pestaña"," para asignarlo.",[14,681,682,683,685],{},"Las transiciones de pestaña están en ",[18,684,122],{},": Slide, Fade, Botones uno a uno, o Ninguna.",[23,687,689],{"id":688},"grupos","Grupos",[14,691,692],{},"Desde la v0.5.3, los separadores pueden convertirse en grupos con nombre:",[66,694,695,698,701,704],{},[31,696,697],{},"Añadir, renombrar o quitar un grupo desde el menú contextual",[31,699,700],{},"Arrastra la cabecera del grupo — los hijos se mueven con ella",[31,702,703],{},"Suelta sonidos dentro o fuera de un grupo",[31,705,706],{},"Define color de borde, color del nombre y alineación de botones (o usa el valor por defecto de la pestaña)",[14,708,709,710,713],{},"Sigue pudiendo añadir un ",[18,711,712],{},"Separador"," simple si solo necesitas un corte visual.",[14,715,716,717,21],{},"Clic derecho en el espacio vacío del tablero para ",[18,718,719],{},"Añadir grupo",[23,721,723],{"id":722},"etiquetas-filtros","Etiquetas \u002F Filtros",[14,725,726,727,730,731,733],{},"Las etiquetas cruzan las pestañas. El panel ",[18,728,729],{},"Filtro"," (barra lateral ",[18,732,729],{},") es donde las creas y filtras el tablero.",[735,736,738],"h3",{"id":737},"crear-y-editar-etiquetas","Crear y editar etiquetas",[28,740,741,746,756,763],{},[31,742,506,743,745],{},[18,744,729],{}," en la barra lateral.",[31,747,119,748,751,752,755],{},[18,749,750],{},"Etiquetas",", usa ",[18,753,754],{},"Añadir etiqueta"," — nombre y color.",[31,757,758,759,762],{},"Renombra, recolorea o ",[18,760,761],{},"Eliminar etiqueta"," en la misma lista.",[31,764,765,766,769],{},"Si ves ",[18,767,768],{},"Aún no hay etiquetas",", crea una aquí antes de asignar.",[735,771,773],{"id":772},"asignar-etiquetas-a-sonidos","Asignar etiquetas a sonidos",[14,775,776,777,779],{},"Clic derecho en un sonido → ",[18,778,750],{}," (casillas). Un sonido puede tener varias. Si aún no hay ninguna, el menú te lleva al panel de filtro.",[735,781,783],{"id":782},"filtrar-el-tablero","Filtrar el tablero",[66,785,786,792,803,814],{},[31,787,788,789,21],{},"Activa etiquetas en el panel Filtro o como ",[18,790,791],{},"chips bajo la barra de búsqueda",[31,793,794,795,798,799,802],{},"La coincidencia es ",[18,796,797],{},"OR",": un sonido sigue visible si tiene ",[18,800,801],{},"cualquiera"," de las etiquetas seleccionadas.",[31,804,805,806,809,810,813],{},"El campo ",[18,807,808],{},"Buscar"," combina con ",[18,811,812],{},"AND"," el filtro de etiquetas activo (texto + etiquetas juntos).",[31,815,816],{},"Apaga los chips (o limpia el filtro) para ver de nuevo toda la pestaña.",[14,818,819,820,21],{},"Los nombres de etiqueta en color pueden aparecer en los botones. Actívalos en ",[18,821,822],{},"Ajustes → Comportamiento → Mostrar badges de etiquetas",[23,824,826],{"id":825},"orden","Orden",[14,828,829],{},"Abre el panel de filtro y elige un modo:",[66,831,832,838],{},[31,833,834,837],{},[18,835,836],{},"Definido por el usuario"," — tu orden de pestaña, grupos visibles",[31,839,840,391,843,391,846,319,849,852,853],{},[18,841,842],{},"Nombre",[18,844,845],{},"Fecha de añadido",[18,847,848],{},"Tiempo de reproducción",[18,850,851],{},"Tamaño de archivo"," — lista plana ordenada; ",[18,854,855],{},"los grupos se ocultan",[14,857,858],{},"Ordenar por duración puede precargar los metadatos de duración la primera vez.",[23,860,862],{"id":861},"reordenar","Reordenar",[14,864,865,866,869,870,873,874,21],{},"Activa arrastrar y soltar en ",[18,867,868],{},"Ajustes → Comportamiento"," (",[18,871,872],{},"Permitir reordenar","). Luego arrastra sonidos y grupos a su sitio. Reordenar aplica en el orden ",[18,875,836],{},[23,877,879],{"id":878},"selección-múltiple","Selección múltiple",[14,881,882,883,885],{},"Activa ",[18,884,879],{}," en la barra de navegación, luego:",[66,887,888,891,897,904],{},[31,889,890],{},"Clic para alternar un sonido",[31,892,893,896],{},[18,894,895],{},"Mayús+clic"," para un rango desde el último ancla",[31,898,899,900,903],{},"Arrastra un ",[18,901,902],{},"marco"," en el espacio vacío del tablero",[31,905,906],{},"Clic en el tablero vacío (o fuera) para limpiar la selección",[14,908,909,910,391,913,391,916,919,920,21],{},"Una barra masiva muestra el recuento, más ",[18,911,912],{},"Color",[18,914,915],{},"Mover a pestaña…",[18,917,918],{},"Eliminar"," y ",[18,921,922],{},"Hecho",[14,924,925,926,929],{},"En selección múltiple, cada botón muestra un ",[18,927,928],{},"chip de ID de 8 caracteres",". Clic derecho en el chip para copiarlo.",[23,931,933],{"id":932},"volumen-por-sonido","Volumen por sonido",[14,935,936,937,940,941,944],{},"Clic derecho → ",[18,938,939],{},"Volumen",". Arrastra el control de 0 % a 100 %. ",[18,942,943],{},"Doble clic"," lo restablece a 100 %.",[14,946,947],{},"Se acumula con el volumen de salida maestro en Ajustes.",[23,949,951],{"id":950},"atajos-e-ids-de-sonido","Atajos e IDs de sonido",[14,953,954,955,958],{},"Cada sonido tiene un ID de 8 caracteres. Cópialo desde el menú contextual del botón (",[18,956,957],{},"Copiar ID",") o el chip de ID de la selección múltiple.",[14,960,506,961,964,965,968],{},[18,962,963],{},"Ajustes → Atajos"," para vincular una tecla a un ID de sonido. Los atajos globales son opcionales. ",[18,966,967],{},"Asignar atajo"," en el menú contextual salta allí con el ID rellenado.",[14,970,971,972,974],{},"El mismo ID es el que ",[225,973,228],{"href":227}," usa para disparar un clip.",[23,976,978],{"id":977},"imágenes-de-fondo-y-colores","Imágenes de fondo y colores",[14,980,981,982,986],{},"Clic derecho en un sonido para definir colores por botón o una imagen de fondo. Eso es independiente del ",[225,983,985],{"href":984},"\u002Fdocs\u002Ftheme-editor","Theme Creator",", que da estilo a todo el tablero.",[14,988,989,990,993],{},"El selector es un diálogo ",[18,991,992],{},"Imagen de fondo"," (PNG, JPEG, GIF, WebP):",[66,995,996,1002],{},[31,997,998,1001],{},[18,999,1000],{},"Archivos locales"," — añade carpetas, elige un archivo, busca por nombre, previsualiza la cuadrícula o quita una carpeta de la biblioteca",[31,1003,1004,1007,1008,1010],{},[18,1005,1006],{},"KLIPY"," — busca GIFs en línea. Pon tu propia clave API en ",[18,1009,868],{},". La clave no se guarda en los archivos del proyecto.",[14,1012,1013],{},"Tras elegir, mueve y recorta la imagen en el botón.",{"title":139,"searchDepth":140,"depth":140,"links":1015},[1016,1017,1018,1023,1024,1025,1026,1027,1028],{"id":652,"depth":140,"text":56},{"id":688,"depth":140,"text":689},{"id":722,"depth":140,"text":723,"children":1019},[1020,1021,1022],{"id":737,"depth":631,"text":738},{"id":772,"depth":631,"text":773},{"id":782,"depth":631,"text":783},{"id":825,"depth":140,"text":826},{"id":861,"depth":140,"text":862},{"id":878,"depth":140,"text":879},{"id":932,"depth":140,"text":933},{"id":950,"depth":140,"text":951},{"id":977,"depth":140,"text":978},"Etiquetas, filtros, pestañas, grupos, orden, selección múltiple, volumen y atajos.",{},4,"\u002Forganizing-sounds",{"title":620,"description":1029},"organizing-sounds","0TCdzxC5d9uOHlnFnD2ygCuD63pFk5yy3tK0Xgbpa7M",{"id":4,"title":5,"body":1037,"description":146,"extension":147,"meta":1123,"navigation":149,"order":150,"path":151,"seo":1124,"stem":153,"__hash__":154},{"type":7,"value":1038,"toc":1117},[1039,1041,1045,1047,1065,1067,1069,1079,1081,1099,1101,1103,1107],[10,1040,5],{"id":12},[14,1042,16,1043,21],{},[18,1044,20],{},[23,1046,26],{"id":25},[28,1048,1049,1057,1061],{},[31,1050,1051,36,1053,41,1055,45],{},[18,1052,35],{},[38,1054,40],{},[38,1056,44],{},[31,1058,1059,51],{},[18,1060,50],{},[31,1062,1063,57],{},[18,1064,56],{},[14,1066,60],{},[23,1068,64],{"id":63},[66,1070,1071,1073,1075,1077],{},[31,1072,70],{},[31,1074,73],{},[31,1076,76],{},[31,1078,79],{},[23,1080,83],{"id":82},[66,1082,1083,1087,1091,1095],{},[31,1084,1085,91],{},[18,1086,90],{},[31,1088,1089,97],{},[18,1090,96],{},[31,1092,1093,103],{},[18,1094,102],{},[31,1096,1097,109],{},[18,1098,108],{},[14,1100,112],{},[23,1102,116],{"id":115},[14,1104,119,1105,123],{},[18,1106,122],{},[66,1108,1109,1111,1115],{},[31,1110,128],{},[31,1112,131,1113,45],{},[18,1114,134],{},[31,1116,137],{},{"title":139,"searchDepth":140,"depth":140,"links":1118},[1119,1120,1121,1122],{"id":25,"depth":140,"text":26},{"id":63,"depth":140,"text":64},{"id":82,"depth":140,"text":83},{"id":115,"depth":140,"text":116},{},{"title":5,"description":146},{"id":1126,"title":1127,"body":1128,"description":1264,"extension":147,"meta":1265,"navigation":149,"order":1266,"path":1267,"seo":1268,"stem":1269,"__hash__":1270},"content_es\u002Frecording-editor.md","Editor de grabación",{"type":7,"value":1129,"toc":1258},[1130,1133,1139,1143,1149,1169,1172,1176,1201,1205,1219,1223,1237,1248],[10,1131,1127],{"id":1132},"editor-de-grabación",[14,1134,1135,1136,1138],{},"Graba un clip dentro de SoundNinja, recórtalo e impórtalo a una pestaña. Abre el editor con el botón ",[18,1137,570],{}," en la barra del reproductor.",[23,1140,1142],{"id":1141},"elegir-una-entrada","Elegir una entrada",[14,1144,119,1145,1148],{},[18,1146,1147],{},"Ajustes → Audio",":",[66,1150,1151,1157,1163],{},[31,1152,1153,1156],{},[18,1154,1155],{},"Dispositivos de entrada"," — micrófono",[31,1158,1159,1162],{},[18,1160,1161],{},"Dispositivos de salida (audio del PC)"," — loopback de lo que reproduce el PC",[31,1164,1165,1168],{},[18,1166,1167],{},"Volumen de entrada"," — ganancia de captura del 0 % al 200 %",[14,1170,1171],{},"El botón Grabar usa el dispositivo que eliges aquí.",[23,1173,1175],{"id":1174},"editar-la-toma","Editar la toma",[66,1177,1178,1181,1184,1192,1195,1198],{},[31,1179,1180],{},"Grabar y detener",[31,1182,1183],{},"Observar el medidor de nivel de entrada",[31,1185,1186,319,1189],{},[18,1187,1188],{},"Normalizar",[18,1190,1191],{},"Cancelación de ruido",[31,1193,1194],{},"Recortar todo el clip, recortar a una selección o borrar una selección",[31,1196,1197],{},"Deshacer \u002F rehacer",[31,1199,1200],{},"Acercar y alejar",[23,1202,1204],{"id":1203},"preparar-e-importar","Preparar e importar",[28,1206,1207,1210,1213],{},[31,1208,1209],{},"Añade la selección o la pista completa a la lista de staging.",[31,1211,1212],{},"La lista empieza vacía: graba, edita y luego añade un clip.",[31,1214,1215,319,1217,578],{},[18,1216,574],{},[18,1218,577],{},[23,1220,1222],{"id":1221},"separación-de-stems-opcional","Separación de stems (opcional)",[14,1224,1225,1226,1229,1230,319,1233,1236],{},"Las builds oficiales de Windows, macOS y Linux incluyen la función ",[18,1227,1228],{},"stems",". El Record Editor puede conservar ",[18,1231,1232],{},"voces",[18,1234,1235],{},"música"," con BS-RoFormer.",[14,1238,1239,1240,1243,1244,1247],{},"El modelo pesa unos 158 MB y ",[18,1241,1242],{},"no"," viene en el instalador. Descárgalo desde ",[18,1245,1246],{},"Ajustes → Separación de stems",", o acepta el aviso del primer arranque. El instalador de Windows también puede ofrecer descargar el modelo al primer inicio.",[14,1249,1250,1251,41,1254,1257],{},"Las builds personalizadas desde código necesitan un flag extra (",[38,1252,1253],{},"tauri:serve:stems",[38,1255,1256],{},"tauri:build:stems",").",{"title":139,"searchDepth":140,"depth":140,"links":1259},[1260,1261,1262,1263],{"id":1141,"depth":140,"text":1142},{"id":1174,"depth":140,"text":1175},{"id":1203,"depth":140,"text":1204},{"id":1221,"depth":140,"text":1222},"Captura micrófono o audio del PC, edita el clip y suéltalo en tu tablero.",{},6,"\u002Frecording-editor",{"title":1127,"description":1264},"recording-editor","89aDSCp7hE8To2TNFwdWaImQVsHH2-xNcOyltCPP5IY",{"id":1272,"title":1273,"body":1274,"description":1486,"extension":147,"meta":1487,"navigation":149,"order":1488,"path":1489,"seo":1490,"stem":1491,"__hash__":1492},"content_es\u002Fremote-control.md","Control remoto",{"type":7,"value":1275,"toc":1479},[1276,1279,1282,1286,1315,1318,1321,1356,1360,1380,1383,1387,1419,1423,1429],[10,1277,1273],{"id":1278},"control-remoto",[14,1280,1281],{},"SoundNinja puede escuchar en tu red local para que Bitfocus Companion (o cualquier cliente HTTP\u002FWebSocket) reproduzca y detenga sonidos.",[23,1283,1285],{"id":1284},"activar-el-servidor-remoto","Activar el servidor remoto",[28,1287,1288,1293,1299,1305],{},[31,1289,506,1290,21],{},[18,1291,1292],{},"Ajustes → Remoto",[31,1294,1295,1296,21],{},"Activa el servidor remoto. El puerto por defecto es ",[18,1297,1298],{},"7331",[31,1300,1301,1302,21],{},"Opcional: define un token. Los clientes deben enviarlo como Bearer token o ",[38,1303,1304],{},"?token=",[31,1306,1307,1308,1311,1312,21],{},"Copia la URL ",[38,1309,1310],{},"http:\u002F\u002FIP:PORT",", o copia la IP del sistema desde ",[18,1313,1314],{},"Ajustes → Acerca de",[14,1316,1317],{},"Windows puede mostrar un aviso del firewall la primera vez que arranca el servidor. Permite el acceso a la red privada.",[23,1319,228],{"id":1320},"bitfocus-companion",[28,1322,1323,1330,1339,1349],{},[31,1324,1325,1326,21],{},"Instala ",[225,1327,228],{"href":1328,"rel":1329},"https:\u002F\u002Fbitfocus.io\u002Fcompanion",[246],[31,1331,1332,1333,1338],{},"Descarga ",[225,1334,1337],{"href":1335,"rel":1336},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Freleases\u002Flatest\u002Fdownload\u002FSoundNinja-Companion.tgz",[246],"SoundNinja-Companion.tgz",". Aún no hay paquete en Companion Store.",[31,1340,1341,1342,1345,1346,21],{},"En Companion: ",[18,1343,1344],{},"Modules → Load module package"," y elige el ",[38,1347,1348],{},".tgz",[31,1350,1351,1352,1355],{},"Añade una conexión ",[18,1353,1354],{},"Sound Ninja",". Pega la IP del PC, el puerto y el token si definiste uno.",[23,1357,1359],{"id":1358},"acciones","Acciones",[66,1361,1362,1368,1374],{},[31,1363,1364,1367],{},[18,1365,1366],{},"Trigger Sound"," — elige en el menú desplegable en vivo, o escribe un ID de sonido de 8 caracteres (las variables de Companion funcionan)",[31,1369,1370,1373],{},[18,1371,1372],{},"Stop Sound"," — detiene un sonido en reproducción por ID",[31,1375,1376,1379],{},[18,1377,1378],{},"Stop All"," — detiene todos los sonidos en reproducción",[14,1381,1382],{},"Copia un ID de sonido en SoundNinja desde el menú contextual del botón o el chip de ID de la selección múltiple.",[23,1384,1386],{"id":1385},"feedbacks-y-variables","Feedbacks y variables",[66,1388,1389,1395,1407,1413],{},[31,1390,1391,1394],{},[18,1392,1393],{},"Sound Playing"," — verdadero mientras ese ID de sonido está activo (úsalo para el color del botón)",[31,1396,1397,1400,1401,41,1404],{},[38,1398,1399],{},"$(soundninja:connected)"," — ",[38,1402,1403],{},"true",[38,1405,1406],{},"false",[31,1408,1409,1412],{},[38,1410,1411],{},"$(soundninja:playing_count)"," — cuántos sonidos suenan",[31,1414,1415,1418],{},[38,1416,1417],{},"$(soundninja:last_triggered)"," — último ID de sonido disparado",[23,1420,1422],{"id":1421},"api-http-avanzado","API HTTP (avanzado)",[14,1424,1425,1426],{},"Ruta base: ",[38,1427,1428],{},"\u002Fapi\u002Fv1",[66,1430,1431,1437,1443,1449,1459,1465,1473],{},[31,1432,1433,1436],{},[38,1434,1435],{},"GET \u002Finfo"," — nombre de la app, versión, protocolo, si se requiere un token",[31,1438,1439,1442],{},[38,1440,1441],{},"GET \u002Fsounds"," — lista de sonidos (id, name, tabs, active)",[31,1444,1445,1448],{},[38,1446,1447],{},"GET \u002Fstate"," — sonidos más IDs que suenan ahora",[31,1450,1451,1454,1455,1458],{},[38,1452,1453],{},"POST \u002Ftrigger"," con ",[38,1456,1457],{},"{ \"id\" }"," — reproducir un sonido",[31,1460,1461,1464],{},[38,1462,1463],{},"GET \u002Ftrigger\u002F:id"," — reproducir (fácil de probar en el navegador)",[31,1466,1467,1454,1470,1472],{},[38,1468,1469],{},"POST \u002Fstop",[38,1471,1457],{}," opcional — detener un sonido o todos",[31,1474,1475,1478],{},[38,1476,1477],{},"GET \u002Fws"," — estado en vivo; enviar comandos trigger\u002Fstop de entrada",{"title":139,"searchDepth":140,"depth":140,"links":1480},[1481,1482,1483,1484,1485],{"id":1284,"depth":140,"text":1285},{"id":1320,"depth":140,"text":228},{"id":1358,"depth":140,"text":1359},{"id":1385,"depth":140,"text":1386},{"id":1421,"depth":140,"text":1422},"Dispara SoundNinja desde Bitfocus Companion en la red local.",{},7,"\u002Fremote-control",{"title":1273,"description":1486},"remote-control","bTIIsplmKgFYFnJhA-Du-dpqsYQjLONQUNuBpkY2Usg",{"id":1494,"title":1495,"body":1496,"description":1584,"extension":147,"meta":1585,"navigation":149,"order":1586,"path":1587,"seo":1588,"stem":1589,"__hash__":1590},"content_es\u002Fsupport.md","Soporte",{"type":7,"value":1497,"toc":1577},[1498,1501,1504,1508,1511,1518,1526,1530,1537,1539,1552,1556,1567,1571],[10,1499,1495],{"id":1500},"soporte",[14,1502,1503],{},"SoundNinja es un proyecto comunitario en beta temprana. La forma más rápida de pedir ayuda es GitHub.",[23,1505,1507],{"id":1506},"reportar-un-error-o-hacer-una-pregunta","Reportar un error o hacer una pregunta",[14,1509,1510],{},"Abre un issue en GitHub:",[14,1512,1513],{},[225,1514,1517],{"href":1515,"rel":1516},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fissues",[246],"github.com\u002Fmarcus-universe\u002FSoundNinja\u002Fissues",[14,1519,1520,1521,319,1523,1525],{},"Incluye tu SO, la versión de SoundNinja (",[18,1522,405],{},[18,1524,1314],{},") y los pasos para reproducirlo.",[23,1527,1529],{"id":1528},"correo","Correo",[14,1531,1532,1533],{},"Contacto del mantenedor: ",[225,1534,1536],{"href":1535},"mailto:contact@marcus-universe.de","contact@marcus-universe.de",[23,1538,399],{"id":398},[14,1540,1541,1542,1544,1545,1547,1548,21],{},"En la app, usa ",[18,1543,405],{},". Las builds nuevas también aparecen en la ",[225,1546,300],{"href":299}," y en ",[225,1549,306],{"href":1550,"rel":1551},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Freleases",[246],[23,1553,1555],{"id":1554},"contribuir","Contribuir",[14,1557,1558,1559,1563,1564,21],{},"Los pull requests son bienvenidos. El repo de la app es ",[225,1560,1562],{"href":416,"rel":1561},[246],"github.com\u002Fmarcus-universe\u002FSoundNinja",". El proyecto está bajo licencia ",[225,1565,247],{"href":244,"rel":1566},[246],[23,1568,1570],{"id":1569},"aviso-legal","Aviso legal",[14,1572,1573,1574,21],{},"Aviso legal y datos de contacto: ",[225,1575,1570],{"href":1576},"\u002Fimpressum",{"title":139,"searchDepth":140,"depth":140,"links":1578},[1579,1580,1581,1582,1583],{"id":1506,"depth":140,"text":1507},{"id":1528,"depth":140,"text":1529},{"id":398,"depth":140,"text":399},{"id":1554,"depth":140,"text":1555},{"id":1569,"depth":140,"text":1570},"Dónde pedir ayuda y reportar errores.",{},8,"\u002Fsupport",{"title":1495,"description":1584},"support","a00is-hTbQUOnHv2YiZDFMQVyUfDSKLK4GccVuiJQ9c",1789333836834]