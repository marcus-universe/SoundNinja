,{},[26,524,525,73],{},[30,526,72],{},[26,528,529,79],{},[30,530,78],{},[18,532,83],{"id":82},[14,534,86,535,92,537,96,539,100,541,104],{},[88,536,91],{"href":90},[30,538,95],{},[30,540,99],{},[30,542,103],{},[18,544,108],{"id":107},[14,546,547,114,549,119,551,123],{},[30,548,113],{},[116,550,118],{},[116,552,122],{},[14,554,126],{},[18,556,130],{"id":129},[14,558,133,559,137],{},[30,560,136],{},[18,562,141],{"id":140},[14,564,144,565,149],{},[88,566,148],{"href":147},{"title":151,"searchDepth":152,"depth":152,"links":568},[569,570,571,572,573,574],{"id":20,"depth":152,"text":21},{"id":46,"depth":152,"text":47},{"id":82,"depth":152,"text":83},{"id":107,"depth":152,"text":108},{"id":129,"depth":152,"text":130},{"id":140,"depth":152,"text":141},{},{"title":5,"description":160},{"id":578,"title":148,"body":579,"description":726,"extension":161,"meta":727,"navigation":163,"order":728,"path":729,"seo":730,"stem":731,"__hash__":732},"content_es\u002Forganizing-sounds.md",{"type":7,"value":580,"toc":717},[581,584,587,591,618,625,629,632,646,653,657,664,668,679,683,686,690,693,699,705,709],[10,582,148],{"id":583},"organizar-sonidos",[14,585,586],{},"SoundNinja está hecho para bibliotecas grandes. Usa pestañas, grupos, búsqueda y atajos para que el clip que necesitas esté a un clic (o una tecla) de distancia.",[18,588,590],{"id":589},"pestañas","Pestañas",[66,592,593,600,607],{},[26,594,595,596,599],{},"Añade una pestaña con ",[30,597,598],{},"Añadir pestaña",". Dale un color para escanear la barra rápido.",[26,601,602,603,606],{},"La vista ",[30,604,605],{},"Todos"," muestra cada sonido de todas las pestañas.",[26,608,609,610,613,614,617],{},"Un sonido puede pertenecer a ",[30,611,612],{},"una o más pestañas",". Clic derecho en un sonido y usa ",[30,615,616],{},"Mover a pestaña"," para asignarlo.",[14,619,620,621,624],{},"Las transiciones de pestaña están en ",[30,622,623],{},"Ajustes → General",": Slide, Fade, Botones uno a uno, o Ninguna.",[18,626,628],{"id":627},"grupos","Grupos",[14,630,631],{},"Desde la v0.5.3, los separadores pueden convertirse en grupos con nombre:",[66,633,634,637,640,643],{},[26,635,636],{},"Añadir, renombrar o quitar un grupo desde el menú contextual",[26,638,639],{},"Arrastra la cabecera del grupo — los hijos se mueven con ella",[26,641,642],{},"Suelta sonidos dentro o fuera de un grupo",[26,644,645],{},"Define color de borde, color del nombre y alineación de botones (o usa el valor por defecto de la pestaña)",[14,647,648,649,652],{},"Sigue pudiendo añadir un ",[30,650,651],{},"Separador"," simple si solo necesitas un corte visual.",[18,654,656],{"id":655},"búsqueda","Búsqueda",[14,658,659,660,663],{},"Usa el campo ",[30,661,662],{},"Buscar"," en la barra de navegación. Los resultados se actualizan mientras escribes.",[18,665,667],{"id":666},"reordenar","Reordenar",[14,669,670,671,674,675,678],{},"Activa arrastrar y soltar en ",[30,672,673],{},"Ajustes → Comportamiento"," (",[30,676,677],{},"Permitir reordenar","). Luego arrastra sonidos y grupos a su sitio.",[18,680,682],{"id":681},"edición-masiva","Edición masiva",[14,684,685],{},"Selecciona varios sonidos y cambia el color, muévelos a una pestaña o elimínalos de una vez.",[18,687,689],{"id":688},"atajos-e-ids-de-sonido","Atajos e IDs de sonido",[14,691,692],{},"Cada sonido tiene un ID de 8 caracteres. Cópialo desde el menú contextual del botón o el chip de ID de la selección múltiple.",[14,694,28,695,698],{},[30,696,697],{},"Ajustes → Atajos"," para vincular una tecla a un ID de sonido. Los atajos globales son opcionales.",[14,700,701,702,704],{},"El mismo ID es el que ",[88,703,232],{"href":231}," usa para disparar un clip.",[18,706,708],{"id":707},"gifs-y-colores","GIFs y colores",[14,710,711,712,716],{},"Clic derecho en un sonido para definir colores por botón o un fondo GIF \u002F imagen. Eso es independiente del ",[88,713,715],{"href":714},"\u002Fdocs\u002Ftheme-editor","Theme Creator",", que da estilo a todo el tablero.",{"title":151,"searchDepth":152,"depth":152,"links":718},[719,720,721,722,723,724,725],{"id":589,"depth":152,"text":590},{"id":627,"depth":152,"text":628},{"id":655,"depth":152,"text":656},{"id":666,"depth":152,"text":667},{"id":681,"depth":152,"text":682},{"id":688,"depth":152,"text":689},{"id":707,"depth":152,"text":708},"Pestañas, grupos, búsqueda, edición masiva y atajos.",{},4,"\u002Forganizing-sounds",{"title":148,"description":726},"organizing-sounds","L2-ttc1gCTlJQIkJYckTzh-JzPPPTLU4m0uGjwPApXk",{"id":734,"title":735,"body":736,"description":862,"extension":161,"meta":863,"navigation":163,"order":864,"path":865,"seo":866,"stem":867,"__hash__":868},"content_es\u002Ftheme-editor.md","Editor de temas",{"type":7,"value":737,"toc":856},[738,741,747,751,778,781,785,799,803,829,832,836,842],[10,739,735],{"id":740},"editor-de-temas",[14,742,743,744,149],{},"El Theme Creator es el editor visual completo de tu tablero. Ábrelo desde ",[30,745,746],{},"Ajustes → General → Theme Creator",[18,748,750],{"id":749},"tres-pestañas","Tres pestañas",[23,752,753,767,773],{},[26,754,755,758,759,762,763,766],{},[30,756,757],{},"General"," — nombre del tema, colores compartidos y carga de fuentes (",[116,760,761],{},".ttf"," \u002F ",[116,764,765],{},".otf",")",[26,768,769,772],{},[30,770,771],{},"Botones"," — colores, tipo, diseño y overlay GIF de los botones de sonido",[26,774,775,777],{},[30,776,590],{}," — colores, tipo y grosor de borde de la barra de pestañas",[14,779,780],{},"Una vista previa en vivo muestra pestañas y botones mientras editas.",[18,782,784],{"id":783},"qué-puedes-cambiar","Qué puedes cambiar",[66,786,787,790,793,796],{},[26,788,789],{},"Colores primario y de acento, fondos, colores de botones, colores de pestañas",[26,791,792],{},"Familia y tamaño de fuente de botones y pestañas",[26,794,795],{},"Ancho, radio, borde, huecos y padding de los botones",[26,797,798],{},"Opacidad del overlay GIF (normal y hover)",[18,800,802],{"id":801},"guardar-y-compartir","Guardar y compartir",[66,804,805,811,817,823],{},[26,806,807,810],{},[30,808,809],{},"Exportar .css"," — escribe un archivo de tema para respaldar o enviar a un amigo",[26,812,813,816],{},[30,814,815],{},"Añadir a temas"," — guarda el archivo en tu carpeta Themes y aplícalo",[26,818,819,822],{},[30,820,821],{},"Importar .css"," — carga un preset integrado o un tema guardado",[26,824,825,828],{},[30,826,827],{},"Restablecer"," — vuelve a los valores por defecto de SoundNinja",[14,830,831],{},"Si cierras la ventana con cambios sin guardar, SoundNinja te pide que guardes primero.",[18,833,835],{"id":834},"sin-el-editor-completo","Sin el editor completo",[14,837,838,839,841],{},"En ",[30,840,623],{}," aún puedes:",[66,843,844,847,853],{},[26,845,846],{},"Elegir un tema de la lista",[26,848,849,850,766],{},"Editar variables CSS en vivo (",[30,851,852],{},"CSS personalizado",[26,854,855],{},"Importar un archivo de tema a la carpeta Themes",{"title":151,"searchDepth":152,"depth":152,"links":857},[858,859,860,861],{"id":749,"depth":152,"text":750},{"id":783,"depth":152,"text":784},{"id":801,"depth":152,"text":802},{"id":834,"depth":152,"text":835},"Diseña colores, fuentes, botones y pestañas en el Theme Creator.",{},5,"\u002Ftheme-editor",{"title":735,"description":862},"theme-editor","bPcJP7OLtBsnNMYJ-S1J6DmB6nngULo1_Q1hBJMNZAQ",{"id":870,"title":871,"body":872,"description":1004,"extension":161,"meta":1005,"navigation":163,"order":1006,"path":1007,"seo":1008,"stem":1009,"__hash__":1010},"content_es\u002Frecording-editor.md","Editor de grabación",{"type":7,"value":873,"toc":998},[874,877,883,887,893,913,916,920,945,949,963,967,981,988],[10,875,871],{"id":876},"editor-de-grabación",[14,878,879,880,882],{},"Graba un clip dentro de SoundNinja, recórtalo e impórtalo a una pestaña. Abre el editor con el botón ",[30,881,95],{}," en la barra del reproductor.",[18,884,886],{"id":885},"elegir-una-entrada","Elegir una entrada",[14,888,838,889,892],{},[30,890,891],{},"Ajustes → Audio",":",[66,894,895,901,907],{},[