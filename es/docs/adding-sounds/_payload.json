[{"data":1,"prerenderedAt":1624},["ShallowReactive",2],{"docs-page-es-\u002Fadding-sounds":3,"docs-nav-es":169},{"id":4,"title":5,"body":6,"description":160,"extension":161,"meta":162,"navigation":163,"order":164,"path":165,"seo":166,"stem":167,"__hash__":168},"content_es\u002Fadding-sounds.md","Añadir sonidos",{"type":7,"value":8,"toc":150},"minimark",[9,13,17,22,44,48,80,84,105,109,124,127,131,138,142],[10,11,5],"h1",{"id":12},"añadir-sonidos",[14,15,16],"p",{},"Un tablero está vacío hasta que añades clips. SoundNinja puede importar archivos, carpetas enteras, una grabación o un pack de soundboard compartido.",[18,19,21],"h2",{"id":20},"importar-archivos-de-audio","Importar archivos de audio",[23,24,25,38,41],"ol",{},[26,27,28,29,33,34,37],"li",{},"Abre ",[30,31,32],"strong",{},"Archivo → Importar archivos de audio",", o usa ",[30,35,36],{},"Importar"," en la barra de navegación.",[26,39,40],{},"Elige uno o más archivos de audio.",[26,42,43],{},"Los sonidos llegan a la pestaña actual.",[18,45,47],{"id":46},"importar-carpetas","Importar carpetas",[23,49,50,59,62],{},[26,51,28,52,55,56,58],{},[30,53,54],{},"Archivo → Importar carpetas"," (o ",[30,57,47],{}," en la barra de navegación).",[26,60,61],{},"Añade una o más carpetas. Arrastra para reordenarlas antes de importar.",[26,63,64,65],{},"Elige cómo llegan:\n",[66,67,68,74],"ul",{},[26,69,70,73],{},[30,71,72],{},"Importar como pestañas"," — cada carpeta se convierte en su propia pestaña",[26,75,76,79],{},[30,77,78],{},"Importar a la pestaña actual"," — cada archivo va a la pestaña activa",[18,81,83],{"id":82},"grabar-un-clip","Grabar un clip",[14,85,86,87,92,93,96,97,100,101,104],{},"Abre el ",[88,89,91],"a",{"href":90},"\u002Fdocs\u002Frecording-editor","Record Editor"," desde el botón ",[30,94,95],{},"Grabar"," en la barra del reproductor. Captura, recorta y luego ",[30,98,99],{},"Importar selección"," o ",[30,102,103],{},"Importar todo"," en la pestaña actual o en una pestaña que elijas.",[18,106,108],{"id":107},"importar-un-soundboard","Importar un soundboard",[14,110,111,114,115,119,120,123],{},[30,112,113],{},"Archivo → Importar soundboard"," carga un pack compartido. Los packs son un ",[116,117,118],"code",{},".zip"," que contiene ",[116,121,122],{},"project.sninja"," más los archivos de sonido. Tras importar, abre el proyecto y reproduce.",[14,125,126],{},"También puedes tener varios proyectos (perfiles). Usa el selector de proyecto para cambiar de tablero.",[18,128,130],{"id":129},"reenlazar-archivos-faltantes","Reenlazar archivos faltantes",[14,132,133,134,137],{},"Si los archivos de audio se mueven en el disco, SoundNinja muestra ",[30,135,136],{},"Archivos de sonido faltantes",". Elige una carpeta para buscar y reenlazar los clips.",[18,139,141],{"id":140},"siguiente","Siguiente",[14,143,144,145,149],{},"Organiza pestañas, etiquetas, filtros y atajos en ",[88,146,148],{"href":147},"\u002Fdocs\u002Forganizing-sounds","Organizar sonidos",".",{"title":151,"searchDepth":152,"depth":152,"links":153},"",2,[154,155,156,157,158,159],{"id":20,"depth":152,"text":21},{"id":46,"depth":152,"text":47},{"id":82,"depth":152,"text":83},{"id":107,"depth":152,"text":108},{"id":129,"depth":152,"text":130},{"id":140,"depth":152,"text":141},"Importa audio, carpetas, grabaciones y soundboards compartidos.","md",{},true,3,"\u002Fadding-sounds",{"title":5,"description":160},"adding-sounds","O5nOJGNq2FL6jafUxqoGYNKJDVbb2UrZRjfKpK21LlQ",[170,297,519,610,1023,1158,1304,1526],{"id":171,"title":172,"body":173,"description":290,"extension":161,"meta":291,"navigation":163,"order":292,"path":293,"seo":294,"stem":295,"__hash__":296},"content_es\u002Foverview.md","Resumen",{"type":7,"value":174,"toc":284},[175,178,181,184,187,191,205,209,248,252,262,266],[10,176,172],{"id":177},"resumen",[14,179,180],{},"SoundNinja es un soundboard de código abierto para streaming en directo, charlas con amigos y grabación de podcasts. Está construido con Tauri v2 y Nuxt 4 para que sea ligero en RAM y disco.",[14,182,183],{},"El objetivo es simple: mantener una biblioteca enorme fácil de recorrer y reproducir el clip correcto en milisegundos. La interfaz también funciona bien como panel en VR.",[14,185,186],{},"SoundNinja sigue en desarrollo temprano. Las funciones marchan, pero no todas las plataformas están del todo probadas.",[18,188,190],{"id":189},"para-quién","Para quién",[66,192,193,196,199,202],{},[26,194,195],{},"Streamers que necesitan cues de sonido al instante",[26,197,198],{},"Amigos que quieren un tablero compartido para el chat de voz",[26,200,201],{},"Podcasters que graban clips y los sueltan en un tablero",[26,203,204],{},"Quien quiera un soundboard personalizable y local-first",[18,206,208],{"id":207},"qué-puedes-hacer","Qué puedes hacer",[66,210,211,214,217,220,223,226,229,232,235,242,245],{},[26,212,213],{},"Montar un soundboard con tus propios archivos de audio",[26,215,216],{},"Organizar sonidos en pestañas de colores, grupos, etiquetas y búsqueda",[26,218,219],{},"Filtrar por etiquetas (OR) y ordenar por nombre, fecha, duración o tamaño",[26,221,222],{},"Selección múltiple con marco o rango Mayús, luego color, mover o borrar en lote",[26,224,225],{},"Ajustar el volumen por sonido desde el menú contextual",[26,227,228],{},"Diseñar el aspecto con el Theme Creator",[26,230,231],{},"Grabar audio del PC o un micrófono en el Record Editor",[26,233,234],{},"Asignar atajos a sonidos individuales",[26,236,237,238],{},"Disparar sonidos desde ",[88,239,241],{"href":240},"\u002Fdocs\u002Fremote-control","Bitfocus Companion",[26,243,244],{},"Importar y exportar un soundboard completo para compartirlo",[26,246,247],{},"Usar GIFs o imágenes en los botones — biblioteca local de carpetas, GifSnap o KLIPY",[18,249,251],{"id":250},"licencia","Licencia",[14,253,254,255,261],{},"SoundNinja es software libre bajo ",[88,256,260],{"href":257,"rel":258},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fblob\u002Fmain\u002FLICENSE",[259],"nofollow","GPL-3.0",". Haz fork, cámbialo, compártelo.",[18,263,265],{"id":264},"siguientes-pasos","Siguientes pasos",[23,267,268,274,279],{},[26,269,270],{},[88,271,273],{"href":272},"\u002Fdocs\u002Finstallation","Instalar SoundNinja",[26,275,276],{},[88,277,5],{"href":278},"\u002Fdocs\u002Fadding-sounds",[26,280,281],{},[88,282,283],{"href":147},"Organizar tu tablero",{"title":151,"searchDepth":152,"depth":152,"links":285},[286,287,288,289],{"id":189,"depth":152,"text":190},{"id":207,"depth":152,"text":208},{"id":250,"depth":152,"text":251},{"id":264,"depth":152,"text":265},"Qué es SoundNinja y qué puedes hacer con él.",{},1,"\u002Foverview",{"title":172,"description":290},"overview","aVQIpArgBh8Yx660xBvwTxx-97ukf5Chr1A7jNPd3UE",{"id":298,"title":299,"body":300,"description":513,"extension":161,"meta":514,"navigation":163,"order":152,"path":515,"seo":516,"stem":517,"__hash__":518},"content_es\u002Finstallation.md","Instalación",{"type":7,"value":301,"toc":506},[302,305,319,323,343,346,350,364,367,371,395,406,410,417,421,436,466,481,502],[10,303,299],{"id":304},"instalación",[14,306,307,308,312,313,318],{},"Consigue una build en la ",[88,309,311],{"href":310},"\u002Fdownload","página de descarga"," o en ",[88,314,317],{"href":315,"rel":316},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Freleases\u002Flatest",[259],"GitHub Releases",". SoundNinja está en desarrollo temprano, así que trata las builds como beta.",[18,320,322],{"id":321},"windows","Windows",[66,324,325,334,337,340],{},[26,326,327,100,330,333],{},[30,328,329],{},"Instalador (.exe)",[30,331,332],{},"MSI (.msi)"," para Windows de 64 bits",[26,335,336],{},"Objetivo de la landing: Windows 10 y posterior",[26,338,339],{},"El README de la app también lista Windows 8 y superior",[26,341,342],{},"El instalador NSIS usa tema oscuro. Elige idioma en el setup — SoundNinja lo recuerda en el siguiente arranque.",[14,344,345],{},"Ejecuta el instalador y luego abre SoundNinja desde el menú Inicio.",[18,347,349],{"id":348},"macos","macOS",[66,351,352,358,361],{},[26,353,354,357],{},[30,355,356],{},".dmg universal"," para Apple Silicon e Intel",[26,359,360],{},"Objetivo de la landing: macOS 10.14 y posterior",[26,362,363],{},"El README de la app lista macOS 10.15 y superior",[14,365,366],{},"Abre la imagen de disco y arrastra SoundNinja a Aplicaciones.",[18,368,370],{"id":369},"linux","Linux",[66,372,373,379,385,392],{},[26,374,375,378],{},[30,376,377],{},"Debian (.deb)"," para Ubuntu \u002F Debian",[26,380,381,384],{},[30,382,383],{},"AppImage"," para otras distros",[26,386,387,388,391],{},"Tras publicar una release, los usuarios de Arch pueden instalar ",[116,389,390],{},"soundninja-bin"," desde el AUR",[26,393,394],{},"Probado en Ubuntu 20.04",[14,396,397,398,401,402,405],{},"Las builds de escritorio necesitan paquetes WebKit y GTK. En Debian\u002FUbuntu eso suele ser ",[116,399,400],{},"libwebkit2gtk",", ",[116,403,404],{},"libgtk-3-0"," y una biblioteca app-indicator.",[18,407,409],{"id":408},"actualizaciones","Actualizaciones",[14,411,412,413,416],{},"En la app, abre ",[30,414,415],{},"Ayuda → Buscar actualizaciones",". También puedes dejar que SoundNinja compruebe al arrancar en Ajustes.",[18,418,420],{"id":419},"compilar-desde-el-código","Compilar desde el código",[14,422,423,424,429,430,435],{},"¿Necesitas una build personalizada? Clona ",[88,425,428],{"href":426,"rel":427},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja",[259],"el repo",", instala los ",[88,431,434],{"href":432,"rel":433},"https:\u002F\u002Fv2.tauri.app\u002Fstart\u002Fprerequisites\u002F",[259],"requisitos de Tauri"," y luego:",[437,438,442],"pre",{"className":439,"code":440,"language":441,"meta":151,"style":151},"language-bash shiki shiki-themes github-light github-dark","bun install\nbun run tauri:serve\n","bash",[116,443,444,456],{"__ignoreMap":151},[445,446,448,452],"span",{"class":447,"line":292},"line",[445,449,451],{"class":450},"sScJk","bun",[445,453,455],{"class":454},"sZZnC"," install\n",[445,457,458,460,463],{"class":447,"line":152},[445,459,451],{"class":450},[445,461,462],{"class":454}," run",[445,464,465],{"class":454}," tauri:serve\n",[14,467,468,401,471,100,474,477,478,149],{},[116,469,470],{},"npm",[116,472,473],{},"pnpm",[116,475,476],{},"deno"," también sirven. Build de producción: ",[116,479,480],{},"bun run tauri:build",[14,482,483,486,487,492,493,496,497,149],{},[30,484,485],{},"Solo Windows:"," cada compile de Windows incluye ASIO con el ",[88,488,491],{"href":489,"rel":490},"https:\u002F\u002Fwww.steinberg.net\u002Fasiosdk",[259],"Steinberg ASIO SDK",". Ejecuta ",[116,494,495],{},"bun run setup:asio"," una vez (el SDK no está en git). Linux y macOS usan PipeWire \u002F Core Audio — omite ese paso. Detalles: ",[88,498,501],{"href":499,"rel":500},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fblob\u002Fmain\u002Fdocs\u002Fbuild-from-source.md",[259],"build-from-source.md",[503,504,505],"style",{},"html pre.shiki code .sScJk, html code.shiki .sScJk{--shiki-default:#6F42C1;--shiki-dark:#B392F0}html pre.shiki code .sZZnC, html code.shiki .sZZnC{--shiki-default:#032F62;--shiki-dark:#9ECBFF}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html.dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}",{"title":151,"searchDepth":152,"depth":152,"links":507},[508,509,510,511,512],{"id":321,"depth":152,"text":322},{"id":348,"depth":152,"text":349},{"id":369,"depth":152,"text":370},{"id":408,"depth":152,"text":409},{"id":419,"depth":152,"text":420},"Instala SoundNinja en Windows, macOS o Linux.",{},"\u002Finstallation",{"title":299,"description":513},"installation","6QKa3OcTs0sq8JVvjceX-ugwL8mdPc4h6O-JOoo1Qd8",{"id":4,"title":5,"body":520,"description":160,"extension":161,"meta":608,"navigation":163,"order":164,"path":165,"seo":609,"stem":167,"__hash__":168},{"type":7,"value":521,"toc":600},[522,524,526,528,540,542,564,566,576,578,586,588,590,594,596],[10,523,5],{"id":12},[14,525,16],{},[18,527,21],{"id":20},[23,529,530,536,538],{},[26,531,28,532,33,534,37],{},[30,533,32],{},[30,535,36],{},[26,537,40],{},[26,539,43],{},[18,541,47],{"id":46},[23,543,544,550,552],{},[26,545,28,546,55,548,58],{},[30,547,54],{},[30,549,47],{},[26,551,61],{},[26,553,64,554],{},[66,555,556,560],{},[26,557,558,73],{},[30,559,72],{},[26,561,562,79],{},[30,563,78],{},[18,565,83],{"id":82},[14,567,86,568,92,570,96,572,100,574,104],{},[88,569,91],{"href":90},[30,571,95],{},[30,573,99],{},[30,575,103],{},[18,577,108],{"id":107},[14,579,580,114,582,119,584,123],{},[30,581,113],{},[116,583,118],{},[116,585,122],{},[14,587,126],{},[18,589,130],{"id":129},[14,591,133,592,137],{},[30,593,136],{},[18,595,141],{"id":140},[14,597,144,598,149],{},[88,599,148],{"href":147},{"title":151,"searchDepth":152,"depth":152,"links":601},[602,603,604,605,606,607],{"id":20,"depth":152,"text":21},{"id":46,"depth":152,"text":47},{"id":82,"depth":152,"text":83},{"id":107,"depth":152,"text":108},{"id":129,"depth":152,"text":130},{"id":140,"depth":152,"text":141},{},{"title":5,"description":160},{"id":611,"title":148,"body":612,"description":1016,"extension":161,"meta":1017,"navigation":163,"order":1018,"path":1019,"seo":1020,"stem":1021,"__hash__":1022},"content_es\u002Forganizing-sounds.md",{"type":7,"value":613,"toc":1001},[614,617,624,628,655,662,666,669,683,690,696,700,710,715,747,751,757,761,794,800,804,807,833,836,840,853,857,863,884,900,907,911,922,925,929,936,946,952,956,964,971,998],[10,615,148],{"id":616},"organizar-sonidos",[14,618,619,620,623],{},"SoundNinja está hecho para bibliotecas grandes. ",[30,621,622],{},"Etiquetas y filtros",", pestañas, búsqueda, selección múltiple y atajos — el clip que necesitas está a un clic (o una tecla).",[18,625,627],{"id":626},"pestañas","Pestañas",[66,629,630,637,644],{},[26,631,632,633,636],{},"Añade una pestaña con ",[30,634,635],{},"Añadir pestaña",". Dale un color para escanear la barra rápido.",[26,638,639,640,643],{},"La vista ",[30,641,642],{},"Todos"," muestra cada sonido de todas las pestañas.",[26,645,646,647,650,651,654],{},"Un sonido puede pertenecer a ",[30,648,649],{},"una o más pestañas",". Clic derecho en un sonido y usa ",[30,652,653],{},"Mover a pestaña"," para asignarlo.",[14,656,657,658,661],{},"Las transiciones de pestaña están en ",[30,659,660],{},"Ajustes → General",": Slide, Fade, Botones uno a uno, o Ninguna.",[18,663,665],{"id":664},"grupos","Grupos",[14,667,668],{},"Desde la v0.5.3, los separadores pueden convertirse en grupos con nombre:",[66,670,671,674,677,680],{},[26,672,673],{},"Añadir, renombrar o quitar un grupo desde el menú contextual",[26,675,676],{},"Arrastra la cabecera del grupo — los hijos se mueven con ella",[26,678,679],{},"Suelta sonidos dentro o fuera de un grupo",[26,681,682],{},"Define color de borde, color del nombre y alineación de botones (o usa el valor por defecto de la pestaña)",[14,684,685,686,689],{},"Sigue pudiendo añadir un ",[30,687,688],{},"Separador"," simple si solo necesitas un corte visual.",[14,691,692,693,149],{},"Clic derecho en el espacio vacío del tablero para ",[30,694,695],{},"Añadir grupo",[18,697,699],{"id":698},"etiquetas-filtros","Etiquetas \u002F Filtros",[14,701,702,703,706,707,709],{},"Las etiquetas cruzan las pestañas. El panel ",[30,704,705],{},"Filtro"," (barra lateral ",[30,708,705],{},") es donde las creas y filtras el tablero.",[711,712,714],"h3",{"id":713},"crear-y-editar-etiquetas","Crear y editar etiquetas",[23,716,717,722,733,740],{},[26,718,28,719,721],{},[30,720,705],{}," en la barra lateral.",[26,723,724,725,728,729,732],{},"En ",[30,726,727],{},"Etiquetas",", usa ",[30,730,731],{},"Añadir etiqueta"," — nombre y color.",[26,734,735,736,739],{},"Renombra, recolorea o ",[30,737,738],{},"Eliminar etiqueta"," en la misma lista.",[26,741,742,743,746],{},"Si ves ",[30,744,745],{},"Aún no hay etiquetas",", crea una aquí antes de asignar.",[711,748,750],{"id":749},"asignar-etiquetas-a-sonidos","Asignar etiquetas a sonidos",[14,752,753,754,756],{},"Clic derecho en un sonido → ",[30,755,727],{}," (casillas). Un sonido puede tener varias. Si aún no hay ninguna, el menú te lleva al panel de filtro.",[711,758,760],{"id":759},"filtrar-el-tablero","Filtrar el tablero",[66,762,763,769,780,791],{},[26,764,765,766,149],{},"Activa etiquetas en el panel Filtro o como ",[30,767,768],{},"chips bajo la barra de búsqueda",[26,770,771,772,775,776,779],{},"La coincidencia es ",[30,773,774],{},"OR",": un sonido sigue visible si tiene ",[30,777,778],{},"cualquiera"," de las etiquetas seleccionadas.",[26,781,782,783,786,787,790],{},"El campo ",[30,784,785],{},"Buscar"," combina con ",[30,788,789],{},"AND"," el filtro de etiquetas activo (texto + etiquetas juntos).",[26,792,793],{},"Apaga los chips (o limpia el filtro) para ver de nuevo toda la pestaña.",[14,795,796,797,149],{},"Los nombres de etiqueta en color pueden aparecer en los botones. Actívalos en ",[30,798,799],{},"Ajustes → Comportamiento → Mostrar badges de etiquetas",[18,801,803],{"id":802},"orden","Orden",[14,805,806],{},"Abre el panel de filtro y elige un modo:",[66,808,809,815],{},[26,810,811,814],{},[30,812,813],{},"Definido por el usuario"," — tu orden de pestaña, grupos visibles",[26,816,817,401,820,401,823,100,826,829,830],{},[30,818,819],{},"Nombre",[30,821,822],{},"Fecha de añadido",[30,824,825],{},"Tiempo de reproducción",[30,827,828],{},"Tamaño de archivo"," — lista plana ordenada; ",[30,831,832],{},"los grupos se ocultan",[14,834,835],{},"Ordenar por duración puede precargar los metadatos de duración la primera vez.",[18,837,839],{"id":838},"reordenar","Reordenar",[14,841,842,843,846,847,850,851,149],{},"Activa arrastrar y soltar en ",[30,844,845],{},"Ajustes → Comportamiento"," (",[30,848,849],{},"Permitir reordenar","). Luego arrastra sonidos y grupos a su sitio. Reordenar aplica en el orden ",[30,852,813],{},[18,854,856],{"id":855},"selección-múltiple","Selección múltiple",[14,858,859,860,862],{},"Activa ",[30,861,856],{}," en la barra de navegación, luego:",[66,864,865,868,874,881],{},[26,866,867],{},"Clic para alternar un sonido",[26,869,870,873],{},[30,871,872],{},"Mayús+clic"," para un rango desde el último ancla",[26,875,876,877,880],{},"Arrastra un ",[30,878,879],{},"marco"," en el espacio vacío del tablero",[26,882,883],{},"Clic en el tablero vacío (o fuera) para limpiar la selección",[14,885,886,887,401,890,401,893,896,897,149],{},"Una barra masiva muestra el recuento, más ",[30,888,889],{},"Color",[30,891,892],{},"Mover a pestaña…",[30,894,895],{},"Eliminar"," y ",[30,898,899],{},"Hecho",[14,901,902,903,906],{},"En selección múltiple, cada botón muestra un ",[30,904,905],{},"chip de ID de 8 caracteres",". Clic derecho en el chip para copiarlo.",[18,908,910],{"id":909},"volumen-por-sonido","Volumen por sonido",[14,912,913,914,917,918,921],{},"Clic derecho → ",[30,915,916],{},"Volumen",". Arrastra el control de 0 % a 100 %. ",[30,919,920],{},"Doble clic"," lo restablece a 100 %.",[14,923,924],{},"Se acumula con el volumen de salida maestro en Ajustes.",[18,926,928],{"id":927},"atajos-e-ids-de-sonido","Atajos e IDs de sonido",[14,930,931,932,935],{},"Cada sonido tiene un ID de 8 caracteres. Cópialo desde el menú contextual del botón (",[30,933,934],{},"Copiar ID",") o el chip de ID de la selección múltiple.",[14,937,28,938,941,942,945],{},[30,939,940],{},"Ajustes → Atajos"," para vincular una tecla a un ID de sonido. Los atajos globales son opcionales. ",[30,943,944],{},"Asignar atajo"," en el menú contextual salta allí con el ID rellenado.",[14,947,948,949,951],{},"El mismo ID es el que ",[88,950,241],{"href":240}," usa para disparar un clip.",[18,953,955],{"id":954},"imágenes-de-fondo-y-colores","Imágenes de fondo y colores",[14,957,958,959,963],{},"Clic derecho en un sonido para definir colores por botón o una imagen de fondo. Eso es independiente del ",[88,960,962],{"href":961},"\u002Fdocs\u002Ftheme-editor","Theme Creator",", que da estilo a todo el tablero.",[14,965,966,967,970],{},"El selector es un diálogo ",[30,968,969],{},"Imagen de fondo"," (PNG, JPEG, GIF, WebP):",[66,972,973,979,989],{},[26,974,975,978],{},[30,976,977],{},"Archivos locales"," — añade carpetas, elige un archivo, busca por nombre, previsualiza la cuadrícula o quita una carpeta de la biblioteca",[26,980,981,984,985,149],{},[30,982,983],{},"GifSnap"," — busca GIFs en línea sin clave API. La primera visita pide aceptar las peticiones a GifSnap; los resultados se cachean para reducir tráfico. Ver ",[88,986,983],{"href":987,"rel":988},"https:\u002F\u002Fgifsnap.com",[259],[26,990,991,994,995,997],{},[30,992,993],{},"KLIPY"," — busca GIFs en línea. Pon tu propia clave API en ",[30,996,845],{},". La clave no se guarda en los archivos del proyecto.",[14,999,1000],{},"Tras elegir, mueve y recorta la imagen en el botón.",{"title":151,"searchDepth":152,"depth":152,"links":1002},[1003,1004,1005,1010,1011,1012,1013,1014,1015],{"id":626,"depth":152,"text":627},{"id":664,"depth":152,"text":665},{"id":698,"depth":152,"text":699,"children":1006},[1007,1008,1009],{"id":713,"depth":164,"text":714},{"id":749,"depth":164,"text":750},{"id":759,"depth":164,"text":760},{"id":802,"depth":152,"text":803},{"id":838,"depth":152,"text":839},{"id":855,"depth":152,"text":856},{"id":909,"depth":152,"text":910},{"id":927,"depth":152,"text":928},{"id":954,"depth":152,"text":955},"Etiquetas, filtros, pestañas, grupos, orden, selección múltiple, volumen y atajos.",{},4,"\u002Forganizing-sounds",{"title":148,"description":1016},"organizing-sounds","v2Vh-pefsaiWoUdwQrv4wMerfeXZbtLIa6iq8beVync",{"id":1024,"title":1025,"body":1026,"description":1151,"extension":161,"meta":1152,"navigation":163,"order":1153,"path":1154,"seo":1155,"stem":1156,"__hash__":1157},"content_es\u002Ftheme-editor.md","Editor de temas",{"type":7,"value":1027,"toc":1145},[1028,1031,1037,1041,1068,1071,1075,1089,1093,1119,1122,1126,1131],[10,1029,1025],{"id":1030},"editor-de-temas",[14,1032,1033,1034,149],{},"El Theme Creator es el editor visual completo de tu tablero. Ábrelo desde ",[30,1035,1036],{},"Ajustes → General → Theme Creator",[18,1038,1040],{"id":1039},"tres-pestañas","Tres pestañas",[23,1042,1043,1057,1063],{},[26,1044,1045,1048,1049,1052,1053,1056],{},[30,1046,1047],{},"General"," — nombre del tema, colores compartidos y carga de fuentes (",[116,1050,1051],{},".ttf"," \u002F ",[116,1054,1055],{},".otf",")",[26,1058,1059,1062],{},[30,1060,1061],{},"Botones"," — colores, tipo, diseño y overlay GIF de los botones de sonido",[26,1064,1065,1067],{},[30,1066,627],{}," — colores, tipo y grosor de borde de la barra de pestañas",[14,1069,1070],{},"Una vista previa en vivo muestra pestañas y botones mientras editas.",[18,1072,1074],{"id":1073},"qué-puedes-cambiar","Qué puedes cambiar",[66,1076,1077,1080,1083,1086],{},[26,1078,1079],{},"Colores primario y de acento, fondos, colores de botones, colores de pestañas",[26,1081,1082],{},"Familia y tamaño de fuente de botones y pestañas",[26,1084,1085],{},"Ancho, radio, borde, huecos y padding de los botones",[26,1087,1088],{},"Opacidad del overlay GIF (normal y hover)",[18,1090,1092],{"id":1091},"guardar-y-compartir","Guardar y compartir",[66,1094,1095,1101,1107,1113],{},[26,1096,1097,1100],{},[30,1098,1099],{},"Exportar .css"," — escribe un archivo de tema para respaldar o enviar a un amigo",[26,1102,1103,1106],{},[30,1104,1105],{},"Añadir a temas"," — guarda el archivo en tu carpeta Themes y aplícalo",[26,1108,1109,1112],{},[30,1110,1111],{},"Importar .css"," — carga un preset integrado o un tema guardado",[26,1114,1115,1118],{},[30,1116,1117],{},"Restablecer"," — vuelve a los valores por defecto de SoundNinja",[14,1120,1121],{},"Si cierras la ventana con cambios sin guardar, SoundNinja te pide que guardes primero.",[18,1123,1125],{"id":1124},"sin-el-editor-completo","Sin el editor completo",[14,1127,724,1128,1130],{},[30,1129,660],{}," aún puedes:",[66,1132,1133,1136,1142],{},[26,1134,1135],{},"Elegir un tema de la lista",[26,1137,1138,1139,1056],{},"Editar variables CSS en vivo (",[30,1140,1141],{},"CSS personalizado",[26,1143,1144],{},"Importar un archivo de tema a la carpeta Themes",{"title":151,"searchDepth":152,"depth":152,"links":1146},[1147,1148,1149,1150],{"id":1039,"depth":152,"text":1040},{"id":1073,"depth":152,"text":1074},{"id":1091,"depth":152,"text":1092},{"id":1124,"depth":152,"text":1125},"Diseña colores, fuentes, botones y pestañas en el Theme Creator.",{},5,"\u002Ftheme-editor",{"title":1025,"description":1151},"theme-editor","bPcJP7OLtBsnNMYJ-S1J6DmB6nngULo1_Q1hBJMNZAQ",{"id":1159,"title":1160,"body":1161,"description":1297,"extension":161,"meta":1298,"navigation":163,"order":1299,"path":1300,"seo":1301,"stem":1302,"__hash__":1303},"content_es\u002Frecording-editor.md","Editor de grabación",{"type":7,"value":1162,"toc":1291},[1163,1166,1172,1176,1182,1202,1205,1209,1234,1238,1252,1256,1270,1281],[10,1164,1160],{"id":1165},"editor-de-grabación",[14,1167,1168,1169,1171],{},"Graba un clip dentro de SoundNinja, recórtalo e impórtalo a una pestaña. Abre el editor con el botón ",[30,1170,95],{}," en la barra del reproductor.",[18,1173,1175],{"id":1174},"elegir-una-entrada","Elegir una entrada",[14,1177,724,1178,1181],{},[30,1179,1180],{},"Ajustes → Audio",":",[66,1183,1184,1190,1196],{},[26,1185,1186,1189],{},[30,1187,1188],{},"Dispositivos de entrada"," — micrófono",[26,1191,1192,1195],{},[30,1193,1194],{},"Dispositivos de salida (audio del PC)"," — loopback de lo que reproduce el PC",[26,1197,1198,1201],{},[30,1199,1200],{},"Volumen de entrada"," — ganancia de captura del 0 % al 200 %",[14,1203,1204],{},"El botón Grabar usa el dispositivo que eliges aquí.",[18,1206,1208],{"id":1207},"editar-la-toma","Editar la toma",[66,1210,1211,1214,1217,1225,1228,1231],{},[26,1212,1213],{},"Grabar y detener",[26,1215,1216],{},"Observar el medidor de nivel de entrada",[26,1218,1219,100,1222],{},[30,1220,1221],{},"Normalizar",[30,1223,1224],{},"Cancelación de ruido",[26,1226,1227],{},"Recortar todo el clip, recortar a una selección o borrar una selección",[26,1229,1230],{},"Deshacer \u002F rehacer",[26,1232,1233],{},"Acercar y alejar",[18,1235,1237],{"id":1236},"preparar-e-importar","Preparar e importar",[23,1239,1240,1243,1246],{},[26,1241,1242],{},"Añade la selección o la pista completa a la lista de staging.",[26,1244,1245],{},"La lista empieza vacía: graba, edita y luego añade un clip.",[26,1247,1248,100,1250,104],{},[30,1249,99],{},[30,1251,103],{},[18,1253,1255],{"id":1254},"separación-de-stems-opcional","Separación de stems (opcional)",[14,1257,1258,1259,1262,1263,100,1266,1269],{},"Las builds oficiales de Windows, macOS y Linux incluyen la función ",[30,1260,1261],{},"stems",". El Record Editor puede conservar ",[30,1264,1265],{},"voces",[30,1267,1268],{},"música"," con BS-RoFormer.",[14,1271,1272,1273,1276,1277,1280],{},"El modelo pesa unos 158 MB y ",[30,1274,1275],{},"no"," viene en el instalador. Descárgalo desde ",[30,1278,1279],{},"Ajustes → Separación de stems",", o acepta el aviso del primer arranque. El instalador de Windows también puede ofrecer descargar el modelo al primer inicio.",[14,1282,1283,1284,1052,1287,1290],{},"Las builds personalizadas desde código necesitan un flag extra (",[116,1285,1286],{},"tauri:serve:stems",[116,1288,1289],{},"tauri:build:stems",").",{"title":151,"searchDepth":152,"depth":152,"links":1292},[1293,1294,1295,1296],{"id":1174,"depth":152,"text":1175},{"id":1207,"depth":152,"text":1208},{"id":1236,"depth":152,"text":1237},{"id":1254,"depth":152,"text":1255},"Captura micrófono o audio del PC, edita el clip y suéltalo en tu tablero.",{},6,"\u002Frecording-editor",{"title":1160,"description":1297},"recording-editor","89aDSCp7hE8To2TNFwdWaImQVsHH2-xNcOyltCPP5IY",{"id":1305,"title":1306,"body":1307,"description":1519,"extension":161,"meta":1520,"navigation":163,"order":1521,"path":1522,"seo":1523,"stem":1524,"__hash__":1525},"content_es\u002Fremote-control.md","Control remoto",{"type":7,"value":1308,"toc":1512},[1309,1312,1315,1319,1348,1351,1354,1389,1393,1413,1416,1420,1452,1456,1462],[10,1310,1306],{"id":1311},"control-remoto",[14,1313,1314],{},"SoundNinja puede escuchar en tu red local para que Bitfocus Companion (o cualquier cliente HTTP\u002FWebSocket) reproduzca y detenga sonidos.",[18,1316,1318],{"id":1317},"activar-el-servidor-remoto","Activar el servidor remoto",[23,1320,1321,1326,1332,1338],{},[26,1322,28,1323,149],{},[30,1324,1325],{},"Ajustes → Remoto",[26,1327,1328,1329,149],{},"Activa el servidor remoto. El puerto por defecto es ",[30,1330,1331],{},"7331",[26,1333,1334,1335,149],{},"Opcional: define un token. Los clientes deben enviarlo como Bearer token o ",[116,1336,1337],{},"?token=",[26,1339,1340,1341,1344,1345,149],{},"Copia la URL ",[116,1342,1343],{},"http:\u002F\u002FIP:PORT",", o copia la IP del sistema desde ",[30,1346,1347],{},"Ajustes → Acerca de",[14,1349,1350],{},"Windows puede mostrar un aviso del firewall la primera vez que arranca el servidor. Permite el acceso a la red privada.",[18,1352,241],{"id":1353},"bitfocus-companion",[23,1355,1356,1363,1372,1382],{},[26,1357,1358,1359,149],{},"Instala ",[88,1360,241],{"href":1361,"rel":1362},"https:\u002F\u002Fbitfocus.io\u002Fcompanion",[259],[26,1364,1365,1366,137