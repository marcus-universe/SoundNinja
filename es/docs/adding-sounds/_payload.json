[{"data":1,"prerenderedAt":1334},["ShallowReactive",2],{"docs-page-es-\u002Fadding-sounds":3,"docs-nav-es":169},{"id":4,"title":5,"body":6,"description":160,"extension":161,"meta":162,"navigation":163,"order":164,"path":165,"seo":166,"stem":167,"__hash__":168},"content_es\u002Fadding-sounds.md","Añadir sonidos",{"type":7,"value":8,"toc":150},"minimark",[9,13,17,22,44,48,80,84,105,109,124,127,131,138,142],[10,11,5],"h1",{"id":12},"añadir-sonidos",[14,15,16],"p",{},"Un tablero está vacío hasta que añades clips. SoundNinja puede importar archivos, carpetas enteras, una grabación o un pack de soundboard compartido.",[18,19,21],"h2",{"id":20},"importar-archivos-de-audio","Importar archivos de audio",[23,24,25,38,41],"ol",{},[26,27,28,29,33,34,37],"li",{},"Abre ",[30,31,32],"strong",{},"Archivo → Importar archivos de audio",", o usa ",[30,35,36],{},"Importar"," en la barra de navegación.",[26,39,40],{},"Elige uno o más archivos de audio.",[26,42,43],{},"Los sonidos llegan a la pestaña actual.",[18,45,47],{"id":46},"importar-carpetas","Importar carpetas",[23,49,50,59,62],{},[26,51,28,52,55,56,58],{},[30,53,54],{},"Archivo → Importar carpetas"," (o ",[30,57,47],{}," en la barra de navegación).",[26,60,61],{},"Añade una o más carpetas. Arrastra para reordenarlas antes de importar.",[26,63,64,65],{},"Elige cómo llegan:\n",[66,67,68,74],"ul",{},[26,69,70,73],{},[30,71,72],{},"Importar como pestañas"," — cada carpeta se convierte en su propia pestaña",[26,75,76,79],{},[30,77,78],{},"Importar a la pestaña actual"," — cada archivo va a la pestaña activa",[18,81,83],{"id":82},"grabar-un-clip","Grabar un clip",[14,85,86,87,92,93,96,97,100,101,104],{},"Abre el ",[88,89,91],"a",{"href":90},"\u002Fdocs\u002Frecording-editor","Record Editor"," desde el botón ",[30,94,95],{},"Grabar"," en la barra del reproductor. Captura, recorta y luego ",[30,98,99],{},"Importar selección"," o ",[30,102,103],{},"Importar todo"," en la pestaña actual o en una pestaña que elijas.",[18,106,108],{"id":107},"importar-un-soundboard","Importar un soundboard",[14,110,111,114,115,119,120,123],{},[30,112,113],{},"Archivo → Importar soundboard"," carga un pack compartido. Los packs son un ",[116,117,118],"code",{},".zip"," que contiene ",[116,121,122],{},"project.sninja"," más los archivos de sonido. Tras importar, abre el proyecto y reproduce.",[14,125,126],{},"También puedes tener varios proyectos (perfiles). Usa el selector de proyecto para cambiar de tablero.",[18,128,130],{"id":129},"reenlazar-archivos-faltantes","Reenlazar archivos faltantes",[14,132,133,134,137],{},"Si los archivos de audio se mueven en el disco, SoundNinja muestra ",[30,135,136],{},"Archivos de sonido faltantes",". Elige una carpeta para buscar y reenlazar los clips.",[18,139,141],{"id":140},"siguiente","Siguiente",[14,143,144,145,149],{},"Organiza pestañas, grupos y atajos en ",[88,146,148],{"href":147},"\u002Fdocs\u002Forganizing-sounds","Organizar sonidos",".",{"title":151,"searchDepth":152,"depth":152,"links":153},"",2,[154,155,156,157,158,159],{"id":20,"depth":152,"text":21},{"id":46,"depth":152,"text":47},{"id":82,"depth":152,"text":83},{"id":107,"depth":152,"text":108},{"id":129,"depth":152,"text":130},{"id":140,"depth":152,"text":141},"Importa audio, carpetas, grabaciones y soundboards compartidos.","md",{},true,3,"\u002Fadding-sounds",{"title":5,"description":160},"adding-sounds","Pp2z7pkBymoeTp058Pu8gOujI6GqQLoQ-Go0ZA2L1F4",[170,288,486,577,733,869,1011,1236],{"id":171,"title":172,"body":173,"description":281,"extension":161,"meta":282,"navigation":163,"order":283,"path":284,"seo":285,"stem":286,"__hash__":287},"content_es\u002Foverview.md","Resumen",{"type":7,"value":174,"toc":275},[175,178,181,184,187,191,205,209,239,243,253,257],[10,176,172],{"id":177},"resumen",[14,179,180],{},"SoundNinja es un soundboard de código abierto para streaming en directo, charlas con amigos y grabación de podcasts. Está construido con Tauri v2 y Nuxt 4 para que sea ligero en RAM y disco.",[14,182,183],{},"El objetivo es simple: mantener una biblioteca enorme fácil de recorrer y reproducir el clip correcto en milisegundos. La interfaz también funciona bien como panel en VR.",[14,185,186],{},"SoundNinja sigue en desarrollo temprano. Las funciones marchan, pero no todas las plataformas están del todo probadas.",[18,188,190],{"id":189},"para-quién","Para quién",[66,192,193,196,199,202],{},[26,194,195],{},"Streamers que necesitan cues de sonido al instante",[26,197,198],{},"Amigos que quieren un tablero compartido para el chat de voz",[26,200,201],{},"Podcasters que graban clips y los sueltan en un tablero",[26,203,204],{},"Quien quiera un soundboard personalizable y local-first",[18,206,208],{"id":207},"qué-puedes-hacer","Qué puedes hacer",[66,210,211,214,217,220,223,226,233,236],{},[26,212,213],{},"Montar un soundboard con tus propios archivos de audio",[26,215,216],{},"Organizar sonidos en pestañas de colores, grupos y búsqueda",[26,218,219],{},"Diseñar el aspecto con el Theme Creator",[26,221,222],{},"Grabar audio del PC o un micrófono en el Record Editor",[26,224,225],{},"Asignar atajos a sonidos individuales",[26,227,228,229],{},"Disparar sonidos desde ",[88,230,232],{"href":231},"\u002Fdocs\u002Fremote-control","Bitfocus Companion",[26,234,235],{},"Importar y exportar un soundboard completo para compartirlo",[26,237,238],{},"Usar GIFs o imágenes en los botones de sonido",[18,240,242],{"id":241},"licencia","Licencia",[14,244,245,246,252],{},"SoundNinja es software libre bajo ",[88,247,251],{"href":248,"rel":249},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fblob\u002Fmain\u002FLICENSE",[250],"nofollow","GPL-3.0",". Haz fork, cámbialo, compártelo.",[18,254,256],{"id":255},"siguientes-pasos","Siguientes pasos",[23,258,259,265,270],{},[26,260,261],{},[88,262,264],{"href":263},"\u002Fdocs\u002Finstallation","Instalar SoundNinja",[26,266,267],{},[88,268,5],{"href":269},"\u002Fdocs\u002Fadding-sounds",[26,271,272],{},[88,273,274],{"href":147},"Organizar tu tablero",{"title":151,"searchDepth":152,"depth":152,"links":276},[277,278,279,280],{"id":189,"depth":152,"text":190},{"id":207,"depth":152,"text":208},{"id":241,"depth":152,"text":242},{"id":255,"depth":152,"text":256},"Qué es SoundNinja y qué puedes hacer con él.",{},1,"\u002Foverview",{"title":172,"description":281},"overview","_jbFAqK9Ea28XfzNs3a2S9mJrWOMez_Uxtm9qlYTevc",{"id":289,"title":290,"body":291,"description":480,"extension":161,"meta":481,"navigation":163,"order":152,"path":482,"seo":483,"stem":484,"__hash__":485},"content_es\u002Finstallation.md","Instalación",{"type":7,"value":292,"toc":473},[293,296,310,314,331,334,338,352,355,359,383,394,398,405,409,424,454,469],[10,294,290],{"id":295},"instalación",[14,297,298,299,303,304,309],{},"Consigue una build en la ",[88,300,302],{"href":301},"\u002Fdownload","página de descarga"," o en ",[88,305,308],{"href":306,"rel":307},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Freleases\u002Flatest",[250],"GitHub Releases",". SoundNinja está en desarrollo temprano, así que trata las builds como beta.",[18,311,313],{"id":312},"windows","Windows",[66,315,316,325,328],{},[26,317,318,100,321,324],{},[30,319,320],{},"Instalador (.exe)",[30,322,323],{},"MSI (.msi)"," para Windows de 64 bits",[26,326,327],{},"Objetivo de la landing: Windows 10 y posterior",[26,329,330],{},"El README de la app también lista Windows 8 y superior",[14,332,333],{},"Ejecuta el instalador y luego abre SoundNinja desde el menú Inicio.",[18,335,337],{"id":336},"macos","macOS",[66,339,340,346,349],{},[26,341,342,345],{},[30,343,344],{},".dmg universal"," para Apple Silicon e Intel",[26,347,348],{},"Objetivo de la landing: macOS 10.14 y posterior",[26,350,351],{},"El README de la app lista macOS 10.15 y superior",[14,353,354],{},"Abre la imagen de disco y arrastra SoundNinja a Aplicaciones.",[18,356,358],{"id":357},"linux","Linux",[66,360,361,367,373,380],{},[26,362,363,366],{},[30,364,365],{},"Debian (.deb)"," para Ubuntu \u002F Debian",[26,368,369,372],{},[30,370,371],{},"AppImage"," para otras distros",[26,374,375,376,379],{},"Tras publicar una release, los usuarios de Arch pueden instalar ",[116,377,378],{},"soundninja-bin"," desde el AUR",[26,381,382],{},"Probado en Ubuntu 20.04",[14,384,385,386,389,390,393],{},"Las builds de escritorio necesitan paquetes WebKit y GTK. En Debian\u002FUbuntu eso suele ser ",[116,387,388],{},"libwebkit2gtk",", ",[116,391,392],{},"libgtk-3-0"," y una biblioteca app-indicator.",[18,395,397],{"id":396},"actualizaciones","Actualizaciones",[14,399,400,401,404],{},"En la app, abre ",[30,402,403],{},"Ayuda → Buscar actualizaciones",". También puedes dejar que SoundNinja compruebe al arrancar en Ajustes.",[18,406,408],{"id":407},"compilar-desde-el-código","Compilar desde el código",[14,410,411,412,417,418,423],{},"¿Necesitas una build personalizada? Clona ",[88,413,416],{"href":414,"rel":415},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja",[250],"el repo",", instala los ",[88,419,422],{"href":420,"rel":421},"https:\u002F\u002Fv2.tauri.app\u002Fstart\u002Fprerequisites\u002F",[250],"requisitos de Tauri"," y luego:",[425,426,430],"pre",{"className":427,"code":428,"language":429,"meta":151,"style":151},"language-bash shiki shiki-themes github-light github-dark","bun install\nbun run tauri:serve\n","bash",[116,431,432,444],{"__ignoreMap":151},[433,434,436,440],"span",{"class":435,"line":283},"line",[433,437,439],{"class":438},"sScJk","bun",[433,441,443],{"class":442},"sZZnC"," install\n",[433,445,446,448,451],{"class":435,"line":152},[433,447,439],{"class":438},[433,449,450],{"class":442}," run",[433,452,453],{"class":442}," tauri:serve\n",[14,455,456,389,459,100,462,465,466,149],{},[116,457,458],{},"npm",[116,460,461],{},"pnpm",[116,463,464],{},"deno"," también sirven. Build de producción: ",[116,467,468],{},"bun run tauri:build",[470,471,472],"style",{},"html pre.shiki code .sScJk, html code.shiki .sScJk{--shiki-default:#6F42C1;--