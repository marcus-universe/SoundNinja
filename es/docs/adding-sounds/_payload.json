[{"data":1,"prerenderedAt":1593},["ShallowReactive",2],{"docs-page-es-\u002Fadding-sounds":3,"docs-nav-es":169},{"id":4,"title":5,"body":6,"description":160,"extension":161,"meta":162,"navigation":163,"order":164,"path":165,"seo":166,"stem":167,"__hash__":168},"content_es\u002Fadding-sounds.md","Añadir sonidos",{"type":7,"value":8,"toc":150},"minimark",[9,13,17,22,44,48,80,84,105,109,124,127,131,138,142],[10,11,5],"h1",{"id":12},"añadir-sonidos",[14,15,16],"p",{},"Un tablero está vacío hasta que añades clips. SoundNinja puede importar archivos, carpetas enteras, una grabación o un pack de soundboard compartido.",[18,19,21],"h2",{"id":20},"importar-archivos-de-audio","Importar archivos de audio",[23,24,25,38,41],"ol",{},[26,27,28,29,33,34,37],"li",{},"Abre ",[30,31,32],"strong",{},"Archivo → Importar archivos de audio",", o usa ",[30,35,36],{},"Importar"," en la barra de navegación.",[26,39,40],{},"Elige uno o más archivos de audio.",[26,42,43],{},"Los sonidos llegan a la pestaña actual.",[18,45,47],{"id":46},"importar-carpetas","Importar carpetas",[23,49,50,59,62],{},[26,51,28,52,55,56,58],{},[30,53,54],{},"Archivo → Importar carpetas"," (o ",[30,57,47],{}," en la barra de navegación).",[26,60,61],{},"Añade una o más carpetas. Arrastra para reordenarlas antes de importar.",[26,63,64,65],{},"Elige cómo llegan:\n",[66,67,68,74],"ul",{},[26,69,70,73],{},[30,71,72],{},"Importar como pestañas"," — cada carpeta se convierte en su propia pestaña",[26,75,76,79],{},[30,77,78],{},"Importar a la pestaña actual"," — cada archivo va a la pestaña activa",[18,81,83],{"id":82},"grabar-un-clip","Grabar un clip",[14,85,86,87,92,93,96,97,100,101,104],{},"Abre el ",[88,89,91],"a",{"href":90},"\u002Fdocs\u002Frecording-editor","Record Editor"," desde el botón ",[30,94,95],{},"Grabar"," en la barra del reproductor. Captura, recorta y luego ",[30,98,99],{},"Importar selección"," o ",[30,102,103],{},"Importar todo"," en la pestaña actual o en una pestaña que elijas.",[18,106,108],{"id":107},"importar-un-soundboard","Importar un soundboard",[14,110,111,114,115,119,120,123],{},[30,112,113],{},"Archivo → Importar soundboard"," carga un pack compartido. Los packs son un ",[116,117,118],"code",{},".zip"," que contiene ",[116,121,122],{},"project.sninja"," más los archivos de sonido. Tras importar, abre el proyecto y reproduce.",[14,125,126],{},"También puedes tener varios proyectos (perfiles). Usa el selector de proyecto para cambiar de tablero.",[18,128,130],{"id":129},"reenlazar-archivos-faltantes","Reenlazar archivos faltantes",[14,132,133,134,137],{},"Si los archivos de audio se mueven en el disco, SoundNinja muestra ",[30,135,136],{},"Archivos de sonido faltantes",". Elige una carpeta para buscar y reenlazar los clips.",[18,139,141],{"id":140},"siguiente","Siguiente",[14,143,144,145,149],{},"Organiza pestañas, etiquetas, filtros y atajos en ",[88,146,148],{"href":147},"\u002Fdocs\u002Forganizing-sounds","Organizar sonidos",".",{"title":151,"searchDepth":152,"depth":152,"links":153},"",2,[154,155,156,157,158,159],{"id":20,"depth":152,"text":21},{"id":46,"depth":152,"text":47},{"id":82,"depth":152,"text":83},{"id":107,"depth":152,"text":108},{"id":129,"depth":152,"text":130},{"id":140,"depth":152,"text":141},"Importa audio, carpetas, grabaciones y soundboards compartidos.","md",{},true,3,"\u002Fadding-sounds",{"title":5,"description":160},"adding-sounds","O5nOJGNq2FL6jafUxqoGYNKJDVbb2UrZRjfKpK21LlQ",[170,297,498,589,992,1127,1273,1495],{"id":171,"title":172,"body":173,"description":290,"extension":161,"meta":291,"navigation":163,"order":292,"path":293,"seo":294,"stem":295,"__hash__":296},"content_es\u002Foverview.md","Resumen",{"type":7,"value":174,"toc":284},[175,178,181,184,187,191,205,209,248,252,262,266],[10,176,172],{"id":177},"resumen",[14,179,180],{},"SoundNinja es un soundboard de código abierto para streaming en directo, charlas con amigos y grabación de podcasts. Está construido con Tauri v2 y Nuxt 4 para que sea ligero en RAM y disco.",[14,182,183],{},"El objetivo es simple: mantener una biblioteca enorme fácil de recorrer y reproducir el clip correcto en milisegundos. La interfaz también funciona bien como panel en VR.",[14,185,186],{},"SoundNinja sigue en desarrollo temprano. Las funciones marchan, pero no todas las plataformas están del todo probadas.",[18,188,190],{"id":189},"para-quién","Para quién",[66,192,193,196,199,202],{},[26,194,195],{},"Streamers que necesitan cues de sonido al instante",[26,197,198],{},"Amigos que quieren un tablero compartido para el chat de voz",[26,200,201],{},"Podcasters que graban clips y los sueltan en un tablero",[26,203,204],{},"Quien quiera un soundboard personalizable y local-first",[18,206,208],{"id":207},"qué-puedes-hacer","Qué puedes hacer",[66,210,211,214,217,220,223,226,229,232,235,242,245],{},[26,212,213],{},"Montar un soundboard con tus propios archivos de audio",[26,215,216],{},"Organizar sonidos en pestañas de colores, grupos, etiquetas y búsqueda",[26,218,219],{},"Filtrar por etiquetas (OR) y ordenar por nombre, fecha, duración o tamaño",[26,221,222],{},"Selección múltiple con marco o rango Mayús, luego color, mover o borrar en lote",[26,224,225],{},"Ajustar el volumen por sonido desde el menú contextual",[26,227,228],{},"Diseñar el aspecto con el Theme Creator",[26,230,231],{},"Grabar audio del PC o un micrófono en el Record Editor",[26,233,234],{},"Asignar atajos a sonidos individuales",[26,236,237,238],{},"Disparar sonidos desde ",[88,239,241],{"href":240},"\u002Fdocs\u002Fremote-control","Bitfocus Companion",[26,243,244],{},"Importar y exportar un soundboard completo para compartirlo",[26,246,247],{},"Usar GIFs o imágenes en los botones — biblioteca local de carpetas o KLIPY",[18,249,251],{"id":250},"licencia","Licencia",[14,253,254,255,261],{},"SoundNinja es software libre bajo ",[88,256,260],{"href":257,"rel":258},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fblob\u002Fmain\u002FLICENSE",[259],"nofollow","GPL-3.0",". Haz fork, cámbialo, compártelo.",[18,263,265],{"id":264},"siguientes-pasos","Siguientes pasos",[23,267,268,274,279],{},[26,269,270],{},[88,271,273],{"href":272},"\u002Fdocs\u002Finstallation","Instalar SoundNinja",[26,275,276],{},[88,277,5],{"href":278},"\u002Fdocs\u002Fadding-sounds",[26,280,281],{},[88,282,283],{"href":147},"Organizar tu tablero",{"title":151,"searchDepth":152,"depth":152,"links":285},[286,287,288,289],{"id":189,"depth":152,"text":190},{"id":207,"depth":152,"text":208},{"id":250,"depth":152,"text":251},{"id":264,"depth":152,"text":265},"Qué es SoundNinja y qué puedes hacer con él.",{},1,"\u002Foverview",{"title":172,"description":290},"overview","XWpBFvtyid6BLXO3HByHppTxfsOo0i7DlSOMew5tq2g",{"id":298,"title":299,"body":300,"description":492,"extension":161,"meta":493,"navigation":163,"order":152,"path":494,"seo":495,"stem":496,"__hash__":497},"content_es\u002Finstallation.md","Instalación",{"type":7,"value":301,"toc":485},[302,305,319,323,343,346,350,364,367,371,395,406,410,417,421,436,466,481],[10,303,299],{"id":304},"instalación",[14,306,307,308,312,313,318],{},"Consigue una build en la ",[88,309,311],{"href":310},"\u002Fdownload","página de descarga"," o en ",[88,314,317],{"href":315,"rel":316},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Freleases\u002Flatest",[259],"GitHub Releases",". SoundNinja está en desarrollo temprano, así que trata las builds como beta.",[18,320,322],{"id":321},"windows","Windows",[66,324,325,334,337,340],{},[26,326,327,100,330,333],{},[30,328,329],{},"Instalador (.exe)",[30,331,332],{},"MSI (.msi)"," para Windows de 64 bits",[26,335,336],{},"Objetivo de la landing: Windows 10 y posterior",[26,338,339],{},"El README de la app también lista Windows 8 y superior",[26,341,342],{},"El instalador NSIS usa tema oscuro. Elige idioma en el setup — SoundNinja lo recuerda en el siguiente arranque.",[14,344,345],{},"Ejecuta el instalador y luego abre SoundNinja desde el menú Inicio.",[18,347,349],{"id":348},"macos","macOS",[66,351,352,358,361],{},[26,353,354,357],{},[30,355,356],{},".dmg universal"," para Apple Silicon e Intel",[26,359,360],{},"Objetivo de la landing: macOS 10.14 y posterior",[26,362,363],{},"El README de la app lista macOS 10.15 y superior",[14,365,366],{},"Abre la imagen de disco y arrastra SoundNinja a Aplicaciones.",[18,368,370],{"id":369},"linux","Linux",[66,372,373,379,385,392],{},[26,374,375,378],{},[30,376,377],{},"Debian (.deb)"," para Ubuntu \u002F Debian",[26,380,381,384],{},[30,382,383],{},"AppImage"," para otras distros",[26,386,387,388,391],{},"Tras publicar una release, los usuarios de Arch pueden instalar ",[116,389,390],{},"soundninja-bin"," desde el AUR",[26,393,394],{},"Probado en Ubuntu 20.04",[14,396,397,398,401,402,405],{},"Las builds de escritorio necesitan paquetes WebKit y GTK. En Debian\u002FUbuntu eso suele ser ",[116,399,400],{},"libwebkit2gtk",", ",[116,403,404],{},"libgtk-3-0"," y una biblioteca app-indicator.",[18,407,409],{"id":408},"actualizaciones","Actualizaciones",[14,411,412,413,416],{},"En la app, abre ",[30,414,415],{},"Ayuda → Buscar actualizaciones",". También puedes dejar que SoundNinja compruebe al arrancar en Ajustes.",[18,418,420],{"id":419},"compilar-desde-el-código","Compilar desde el código",[14,422,423,424,429,430,435],{},"¿Necesitas una build personalizada? Clona ",[88,425,428],{"href":426,"rel":427},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja",[259],"el repo",", instala los ",[88,431,434],{"href":432,"rel":433},"https:\u002F\u002Fv2.tauri.app\u002Fstart\u002Fprerequisites\u002F",[259],"requisitos de Tauri"," y luego:",[437,438,442],"pre",{"className":439,"code":440,"language":441,"meta":151,"style":151},"language-bash shiki shiki-themes github-light github-dark","bun install\nbun run tauri:serve\n","bash",[116,443,444,456],{"__ignoreMap":151},[445,446,448,452],"span",{"class":447,"line":292},"line",[445,449,451],{"class":450},"sScJk","bun",[445,453,455],{"class":454},"sZZnC"," install\n",[445,457,458,460,463],{"class":447,"line":152},[445,459,451],{"class":450},[445,461,462],{"class":454}," run",[445,464,465],{"class":454}," tauri:serve\n",[14,467,468,401,471,100,474,477,478,149],{},[116,469,470],{},"npm",[116,472,473],{},"pnpm",[116,475,476],{},"deno"," también sirven. Build de producción: ",[116,479,480],{},"bun run tauri:build",[482,483,484],"style",{},"html pre.shiki code .sScJk, html code.shiki .sScJk{--shiki-default:#6F42C1;--shiki-dark:#B392F0}html pre.shiki code .sZZnC, html code.shiki .sZZnC{--shiki-default:#032F62;--shiki-dark:#9ECBFF}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html.dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}",{"title":151,"searchDepth":152,"depth":152,"links":486},[487,488,489,490,491],{"id":321,"depth":152,"text":322},{"id":348,"depth":152,"text":349},{"id":369,"depth":152,"text":370},{"id":408,"depth":152,"text":409},{"id":419,"depth":152,"text":420},"Instala SoundNinja en Windows, macOS o Linux.",{},"\u002Finstallation",{"title":299,"description":492},"installation","zTwxz-vo_-k3K7RGGSHRG4ObTS6FkM9sbuxQPVMKTtY",{"id":4,"title":5,"body":499,"description":160,"extension":161,"meta":587,"navigation":163,"order":164,"path":165,"seo":588,"stem":167,"__hash__":168},{"type":7,"value":500,"toc":579},[501,503,505,507,519,521,543,545,555,557,565,567,569,573,575],[10,502,5],{"id":12},[14,504,16],{},[18,506,21],{"id":20},[23,508,509,515,517],{},[26,510,28,511,33,513,37],{},[30,512,32],{},[30,514,36],{},[26,516,40],{},[26,518,43],{},[18,520,47],{"id":46},[23,522,523,529,531],{},[26,524,28,525,55,527,58],{},[30,526,54],{},[30,528,47],{},[26,530,61],{},[26,532,64,533],{},[66,534,535,539],{},[26,536,537,73],{},[30,538,72],{},[26,540,541,79],{},[30,542,78],{},[18,544,83],{"id":82},[14,546,86,547,92,549,96,551,100,553,104],{},[88,548,91],{"href":90},[30,550,95],{},[30,552,99],{},[30,554,103],{},[18,556,108],{"id":107},[14,558,559,114,561,119,563,123],{},[30,560,113],{},[116,562,118],{},[116,564,122],{},[14,566,126],{},[18,568,130],{"id":129},[14,570,133,571,137],{},[30,572,136],{},[18,574,141],{"id":140},[14,576,144,577,149],{},[88,578,148],{"href":147},{"title":151,"searchDepth":152,"depth":152,"links":580},[581,582,583,584,585,586],{"id":20,"depth":152,"text":21},{"id":46,"depth":152,"text":47},{"id":82,"depth":152,"text":83},{"id":107,"depth":152,"text":108},{"id":129,"depth":152,"text":130},{"id":140,"depth":152,"text":141},{},{"title":5,"description":160},{"id":590,"title":148,"body":591,"description":985,"extension":161,"meta":986,"navigation":163,"order":987,"path":988,"seo":989,"stem":990,"__hash__":991},"content_es\u002Forganizing-sounds.md",{"type":7,"value":592,"toc":970},[593,596,603,607,634,641,645,648,662,669,675,679,689,694,726,730,736,740,773,779,783,786,812,815,819,832,836,842,863,879,886,890,901,904,908,915,925,931,935,943,950,967],[10,594,148],{"id":595},"organizar-sonidos",[14,597,598,599,602],{},"SoundNinja está hecho para bibliotecas grandes. ",[30,600,601],{},"Etiquetas y filtros",", pestañas, búsqueda, selección múltiple y atajos — el clip que necesitas está a un clic (o una tecla).",[18,604,606],{"id":605},"pestañas","Pestañas",[66,608,609,616,623],{},[26,610,611,612,615],{},"Añade una pestaña con ",[30,613,614],{},"Añadir pestaña",". Dale un color para escanear la barra rápido.",[26,617,618,619,622],{},"La vista ",[30,620,621],{},"Todos"," muestra cada sonido de todas las pestañas.",[26,624,625,626,629,630,633],{},"Un sonido puede pertenecer a ",[30,627,628],{},"una o más pestañas",". Clic derecho en un sonido y usa ",[30,631,632],{},"Mover a pestaña"," para asignarlo.",[14,635,636,637,640],{},"Las transiciones de pestaña están en ",[30,638,639],{},"Ajustes → General",": Slide, Fade, Botones uno a uno, o Ninguna.",[18,642,644],{"id":643},"grupos","Grupos",[14,646,647],{},"Desde la v0.5.3, los separadores pueden convertirse en grupos con nombre:",[66,649,650,653,656,659],{},[26,651,652],{},"Añadir, renombrar o quitar un grupo desde el menú contextual",[26,654,655],{},"Arrastra la cabecera del grupo — los hijos se mueven con ella",[26,657,658],{},"Suelta sonidos dentro o fuera de un grupo",[26,660,661],{},"Define color de borde, color del nombre y alineación de botones (o usa el valor por defecto de la pestaña)",[14,663,664,665,668],{},"Sigue pudiendo añadir un ",[30,666,667],{},"Separador"," simple si solo necesitas un corte visual.",[14,670,671,672,149],{},"Clic derecho en el espacio vacío del tablero para ",[30,673,674],{},"Añadir grupo",[18,676,678],{"id":677},"etiquetas-filtros","Etiquetas \u002F Filtros",[14,680,681,682,685,686,688],{},"Las etiquetas cruzan las pestañas. El panel ",[30,683,684],{},"Filtro"," (barra lateral ",[30,687,684],{},") es donde las creas y filtras el tablero.",[690,691,693],"h3",{"id":692},"crear-y-editar-etiquetas","Crear y editar etiquetas",[23,695,696,701,712,719],{},[26,697,28,698,700],{},[30,699,684],{}," en la barra lateral.",[26,702,703,704,707,708,711],{},"En ",[30,705,706],{},"Etiquetas",", usa ",[30,709,710],{},"Añadir etiqueta"," — nombre y color.",[26,713,714,715,718],{},"Renombra, recolorea o ",[30,716,717],{},"Eliminar etiqueta"," en la misma lista.",[26,720,721,722,725],{},"Si ves ",[30,723,724],{},"Aún no hay etiquetas",", crea una aquí antes de asignar.",[690,727,729],{"id":728},"asignar-etiquetas-a-sonidos","Asignar etiquetas a sonidos",[14,731,732,733,735],{},"Clic derecho en un sonido → ",[30,734,706],{}," (casillas). Un sonido puede tener varias. Si aún no hay ninguna, el menú te lleva al panel de filtro.",[690,737,739],{"id":738},"filtrar-el-tablero","Filtrar el tablero",[66,741,742,748,759,770],{},[26,743,744,745,149],{},"Activa etiquetas en el panel Filtro o como ",[30,746,747],{},"chips bajo la barra de búsqueda",[26,749,750,751,754,755,758],{},"La coincidencia es ",[30,752,753],{},"OR",": un sonido sigue visible si tiene ",[30,756,757],{},"cualquiera"," de las etiquetas seleccionadas.",[26,760,761,762,765,766,769],{},"El campo ",[30,763,764],{},"Buscar"," combina con ",[30,767,768],{},"AND"," el filtro de etiquetas activo (texto + etiquetas juntos).",[26,771,772],{},"Apaga los chips (o limpia el filtro) para ver de nuevo toda la pestaña.",[14,774,775,776,149],{},"Los nombres de etiqueta en color pueden aparecer en los botones. Actívalos en ",[30,777,778],{},"Ajustes → Comportamiento → Mostrar badges de etiquetas",[18,780,782],{"id":781},"orden","Orden",[14,784,785],{},"Abre el panel de filtro y elige un modo:",[66,787,788,794],{},[26,789,790,793],{},[30,791,792],{},"Definido por el usuario"," — tu orden de pestaña, grupos visibles",[26,795,796,401,799,401,802,100,805,808,809],{},[30,797,798],{},"Nombre",[30,800,801],{},"Fecha de añadido",[30,803,804],{},"Tiempo de reproducción",[30,806,807],{},"Tamaño de archivo"," — lista plana ordenada; ",[30,810,811],{},"los grupos se ocultan",[14,813,814],{},"Ordenar por duración puede precargar los metadatos de duración la primera vez.",[18,816,818],{"id":817},"reordenar","Reordenar",[14,820,821,822,825,826,829,830,149],{},"Activa arrastrar y soltar en ",[30,823,824],{},"Ajustes → Comportamiento"," (",[30,827,828],{},"Permitir reordenar","). Luego arrastra sonidos y grupos a su sitio. Reordenar aplica en el orden ",[30,831,792],{},[18,833,835],{"id":834},"selección-múltiple","Selección múltiple",[14,837,838,839,841],{},"Activa ",[30,840,835],{}," en la barra de navegación, luego:",[66,843,844,847,853,860],{},[26,845,846],{},"Clic para alternar un sonido",[26,848,849,852],{},[30,850,851],{},"Mayús+clic"," para un rango desde el último ancla",[26,854,855,856,859],{},"Arrastra un ",[30,857,858],{},"marco"," en el espacio vacío del tablero",[26,861,862],{},"Clic en el tablero vacío (o fuera) para limpiar la selección",[14,864,865,866,401,869,401,872,875,876,149],{},"Una barra masiva muestra el recuento, más ",[30,867,868],{},"Color",[30,870,871],{},"Mover a pestaña…",[30,873,874],{},"Eliminar"," y ",[30,877,878],{},"Hecho",[14,880,881,882,885],{},"En selección múltiple, cada botón muestra un ",[30,883,884],{},"chip de ID de 8 caracteres",". Clic derecho en el chip para copiarlo.",[18,887,889],{"id":888},"volumen-por-sonido","Volumen por sonido",[14,891,892,893,896,897,900],{},"Clic derecho → ",[30,894,895],{},"Volumen",". Arrastra el control de 0 % a 100 %. ",[30,898,899],{},"Doble clic"," lo restablece a 100 %.",[14,902,903],{},"Se acumula con el volumen de salida maestro en Ajustes.",[18,905,907],{"id":906},"atajos-e-ids-de-sonido","Atajos e IDs de sonido",[14,909,910,911,914],{},"Cada sonido tiene un ID de 8 caracteres. Cópialo desde el menú contextual del botón (",[30,912,913],{},"Copiar ID",") o el chip de ID de la selección múltiple.",[14,916,28,917,920,921,924],{},[30,918,919],{},"Ajustes → Atajos"," para vincular una tecla a un ID de sonido. Los atajos globales son opcionales. ",[30,922,923],{},"Asignar atajo"," en el menú contextual salta allí con el ID rellenado.",[14,926,927,928,930],{},"El mismo ID es el que ",[88,929,241],{"href":240}," usa para disparar un clip.",[18,932,934],{"id":933},"imágenes-de-fondo-y-colores","Imágenes de fondo y colores",[14,936,937,938,942],{},"Clic derecho en un sonido para definir colores por botón o una imagen de fondo. Eso es independiente del ",[88,939,941],{"href":940},"\u002Fdocs\u002Ftheme-editor","Theme Creator",", que da estilo a todo el tablero.",[14,944,945,946,949],{},"El selector es un diálogo ",[30,947,948],{},"Imagen de fondo"," (PNG, JPEG, GIF, WebP):",[66,951,952,958],{},[26,953,954,957],{},[30,955,956],{},"Archivos locales"," — añade carpetas, elige un archivo, busca por nombre, previsualiza la cuadrícula o quita una carpeta de la biblioteca",[26,959,960,963,964,966],{},[30,961,962],{},"KLIPY"," — busca GIFs en línea. Pon tu propia clave API en ",[30,965,824],{},". La clave no se guarda en los archivos del proyecto.",[14,968,969],{},"Tras elegir, mueve y recorta la imagen en el botón.",{"title":151,"searchDepth":152,"depth":152,"links":971},[972,973,974,979,980,981,982,983,984],{"id":605,"depth":152,"text":606},{"id":643,"depth":152,"text":644},{"id":677,"depth":152,"text":678,"children":975},[976,977,978],{"id":692,"depth":164,"text":693},{"id":728,"depth":164,"text":729},{"id":738,"depth":164,"text":739},{"id":781,"depth":152,"text":782},{"id":817,"depth":152,"text":818},{"id":834,"depth":152,"text":835},{"id":888,"depth":152,"text":889},{"id":906,"depth":152,"text":907},{"id":933,"depth":152,"text":934},"Etiquetas, filtros, pestañas, grupos, orden, selección múltiple, volumen y atajos.",{},4,"\u002Forganizing-sounds",{"title":148,"description":985},"organizing-sounds","0TCdzxC5d9uOHlnFnD2ygCuD63pFk5yy3tK0Xgbpa7M",{"id":993,"title":994,"body":995,"description":1120,"extension":161,"meta":1121,"navigation":163,"order":1122,"path":1123,"seo":1124,"stem":1125,"__hash__":1126},"content_es\u002Ftheme-editor.md","Editor de temas",{"type":7,"value":996,"toc":1114},[997,1000,1006,1010,1037,1040,1044,1058,1062,1088,1091,1095,1100],[10,998,994],{"id":999},"editor-de-temas",[14,1001,1002,1003,149],{},"El Theme Creator es el editor visual completo de tu tablero. Ábrelo desde ",[30,1004,1005],{},"Ajustes → General → Theme Creator",[18,1007,1009],{"id":1008},"tres-pestañas","Tres pestañas",[23,1011,1012,1026,1032],{},[26,1013,1014,1017,1018,1021,1022,1025],{},[30,1015,1016],{},"General"," — nombre del tema, colores compartidos y carga de fuentes (",[116,1019,1020],{},".ttf"," \u002F ",[116,1023,1024],{},".otf",")",[26,1027,1028,1031],{},[30,1029,1030],{},"Botones"," — colores, tipo, diseño y overlay GIF de los botones de sonido",[26,1033,1034,1036],{},[30,1035,606],{}," — colores, tipo y grosor de borde de la barra de pestañas",[14,1038,1039],{},"Una vista previa en vivo muestra pestañas y botones mientras editas.",[18,1041,1043],{"id":1042},"qué-puedes-cambiar","Qué puedes cambiar",[66,1045,1046,1049,1052,1055],{},[26,1047,1048],{},"Colores primario y de acento, fondos, colores de botones, colores de pestañas",[26,1050,1051],{},"Familia y tamaño de fuente de botones y pestañas",[26,1053,1054],{},"Ancho, radio, borde, huecos y padding de los botones",[26,1056,1057],{},"Opacidad del overlay GIF (normal y hover)",[18,1059,1061],{"id":1060},"guardar-y-compartir","Guardar y compartir",[66,1063,1064,1070,1076,1082],{},[26,1065,1066,1069],{},[30,1067,1068],{},"Exportar .css"," — escribe un archivo de tema para respaldar o enviar a un amigo",[26,1071,1072,1075],{},[30,1073,1074],{},"Añadir a temas"," — guarda el archivo en tu carpeta Themes y aplícalo",[26,1077,1078,1081],{},[30,1079,1080],{},"Importar .css"," — carga un preset integrado o un tema guardado",[26,1083,1084,1087],{},[30,1085,1086],{},"Restablecer"," — vuelve a los valores por defecto de SoundNinja",[14,1089,1090],{},"Si cierras la ventana con cambios sin guardar, SoundNinja te pide que guardes primero.",[18,1092,1094],{"id":1093},"sin-el-editor-completo","Sin el editor completo",[14,1096,703,1097,1099],{},[30,1098,639],{}," aún puedes:",[66,1101,1102,1105,1111],{},[26,1103,1104],{},"Elegir un tema de la lista",[26,1106,1107,1108,1025],{},"Editar variables CSS en vivo (",[30,1109,1110],{},"CSS personalizado",[26,1112,1113],{},"Importar un archivo de tema a la carpeta Themes",{"title":151,"searchDepth":152,"depth":152,"links":1115},[1116,1117,1118,1119],{"id":1008,"depth":152,"text":1009},{"id":1042,"depth":152,"text":1043},{"id":1060,"depth":152,"text":1061},{"id":1093,"depth":152,"text":1094},"Diseña colores, fuentes, botones y pestañas en el Theme Creator.",{},5,"\u002Ftheme-editor",{"title":994,"description":1120},"theme-editor","bPcJP7OLtBsnNMYJ-S1J6DmB6nngULo1_Q1hBJMNZAQ",{"id":1128,"title":1129,"body":1130,"description":1266,"extension":161,"meta":1267,"navigation":163,"order":1268,"path":1269,"seo":1270,"stem":1271,"__hash__":1272},"content_es\u002Frecording-editor.md","Editor de grabación",{"type":7,"value":1131,"toc":1260},[1132,1135,1141,1145,1151,1171,1174,1178,1203,1207,1221,1225,1239,1250],[10,1133,1129],{"id":1134},"editor-de-grabación",[14,1136,1137,1138,1140],{},"Graba un clip dentro de SoundNinja, recórtalo e impórtalo a una pestaña. Abre el editor con el botón ",[30,1139,95],{}," en la barra del reproductor.",[18,1142,1144],{"id":1143},"elegir-una-entrada","Elegir una entrada",[14,1146,703,1147,1150],{},[30,1148,1149],{},"Ajustes → Audio",":",[66,1152,1153,1159,1165],{},[26,1154,1155,1158],{},[30,1156,1157],{},"Dispositivos de entrada"," — micrófono",[26,1160,1161,1164],{},[30,1162,1163],{},"Dispositivos de salida (audio del PC)"," — loopback de lo que reproduce el PC",[26,1166,1167,1170],{},[30,1168,1169],{},"Volumen de entrada"," — ganancia de captura del 0 % al 200 %",[14,1172,1173],{},"El botón Grabar usa el dispositivo que eliges aquí.",[18,1175,1177],{"id":1176},"editar-la-toma","Editar la toma",[66,1179,1180,1183,1186,1194,1197,1200],{},[26,1181,1182],{},"Grabar y detener",[26,1184,1185],{},"Observar el medidor de nivel de entrada",[26,1187,1188,100,1191],{},[30,1189,1190],{},"Normalizar",[30,1192,1193],{},"Cancelación de ruido",[26,1195,1196],{},"Recortar todo el clip, recortar a una selección o borrar una selección",[26,1198,1199],{},"Deshacer \u002F rehacer",[26,1201,1202],{},"Acercar y alejar",[18,1204,1206],{"id":1205},"preparar-e-importar","Preparar e importar",[23,1208,1209,1212,1215],{},[26,1210,1211],{},"Añade la selección o la pista completa a la lista de staging.",[26,1213,1214],{},"La lista empieza vacía: graba, edita y luego añade un clip.",[26,1216,1217,100,1219,104],{},[30,1218,99],{},[30,1220,103],{},[18,1222,1224],{"id":1223},"separación-de-stems-opcional","Separación de stems (opcional)",[14,1226,1227,1228,1231,1232,100,1235,1238],{},"Las builds oficiales de Windows, macOS y Linux incluyen la función ",[30,1229,1230],{},"stems",". El Record Editor puede conservar ",[30,1233,1234],{},"voces",[30,1236,1237],{},"música"," con BS-RoFormer.",[14,1240,1241,1242,1245,1246,1249],{},"El modelo pesa unos 158 MB y ",[30,1243,1244],{},"no"," viene en el instalador. Descárgalo desde ",[30,1247,1248],{},"Ajustes → Separación de stems",", o acepta el aviso del primer arranque. El instalador de Windows también puede ofrecer descargar el modelo al primer inicio.",[14,1251,1252,1253,1021,1256,1259],{},"Las builds personalizadas desde código necesitan un flag extra (",[116,1254,1255],{},"tauri:serve:stems",[116,1257,1258],{},"tauri:build:stems",").",{"title":151,"searchDepth":152,"depth":152,"links":1261},[1262,1263,1264,1265],{"id":1143,"depth":152,"text":1144},{"id":1176,"depth":152,"text":1177},{"id":1205,"depth":152,"text":1206},{"id":1223,"depth":152,"text":1224},"Captura micrófono o audio del PC, edita el clip y suéltalo en tu tablero.",{},6,"\u002Frecording-editor",{"title":1129,"description":1266},"recording-editor","89aDSCp7hE8To2TNFwdWaImQVsHH2-xNcOyltCPP5IY",{"id":1274,"title":1275,"body":1276,"description":1488,"extension":161,"meta":1489,"navigation":163,"order":1490,"path":1491,"seo":1492,"stem":1493,"__hash__":1494},"content_es\u002Fremote-control.md","Control remoto",{"type":7,"value":1277,"toc":1481},[1278,1281,1284,1288,1317,1320,1323,1358,1362,1382,1385,1389,1421,1425,1431],[10,1279,1275],{"id":1280},"control-remoto",[14,1282,1283],{},"SoundNinja puede escuchar en tu red local para que Bitfocus Companion (o cualquier cliente HTTP\u002FWebSocket) reproduzca y detenga sonidos.",[18,1285,1287],{"id":1286},"activar-el-servidor-remoto","Activar el servidor remoto",[23,1289,1290,1295,1301,1307],{},[26,1291,28,1292,149],{},[30,1293,1294],{},"Ajustes → Remoto",[26,1296,1297,1298,149],{},"Activa el servidor remoto. El puerto por defecto es ",[30,1299,1300],{},"7331",[26,1302,1303,1304,149],{},"Opcional: define un token. Los clientes deben enviarlo como Bearer token o ",[116,1305,1306],{},"?token=",[26,1308,1309,1310,1313,1314,149],{},"Copia la URL ",[116,1311,1312],{},"http:\u002F\u002FIP:PORT",", o copia la IP del sistema desde ",[30,1315,1316],{},"Ajustes → Acerca de",[14,1318,1319],{},"Windows puede mostrar un aviso del firewall la primera vez que arranca el servidor. Permite el acceso a la red privada.",[18,1321,241],{"id":1322},"bitfocus-companion",[23,1324,1325,1332,1341,1351],{},[26,1326,1327,1328,149],{},"Instala ",[88,1329,241],{"href":1330,"rel":1331},"https:\u002F\u002Fbitfocus.io\u002Fcompanion",[259],[26,1333,1334,1335,1340],{},"Descarga ",[88,1336,1339],{"href":1337,"rel":1338},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002Fcompanion-module-soundninja\u002Freleases\u002Flatest",[259],"SoundNinja-Companion.tgz",". Aún no hay paquete en Companion Store.",[26,1342,1343,1344,1347,1348,149],{},"En Companion: ",[30,1345,1346],{},"Modules → Load module package"," y elige el ",[116,1349,1350],{},".tgz",[26,1352,1353,1354,1357],{},"Añade una conexión ",[30,1355,1356],{},"Sound Ninja",". Pega la IP del PC, el puerto y el token si definiste uno.",[18,1359,1361],{"id":1360},"acciones","Acciones",[66,1363,1364,1370,1376],{},[26,1365,1366,1369],{},[30,1367,1368],{},"Trigger Sound"," — elige en el menú desplegable en vivo, o escribe un ID de sonido de 8 caracteres (las variables de Companion funcionan)",[26,1371,1372,1375],{},[30,1373,1374],{},"Stop Sound"," — detiene un sonido en reproducción por ID",[26,1377,1378,1381],{},[30,1379,1380],{},"Stop All"," — detiene todos los sonidos en reproducción",[14,1383,1384],{},"Copia un ID de sonido en SoundNinja desde el menú contextual del botón o el chip de ID de la selección múltiple.",[18,1386,1388],{"id":1387},"feedbacks-y-variables","Feedbacks y variables",[66,1390,1391,1397,1409,1415],{},[26,1392,1393,1396],{},[30,1394,1395],{},"Sound Playing"," — verdadero mientras ese ID de sonido está activo (úsalo para el color del botón)",[26,1398,1399,1402,1403,1021,1406],{},[116,1400,1401],{},"$(soundninja:connected)"," — ",[116,1404,1405],{},"true",[116,1407,1408],{},"false",[26,1410,1411,1414],{},[116,1412,1413],{},"$(soundninja:playing_count)"," — cuántos sonidos suenan",[26,1416,1417,1420],{},[116,1418,1419],{},"$(soundninja:last_triggered)"," — último ID de sonido disparado",[18,1422,1424],{"id":1423},"api-http-avanzado","API HTTP (avanzado)",[14,1426,1427,1428],{},"Ruta base: ",[116,1429,1430],{},"\u002Fapi\u002Fv1",[66,1432,1433,1439,1445,1451,1461,1467,1475],{},[26,1434,1435,1438],{},[116,1436,1437],{},"GET \u002Finfo"," — nombre de la app, versión, protocolo, si se requiere un token",[26,1440,1441,1444],{},[116,1442,1443],{},"GET \u002Fsounds"," — lista de sonidos (id, name, tabs, active)",[26,1446,1447,1450],{},[116,1448,1449],{},"GET \u002Fstate"," — sonidos más IDs que suenan ahora",[26,1452,1453,1456,1457,1460],{},[116,1454,1455],{},"POST \u002Ftrigger"," con ",[116,1458,1459],{},"{ \"id\" }"," — reproducir un sonido",[26,1462,1463,1466],{},[116,1464,1465],{},"GET \u002Ftrigger\u002F:id"," — reproducir (fácil de probar en el navegador)",[26,1468,1469,1456,1472,1474],{},[116,1470,1471],{},"POST \u002Fstop",[116,1473,1459],{}," opcional — detener un sonido o todos",[26,1476,1477,1480],{},[116,1478,1479],{},"GET \u002Fws"," — estado en vivo; enviar comandos trigger\u002Fstop de entrada",{"title":151,"searchDepth":152,"depth":152,"links":1482},[1483,1484,1485,1486,1487],{"id":1286,"depth":152,"text":1287},{"id":1322,"depth":152,"text":241},{"