[{"data":1,"prerenderedAt":1618},["ShallowReactive",2],{"docs-page-es-\u002Frecording-editor":3,"docs-nav-es":169},{"id":4,"title":5,"body":6,"description":160,"extension":161,"meta":162,"navigation":163,"order":164,"path":165,"seo":166,"stem":167,"__hash__":168},"content_es\u002Frecording-editor.md","Editor de grabación",{"type":7,"value":8,"toc":152},"minimark",[9,13,22,27,34,56,59,63,89,93,111,115,129,140],[10,11,5],"h1",{"id":12},"editor-de-grabación",[14,15,16,17,21],"p",{},"Graba un clip dentro de SoundNinja, recórtalo e impórtalo a una pestaña. Abre el editor con el botón ",[18,19,20],"strong",{},"Grabar"," en la barra del reproductor.",[23,24,26],"h2",{"id":25},"elegir-una-entrada","Elegir una entrada",[14,28,29,30,33],{},"En ",[18,31,32],{},"Ajustes → Audio",":",[35,36,37,44,50],"ul",{},[38,39,40,43],"li",{},[18,41,42],{},"Dispositivos de entrada"," — micrófono",[38,45,46,49],{},[18,47,48],{},"Dispositivos de salida (audio del PC)"," — loopback de lo que reproduce el PC",[38,51,52,55],{},[18,53,54],{},"Volumen de entrada"," — ganancia de captura del 0 % al 200 %",[14,57,58],{},"El botón Grabar usa el dispositivo que eliges aquí.",[23,60,62],{"id":61},"editar-la-toma","Editar la toma",[35,64,65,68,71,80,83,86],{},[38,66,67],{},"Grabar y detener",[38,69,70],{},"Observar el medidor de nivel de entrada",[38,72,73,76,77],{},[18,74,75],{},"Normalizar"," o ",[18,78,79],{},"Cancelación de ruido",[38,81,82],{},"Recortar todo el clip, recortar a una selección o borrar una selección",[38,84,85],{},"Deshacer \u002F rehacer",[38,87,88],{},"Acercar y alejar",[23,90,92],{"id":91},"preparar-e-importar","Preparar e importar",[94,95,96,99,102],"ol",{},[38,97,98],{},"Añade la selección o la pista completa a la lista de staging.",[38,100,101],{},"La lista empieza vacía: graba, edita y luego añade un clip.",[38,103,104,76,107,110],{},[18,105,106],{},"Importar selección",[18,108,109],{},"Importar todo"," en la pestaña actual o en una pestaña que elijas.",[23,112,114],{"id":113},"separación-de-stems-opcional","Separación de stems (opcional)",[14,116,117,118,121,122,76,125,128],{},"Las builds oficiales de Windows, macOS y Linux incluyen la función ",[18,119,120],{},"stems",". El Record Editor puede conservar ",[18,123,124],{},"voces",[18,126,127],{},"música"," con BS-RoFormer.",[14,130,131,132,135,136,139],{},"El modelo pesa unos 158 MB y ",[18,133,134],{},"no"," viene en el instalador. Descárgalo desde ",[18,137,138],{},"Ajustes → Separación de stems",", o acepta el aviso del primer arranque. El instalador de Windows también puede ofrecer descargar el modelo al primer inicio.",[14,141,142,143,147,148,151],{},"Las builds personalizadas desde código necesitan un flag extra (",[144,145,146],"code",{},"tauri:serve:stems"," \u002F ",[144,149,150],{},"tauri:build:stems",").",{"title":153,"searchDepth":154,"depth":154,"links":155},"",2,[156,157,158,159],{"id":25,"depth":154,"text":26},{"id":61,"depth":154,"text":62},{"id":91,"depth":154,"text":92},{"id":113,"depth":154,"text":114},"Captura micrófono o audio del PC, edita el clip y suéltalo en tu tablero.","md",{},true,6,"\u002Frecording-editor",{"title":5,"description":160},"recording-editor","89aDSCp7hE8To2TNFwdWaImQVsHH2-xNcOyltCPP5IY",[170,300,523,667,1069,1203,1298,1520],{"id":171,"title":172,"body":173,"description":293,"extension":161,"meta":294,"navigation":163,"order":295,"path":296,"seo":297,"stem":298,"__hash__":299},"content_es\u002Foverview.md","Resumen",{"type":7,"value":174,"toc":287},[175,178,181,184,187,191,205,209,249,253,263,267],[10,176,172],{"id":177},"resumen",[14,179,180],{},"SoundNinja es un soundboard de código abierto para streaming en directo, charlas con amigos y grabación de podcasts. Está construido con Tauri v2 y Nuxt 4 para que sea ligero en RAM y disco.",[14,182,183],{},"El objetivo es simple: mantener una biblioteca enorme fácil de recorrer y reproducir el clip correcto en milisegundos. La interfaz también funciona bien como panel en VR.",[14,185,186],{},"SoundNinja sigue en desarrollo temprano. Las funciones marchan, pero no todas las plataformas están del todo probadas.",[23,188,190],{"id":189},"para-quién","Para quién",[35,192,193,196,199,202],{},[38,194,195],{},"Streamers que necesitan cues de sonido al instante",[38,197,198],{},"Amigos que quieren un tablero compartido para el chat de voz",[38,200,201],{},"Podcasters que graban clips y los sueltan en un tablero",[38,203,204],{},"Quien quiera un soundboard personalizable y local-first",[23,206,208],{"id":207},"qué-puedes-hacer","Qué puedes hacer",[35,210,211,214,217,220,223,226,229,232,235,243,246],{},[38,212,213],{},"Montar un soundboard con tus propios archivos de audio",[38,215,216],{},"Organizar sonidos en pestañas de colores, grupos, etiquetas y búsqueda",[38,218,219],{},"Filtrar por etiquetas (OR) y ordenar por nombre, fecha, duración o tamaño",[38,221,222],{},"Selección múltiple con marco o rango Mayús, luego color, mover o borrar en lote",[38,224,225],{},"Ajustar el volumen por sonido desde el menú contextual",[38,227,228],{},"Diseñar el aspecto con el Theme Creator",[38,230,231],{},"Grabar audio del PC o un micrófono en el Record Editor",[38,233,234],{},"Asignar atajos a sonidos individuales",[38,236,237,238],{},"Disparar sonidos desde ",[239,240,242],"a",{"href":241},"\u002Fdocs\u002Fremote-control","Bitfocus Companion",[38,244,245],{},"Importar y exportar un soundboard completo para compartirlo",[38,247,248],{},"Usar GIFs o imágenes en los botones — biblioteca local de carpetas o KLIPY",[23,250,252],{"id":251},"licencia","Licencia",[14,254,255,256,262],{},"SoundNinja es software libre bajo ",[239,257,261],{"href":258,"rel":259},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fblob\u002Fmain\u002FLICENSE",[260],"nofollow","GPL-3.0",". Haz fork, cámbialo, compártelo.",[23,264,266],{"id":265},"siguientes-pasos","Siguientes pasos",[94,268,269,275,281],{},[38,270,271],{},[239,272,274],{"href":273},"\u002Fdocs\u002Finstallation","Instalar SoundNinja",[38,276,277],{},[239,278,280],{"href":279},"\u002Fdocs\u002Fadding-sounds","Añadir sonidos",[38,282,283],{},[239,284,286],{"href":285},"\u002Fdocs\u002Forganizing-sounds","Organizar tu tablero",{"title":153,"searchDepth":154,"depth":154,"links":288},[289,290,291,292],{"id":189,"depth":154,"text":190},{"id":207,"depth":154,"text":208},{"id":251,"depth":154,"text":252},{"id":265,"depth":154,"text":266},"Qué es SoundNinja y qué puedes hacer con él.",{},1,"\u002Foverview",{"title":172,"description":293},"overview","XWpBFvtyid6BLXO3HByHppTxfsOo0i7DlSOMew5tq2g",{"id":301,"title":302,"body":303,"description":517,"extension":161,"meta":518,"navigation":163,"order":154,"path":519,"seo":520,"stem":521,"__hash__":522},"content_es\u002Finstallation.md","Instalación",{"type":7,"value":304,"toc":510},[305,308,322,326,346,349,353,367,370,374,398,409,413,420,424,439,469,485,506],[10,306,302],{"id":307},"instalación",[14,309,310,311,315,316,321],{},"Consigue una build en la ",[239,312,314],{"href":313},"\u002Fdownload","página de descarga"," o en ",[239,317,320],{"href":318,"rel":319},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Freleases\u002Flatest",[260],"GitHub Releases",". SoundNinja está en desarrollo temprano, así que trata las builds como beta.",[23,323,325],{"id":324},"windows","Windows",[35,327,328,337,340,343],{},[38,329,330,76,333,336],{},[18,331,332],{},"Instalador (.exe)",[18,334,335],{},"MSI (.msi)"," para Windows de 64 bits",[38,338,339],{},"Objetivo de la landing: Windows 10 y posterior",[38,341,342],{},"El README de la app también lista Windows 8 y superior",[38,344,345],{},"El instalador NSIS usa tema oscuro. Elige idioma en el setup — SoundNinja lo recuerda en el siguiente arranque.",[14,347,348],{},"Ejecuta el instalador y luego abre SoundNinja desde el menú Inicio.",[23,350,352],{"id":351},"macos","macOS",[35,354,355,361,364],{},[38,356,357,360],{},[18,358,359],{},".dmg universal"," para Apple Silicon e Intel",[38,362,363],{},"Objetivo de la landing: macOS 10.14 y posterior",[38,365,366],{},"El README de la app lista macOS 10.15 y superior",[14,368,369],{},"Abre la imagen de disco y arrastra SoundNinja a Aplicaciones.",[23,371,373],{"id":372},"linux","Linux",[35,375,376,382,388,395],{},[38,377,378,381],{},[18,379,380],{},"Debian (.deb)"," para Ubuntu \u002F Debian",[38,383,384,387],{},[18,385,386],{},"AppImage"," para otras distros",[38,389,390,391,394],{},"Tras publicar una release, los usuarios de Arch pueden instalar ",[144,392,393],{},"soundninja-bin"," desde el AUR",[38,396,397],{},"Probado en Ubuntu 20.04",[14,399,400,401,404,405,408],{},"Las builds de escritorio necesitan paquetes WebKit y GTK. En Debian\u002FUbuntu eso suele ser ",[144,402,403],{},"libwebkit2gtk",", ",[144,406,407],{},"libgtk-3-0"," y una biblioteca app-indicator.",[23,410,412],{"id":411},"actualizaciones","Actualizaciones",[14,414,415,416,419],{},"En la app, abre ",[18,417,418],{},"Ayuda → Buscar actualizaciones",". También puedes dejar que SoundNinja compruebe al arrancar en Ajustes.",[23,421,423],{"id":422},"compilar-desde-el-código","Compilar desde el código",[14,425,426,427,432,433,438],{},"¿Necesitas una build personalizada? Clona ",[239,428,431],{"href":429,"rel":430},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja",[260],"el repo",", instala los ",[239,434,437],{"href":435,"rel":436},"https:\u002F\u002Fv2.tauri.app\u002Fstart\u002Fprerequisites\u002F",[260],"requisitos de Tauri"," y luego:",[440,441,445],"pre",{"className":442,"code":443,"language":444,"meta":153,"style":153},"language-bash shiki shiki-themes github-light github-dark","bun install\nbun run tauri:serve\n","bash",[144,446,447,459],{"__ignoreMap":153},[448,449,451,455],"span",{"class":450,"line":295},"line",[448,452,454],{"class":453},"sScJk","bun",[448,456,458],{"class":457},"sZZnC"," install\n",[448,460,461,463,466],{"class":450,"line":154},[448,462,454],{"class":453},[448,464,465],{"class":457}," run",[448,467,468],{"class":457}," tauri:serve\n",[14,470,471,404,474,76,477,480,481,484],{},[144,472,473],{},"npm",[144,475,476],{},"pnpm",[144,478,479],{},"deno"," también sirven. Build de producción: ",[144,482,483],{},"bun run tauri:build",".",[14,486,487,490,491,496,497,500,501,484],{},[18,488,489],{},"Solo Windows:"," cada compile de Windows incluye ASIO con el ",[239,492,495],{"href":493,"rel":494},"https:\u002F\u002Fwww.steinberg.net\u002Fasiosdk",[260],"Steinberg ASIO SDK",". Ejecuta ",[144,498,499],{},"bun run setup:asio"," una vez (el SDK no está en git). Linux y macOS usan PipeWire \u002F Core Audio — omite ese paso. Detalles: ",[239,502,505],{"href":503,"rel":504},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fblob\u002Fmain\u002Fdocs\u002Fbuild-from-source.md",[260],"build-from-source.md",[507,508,509],"style",{},"html pre.shiki code .sScJk, html code.shiki .sScJk{--shiki-default:#6F42C1;--shiki-dark:#B392F0}html pre.shiki code .sZZnC, html code.shiki .sZZnC{--shiki-default:#032F62;--shiki-dark:#9ECBFF}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html.dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}",{"title":153,"searchDepth":154,"depth":154,"links":511},[512,513,514,515,516],{"id":324,"depth":154,"text":325},{"id":351,"depth":154,"text":352},{"id":372,"depth":154,"text":373},{"id":411,"depth":154,"text":412},{"id":422,"depth":154,"text":423},"Instala SoundNinja en Windows, macOS o Linux.",{},"\u002Finstallation",{"title":302,"description":517},"installation","6QKa3OcTs0sq8JVvjceX-ugwL8mdPc4h6O-JOoo1Qd8",{"id":524,"title":280,"body":525,"description":660,"extension":161,"meta":661,"navigation":163,"order":662,"path":663,"seo":664,"stem":665,"__hash__":666},"content_es\u002Fadding-sounds.md",{"type":7,"value":526,"toc":652},[527,530,533,537,556,560,591,595,610,614,628,631,635,642,646],[10,528,280],{"id":529},"añadir-sonidos",[14,531,532],{},"Un tablero está vacío hasta que añades clips. SoundNinja puede importar archivos, carpetas enteras, una grabación o un pack de soundboard compartido.",[23,534,536],{"id":535},"importar-archivos-de-audio","Importar archivos de audio",[94,538,539,550,553],{},[38,540,541,542,545,546,549],{},"Abre ",[18,543,544],{},"Archivo → Importar archivos de audio",", o usa ",[18,547,548],{},"Importar"," en la barra de navegación.",[38,551,552],{},"Elige uno o más archivos de audio.",[38,554,555],{},"Los sonidos llegan a la pestaña actual.",[23,557,559],{"id":558},"importar-carpetas","Importar carpetas",[94,561,562,571,574],{},[38,563,541,564,567,568,570],{},[18,565,566],{},"Archivo → Importar carpetas"," (o ",[18,569,559],{}," en la barra de navegación).",[38,572,573],{},"Añade una o más carpetas. Arrastra para reordenarlas antes de importar.",[38,575,576,577],{},"Elige cómo llegan:\n",[35,578,579,585],{},[38,580,581,584],{},[18,582,583],{},"Importar como pestañas"," — cada carpeta se convierte en su propia pestaña",[38,586,587,590],{},[18,588,589],{},"Importar a la pestaña actual"," — cada archivo va a la pestaña activa",[23,592,594],{"id":593},"grabar-un-clip","Grabar un clip",[14,596,597,598,602,603,605,606,76,608,110],{},"Abre el ",[239,599,601],{"href":600},"\u002Fdocs\u002Frecording-editor","Record Editor"," desde el botón ",[18,604,20],{}," en la barra del reproductor. Captura, recorta y luego ",[18,607,106],{},[18,609,109],{},[23,611,613],{"id":612},"importar-un-soundboard","Importar un soundboard",[14,615,616,619,620,623,624,627],{},[18,617,618],{},"Archivo → Importar soundboard"," carga un pack compartido. Los packs son un ",[144,621,622],{},".zip"," que contiene ",[144,625,626],{},"project.sninja"," más los archivos de sonido. Tras importar, abre el proyecto y reproduce.",[14,629,630],{},"También puedes tener varios proyectos (perfiles). Usa el selector de proyecto para cambiar de tablero.",[23,632,634],{"id":633},"reenlazar-archivos-faltantes","Reenlazar archivos faltantes",[14,636,637,638,641],{},"Si los archivos de audio se mueven en el disco, SoundNinja muestra ",[18,639,640],{},"Archivos de sonido faltantes",". Elige una carpeta para buscar y reenlazar los clips.",[23,643,645],{"id":644},"siguiente","Siguiente",[14,647,648,649,484],{},"Organiza pestañas, etiquetas, filtros y atajos en ",[239,650,651],{"href":285},"Organizar sonidos",{"title":153,"searchDepth":154,"depth":154,"links":653},[654,655,656,657,658,659],{"id":535,"depth":154,"text":536},{"id":558,"depth":154,"text":559},{"id":593,"depth":154,"text":594},{"id":612,"depth":154,"text":613},{"id":633,"depth":154,"text":634},{"id":644,"depth":154,"text":645},"Importa audio, carpetas, grabaciones y soundboards compartidos.",{},3,"\u002Fadding-sounds",{"title":280,"description":660},"adding-sounds","O5nOJGNq2FL6jafUxqoGYNKJDVbb2UrZRjfKpK21LlQ",{"id":668,"title":651,"body":669,"description":1062,"extension":161,"meta":1063,"navigation":163,"order":1064,"path":1065,"seo":1066,"stem":1067,"__hash__":1068},"content_es\u002Forganizing-sounds.md",{"type":7,"value":670,"toc":1047},[671,674,681,685,712,719,723,726,740,747,753,757,767,772,803,807,813,817,850,856,860,863,889,892,896,909,913,919,940,956,963,967,978,981,985,992,1002,1008,1012,1020,1027,1044],[10,672,651],{"id":673},"organizar-sonidos",[14,675,676,677,680],{},"SoundNinja está hecho para bibliotecas grandes. ",[18,678,679],{},"Etiquetas y filtros",", pestañas, búsqueda, selección múltiple y atajos — el clip que necesitas está a un clic (o una tecla).",[23,682,684],{"id":683},"pestañas","Pestañas",[35,686,687,694,701],{},[38,688,689,690,693],{},"Añade una pestaña con ",[18,691,692],{},"Añadir pestaña",". Dale un color para escanear la barra rápido.",[38,695,696,697,700],{},"La vista ",[18,698,699],{},"Todos"," muestra cada sonido de todas las pestañas.",[38,702,703,704,707,708,711],{},"Un sonido puede pertenecer a ",[18,705,706],{},"una o más pestañas",". Clic derecho en un sonido y usa ",[18,709,710],{},"Mover a pestaña"," para asignarlo.",[14,713,714,715,718],{},"Las transiciones de pestaña están en ",[18,716,717],{},"Ajustes → General",": Slide, Fade, Botones uno a uno, o Ninguna.",[23,720,722],{"id":721},"grupos","Grupos",[14,724,725],{},"Desde la v0.5.3, los separadores pueden convertirse en grupos con nombre:",[35,727,728,731,734,737],{},[38,729,730],{},"Añadir, renombrar o quitar un grupo desde el menú contextual",[38,732,733],{},"Arrastra la cabecera del grupo — los hijos se mueven con ella",[38,735,736],{},"Suelta sonidos dentro o fuera de un grupo",[38,738,739],{},"Define color de borde, color del nombre y alineación de botones (o usa el valor por defecto de la pestaña)",[14,741,742,743,746],{},"Sigue pudiendo añadir un ",[18,744,745],{},"Separador"," simple si solo necesitas un corte visual.",[14,748,749,750,484],{},"Clic derecho en el espacio vacío del tablero para ",[18,751,752],{},"Añadir grupo",[23,754,756],{"id":755},"etiquetas-filtros","Etiquetas \u002F Filtros",[14,758,759,760,763,764,766],{},"Las etiquetas cruzan las pestañas. El panel ",[18,761,762],{},"Filtro"," (barra lateral ",[18,765,762],{},") es donde las creas y filtras el tablero.",[768,769,771],"h3",{"id":770},"crear-y-editar-etiquetas","Crear y editar etiquetas",[94,773,774,779,789,796],{},[38,775,541,776,778],{},[18,777,762],{}," en la barra lateral.",[38,780,29,781,784,785,788],{},[18,782,783],{},"Etiquetas",", usa ",[18,786,787],{},"Añadir etiqueta"," — nombre y color.",[38,790,791,792,795],{},"Renombra, recolorea o ",[18,793,794],{},"Eliminar etiqueta"," en la misma lista.",[38,797,798,799,802],{},"Si ves ",[18,800,801],{},"Aún no hay etiquetas",", crea una aquí antes de asignar.",[768,804,806],{"id":805},"asignar-etiquetas-a-sonidos","Asignar etiquetas a sonidos",[14,808,809,810,812],{},"Clic derecho en un sonido → ",[18,811,783],{}," (casillas). Un sonido puede tener varias. Si aún no hay ninguna, el menú te lleva al panel de filtro.",[768,814,816],{"id":815},"filtrar-el-tablero","Filtrar el tablero",[35,818,819,825,836,847],{},[38,820,821,822,484],{},"Activa etiquetas en el panel Filtro o como ",[18,823,824],{},"chips bajo la barra de búsqueda",[38,826,827,828,831,832,835],{},"La coincidencia es ",[18,829,830],{},"OR",": un sonido sigue visible si tiene ",[18,833,834],{},"cualquiera"," de las etiquetas seleccionadas.",[38,837,838,839,842,843,846],{},"El campo ",[18,840,841],{},"Buscar"," combina con ",[18,844,845],{},"AND"," el filtro de etiquetas activo (texto + etiquetas juntos).",[38,848,849],{},"Apaga los chips (o limpia el filtro) para ver de nuevo toda la pestaña.",[14,851,852,853,484],{},"Los nombres de etiqueta en color pueden aparecer en los botones. Actívalos en ",[18,854,855],{},"Ajustes → Comportamiento → Mostrar badges de etiquetas",[23,857,859],{"id":858},"orden","Orden",[14,861,862],{},"Abre el panel de filtro y elige un modo:",[35,864,865,871],{},[38,866,867,870],{},[18,868,869],{},"Definido por el usuario"," — tu orden de pestaña, grupos visibles",[38,872,873,404,876,404,879,76,882,885,886],{},[18,874,875],{},"Nombre",[18,877,878],{},"Fecha de añadido",[18,880,881],{},"Tiempo de reproducción",[18,883,884],{},"Tamaño de archivo"," — lista plana ordenada; ",[18,887,888],{},"los grupos se ocultan",[14,890,891],{},"Ordenar por duración puede precargar los metadatos de duración la primera vez.",[23,893,895],{"id":894},"reordenar","Reordenar",[14,897,898,899,902,903,906,907,484],{},"Activa arrastrar y soltar en ",[18,900,901],{},"Ajustes → Comportamiento"," (",[18,904,905],{},"Permitir reordenar","). Luego arrastra sonidos y grupos a su sitio. Reordenar aplica en el orden ",[18,908,869],{},[23,910,912],{"id":911},"selección-múltiple","Selección múltiple",[14,914,915,916,918],{},"Activa ",[18,917,912],{}," en la barra de navegación, luego:",[35,920,921,924,930,937],{},[38,922,923],{},"Clic para alternar un sonido",[38,925,926,929],{},[18,927,928],{},"Mayús+clic"," para un rango desde el último ancla",[38,931,932,933,936],{},"Arrastra un ",[18,934,935],{},"marco"," en el espacio vacío del tablero",[38,938,939],{},"Clic en el tablero vacío (o fuera) para limpiar la selección",[14,941,942,943,404,946,404,949,952,953,484],{},"Una barra masiva muestra el recuento, más ",[18,944,945],{},"Color",[18,947,948],{},"Mover a pestaña…",[18,950,951],{},"Eliminar"," y ",[18,954,955],{},"Hecho",[14,957,958,959,962],{},"En selección múltiple, cada botón muestra un ",[18,960,961],{},"chip de ID de 8 caracteres",". Clic derecho en el chip para copiarlo.",[23,964,966],{"id":965},"volumen-por-sonido","Volumen por sonido",[14,968,969,970,973,974,977],{},"Clic derecho → ",[18,971,972],{},"Volumen",". Arrastra el control de 0 % a 100 %. ",[18,975,976],{},"Doble clic"," lo restablece a 100 %.",[14,979,980],{},"Se acumula con el volumen de salida maestro en Ajustes.",[23,982,984],{"id":983},"atajos-e-ids-de-sonido","Atajos e IDs de sonido",[14,986,987,988,991],{},"Cada sonido tiene un ID de 8 caracteres. Cópialo desde el menú contextual del botón (",[18,989,990],{},"Copiar ID",") o el chip de ID de la selección múltiple.",[14,993,541,994,997,998,1001],{},[18,995,996],{},"Ajustes → Atajos"," para vincular una tecla a un ID de sonido. Los atajos globales son opcionales. ",[18,999,1000],{},"Asignar atajo"," en el menú contextual salta allí con el ID rellenado.",[14,1003,1004,1005,1007],{},"El mismo ID es el que ",[239,1006,242],{"href":241}," usa para disparar un clip.",[23,1009,1011],{"id":1010},"imágenes-de-fondo-y-colores","Imágenes de fondo y colores",[14,1013,1014,1015,1019],{},"Clic derecho en un sonido para definir colores por botón o una imagen de fondo. Eso es independiente del ",[239,1016,1018],{"href":1017},"\u002Fdocs\u002Ftheme-editor","Theme Creator",", que da estilo a todo el tablero.",[14,1021,1022,1023,1026],{},"El selector es un diálogo ",[18,1024,1025],{},"Imagen de fondo"," (PNG, JPEG, GIF, WebP):",[35,1028,1029,1035],{},[38,1030,1031,1034],{},[18,1032,1033],{},"Archivos locales"," — añade carpetas, elige un archivo, busca por nombre, previsualiza la cuadrícula o quita una carpeta de la biblioteca",[38,1036,1037,1040,1041,1043],{},[18,1038,1039],{},"KLIPY"," — busca GIFs en línea. Pon tu propia clave API en ",[18,1042,901],{},". La clave no se guarda en los archivos del proyecto.",[14,1045,1046],{},"Tras elegir, mueve y recorta la imagen en el botón.",{"title":153,"searchDepth":154,"depth":154,"links":1048},[1049,1050,1051,1056,1057,1058,1059,1060,1061],{"id":683,"depth":154,"text":684},{"id":721,"depth":154,"text":722},{"id":755,"depth":154,"text":756,"children":1052},[1053,1054,1055],{"id":770,"depth":662,"text":771},{"id":805,"depth":662,"text":806},{"id":815,"depth":662,"text":816},{"id":858,"depth":154,"text":859},{"id":894,"depth":154,"text":895},{"id":911,"depth":154,"text":912},{"id":965,"depth":154,"text":966},{"id":983,"depth":154,"text":984},{"id":1010,"depth":154,"text":1011},"Etiquetas, filtros, pestañas, grupos, orden, selección múltiple, volumen y atajos.",{},4,"\u002Forganizing-sounds",{"title":651,"description":1062},"organizing-sounds","0TCdzxC5d9uOHlnFnD2ygCuD63pFk5yy3tK0Xgbpa7M",{"id":1070,"title":1071,"body":1072,"description":1196,"extension":161,"meta":1197,"navigation":163,"order":1198,"path":1199,"seo":1200,"stem":1201,"__hash__":1202},"content_es\u002Ftheme-editor.md","Editor de temas",{"type":7,"value":1073,"toc":1190},[1074,1077,1083,1087,1113,1116,1120,1134,1138,1164,1167,1171,1176],[10,1075,1071],{"id":1076},"editor-de-temas",[14,1078,1079,1080,484],{},"El Theme Creator es el editor visual completo de tu tablero. Ábrelo desde ",[18,1081,1082],{},"Ajustes → General → Theme Creator",[23,1084,1086],{"id":1085},"tres-pestañas","Tres pestañas",[94,1088,1089,1102,1108],{},[38,1090,1091,1094,1095,147,1098,1101],{},[18,1092,1093],{},"General"," — nombre del tema, colores compartidos y carga de fuentes (",[144,1096,1097],{},".ttf",[144,1099,1100],{},".otf",")",[38,1103,1104,1107],{},[18,1105,1106],{},"Botones"," — colores, tipo, diseño y overlay GIF de los botones de sonido",[38,1109,1110,1112],{},[18,1111,684],{}," — colores, tipo y grosor de borde de la barra de pestañas",[14,1114,1115],{},"Una vista previa en vivo muestra pestañas y botones mientras editas.",[23,1117,1119],{"id":1118},"qué-puedes-cambiar","Qué puedes cambiar",[35,1121,1122,1125,1128,1131],{},[38,1123,1124],{},"Colores primario y de acento, fondos, colores de botones, colores de pestañas",[38,1126,1127],{},"Familia y tamaño de fuente de botones y pestañas",[38,1129,1130],{},"Ancho, radio, borde, huecos y padding de los botones",[38,1132,1133],{},"Opacidad del overlay GIF (normal y hover)",[23,1135,1137],{"id":1136},"guardar-y-compartir","Guardar y compartir",[35,1139,1140,1146,1152,1158],{},[38,1141,1142,1145],{},[18,1143,1144],{},"Exportar .css"," — escribe un archivo de tema para respaldar o enviar a un amigo",[38,1147,1148,1151],{},[18,1149,1150],{},"Añadir a temas"," — guarda el archivo en tu carpeta Themes y aplícalo",[38,1153,1154,1157],{},[18,1155,1156],{},"Importar .css"," — carga un preset integrado o un tema guardado",[38,1159,1160,1163],{},[18,1161,1162],{},"Restablecer"," — vuelve a los valores por defecto de SoundNinja",[14,1165,1166],{},"Si cierras la ventana con cambios sin guardar, SoundNinja te pide que guardes primero.",[23,1168,1170],{"id":1169},"sin-el-editor-completo","Sin el editor completo",[14,1172,29,1173,1175],{},[18,1174,717],{}," aún puedes:",[35,1177,1178,1181,1187],{},[38,1179,1180],{},"Elegir un tema de la lista",[38,1182,1183,1184,1101],{},"Editar variables CSS en vivo (",[18,1185,1186],{},"CSS personalizado",[38,1188,1189],{},"Importar un archivo de tema a la carpeta Themes",{"title":153,"searchDepth":154,"depth":154,"links":1191},[1192,1193,1194,1195],{"id":1085,"depth":154,"text":1086},{"id":1118,"depth":154,"text":1119},{"id":1136,"depth":154,"text":1137},{"id":1169,"depth":154,"text":1170},"Diseña colores, fuentes, botones y pestañas en el Theme Creator.",{},5,"\u002Ftheme-editor",{"title":1071,"description":1196},"theme-editor","bPcJP7OLtBsnNMYJ-S1J6DmB6nngULo1_Q1hBJMNZAQ",{"id":4,"title":5,"body":1204,"description":160,"extension":161,"meta":1296,"navigation":163,"order":164,"path":165,"seo":1297,"stem":167,"__hash__":168},{"type":7,"value":1205,"toc":1290},[1206,1208,1212,1214,1218,1232,1234,1236,1254,1256,1268,1270,1278,1284],[10,1207,5],{"id":12},[14,1209,16,1210,21],{},[18,1211,20],{},[23,1213,26],{"id":25},[14,1215,29,1216,33],{},[18,1217,32],{},[35,1219,1220,1224,1228],{},[38,1221,1222,43],{},[18,1223,42],{},[38,1225,1226,49],{},[18,1227,48],{},[38,1229,1230,55],{},[18,1231,54],{},[14,1233,58],{},[23,1235,62],{"id":61},[35,1237,1238,1240,1242,1248,1250,1252],{},[38,1239,67],{},[38,1241,70],{},[38,1243,1244,76,1246],{},[18,1245,75],{},[18,1247,79],{},[38,1249,82],{},[38,1251,85],{},[38,1253,88],{},[23,1255,92],{"id":91},[94,1257,1258,1260,1262],{},[38,1259,98],{},[38,1261,101],{},[38,1263,1264,76,1266,110],{},[18,1265,106],{},[18,1267,109],{},[23,1269,114],{"id":113},[14,1271,117,1272,121,1274,76,1276,128],{},[18,1273,120],{},[18,1275,124],{},[18,1277,127],{},[14,1279,131,1280,135,1282,139],{},[18,1281,134],{},[18,1283,138],{},[14,1285,142,1286,147,1288,151],{},[144,1287,146],{},[144,1289,150],{},{"title":153,"searchDepth":154,"depth":154,"links":1291},[1292,1293,1294,1295],{"id":25,"depth":154,"text":26},{"id":61,"depth":154,"text":62},{"id":91,"depth":154,"text":92},{"id":113,"depth":154,"text":114},{},{"title":5,"description":160},{"id":1299,"title":1300,"body":1301,"description":1513,"extension":161,"meta":1514,"navigation":163,"order":1515,"path":1516,"seo":1517,"stem":1518,"__hash__":1519},"content_es\u002Fremote-control.md","Control remoto",{"type":7,"value":1302,"toc":1506},[1303,1306,1309,1313,1342,1345,1348,1383,1387,1407,1410,1414,1446,1450,1456],[10,1304,1300],{"id":1305},"control-remoto",[14,1307,1308],{},"SoundNinja puede escuchar en tu red local para que Bitfocus Companion (o cualquier cliente HTTP\u002FWebSocket) reproduzca y detenga sonidos.",[23,1310,1312],{"id":1311},"activar-el-servidor-remoto","Activar el servidor remoto",[94,1314,1315,1320,1326,1332],{},[38,1316,541,1317,484],{},[18,1318,1319],{},"Ajustes → Remoto",[38,1321,1322,1323,484],{},"Activa el servidor remoto. El puerto por defecto es ",[18,1324,1325],{},"7331",[38,1327,1328,1329,484],{},"Opcional: define un token. Los clientes deben enviarlo como Bearer token o ",[144,1330,1331],{},"?token=",[38,1333,1334,1335,1338,1339,484],{},"Copia la URL ",[144,1336,1337],{},"http:\u002F\u002FIP:PORT",", o copia la IP del sistema desde ",[18,1340,1341],{},"Ajustes → Acerca de",[14,1343,1344],{},"Windows puede mostrar un aviso del firewall la primera vez que arranca el servidor. Permite el acceso a la red privada.",[23,1346,242],{"id":1347},"bitfocus-companion",[94,1349,1350,1357,1366,1376],{},[38,1351,1352,1353,484],{},"Instala ",[239,1354,242],{"href":1355,"rel":1356},"https:\u002F\u002Fbitfocus.io\u002Fcompanion",[260],[38,1358,1359,1360,1365],{},"Descarga ",[239,1361,1364],{"href":1362,"rel":1363},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002Fcompanion-module-soundninja\u002Freleases\u002Flatest",[260],"SoundNinja-Companion.tgz",". Aún no hay paquete en Companion Store.",[38,1367,1368,1369,1372,1373,484],{},"En Companion: ",[18,1370,1371],{},"Modules → Load module packag