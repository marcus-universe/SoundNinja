[{"data":1,"prerenderedAt":1336},["ShallowReactive",2],{"docs-page-es-\u002Frecording-editor":3,"docs-nav-es":165},{"id":4,"title":5,"body":6,"description":156,"extension":157,"meta":158,"navigation":159,"order":160,"path":161,"seo":162,"stem":163,"__hash__":164},"content_es\u002Frecording-editor.md","Editor de grabación",{"type":7,"value":8,"toc":148},"minimark",[9,13,22,27,34,56,59,63,89,93,111,115,129,136],[10,11,5],"h1",{"id":12},"editor-de-grabación",[14,15,16,17,21],"p",{},"Graba un clip dentro de SoundNinja, recórtalo e impórtalo a una pestaña. Abre el editor con el botón ",[18,19,20],"strong",{},"Grabar"," en la barra del reproductor.",[23,24,26],"h2",{"id":25},"elegir-una-entrada","Elegir una entrada",[14,28,29,30,33],{},"En ",[18,31,32],{},"Ajustes → Audio",":",[35,36,37,44,50],"ul",{},[38,39,40,43],"li",{},[18,41,42],{},"Dispositivos de entrada"," — micrófono",[38,45,46,49],{},[18,47,48],{},"Dispositivos de salida (audio del PC)"," — loopback de lo que reproduce el PC",[38,51,52,55],{},[18,53,54],{},"Volumen de entrada"," — ganancia de captura del 0 % al 200 %",[14,57,58],{},"El botón Grabar usa el dispositivo que eliges aquí.",[23,60,62],{"id":61},"editar-la-toma","Editar la toma",[35,64,65,68,71,80,83,86],{},[38,66,67],{},"Grabar y detener",[38,69,70],{},"Observar el medidor de nivel de entrada",[38,72,73,76,77],{},[18,74,75],{},"Normalizar"," o ",[18,78,79],{},"Cancelación de ruido",[38,81,82],{},"Recortar todo el clip, recortar a una selección o borrar una selección",[38,84,85],{},"Deshacer \u002F rehacer",[38,87,88],{},"Acercar y alejar",[23,90,92],{"id":91},"preparar-e-importar","Preparar e importar",[94,95,96,99,102],"ol",{},[38,97,98],{},"Añade la selección o la pista completa a la lista de staging.",[38,100,101],{},"La lista empieza vacía: graba, edita y luego añade un clip.",[38,103,104,76,107,110],{},[18,105,106],{},"Importar selección",[18,108,109],{},"Importar todo"," en la pestaña actual o en una pestaña que elijas.",[23,112,114],{"id":113},"separación-de-stems-opcional","Separación de stems (opcional)",[14,116,117,118,76,121,124,125,128],{},"El Record Editor puede conservar ",[18,119,120],{},"voces",[18,122,123],{},"música"," con BS-RoFormer. El modelo pesa unos 158 MB y ",[18,126,127],{},"no"," viene incluido con la app.",[14,130,131,132,135],{},"Descárgalo desde ",[18,133,134],{},"Ajustes → Separación de stems",", o acepta el aviso del primer arranque. El instalador de Windows también puede ofrecer descargar el modelo al primer inicio.",[14,137,138,139,143,144,147],{},"Las builds desde código con stems necesitan un flag extra (",[140,141,142],"code",{},"tauri:serve:stems"," \u002F ",[140,145,146],{},"tauri:build:stems",").",{"title":149,"searchDepth":150,"depth":150,"links":151},"",2,[152,153,154,155],{"id":25,"depth":150,"text":26},{"id":61,"depth":150,"text":62},{"id":91,"depth":150,"text":92},{"id":113,"depth":150,"text":114},"Captura micrófono o audio del PC, edita el clip y suéltalo en tu tablero.","md",{},true,6,"\u002Frecording-editor",{"title":5,"description":156},"recording-editor","6kXc1zcNP9ffTeowsG3fPS8NGId-wyGEWWxVXslWkZE",[166,287,486,630,786,920,1013,1238],{"id":167,"title":168,"body":169,"description":280,"extension":157,"meta":281,"navigation":159,"order":282,"path":283,"seo":284,"stem":285,"__hash__":286},"content_es\u002Foverview.md","Resumen",{"type":7,"value":170,"toc":274},[171,174,177,180,183,187,201,205,236,240,250,254],[10,172,168],{"id":173},"resumen",[14,175,176],{},"SoundNinja es un soundboard de código abierto para streaming en directo, charlas con amigos y grabación de podcasts. Está construido con Tauri v2 y Nuxt 4 para que sea ligero en RAM y disco.",[14,178,179],{},"El objetivo es simple: mantener una biblioteca enorme fácil de recorrer y reproducir el clip correcto en milisegundos. La interfaz también funciona bien como panel en VR.",[14,181,182],{},"SoundNinja sigue en desarrollo temprano. Las funciones marchan, pero no todas las plataformas están del todo probadas.",[23,184,186],{"id":185},"para-quién","Para quién",[35,188,189,192,195,198],{},[38,190,191],{},"Streamers que necesitan cues de sonido al instante",[38,193,194],{},"Amigos que quieren un tablero compartido para el chat de voz",[38,196,197],{},"Podcasters que graban clips y los sueltan en un tablero",[38,199,200],{},"Quien quiera un soundboard personalizable y local-first",[23,202,204],{"id":203},"qué-puedes-hacer","Qué puedes hacer",[35,206,207,210,213,216,219,222,230,233],{},[38,208,209],{},"Montar un soundboard con tus propios archivos de audio",[38,211,212],{},"Organizar sonidos en pestañas de colores, grupos y búsqueda",[38,214,215],{},"Diseñar el aspecto con el Theme Creator",[38,217,218],{},"Grabar audio del PC o un micrófono en el Record Editor",[38,220,221],{},"Asignar atajos a sonidos individuales",[38,223,224,225],{},"Disparar sonidos desde ",[226,227,229],"a",{"href":228},"\u002Fdocs\u002Fremote-control","Bitfocus Companion",[38,231,232],{},"Importar y exportar un soundboard completo para compartirlo",[38,234,235],{},"Usar GIFs o imágenes en los botones de sonido",[23,237,239],{"id":238},"licencia","Licencia",[14,241,242,243,249],{},"SoundNinja es software libre bajo ",[226,244,248],{"href":245,"rel":246},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fblob\u002Fmain\u002FLICENSE",[247],"nofollow","GPL-3.0",". Haz fork, cámbialo, compártelo.",[23,251,253],{"id":252},"siguientes-pasos","Siguientes pasos",[94,255,256,262,268],{},[38,257,258],{},[226,259,261],{"href":260},"\u002Fdocs\u002Finstallation","Instalar SoundNinja",[38,263,264],{},[226,265,267],{"href":266},"\u002Fdocs\u002Fadding-sounds","Añadir sonidos",[38,269,270],{},[226,271,273],{"href":272},"\u002Fdocs\u002Forganizing-sounds","Organizar tu tablero",{"title":149,"searchDepth":150,"depth":150,"links":275},[276,277,278,279],{"id":185,"depth":150,"text":186},{"id":203,"depth":150,"text":204},{"id":238,"depth":150,"text":239},{"id":252,"depth":150,"text":253},"Qué es SoundNinja y qué puedes hacer con él.",{},1,"\u002Foverview",{"title":168,"description":280},"overview","_jbFAqK9Ea28XfzNs3a2S9mJrWOMez_Uxtm9qlYTevc",{"id":288,"title":289,"body":290,"description":480,"extension":157,"meta":481,"navigation":159,"order":150,"path":482,"seo":483,"stem":484,"__hash__":485},"content_es\u002Finstallation.md","Instalación",{"type":7,"value":291,"toc":473},[292,295,309,313,330,333,337,351,354,358,382,393,397,404,408,423,453,469],[10,293,289],{"id":294},"instalación",[14,296,297,298,302,303,308],{},"Consigue una build en la ",[226,299,301],{"href":300},"\u002Fdownload","página de descarga"," o en ",[226,304,307],{"href":305,"rel":306},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Freleases\u002Flatest",[247],"GitHub Releases",". SoundNinja está en desarrollo temprano, así que trata las builds como beta.",[23,310,312],{"id":311},"windows","Windows",[35,314,315,324,327],{},[38,316,317,76,320,323],{},[18,318,319],{},"Instalador (.exe)",[18,321,322],{},"MSI (.msi)"," para Windows de 64 bits",[38,325,326],{},"Objetivo de la landing: Windows 10 y posterior",[38,328,329],{},"El README de la app también lista Windows 8 y superior",[14,331,332],{},"Ejecuta el instalador y luego abre SoundNinja desde el menú Inicio.",[23,334,336],{"id":335},"macos","macOS",[35,338,339,345,348],{},[38,340,341,344],{},[18,342,343],{},".dmg universal"," para Apple Silicon e Intel",[38,346,347],{},"Objetivo de la landing: macOS 10.14 y posterior",[38,349,350],{},"El README de la app lista macOS 10.15 y superior",[14,352,353],{},"Abre la imagen de disco y arrastra SoundNinja a Aplicaciones.",[23,355,357],{"id":356},"linux","Linux",[35,359,360,366,372,379],{},[38,361,362,365],{},[18,363,364],{},"Debian (.deb)"," para Ubuntu \u002F Debian",[38,367,368,371],{},[18,369,370],{},"AppImage"," para otras distros",[38,373,374,375,378],{},"Tras publicar una release, los usuarios de Arch pueden instalar ",[140,376,377],{},"soundninja-bin"," desde el AUR",[38,380,381],{},"Probado en Ubuntu 20.04",[14,383,384,385,388,389,392],{},"Las builds de escritorio necesitan paquetes WebKit y GTK. En Debian\u002FUbuntu eso suele ser ",[140,386,387],{},"libwebkit2gtk",", ",[140,390,391],{},"libgtk-3-0"," y una biblioteca app-indicator.",[23,394,396],{"id":395},"actualizaciones","Actualizaciones",[14,398,399,400,403],{},"En la app, abre ",[18,401,402],{},"Ayuda → Buscar actualizaciones",". También puedes dejar que SoundNinja compruebe al arrancar en Ajustes.",[23,405,407],{"id":406},"compilar-desde-el-código","Compilar desde el código",[14,409,410,411,416,417,422],{},"¿Necesitas una build personalizada? Clona ",[226,412,415],{"href":413,"rel":414},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja",[247],"el repo",", instala los ",[226,418,421],{"href":419,"rel":420},"https:\u002F\u002Fv2.tauri.app\u002Fstart\u002Fprerequisites\u002F",[247],"requisitos de Tauri"," y luego:",[424,425,429],"pre",{"className":426,"code":427,"language":428,"meta":149,"style":149},"language-bash shiki shiki-themes github-light github-dark","bun install\nbun run tauri:serve\n","bash",[140,430,431,443],{"__ignoreMap":149},[432,433,435,439],"span",{"class":434,"line":282},"line",[432,436,438],{"class":437},"sScJk","bun",[432,440,442],{"class":441},"sZZnC"," install\n",[432,444,445,447,450],{"class":434,"line":150},[432,446,438],{"class":437},[432,448,449],{"class":441}," run",[432,451,452],{"class":441}," tauri:serve\n",[14,454,455,388,458,76,461,464,465,468],{},[140,456,457],{},"npm",[140,459,460],{},"pnpm",[140,462,463],{},"deno"," también sirven. Build de producción: ",[140,466,467],{},"bun run tauri:build",".",[470,471,472],"style",{},"html pre.shiki code .sScJk, html code.shiki .sScJk{--shiki-default:#6F42C1;--shiki-dark:#B392F0}html pre.shiki code .sZZnC, html code.shiki .sZZnC{--shiki-default:#032F62;--shiki-dark:#9ECBFF}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html.dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}",{"title":149,"searchDepth":150,"depth":150,"links":474},[475,476,477,478,479],{"id":311,"depth":150,"text":312},{"id":335,"depth":150,"text":336},{"id":356,"depth":150,"text":357},{"id":395,"depth":150,"text":396},{"id":406,"depth":150,"text":407},"Instala SoundNinja en Windows, macOS o Linux.",{},"\u002Finstallation",{"title":289,"description":480},"installation","DZ0nnkuNJ5bWc2nnZMQjtBcj72EEzzogekGEbJUmx80",{"id":487,"title":267,"body":488,"description":623,"extension":157,"meta":624,"navigation":159,"order":625,"path":626,"seo":627,"stem":628,"__hash__":629},"content_es\u002Fadding-sounds.md",{"type":7,"value":489,"toc":615},[490,493,496,500,519,523,554,558,573,577,591,594,598,605,609],[10,491,267],{"id":492},"añadir-sonidos",[14,494,495],{},"Un tablero está vacío hasta que añades clips. SoundNinja puede importar archivos, carpetas enteras, una grabación o un pack de soundboard compartido.",[23,497,499],{"id":498},"importar-archivos-de-audio","Importar archivos de audio",[94,501,502,513,516],{},[38,503,504,505,508,509,512],{},"Abre ",[18,506,507],{},"Archivo → Importar archivos de audio",", o usa ",[18,510,511],{},"Importar"," en la barra de navegación.",[38,514,515],{},"Elige uno o más archivos de audio.",[38,517,518],{},"Los sonidos llegan a la pestaña actual.",[23,520,522],{"id":521},"importar-carpetas","Importar carpetas",[94,524,525,534,537],{},[38,526,504,527,530,531,533],{},[18,528,529],{},"Archivo → Importar carpetas"," (o ",[18,532,522],{}," en la barra de navegación).",[38,535,536],{},"Añade una o más carpetas. Arrastra para reordenarlas antes de importar.",[38,538,539,540],{},"Elige cómo llegan:\n",[35,541,542,548],{},[38,543,544,547],{},[18,545,546],{},"Importar como pestañas"," — cada carpeta se convierte en su propia pestaña",[38,549,550,553],{},[18,551,552],{},"Importar a la pestaña actual"," — cada archivo va a la pestaña activa",[23,555,557],{"id":556},"grabar-un-clip","Grabar un clip",[14,559,560,561,565,566,568,569,76,571,110],{},"Abre el ",[226,562,564],{"href":563},"\u002Fdocs\u002Frecording-editor","Record Editor"," desde el botón ",[18,567,20],{}," en la barra del reproductor. Captura, recorta y luego ",[18,570,106],{},[18,572,109],{},[23,574,576],{"id":575},"importar-un-soundboard","Importar un soundboard",[14,578,579,582,583,586,587,590],{},[18,580,581],{},"Archivo → Importar soundboard"," carga un pack compartido. Los packs son un ",[140,584,585],{},".zip"," que contiene ",[140,588,589],{},"project.sninja"," más los archivos de sonido. Tras importar, abre el proyecto y reproduce.",[14,592,593],{},"También puedes tener varios proyectos (perfiles). Usa el selector de proyecto para cambiar de tablero.",[23,595,597],{"id":596},"reenlazar-archivos-faltantes","Reenlazar archivos faltantes",[14,599,600,601,604],{},"Si los archivos de audio se mueven en el disco, SoundNinja muestra ",[18,602,603],{},"Archivos de sonido faltantes",". Elige una carpeta para buscar y reenlazar los clips.",[23,606,608],{"id":607},"siguiente","Siguiente",[14,610,611,612,468],{},"Organiza pestañas, grupos y atajos en ",[226,613,614],{"href":272},"Organizar sonidos",{"title":149,"searchDepth":150,"depth":150,"links":616},[617,618,619,620,621,622],{"id":498,"depth":150,"text":499},{"id":521,"depth":150,"text":522},{"id":556,"depth":150,"text":557},{"id":575,"depth":150,"text":576},{"id":596,"depth":150,"text":597},{"id":607,"depth":150,"text":608},"Importa audio, carpetas, grabaciones y soundboards compartidos.",{},3,"\u002Fadding-sounds",{"title":267,"description":623},"adding-sounds","Pp2z7pkBymoeTp058Pu8gOujI6GqQLoQ-Go0ZA2L1F4",{"id":631,"title":614,"body":632,"description":779,"extension":157,"meta":780,"navigation":159,"order":781,"path":782,"seo":783,"stem":784,"__hash__":785},"content_es\u002Forganizing-sounds.md",{"type":7,"value":633,"toc":770},[634,637,640,644,671,678,682,685,699,706,710,717,721,732,736,739,743,746,752,758,762],[10,635,614],{"id":636},"organizar-sonidos",[14,638,639],{},"SoundNinja está hecho para bibliotecas grandes. Usa pestañas, grupos, búsqueda y atajos para que el clip que necesitas esté a un clic (o una tecla) de distancia.",[23,641,643],{"id":642},"pestañas","Pestañas",[35,645,646,653,660],{},[38,647,648,649,652],{},"Añade una pestaña con ",[18,650,651],{},"Añadir pestaña",". Dale un color para escanear la barra rápido.",[38,654,655,656,659],{},"La vista ",[18,657,658],{},"Todos"," muestra cada sonido de todas las pestañas.",[38,661,662,663,666,667,670],{},"Un sonido puede pertenecer a ",[18,664,665],{},"una o más pestañas",". Clic derecho en un sonido y usa ",[18,668,669],{},"Mover a pestaña"," para asignarlo.",[14,672,673,674,677],{},"Las transiciones de pestaña están en ",[18,675,676],{},"Ajustes → General",": Slide, Fade, Botones uno a uno, o Ninguna.",[23,679,681],{"id":680},"grupos","Grupos",[14,683,684],{},"Desde la v0.5.3, los separadores pueden convertirse en grupos con nombre:",[35,686,687,690,693,696],{},[38,688,689],{},"Añadir, renombrar o quitar un grupo desde el menú contextual",[38,691,692],{},"Arrastra la cabecera del grupo — los hijos se mueven con ella",[38,694,695],{},"Suelta sonidos dentro o fuera de un grupo",[38,697,698],{},"Define color de borde, color del nombre y alineación de botones (o usa el valor por defecto de la pestaña)",[14,700,701,702,705],{},"Sigue pudiendo añadir un ",[18,703,704],{},"Separador"," simple si solo necesitas un corte visual.",[23,707,709],{"id":708},"búsqueda","Búsqueda",[14,711,712,713,716],{},"Usa el campo ",[18,714,715],{},"Buscar"," en la barra de navegación. Los resultados se actualizan mientras escribes.",[23,718,720],{"id":719},"reordenar","Reordenar",[14,722,723,724,727,728,731],{},"Activa arrastrar y soltar en ",[18,725,726],{},"Ajustes → Comportamiento"," (",[18,729,730],{},"Permitir reordenar","). Luego arrastra sonidos y grupos a su sitio.",[23,733,735],{"id":734},"edición-masiva","Edición masiva",[14,737,738],{},"Selecciona varios sonidos y cambia el color, muévelos a una pestaña o elimínalos de una vez.",[23,740,742],{"id":741},"atajos-e-ids-de-sonido","Atajos e IDs de sonido",[14,744,745],{},"Cada sonido tiene un ID de 8 caracteres. Cópialo desde el menú contextual del botón o el chip de ID de la selección múltiple.",[14,747,504,748,751],{},[18,749,750],{},"Ajustes → Atajos"," para vincular una tecla a un ID de sonido. Los atajos globales son opcionales.",[14,753,754,755,757],{},"El mismo ID es el que ",[226,756,229],{"href":228}," usa para disparar un clip.",[23,759,761],{"id":760},"gifs-y-colores","GIFs y colores",[14,763,764,765,769],{},"Clic derecho en un sonido para definir colores por botón o un fondo GIF \u002F imagen. Eso es independiente del ",[226,766,768],{"href":767},"\u002Fdocs\u002Ftheme-editor","Theme Creator",", que da estilo a todo el tablero.",{"title":149,"searchDepth":150,"depth":150,"links":771},[772,773,774,775,776,777,778],{"id":642,"depth":150,"text":643},{"id":680,"depth":150,"text":681},{"id":708,"depth":150,"text":709},{"id":719,"depth":150,"text":720},{"id":734,"depth":150,"text":735},{"id":741,"depth":150,"text":742},{"id":760,"depth":150,"text":761},"Pestañas, grupos, búsqueda, edición masiva y atajos.",{},4,"\u002Forganizing-sounds",{"title":614,"description":779},"organizing-sounds","L2-ttc1gCTlJQIkJYckTzh-JzPPPTLU4m0uGjwPApXk",{"id":787,"title":788,"body":789,"description":913,"extension":157,"meta":914,"navigation":159,"order":915,"path":916,"seo":917,"stem":918,"__hash__":919},"content_es\u002Ftheme-editor.md","Editor de temas",{"type":7,"value":790,"toc":907},[791,794,800,804,830,833,837,851,855,881,884,888,893],[10,792,788],{"id":793},"editor-de-temas",[14,795,796,797,468],{},"El Theme Creator es el editor visual completo de tu tablero. Ábrelo desde ",[18,798,799],{},"Ajustes → General → Theme Creator",[23,801,803],{"id":802},"tres-pestañas","Tres pestañas",[94,805,806,819,825],{},[38,807,808,811,812,143,815,818],{},[18,809,810],{},"General"," — nombre del tema, colores compartidos y carga de fuentes (",[140,813,814],{},".ttf",[140,816,817],{},".otf",")",[38,820,821,824],{},[18,822,823],{},"Botones"," — colores, tipo, diseño y overlay GIF de los botones de sonido",[38,826,827,829],{},[18,828,643],{}," — colores, tipo y grosor de borde de la barra de pestañas",[14,831,832],{},"Una vista previa en vivo muestra pestañas y botones mientras editas.",[23,834,836],{"id":835},"qué-puedes-cambiar","Qué puedes cambiar",[35,838,839,842,845,848],{},[38,840,841],{},"Colores primario y de acento, fondos, colores de botones, colores de pestañas",[38,843,844],{},"Familia y tamaño de fuente de botones y pestañas",[38,846,847],{},"Ancho, radio, borde, huecos y padding de los botones",[38,849,850],{},"Opacidad del overlay GIF (normal y hover)",[23,852,854],{"id":853},"guardar-y-compartir","Guardar y compartir",[35,856,857,863,869,875],{},[38,858,859,862],{},[18,860,861],{},"Exportar .css"," — escribe un archivo de tema para respaldar o enviar a un amigo",[38,864,865,868],{},[18,866,867],{},"Añadir a temas"," — guarda el archivo en tu carpeta Themes y aplícalo",[38,870,871,874],{},[18,872,873],{},"Importar .css"," — carga un preset integrado o un tema guardado",[38,876,877,880],{},[18,878,879],{},"Restablecer"," — vuelve a los valores por defecto de SoundNinja",[14,882,883],{},"Si cierras la ventana con cambios sin guardar, SoundNinja te pide que guardes primero.",[23,885,887],{"id":886},"sin-el-editor-completo","Sin el editor completo",[14,889,29,890,892],{},[18,891,676],{}," aún puedes:",[35,894,895,898,904],{},[38,896,897],{},"Elegir un tema de la lista",[38,899,900,901,818],{},"Editar variables CSS en vivo (",[18,902,903],{},"CSS personalizado",[38,905,906],{},"Importar un archivo de tema a la carpeta Themes",{"title":149,"searchDepth":150,"depth":150,"links":908},[909,910,911,912],{"id":802,"depth":150,"text":803},{"id":835,"depth":150,"text":836},{"id":853,"depth":150,"text":854},{"id":886,"depth":150,"text":887},"Diseña colores, fuentes, botones y pestañas en el Theme Creator.",{},5,"\u002Ftheme-editor",{"title":788,"description":913},"theme-editor","bPcJP7OLtBsnNMYJ-S1J6DmB6nngULo1_Q1hBJMNZAQ",{"id":4,"title":5,"body":921,"description":156,"extension":157,"meta":1011,"navigation":159,"order":160,"path":161,"seo":1012,"stem":163,"__hash__":164},{"type":7,"value":922,"toc":1005},[923,925,929,931,935,949,951,953,971,973,985,987,995,999],[10,924,5],{"id":12},[14,926,16,927,21],{},[18,928,20],{},[23,930,26],{"id":25},[14,932,29,933,33],{},[18,934,32],{},[35,936,937,941,945],{},[38,938,939,43],{},[18,940,42],{},[38,942,943,49],{},[18,944,48],{},[38,946,947,55],{},[18,948,54],{},[14,950,58],{},[23,952,62],{"id":61},[35,954,955,957,959,965,967,969],{},[38,956,67],{},[38,958,70],{},[38,960,961,76,963],{},[18,962,75],{},[18,964,79],{},[38,966,82],{},[38,968,85],{},[38,970,88],{},[23,972,92],{"id":91},[94,974,975,977,979],{},[38,976,98],{},[38,978,101],{},[38,980,981,76,983,110],{},[18,982,106],{},[18,984,109],{},[23,986,114],{"id":113},[14,988,117,989,76,991,124,993,128],{},[18,990,120],{},[18,992,123],{},[18,994,127],{},[14,996,131,997,135],{},[18,998,134],{},[14,1000,138,1001,143,1003,147],{},[140,1002,142],{},[140,1004,146],{},{"title":149,"searchDepth":150,"depth":150,"links":1006},[1007,1008,1009,1010],{"id":25,"depth":150,"text":26},{"id":61,"depth":150,"text":62},{"id":91,"depth":150,"text":92},{"id":113,"depth":150,"text":114},{},{"title":5,"description":156},{"id":1014,"title":1015,"body":1016,"description":1231,"extension":157,"meta":1232,"navigation":159,"order":1233,"path":1234,"seo":1235,"stem":1236,"__hash__":1237},"content_es\u002Fremote-control.md","Control remoto",{"type":7,"value":1017,"toc":1224},[1018,1021,1024,1028,1057,1060,1063,1101,1105,1125,1128,1132,1164,1168,1174],[10,1019,1015],{"id":1020},"control-remoto",[14,1022,1023],{},"SoundNinja puede escuchar en tu red local para que Bitfocus Companion (o cualquier cliente HTTP\u002FWebSocket) reproduzca y detenga sonidos.",[23,1025,1027],{"id":1026},"activar-el-servidor-remoto","Activar el servidor remoto",[94,1029,1030,1035,1041,1047],{},[38,1031,504,1032,468],{},[18,1033,1034],{},"Ajustes → Remoto",[38,1036,1037,1038,468],{},"Activa el servidor remoto. El puerto por defecto es ",[18,1039,1040],{},"7331",[38,1042,1043,1044,468],{},"Opcional: define un token. Los clientes deben enviarlo como Bearer token o ",[140,1045,1046],{},"?token=",[38,1048,1049,1050,1053,1054,468],{},"Copia la URL ",[140,1051,1052],{},"http:\u002F\u002FIP:PORT",", o copia la IP del sistema desde ",[18,1055,1056],{},"Ajustes → Acerca de",[14,1058,1059],{},"Windows puede mostrar un aviso del firewall la primera vez que arranca el servidor. Permite el acceso a la red privada.",[23,1061,229],{"id":1062},"bitfocus-companion",[94,1064,1065,1072,1081,1088,1094],{},[38,1066,1067,1068,468],{},"Instala ",[226,1069,229],{"href":1070,"rel":1071},"https:\u002F\u002Fbitfocus.io\u002Fcompanion",[247],[38,1073,1074,1075,1080],{},"Descarga el módulo SoundNinja desde la carpeta oficial: ",[226,1076,1079],{"href":1077,"rel":1078},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Ftree\u002Fmain\u002Fcompanion-module-soundninja",[247],"companion-module-soundninja",". Aún no hay paquete en Companion Store — esta carpeta es la descarga.",[38,1082,1083,1084,1087],{},"En Companion abre ",[18,1085,1086],{},"Developer → Modules",", o suelta la carpeta en la ruta de módulos personalizados de Companion.",[38,1089,1090,1091,468],{},"En la carpeta del módulo ejecuta ",[140,1092,1093],{},"npm install",[38,1095,1096,1097,1100],{},"Añade una conexión ",[18,1098,1099],{},"Sound Ninja",". Pega la IP del PC, el puerto y el token si definiste uno.",[23,1102,1104],{"id":1103},"acciones","Acciones",[35,1106,1107,1113,1119],{},[38,1108,1109,1112],{},[18,1110,1111],{},"Trigger Sound"," — elige en el menú desplegable en vivo, o escribe un ID de sonido de 8 caracteres (las variables de Companion funcionan)",[38,1114,1115,1118],{},[18,1116,1117],{},"Stop Sound"," — detiene un sonido en reproducción por ID",[38,1120,1121,1124],{},[18,1122,1123],{},"Stop All"," — detiene todos los sonidos en reproducción",[14,1126,1127],{},"Copia un ID de sonido en SoundNinja desde el menú contextual del botón o el chip de ID de la selección múltiple.",[23,1129,1131],{"id":1130},"feedbacks-y-variables","Feedbacks y variables",[35,1133,1134,1140,1152,1158],{},[38,1135,1136,1139],{},[18,1137,1138],{},"Sound Playing"," — verdadero mientras ese ID de sonido está activo (úsalo para el color del botón)",[38,1141,1142,1145,1146,143,1149],{},[140,1143,1144],{},"$(soundninja:connected)"," — ",[140,1147,1148],{},"true",[140,1150,1151],{},"false",[38,1153,1154,1157],{},[140,1155,1156],{},"$(soundninja:playing_count)"," — cuántos sonidos suenan",[38,1159,1160,1163],{},[140,1161,1162],{},"$(soundninja:last_triggered)"," — último ID de sonido disparado",[23,1165,1167],{"id":1166},"api-http-avanzado","API HTTP (avanzado)",[14,1169,1170,1171],{},"Ruta base: ",[140,1172,1173],{},"\u002Fapi\u002Fv1",[35,1175,1176,1182,1188,1194,1204,1210,1218],{},[38,1177,1178,1181],{},[140,1179,1180],{},"GET \u002Finfo"," — nombre de la app, versión, protocolo, si se requiere un token",[38,1183,1184,1187],{},[140,1185,1186],{},"GET \u002Fsounds"," — lista de sonidos (id, name, tabs, active)",[38,1189,1190,1193],{},[140,1191,1192],{},"GET \u002Fstate"," — sonidos más IDs que suenan ahora",[38,1195,1196,1199,1200,1203],{},[140,1197,1198],{},"POST \u002Ftrigger"," con ",[140,1201,1202],{},"{ \"id\" }"," — reproducir un sonido",[38,1205,1206,1209],{},[140,1207,1208],{},"GET \u002Ftrigger\u002F:id"," — reproducir (fácil de probar en el navegador)",[38,1211,1212,1199,1215,1217],{},[140,1213,1214],{},"POST \u002Fstop",[140,1216,1202],{}," opcional — detener un sonido o todos",[38,1219,1220,1223],{},[140,1221,1222],{},"GET \u002Fws"," — estado en vivo; enviar comandos trigger\u002Fstop de entrada",{"title":149,"searchDepth":150,"depth":150,"links":1225},[1226,1227,1228,1229,1230],{"id":1026,"depth":150,"text":1027},{"id":1062,"depth":150,"text":229},{"id":1103,"depth":150,"text":1104},{"id":1130,"depth":150,"text":1131},{"id":1166,"depth":150,"text":1167},"Dispara SoundNinja desde Bitfocus Companion en la red local.",{},7,"\u002Fremote-control",{"title":1015,"description":1231},"remote-control","80wDgQjcOFBZ-zEcEomn6KPqnTOOWEstkAVGy6tohhY",{"id":1239,"title":1240,"body":1241,"description":1329,"extension":157,"meta":1330,"navigation":159,"order":1331,"path":1332,"seo":1333,"stem":1334,"__hash__":1335},"content_es\u002Fsupport.md","Soporte",{"type":7,"value":1242,"toc":1322},[1243,1246,1249,1253,1256,1263,1271,1275,1282,1284,1297,1301,1312,1316],[10,1244,1240],{"id":1245},"soporte",[14,1247,1248],{},"SoundNinja es un proyecto comunitario en beta temprana. La forma más rápida de pedir ayuda es GitHub.",[23,1250,1252],{"id":1251},"reportar-un-error-o-hacer-una-pregunta","Reportar un error o hacer una pregunta",[14,1254,1255],{},"Abre un issue en GitHub:",[14,1257,1258],{},[226,1259,1262],{"href":1260,"rel":1261},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fissues",[247],"github.com\u002Fmarcus-universe\u002FSoundNinja\u002Fissues",[14,1264,1265,1266,76,1268,1270],{},"Incluye tu SO, la versión de 