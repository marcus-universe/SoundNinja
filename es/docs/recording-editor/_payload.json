[{"data":1,"prerenderedAt":1597},["ShallowReactive",2],{"docs-page-es-\u002Frecording-editor":3,"docs-nav-es":169},{"id":4,"title":5,"body":6,"description":160,"extension":161,"meta":162,"navigation":163,"order":164,"path":165,"seo":166,"stem":167,"__hash__":168},"content_es\u002Frecording-editor.md","Editor de grabación",{"type":7,"value":8,"toc":152},"minimark",[9,13,22,27,34,56,59,63,89,93,111,115,129,140],[10,11,5],"h1",{"id":12},"editor-de-grabación",[14,15,16,17,21],"p",{},"Graba un clip dentro de SoundNinja, recórtalo e impórtalo a una pestaña. Abre el editor con el botón ",[18,19,20],"strong",{},"Grabar"," en la barra del reproductor.",[23,24,26],"h2",{"id":25},"elegir-una-entrada","Elegir una entrada",[14,28,29,30,33],{},"En ",[18,31,32],{},"Ajustes → Audio",":",[35,36,37,44,50],"ul",{},[38,39,40,43],"li",{},[18,41,42],{},"Dispositivos de entrada"," — micrófono",[38,45,46,49],{},[18,47,48],{},"Dispositivos de salida (audio del PC)"," — loopback de lo que reproduce el PC",[38,51,52,55],{},[18,53,54],{},"Volumen de entrada"," — ganancia de captura del 0 % al 200 %",[14,57,58],{},"El botón Grabar usa el dispositivo que eliges aquí.",[23,60,62],{"id":61},"editar-la-toma","Editar la toma",[35,64,65,68,71,80,83,86],{},[38,66,67],{},"Grabar y detener",[38,69,70],{},"Observar el medidor de nivel de entrada",[38,72,73,76,77],{},[18,74,75],{},"Normalizar"," o ",[18,78,79],{},"Cancelación de ruido",[38,81,82],{},"Recortar todo el clip, recortar a una selección o borrar una selección",[38,84,85],{},"Deshacer \u002F rehacer",[38,87,88],{},"Acercar y alejar",[23,90,92],{"id":91},"preparar-e-importar","Preparar e importar",[94,95,96,99,102],"ol",{},[38,97,98],{},"Añade la selección o la pista completa a la lista de staging.",[38,100,101],{},"La lista empieza vacía: graba, edita y luego añade un clip.",[38,103,104,76,107,110],{},[18,105,106],{},"Importar selección",[18,108,109],{},"Importar todo"," en la pestaña actual o en una pestaña que elijas.",[23,112,114],{"id":113},"separación-de-stems-opcional","Separación de stems (opcional)",[14,116,117,118,121,122,76,125,128],{},"Las builds oficiales de Windows, macOS y Linux incluyen la función ",[18,119,120],{},"stems",". El Record Editor puede conservar ",[18,123,124],{},"voces",[18,126,127],{},"música"," con BS-RoFormer.",[14,130,131,132,135,136,139],{},"El modelo pesa unos 158 MB y ",[18,133,134],{},"no"," viene en el instalador. Descárgalo desde ",[18,137,138],{},"Ajustes → Separación de stems",", o acepta el aviso del primer arranque. El instalador de Windows también puede ofrecer descargar el modelo al primer inicio.",[14,141,142,143,147,148,151],{},"Las builds personalizadas desde código necesitan un flag extra (",[144,145,146],"code",{},"tauri:serve:stems"," \u002F ",[144,149,150],{},"tauri:build:stems",").",{"title":153,"searchDepth":154,"depth":154,"links":155},"",2,[156,157,158,159],{"id":25,"depth":154,"text":26},{"id":61,"depth":154,"text":62},{"id":91,"depth":154,"text":92},{"id":113,"depth":154,"text":114},"Captura micrófono o audio del PC, edita el clip y suéltalo en tu tablero.","md",{},true,6,"\u002Frecording-editor",{"title":5,"description":160},"recording-editor","89aDSCp7hE8To2TNFwdWaImQVsHH2-xNcOyltCPP5IY",[170,300,502,646,1048,1182,1277,1499],{"id":171,"title":172,"body":173,"description":293,"extension":161,"meta":294,"navigation":163,"order":295,"path":296,"seo":297,"stem":298,"__hash__":299},"content_es\u002Foverview.md","Resumen",{"type":7,"value":174,"toc":287},[175,178,181,184,187,191,205,209,249,253,263,267],[10,176,172],{"id":177},"resumen",[14,179,180],{},"SoundNinja es un soundboard de código abierto para streaming en directo, charlas con amigos y grabación de podcasts. Está construido con Tauri v2 y Nuxt 4 para que sea ligero en RAM y disco.",[14,182,183],{},"El objetivo es simple: mantener una biblioteca enorme fácil de recorrer y reproducir el clip correcto en milisegundos. La interfaz también funciona bien como panel en VR.",[14,185,186],{},"SoundNinja sigue en desarrollo temprano. Las funciones marchan, pero no todas las plataformas están del todo probadas.",[23,188,190],{"id":189},"para-quién","Para quién",[35,192,193,196,199,202],{},[38,194,195],{},"Streamers que necesitan cues de sonido al instante",[38,197,198],{},"Amigos que quieren un tablero compartido para el chat de voz",[38,200,201],{},"Podcasters que graban clips y los sueltan en un tablero",[38,203,204],{},"Quien quiera un soundboard personalizable y local-first",[23,206,208],{"id":207},"qué-puedes-hacer","Qué puedes hacer",[35,210,211,214,217,220,223,226,229,232,235,243,246],{},[38,212,213],{},"Montar un soundboard con tus propios archivos de audio",[38,215,216],{},"Organizar sonidos en pestañas de colores, grupos, etiquetas y búsqueda",[38,218,219],{},"Filtrar por etiquetas (OR) y ordenar por nombre, fecha, duración o tamaño",[38,221,222],{},"Selección múltiple con marco o rango Mayús, luego color, mover o borrar en lote",[38,224,225],{},"Ajustar el volumen por sonido desde el menú contextual",[38,227,228],{},"Diseñar el aspecto con el Theme Creator",[38,230,231],{},"Grabar audio del PC o un micrófono en el Record Editor",[38,233,234],{},"Asignar atajos a sonidos individuales",[38,236,237,238],{},"Disparar sonidos desde ",[239,240,242],"a",{"href":241},"\u002Fdocs\u002Fremote-control","Bitfocus Companion",[38,244,245],{},"Importar y exportar un soundboard completo para compartirlo",[38,247,248],{},"Usar GIFs o imágenes en los botones — biblioteca local de carpetas o KLIPY",[23,250,252],{"id":251},"licencia","Licencia",[14,254,255,256,262],{},"SoundNinja es software libre bajo ",[239,257,261],{"href":258,"rel":259},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fblob\u002Fmain\u002FLICENSE",[260],"nofollow","GPL-3.0",". Haz fork, cámbialo, compártelo.",[23,264,266],{"id":265},"siguientes-pasos","Siguientes pasos",[94,268,269,275,281],{},[38,270,271],{},[239,272,274],{"href":273},"\u002Fdocs\u002Finstallation","Instalar SoundNinja",[38,276,277],{},[239,278,280],{"href":279},"\u002Fdocs\u002Fadding-sounds","Añadir sonidos",[38,282,283],{},[239,284,286],{"href":285},"\u002Fdocs\u002Forganizing-sounds","Organizar tu tablero",{"title":153,"searchDepth":154,"depth":154,"links":288},[289,290,291,292],{"id":189,"depth":154,"text":190},{"id":207,"depth":154,"text":208},{"id":251,"depth":154,"text":252},{"id":265,"depth":154,"text":266},"Qué es SoundNinja y qué puedes hacer con él.",{},1,"\u002Foverview",{"title":172,"description":293},"overview","XWpBFvtyid6BLXO3HByHppTxfsOo0i7DlSOMew5tq2g",{"id":301,"title":302,"body":303,"description":496,"extension":161,"meta":497,"navigation":163,"order":154,"path":498,"seo":499,"stem":500,"__hash__":501},"content_es\u002Finstallation.md","Instalación",{"type":7,"value":304,"toc":489},[305,308,322,326,346,349,353,367,370,374,398,409,413,420,424,439,469,485],[10,306,302],{"id":307},"instalación",[14,309,310,311,315,316,321],{},"Consigue una build en la ",[239,312,314],{"href":313},"\u002Fdownload","página de descarga"," o en ",[239,317,320],{"href":318,"rel":319},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Freleases\u002Flatest",[260],"GitHub Releases",". SoundNinja está en desarrollo temprano, así que trata las builds como beta.",[23,323,325],{"id":324},"windows","Windows",[35,327,328,337,340,343],{},[38,329,330,76,333,336],{},[18,331,332],{},"Instalador (.exe)",[18,334,335],{},"MSI (.msi)"," para Windows de 64 bits",[38,338,339],{},"Objetivo de la landing: Windows 10 y posterior",[38,341,342],{},"El README de la app también lista Windows 8 y superior",[38,344,345],{},"El instalador NSIS usa tema oscuro. Elige idioma en el setup — SoundNinja lo recuerda en el siguiente arranque.",[14,347,348],{},"Ejecuta el instalador y luego abre SoundNinja desde el menú Inicio.",[23,350,352],{"id":351},"macos","macOS",[35,354,355,361,364],{},[38,356,357,360],{},[18,358,359],{},".dmg universal"," para Apple Silicon e Intel",[38,362,363],{},"Objetivo de la landing: macOS 10.14 y posterior",[38,365,366],{},"El README de la app lista macOS 10.15 y superior",[14,368,369],{},"Abre la imagen de disco y arrastra SoundNinja a Aplicaciones.",[23,371,373],{"id":372},"linux","Linux",[35,375,376,382,388,395],{},[38,377,378,381],{},[18,379,380],{},"Debian (.deb)"," para Ubuntu \u002F Debian",[38,383,384,387],{},[18,385,386],{},"AppImage"," para otras distros",[38,389,390,391,394],{},"Tras publicar una release, los usuarios de Arch pueden instalar ",[144,392,393],{},"soundninja-bin"," desde el AUR",[38,396,397],{},"Probado en Ubuntu 20.04",[14,399,400,401,404,405,408],{},"Las builds de escritorio necesitan paquetes WebKit y GTK. En Debian\u002FUbuntu eso suele ser ",[144,402,403],{},"libwebkit2gtk",", ",[144,406,407],{},"libgtk-3-0"," y una biblioteca app-indicator.",[23,410,412],{"id":411},"actualizaciones","Actualizaciones",[14,414,415,416,419],{},"En la app, abre ",[18,417,418],{},"Ayuda → Buscar actualizaciones",". También puedes dejar que SoundNinja compruebe al arrancar en Ajustes.",[23,421,423],{"id":422},"compilar-desde-el-código","Compilar desde el código",[14,425,426,427,432,433,438],{},"¿Necesitas una build personalizada? Clona ",[239,428,431],{"href":429,"rel":430},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja",[260],"el repo",", instala los ",[239,434,437],{"href":435,"rel":436},"https:\u002F\u002Fv2.tauri.app\u002Fstart\u002Fprerequisites\u002F",[260],"requisitos de Tauri"," y luego:",[440,441,445],"pre",{"className":442,"code":443,"language":444,"meta":153,"style":153},"language-bash shiki shiki-themes github-light github-dark","bun install\nbun run tauri:serve\n","bash",[144,446,447,459],{"__ignoreMap":153},[448,449,451,455],"span",{"class":450,"line":295},"line",[448,452,454],{"class":453},"sScJk","bun",[448,456,458],{"class":457},"sZZnC"," install\n",[448,460,461,463,466],{"class":450,"line":154},[448,462,454],{"class":453},[448,464,465],{"class":457}," run",[448,467,468],{"class":457}," tauri:serve\n",[14,470,471,404,474,76,477,480,481,484],{},[144,472,473],{},"npm",[144,475,476],{},"pnpm",[144,478,479],{},"deno"," también sirven. Build de producción: ",[144,482,483],{},"bun run tauri:build",".",[486,487,488],"style",{},"html pre.shiki code .sScJk, html code.shiki .sScJk{--shiki-default:#6F42C1;--shiki-dark:#B392F0}html pre.shiki code .sZZnC, html code.shiki .sZZnC{--shiki-default:#032F62;--shiki-dark:#9ECBFF}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html.dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}",{"title":153,"searchDepth":154,"depth":154,"links":490},[491,492,493,494,495],{"id":324,"depth":154,"text":325},{"id":351,"depth":154,"text":352},{"id":372,"depth":154,"text":373},{"id":411,"depth":154,"text":412},{"id":422,"depth":154,"text":423},"Instala SoundNinja en Windows, macOS o Linux.",{},"\u002Finstallation",{"title":302,"description":496},"installation","zTwxz-vo_-k3K7RGGSHRG4ObTS6FkM9sbuxQPVMKTtY",{"id":503,"title":280,"body":504,"description":639,"extension":161,"meta":640,"navigation":163,"order":641,"path":642,"seo":643,"stem":644,"__hash__":645},"content_es\u002Fadding-sounds.md",{"type":7,"value":505,"toc":631},[506,509,512,516,535,539,570,574,589,593,607,610,614,621,625],[10,507,280],{"id":508},"añadir-sonidos",[14,510,511],{},"Un tablero está vacío hasta que añades clips. SoundNinja puede importar archivos, carpetas enteras, una grabación o un pack de soundboard compartido.",[23,513,515],{"id":514},"importar-archivos-de-audio","Importar archivos de audio",[94,517,518,529,532],{},[38,519,520,521,524,525,528],{},"Abre ",[18,522,523],{},"Archivo → Importar archivos de audio",", o usa ",[18,526,527],{},"Importar"," en la barra de navegación.",[38,530,531],{},"Elige uno o más archivos de audio.",[38,533,534],{},"Los sonidos llegan a la pestaña actual.",[23,536,538],{"id":537},"importar-carpetas","Importar carpetas",[94,540,541,550,553],{},[38,542,520,543,546,547,549],{},[18,544,545],{},"Archivo → Importar carpetas"," (o ",[18,548,538],{}," en la barra de navegación).",[38,551,552],{},"Añade una o más carpetas. Arrastra para reordenarlas antes de importar.",[38,554,555,556],{},"Elige cómo llegan:\n",[35,557,558,564],{},[38,559,560,563],{},[18,561,562],{},"Importar como pestañas"," — cada carpeta se convierte en su propia pestaña",[38,565,566,569],{},[18,567,568],{},"Importar a la pestaña actual"," — cada archivo va a la pestaña activa",[23,571,573],{"id":572},"grabar-un-clip","Grabar un clip",[14,575,576,577,581,582,584,585,76,587,110],{},"Abre el ",[239,578,580],{"href":579},"\u002Fdocs\u002Frecording-editor","Record Editor"," desde el botón ",[18,583,20],{}," en la barra del reproductor. Captura, recorta y luego ",[18,586,106],{},[18,588,109],{},[23,590,592],{"id":591},"importar-un-soundboard","Importar un soundboard",[14,594,595,598,599,602,603,606],{},[18,596,597],{},"Archivo → Importar soundboard"," carga un pack compartido. Los packs son un ",[144,600,601],{},".zip"," que contiene ",[144,604,605],{},"project.sninja"," más los archivos de sonido. Tras importar, abre el proyecto y reproduce.",[14,608,609],{},"También puedes tener varios proyectos (perfiles). Usa el selector de proyecto para cambiar de tablero.",[23,611,613],{"id":612},"reenlazar-archivos-faltantes","Reenlazar archivos faltantes",[14,615,616,617,620],{},"Si los archivos de audio se mueven en el disco, SoundNinja muestra ",[18,618,619],{},"Archivos de sonido faltantes",". Elige una carpeta para buscar y reenlazar los clips.",[23,622,624],{"id":623},"siguiente","Siguiente",[14,626,627,628,484],{},"Organiza pestañas, etiquetas, filtros y atajos en ",[239,629,630],{"href":285},"Organizar sonidos",{"title":153,"searchDepth":154,"depth":154,"links":632},[633,634,635,636,637,638],{"id":514,"depth":154,"text":515},{"id":537,"depth":154,"text":538},{"id":572,"depth":154,"text":573},{"id":591,"depth":154,"text":592},{"id":612,"depth":154,"text":613},{"id":623,"depth":154,"text":624},"Importa audio, carpetas, grabaciones y soundboards compartidos.",{},3,"\u002Fadding-sounds",{"title":280,"description":639},"adding-sounds","O5nOJGNq2FL6jafUxqoGYNKJDVbb2UrZRjfKpK21LlQ",{"id":647,"title":630,"body":648,"description":1041,"extension":161,"meta":1042,"navigation":163,"order":1043,"path":1044,"seo":1045,"stem":1046,"__hash__":1047},"content_es\u002Forganizing-sounds.md",{"type":7,"value":649,"toc":1026},[650,653,660,664,691,698,702,705,719,726,732,736,746,751,782,786,792,796,829,835,839,842,868,871,875,888,892,898,919,935,942,946,957,960,964,971,981,987,991,999,1006,1023],[10,651,630],{"id":652},"organizar-sonidos",[14,654,655,656,659],{},"SoundNinja está hecho para bibliotecas grandes. ",[18,657,658],{},"Etiquetas y filtros",", pestañas, búsqueda, selección múltiple y atajos — el clip que necesitas está a un clic (o una tecla).",[23,661,663],{"id":662},"pestañas","Pestañas",[35,665,666,673,680],{},[38,667,668,669,672],{},"Añade una pestaña con ",[18,670,671],{},"Añadir pestaña",". Dale un color para escanear la barra rápido.",[38,674,675,676,679],{},"La vista ",[18,677,678],{},"Todos"," muestra cada sonido de todas las pestañas.",[38,681,682,683,686,687,690],{},"Un sonido puede pertenecer a ",[18,684,685],{},"una o más pestañas",". Clic derecho en un sonido y usa ",[18,688,689],{},"Mover a pestaña"," para asignarlo.",[14,692,693,694,697],{},"Las transiciones de pestaña están en ",[18,695,696],{},"Ajustes → General",": Slide, Fade, Botones uno a uno, o Ninguna.",[23,699,701],{"id":700},"grupos","Grupos",[14,703,704],{},"Desde la v0.5.3, los separadores pueden convertirse en grupos con nombre:",[35,706,707,710,713,716],{},[38,708,709],{},"Añadir, renombrar o quitar un grupo desde el menú contextual",[38,711,712],{},"Arrastra la cabecera del grupo — los hijos se mueven con ella",[38,714,715],{},"Suelta sonidos dentro o fuera de un grupo",[38,717,718],{},"Define color de borde, color del nombre y alineación de botones (o usa el valor por defecto de la pestaña)",[14,720,721,722,725],{},"Sigue pudiendo añadir un ",[18,723,724],{},"Separador"," simple si solo necesitas un corte visual.",[14,727,728,729,484],{},"Clic derecho en el espacio vacío del tablero para ",[18,730,731],{},"Añadir grupo",[23,733,735],{"id":734},"etiquetas-filtros","Etiquetas \u002F Filtros",[14,737,738,739,742,743,745],{},"Las etiquetas cruzan las pestañas. El panel ",[18,740,741],{},"Filtro"," (barra lateral ",[18,744,741],{},") es donde las creas y filtras el tablero.",[747,748,750],"h3",{"id":749},"crear-y-editar-etiquetas","Crear y editar etiquetas",[94,752,753,758,768,775],{},[38,754,520,755,757],{},[18,756,741],{}," en la barra lateral.",[38,759,29,760,763,764,767],{},[18,761,762],{},"Etiquetas",", usa ",[18,765,766],{},"Añadir etiqueta"," — nombre y color.",[38,769,770,771,774],{},"Renombra, recolorea o ",[18,772,773],{},"Eliminar etiqueta"," en la misma lista.",[38,776,777,778,781],{},"Si ves ",[18,779,780],{},"Aún no hay etiquetas",", crea una aquí antes de asignar.",[747,783,785],{"id":784},"asignar-etiquetas-a-sonidos","Asignar etiquetas a sonidos",[14,787,788,789,791],{},"Clic derecho en un sonido → ",[18,790,762],{}," (casillas). Un sonido puede tener varias. Si aún no hay ninguna, el menú te lleva al panel de filtro.",[747,793,795],{"id":794},"filtrar-el-tablero","Filtrar el tablero",[35,797,798,804,815,826],{},[38,799,800,801,484],{},"Activa etiquetas en el panel Filtro o como ",[18,802,803],{},"chips bajo la barra de búsqueda",[38,805,806,807,810,811,814],{},"La coincidencia es ",[18,808,809],{},"OR",": un sonido sigue visible si tiene ",[18,812,813],{},"cualquiera"," de las etiquetas seleccionadas.",[38,816,817,818,821,822,825],{},"El campo ",[18,819,820],{},"Buscar"," combina con ",[18,823,824],{},"AND"," el filtro de etiquetas activo (texto + etiquetas juntos).",[38,827,828],{},"Apaga los chips (o limpia el filtro) para ver de nuevo toda la pestaña.",[14,830,831,832,484],{},"Los nombres de etiqueta en color pueden aparecer en los botones. Actívalos en ",[18,833,834],{},"Ajustes → Comportamiento → Mostrar badges de etiquetas",[23,836,838],{"id":837},"orden","Orden",[14,840,841],{},"Abre el panel de filtro y elige un modo:",[35,843,844,850],{},[38,845,846,849],{},[18,847,848],{},"Definido por el usuario"," — tu orden de pestaña, grupos visibles",[38,851,852,404,855,404,858,76,861,864,865],{},[18,853,854],{},"Nombre",[18,856,857],{},"Fecha de añadido",[18,859,860],{},"Tiempo de reproducción",[18,862,863],{},"Tamaño de archivo"," — lista plana ordenada; ",[18,866,867],{},"los grupos se ocultan",[14,869,870],{},"Ordenar por duración puede precargar los metadatos de duración la primera vez.",[23,872,874],{"id":873},"reordenar","Reordenar",[14,876,877,878,881,882,885,886,484],{},"Activa arrastrar y soltar en ",[18,879,880],{},"Ajustes → Comportamiento"," (",[18,883,884],{},"Permitir reordenar","). Luego arrastra sonidos y grupos a su sitio. Reordenar aplica en el orden ",[18,887,848],{},[23,889,891],{"id":890},"selección-múltiple","Selección múltiple",[14,893,894,895,897],{},"Activa ",[18,896,891],{}," en la barra de navegación, luego:",[35,899,900,903,909,916],{},[38,901,902],{},"Clic para alternar un sonido",[38,904,905,908],{},[18,906,907],{},"Mayús+clic"," para un rango desde el último ancla",[38,910,911,912,915],{},"Arrastra un ",[18,913,914],{},"marco"," en el espacio vacío del tablero",[38,917,918],{},"Clic en el tablero vacío (o fuera) para limpiar la selección",[14,920,921,922,404,925,404,928,931,932,484],{},"Una barra masiva muestra el recuento, más ",[18,923,924],{},"Color",[18,926,927],{},"Mover a pestaña…",[18,929,930],{},"Eliminar"," y ",[18,933,934],{},"Hecho",[14,936,937,938,941],{},"En selección múltiple, cada botón muestra un ",[18,939,940],{},"chip de ID de 8 caracteres",". Clic derecho en el chip para copiarlo.",[23,943,945],{"id":944},"volumen-por-sonido","Volumen por sonido",[14,947,948,949,952,953,956],{},"Clic derecho → ",[18,950,951],{},"Volumen",". Arrastra el control de 0 % a 100 %. ",[18,954,955],{},"Doble clic"," lo restablece a 100 %.",[14,958,959],{},"Se acumula con el volumen de salida maestro en Ajustes.",[23,961,963],{"id":962},"atajos-e-ids-de-sonido","Atajos e IDs de sonido",[14,965,966,967,970],{},"Cada sonido tiene un ID de 8 caracteres. Cópialo desde el menú contextual del botón (",[18,968,969],{},"Copiar ID",") o el chip de ID de la selección múltiple.",[14,972,520,973,976,977,980],{},[18,974,975],{},"Ajustes → Atajos"," para vincular una tecla a un ID de sonido. Los atajos globales son opcionales. ",[18,978,979],{},"Asignar atajo"," en el menú contextual salta allí con el ID rellenado.",[14,982,983,984,986],{},"El mismo ID es el que ",[239,985,242],{"href":241}," usa para disparar un clip.",[23,988,990],{"id":989},"imágenes-de-fondo-y-colores","Imágenes de fondo y colores",[14,992,993,994,998],{},"Clic derecho en un sonido para definir colores por botón o una imagen de fondo. Eso es independiente del ",[239,995,997],{"href":996},"\u002Fdocs\u002Ftheme-editor","Theme Creator",", que da estilo a todo el tablero.",[14,1000,1001,1002,1005],{},"El selector es un diálogo ",[18,1003,1004],{},"Imagen de fondo"," (PNG, JPEG, GIF, WebP):",[35,1007,1008,1014],{},[38,1009,1010,1013],{},[18,1011,1012],{},"Archivos locales"," — añade carpetas, elige un archivo, busca por nombre, previsualiza la cuadrícula o quita una carpeta de la biblioteca",[38,1015,1016,1019,1020,1022],{},[18,1017,1018],{},"KLIPY"," — busca GIFs en línea. Pon tu propia clave API en ",[18,1021,880],{},". La clave no se guarda en los archivos del proyecto.",[14,1024,1025],{},"Tras elegir, mueve y recorta la imagen en el botón.",{"title":153,"searchDepth":154,"depth":154,"links":1027},[1028,1029,1030,1035,1036,1037,1038,1039,1040],{"id":662,"depth":154,"text":663},{"id":700,"depth":154,"text":701},{"id":734,"depth":154,"text":735,"children":1031},[1032,1033,1034],{"id":749,"depth":641,"text":750},{"id":784,"depth":641,"text":785},{"id":794,"depth":641,"text":795},{"id":837,"depth":154,"text":838},{"id":873,"depth":154,"text":874},{"id":890,"depth":154,"text":891},{"id":944,"depth":154,"text":945},{"id":962,"depth":154,"text":963},{"id":989,"depth":154,"text":990},"Etiquetas, filtros, pestañas, grupos, orden, selección múltiple, volumen y atajos.",{},4,"\u002Forganizing-sounds",{"title":630,"description":1041},"organizing-sounds","0TCdzxC5d9uOHlnFnD2ygCuD63pFk5yy3tK0Xgbpa7M",{"id":1049,"title":1050,"body":1051,"description":1175,"extension":161,"meta":1176,"navigation":163,"order":1177,"path":1178,"seo":1179,"stem":1180,"__hash__":1181},"content_es\u002Ftheme-editor.md","Editor de temas",{"type":7,"value":1052,"toc":1169},[1053,1056,1062,1066,1092,1095,1099,1113,1117,1143,1146,1150,1155],[10,1054,1050],{"id":1055},"editor-de-temas",[14,1057,1058,1059,484],{},"El Theme Creator es el editor visual completo de tu tablero. Ábrelo desde ",[18,1060,1061],{},"Ajustes → General → Theme Creator",[23,1063,1065],{"id":1064},"tres-pestañas","Tres pestañas",[94,1067,1068,1081,1087],{},[38,1069,1070,1073,1074,147,1077,1080],{},[18,1071,1072],{},"General"," — nombre del tema, colores compartidos y carga de fuentes (",[144,1075,1076],{},".ttf",[144,1078,1079],{},".otf",")",[38,1082,1083,1086],{},[18,1084,1085],{},"Botones"," — colores, tipo, diseño y overlay GIF de los botones de sonido",[38,1088,1089,1091],{},[18,1090,663],{}," — colores, tipo y grosor de borde de la barra de pestañas",[14,1093,1094],{},"Una vista previa en vivo muestra pestañas y botones mientras editas.",[23,1096,1098],{"id":1097},"qué-puedes-cambiar","Qué puedes cambiar",[35,1100,1101,1104,1107,1110],{},[38,1102,1103],{},"Colores primario y de acento, fondos, colores de botones, colores de pestañas",[38,1105,1106],{},"Familia y tamaño de fuente de botones y pestañas",[38,1108,1109],{},"Ancho, radio, borde, huecos y padding de los botones",[38,1111,1112],{},"Opacidad del overlay GIF (normal y hover)",[23,1114,1116],{"id":1115},"guardar-y-compartir","Guardar y compartir",[35,1118,1119,1125,1131,1137],{},[38,1120,1121,1124],{},[18,1122,1123],{},"Exportar .css"," — escribe un archivo de tema para respaldar o enviar a un amigo",[38,1126,1127,1130],{},[18,1128,1129],{},"Añadir a temas"," — guarda el archivo en tu carpeta Themes y aplícalo",[38,1132,1133,1136],{},[18,1134,1135],{},"Importar .css"," — carga un preset integrado o un tema guardado",[38,1138,1139,1142],{},[18,1140,1141],{},"Restablecer"," — vuelve a los valores por defecto de SoundNinja",[14,1144,1145],{},"Si cierras la ventana con cambios sin guardar, SoundNinja te pide que guardes primero.",[23,1147,1149],{"id":1148},"sin-el-editor-completo","Sin el editor completo",[14,1151,29,1152,1154],{},[18,1153,696],{}," aún puedes:",[35,1156,1157,1160,1166],{},[38,1158,1159],{},"Elegir un tema de la lista",[38,1161,1162,1163,1080],{},"Editar variables CSS en vivo (",[18,1164,1165],{},"CSS personalizado",[38,1167,1168],{},"Importar un archivo de tema a la carpeta Themes",{"title":153,"searchDepth":154,"depth":154,"links":1170},[1171,1172,1173,1174],{"id":1064,"depth":154,"text":1065},{"id":1097,"depth":154,"text":1098},{"id":1115,"depth":154,"text":1116},{"id":1148,"depth":154,"text":1149},"Diseña colores, fuentes, botones y pestañas en el Theme Creator.",{},5,"\u002Ftheme-editor",{"title":1050,"description":1175},"theme-editor","bPcJP7OLtBsnNMYJ-S1J6DmB6nngULo1_Q1hBJMNZAQ",{"id":4,"title":5,"body":1183,"description":160,"extension":161,"meta":1275,"navigation":163,"order":164,"path":165,"seo":1276,"stem":167,"__hash__":168},{"type":7,"value":1184,"toc":1269},[1185,1187,1191,1193,1197,1211,1213,1215,1233,1235,1247,1249,1257,1263],[10,1186,5],{"id":12},[14,1188,16,1189,21],{},[18,1190,20],{},[23,1192,26],{"id":25},[14,1194,29,1195,33],{},[18,1196,32],{},[35,1198,1199,1203,1207],{},[38,1200,1201,43],{},[18,1202,42],{},[38,1204,1205,49],{},[18,1206,48],{},[38,1208,1209,55],{},[18,1210,54],{},[14,1212,58],{},[23,1214,62],{"id":61},[35,1216,1217,1219,1221,1227,1229,1231],{},[38,1218,67],{},[38,1220,70],{},[38,1222,1223,76,1225],{},[18,1224,75],{},[18,1226,79],{},[38,1228,82],{},[38,1230,85],{},[38,1232,88],{},[23,1234,92],{"id":91},[94,1236,1237,1239,1241],{},[38,1238,98],{},[38,1240,101],{},[38,1242,1243,76,1245,110],{},[18,1244,106],{},[18,1246,109],{},[23,1248,114],{"id":113},[14,1250,117,1251,121,1253,76,1255,128],{},[18,1252,120],{},[18,1254,124],{},[18,1256,127],{},[14,1258,131,1259,135,1261,139],{},[18,1260,134],{},[18,1262,138],{},[14,1264,142,1265,147,1267,151],{},[144,1266,146],{},[144,1268,150],{},{"title":153,"searchDepth":154,"depth":154,"links":1270},[1271,1272,1273,1274],{"id":25,"depth":154,"text":26},{"id":61,"depth":154,"text":62},{"id":91,"depth":154,"text":92},{"id":113,"depth":154,"text":114},{},{"title":5,"description":160},{"id":1278,"title":1279,"body":1280,"description":1492,"extension":161,"meta":1493,"navigation":163,"order":1494,"path":1495,"seo":1496,"stem":1497,"__hash__":1498},"content_es\u002Fremote-control.md","Control remoto",{"type":7,"value":1281,"toc":1485},[1282,1285,1288,1292,1321,1324,1327,1362,1366,1386,1389,1393,1425,1429,1435],[10,1283,1279],{"id":1284},"control-remoto",[14,1286,1287],{},"SoundNinja puede escuchar en tu red local para que Bitfocus Companion (o cualquier cliente HTTP\u002FWebSocket) reproduzca y detenga sonidos.",[23,1289,1291],{"id":1290},"activar-el-servidor-remoto","Activar el servidor remoto",[94,1293,1294,1299,1305,1311],{},[38,1295,520,1296,484],{},[18,1297,1298],{},"Ajustes → Remoto",[38,1300,1301,1302,484],{},"Activa el servidor remoto. El puerto por defecto es ",[18,1303,1304],{},"7331",[38,1306,1307,1308,484],{},"Opcional: define un token. Los clientes deben enviarlo como Bearer token o ",[144,1309,1310],{},"?token=",[38,1312,1313,1314,1317,1318,484],{},"Copia la URL ",[144,1315,1316],{},"http:\u002F\u002FIP:PORT",", o copia la IP del sistema desde ",[18,1319,1320],{},"Ajustes → Acerca de",[14,1322,1323],{},"Windows puede mostrar un aviso del firewall la primera vez que arranca el servidor. Permite el acceso a la red privada.",[23,1325,242],{"id":1326},"bitfocus-companion",[94,1328,1329,1336,1345,1355],{},[38,1330,1331,1332,484],{},"Instala ",[239,1333,242],{"href":1334,"rel":1335},"https:\u002F\u002Fbitfocus.io\u002Fcompanion",[260],[38,1337,1338,1339,1344],{},"Descarga ",[239,1340,1343],{"href":1341,"rel":1342},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002Fcompanion-module-soundninja\u002Freleases\u002Flatest",[260],"SoundNinja-Companion.tgz",". Aún no hay paquete en Companion Store.",[38,1346,1347,1348,1351,1352,484],{},"En Companion: ",[18,1349,1350],{},"Modules → Load module package"," y elige el ",[144,1353,1354],{},".tgz",[38,1356,1357,1358,1361],{},"Añade una conexión ",[18,1359,1360],{},"Sound Ninja",". Pega la IP del PC, el puerto y el token si definiste uno.",[23,1363,1365],{"id":1364},"acciones","Acciones",[35,1367,1368,1374,1380],{},[38,1369,1370,1373],{},[18,1371,1372],{},"Trigger Sound"," — elige en el menú desplegable en vivo, o escribe un ID de sonido de 8 caracteres (las variables de Companion funcionan)",[38,1375,1376,1379],{},[18,1377,1378],{},"Stop Sound"," — detiene un sonido en reproducción por ID",[38,1381,1382,1385],{},[18,1383,1384],{},"Stop All"," — detiene todos los sonidos en reproducción",[14,1387,1388],{},"Copia un ID de sonido en SoundNinja desde el menú contextual del botón o el chip de ID de la selección múltiple.",[23,1390,1392],{"id":1391},"feedbacks-y-variables","Feedbacks y variables",[35,1394,1395,1401,1413,1419],{},[38,1396,1397,1400],{},[18,1398,1399],{},"Sound Playing"," — verdadero mientras ese ID de sonido está activo (úsalo para el color del botón)",[38,1402,1403,1406,1407,147,1410],{},[144,1404,1405],{},"$(soundninja:connected)"," — ",[144,1408,1409],{},"true",[144,1411,1412],{},"false",[38,1414,1415,1418],{},[144,1416,1417],{},"$(soundninja:playing_count)"," — cuántos sonidos suenan",[38,1420,1421,1424],{},[144,1422,1423],{},"$(soundninja:last_triggered)"," — último ID de sonido disparado",[23,1426,1428],{"id":1427},"api-http-avanzado","API HTTP (avanzado)",[14,1430,1431,1432],{},"Ruta base: ",[144,1433,1434],{},"\u002Fapi\u002Fv1",[35,1436,1437,1443,1449,1455,1465,1471,1479],{},[38,1438,1439,1442],{},[144,1440,1441],{},"GET \u002Finfo"," — nombre de la app, versión, protocolo, si se requiere un token",[38,1444,1445,1448],{},[144,1446,1447],{},"GET \u002Fsounds"," — lista de sonidos (id, name, tabs, active)",[38,1450,1451,1454],{},[144,1452,1453],{},"GET \u002Fstate"," — sonidos más IDs que suenan ahora",[38,1456,1457,1460,1461,1464],{},[144,1458,1459],{},"POST \u002Ftrigger"," con ",[144,1462,1463],{},"{ \"id\" }"," — reproducir un sonido",[38,1466,1467,1470],{},[144,1468,1469],{},"GET \u002Ftrigger\u002F:id"," — reproducir (fácil de probar en el navegador)",[38,1472,1473,1460,1476,1478],{},[144,1474,1475],{},"POST \u002Fstop",[144,1477,1463],{}," opcional — detener un sonido o todos",[38,1480,1481,1484],{},[144,1482,1483],{},"GET \u002Fws"," — estado en vivo; enviar comandos trigger\u002Fstop de entrada",{"title":153,"searchDepth":154,"depth":154,"links":1486},[1487,1488,1489,1490,1491],{"id":1290,"depth":154,"text":1291},{"id":1326,"depth":154,"text":242},{"id":1364,"depth":154,"text":1365},{"id":1391,"d