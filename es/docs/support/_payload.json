[{"data":1,"prerenderedAt":1566},["ShallowReactive",2],{"docs-page-es-\u002Fsupport":3,"docs-nav-es":124},{"id":4,"title":5,"body":6,"description":115,"extension":116,"meta":117,"navigation":118,"order":119,"path":120,"seo":121,"stem":122,"__hash__":123},"content_es\u002Fsupport.md","Soporte",{"type":7,"value":8,"toc":106},"minimark",[9,13,17,22,25,34,46,50,57,61,78,82,96,100],[10,11,5],"h1",{"id":12},"soporte",[14,15,16],"p",{},"SoundNinja es un proyecto comunitario en beta temprana. La forma más rápida de pedir ayuda es GitHub.",[18,19,21],"h2",{"id":20},"reportar-un-error-o-hacer-una-pregunta","Reportar un error o hacer una pregunta",[14,23,24],{},"Abre un issue en GitHub:",[14,26,27],{},[28,29,33],"a",{"href":30,"rel":31},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fissues",[32],"nofollow","github.com\u002Fmarcus-universe\u002FSoundNinja\u002Fissues",[14,35,36,37,41,42,45],{},"Incluye tu SO, la versión de SoundNinja (",[38,39,40],"strong",{},"Ayuda → Buscar actualizaciones"," o ",[38,43,44],{},"Ajustes → Acerca de",") y los pasos para reproducirlo.",[18,47,49],{"id":48},"correo","Correo",[14,51,52,53],{},"Contacto del mantenedor: ",[28,54,56],{"href":55},"mailto:contact@marcus-universe.de","contact@marcus-universe.de",[18,58,60],{"id":59},"actualizaciones","Actualizaciones",[14,62,63,64,66,67,71,72,77],{},"En la app, usa ",[38,65,40],{},". Las builds nuevas también aparecen en la ",[28,68,70],{"href":69},"\u002Fdownload","página de descarga"," y en ",[28,73,76],{"href":74,"rel":75},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Freleases",[32],"GitHub Releases",".",[18,79,81],{"id":80},"contribuir","Contribuir",[14,83,84,85,90,91,77],{},"Los pull requests son bienvenidos. El repo de la app es ",[28,86,89],{"href":87,"rel":88},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja",[32],"github.com\u002Fmarcus-universe\u002FSoundNinja",". El proyecto está bajo licencia ",[28,92,95],{"href":93,"rel":94},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fblob\u002Fmain\u002FLICENSE",[32],"GPL-3.0",[18,97,99],{"id":98},"aviso-legal","Aviso legal",[14,101,102,103,77],{},"Aviso legal y datos de contacto: ",[28,104,99],{"href":105},"\u002Fimpressum",{"title":107,"searchDepth":108,"depth":108,"links":109},"",2,[110,111,112,113,114],{"id":20,"depth":108,"text":21},{"id":48,"depth":108,"text":49},{"id":59,"depth":108,"text":60},{"id":80,"depth":108,"text":81},{"id":98,"depth":108,"text":99},"Dónde pedir ayuda y reportar errores.","md",{},true,8,"\u002Fsupport",{"title":5,"description":115},"support","a00is-hTbQUOnHv2YiZDFMQVyUfDSKLK4GccVuiJQ9c",[125,254,449,597,1000,1135,1281,1502],{"id":126,"title":127,"body":128,"description":247,"extension":116,"meta":248,"navigation":118,"order":249,"path":250,"seo":251,"stem":252,"__hash__":253},"content_es\u002Foverview.md","Resumen",{"type":7,"value":129,"toc":241},[130,133,136,139,142,146,162,166,205,209,216,220],[10,131,127],{"id":132},"resumen",[14,134,135],{},"SoundNinja es un soundboard de código abierto para streaming en directo, charlas con amigos y grabación de podcasts. Está construido con Tauri v2 y Nuxt 4 para que sea ligero en RAM y disco.",[14,137,138],{},"El objetivo es simple: mantener una biblioteca enorme fácil de recorrer y reproducir el clip correcto en milisegundos. La interfaz también funciona bien como panel en VR.",[14,140,141],{},"SoundNinja sigue en desarrollo temprano. Las funciones marchan, pero no todas las plataformas están del todo probadas.",[18,143,145],{"id":144},"para-quién","Para quién",[147,148,149,153,156,159],"ul",{},[150,151,152],"li",{},"Streamers que necesitan cues de sonido al instante",[150,154,155],{},"Amigos que quieren un tablero compartido para el chat de voz",[150,157,158],{},"Podcasters que graban clips y los sueltan en un tablero",[150,160,161],{},"Quien quiera un soundboard personalizable y local-first",[18,163,165],{"id":164},"qué-puedes-hacer","Qué puedes hacer",[147,167,168,171,174,177,180,183,186,189,192,199,202],{},[150,169,170],{},"Montar un soundboard con tus propios archivos de audio",[150,172,173],{},"Organizar sonidos en pestañas de colores, grupos, etiquetas y búsqueda",[150,175,176],{},"Filtrar por etiquetas (OR) y ordenar por nombre, fecha, duración o tamaño",[150,178,179],{},"Selección múltiple con marco o rango Mayús, luego color, mover o borrar en lote",[150,181,182],{},"Ajustar el volumen por sonido desde el menú contextual",[150,184,185],{},"Diseñar el aspecto con el Theme Creator",[150,187,188],{},"Grabar audio del PC o un micrófono en el Record Editor",[150,190,191],{},"Asignar atajos a sonidos individuales",[150,193,194,195],{},"Disparar sonidos desde ",[28,196,198],{"href":197},"\u002Fdocs\u002Fremote-control","Bitfocus Companion",[150,200,201],{},"Importar y exportar un soundboard completo para compartirlo",[150,203,204],{},"Usar GIFs o imágenes en los botones — biblioteca local de carpetas o KLIPY",[18,206,208],{"id":207},"licencia","Licencia",[14,210,211,212,215],{},"SoundNinja es software libre bajo ",[28,213,95],{"href":93,"rel":214},[32],". Haz fork, cámbialo, compártelo.",[18,217,219],{"id":218},"siguientes-pasos","Siguientes pasos",[221,222,223,229,235],"ol",{},[150,224,225],{},[28,226,228],{"href":227},"\u002Fdocs\u002Finstallation","Instalar SoundNinja",[150,230,231],{},[28,232,234],{"href":233},"\u002Fdocs\u002Fadding-sounds","Añadir sonidos",[150,236,237],{},[28,238,240],{"href":239},"\u002Fdocs\u002Forganizing-sounds","Organizar tu tablero",{"title":107,"searchDepth":108,"depth":108,"links":242},[243,244,245,246],{"id":144,"depth":108,"text":145},{"id":164,"depth":108,"text":165},{"id":207,"depth":108,"text":208},{"id":218,"depth":108,"text":219},"Qué es SoundNinja y qué puedes hacer con él.",{},1,"\u002Foverview",{"title":127,"description":247},"overview","XWpBFvtyid6BLXO3HByHppTxfsOo0i7DlSOMew5tq2g",{"id":255,"title":256,"body":257,"description":443,"extension":116,"meta":444,"navigation":118,"order":108,"path":445,"seo":446,"stem":447,"__hash__":448},"content_es\u002Finstallation.md","Instalación",{"type":7,"value":258,"toc":436},[259,262,273,277,297,300,304,318,321,325,350,361,363,369,373,387,417,432],[10,260,256],{"id":261},"instalación",[14,263,264,265,267,268,272],{},"Consigue una build en la ",[28,266,70],{"href":69}," o en ",[28,269,76],{"href":270,"rel":271},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Freleases\u002Flatest",[32],". SoundNinja está en desarrollo temprano, así que trata las builds como beta.",[18,274,276],{"id":275},"windows","Windows",[147,278,279,288,291,294],{},[150,280,281,41,284,287],{},[38,282,283],{},"Instalador (.exe)",[38,285,286],{},"MSI (.msi)"," para Windows de 64 bits",[150,289,290],{},"Objetivo de la landing: Windows 10 y posterior",[150,292,293],{},"El README de la app también lista Windows 8 y superior",[150,295,296],{},"El instalador NSIS usa tema oscuro. Elige idioma en el setup — SoundNinja lo recuerda en el siguiente arranque.",[14,298,299],{},"Ejecuta el instalador y luego abre SoundNinja desde el menú Inicio.",[18,301,303],{"id":302},"macos","macOS",[147,305,306,312,315],{},[150,307,308,311],{},[38,309,310],{},".dmg universal"," para Apple Silicon e Intel",[150,313,314],{},"Objetivo de la landing: macOS 10.14 y posterior",[150,316,317],{},"El README de la app lista macOS 10.15 y superior",[14,319,320],{},"Abre la imagen de disco y arrastra SoundNinja a Aplicaciones.",[18,322,324],{"id":323},"linux","Linux",[147,326,327,333,339,347],{},[150,328,329,332],{},[38,330,331],{},"Debian (.deb)"," para Ubuntu \u002F Debian",[150,334,335,338],{},[38,336,337],{},"AppImage"," para otras distros",[150,340,341,342,346],{},"Tras publicar una release, los usuarios de Arch pueden instalar ",[343,344,345],"code",{},"soundninja-bin"," desde el AUR",[150,348,349],{},"Probado en Ubuntu 20.04",[14,351,352,353,356,357,360],{},"Las builds de escritorio necesitan paquetes WebKit y GTK. En Debian\u002FUbuntu eso suele ser ",[343,354,355],{},"libwebkit2gtk",", ",[343,358,359],{},"libgtk-3-0"," y una biblioteca app-indicator.",[18,362,60],{"id":59},[14,364,365,366,368],{},"En la app, abre ",[38,367,40],{},". También puedes dejar que SoundNinja compruebe al arrancar en Ajustes.",[18,370,372],{"id":371},"compilar-desde-el-código","Compilar desde el código",[14,374,375,376,380,381,386],{},"¿Necesitas una build personalizada? Clona ",[28,377,379],{"href":87,"rel":378},[32],"el repo",", instala los ",[28,382,385],{"href":383,"rel":384},"https:\u002F\u002Fv2.tauri.app\u002Fstart\u002Fprerequisites\u002F",[32],"requisitos de Tauri"," y luego:",[388,389,393],"pre",{"className":390,"code":391,"language":392,"meta":107,"style":107},"language-bash shiki shiki-themes github-light github-dark","bun install\nbun run tauri:serve\n","bash",[343,394,395,407],{"__ignoreMap":107},[396,397,399,403],"span",{"class":398,"line":249},"line",[396,400,402],{"class":401},"sScJk","bun",[396,404,406],{"class":405},"sZZnC"," install\n",[396,408,409,411,414],{"class":398,"line":108},[396,410,402],{"class":401},[396,412,413],{"class":405}," run",[396,415,416],{"class":405}," tauri:serve\n",[14,418,419,356,422,41,425,428,429,77],{},[343,420,421],{},"npm",[343,423,424],{},"pnpm",[343,426,427],{},"deno"," también sirven. Build de producción: ",[343,430,431],{},"bun run tauri:build",[433,434,435],"style",{},"html pre.shiki code .sScJk, html code.shiki .sScJk{--shiki-default:#6F42C1;--shiki-dark:#B392F0}html pre.shiki code .sZZnC, html code.shiki .sZZnC{--shiki-default:#032F62;--shiki-dark:#9ECBFF}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html.dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}",{"title":107,"searchDepth":108,"depth":108,"links":437},[438,439,440,441,442],{"id":275,"depth":108,"text":276},{"id":302,"depth":108,"text":303},{"id":323,"depth":108,"text":324},{"id":59,"depth":108,"text":60},{"id":371,"depth":108,"text":372},"Instala SoundNinja en Windows, macOS o Linux.",{},"\u002Finstallation",{"title":256,"description":443},"installation","zTwxz-vo_-k3K7RGGSHRG4ObTS6FkM9sbuxQPVMKTtY",{"id":450,"title":234,"body":451,"description":590,"extension":116,"meta":591,"navigation":118,"order":592,"path":593,"seo":594,"stem":595,"__hash__":596},"content_es\u002Fadding-sounds.md",{"type":7,"value":452,"toc":582},[453,456,459,463,482,486,517,521,540,544,558,561,565,572,576],[10,454,234],{"id":455},"añadir-sonidos",[14,457,458],{},"Un tablero está vacío hasta que añades clips. SoundNinja puede importar archivos, carpetas enteras, una grabación o un pack de soundboard compartido.",[18,460,462],{"id":461},"importar-archivos-de-audio","Importar archivos de audio",[221,464,465,476,479],{},[150,466,467,468,471,472,475],{},"Abre ",[38,469,470],{},"Archivo → Importar archivos de audio",", o usa ",[38,473,474],{},"Importar"," en la barra de navegación.",[150,477,478],{},"Elige uno o más archivos de audio.",[150,480,481],{},"Los sonidos llegan a la pestaña actual.",[18,483,485],{"id":484},"importar-carpetas","Importar carpetas",[221,487,488,497,500],{},[150,489,467,490,493,494,496],{},[38,491,492],{},"Archivo → Importar carpetas"," (o ",[38,495,485],{}," en la barra de navegación).",[150,498,499],{},"Añade una o más carpetas. Arrastra para reordenarlas antes de importar.",[150,501,502,503],{},"Elige cómo llegan:\n",[147,504,505,511],{},[150,506,507,510],{},[38,508,509],{},"Importar como pestañas"," — cada carpeta se convierte en su propia pestaña",[150,512,513,516],{},[38,514,515],{},"Importar a la pestaña actual"," — cada archivo va a la pestaña activa",[18,518,520],{"id":519},"grabar-un-clip","Grabar un clip",[14,522,523,524,528,529,532,533,41,536,539],{},"Abre el ",[28,525,527],{"href":526},"\u002Fdocs\u002Frecording-editor","Record Editor"," desde el botón ",[38,530,531],{},"Grabar"," en la barra del reproductor. Captura, recorta y luego ",[38,534,535],{},"Importar selección",[38,537,538],{},"Importar todo"," en la pestaña actual o en una pestaña que elijas.",[18,541,543],{"id":542},"importar-un-soundboard","Importar un soundboard",[14,545,546,549,550,553,554,557],{},[38,547,548],{},"Archivo → Importar soundboard"," carga un pack compartido. Los packs son un ",[343,551,552],{},".zip"," que contiene ",[343,555,556],{},"project.sninja"," más los archivos de sonido. Tras importar, abre el proyecto y reproduce.",[14,559,560],{},"También puedes tener varios proyectos (perfiles). Usa el selector de proyecto para cambiar de tablero.",[18,562,564],{"id":563},"reenlazar-archivos-faltantes","Reenlazar archivos faltantes",[14,566,567,568,571],{},"Si los archivos de audio se mueven en el disco, SoundNinja muestra ",[38,569,570],{},"Archivos de sonido faltantes",". Elige una carpeta para buscar y reenlazar los clips.",[18,573,575],{"id":574},"siguiente","Siguiente",[14,577,578,579,77],{},"Organiza pestañas, etiquetas, filtros y atajos en ",[28,580,581],{"href":239},"Organizar sonidos",{"title":107,"searchDepth":108,"depth":108,"links":583},[584,585,586,587,588,589],{"id":461,"depth":108,"text":462},{"id":484,"depth":108,"text":485},{"id":519,"depth":108,"text":520},{"id":542,"depth":108,"text":543},{"id":563,"depth":108,"text":564},{"id":574,"depth":108,"text":575},"Importa audio, carpetas, grabaciones y soundboards compartidos.",{},3,"\u002Fadding-sounds",{"title":234,"description":590},"adding-sounds","O5nOJGNq2FL6jafUxqoGYNKJDVbb2UrZRjfKpK21LlQ",{"id":598,"title":581,"body":599,"description":993,"extension":116,"meta":994,"navigation":118,"order":995,"path":996,"seo":997,"stem":998,"__hash__":999},"content_es\u002Forganizing-sounds.md",{"type":7,"value":600,"toc":978},[601,604,611,615,642,649,653,656,670,677,683,687,697,702,734,738,744,748,781,787,791,794,820,823,827,840,844,850,871,887,894,898,909,912,916,923,933,939,943,951,958,975],[10,602,581],{"id":603},"organizar-sonidos",[14,605,606,607,610],{},"SoundNinja está hecho para bibliotecas grandes. ",[38,608,609],{},"Etiquetas y filtros",", pestañas, búsqueda, selección múltiple y atajos — el clip que necesitas está a un clic (o una tecla).",[18,612,614],{"id":613},"pestañas","Pestañas",[147,616,617,624,631],{},[150,618,619,620,623],{},"Añade una pestaña con ",[38,621,622],{},"Añadir pestaña",". Dale un color para escanear la barra rápido.",[150,625,626,627,630],{},"La vista ",[38,628,629],{},"Todos"," muestra cada sonido de todas las pestañas.",[150,632,633,634,637,638,641],{},"Un sonido puede pertenecer a ",[38,635,636],{},"una o más pestañas",". Clic derecho en un sonido y usa ",[38,639,640],{},"Mover a pestaña"," para asignarlo.",[14,643,644,645,648],{},"Las transiciones de pestaña están en ",[38,646,647],{},"Ajustes → General",": Slide, Fade, Botones uno a uno, o Ninguna.",[18,650,652],{"id":651},"grupos","Grupos",[14,654,655],{},"Desde la v0.5.3, los separadores pueden convertirse en grupos con nombre:",[147,657,658,661,664,667],{},[150,659,660],{},"Añadir, renombrar o quitar un grupo desde el menú contextual",[150,662,663],{},"Arrastra la cabecera del grupo — los hijos se mueven con ella",[150,665,666],{},"Suelta sonidos dentro o fuera de un grupo",[150,668,669],{},"Define color de borde, color del nombre y alineación de botones (o usa el valor por defecto de la pestaña)",[14,671,672,673,676],{},"Sigue pudiendo añadir un ",[38,674,675],{},"Separador"," simple si solo necesitas un corte visual.",[14,678,679,680,77],{},"Clic derecho en el espacio vacío del tablero para ",[38,681,682],{},"Añadir grupo",[18,684,686],{"id":685},"etiquetas-filtros","Etiquetas \u002F Filtros",[14,688,689,690,693,694,696],{},"Las etiquetas cruzan las pestañas. El panel ",[38,691,692],{},"Filtro"," (barra lateral ",[38,695,692],{},") es donde las creas y filtras el tablero.",[698,699,701],"h3",{"id":700},"crear-y-editar-etiquetas","Crear y editar etiquetas",[221,703,704,709,720,727],{},[150,705,467,706,708],{},[38,707,692],{}," en la barra lateral.",[150,710,711,712,715,716,719],{},"En ",[38,713,714],{},"Etiquetas",", usa ",[38,717,718],{},"Añadir etiqueta"," — nombre y color.",[150,721,722,723,726],{},"Renombra, recolorea o ",[38,724,725],{},"Eliminar etiqueta"," en la misma lista.",[150,728,729,730,733],{},"Si ves ",[38,731,732],{},"Aún no hay etiquetas",", crea una aquí antes de asignar.",[698,735,737],{"id":736},"asignar-etiquetas-a-sonidos","Asignar etiquetas a sonidos",[14,739,740,741,743],{},"Clic derecho en un sonido → ",[38,742,714],{}," (casillas). Un sonido puede tener varias. Si aún no hay ninguna, el menú te lleva al panel de filtro.",[698,745,747],{"id":746},"filtrar-el-tablero","Filtrar el tablero",[147,749,750,756,767,778],{},[150,751,752,753,77],{},"Activa etiquetas en el panel Filtro o como ",[38,754,755],{},"chips bajo la barra de búsqueda",[150,757,758,759,762,763,766],{},"La coincidencia es ",[38,760,761],{},"OR",": un sonido sigue visible si tiene ",[38,764,765],{},"cualquiera"," de las etiquetas seleccionadas.",[150,768,769,770,773,774,777],{},"El campo ",[38,771,772],{},"Buscar"," combina con ",[38,775,776],{},"AND"," el filtro de etiquetas activo (texto + etiquetas juntos).",[150,779,780],{},"Apaga los chips (o limpia el filtro) para ver de nuevo toda la pestaña.",[14,782,783,784,77],{},"Los nombres de etiqueta en color pueden aparecer en los botones. Actívalos en ",[38,785,786],{},"Ajustes → Comportamiento → Mostrar badges de etiquetas",[18,788,790],{"id":789},"orden","Orden",[14,792,793],{},"Abre el panel de filtro y elige un modo:",[147,795,796,802],{},[150,797,798,801],{},[38,799,800],{},"Definido por el usuario"," — tu orden de pestaña, grupos visibles",[150,803,804,356,807,356,810,41,813,816,817],{},[38,805,806],{},"Nombre",[38,808,809],{},"Fecha de añadido",[38,811,812],{},"Tiempo de reproducción",[38,814,815],{},"Tamaño de archivo"," — lista plana ordenada; ",[38,818,819],{},"los grupos se ocultan",[14,821,822],{},"Ordenar por duración puede precargar los metadatos de duración la primera vez.",[18,824,826],{"id":825},"reordenar","Reordenar",[14,828,829,830,833,834,837,838,77],{},"Activa arrastrar y soltar en ",[38,831,832],{},"Ajustes → Comportamiento"," (",[38,835,836],{},"Permitir reordenar","). Luego arrastra sonidos y grupos a su sitio. Reordenar aplica en el orden ",[38,839,800],{},[18,841,843],{"id":842},"selección-múltiple","Selección múltiple",[14,845,846,847,849],{},"Activa ",[38,848,843],{}," en la barra de navegación, luego:",[147,851,852,855,861,868],{},[150,853,854],{},"Clic para alternar un sonido",[150,856,857,860],{},[38,858,859],{},"Mayús+clic"," para un rango desde el último ancla",[150,862,863,864,867],{},"Arrastra un ",[38,865,866],{},"marco"," en el espacio vacío del tablero",[150,869,870],{},"Clic en el tablero vacío (o fuera) para limpiar la selección",[14,872,873,874,356,877,356,880,883,884,77],{},"Una barra masiva muestra el recuento, más ",[38,875,876],{},"Color",[38,878,879],{},"Mover a pestaña…",[38,881,882],{},"Eliminar"," y ",[38,885,886],{},"Hecho",[14,888,889,890,893],{},"En selección múltiple, cada botón muestra un ",[38,891,892],{},"chip de ID de 8 caracteres",". Clic derecho en el chip para copiarlo.",[18,895,897],{"id":896},"volumen-por-sonido","Volumen por sonido",[14,899,900,901,904,905,908],{},"Clic derecho → ",[38,902,903],{},"Volumen",". Arrastra el control de 0 % a 100 %. ",[38,906,907],{},"Doble clic"," lo restablece a 100 %.",[14,910,911],{},"Se acumula con el volumen de salida maestro en Ajustes.",[18,913,915],{"id":914},"atajos-e-ids-de-sonido","Atajos e IDs de sonido",[14,917,918,919,922],{},"Cada sonido tiene un ID de 8 caracteres. Cópialo desde el menú contextual del botón (",[38,920,921],{},"Copiar ID",") o el chip de ID de la selección múltiple.",[14,924,467,925,928,929,932],{},[38,926,927],{},"Ajustes → Atajos"," para vincular una tecla a un ID de sonido. Los atajos globales son opcionales. ",[38,930,931],{},"Asignar atajo"," en el menú contextual salta allí con el ID rellenado.",[14,934,935,936,938],{},"El mismo ID es el que ",[28,937,198],{"href":197}," usa para disparar un clip.",[18,940,942],{"id":941},"imágenes-de-fondo-y-colores","Imágenes de fondo y colores",[14,944,945,946,950],{},"Clic derecho en un sonido para definir colores por botón o una imagen de fondo. Eso es independiente del ",[28,947,949],{"href":948},"\u002Fdocs\u002Ftheme-editor","Theme Creator",", que da estilo a todo el tablero.",[14,952,953,954,957],{},"El selector es un diálogo ",[38,955,956],{},"Imagen de fondo"," (PNG, JPEG, GIF, WebP):",[147,959,960,966],{},[150,961,962,965],{},[38,963,964],{},"Archivos locales"," — añade carpetas, elige un archivo, busca por nombre, previsualiza la cuadrícula o quita una carpeta de la biblioteca",[150,967,968,971,972,974],{},[38,969,970],{},"KLIPY"," — busca GIFs en línea. Pon tu propia clave API en ",[38,973,832],{},". La clave no se guarda en los archivos del proyecto.",[14,976,977],{},"Tras elegir, mueve y recorta la imagen en el botón.",{"title":107,"searchDepth":108,"depth":108,"links":979},[980,981,982,987,988,989,990,991,992],{"id":613,"depth":108,"text":614},{"id":651,"depth":108,"text":652},{"id":685,"depth":108,"text":686,"children":983},[984,985,986],{"id":700,"depth":592,"text":701},{"id":736,"depth":592,"text":737},{"id":746,"depth":592,"text":747},{"id":789,"depth":108,"text":790},{"id":825,"depth":108,"text":826},{"id":842,"depth":108,"text":843},{"id":896,"depth":108,"text":897},{"id":914,"depth":108,"text":915},{"id":941,"depth":108,"text":942},"Etiquetas, filtros, pestañas, grupos, orden, selección múltiple, volumen y atajos.",{},4,"\u002Forganizing-sounds",{"title":581,"description":993},"organizing-sounds","0TCdzxC5d9uOHlnFnD2ygCuD63pFk5yy3tK0Xgbpa7M",{"id":1001,"title":1002,"body":1003,"description":1128,"extension":116,"meta":1129,"navigation":118,"order":1130,"path":1131,"seo":1132,"stem":1133,"__hash__":1134},"content_es\u002Ftheme-editor.md","Editor de temas",{"type":7,"value":1004,"toc":1122},[1005,1008,1014,1018,1045,1048,1052,1066,1070,1096,1099,1103,1108],[10,1006,1002],{"id":1007},"editor-de-temas",[14,1009,1010,1011,77],{},"El Theme Creator es el editor visual completo de tu tablero. Ábrelo desde ",[38,1012,1013],{},"Ajustes → General → Theme Creator",[18,1015,1017],{"id":1016},"tres-pestañas","Tres pestañas",[221,1019,1020,1034,1040],{},[150,1021,1022,1025,1026,1029,1030,1033],{},[38,1023,1024],{},"General"," — nombre del tema, colores compartidos y carga de fuentes (",[343,1027,1028],{},".ttf"," \u002F ",[343,1031,1032],{},".otf",")",[150,1035,1036,1039],{},[38,1037,1038],{},"Botones"," — colores, tipo, diseño y overlay GIF de los botones de sonido",[150,1041,1042,1044],{},[38,1043,614],{}," — colores, tipo y grosor de borde de la barra de pestañas",[14,1046,1047],{},"Una vista previa en vivo muestra pestañas y botones mientras editas.",[18,1049,1051],{"id":1050},"qué-puedes-cambiar","Qué puedes cambiar",[147,1053,1054,1057,1060,1063],{},[150,1055,1056],{},"Colores primario y de acento, fondos, colores de botones, colores de pestañas",[150,1058,1059],{},"Familia y tamaño de fuente de botones y pestañas",[150,1061,1062],{},"Ancho, radio, borde, huecos y padding de los botones",[150,1064,1065],{},"Opacidad del overlay GIF (normal y hover)",[18,1067,1069],{"id":1068},"guardar-y-compartir","Guardar y compartir",[147,1071,1072,1078,1084,1090],{},[150,1073,1074,1077],{},[38,1075,1076],{},"Exportar .css"," — escribe un archivo de tema para respaldar o enviar a un amigo",[150,1079,1080,1083],{},[38,1081,1082],{},"Añadir a temas"," — guarda el archivo en tu carpeta Themes y aplícalo",[150,1085,1086,1089],{},[38,1087,1088],{},"Importar .css"," — carga un preset integrado o un tema guardado",[150,1091,1092,1095],{},[38,1093,1094],{},"Restablecer"," — vuelve a los valores por defecto de SoundNinja",[14,1097,1098],{},"Si cierras la ventana con cambios sin guardar, SoundNinja te pide que guardes primero.",[18,1100,1102],{"id":1101},"sin-el-editor-completo","Sin el editor completo",[14,1104,711,1105,1107],{},[38,1106,647],{}," aún puedes:",[147,1109,1110,1113,1119],{},[150,1111,1112],{},"Elegir un tema de la lista",[150,1114,1115,1116,1033],{},"Editar variables CSS en vivo (",[38,1117,1118],{},"CSS personalizado",[150,1120,1121],{},"Importar un archivo de tema a la carpeta Themes",{"title":107,"searchDepth":108,"depth":108,"links":1123},[1124,1125,1126,1127],{"id":1016,"depth":108,"text":1017},{"id":1050,"depth":108,"text":1051},{"id":1068,"depth":108,"text":1069},{"id":1101,"depth":108,"text":1102},"Diseña colores, fuentes, botones y pestañas en el Theme Creator.",{},5,"\u002Ftheme-editor",{"title":1002,"description":1128},"theme-editor","bPcJP7OLtBsnNMYJ-S1J6DmB6nngULo1_Q1hBJMNZAQ",{"id":1136,"title":1137,"body":1138,"description":1274,"extension":116,"meta":1275,"navigation":118,"order":1276,"path":1277,"seo":1278,"stem":1279,"__hash__":1280},"content_es\u002Frecording-editor.md","Editor de grabación",{"type":7,"value":1139,"toc":1268},[1140,1143,1149,1153,1159,1179,1182,1186,1211,1215,1229,1233,1247,1258],[10,1141,1137],{"id":1142},"editor-de-grabación",[14,1144,1145,1146,1148],{},"Graba un clip dentro de SoundNinja, recórtalo e impórtalo a una pestaña. Abre el editor con el botón ",[38,1147,531],{}," en la barra del reproductor.",[18,1150,1152],{"id":1151},"elegir-una-entrada","Elegir una entrada",[14,1154,711,1155,1158],{},[38,1156,1157],{},"Ajustes → Audio",":",[147,1160,1161,1167,1173],{},[150,1162,1163,1166],{},[38,1164,1165],{},"Dispositivos de entrada"," — micrófono",[150,1168,1169,1172],{},[38,1170,1171],{},"Dispositivos de salida (audio del PC)"," — loopback de lo que reproduce el PC",[150,1174,1175,1178],{},[38,1176,1177],{},"Volumen de entrada"," — ganancia de captura del 0 % al 200 %",[14,1180,1181],{},"El botón Grabar usa el dispositivo que eliges aquí.",[18,1183,1185],{"id":1184},"editar-la-toma","Editar la toma",[147,1187,1188,1191,1194,1202,1205,1208],{},[150,1189,1190],{},"Grabar y detener",[150,1192,1193],{},"Observar el medidor de nivel de entrada",[150,1195,1196,41,1199],{},[38,1197,1198],{},"Normalizar",[38,1200,1201],{},"Cancelación de ruido",[150,1203,1204],{},"Recortar todo el clip, recortar a una selección o borrar una selección",[150,1206,1207],{},"Deshacer \u002F rehacer",[150,1209,1210],{},"Acercar y alejar",[18,1212,1214],{"id":1213},"preparar-e-importar","Preparar e importar",[221,1216,1217,1220,1223],{},[150,1218,1219],{},"Añade la selección o la pista completa a la lista de staging.",[150,1221,1222],{},"La lista empieza vacía: graba, edita y luego añade un clip.",[150,1224,1225,41,1227,539],{},[38,1226,535],{},[38,1228,538],{},[18,1230,1232],{"id":1231},"separación-de-stems-opcional","Separación de stems (opcional)",[14,1234,1235,1236,1239,1240,41,1243,1246],{},"Las builds oficiales de Windows, macOS y Linux incluyen la función ",[38,1237,1238],{},"stems",". El Record Editor puede conservar ",[38,1241,1242],{},"voces",[38,1244,1245],{},"música"," con BS-RoFormer.",[14,1248,1249,1250,1253,1254,1257],{},"El modelo pesa unos 158 MB y ",[38,1251,1252],{},"no"," viene en el instalador. Descárgalo desde ",[38,1255,1256],{},"Ajustes → Separación de stems",", o acepta el aviso del primer arranque. El instalador de Windows también puede ofrecer descargar el modelo al primer inicio.",[14,1259,1260,1261,1029,1264,1267],{},"Las builds personalizadas desde código necesitan un flag extra (",[343,1262,1263],{},"tauri:serve:stems",[343,1265,1266],{},"tauri:build:stems",").",{"title":107,"searchDepth":108,"depth":108,"links":1269},[1270,1271,1272,1273],{"id":1151,"depth":108,"text":1152},{"id":1184,"depth":108,"text":1185},{"id":1213,"depth":108,"text":1214},{"id":1231,"depth":108,"text":1232},"Captura micrófono o audio del PC, edita el clip y suéltalo en tu tablero.",{},6,"\u002Frecording-editor",{"title":1137,"description":1274},"recording-editor","89aDSCp7hE8To2TNFwdWaImQVsHH2-xNcOyltCPP5IY",{"id":1282,"title":1283,"body":1284,"description":1495,"extension":116,"meta":1496,"navigation":118,"order":1497,"path":1498,"seo":1499,"stem":1500,"__hash__":1501},"content_es\u002Fremote-control.md","Control remoto",{"type":7,"value":1285,"toc":1488},[1286,1289,1292,1296,1324,1327,1330,1365,1369,1389,1392,1396,1428,1432,1438],[10,1287,1283],{"id":1288},"control-remoto",[14,1290,1291],{},"SoundNinja puede escuchar en tu red local para que Bitfocus Companion (o cualquier cliente HTTP\u002FWebSocket) reproduzca y detenga sonidos.",[18,1293,1295],{"id":1294},"activar-el-servidor-remoto","Activar el servidor remoto",[221,1297,1298,1303,1309,1315],{},[150,1299,467,1300,77],{},[38,1301,1302],{},"Ajustes → Remoto",[150,1304,1305,1306,77],{},"Activa el servidor remoto. El puerto por defecto es ",[38,1307,1308],{},"7331",[150,1310,1311,1312,77],{},"Opcional: define un token. Los clientes deben enviarlo como Bearer token o ",[343,1313,1314],{},"?token=",[150,1316,1317,1318,1321,1322,77],{},"Copia la URL ",[343,1319,1320],{},"http:\u002F\u002FIP:PORT",", o copia la IP del sistema desde ",[38,1323,44],{},[14,1325,1326],{},"Windows puede mostrar un aviso del firewall la primera vez que arranca el servidor. Permite el acceso a la red privada.",[18,1328,198],{"id":1329},"bitfocus-companion",[221,1331,1332,1339,1348,1358],{},[150,1333,1334,1335,77],{},"Instala ",[28,1336,198],{"href":1337,"rel":1338},"https:\u002F\u002Fbitfocus.io\u002Fcompanion",[32],[150,1340,1341,1342,1347],{},"Descarga ",[28,1343,1346],{"href":1344,"rel":1345},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002Fcompanion-module-soundninja\u002Freleases\u002Flatest",[32],"SoundNinja-Companion.tgz",". Aún no hay paquete en Companion Store.",[150,1349,1350,1351,1354,1355,77],{},"En Companion: ",[38,1352,1353],{},"Modules → Load module package"," y elige el ",[343,1356,1357],{},".tgz",[150,1359,1360,1361,1364],{},"Añade una conexión ",[38,1362,1363],{},"Sound Ninja",". Pega la IP del PC, el puerto y el token si definiste uno.",[18,1366,1368],{"id":1367},"acciones","Acciones",[147,1370,1371,1377,1383],{},[150,1372,1373,1376],{},[38,1374,1375],{},"Trigger Sound"," — elige en el menú desplegable en vivo, o escribe un ID de sonido de 8 caracteres (las variables de Companion funcionan)",[150,1378,1379,1382],{},[38,1380,1381],{},"Stop Sound"," — detiene un sonido en reproducción por ID",[150,1384,1385,1388],{},[38,1386,1387],{},"Stop All"," — detiene todos los sonidos en reproducción",[14,1390,1391],{},"Copia un ID de sonido en SoundNinja desde el menú contextual del botón o el chip de ID de la selección múltiple.",[18,1393,1395],{"id":1394},"feedbacks-y-variables","Feedbacks y variables",[147,1397,1398,1404,1416,1422],{},[150,1399,1400,1403],{},[38,1401,1402],{},"Sound Playing"," — verdadero mientras ese ID de sonido está activo (úsalo para el color del botón)",[150,1405,1406,1409,1410,1029,1413],{},[343,1407,1408],{},"$(soundninja:connected)"," — ",[343,1411,1412],{},"true",[343,1414,1415],{},"false",[150,1417,1418,1421],{},[343,1419,1420],{},"$(soundninja:playing_count)"," — cuántos sonidos suenan",[150,1423,1424,1427],{},[343,1425,1426],{},"$(soundninja:last_triggered)"," — último ID de sonido disparado",[18,1429,1431],{"id":1430},"api-http-avanzado","API HTTP (avanzado)",[14,1433,1434,1435],{},"Ruta base: ",[343,1436,1437],{},"\u002Fapi\u002Fv1",[147,1439,1440,1446,1452,1458,1468,1474,1482],{},[150,1441,1442,1445],{},[343,1443,1444],{},"GET \u002Finfo"," — nombre de la app, versión, protocolo, si se requiere un token",[150,1447,1448,1451],{},[343,1449,1450],{},"GET \u002Fsounds"," — lista de sonidos (id, name, tabs, active)",[150,1453,1454,1457],{},[343,1455,1456],{},"GET \u002Fstate"," — sonidos más IDs que suenan ahora",[150,1459,1460,1463,1464,1467],{},[343,1461,1462],{},"POST \u002Ftrigger"," con ",[343,1465,1466],{},"{ \"id\" }"," — reproducir un sonido",[150,1469,1470,1473],{},[343,1471,1472],{},"GET \u002Ftrigger\u002F:id"," — reproducir (fácil de probar en el navegador)",[150,1475,1476,1463,1479,1481],{},[343,1477,1478],{},"POST \u002Fstop",[343,1480,1466],{}," opcional — detener un sonido o todos",[150,1483,1484,1487],{},[343,1485,1486],{},"GET \u002Fws"," — estado en vivo; enviar comandos trigger\u002Fstop de entrada",{"title":107,"searchDepth":108,"depth":108,"links":1489},[1490,1491,1492,1493,1494],{"id":1294,"depth":108,"text":1295},{"id":1329,"depth":108,"text":198},{"id":1367,"depth":108,"text":1368},{"id":1394,"depth":108,"text":1395},{"id":1430,"depth":108,"text":1431},"Dispara SoundNinja desde Bitfocus Companion en la red local.",{},7,"\u002Fremote-control",{"title":1283,"description":1495},"remote-control","ph5vfcZDpw1R_Zj_L4KkovRHKYPdInfF4l4V_nT9tT4",{"id":4,"title":5,"body":1503,"description":115,"extension":116,"meta":1564,"navigation":118,"order":119,"path":120,"seo":1565,"stem":122,"__hash__":123},{"type":7,"value":1504,"toc":1557},[1505,1507,1509,1511,1513,1518,1524,1526,1530,1532,1541,1543,1551,1553],[10,1506,5],{"id":12},[14,1508,16],{},[18,1510,21],{"id":20},[14,1512,24],{},[14,1514,1515],{},[28,1516,33],{"href":30,"rel":1517},[32],[14,1519,36,1520,41,1522,45],{},[38,1521,40],{},[38,1523,44],{},[18,1525,49],{"id":48},[14,1527,52,1528],{},[28,1529,56],{"href":55},[18,1531,60],{"id":59},[14,1533,63,1534,66,1536,71,1538,77],{},[38,1535,40],{},[28,1537,70],{"href":69},[28,1539,76],{"href":74,"rel":1540},[32],[18,1542,81],{"id":80},[14,1544,84,1545,90,1548,77],{},[28,1546,89],{"href":87,"rel":1547},[32],[28,1549,95],{"href":93,"rel":1550},[32],[18,1552,99],{"id":98},[14,1554,102,1555,77],{},[28,1556,99],{"href":105},{"title":107,"searchDepth":108,"depth":108,"links":1558},[1559,1560,1561,1562,1563],{"id":20,"depth":108,"text":21},{"id":48,"depth":108,"text":49},{"id":59,"depth":108,"text":60},{"id":80,"depth":108,"text":81},{"id":98,"depth":108,"text":99},{},{"title":5,"description":115},1789586417485]