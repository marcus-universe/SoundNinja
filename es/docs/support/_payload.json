[{"data":1,"prerenderedAt":1304},["ShallowReactive",2],{"docs-page-es-\u002Fsupport":3,"docs-nav-es":124},{"id":4,"title":5,"body":6,"description":115,"extension":116,"meta":117,"navigation":118,"order":119,"path":120,"seo":121,"stem":122,"__hash__":123},"content_es\u002Fsupport.md","Soporte",{"type":7,"value":8,"toc":106},"minimark",[9,13,17,22,25,34,46,50,57,61,78,82,96,100],[10,11,5],"h1",{"id":12},"soporte",[14,15,16],"p",{},"SoundNinja es un proyecto comunitario en beta temprana. La forma más rápida de pedir ayuda es GitHub.",[18,19,21],"h2",{"id":20},"reportar-un-error-o-hacer-una-pregunta","Reportar un error o hacer una pregunta",[14,23,24],{},"Abre un issue en GitHub:",[14,26,27],{},[28,29,33],"a",{"href":30,"rel":31},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fissues",[32],"nofollow","github.com\u002Fmarcus-universe\u002FSoundNinja\u002Fissues",[14,35,36,37,41,42,45],{},"Incluye tu SO, la versión de SoundNinja (",[38,39,40],"strong",{},"Ayuda → Buscar actualizaciones"," o ",[38,43,44],{},"Ajustes → Acerca de",") y los pasos para reproducirlo.",[18,47,49],{"id":48},"correo","Correo",[14,51,52,53],{},"Contacto del mantenedor: ",[28,54,56],{"href":55},"mailto:contact@marcus-universe.de","contact@marcus-universe.de",[18,58,60],{"id":59},"actualizaciones","Actualizaciones",[14,62,63,64,66,67,71,72,77],{},"En la app, usa ",[38,65,40],{},". Las builds nuevas también aparecen en la ",[28,68,70],{"href":69},"\u002Fdownload","página de descarga"," y en ",[28,73,76],{"href":74,"rel":75},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Freleases",[32],"GitHub Releases",".",[18,79,81],{"id":80},"contribuir","Contribuir",[14,83,84,85,90,91,77],{},"Los pull requests son bienvenidos. El repo de la app es ",[28,86,89],{"href":87,"rel":88},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja",[32],"github.com\u002Fmarcus-universe\u002FSoundNinja",". El proyecto está bajo licencia ",[28,92,95],{"href":93,"rel":94},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fblob\u002Fmain\u002FLICENSE",[32],"GPL-3.0",[18,97,99],{"id":98},"aviso-legal","Aviso legal",[14,101,102,103,77],{},"Aviso legal y datos de contacto: ",[28,104,99],{"href":105},"\u002Fimpressum",{"title":107,"searchDepth":108,"depth":108,"links":109},"",2,[110,111,112,113,114],{"id":20,"depth":108,"text":21},{"id":48,"depth":108,"text":49},{"id":59,"depth":108,"text":60},{"id":80,"depth":108,"text":81},{"id":98,"depth":108,"text":99},"Dónde pedir ayuda y reportar errores.","md",{},true,8,"\u002Fsupport",{"title":5,"description":115},"support","a00is-hTbQUOnHv2YiZDFMQVyUfDSKLK4GccVuiJQ9c",[125,245,437,585,741,877,1019,1240],{"id":126,"title":127,"body":128,"description":238,"extension":116,"meta":239,"navigation":118,"order":240,"path":241,"seo":242,"stem":243,"__hash__":244},"content_es\u002Foverview.md","Resumen",{"type":7,"value":129,"toc":232},[130,133,136,139,142,146,162,166,196,200,207,211],[10,131,127],{"id":132},"resumen",[14,134,135],{},"SoundNinja es un soundboard de código abierto para streaming en directo, charlas con amigos y grabación de podcasts. Está construido con Tauri v2 y Nuxt 4 para que sea ligero en RAM y disco.",[14,137,138],{},"El objetivo es simple: mantener una biblioteca enorme fácil de recorrer y reproducir el clip correcto en milisegundos. La interfaz también funciona bien como panel en VR.",[14,140,141],{},"SoundNinja sigue en desarrollo temprano. Las funciones marchan, pero no todas las plataformas están del todo probadas.",[18,143,145],{"id":144},"para-quién","Para quién",[147,148,149,153,156,159],"ul",{},[150,151,152],"li",{},"Streamers que necesitan cues de sonido al instante",[150,154,155],{},"Amigos que quieren un tablero compartido para el chat de voz",[150,157,158],{},"Podcasters que graban clips y los sueltan en un tablero",[150,160,161],{},"Quien quiera un soundboard personalizable y local-first",[18,163,165],{"id":164},"qué-puedes-hacer","Qué puedes hacer",[147,167,168,171,174,177,180,183,190,193],{},[150,169,170],{},"Montar un soundboard con tus propios archivos de audio",[150,172,173],{},"Organizar sonidos en pestañas de colores, grupos y búsqueda",[150,175,176],{},"Diseñar el aspecto con el Theme Creator",[150,178,179],{},"Grabar audio del PC o un micrófono en el Record Editor",[150,181,182],{},"Asignar atajos a sonidos individuales",[150,184,185,186],{},"Disparar sonidos desde ",[28,187,189],{"href":188},"\u002Fdocs\u002Fremote-control","Bitfocus Companion",[150,191,192],{},"Importar y exportar un soundboard completo para compartirlo",[150,194,195],{},"Usar GIFs o imágenes en los botones de sonido",[18,197,199],{"id":198},"licencia","Licencia",[14,201,202,203,206],{},"SoundNinja es software libre bajo ",[28,204,95],{"href":93,"rel":205},[32],". Haz fork, cámbialo, compártelo.",[18,208,210],{"id":209},"siguientes-pasos","Siguientes pasos",[212,213,214,220,226],"ol",{},[150,215,216],{},[28,217,219],{"href":218},"\u002Fdocs\u002Finstallation","Instalar SoundNinja",[150,221,222],{},[28,223,225],{"href":224},"\u002Fdocs\u002Fadding-sounds","Añadir sonidos",[150,227,228],{},[28,229,231],{"href":230},"\u002Fdocs\u002Forganizing-sounds","Organizar tu tablero",{"title":107,"searchDepth":108,"depth":108,"links":233},[234,235,236,237],{"id":144,"depth":108,"text":145},{"id":164,"depth":108,"text":165},{"id":198,"depth":108,"text":199},{"id":209,"depth":108,"text":210},"Qué es SoundNinja y qué puedes hacer con él.",{},1,"\u002Foverview",{"title":127,"description":238},"overview","_jbFAqK9Ea28XfzNs3a2S9mJrWOMez_Uxtm9qlYTevc",{"id":246,"title":247,"body":248,"description":431,"extension":116,"meta":432,"navigation":118,"order":108,"path":433,"seo":434,"stem":435,"__hash__":436},"content_es\u002Finstallation.md","Instalación",{"type":7,"value":249,"toc":424},[250,253,264,268,285,288,292,306,309,313,338,349,351,357,361,375,405,420],[10,251,247],{"id":252},"instalación",[14,254,255,256,258,259,263],{},"Consigue una build en la ",[28,257,70],{"href":69}," o en ",[28,260,76],{"href":261,"rel":262},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Freleases\u002Flatest",[32],". SoundNinja está en desarrollo temprano, así que trata las builds como beta.",[18,265,267],{"id":266},"windows","Windows",[147,269,270,279,282],{},[150,271,272,41,275,278],{},[38,273,274],{},"Instalador (.exe)",[38,276,277],{},"MSI (.msi)"," para Windows de 64 bits",[150,280,281],{},"Objetivo de la landing: Windows 10 y posterior",[150,283,284],{},"El README de la app también lista Windows 8 y superior",[14,286,287],{},"Ejecuta el instalador y luego abre SoundNinja desde el menú Inicio.",[18,289,291],{"id":290},"macos","macOS",[147,293,294,300,303],{},[150,295,296,299],{},[38,297,298],{},".dmg universal"," para Apple Silicon e Intel",[150,301,302],{},"Objetivo de la landing: macOS 10.14 y posterior",[150,304,305],{},"El README de la app lista macOS 10.15 y superior",[14,307,308],{},"Abre la imagen de disco y arrastra SoundNinja a Aplicaciones.",[18,310,312],{"id":311},"linux","Linux",[147,314,315,321,327,335],{},[150,316,317,320],{},[38,318,319],{},"Debian (.deb)"," para Ubuntu \u002F Debian",[150,322,323,326],{},[38,324,325],{},"AppImage"," para otras distros",[150,328,329,330,334],{},"Tras publicar una release, los usuarios de Arch pueden instalar ",[331,332,333],"code",{},"soundninja-bin"," desde el AUR",[150,336,337],{},"Probado en Ubuntu 20.04",[14,339,340,341,344,345,348],{},"Las builds de escritorio necesitan paquetes WebKit y GTK. En Debian\u002FUbuntu eso suele ser ",[331,342,343],{},"libwebkit2gtk",", ",[331,346,347],{},"libgtk-3-0"," y una biblioteca app-indicator.",[18,350,60],{"id":59},[14,352,353,354,356],{},"En la app, abre ",[38,355,40],{},". También puedes dejar que SoundNinja compruebe al arrancar en Ajustes.",[18,358,360],{"id":359},"compilar-desde-el-código","Compilar desde el código",[14,362,363,364,368,369,374],{},"¿Necesitas una build personalizada? Clona ",[28,365,367],{"href":87,"rel":366},[32],"el repo",", instala los ",[28,370,373],{"href":371,"rel":372},"https:\u002F\u002Fv2.tauri.app\u002Fstart\u002Fprerequisites\u002F",[32],"requisitos de Tauri"," y luego:",[376,377,381],"pre",{"className":378,"code":379,"language":380,"meta":107,"style":107},"language-bash shiki shiki-themes github-light github-dark","bun install\nbun run tauri:serve\n","bash",[331,382,383,395],{"__ignoreMap":107},[384,385,387,391],"span",{"class":386,"line":240},"line",[384,388,390],{"class":389},"sScJk","bun",[384,392,394],{"class":393},"sZZnC"," install\n",[384,396,397,399,402],{"class":386,"line":108},[384,398,390],{"class":389},[384,400,401],{"class":393}," run",[384,403,404],{"class":393}," tauri:serve\n",[14,406,407,344,410,41,413,416,417,77],{},[331,408,409],{},"npm",[331,411,412],{},"pnpm",[331,414,415],{},"deno"," también sirven. Build de producción: ",[331,418,419],{},"bun run tauri:build",[421,422,423],"style",{},"html pre.shiki code .sScJk, html code.shiki .sScJk{--shiki-default:#6F42C1;--shiki-dark:#B392F0}html pre.shiki code .sZZnC, html code.shiki .sZZnC{--shiki-default:#032F62;--shiki-dark:#9ECBFF}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html.dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}",{"title":107,"searchDepth":108,"depth":108,"links":425},[426,427,428,429,430],{"id":266,"depth":108,"text":267},{"id":290,"depth":108,"text":291},{"id":311,"depth":108,"text":312},{"id":59,"depth":108,"text":60},{"id":359,"depth":108,"text":360},"Instala SoundNinja en Windows, macOS o Linux.",{},"\u002Finstallation",{"title":247,"description":431},"installation","DZ0nnkuNJ5bWc2nnZMQjtBcj72EEzzogekGEbJUmx80",{"id":438,"title":225,"body":439,"description":578,"extension":116,"meta":579,"navigation":118,"order":580,"path":581,"seo":582,"stem":583,"__hash__":584},"content_es\u002Fadding-sounds.md",{"type":7,"value":440,"toc":570},[441,444,447,451,470,474,505,509,528,532,546,549,553,560,564],[10,442,225],{"id":443},"añadir-sonidos",[14,445,446],{},"Un tablero está vacío hasta que añades clips. SoundNinja puede importar archivos, carpetas enteras, una grabación o un pack de soundboard compartido.",[18,448,450],{"id":449},"importar-archivos-de-audio","Importar archivos de audio",[212,452,453,464,467],{},[150,454,455,456,459,460,463],{},"Abre ",[38,457,458],{},"Archivo → Importar archivos de audio",", o usa ",[38,461,462],{},"Importar"," en la barra de navegación.",[150,465,466],{},"Elige uno o más archivos de audio.",[150,468,469],{},"Los sonidos llegan a la pestaña actual.",[18,471,473],{"id":472},"importar-carpetas","Importar carpetas",[212,475,476,485,488],{},[150,477,455,478,481,482,484],{},[38,479,480],{},"Archivo → Importar carpetas"," (o ",[38,483,473],{}," en la barra de navegación).",[150,486,487],{},"Añade una o más carpetas. Arrastra para reordenarlas antes de importar.",[150,489,490,491],{},"Elige cómo llegan:\n",[147,492,493,499],{},[150,494,495,498],{},[38,496,497],{},"Importar como pestañas"," — cada carpeta se convierte en su propia pestaña",[150,500,501,504],{},[38,502,503],{},"Importar a la pestaña actual"," — cada archivo va a la pestaña activa",[18,506,508],{"id":507},"grabar-un-clip","Grabar un clip",[14,510,511,512,516,517,520,521,41,524,527],{},"Abre el ",[28,513,515],{"href":514},"\u002Fdocs\u002Frecording-editor","Record Editor"," desde el botón ",[38,518,519],{},"Grabar"," en la barra del reproductor. Captura, recorta y luego ",[38,522,523],{},"Importar selección",[38,525,526],{},"Importar todo"," en la pestaña actual o en una pestaña que elijas.",[18,529,531],{"id":530},"importar-un-soundboard","Importar un soundboard",[14,533,534,537,538,541,542,545],{},[38,535,536],{},"Archivo → Importar soundboard"," carga un pack compartido. Los packs son un ",[331,539,540],{},".zip"," que contiene ",[331,543,544],{},"project.sninja"," más los archivos de sonido. Tras importar, abre el proyecto y reproduce.",[14,547,548],{},"También puedes tener varios proyectos (perfiles). Usa el selector de proyecto para cambiar de tablero.",[18,550,552],{"id":551},"reenlazar-archivos-faltantes","Reenlazar archivos faltantes",[14,554,555,556,559],{},"Si los archivos de audio se mueven en el disco, SoundNinja muestra ",[38,557,558],{},"Archivos de sonido faltantes",". Elige una carpeta para buscar y reenlazar los clips.",[18,561,563],{"id":562},"siguiente","Siguiente",[14,565,566,567,77],{},"Organiza pestañas, grupos y atajos en ",[28,568,569],{"href":230},"Organizar sonidos",{"title":107,"searchDepth":108,"depth":108,"links":571},[572,573,574,575,576,577],{"id":449,"depth":108,"text":450},{"id":472,"depth":108,"text":473},{"id":507,"depth":108,"text":508},{"id":530,"depth":108,"text":531},{"id":551,"depth":108,"text":552},{"id":562,"depth":108,"text":563},"Importa audio, carpetas, grabaciones y soundboards compartidos.",{},3,"\u002Fadding-sounds",{"title":225,"description":578},"adding-sounds","Pp2z7pkBymoeTp058Pu8gOujI6GqQLoQ-Go0ZA2L1F4",{"id":586,"title":569,"body":587,"description":734,"extension":116,"meta":735,"navigation":118,"order":736,"path":737,"seo":738,"stem":739,"__hash__":740},"content_es\u002Forganizing-sounds.md",{"type":7,"value":588,"toc":725},[589,592,595,599,626,633,637,640,654,661,665,672,676,687,691,694,698,701,707,713,717],[10,590,569],{"id":591},"organizar-sonidos",[14,593,594],{},"SoundNinja está hecho para bibliotecas grandes. Usa pestañas, grupos, búsqueda y atajos para que el clip que necesitas esté a un clic (o una tecla) de distancia.",[18,596,598],{"id":597},"pestañas","Pestañas",[147,600,601,608,615],{},[150,602,603,604,607],{},"Añade una pestaña con ",[38,605,606],{},"Añadir pestaña",". Dale un color para escanear la barra rápido.",[150,609,610,611,614],{},"La vista ",[38,612,613],{},"Todos"," muestra cada sonido de todas las pestañas.",[150,616,617,618,621,622,625],{},"Un sonido puede pertenecer a ",[38,619,620],{},"una o más pestañas",". Clic derecho en un sonido y usa ",[38,623,624],{},"Mover a pestaña"," para asignarlo.",[14,627,628,629,632],{},"Las transiciones de pestaña están en ",[38,630,631],{},"Ajustes → General",": Slide, Fade, Botones uno a uno, o Ninguna.",[18,634,636],{"id":635},"grupos","Grupos",[14,638,639],{},"Desde la v0.5.3, los separadores pueden convertirse en grupos con nombre:",[147,641,642,645,648,651],{},[150,643,644],{},"Añadir, renombrar o quitar un grupo desde el menú contextual",[150,646,647],{},"Arrastra la cabecera del grupo — los hijos se mueven con ella",[150,649,650],{},"Suelta sonidos dentro o fuera de un grupo",[150,652,653],{},"Define color de borde, color del nombre y alineación de botones (o usa el valor por defecto de la pestaña)",[14,655,656,657,660],{},"Sigue pudiendo añadir un ",[38,658,659],{},"Separador"," simple si solo necesitas un corte visual.",[18,662,664],{"id":663},"búsqueda","Búsqueda",[14,666,667,668,671],{},"Usa el campo ",[38,669,670],{},"Buscar"," en la barra de navegación. Los resultados se actualizan mientras escribes.",[18,673,675],{"id":674},"reordenar","Reordenar",[14,677,678,679,682,683,686],{},"Activa arrastrar y soltar en ",[38,680,681],{},"Ajustes → Comportamiento"," (",[38,684,685],{},"Permitir reordenar","). Luego arrastra sonidos y grupos a su sitio.",[18,688,690],{"id":689},"edición-masiva","Edición masiva",[14,692,693],{},"Selecciona varios sonidos y cambia el color, muévelos a una pestaña o elimínalos de una vez.",[18,695,697],{"id":696},"atajos-e-ids-de-sonido","Atajos e IDs de sonido",[14,699,700],{},"Cada sonido tiene un ID de 8 caracteres. Cópialo desde el menú contextual del botón o el chip de ID de la selección múltiple.",[14,702,455,703,706],{},[38,704,705],{},"Ajustes → Atajos"," para vincular una tecla a un ID de sonido. Los atajos globales son opcionales.",[14,708,709,710,712],{},"El mismo ID es el que ",[28,711,189],{"href":188}," usa para disparar un clip.",[18,714,716],{"id":715},"gifs-y-colores","GIFs y colores",[14,718,719,720,724],{},"Clic derecho en un sonido para definir colores por botón o un fondo GIF \u002F imagen. Eso es independiente del ",[28,721,723],{"href":722},"\u002Fdocs\u002Ftheme-editor","Theme Creator",", que da estilo a todo el tablero.",{"title":107,"searchDepth":108,"depth":108,"links":726},[727,728,729,730,731,732,733],{"id":597,"depth":108,"text":598},{"id":635,"depth":108,"text":636},{"id":663,"depth":108,"text":664},{"id":674,"depth":108,"text":675},{"id":689,"depth":108,"text":690},{"id":696,"depth":108,"text":697},{"id":715,"depth":108,"text":716},"Pestañas, grupos, búsqueda, edición masiva y atajos.",{},4,"\u002Forganizing-sounds",{"title":569,"description":734},"organizing-sounds","L2-ttc1gCTlJQIkJYckTzh-JzPPPTLU4m0uGjwPApXk",{"id":742,"title":743,"body":744,"description":870,"extension":116,"meta":871,"navigation":118,"order":872,"path":873,"seo":874,"stem":875,"__hash__":876},"content_es\u002Ftheme-editor.md","Editor de temas",{"type":7,"value":745,"toc":864},[746,749,755,759,786,789,793,807,811,837,840,844,850],[10,747,743],{"id":748},"editor-de-temas",[14,750,751,752,77],{},"El Theme Creator es el editor visual completo de tu tablero. Ábrelo desde ",[38,753,754],{},"Ajustes → General → Theme Creator",[18,756,758],{"id":757},"tres-pestañas","Tres pestañas",[212,760,761,775,781],{},[150,762,763,766,767,770,771,774],{},[38,764,765],{},"General"," — nombre del tema, colores compartidos y carga de fuentes (",[331,768,769],{},".ttf"," \u002F ",[331,772,773],{},".otf",")",[150,776,777,780],{},[38,778,779],{},"Botones"," — colores, tipo, diseño y overlay GIF de los botones de sonido",[150,782,783,785],{},[38,784,598],{}," — colores, tipo y grosor de borde de la barra de pestañas",[14,787,788],{},"Una vista previa en vivo muestra pestañas y botones mientras editas.",[18,790,792],{"id":791},"qué-puedes-cambiar","Qué puedes cambiar",[147,794,795,798,801,804],{},[150,796,797],{},"Colores primario y de acento, fondos, colores de botones, colores de pestañas",[150,799,800],{},"Familia y tamaño de fuente de botones y pestañas",[150,802,803],{},"Ancho, radio, borde, huecos y padding de los botones",[150,805,806],{},"Opacidad del overlay GIF (normal y hover)",[18,808,810],{"id":809},"guardar-y-compartir","Guardar y compartir",[147,812,813,819,825,831],{},[150,814,815,818],{},[38,816,817],{},"Exportar .css"," — escribe un archivo de tema para respaldar o enviar a un amigo",[150,820,821,824],{},[38,822,823],{},"Añadir a temas"," — guarda el archivo en tu carpeta Themes y aplícalo",[150,826,827,830],{},[38,828,829],{},"Importar .css"," — carga un preset integrado o un tema guardado",[150,832,833,836],{},[38,834,835],{},"Restablecer"," — vuelve a los valores por defecto de SoundNinja",[14,838,839],{},"Si cierras la ventana con cambios sin guardar, SoundNinja te pide que guardes primero.",[18,841,843],{"id":842},"sin-el-editor-completo","Sin el editor completo",[14,845,846,847,849],{},"En ",[38,848,631],{}," aún puedes:",[147,851,852,855,861],{},[150,853,854],{},"Elegir un tema de la lista",[150,856,857,858,774],{},"Editar variables CSS en vivo (",[38,859,860],{},"CSS personalizado",[150,862,863],{},"Importar un archivo de tema a la carpeta Themes",{"title":107,"searchDepth":108,"depth":108,"links":865},[866,867,868,869],{"id":757,"depth":108,"text":758},{"id":791,"depth":108,"text":792},{"id":809,"depth":108,"text":810},{"id":842,"depth":108,"text":843},"Diseña colores, fuentes, botones y pestañas en el Theme Creator.",{},5,"\u002Ftheme-editor",{"title":743,"description":870},"theme-editor","bPcJP7OLtBsnNMYJ-S1J6DmB6nngULo1_Q1hBJMNZAQ",{"id":878,"title":879,"body":880,"description":1012,"extension":116,"meta":1013,"navigation":118,"order":1014,"path":1015,"seo":1016,"stem":1017,"__hash__":1018},"content_es\u002Frecording-editor.md","Editor de grabación",{"type":7,"value":881,"toc":1006},[882,885,891,895,901,921,924,928,953,957,971,975,989,996],[10,883,879],{"id":884},"editor-de-grabación",[14,886,887,888,890],{},"Graba un clip dentro de SoundNinja, recórtalo e impórtalo a una pestaña. Abre el editor con el botón ",[38,889,519],{}," en la barra del reproductor.",[18,892,894],{"id":893},"elegir-una-entrada","Elegir una entrada",[14,896,846,897,900],{},[38,898,899],{},"Ajustes → Audio",":",[147,902,903,909,915],{},[150,904,905,908],{},[38,906,907],{},"Dispositivos de entrada"," — micrófono",[150,910,911,914],{},[38,912,913],{},"Dispositivos de salida (audio del PC)"," — loopback de lo que reproduce el PC",[150,916,917,920],{},[38,918,919],{},"Volumen de entrada"," — ganancia de captura del 0 % al 200 %",[14,922,923],{},"El botón Grabar usa el dispositivo que eliges aquí.",[18,925,927],{"id":926},"editar-la-toma","Editar la toma",[147,929,930,933,936,944,947,950],{},[150,931,932],{},"Grabar y detener",[150,934,935],{},"Observar el medidor de nivel de entrada",[150,937,938,41,941],{},[38,939,940],{},"Normalizar",[38,942,943],{},"Cancelación de ruido",[150,945,946],{},"Recortar todo el clip, recortar a una selección o borrar una selección",[150,948,949],{},"Deshacer \u002F rehacer",[150,951,952],{},"Acercar y alejar",[18,954,956],{"id":955},"preparar-e-importar","Preparar e importar",[212,958,959,962,965],{},[150,960,961],{},"Añade la selección o la pista completa a la lista de staging.",[150,963,964],{},"La lista empieza vacía: graba, edita y luego añade un clip.",[150,966,967,41,969,527],{},[38,968,523],{},[38,970,526],{},[18,972,974],{"id":973},"separación-de-stems-opcional","Separación de stems (opcional)",[14,976,977,978,41,981,984,985,988],{},"El Record Editor puede conservar ",[38,979,980],{},"voces",[38,982,983],{},"música"," con BS-RoFormer. El modelo pesa unos 158 MB y ",[38,986,987],{},"no"," viene incluido con la app.",[14,990,991,992,995],{},"Descárgalo desde ",[38,993,994],{},"Ajustes → Separación de stems",", o acepta el aviso del primer arranque. El instalador de Windows también puede ofrecer descargar el modelo al primer inicio.",[14,997,998,999,770,1002,1005],{},"Las builds desde código con stems necesitan un flag extra (",[331,1000,1001],{},"tauri:serve:stems",[331,1003,1004],{},"tauri:build:stems",").",{"title":107,"searchDepth":108,"depth":108,"links":1007},[1008,1009,1010,1011],{"id":893,"depth":108,"text":894},{"id":926,"depth":108,"text":927},{"id":955,"depth":108,"text":956},{"id":973,"depth":108,"text":974},"Captura micrófono o audio del PC, edita el clip y suéltalo en tu tablero.",{},6,"\u002Frecording-editor",{"title":879,"description":1012},"recording-editor","6kXc1zcNP9ffTeowsG3fPS8NGId-wyGEWWxVXslWkZE",{"id":1020,"title":1021,"body":1022,"description":1233,"extension":116,"meta":1234,"navigation":118,"order":1235,"path":1236,"seo":1237,"stem":1238,"__hash__":1239},"content_es\u002Fremote-control.md","Control remoto",{"type":7,"value":1023,"toc":1226},[1024,1027,1030,1034,1062,1065,1068,1103,1107,1127,1130,1134,1166,1170,1176],[10,1025,1021],{"id":1026},"control-remoto",[14,1028,1029],{},"SoundNinja puede escuchar en tu red local para que Bitfocus Companion (o cualquier cliente HTTP\u002FWebSocket) reproduzca y detenga sonidos.",[18,1031,1033],{"id":1032},"activar-el-servidor-remoto","Activar el servidor remoto",[212,1035,1036,1041,1047,1053],{},[150,1037,455,1038,77],{},[38,1039,1040],{},"Ajustes → Remoto",[150,1042,1043,1044,77],{},"Activa el servidor remoto. El puerto por defecto es ",[38,1045,1046],{},"7331",[150,1048,1049,1050,77],{},"Opcional: define un token. Los clientes deben enviarlo como Bearer token o ",[331,1051,1052],{},"?token=",[150,1054,1055,1056,1059,1060,77],{},"Copia la URL ",[331,1057,1058],{},"http:\u002F\u002FIP:PORT",", o copia la IP del sistema desde ",[38,1061,44],{},[14,1063,1064],{},"Windows puede mostrar un aviso del firewall la primera vez que arranca el servidor. Permite el acceso a la red privada.",[18,1066,189],{"id":1067},"bitfocus-companion",[212,1069,1070,1077,1086,1096],{},[150,1071,1072,1073,77],{},"Instala ",[28,1074,189],{"href":1075,"rel":1076},"https:\u002F\u002Fbitfocus.io\u002Fcompanion",[32],[150,1078,1079,1080,1085],{},"Descarga ",[28,1081,1084],{"href":1082,"rel":1083},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Freleases\u002Flatest\u002Fdownload\u002Fcompanion-module-soundninja.tgz",[32],"companion-module-soundninja.tgz",". Aún no hay paquete en Companion Store.",[150,1087,1088,1089,1092,1093,77],{},"En Companion: ",[38,1090,1091],{},"Modules → Load module package"," y elige el ",[331,1094,1095],{},".tgz",[150,1097,1098,1099,1102],{},"Añade una conexión ",[38,1100,1101],{},"Sound Ninja",". Pega la IP del PC, el puerto y el token si definiste uno.",[18,1104,1106],{"id":1105},"acciones","Acciones",[147,1108,1109,1115,1121],{},[150,1110,1111,1114],{},[38,1112,1113],{},"Trigger Sound"," — elige en el menú desplegable en vivo, o escribe un ID de sonido de 8 caracteres (las variables de Companion funcionan)",[150,1116,1117,1120],{},[38,1118,1119],{},"Stop Sound"," — detiene un sonido en reproducción por ID",[150,1122,1123,1126],{},[38,1124,1125],{},"Stop All"," — detiene todos los sonidos en reproducción",[14,1128,1129],{},"Copia un ID de sonido en SoundNinja desde el menú contextual del botón o el chip de ID de la selección múltiple.",[18,1131,1133],{"id":1132},"feedbacks-y-variables","Feedbacks y variables",[147,1135,1136,1142,1154,1160],{},[150,1137,1138,1141],{},[38,1139,1140],{},"Sound Playing"," — verdadero mientras ese ID de sonido está activo (úsalo para el color del botón)",[150,1143,1144,1147,1148,770,1151],{},[331,1145,1146],{},"$(soundninja:connected)"," — ",[331,1149,1150],{},"true",[331,1152,1153],{},"false",[150,1155,1156,1159],{},[331,1157,1158],{},"$(soundninja:playing_count)"," — cuántos sonidos suenan",[150,1161,1162,1165],{},[331,1163,1164],{},"$(soundninja:last_triggered)"," — último ID de sonido disparado",[18,1167,1169],{"id":1168},"api-http-avanzado","API HTTP (avanzado)",[14,1171,1172,1173],{},"Ruta base: ",[331,1174,1175],{},"\u002Fapi\u002Fv1",[147,1177,1178,1184,1190,1196,1206,1212,1220],{},[150,1179,1180,1183],{},[331,1181,1182],{},"GET \u002Finfo"," — nombre de la app, versión, protocolo, si se requiere un token",[150,1185,1186,1189],{},[331,1187,1188],{},"GET \u002Fsounds"," — lista de sonidos (id, name, tabs, active)",[150,1191,1192,1195],{},[331,1193,1194],{},"GET \u002Fstate"," — sonidos más IDs que suenan ahora",[150,1197,1198,1201,1202,1205],{},[331,1199,1200],{},"POST \u002Ftrigger"," con ",[331,1203,1204],{},"{ \"id\" }"," — reproducir un sonido",[150,1207,1208,1211],{},[331,1209,1210],{},"GET \u002Ftrigger\u002F:id"," — reproducir (fácil de probar en el navegador)",[150,1213,1214,1201,1217,1219],{},[331,1215,1216],{},"POST \u002Fstop",[331,1218,1204],{}," opcional — detener un sonido o todos",[150,1221,1222,1225],{},[331,1223,1224],{},"GET \u002Fws"," — estado en vivo; enviar comandos trigger\u002Fstop de entrada",{"title":107,"searchDepth":108,"depth":108,"links":1227},[1228,1229,1230,1231,1232],{"id":1032,"depth":108,"text":1033},{"id":1067,"depth":108,"text":189},{"id":1105,"depth":108,"text":1106},{"id":1132,"depth":108,"text":1133},{"id":1168,"depth":108,"text":1169},"Dispara SoundNinja desde Bitfocus Companion en la red local.",{},7,"\u002Fremote-control",{"title":1021,"description":1233},"remote-control","FXZNdlLVwqBTHCjLmpjNr2ZHY0S5NmW5TzHr5uUtI7U",{"id":4,"