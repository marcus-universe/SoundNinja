[{"data":1,"prerenderedAt":1587},["ShallowReactive",2],{"docs-page-es-\u002Fsupport":3,"docs-nav-es":124},{"id":4,"title":5,"body":6,"description":115,"extension":116,"meta":117,"navigation":118,"order":119,"path":120,"seo":121,"stem":122,"__hash__":123},"content_es\u002Fsupport.md","Soporte",{"type":7,"value":8,"toc":106},"minimark",[9,13,17,22,25,34,46,50,57,61,78,82,96,100],[10,11,5],"h1",{"id":12},"soporte",[14,15,16],"p",{},"SoundNinja es un proyecto comunitario en beta temprana. La forma más rápida de pedir ayuda es GitHub.",[18,19,21],"h2",{"id":20},"reportar-un-error-o-hacer-una-pregunta","Reportar un error o hacer una pregunta",[14,23,24],{},"Abre un issue en GitHub:",[14,26,27],{},[28,29,33],"a",{"href":30,"rel":31},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fissues",[32],"nofollow","github.com\u002Fmarcus-universe\u002FSoundNinja\u002Fissues",[14,35,36,37,41,42,45],{},"Incluye tu SO, la versión de SoundNinja (",[38,39,40],"strong",{},"Ayuda → Buscar actualizaciones"," o ",[38,43,44],{},"Ajustes → Acerca de",") y los pasos para reproducirlo.",[18,47,49],{"id":48},"correo","Correo",[14,51,52,53],{},"Contacto del mantenedor: ",[28,54,56],{"href":55},"mailto:contact@marcus-universe.de","contact@marcus-universe.de",[18,58,60],{"id":59},"actualizaciones","Actualizaciones",[14,62,63,64,66,67,71,72,77],{},"En la app, usa ",[38,65,40],{},". Las builds nuevas también aparecen en la ",[28,68,70],{"href":69},"\u002Fdownload","página de descarga"," y en ",[28,73,76],{"href":74,"rel":75},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Freleases",[32],"GitHub Releases",".",[18,79,81],{"id":80},"contribuir","Contribuir",[14,83,84,85,90,91,77],{},"Los pull requests son bienvenidos. El repo de la app es ",[28,86,89],{"href":87,"rel":88},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja",[32],"github.com\u002Fmarcus-universe\u002FSoundNinja",". El proyecto está bajo licencia ",[28,92,95],{"href":93,"rel":94},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fblob\u002Fmain\u002FLICENSE",[32],"GPL-3.0",[18,97,99],{"id":98},"aviso-legal","Aviso legal",[14,101,102,103,77],{},"Aviso legal y datos de contacto: ",[28,104,99],{"href":105},"\u002Fimpressum",{"title":107,"searchDepth":108,"depth":108,"links":109},"",2,[110,111,112,113,114],{"id":20,"depth":108,"text":21},{"id":48,"depth":108,"text":49},{"id":59,"depth":108,"text":60},{"id":80,"depth":108,"text":81},{"id":98,"depth":108,"text":99},"Dónde pedir ayuda y reportar errores.","md",{},true,8,"\u002Fsupport",{"title":5,"description":115},"support","a00is-hTbQUOnHv2YiZDFMQVyUfDSKLK4GccVuiJQ9c",[125,254,470,618,1021,1156,1302,1523],{"id":126,"title":127,"body":128,"description":247,"extension":116,"meta":248,"navigation":118,"order":249,"path":250,"seo":251,"stem":252,"__hash__":253},"content_es\u002Foverview.md","Resumen",{"type":7,"value":129,"toc":241},[130,133,136,139,142,146,162,166,205,209,216,220],[10,131,127],{"id":132},"resumen",[14,134,135],{},"SoundNinja es un soundboard de código abierto para streaming en directo, charlas con amigos y grabación de podcasts. Está construido con Tauri v2 y Nuxt 4 para que sea ligero en RAM y disco.",[14,137,138],{},"El objetivo es simple: mantener una biblioteca enorme fácil de recorrer y reproducir el clip correcto en milisegundos. La interfaz también funciona bien como panel en VR.",[14,140,141],{},"SoundNinja sigue en desarrollo temprano. Las funciones marchan, pero no todas las plataformas están del todo probadas.",[18,143,145],{"id":144},"para-quién","Para quién",[147,148,149,153,156,159],"ul",{},[150,151,152],"li",{},"Streamers que necesitan cues de sonido al instante",[150,154,155],{},"Amigos que quieren un tablero compartido para el chat de voz",[150,157,158],{},"Podcasters que graban clips y los sueltan en un tablero",[150,160,161],{},"Quien quiera un soundboard personalizable y local-first",[18,163,165],{"id":164},"qué-puedes-hacer","Qué puedes hacer",[147,167,168,171,174,177,180,183,186,189,192,199,202],{},[150,169,170],{},"Montar un soundboard con tus propios archivos de audio",[150,172,173],{},"Organizar sonidos en pestañas de colores, grupos, etiquetas y búsqueda",[150,175,176],{},"Filtrar por etiquetas (OR) y ordenar por nombre, fecha, duración o tamaño",[150,178,179],{},"Selección múltiple con marco o rango Mayús, luego color, mover o borrar en lote",[150,181,182],{},"Ajustar el volumen por sonido desde el menú contextual",[150,184,185],{},"Diseñar el aspecto con el Theme Creator",[150,187,188],{},"Grabar audio del PC o un micrófono en el Record Editor",[150,190,191],{},"Asignar atajos a sonidos individuales",[150,193,194,195],{},"Disparar sonidos desde ",[28,196,198],{"href":197},"\u002Fdocs\u002Fremote-control","Bitfocus Companion",[150,200,201],{},"Importar y exportar un soundboard completo para compartirlo",[150,203,204],{},"Usar GIFs o imágenes en los botones — biblioteca local de carpetas o KLIPY",[18,206,208],{"id":207},"licencia","Licencia",[14,210,211,212,215],{},"SoundNinja es software libre bajo ",[28,213,95],{"href":93,"rel":214},[32],". Haz fork, cámbialo, compártelo.",[18,217,219],{"id":218},"siguientes-pasos","Siguientes pasos",[221,222,223,229,235],"ol",{},[150,224,225],{},[28,226,228],{"href":227},"\u002Fdocs\u002Finstallation","Instalar SoundNinja",[150,230,231],{},[28,232,234],{"href":233},"\u002Fdocs\u002Fadding-sounds","Añadir sonidos",[150,236,237],{},[28,238,240],{"href":239},"\u002Fdocs\u002Forganizing-sounds","Organizar tu tablero",{"title":107,"searchDepth":108,"depth":108,"links":242},[243,244,245,246],{"id":144,"depth":108,"text":145},{"id":164,"depth":108,"text":165},{"id":207,"depth":108,"text":208},{"id":218,"depth":108,"text":219},"Qué es SoundNinja y qué puedes hacer con él.",{},1,"\u002Foverview",{"title":127,"description":247},"overview","XWpBFvtyid6BLXO3HByHppTxfsOo0i7DlSOMew5tq2g",{"id":255,"title":256,"body":257,"description":464,"extension":116,"meta":465,"navigation":118,"order":108,"path":466,"seo":467,"stem":468,"__hash__":469},"content_es\u002Finstallation.md","Instalación",{"type":7,"value":258,"toc":457},[259,262,273,277,297,300,304,318,321,325,350,361,363,369,373,387,417,432,453],[10,260,256],{"id":261},"instalación",[14,263,264,265,267,268,272],{},"Consigue una build en la ",[28,266,70],{"href":69}," o en ",[28,269,76],{"href":270,"rel":271},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Freleases\u002Flatest",[32],". SoundNinja está en desarrollo temprano, así que trata las builds como beta.",[18,274,276],{"id":275},"windows","Windows",[147,278,279,288,291,294],{},[150,280,281,41,284,287],{},[38,282,283],{},"Instalador (.exe)",[38,285,286],{},"MSI (.msi)"," para Windows de 64 bits",[150,289,290],{},"Objetivo de la landing: Windows 10 y posterior",[150,292,293],{},"El README de la app también lista Windows 8 y superior",[150,295,296],{},"El instalador NSIS usa tema oscuro. Elige idioma en el setup — SoundNinja lo recuerda en el siguiente arranque.",[14,298,299],{},"Ejecuta el instalador y luego abre SoundNinja desde el menú Inicio.",[18,301,303],{"id":302},"macos","macOS",[147,305,306,312,315],{},[150,307,308,311],{},[38,309,310],{},".dmg universal"," para Apple Silicon e Intel",[150,313,314],{},"Objetivo de la landing: macOS 10.14 y posterior",[150,316,317],{},"El README de la app lista macOS 10.15 y superior",[14,319,320],{},"Abre la imagen de disco y arrastra SoundNinja a Aplicaciones.",[18,322,324],{"id":323},"linux","Linux",[147,326,327,333,339,347],{},[150,328,329,332],{},[38,330,331],{},"Debian (.deb)"," para Ubuntu \u002F Debian",[150,334,335,338],{},[38,336,337],{},"AppImage"," para otras distros",[150,340,341,342,346],{},"Tras publicar una release, los usuarios de Arch pueden instalar ",[343,344,345],"code",{},"soundninja-bin"," desde el AUR",[150,348,349],{},"Probado en Ubuntu 20.04",[14,351,352,353,356,357,360],{},"Las builds de escritorio necesitan paquetes WebKit y GTK. En Debian\u002FUbuntu eso suele ser ",[343,354,355],{},"libwebkit2gtk",", ",[343,358,359],{},"libgtk-3-0"," y una biblioteca app-indicator.",[18,362,60],{"id":59},[14,364,365,366,368],{},"En la app, abre ",[38,367,40],{},". También puedes dejar que SoundNinja compruebe al arrancar en Ajustes.",[18,370,372],{"id":371},"compilar-desde-el-código","Compilar desde el código",[14,374,375,376,380,381,386],{},"¿Necesitas una build personalizada? Clona ",[28,377,379],{"href":87,"rel":378},[32],"el repo",", instala los ",[28,382,385],{"href":383,"rel":384},"https:\u002F\u002Fv2.tauri.app\u002Fstart\u002Fprerequisites\u002F",[32],"requisitos de Tauri"," y luego:",[388,389,393],"pre",{"className":390,"code":391,"language":392,"meta":107,"style":107},"language-bash shiki shiki-themes github-light github-dark","bun install\nbun run tauri:serve\n","bash",[343,394,395,407],{"__ignoreMap":107},[396,397,399,403],"span",{"class":398,"line":249},"line",[396,400,402],{"class":401},"sScJk","bun",[396,404,406],{"class":405},"sZZnC"," install\n",[396,408,409,411,414],{"class":398,"line":108},[396,410,402],{"class":401},[396,412,413],{"class":405}," run",[396,415,416],{"class":405}," tauri:serve\n",[14,418,419,356,422,41,425,428,429,77],{},[343,420,421],{},"npm",[343,423,424],{},"pnpm",[343,426,427],{},"deno"," también sirven. Build de producción: ",[343,430,431],{},"bun run tauri:build",[14,433,434,437,438,443,444,447,448,77],{},[38,435,436],{},"Solo Windows:"," cada compile de Windows incluye ASIO con el ",[28,439,442],{"href":440,"rel":441},"https:\u002F\u002Fwww.steinberg.net\u002Fasiosdk",[32],"Steinberg ASIO SDK",". Ejecuta ",[343,445,446],{},"bun run setup:asio"," una vez (el SDK no está en git). Linux y macOS usan PipeWire \u002F Core Audio — omite ese paso. Detalles: ",[28,449,452],{"href":450,"rel":451},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fblob\u002Fmain\u002Fdocs\u002Fbuild-from-source.md",[32],"build-from-source.md",[454,455,456],"style",{},"html pre.shiki code .sScJk, html code.shiki .sScJk{--shiki-default:#6F42C1;--shiki-dark:#B392F0}html pre.shiki code .sZZnC, html code.shiki .sZZnC{--shiki-default:#032F62;--shiki-dark:#9ECBFF}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html.dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}",{"title":107,"searchDepth":108,"depth":108,"links":458},[459,460,461,462,463],{"id":275,"depth":108,"text":276},{"id":302,"depth":108,"text":303},{"id":323,"depth":108,"text":324},{"id":59,"depth":108,"text":60},{"id":371,"depth":108,"text":372},"Instala SoundNinja en Windows, macOS o Linux.",{},"\u002Finstallation",{"title":256,"description":464},"installation","6QKa3OcTs0sq8JVvjceX-ugwL8mdPc4h6O-JOoo1Qd8",{"id":471,"title":234,"body":472,"description":611,"extension":116,"meta":612,"navigation":118,"order":613,"path":614,"seo":615,"stem":616,"__hash__":617},"content_es\u002Fadding-sounds.md",{"type":7,"value":473,"toc":603},[474,477,480,484,503,507,538,542,561,565,579,582,586,593,597],[10,475,234],{"id":476},"añadir-sonidos",[14,478,479],{},"Un tablero está vacío hasta que añades clips. SoundNinja puede importar archivos, carpetas enteras, una grabación o un pack de soundboard compartido.",[18,481,483],{"id":482},"importar-archivos-de-audio","Importar archivos de audio",[221,485,486,497,500],{},[150,487,488,489,492,493,496],{},"Abre ",[38,490,491],{},"Archivo → Importar archivos de audio",", o usa ",[38,494,495],{},"Importar"," en la barra de navegación.",[150,498,499],{},"Elige uno o más archivos de audio.",[150,501,502],{},"Los sonidos llegan a la pestaña actual.",[18,504,506],{"id":505},"importar-carpetas","Importar carpetas",[221,508,509,518,521],{},[150,510,488,511,514,515,517],{},[38,512,513],{},"Archivo → Importar carpetas"," (o ",[38,516,506],{}," en la barra de navegación).",[150,519,520],{},"Añade una o más carpetas. Arrastra para reordenarlas antes de importar.",[150,522,523,524],{},"Elige cómo llegan:\n",[147,525,526,532],{},[150,527,528,531],{},[38,529,530],{},"Importar como pestañas"," — cada carpeta se convierte en su propia pestaña",[150,533,534,537],{},[38,535,536],{},"Importar a la pestaña actual"," — cada archivo va a la pestaña activa",[18,539,541],{"id":540},"grabar-un-clip","Grabar un clip",[14,543,544,545,549,550,553,554,41,557,560],{},"Abre el ",[28,546,548],{"href":547},"\u002Fdocs\u002Frecording-editor","Record Editor"," desde el botón ",[38,551,552],{},"Grabar"," en la barra del reproductor. Captura, recorta y luego ",[38,555,556],{},"Importar selección",[38,558,559],{},"Importar todo"," en la pestaña actual o en una pestaña que elijas.",[18,562,564],{"id":563},"importar-un-soundboard","Importar un soundboard",[14,566,567,570,571,574,575,578],{},[38,568,569],{},"Archivo → Importar soundboard"," carga un pack compartido. Los packs son un ",[343,572,573],{},".zip"," que contiene ",[343,576,577],{},"project.sninja"," más los archivos de sonido. Tras importar, abre el proyecto y reproduce.",[14,580,581],{},"También puedes tener varios proyectos (perfiles). Usa el selector de proyecto para cambiar de tablero.",[18,583,585],{"id":584},"reenlazar-archivos-faltantes","Reenlazar archivos faltantes",[14,587,588,589,592],{},"Si los archivos de audio se mueven en el disco, SoundNinja muestra ",[38,590,591],{},"Archivos de sonido faltantes",". Elige una carpeta para buscar y reenlazar los clips.",[18,594,596],{"id":595},"siguiente","Siguiente",[14,598,599,600,77],{},"Organiza pestañas, etiquetas, filtros y atajos en ",[28,601,602],{"href":239},"Organizar sonidos",{"title":107,"searchDepth":108,"depth":108,"links":604},[605,606,607,608,609,610],{"id":482,"depth":108,"text":483},{"id":505,"depth":108,"text":506},{"id":540,"depth":108,"text":541},{"id":563,"depth":108,"text":564},{"id":584,"depth":108,"text":585},{"id":595,"depth":108,"text":596},"Importa audio, carpetas, grabaciones y soundboards compartidos.",{},3,"\u002Fadding-sounds",{"title":234,"description":611},"adding-sounds","O5nOJGNq2FL6jafUxqoGYNKJDVbb2UrZRjfKpK21LlQ",{"id":619,"title":602,"body":620,"description":1014,"extension":116,"meta":1015,"navigation":118,"order":1016,"path":1017,"seo":1018,"stem":1019,"__hash__":1020},"content_es\u002Forganizing-sounds.md",{"type":7,"value":621,"toc":999},[622,625,632,636,663,670,674,677,691,698,704,708,718,723,755,759,765,769,802,808,812,815,841,844,848,861,865,871,892,908,915,919,930,933,937,944,954,960,964,972,979,996],[10,623,602],{"id":624},"organizar-sonidos",[14,626,627,628,631],{},"SoundNinja está hecho para bibliotecas grandes. ",[38,629,630],{},"Etiquetas y filtros",", pestañas, búsqueda, selección múltiple y atajos — el clip que necesitas está a un clic (o una tecla).",[18,633,635],{"id":634},"pestañas","Pestañas",[147,637,638,645,652],{},[150,639,640,641,644],{},"Añade una pestaña con ",[38,642,643],{},"Añadir pestaña",". Dale un color para escanear la barra rápido.",[150,646,647,648,651],{},"La vista ",[38,649,650],{},"Todos"," muestra cada sonido de todas las pestañas.",[150,653,654,655,658,659,662],{},"Un sonido puede pertenecer a ",[38,656,657],{},"una o más pestañas",". Clic derecho en un sonido y usa ",[38,660,661],{},"Mover a pestaña"," para asignarlo.",[14,664,665,666,669],{},"Las transiciones de pestaña están en ",[38,667,668],{},"Ajustes → General",": Slide, Fade, Botones uno a uno, o Ninguna.",[18,671,673],{"id":672},"grupos","Grupos",[14,675,676],{},"Desde la v0.5.3, los separadores pueden convertirse en grupos con nombre:",[147,678,679,682,685,688],{},[150,680,681],{},"Añadir, renombrar o quitar un grupo desde el menú contextual",[150,683,684],{},"Arrastra la cabecera del grupo — los hijos se mueven con ella",[150,686,687],{},"Suelta sonidos dentro o fuera de un grupo",[150,689,690],{},"Define color de borde, color del nombre y alineación de botones (o usa el valor por defecto de la pestaña)",[14,692,693,694,697],{},"Sigue pudiendo añadir un ",[38,695,696],{},"Separador"," simple si solo necesitas un corte visual.",[14,699,700,701,77],{},"Clic derecho en el espacio vacío del tablero para ",[38,702,703],{},"Añadir grupo",[18,705,707],{"id":706},"etiquetas-filtros","Etiquetas \u002F Filtros",[14,709,710,711,714,715,717],{},"Las etiquetas cruzan las pestañas. El panel ",[38,712,713],{},"Filtro"," (barra lateral ",[38,716,713],{},") es donde las creas y filtras el tablero.",[719,720,722],"h3",{"id":721},"crear-y-editar-etiquetas","Crear y editar etiquetas",[221,724,725,730,741,748],{},[150,726,488,727,729],{},[38,728,713],{}," en la barra lateral.",[150,731,732,733,736,737,740],{},"En ",[38,734,735],{},"Etiquetas",", usa ",[38,738,739],{},"Añadir etiqueta"," — nombre y color.",[150,742,743,744,747],{},"Renombra, recolorea o ",[38,745,746],{},"Eliminar etiqueta"," en la misma lista.",[150,749,750,751,754],{},"Si ves ",[38,752,753],{},"Aún no hay etiquetas",", crea una aquí antes de asignar.",[719,756,758],{"id":757},"asignar-etiquetas-a-sonidos","Asignar etiquetas a sonidos",[14,760,761,762,764],{},"Clic derecho en un sonido → ",[38,763,735],{}," (casillas). Un sonido puede tener varias. Si aún no hay ninguna, el menú te lleva al panel de filtro.",[719,766,768],{"id":767},"filtrar-el-tablero","Filtrar el tablero",[147,770,771,777,788,799],{},[150,772,773,774,77],{},"Activa etiquetas en el panel Filtro o como ",[38,775,776],{},"chips bajo la barra de búsqueda",[150,778,779,780,783,784,787],{},"La coincidencia es ",[38,781,782],{},"OR",": un sonido sigue visible si tiene ",[38,785,786],{},"cualquiera"," de las etiquetas seleccionadas.",[150,789,790,791,794,795,798],{},"El campo ",[38,792,793],{},"Buscar"," combina con ",[38,796,797],{},"AND"," el filtro de etiquetas activo (texto + etiquetas juntos).",[150,800,801],{},"Apaga los chips (o limpia el filtro) para ver de nuevo toda la pestaña.",[14,803,804,805,77],{},"Los nombres de etiqueta en color pueden aparecer en los botones. Actívalos en ",[38,806,807],{},"Ajustes → Comportamiento → Mostrar badges de etiquetas",[18,809,811],{"id":810},"orden","Orden",[14,813,814],{},"Abre el panel de filtro y elige un modo:",[147,816,817,823],{},[150,818,819,822],{},[38,820,821],{},"Definido por el usuario"," — tu orden de pestaña, grupos visibles",[150,824,825,356,828,356,831,41,834,837,838],{},[38,826,827],{},"Nombre",[38,829,830],{},"Fecha de añadido",[38,832,833],{},"Tiempo de reproducción",[38,835,836],{},"Tamaño de archivo"," — lista plana ordenada; ",[38,839,840],{},"los grupos se ocultan",[14,842,843],{},"Ordenar por duración puede precargar los metadatos de duración la primera vez.",[18,845,847],{"id":846},"reordenar","Reordenar",[14,849,850,851,854,855,858,859,77],{},"Activa arrastrar y soltar en ",[38,852,853],{},"Ajustes → Comportamiento"," (",[38,856,857],{},"Permitir reordenar","). Luego arrastra sonidos y grupos a su sitio. Reordenar aplica en el orden ",[38,860,821],{},[18,862,864],{"id":863},"selección-múltiple","Selección múltiple",[14,866,867,868,870],{},"Activa ",[38,869,864],{}," en la barra de navegación, luego:",[147,872,873,876,882,889],{},[150,874,875],{},"Clic para alternar un sonido",[150,877,878,881],{},[38,879,880],{},"Mayús+clic"," para un rango desde el último ancla",[150,883,884,885,888],{},"Arrastra un ",[38,886,887],{},"marco"," en el espacio vacío del tablero",[150,890,891],{},"Clic en el tablero vacío (o fuera) para limpiar la selección",[14,893,894,895,356,898,356,901,904,905,77],{},"Una barra masiva muestra el recuento, más ",[38,896,897],{},"Color",[38,899,900],{},"Mover a pestaña…",[38,902,903],{},"Eliminar"," y ",[38,906,907],{},"Hecho",[14,909,910,911,914],{},"En selección múltiple, cada botón muestra un ",[38,912,913],{},"chip de ID de 8 caracteres",". Clic derecho en el chip para copiarlo.",[18,916,918],{"id":917},"volumen-por-sonido","Volumen por sonido",[14,920,921,922,925,926,929],{},"Clic derecho → ",[38,923,924],{},"Volumen",". Arrastra el control de 0 % a 100 %. ",[38,927,928],{},"Doble clic"," lo restablece a 100 %.",[14,931,932],{},"Se acumula con el volumen de salida maestro en Ajustes.",[18,934,936],{"id":935},"atajos-e-ids-de-sonido","Atajos e IDs de sonido",[14,938,939,940,943],{},"Cada sonido tiene un ID de 8 caracteres. Cópialo desde el menú contextual del botón (",[38,941,942],{},"Copiar ID",") o el chip de ID de la selección múltiple.",[14,945,488,946,949,950,953],{},[38,947,948],{},"Ajustes → Atajos"," para vincular una tecla a un ID de sonido. Los atajos globales son opcionales. ",[38,951,952],{},"Asignar atajo"," en el menú contextual salta allí con el ID rellenado.",[14,955,956,957,959],{},"El mismo ID es el que ",[28,958,198],{"href":197}," usa para disparar un clip.",[18,961,963],{"id":962},"imágenes-de-fondo-y-colores","Imágenes de fondo y colores",[14,965,966,967,971],{},"Clic derecho en un sonido para definir colores por botón o una imagen de fondo. Eso es independiente del ",[28,968,970],{"href":969},"\u002Fdocs\u002Ftheme-editor","Theme Creator",", que da estilo a todo el tablero.",[14,973,974,975,978],{},"El selector es un diálogo ",[38,976,977],{},"Imagen de fondo"," (PNG, JPEG, GIF, WebP):",[147,980,981,987],{},[150,982,983,986],{},[38,984,985],{},"Archivos locales"," — añade carpetas, elige un archivo, busca por nombre, previsualiza la cuadrícula o quita una carpeta de la biblioteca",[150,988,989,992,993,995],{},[38,990,991],{},"KLIPY"," — busca GIFs en línea. Pon tu propia clave API en ",[38,994,853],{},". La clave no se guarda en los archivos del proyecto.",[14,997,998],{},"Tras elegir, mueve y recorta la imagen en el botón.",{"title":107,"searchDepth":108,"depth":108,"links":1000},[1001,1002,1003,1008,1009,1010,1011,1012,1013],{"id":634,"depth":108,"text":635},{"id":672,"depth":108,"text":673},{"id":706,"depth":108,"text":707,"children":1004},[1005,1006,1007],{"id":721,"depth":613,"text":722},{"id":757,"depth":613,"text":758},{"id":767,"depth":613,"text":768},{"id":810,"depth":108,"text":811},{"id":846,"depth":108,"text":847},{"id":863,"depth":108,"text":864},{"id":917,"depth":108,"text":918},{"id":935,"depth":108,"text":936},{"id":962,"depth":108,"text":963},"Etiquetas, filtros, pestañas, grupos, orden, selección múltiple, volumen y atajos.",{},4,"\u002Forganizing-sounds",{"title":602,"description":1014},"organizing-sounds","0TCdzxC5d9uOHlnFnD2ygCuD63pFk5yy3tK0Xgbpa7M",{"id":1022,"title":1023,"body":1024,"description":1149,"extension":116,"meta":1150,"navigation":118,"order":1151,"path":1152,"seo":1153,"stem":1154,"__hash__":1155},"content_es\u002Ftheme-editor.md","Editor de temas",{"type":7,"value":1025,"toc":1143},[1026,1029,1035,1039,1066,1069,1073,1087,1091,1117,1120,1124,1129],[10,1027,1023],{"id":1028},"editor-de-temas",[14,1030,1031,1032,77],{},"El Theme Creator es el editor visual completo de tu tablero. Ábrelo desde ",[38,1033,1034],{},"Ajustes → General → Theme Creator",[18,1036,1038],{"id":1037},"tres-pestañas","Tres pestañas",[221,1040,1041,1055,1061],{},[150,1042,1043,1046,1047,1050,1051,1054],{},[38,1044,1045],{},"General"," — nombre del tema, colores compartidos y carga de fuentes (",[343,1048,1049],{},".ttf"," \u002F ",[343,1052,1053],{},".otf",")",[150,1056,1057,1060],{},[38,1058,1059],{},"Botones"," — colores, tipo, diseño y overlay GIF de los botones de sonido",[150,1062,1063,1065],{},[38,1064,635],{}," — colores, tipo y grosor de borde de la barra de pestañas",[14,1067,1068],{},"Una vista previa en vivo muestra pestañas y botones mientras editas.",[18,1070,1072],{"id":1071},"qué-puedes-cambiar","Qué puedes cambiar",[147,1074,1075,1078,1081,1084],{},[150,1076,1077],{},"Colores primario y de acento, fondos, colores de botones, colores de pestañas",[150,1079,1080],{},"Familia y tamaño de fuente de botones y pestañas",[150,1082,1083],{},"Ancho, radio, borde, huecos y padding de los botones",[150,1085,1086],{},"Opacidad del overlay GIF (normal y hover)",[18,1088,1090],{"id":1089},"guardar-y-compartir","Guardar y compartir",[147,1092,1093,1099,1105,1111],{},[150,1094,1095,1098],{},[38,1096,1097],{},"Exportar .css"," — escribe un archivo de tema para respaldar o enviar a un amigo",[150,1100,1101,1104],{},[38,1102,1103],{},"Añadir a temas"," — guarda el archivo en tu carpeta Themes y aplícalo",[150,1106,1107,1110],{},[38,1108,1109],{},"Importar .css"," — carga un preset integrado o un tema guardado",[150,1112,1113,1116],{},[38,1114,1115],{},"Restablecer"," — vuelve a los valores por defecto de SoundNinja",[14,1118,1119],{},"Si cierras la ventana con cambios sin guardar, SoundNinja te pide que guardes primero.",[18,1121,1123],{"id":1122},"sin-el-editor-completo","Sin el editor completo",[14,1125,732,1126,1128],{},[38,1127,668],{}," aún puedes:",[147,1130,1131,1134,1140],{},[150,1132,1133],{},"Elegir un tema de la lista",[150,1135,1136,1137,1054],{},"Editar variables CSS en vivo (",[38,1138,1139],{},"CSS personalizado",[150,1141,1142],{},"Importar un archivo de tema a la carpeta Themes",{"title":107,"searchDepth":108,"depth":108,"links":1144},[1145,1146,1147,1148],{"id":1037,"depth":108,"text":1038},{"id":1071,"depth":108,"text":1072},{"id":1089,"depth":108,"text":1090},{"id":1122,"depth":108,"text":1123},"Diseña colores, fuentes, botones y pestañas en el Theme Creator.",{},5,"\u002Ftheme-editor",{"title":1023,"description":1149},"theme-editor","bPcJP7OLtBsnNMYJ-S1J6DmB6nngULo1_Q1hBJMNZAQ",{"id":1157,"title":1158,"body":1159,"description":1295,"extension":116,"meta":1296,"navigation":118,"order":1297,"path":1298,"seo":1299,"stem":1300,"__hash__":1301},"content_es\u002Frecording-editor.md","Editor de grabación",{"type":7,"value":1160,"toc":1289},[1161,1164,1170,1174,1180,1200,1203,1207,1232,1236,1250,1254,1268,1279],[10,1162,1158],{"id":1163},"editor-de-grabación",[14,1165,1166,1167,1169],{},"Graba un clip dentro de SoundNinja, recórtalo e impórtalo a una pestaña. Abre el editor con el botón ",[38,1168,552],{}," en la barra del reproductor.",[18,1171,1173],{"id":1172},"elegir-una-entrada","Elegir una entrada",[14,1175,732,1176,1179],{},[38,1177,1178],{},"Ajustes → Audio",":",[147,1181,1182,1188,1194],{},[150,1183,1184,1187],{},[38,1185,1186],{},"Dispositivos de entrada"," — micrófono",[150,1189,1190,1193],{},[38,1191,1192],{},"Dispositivos de salida (audio del PC)"," — loopback de lo que reproduce el PC",[150,1195,1196,1199],{},[38,1197,1198],{},"Volumen de entrada"," — ganancia de captura del 0 % al 200 %",[14,1201,1202],{},"El botón Grabar usa el dispositivo que eliges aquí.",[18,1204,1206],{"id":1205},"editar-la-toma","Editar la toma",[147,1208,1209,1212,1215,1223,1226,1229],{},[150,1210,1211],{},"Grabar y detener",[150,1213,1214],{},"Observar el medidor de nivel de entrada",[150,1216,1217,41,1220],{},[38,1218,1219],{},"Normalizar",[38,1221,1222],{},"Cancelación de ruido",[150,1224,1225],{},"Recortar todo el clip, recortar a una selección o borrar una selección",[150,1227,1228],{},"Deshacer \u002F rehacer",[150,1230,1231],{},"Acercar y alejar",[18,1233,1235],{"id":1234},"preparar-e-importar","Preparar e importar",[221,1237,1238,1241,1244],{},[150,1239,1240],{},"Añade la selección o la pista completa a la lista de staging.",[150,1242,1243],{},"La lista empieza vacía: graba, edita y luego añade un clip.",[150,1245,1246,41,1248,560],{},[38,1247,556],{},[38,1249,559],{},[18,1251,1253],{"id":1252},"separación-de-stems-opcional","Separación de stems (opcional)",[14,1255,1256,1257,1260,1261,41,1264,1267],{},"Las builds oficiales de Windows, macOS y Linux incluyen la función ",[38,1258,1259],{},"stems",". El Record Editor puede conservar ",[38,1262,1263],{},"voces",[38,1265,1266],{},"música"," con BS-RoFormer.",[14,1269,1270,1271,1274,1275,1278],{},"El modelo pesa unos 158 MB y ",[38,1272,1273],{},"no"," viene en el instalador. Descárgalo desde ",[38,1276,1277],{},"Ajustes → Separación de stems",", o acepta el aviso del primer arranque. El instalador de Windows también puede ofrecer descargar el modelo al primer inicio.",[14,1280,1281,1282,1050,1285,1288],{},"Las builds personalizadas desde código necesitan un flag extra (",[343,1283,1284],{},"tauri:serve:stems",[343,1286,1287],{},"tauri:build:stems",").",{"title":107,"searchDepth":108,"depth":108,"links":1290},[1291,1292,1293,1294],{"id":1172,"depth":108,"text":1173},{"id":1205,"depth":108,"text":1206},{"id":1234,"depth":108,"text":1235},{"id":1252,"depth":108,"text":1253},"Captura micrófono o audio del PC, edita el clip y suéltalo en tu tablero.",{},6,"\u002Frecording-editor",{"title":1158,"description":1295},"recording-editor","89aDSCp7hE8To2TNFwdWaImQVsHH2-xNcOyltCPP5IY",{"id":1303,"title":1304,"body":1305,"description":1516,"extension":116,"meta":1517,"navigation":118,"order":1518,"path":1519,"seo":1520,"stem":1521,"__hash__":1522},"content_es\u002Fremote-control.md","Control remoto",{"type":7,"value":1306,"toc":1509},[1307,1310,1313,1317,1345,1348,1351,1386,1390,1410,1413,1417,1449,1453,1459],[10,1308,1304],{"id":1309},"control-remoto",[14,1311,1312],{},"SoundNinja puede escuchar en tu red local para que Bitfocus Companion (o cualquier cliente HTTP\u002FWebSocket) reproduzca y detenga sonidos.",[18,1314,1316],{"id":1315},"activar-el-servidor-remoto","Activar el servidor remoto",[221,1318,1319,1324,1330,1336],{},[150,1320,488,1321,77],{},[38,1322,1323],{},"Ajustes → Remoto",[150,1325,1326,1327,77],{},"Activa el servidor remoto. El puerto por defecto es ",[38,1328,1329],{},"7331",[150,1331,1332,1333,77],{},"Opcional: define un token. Los clientes deben enviarlo como Bearer token o ",[343,1334,1335],{},"?token=",[150,1337,1338,1339,1342,1343,77],{},"Copia la URL ",[343,1340,1341],{},"http:\u002F\u002FIP:PORT",", o copia la IP del sistema desde ",[38,1344,44],{},[14,1346,1347],{},"Windows puede mostrar un aviso del firewall la primera vez que arranca el servidor. Permite el acceso a la red privada.",[18,1349,198],{"id":1350},"bitfocus-companion",[221,1352,1353,1360,1369,1379],{},[150,1354,1355,1356,77],{},"Instala ",[28,1357,198],{"href":1358,"rel":1359},"https:\u002F\u002Fbitfocus.io\u002Fcompanion",[32],[150,1361,1362,1363,1368],{},"Descarga ",[28,1364,1367],{"href":1365,"rel":1366},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002Fcompanion-module-soundninja\u002Freleases\u002Flatest",[32],"SoundNinja-Companion.tgz",". Aún no hay paquete en Companion Store.",[150,1370,1371,1372,1375,1376,77],{},"En Companion: ",[38,1373,1374],{},"Modules → Load module package"," y elige el ",[343,1377,1378],{},".tgz",[150,1380,1381,1382,1385],{},"Añade una conexión ",[38,1383,1384],{},"Sound Ninja",". Pega la IP del PC, el puerto y el token si definiste uno.",[18,1387,1389],{"id":1388},"acciones","Acciones",[147,1391,1392,1398,1404],{},[150,1393,1394,1397],{},[38,1395,1396],{},"Trigger Sound"," — elige en el menú desplegable en vivo, o escribe un ID de sonido de 8 caracteres (las variables de Companion funcionan)",[150,1399,1400,1403],{},[38,1401,1402],{},"Stop Sound"," — detiene un sonido en reproducción por ID",[150,1405,1406,1409],{},[38,1407,1408],{},"Stop All"," — detiene todos los sonidos en reproducción",[14,1411,1412],{},"Copia un ID de sonido en SoundNinja desde el menú contextual del botón o el chip de ID de la selección múltiple.",[18,1414,1416],{"id":1415},"feedbacks-y-variables","Feedbacks y variables",[147,1418,1419,1425,1437,1443],{},[150,1420,1421,1424],{},[38,1422,1423],{},"Sound Playing"," — verdadero mientras ese ID de sonido está activo (úsalo para el color del botón)",[150,1426,1427,1430,1431,1050,1434],{},[343,1428,1429],{},"$(soundninja:connected)"," — ",[343,1432,1433],{},"true",[343,1435,1436],{},"false",[150,1438,1439,1442],{},[343,1440,1441],{},"$(soundninja:playing_count)"," — cuántos sonidos suenan",[150,1444,1445,1448],{},[343,1446,1447],{},"$(soundninja:last_triggered)"," — último ID de sonido disparado",[18,1450,1452],{"id":1451},"api-http-avanzado","API HTTP (avanzado)",[14,1454,1455,1456],{},"Ruta base: ",[343,1457,1458],{},"\u002Fapi\u002Fv1",[147,1460,1461,1467,1473,1479,1489,1495,1503],{},[150,1462,1463,1466],{},[343,1464,1465],{},"GET \u002Finfo"," — nombre de la app, versión, protocolo, si se requiere un token",[150,1468,1469,1472],{},[343,1470,1471],{},"GET \u002Fsounds"," — lista de sonidos (id, name, tabs, active)",[150,1474,1475,1478],{},[343,1476,1477],{},"GET \u002Fstate"," — sonidos más IDs que suenan ahora",[150,1480,1481,1484,1485,1488],{},[343,1482,1483],{},"POST \u002Ftrigger"," con ",[343,1486,1487],{},"{ \"id\" }"," — reproducir un sonido",[150,1490,1491,1494],{},[343,1492,1493],{},"GET \u002Ftrigger\u002F:id"," — reproducir (fácil de probar en el navegador)",[150,1496,1497,1484,1500,1502],{},[343,1498,1499],{},"POST \u002Fstop",[343,1501,1487],{}," opcional — detener un sonido o todos",[150,1504,1505,1508],{},[343,1506,1507],{},"GET \u002Fws"," — estado en vivo; enviar comandos trigger\u002Fstop de entrada",{"title":107,"searchDepth":108,"depth":108,"links":1510},[1511,1512,1513,1514,1515],{"id":1315,"depth":108,"text":1316},{"id":1350,"depth":108,"text":198},{"id":1388,"depth":108,"text":1389},{"id":1415,"depth":108,"text":1416},{"id":1451,"depth":108,"text":1452},"Dispara SoundNinja desde Bitfocus Companion en la red local.",{},7,"\u002Fremote-control",{"title":1304,"description":1516},"remote-control","ph5vfcZDpw1R_Zj_L4KkovRHKYPdInfF4l4V_nT9tT4",{"id":4,"title":5,"body":1524,"description":115,"extension":116,"meta":1585,"n