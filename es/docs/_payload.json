[{"data":1,"prerenderedAt":1584},["ShallowReactive",2],{"docs-page-es-\u002Foverview":3,"docs-nav-es":144},{"id":4,"title":5,"body":6,"description":135,"extension":136,"meta":137,"navigation":138,"order":139,"path":140,"seo":141,"stem":142,"__hash__":143},"content_es\u002Foverview.md","Resumen",{"type":7,"value":8,"toc":127},"minimark",[9,13,17,20,23,28,44,48,88,92,102,106],[10,11,5],"h1",{"id":12},"resumen",[14,15,16],"p",{},"SoundNinja es un soundboard de código abierto para streaming en directo, charlas con amigos y grabación de podcasts. Está construido con Tauri v2 y Nuxt 4 para que sea ligero en RAM y disco.",[14,18,19],{},"El objetivo es simple: mantener una biblioteca enorme fácil de recorrer y reproducir el clip correcto en milisegundos. La interfaz también funciona bien como panel en VR.",[14,21,22],{},"SoundNinja sigue en desarrollo temprano. Las funciones marchan, pero no todas las plataformas están del todo probadas.",[24,25,27],"h2",{"id":26},"para-quién","Para quién",[29,30,31,35,38,41],"ul",{},[32,33,34],"li",{},"Streamers que necesitan cues de sonido al instante",[32,36,37],{},"Amigos que quieren un tablero compartido para el chat de voz",[32,39,40],{},"Podcasters que graban clips y los sueltan en un tablero",[32,42,43],{},"Quien quiera un soundboard personalizable y local-first",[24,45,47],{"id":46},"qué-puedes-hacer","Qué puedes hacer",[29,49,50,53,56,59,62,65,68,71,74,82,85],{},[32,51,52],{},"Montar un soundboard con tus propios archivos de audio",[32,54,55],{},"Organizar sonidos en pestañas de colores, grupos, etiquetas y búsqueda",[32,57,58],{},"Filtrar por etiquetas (OR) y ordenar por nombre, fecha, duración o tamaño",[32,60,61],{},"Selección múltiple con marco o rango Mayús, luego color, mover o borrar en lote",[32,63,64],{},"Ajustar el volumen por sonido desde el menú contextual",[32,66,67],{},"Diseñar el aspecto con el Theme Creator",[32,69,70],{},"Grabar audio del PC o un micrófono en el Record Editor",[32,72,73],{},"Asignar atajos a sonidos individuales",[32,75,76,77],{},"Disparar sonidos desde ",[78,79,81],"a",{"href":80},"\u002Fdocs\u002Fremote-control","Bitfocus Companion",[32,83,84],{},"Importar y exportar un soundboard completo para compartirlo",[32,86,87],{},"Usar GIFs o imágenes en los botones — biblioteca local de carpetas o KLIPY",[24,89,91],{"id":90},"licencia","Licencia",[14,93,94,95,101],{},"SoundNinja es software libre bajo ",[78,96,100],{"href":97,"rel":98},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fblob\u002Fmain\u002FLICENSE",[99],"nofollow","GPL-3.0",". Haz fork, cámbialo, compártelo.",[24,103,105],{"id":104},"siguientes-pasos","Siguientes pasos",[107,108,109,115,121],"ol",{},[32,110,111],{},[78,112,114],{"href":113},"\u002Fdocs\u002Finstallation","Instalar SoundNinja",[32,116,117],{},[78,118,120],{"href":119},"\u002Fdocs\u002Fadding-sounds","Añadir sonidos",[32,122,123],{},[78,124,126],{"href":125},"\u002Fdocs\u002Forganizing-sounds","Organizar tu tablero",{"title":128,"searchDepth":129,"depth":129,"links":130},"",2,[131,132,133,134],{"id":26,"depth":129,"text":27},{"id":46,"depth":129,"text":47},{"id":90,"depth":129,"text":91},{"id":104,"depth":129,"text":105},"Qué es SoundNinja y qué puedes hacer con él.","md",{},true,1,"\u002Foverview",{"title":5,"description":135},"overview","XWpBFvtyid6BLXO3HByHppTxfsOo0i7DlSOMew5tq2g",[145,227,432,580,983,1118,1264,1486],{"id":4,"title":5,"body":146,"description":135,"extension":136,"meta":225,"navigation":138,"order":139,"path":140,"seo":226,"stem":142,"__hash__":143},{"type":7,"value":147,"toc":219},[148,150,152,154,156,158,168,170,196,198,203,205],[10,149,5],{"id":12},[14,151,16],{},[14,153,19],{},[14,155,22],{},[24,157,27],{"id":26},[29,159,160,162,164,166],{},[32,161,34],{},[32,163,37],{},[32,165,40],{},[32,167,43],{},[24,169,47],{"id":46},[29,171,172,174,176,178,180,182,184,186,188,192,194],{},[32,173,52],{},[32,175,55],{},[32,177,58],{},[32,179,61],{},[32,181,64],{},[32,183,67],{},[32,185,70],{},[32,187,73],{},[32,189,76,190],{},[78,191,81],{"href":80},[32,193,84],{},[32,195,87],{},[24,197,91],{"id":90},[14,199,94,200,101],{},[78,201,100],{"href":97,"rel":202},[99],[24,204,105],{"id":104},[107,206,207,211,215],{},[32,208,209],{},[78,210,114],{"href":113},[32,212,213],{},[78,214,120],{"href":119},[32,216,217],{},[78,218,126],{"href":125},{"title":128,"searchDepth":129,"depth":129,"links":220},[221,222,223,224],{"id":26,"depth":129,"text":27},{"id":46,"depth":129,"text":47},{"id":90,"depth":129,"text":91},{"id":104,"depth":129,"text":105},{},{"title":5,"description":135},{"id":228,"title":229,"body":230,"description":426,"extension":136,"meta":427,"navigation":138,"order":129,"path":428,"seo":429,"stem":430,"__hash__":431},"content_es\u002Finstallation.md","Instalación",{"type":7,"value":231,"toc":419},[232,235,249,253,275,278,282,296,299,303,328,339,343,350,354,369,399,415],[10,233,229],{"id":234},"instalación",[14,236,237,238,242,243,248],{},"Consigue una build en la ",[78,239,241],{"href":240},"\u002Fdownload","página de descarga"," o en ",[78,244,247],{"href":245,"rel":246},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Freleases\u002Flatest",[99],"GitHub Releases",". SoundNinja está en desarrollo temprano, así que trata las builds como beta.",[24,250,252],{"id":251},"windows","Windows",[29,254,255,266,269,272],{},[32,256,257,261,262,265],{},[258,259,260],"strong",{},"Instalador (.exe)"," o ",[258,263,264],{},"MSI (.msi)"," para Windows de 64 bits",[32,267,268],{},"Objetivo de la landing: Windows 10 y posterior",[32,270,271],{},"El README de la app también lista Windows 8 y superior",[32,273,274],{},"El instalador NSIS usa tema oscuro. Elige idioma en el setup — SoundNinja lo recuerda en el siguiente arranque.",[14,276,277],{},"Ejecuta el instalador y luego abre SoundNinja desde el menú Inicio.",[24,279,281],{"id":280},"macos","macOS",[29,283,284,290,293],{},[32,285,286,289],{},[258,287,288],{},".dmg universal"," para Apple Silicon e Intel",[32,291,292],{},"Objetivo de la landing: macOS 10.14 y posterior",[32,294,295],{},"El README de la app lista macOS 10.15 y superior",[14,297,298],{},"Abre la imagen de disco y arrastra SoundNinja a Aplicaciones.",[24,300,302],{"id":301},"linux","Linux",[29,304,305,311,317,325],{},[32,306,307,310],{},[258,308,309],{},"Debian (.deb)"," para Ubuntu \u002F Debian",[32,312,313,316],{},[258,314,315],{},"AppImage"," para otras distros",[32,318,319,320,324],{},"Tras publicar una release, los usuarios de Arch pueden instalar ",[321,322,323],"code",{},"soundninja-bin"," desde el AUR",[32,326,327],{},"Probado en Ubuntu 20.04",[14,329,330,331,334,335,338],{},"Las builds de escritorio necesitan paquetes WebKit y GTK. En Debian\u002FUbuntu eso suele ser ",[321,332,333],{},"libwebkit2gtk",", ",[321,336,337],{},"libgtk-3-0"," y una biblioteca app-indicator.",[24,340,342],{"id":341},"actualizaciones","Actualizaciones",[14,344,345,346,349],{},"En la app, abre ",[258,347,348],{},"Ayuda → Buscar actualizaciones",". También puedes dejar que SoundNinja compruebe al arrancar en Ajustes.",[24,351,353],{"id":352},"compilar-desde-el-código","Compilar desde el código",[14,355,356,357,362,363,368],{},"¿Necesitas una build personalizada? Clona ",[78,358,361],{"href":359,"rel":360},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja",[99],"el repo",", instala los ",[78,364,367],{"href":365,"rel":366},"https:\u002F\u002Fv2.tauri.app\u002Fstart\u002Fprerequisites\u002F",[99],"requisitos de Tauri"," y luego:",[370,371,375],"pre",{"className":372,"code":373,"language":374,"meta":128,"style":128},"language-bash shiki shiki-themes github-light github-dark","bun install\nbun run tauri:serve\n","bash",[321,376,377,389],{"__ignoreMap":128},[378,379,381,385],"span",{"class":380,"line":139},"line",[378,382,384],{"class":383},"sScJk","bun",[378,386,388],{"class":387},"sZZnC"," install\n",[378,390,391,393,396],{"class":380,"line":129},[378,392,384],{"class":383},[378,394,395],{"class":387}," run",[378,397,398],{"class":387}," tauri:serve\n",[14,400,401,334,404,261,407,410,411,414],{},[321,402,403],{},"npm",[321,405,406],{},"pnpm",[321,408,409],{},"deno"," también sirven. Build de producción: ",[321,412,413],{},"bun run tauri:build",".",[416,417,418],"style",{},"html pre.shiki code .sScJk, html code.shiki .sScJk{--shiki-default:#6F42C1;--shiki-dark:#B392F0}html pre.shiki code .sZZnC, html code.shiki .sZZnC{--shiki-default:#032F62;--shiki-dark:#9ECBFF}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html.dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}",{"title":128,"searchDepth":129,"depth":129,"links":420},[421,422,423,424,425],{"id":251,"depth":129,"text":252},{"id":280,"depth":129,"text":281},{"id":301,"depth":129,"text":302},{"id":341,"depth":129,"text":342},{"id":352,"depth":129,"text":353},"Instala SoundNinja en Windows, macOS o Linux.",{},"\u002Finstallation",{"title":229,"description":426},"installation","zTwxz-vo_-k3K7RGGSHRG4ObTS6FkM9sbuxQPVMKTtY",{"id":433,"title":120,"body":434,"description":573,"extension":136,"meta":574,"navigation":138,"order":575,"path":576,"seo":577,"stem":578,"__hash__":579},"content_es\u002Fadding-sounds.md",{"type":7,"value":435,"toc":565},[436,439,442,446,465,469,500,504,523,527,541,544,548,555,559],[10,437,120],{"id":438},"añadir-sonidos",[14,440,441],{},"Un tablero está vacío hasta que añades clips. SoundNinja puede importar archivos, carpetas enteras, una grabación o un pack de soundboard compartido.",[24,443,445],{"id":444},"importar-archivos-de-audio","Importar archivos de audio",[107,447,448,459,462],{},[32,449,450,451,454,455,458],{},"Abre ",[258,452,453],{},"Archivo → Importar archivos de audio",", o usa ",[258,456,457],{},"Importar"," en la barra de navegación.",[32,460,461],{},"Elige uno o más archivos de audio.",[32,463,464],{},"Los sonidos llegan a la pestaña actual.",[24,466,468],{"id":467},"importar-carpetas","Importar carpetas",[107,470,471,480,483],{},[32,472,450,473,476,477,479],{},[258,474,475],{},"Archivo → Importar carpetas"," (o ",[258,478,468],{}," en la barra de navegación).",[32,481,482],{},"Añade una o más carpetas. Arrastra para reordenarlas antes de importar.",[32,484,485,486],{},"Elige cómo llegan:\n",[29,487,488,494],{},[32,489,490,493],{},[258,491,492],{},"Importar como pestañas"," — cada carpeta se convierte en su propia pestaña",[32,495,496,499],{},[258,497,498],{},"Importar a la pestaña actual"," — cada archivo va a la pestaña activa",[24,501,503],{"id":502},"grabar-un-clip","Grabar un clip",[14,505,506,507,511,512,515,516,261,519,522],{},"Abre el ",[78,508,510],{"href":509},"\u002Fdocs\u002Frecording-editor","Record Editor"," desde el botón ",[258,513,514],{},"Grabar"," en la barra del reproductor. Captura, recorta y luego ",[258,517,518],{},"Importar selección",[258,520,521],{},"Importar todo"," en la pestaña actual o en una pestaña que elijas.",[24,524,526],{"id":525},"importar-un-soundboard","Importar un soundboard",[14,528,529,532,533,536,537,540],{},[258,530,531],{},"Archivo → Importar soundboard"," carga un pack compartido. Los packs son un ",[321,534,535],{},".zip"," que contiene ",[321,538,539],{},"project.sninja"," más los archivos de sonido. Tras importar, abre el proyecto y reproduce.",[14,542,543],{},"También puedes tener varios proyectos (perfiles). Usa el selector de proyecto para cambiar de tablero.",[24,545,547],{"id":546},"reenlazar-archivos-faltantes","Reenlazar archivos faltantes",[14,549,550,551,554],{},"Si los archivos de audio se mueven en el disco, SoundNinja muestra ",[258,552,553],{},"Archivos de sonido faltantes",". Elige una carpeta para buscar y reenlazar los clips.",[24,556,558],{"id":557},"siguiente","Siguiente",[14,560,561,562,414],{},"Organiza pestañas, etiquetas, filtros y atajos en ",[78,563,564],{"href":125},"Organizar sonidos",{"title":128,"searchDepth":129,"depth":129,"links":566},[567,568,569,570,571,572],{"id":444,"depth":129,"text":445},{"id":467,"depth":129,"text":468},{"id":502,"depth":129,"text":503},{"id":525,"depth":129,"text":526},{"id":546,"depth":129,"text":547},{"id":557,"depth":129,"text":558},"Importa audio, carpetas, grabaciones y soundboards compartidos.",{},3,"\u002Fadding-sounds",{"title":120,"description":573},"adding-sounds","O5nOJGNq2FL6jafUxqoGYNKJDVbb2UrZRjfKpK21LlQ",{"id":581,"title":564,"body":582,"description":976,"extension":136,"meta":977,"navigation":138,"order":978,"path":979,"seo":980,"stem":981,"__hash__":982},"content_es\u002Forganizing-sounds.md",{"type":7,"value":583,"toc":961},[584,587,594,598,625,632,636,639,653,660,666,670,680,685,717,721,727,731,764,770,774,777,803,806,810,823,827,833,854,870,877,881,892,895,899,906,916,922,926,934,941,958],[10,585,564],{"id":586},"organizar-sonidos",[14,588,589,590,593],{},"SoundNinja está hecho para bibliotecas grandes. ",[258,591,592],{},"Etiquetas y filtros",", pestañas, búsqueda, selección múltiple y atajos — el clip que necesitas está a un clic (o una tecla).",[24,595,597],{"id":596},"pestañas","Pestañas",[29,599,600,607,614],{},[32,601,602,603,606],{},"Añade una pestaña con ",[258,604,605],{},"Añadir pestaña",". Dale un color para escanear la barra rápido.",[32,608,609,610,613],{},"La vista ",[258,611,612],{},"Todos"," muestra cada sonido de todas las pestañas.",[32,615,616,617,620,621,624],{},"Un sonido puede pertenecer a ",[258,618,619],{},"una o más pestañas",". Clic derecho en un sonido y usa ",[258,622,623],{},"Mover a pestaña"," para asignarlo.",[14,626,627,628,631],{},"Las transiciones de pestaña están en ",[258,629,630],{},"Ajustes → General",": Slide, Fade, Botones uno a uno, o Ninguna.",[24,633,635],{"id":634},"grupos","Grupos",[14,637,638],{},"Desde la v0.5.3, los separadores pueden convertirse en grupos con nombre:",[29,640,641,644,647,650],{},[32,642,643],{},"Añadir, renombrar o quitar un grupo desde el menú contextual",[32,645,646],{},"Arrastra la cabecera del grupo — los hijos se mueven con ella",[32,648,649],{},"Suelta sonidos dentro o fuera de un grupo",[32,651,652],{},"Define color de borde, color del nombre y alineación de botones (o usa el valor por defecto de la pestaña)",[14,654,655,656,659],{},"Sigue pudiendo añadir un ",[258,657,658],{},"Separador"," simple si solo necesitas un corte visual.",[14,661,662,663,414],{},"Clic derecho en el espacio vacío del tablero para ",[258,664,665],{},"Añadir grupo",[24,667,669],{"id":668},"etiquetas-filtros","Etiquetas \u002F Filtros",[14,671,672,673,676,677,679],{},"Las etiquetas cruzan las pestañas. El panel ",[258,674,675],{},"Filtro"," (barra lateral ",[258,678,675],{},") es donde las creas y filtras el tablero.",[681,682,684],"h3",{"id":683},"crear-y-editar-etiquetas","Crear y editar etiquetas",[107,686,687,692,703,710],{},[32,688,450,689,691],{},[258,690,675],{}," en la barra lateral.",[32,693,694,695,698,699,702],{},"En ",[258,696,697],{},"Etiquetas",", usa ",[258,700,701],{},"Añadir etiqueta"," — nombre y color.",[32,704,705,706,709],{},"Renombra, recolorea o ",[258,707,708],{},"Eliminar etiqueta"," en la misma lista.",[32,711,712,713,716],{},"Si ves ",[258,714,715],{},"Aún no hay etiquetas",", crea una aquí antes de asignar.",[681,718,720],{"id":719},"asignar-etiquetas-a-sonidos","Asignar etiquetas a sonidos",[14,722,723,724,726],{},"Clic derecho en un sonido → ",[258,725,697],{}," (casillas). Un sonido puede tener varias. Si aún no hay ninguna, el menú te lleva al panel de filtro.",[681,728,730],{"id":729},"filtrar-el-tablero","Filtrar el tablero",[29,732,733,739,750,761],{},[32,734,735,736,414],{},"Activa etiquetas en el panel Filtro o como ",[258,737,738],{},"chips bajo la barra de búsqueda",[32,740,741,742,745,746,749],{},"La coincidencia es ",[258,743,744],{},"OR",": un sonido sigue visible si tiene ",[258,747,748],{},"cualquiera"," de las etiquetas seleccionadas.",[32,751,752,753,756,757,760],{},"El campo ",[258,754,755],{},"Buscar"," combina con ",[258,758,759],{},"AND"," el filtro de etiquetas activo (texto + etiquetas juntos).",[32,762,763],{},"Apaga los chips (o limpia el filtro) para ver de nuevo toda la pestaña.",[14,765,766,767,414],{},"Los nombres de etiqueta en color pueden aparecer en los botones. Actívalos en ",[258,768,769],{},"Ajustes → Comportamiento → Mostrar badges de etiquetas",[24,771,773],{"id":772},"orden","Orden",[14,775,776],{},"Abre el panel de filtro y elige un modo:",[29,778,779,785],{},[32,780,781,784],{},[258,782,783],{},"Definido por el usuario"," — tu orden de pestaña, grupos visibles",[32,786,787,334,790,334,793,261,796,799,800],{},[258,788,789],{},"Nombre",[258,791,792],{},"Fecha de añadido",[258,794,795],{},"Tiempo de reproducción",[258,797,798],{},"Tamaño de archivo"," — lista plana ordenada; ",[258,801,802],{},"los grupos se ocultan",[14,804,805],{},"Ordenar por duración puede precargar los metadatos de duración la primera vez.",[24,807,809],{"id":808},"reordenar","Reordenar",[14,811,812,813,816,817,820,821,414],{},"Activa arrastrar y soltar en ",[258,814,815],{},"Ajustes → Comportamiento"," (",[258,818,819],{},"Permitir reordenar","). Luego arrastra sonidos y grupos a su sitio. Reordenar aplica en el orden ",[258,822,783],{},[24,824,826],{"id":825},"selección-múltiple","Selección múltiple",[14,828,829,830,832],{},"Activa ",[258,831,826],{}," en la barra de navegación, luego:",[29,834,835,838,844,851],{},[32,836,837],{},"Clic para alternar un sonido",[32,839,840,843],{},[258,841,842],{},"Mayús+clic"," para un rango desde el último ancla",[32,845,846,847,850],{},"Arrastra un ",[258,848,849],{},"marco"," en el espacio vacío del tablero",[32,852,853],{},"Clic en el tablero vacío (o fuera) para limpiar la selección",[14,855,856,857,334,860,334,863,866,867,414],{},"Una barra masiva muestra el recuento, más ",[258,858,859],{},"Color",[258,861,862],{},"Mover a pestaña…",[258,864,865],{},"Eliminar"," y ",[258,868,869],{},"Hecho",[14,871,872,873,876],{},"En selección múltiple, cada botón muestra un ",[258,874,875],{},"chip de ID de 8 caracteres",". Clic derecho en el chip para copiarlo.",[24,878,880],{"id":879},"volumen-por-sonido","Volumen por sonido",[14,882,883,884,887,888,891],{},"Clic derecho → ",[258,885,886],{},"Volumen",". Arrastra el control de 0 % a 100 %. ",[258,889,890],{},"Doble clic"," lo restablece a 100 %.",[14,893,894],{},"Se acumula con el volumen de salida maestro en Ajustes.",[24,896,898],{"id":897},"atajos-e-ids-de-sonido","Atajos e IDs de sonido",[14,900,901,902,905],{},"Cada sonido tiene un ID de 8 caracteres. Cópialo desde el menú contextual del botón (",[258,903,904],{},"Copiar ID",") o el chip de ID de la selección múltiple.",[14,907,450,908,911,912,915],{},[258,909,910],{},"Ajustes → Atajos"," para vincular una tecla a un ID de sonido. Los atajos globales son opcionales. ",[258,913,914],{},"Asignar atajo"," en el menú contextual salta allí con el ID rellenado.",[14,917,918,919,921],{},"El mismo ID es el que ",[78,920,81],{"href":80}," usa para disparar un clip.",[24,923,925],{"id":924},"imágenes-de-fondo-y-colores","Imágenes de fondo y colores",[14,927,928,929,933],{},"Clic derecho en un sonido para definir colores por botón o una imagen de fondo. Eso es independiente del ",[78,930,932],{"href":931},"\u002Fdocs\u002Ftheme-editor","Theme Creator",", que da estilo a todo el tablero.",[14,935,936,937,940],{},"El selector es un diálogo ",[258,938,939],{},"Imagen de fondo"," (PNG, JPEG, GIF, WebP):",[29,942,943,949],{},[32,944,945,948],{},[258,946,947],{},"Archivos locales"," — añade carpetas, elige un archivo, busca por nombre, previsualiza la cuadrícula o quita una carpeta de la biblioteca",[32,950,951,954,955,957],{},[258,952,953],{},"KLIPY"," — busca GIFs en línea. Pon tu propia clave API en ",[258,956,815],{},". La clave no se guarda en los archivos del proyecto.",[14,959,960],{},"Tras elegir, mueve y recorta la imagen en el botón.",{"title":128,"searchDepth":129,"depth":129,"links":962},[963,964,965,970,971,972,973,974,975],{"id":596,"depth":129,"text":597},{"id":634,"depth":129,"text":635},{"id":668,"depth":129,"text":669,"children":966},[967,968,969],{"id":683,"depth":575,"text":684},{"id":719,"depth":575,"text":720},{"id":729,"depth":575,"text":730},{"id":772,"depth":129,"text":773},{"id":808,"depth":129,"text":809},{"id":825,"depth":129,"text":826},{"id":879,"depth":129,"text":880},{"id":897,"depth":129,"text":898},{"id":924,"depth":129,"text":925},"Etiquetas, filtros, pestañas, grupos, orden, selección múltiple, volumen y atajos.",{},4,"\u002Forganizing-sounds",{"title":564,"description":976},"organizing-sounds","0TCdzxC5d9uOHlnFnD2ygCuD63pFk5yy3tK0Xgbpa7M",{"id":984,"title":985,"body":986,"description":1111,"extension":136,"meta":1112,"navigation":138,"order":1113,"path":1114,"seo":1115,"stem":1116,"__hash__":1117},"content_es\u002Ftheme-editor.md","Editor de temas",{"type":7,"value":987,"toc":1105},[988,991,997,1001,1028,1031,1035,1049,1053,1079,1082,1086,1091],[10,989,985],{"id":990},"editor-de-temas",[14,992,993,994,414],{},"El Theme Creator es el editor visual completo de tu tablero. Ábrelo desde ",[258,995,996],{},"Ajustes → General → Theme Creator",[24,998,1000],{"id":999},"tres-pestañas","Tres pestañas",[107,1002,1003,1017,1023],{},[32,1004,1005,1008,1009,1012,1013,1016],{},[258,1006,1007],{},"General"," — nombre del tema, colores compartidos y carga de fuentes (",[321,1010,1011],{},".ttf"," \u002F ",[321,1014,1015],{},".otf",")",[32,1018,1019,1022],{},[258,1020,1021],{},"Botones"," — colores, tipo, diseño y overlay GIF de los botones de sonido",[32,1024,1025,1027],{},[258,1026,597],{}," — colores, tipo y grosor de borde de la barra de pestañas",[14,1029,1030],{},"Una vista previa en vivo muestra pestañas y botones mientras editas.",[24,1032,1034],{"id":1033},"qué-puedes-cambiar","Qué puedes cambiar",[29,1036,1037,1040,1043,1046],{},[32,1038,1039],{},"Colores primario y de acento, fondos, colores de botones, colores de pestañas",[32,1041,1042],{},"Familia y tamaño de fuente de botones y pestañas",[32,1044,1045],{},"Ancho, radio, borde, huecos y padding de los botones",[32,1047,1048],{},"Opacidad del overlay GIF (normal y hover)",[24,1050,1052],{"id":1051},"guardar-y-compartir","Guardar y compartir",[29,1054,1055,1061,1067,1073],{},[32,1056,1057,1060],{},[258,1058,1059],{},"Exportar .css"," — escribe un archivo de tema para respaldar o enviar a un amigo",[32,1062,1063,1066],{},[258,1064,1065],{},"Añadir a temas"," — guarda el archivo en tu carpeta Themes y aplícalo",[32,1068,1069,1072],{},[258,1070,1071],{},"Importar .css"," — carga un preset integrado o un tema guardado",[32,1074,1075,1078],{},[258,1076,1077],{},"Restablecer"," — vuelve a los valores por defecto de SoundNinja",[14,1080,1081],{},"Si cierras la ventana con cambios sin guardar, SoundNinja te pide que guardes primero.",[24,1083,1085],{"id":1084},"sin-el-editor-completo","Sin el editor completo",[14,1087,694,1088,1090],{},[258,1089,630],{}," aún puedes:",[29,1092,1093,1096,1102],{},[32,1094,1095],{},"Elegir un tema de la lista",[32,1097,1098,1099,1016],{},"Editar variables CSS en vivo (",[258,1100,1101],{},"CSS personalizado",[32,1103,1104],{},"Importar un archivo de tema a la carpeta Themes",{"title":128,"searchDepth":129,"depth":129,"links":1106},[1107,1108,1109,1110],{"id":999,"depth":129,"text":1000},{"id":1033,"depth":129,"text":1034},{"id":1051,"depth":129,"text":1052},{"id":1084,"depth":129,"text":1085},"Diseña colores, fuentes, botones y pestañas en el Theme Creator.",{},5,"\u002Ftheme-editor",{"title":985,"description":1111},"theme-editor","bPcJP7OLtBsnNMYJ-S1J6DmB6nngULo1_Q1hBJMNZAQ",{"id":1119,"title":1120,"body":1121,"description":1257,"extension":136,"meta":1258,"navigation":138,"order":1259,"path":1260,"seo":1261,"stem":1262,"__hash__":1263},"content_es\u002Frecording-editor.md","Editor de grabación",{"type":7,"value":1122,"toc":1251},[1123,1126,1132,1136,1142,1162,1165,1169,1194,1198,1212,1216,1230,1241],[10,1124,1120],{"id":1125},"editor-de-grabación",[14,1127,1128,1129,1131],{},"Graba un clip dentro de SoundNinja, recórtalo e impórtalo a una pestaña. Abre el editor con el botón ",[258,1130,514],{}," en la barra del reproductor.",[24,1133,1135],{"id":1134},"elegir-una-entrada","Elegir una entrada",[14,1137,694,1138,1141],{},[258,1139,1140],{},"Ajustes → Audio",":",[29,1143,1144,1150,1156],{},[32,1145,1146,1149],{},[258,1147,1148],{},"Dispositivos de entrada"," — micrófono",[32,1151,1152,1155],{},[258,1153,1154],{},"Dispositivos de salida (audio del PC)"," — loopback de lo que reproduce el PC",[32,1157,1158,1161],{},[258,1159,1160],{},"Volumen de entrada"," — ganancia de captura del 0 % al 200 %",[14,1163,1164],{},"El botón Grabar usa el dispositivo que eliges aquí.",[24,1166,1168],{"id":1167},"editar-la-toma","Editar la toma",[29,1170,1171,1174,1177,1185,1188,1191],{},[32,1172,1173],{},"Grabar y detener",[32,1175,1176],{},"Observar el medidor de nivel de entrada",[32,1178,1179,261,1182],{},[258,1180,1181],{},"Normalizar",[258,1183,1184],{},"Cancelación de ruido",[32,1186,1187],{},"Recortar todo el clip, recortar a una selección o borrar una selección",[32,1189,1190],{},"Deshacer \u002F rehacer",[32,1192,1193],{},"Acercar y alejar",[24,1195,1197],{"id":1196},"preparar-e-importar","Preparar e importar",[107,1199,1200,1203,1206],{},[32,1201,1202],{},"Añade la selección o la pista completa a la lista de staging.",[32,1204,1205],{},"La lista empieza vacía: graba, edita y luego añade un clip.",[32,1207,1208,261,1210,522],{},[258,1209,518],{},[258,1211,521],{},[24,1213,1215],{"id":1214},"separación-de-stems-opcional","Separación de stems (opcional)",[14,1217,1218,1219,1222,1223,261,1226,1229],{},"Las builds oficiales de Windows, macOS y Linux incluyen la función ",[258,1220,1221],{},"stems",". El Record Editor puede conservar ",[258,1224,1225],{},"voces",[258,1227,1228],{},"música"," con BS-RoFormer.",[14,1231,1232,1233,1236,1237,1240],{},"El modelo pesa unos 158 MB y ",[258,1234,1235],{},"no"," viene en el instalador. Descárgalo desde ",[258,1238,1239],{},"Ajustes → Separación de stems",", o acepta el aviso del primer arranque. El instalador de Windows también puede ofrecer descargar el modelo al primer inicio.",[14,1242,1243,1244,1012,1247,1250],{},"Las builds personalizadas desde código necesitan un flag extra (",[321,1245,1246],{},"tauri:serve:stems",[321,1248,1249],{},"tauri:build:stems",").",{"title":128,"searchDepth":129,"depth":129,"links":1252},[1253,1254,1255,1256],{"id":1134,"depth":129,"text":1135},{"id":1167,"depth":129,"text":1168},{"id":1196,"depth":129,"text":1197},{"id":1214,"depth":129,"text":1215},"Captura micrófono o audio del PC, edita el clip y suéltalo en tu tablero.",{},6,"\u002Frecording-editor",{"title":1120,"description":1257},"recording-editor","89aDSCp7hE8To2TNFwdWaImQVsHH2-xNcOyltCPP5IY",{"id":1265,"title":1266,"body":1267,"description":1479,"extension":136,"meta":1480,"navigation":138,"order":1481,"path":1482,"seo":1483,"stem":1484,"__hash__":1485},"content_es\u002Fremote-control.md","Control remoto",{"type":7,"value":1268,"toc":1472},[1269,1272,1275,1279,1308,1311,1314,1349,1353,1373,1376,1380,1412,1416,1422],[10,1270,1266],{"id":1271},"control-remoto",[14,1273,1274],{},"SoundNinja puede escuchar en tu red local para que Bitfocus Companion (o cualquier cliente HTTP\u002FWebSocket) reproduzca y detenga sonidos.",[24,1276,1278],{"id":1277},"activar-el-servidor-remoto","Activar el servidor remoto",[107,1280,1281,1286,1292,1298],{},[32,1282,450,1283,414],{},[258,1284,1285],{},"Ajustes → Remoto",[32,1287,1288,1289,414],{},"Activa el servidor remoto. El puerto por defecto es ",[258,1290,1291],{},"7331",[32,1293,1294,1295,414],{},"Opcional: define un token. Los clientes deben enviarlo como Bearer token o ",[321,1296,1297],{},"?token=",[32,1299,1300,1301,1304,1305,414],{},"Copia la URL ",[321,1302,1303],{},"http:\u002F\u002FIP:PORT",", o copia la IP del sistema desde ",[258,1306,1307],{},"Ajustes → Acerca de",[14,1309,1310],{},"Windows puede mostrar un aviso del firewall la primera vez que arranca el servidor. Permite el acceso a la red privada.",[24,1312,81],{"id":1313},"bitfocus-companion",[107,1315,1316,1323,1332,1342],{},[32,1317,1318,1319,414],{},"Instala ",[78,1320,81],{"href":1321,"rel":1322},"https:\u002F\u002Fbitfocus.io\u002Fcompanion",[99],[32,1324,1325,1326,1331],{},"Descarga ",[78,1327,1330],{"href":1328,"rel":1329},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002Fcompanion-module-soundninja\u002Freleases\u002Flatest",[99],"SoundNinja-Companion.tgz",". Aún no hay paquete en Companion Store.",[32,1333,1334,1335,1338,1339,414],{},"En Companion: ",[258,1336,1337],{},"Modules → Load module package"," y elige el ",[321,1340,1341],{},".tgz",[32,1343,1344,1345,1348],{},"Añade una conexión ",[258,1346,1347],{},"Sound Ninja",". Pega la IP del PC, el puerto y el token si definiste uno.",[24,1350,1352],{"id":1351},"acciones","Acciones",[29,1354,1355,1361,1367],{},[32,1356,1357,1360],{},[258,1358,1359],{},"Trigger Sound"," — elige en el menú desplegable en vivo, o escribe un ID de sonido de 8 caracteres (las variables de Companion funcionan)",[32,1362,1363,1366],{},[258,1364,1365],{},"Stop Sound"," — detiene un sonido en reproducción por ID",[32,1368,1369,1372],{},[258,1370,1371],{},"Stop All"," — detiene todos los sonidos en reproducción",[14,1374,1375],{},"Copia un ID de sonido en SoundNinja desde el menú contextual del botón o el chip de ID de la selección múltiple.",[24,1377,1379],{"id":1378},"feedbacks-y-variables","Feedbacks y variables",[29,1381,1382,1388,1400,1406],{},[32,1383,1384,1387],{},[258,1385,1386],{},"Sound Playing"," — verdadero mientras ese ID de sonido está activo (úsalo para el color del botón)",[32,1389,1390,1393,1394,1012,1397],{},[321,1391,1392],{},"$(soundninja:connected)"," — ",[321,1395,1396],{},"true",[321,1398,1399],{},"false",[32,1401,1402,1405],{},[321,1403,1404],{},"$(soundninja:playing_count)"," — cuántos sonidos suenan",[32,1407,1408,1411],{},[321,1409,1410],{},"$(soundninja:last_triggered)"," — último ID de sonido disparado",[24,1413,1415],{"id":1414},"api-http-avanzado","API HTTP (avanzado)",[14,1417,1418,1419],{},"Ruta base: ",[321,1420,1421],{},"\u002Fapi\u002Fv1",[29,1423,1424,1430,1436,1442,1452,1458,1466],{},[32,1425,1426,1429],{},[321,1427,1428],{},"GET \u002Finfo"," — nombre de la app, versión, protocolo, si se requiere un token",[32,1431,1432,1435],{},[321,1433,1434],{},"GET \u002Fsounds"," — lista de sonidos (id, name, tabs, active)",[32,1437,1438,1441],{},[321,1439,1440],{},"GET \u002Fstate"," — sonidos más IDs que suenan ahora",[32,1443,1444,1447,1448,1451],{},[321,1445,1446],{},"POST \u002Ftrigger"," con ",[321,1449,1450],{},"{ \"id\" }"," — reproducir un sonido",[32,1453,1454,1457],{},[321,1455,1456],{},"GET \u002Ftrigger\u002F:id"," — reproducir (fácil de probar en el navegador)",[32,1459,1460,1447,1463,1465],{},[321,1461,1462],{},"POST \u002Fstop",[321,1464,1450],{}," opcional — detener un sonido o todos",[32,1467,1468,1471],{},[321,1469,1470],{},"GET \u002Fws"," — estado en vivo; enviar comandos trigger\u002Fstop de entrada",{"title":128,"searchDepth":129,"depth":129,"links":1473},[1474,1475,1476,1477,1478],{"id":1277,"depth":129,"text":1278},{"id":1313,"depth":129,"text":81},{"id":1351,"depth":129,"text":1352},{"id":1378,"depth":129,"text":1379},{"id":1414,"depth":129,"text":1415},"Dispara SoundNinja desde Bitfocus Companion en la red local.",{},7,"\u002Fremote-control",{"title":1266,"description":1479},"remote-control","ph5vfcZDpw1R_Zj_L4KkovRHKYPdInfF4l4V_nT9tT4",{"id":1487,"title":1488,"body":1489,"description":1577,"extension":136,"meta":1578,"navigation":138,"order":1579,"path":1580,"seo":1581,"stem":1582,"__hash__":1583},"content_es\u002Fsupport.md","Soporte",{"type":7,"value":1490,"toc":1570},[1491,1494,1497,1501,1504,1511,1519,1523,1530,1532,1545,1549,1560,1564],[10,1492,1488],{"id":1493},"soporte",[14,1495,1496],{},"SoundNinja es un proyecto comunitario en beta temprana. La forma más rápida de pedir ayuda es GitHub.",[24,1498,1500],{"id":1499},"reportar-un-error-o-hacer-una-pregunta","Reportar un error o hacer una pregunta",[14,1502,1503],{},"Abre un issue en GitHub:",[14,1505,1506],{},[78,1507,1510],{"href":1508,"rel":1509},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fissues",[99],"github.com\u002Fmarcus-universe\u002FSoundNinja\u002Fissues",[14,1512,1513,1514,261,1516,1518],{},"Incluye tu SO, la versión de SoundNinja (",[258,1515,348],{},[258,1517,1307],{},") y los pasos para reproducirlo.",[24,1520,1522],{"id":1521},"correo","Correo",[14,1524,1525,1526],{},"Contacto del mantenedor: ",[78,1527,1529],{"href":1528},"mailto:contact@marcus-universe.de","contact@marcus-universe.de",[24,1531,342],{"id":341},[14,1533,1534,1535,1537,1538,1540,1541,414],{},"En la app, usa ",[258,1536,348],{},". Las builds nuevas también aparecen en la ",[78,1539,241],{"href":240}," y en ",[78,1542,247],{"href":1543,"rel":1544},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Freleases",[99],[24,1546,1548],{"id":1547},"contribuir","Contribuir",[14,1550,1551,1552,1556,1557,414],{},"Los pull requests son bienvenidos. El repo de la app es ",[78,1553,1555],{"href":359,"rel":1554},[99],"github.com\u002Fmarcus-universe\u002FSoundNinja",". El proyecto está bajo licencia ",[78,1558,100],{"href":97,"rel":1559},[99],[24,1561,1563],{"id":1562},"aviso-legal","Aviso legal",[14,1565,1566,1567,414],{},"Aviso legal y datos de contacto: ",[78,1568,1563],{"href":1569},"\u002Fimpressum",{"title":128,"searchDepth":129,"depth":129,"links":1571},[1572,1573,1574,1575,1576],{"id":1499,"depth":129,"text":1500},{"id":1521,"depth":129,"text":1522},{"id":341,"depth":129,"text":342},{"id":1547,"depth":129,"text":1548},{"id":1562,"depth":129,"text":1563},"Dónde pedir ayuda y reportar errores.",{},8,"\u002Fsupport",{"title":1488,"description":1577},"support","a00is-hTbQUOnHv2YiZDFMQVyUfDSKLK4GccVuiJQ9c",1789586417166]