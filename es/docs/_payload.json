[{"data":1,"prerenderedAt":1605},["ShallowReactive",2],{"docs-page-es-\u002Foverview":3,"docs-nav-es":144},{"id":4,"title":5,"body":6,"description":135,"extension":136,"meta":137,"navigation":138,"order":139,"path":140,"seo":141,"stem":142,"__hash__":143},"content_es\u002Foverview.md","Resumen",{"type":7,"value":8,"toc":127},"minimark",[9,13,17,20,23,28,44,48,88,92,102,106],[10,11,5],"h1",{"id":12},"resumen",[14,15,16],"p",{},"SoundNinja es un soundboard de código abierto para streaming en directo, charlas con amigos y grabación de podcasts. Está construido con Tauri v2 y Nuxt 4 para que sea ligero en RAM y disco.",[14,18,19],{},"El objetivo es simple: mantener una biblioteca enorme fácil de recorrer y reproducir el clip correcto en milisegundos. La interfaz también funciona bien como panel en VR.",[14,21,22],{},"SoundNinja sigue en desarrollo temprano. Las funciones marchan, pero no todas las plataformas están del todo probadas.",[24,25,27],"h2",{"id":26},"para-quién","Para quién",[29,30,31,35,38,41],"ul",{},[32,33,34],"li",{},"Streamers que necesitan cues de sonido al instante",[32,36,37],{},"Amigos que quieren un tablero compartido para el chat de voz",[32,39,40],{},"Podcasters que graban clips y los sueltan en un tablero",[32,42,43],{},"Quien quiera un soundboard personalizable y local-first",[24,45,47],{"id":46},"qué-puedes-hacer","Qué puedes hacer",[29,49,50,53,56,59,62,65,68,71,74,82,85],{},[32,51,52],{},"Montar un soundboard con tus propios archivos de audio",[32,54,55],{},"Organizar sonidos en pestañas de colores, grupos, etiquetas y búsqueda",[32,57,58],{},"Filtrar por etiquetas (OR) y ordenar por nombre, fecha, duración o tamaño",[32,60,61],{},"Selección múltiple con marco o rango Mayús, luego color, mover o borrar en lote",[32,63,64],{},"Ajustar el volumen por sonido desde el menú contextual",[32,66,67],{},"Diseñar el aspecto con el Theme Creator",[32,69,70],{},"Grabar audio del PC o un micrófono en el Record Editor",[32,72,73],{},"Asignar atajos a sonidos individuales",[32,75,76,77],{},"Disparar sonidos desde ",[78,79,81],"a",{"href":80},"\u002Fdocs\u002Fremote-control","Bitfocus Companion",[32,83,84],{},"Importar y exportar un soundboard completo para compartirlo",[32,86,87],{},"Usar GIFs o imágenes en los botones — biblioteca local de carpetas o KLIPY",[24,89,91],{"id":90},"licencia","Licencia",[14,93,94,95,101],{},"SoundNinja es software libre bajo ",[78,96,100],{"href":97,"rel":98},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fblob\u002Fmain\u002FLICENSE",[99],"nofollow","GPL-3.0",". Haz fork, cámbialo, compártelo.",[24,103,105],{"id":104},"siguientes-pasos","Siguientes pasos",[107,108,109,115,121],"ol",{},[32,110,111],{},[78,112,114],{"href":113},"\u002Fdocs\u002Finstallation","Instalar SoundNinja",[32,116,117],{},[78,118,120],{"href":119},"\u002Fdocs\u002Fadding-sounds","Añadir sonidos",[32,122,123],{},[78,124,126],{"href":125},"\u002Fdocs\u002Forganizing-sounds","Organizar tu tablero",{"title":128,"searchDepth":129,"depth":129,"links":130},"",2,[131,132,133,134],{"id":26,"depth":129,"text":27},{"id":46,"depth":129,"text":47},{"id":90,"depth":129,"text":91},{"id":104,"depth":129,"text":105},"Qué es SoundNinja y qué puedes hacer con él.","md",{},true,1,"\u002Foverview",{"title":5,"description":135},"overview","XWpBFvtyid6BLXO3HByHppTxfsOo0i7DlSOMew5tq2g",[145,227,453,601,1004,1139,1285,1507],{"id":4,"title":5,"body":146,"description":135,"extension":136,"meta":225,"navigation":138,"order":139,"path":140,"seo":226,"stem":142,"__hash__":143},{"type":7,"value":147,"toc":219},[148,150,152,154,156,158,168,170,196,198,203,205],[10,149,5],{"id":12},[14,151,16],{},[14,153,19],{},[14,155,22],{},[24,157,27],{"id":26},[29,159,160,162,164,166],{},[32,161,34],{},[32,163,37],{},[32,165,40],{},[32,167,43],{},[24,169,47],{"id":46},[29,171,172,174,176,178,180,182,184,186,188,192,194],{},[32,173,52],{},[32,175,55],{},[32,177,58],{},[32,179,61],{},[32,181,64],{},[32,183,67],{},[32,185,70],{},[32,187,73],{},[32,189,76,190],{},[78,191,81],{"href":80},[32,193,84],{},[32,195,87],{},[24,197,91],{"id":90},[14,199,94,200,101],{},[78,201,100],{"href":97,"rel":202},[99],[24,204,105],{"id":104},[107,206,207,211,215],{},[32,208,209],{},[78,210,114],{"href":113},[32,212,213],{},[78,214,120],{"href":119},[32,216,217],{},[78,218,126],{"href":125},{"title":128,"searchDepth":129,"depth":129,"links":220},[221,222,223,224],{"id":26,"depth":129,"text":27},{"id":46,"depth":129,"text":47},{"id":90,"depth":129,"text":91},{"id":104,"depth":129,"text":105},{},{"title":5,"description":135},{"id":228,"title":229,"body":230,"description":447,"extension":136,"meta":448,"navigation":138,"order":129,"path":449,"seo":450,"stem":451,"__hash__":452},"content_es\u002Finstallation.md","Instalación",{"type":7,"value":231,"toc":440},[232,235,249,253,275,278,282,296,299,303,328,339,343,350,354,369,399,415,436],[10,233,229],{"id":234},"instalación",[14,236,237,238,242,243,248],{},"Consigue una build en la ",[78,239,241],{"href":240},"\u002Fdownload","página de descarga"," o en ",[78,244,247],{"href":245,"rel":246},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Freleases\u002Flatest",[99],"GitHub Releases",". SoundNinja está en desarrollo temprano, así que trata las builds como beta.",[24,250,252],{"id":251},"windows","Windows",[29,254,255,266,269,272],{},[32,256,257,261,262,265],{},[258,259,260],"strong",{},"Instalador (.exe)"," o ",[258,263,264],{},"MSI (.msi)"," para Windows de 64 bits",[32,267,268],{},"Objetivo de la landing: Windows 10 y posterior",[32,270,271],{},"El README de la app también lista Windows 8 y superior",[32,273,274],{},"El instalador NSIS usa tema oscuro. Elige idioma en el setup — SoundNinja lo recuerda en el siguiente arranque.",[14,276,277],{},"Ejecuta el instalador y luego abre SoundNinja desde el menú Inicio.",[24,279,281],{"id":280},"macos","macOS",[29,283,284,290,293],{},[32,285,286,289],{},[258,287,288],{},".dmg universal"," para Apple Silicon e Intel",[32,291,292],{},"Objetivo de la landing: macOS 10.14 y posterior",[32,294,295],{},"El README de la app lista macOS 10.15 y superior",[14,297,298],{},"Abre la imagen de disco y arrastra SoundNinja a Aplicaciones.",[24,300,302],{"id":301},"linux","Linux",[29,304,305,311,317,325],{},[32,306,307,310],{},[258,308,309],{},"Debian (.deb)"," para Ubuntu \u002F Debian",[32,312,313,316],{},[258,314,315],{},"AppImage"," para otras distros",[32,318,319,320,324],{},"Tras publicar una release, los usuarios de Arch pueden instalar ",[321,322,323],"code",{},"soundninja-bin"," desde el AUR",[32,326,327],{},"Probado en Ubuntu 20.04",[14,329,330,331,334,335,338],{},"Las builds de escritorio necesitan paquetes WebKit y GTK. En Debian\u002FUbuntu eso suele ser ",[321,332,333],{},"libwebkit2gtk",", ",[321,336,337],{},"libgtk-3-0"," y una biblioteca app-indicator.",[24,340,342],{"id":341},"actualizaciones","Actualizaciones",[14,344,345,346,349],{},"En la app, abre ",[258,347,348],{},"Ayuda → Buscar actualizaciones",". También puedes dejar que SoundNinja compruebe al arrancar en Ajustes.",[24,351,353],{"id":352},"compilar-desde-el-código","Compilar desde el código",[14,355,356,357,362,363,368],{},"¿Necesitas una build personalizada? Clona ",[78,358,361],{"href":359,"rel":360},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja",[99],"el repo",", instala los ",[78,364,367],{"href":365,"rel":366},"https:\u002F\u002Fv2.tauri.app\u002Fstart\u002Fprerequisites\u002F",[99],"requisitos de Tauri"," y luego:",[370,371,375],"pre",{"className":372,"code":373,"language":374,"meta":128,"style":128},"language-bash shiki shiki-themes github-light github-dark","bun install\nbun run tauri:serve\n","bash",[321,376,377,389],{"__ignoreMap":128},[378,379,381,385],"span",{"class":380,"line":139},"line",[378,382,384],{"class":383},"sScJk","bun",[378,386,388],{"class":387},"sZZnC"," install\n",[378,390,391,393,396],{"class":380,"line":129},[378,392,384],{"class":383},[378,394,395],{"class":387}," run",[378,397,398],{"class":387}," tauri:serve\n",[14,400,401,334,404,261,407,410,411,414],{},[321,402,403],{},"npm",[321,405,406],{},"pnpm",[321,408,409],{},"deno"," también sirven. Build de producción: ",[321,412,413],{},"bun run tauri:build",".",[14,416,417,420,421,426,427,430,431,414],{},[258,418,419],{},"Solo Windows:"," cada compile de Windows incluye ASIO con el ",[78,422,425],{"href":423,"rel":424},"https:\u002F\u002Fwww.steinberg.net\u002Fasiosdk",[99],"Steinberg ASIO SDK",". Ejecuta ",[321,428,429],{},"bun run setup:asio"," una vez (el SDK no está en git). Linux y macOS usan PipeWire \u002F Core Audio — omite ese paso. Detalles: ",[78,432,435],{"href":433,"rel":434},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fblob\u002Fmain\u002Fdocs\u002Fbuild-from-source.md",[99],"build-from-source.md",[437,438,439],"style",{},"html pre.shiki code .sScJk, html code.shiki .sScJk{--shiki-default:#6F42C1;--shiki-dark:#B392F0}html pre.shiki code .sZZnC, html code.shiki .sZZnC{--shiki-default:#032F62;--shiki-dark:#9ECBFF}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html.dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}",{"title":128,"searchDepth":129,"depth":129,"links":441},[442,443,444,445,446],{"id":251,"depth":129,"text":252},{"id":280,"depth":129,"text":281},{"id":301,"depth":129,"text":302},{"id":341,"depth":129,"text":342},{"id":352,"depth":129,"text":353},"Instala SoundNinja en Windows, macOS o Linux.",{},"\u002Finstallation",{"title":229,"description":447},"installation","6QKa3OcTs0sq8JVvjceX-ugwL8mdPc4h6O-JOoo1Qd8",{"id":454,"title":120,"body":455,"description":594,"extension":136,"meta":595,"navigation":138,"order":596,"path":597,"seo":598,"stem":599,"__hash__":600},"content_es\u002Fadding-sounds.md",{"type":7,"value":456,"toc":586},[457,460,463,467,486,490,521,525,544,548,562,565,569,576,580],[10,458,120],{"id":459},"añadir-sonidos",[14,461,462],{},"Un tablero está vacío hasta que añades clips. SoundNinja puede importar archivos, carpetas enteras, una grabación o un pack de soundboard compartido.",[24,464,466],{"id":465},"importar-archivos-de-audio","Importar archivos de audio",[107,468,469,480,483],{},[32,470,471,472,475,476,479],{},"Abre ",[258,473,474],{},"Archivo → Importar archivos de audio",", o usa ",[258,477,478],{},"Importar"," en la barra de navegación.",[32,481,482],{},"Elige uno o más archivos de audio.",[32,484,485],{},"Los sonidos llegan a la pestaña actual.",[24,487,489],{"id":488},"importar-carpetas","Importar carpetas",[107,491,492,501,504],{},[32,493,471,494,497,498,500],{},[258,495,496],{},"Archivo → Importar carpetas"," (o ",[258,499,489],{}," en la barra de navegación).",[32,502,503],{},"Añade una o más carpetas. Arrastra para reordenarlas antes de importar.",[32,505,506,507],{},"Elige cómo llegan:\n",[29,508,509,515],{},[32,510,511,514],{},[258,512,513],{},"Importar como pestañas"," — cada carpeta se convierte en su propia pestaña",[32,516,517,520],{},[258,518,519],{},"Importar a la pestaña actual"," — cada archivo va a la pestaña activa",[24,522,524],{"id":523},"grabar-un-clip","Grabar un clip",[14,526,527,528,532,533,536,537,261,540,543],{},"Abre el ",[78,529,531],{"href":530},"\u002Fdocs\u002Frecording-editor","Record Editor"," desde el botón ",[258,534,535],{},"Grabar"," en la barra del reproductor. Captura, recorta y luego ",[258,538,539],{},"Importar selección",[258,541,542],{},"Importar todo"," en la pestaña actual o en una pestaña que elijas.",[24,545,547],{"id":546},"importar-un-soundboard","Importar un soundboard",[14,549,550,553,554,557,558,561],{},[258,551,552],{},"Archivo → Importar soundboard"," carga un pack compartido. Los packs son un ",[321,555,556],{},".zip"," que contiene ",[321,559,560],{},"project.sninja"," más los archivos de sonido. Tras importar, abre el proyecto y reproduce.",[14,563,564],{},"También puedes tener varios proyectos (perfiles). Usa el selector de proyecto para cambiar de tablero.",[24,566,568],{"id":567},"reenlazar-archivos-faltantes","Reenlazar archivos faltantes",[14,570,571,572,575],{},"Si los archivos de audio se mueven en el disco, SoundNinja muestra ",[258,573,574],{},"Archivos de sonido faltantes",". Elige una carpeta para buscar y reenlazar los clips.",[24,577,579],{"id":578},"siguiente","Siguiente",[14,581,582,583,414],{},"Organiza pestañas, etiquetas, filtros y atajos en ",[78,584,585],{"href":125},"Organizar sonidos",{"title":128,"searchDepth":129,"depth":129,"links":587},[588,589,590,591,592,593],{"id":465,"depth":129,"text":466},{"id":488,"depth":129,"text":489},{"id":523,"depth":129,"text":524},{"id":546,"depth":129,"text":547},{"id":567,"depth":129,"text":568},{"id":578,"depth":129,"text":579},"Importa audio, carpetas, grabaciones y soundboards compartidos.",{},3,"\u002Fadding-sounds",{"title":120,"description":594},"adding-sounds","O5nOJGNq2FL6jafUxqoGYNKJDVbb2UrZRjfKpK21LlQ",{"id":602,"title":585,"body":603,"description":997,"extension":136,"meta":998,"navigation":138,"order":999,"path":1000,"seo":1001,"stem":1002,"__hash__":1003},"content_es\u002Forganizing-sounds.md",{"type":7,"value":604,"toc":982},[605,608,615,619,646,653,657,660,674,681,687,691,701,706,738,742,748,752,785,791,795,798,824,827,831,844,848,854,875,891,898,902,913,916,920,927,937,943,947,955,962,979],[10,606,585],{"id":607},"organizar-sonidos",[14,609,610,611,614],{},"SoundNinja está hecho para bibliotecas grandes. ",[258,612,613],{},"Etiquetas y filtros",", pestañas, búsqueda, selección múltiple y atajos — el clip que necesitas está a un clic (o una tecla).",[24,616,618],{"id":617},"pestañas","Pestañas",[29,620,621,628,635],{},[32,622,623,624,627],{},"Añade una pestaña con ",[258,625,626],{},"Añadir pestaña",". Dale un color para escanear la barra rápido.",[32,629,630,631,634],{},"La vista ",[258,632,633],{},"Todos"," muestra cada sonido de todas las pestañas.",[32,636,637,638,641,642,645],{},"Un sonido puede pertenecer a ",[258,639,640],{},"una o más pestañas",". Clic derecho en un sonido y usa ",[258,643,644],{},"Mover a pestaña"," para asignarlo.",[14,647,648,649,652],{},"Las transiciones de pestaña están en ",[258,650,651],{},"Ajustes → General",": Slide, Fade, Botones uno a uno, o Ninguna.",[24,654,656],{"id":655},"grupos","Grupos",[14,658,659],{},"Desde la v0.5.3, los separadores pueden convertirse en grupos con nombre:",[29,661,662,665,668,671],{},[32,663,664],{},"Añadir, renombrar o quitar un grupo desde el menú contextual",[32,666,667],{},"Arrastra la cabecera del grupo — los hijos se mueven con ella",[32,669,670],{},"Suelta sonidos dentro o fuera de un grupo",[32,672,673],{},"Define color de borde, color del nombre y alineación de botones (o usa el valor por defecto de la pestaña)",[14,675,676,677,680],{},"Sigue pudiendo añadir un ",[258,678,679],{},"Separador"," simple si solo necesitas un corte visual.",[14,682,683,684,414],{},"Clic derecho en el espacio vacío del tablero para ",[258,685,686],{},"Añadir grupo",[24,688,690],{"id":689},"etiquetas-filtros","Etiquetas \u002F Filtros",[14,692,693,694,697,698,700],{},"Las etiquetas cruzan las pestañas. El panel ",[258,695,696],{},"Filtro"," (barra lateral ",[258,699,696],{},") es donde las creas y filtras el tablero.",[702,703,705],"h3",{"id":704},"crear-y-editar-etiquetas","Crear y editar etiquetas",[107,707,708,713,724,731],{},[32,709,471,710,712],{},[258,711,696],{}," en la barra lateral.",[32,714,715,716,719,720,723],{},"En ",[258,717,718],{},"Etiquetas",", usa ",[258,721,722],{},"Añadir etiqueta"," — nombre y color.",[32,725,726,727,730],{},"Renombra, recolorea o ",[258,728,729],{},"Eliminar etiqueta"," en la misma lista.",[32,732,733,734,737],{},"Si ves ",[258,735,736],{},"Aún no hay etiquetas",", crea una aquí antes de asignar.",[702,739,741],{"id":740},"asignar-etiquetas-a-sonidos","Asignar etiquetas a sonidos",[14,743,744,745,747],{},"Clic derecho en un sonido → ",[258,746,718],{}," (casillas). Un sonido puede tener varias. Si aún no hay ninguna, el menú te lleva al panel de filtro.",[702,749,751],{"id":750},"filtrar-el-tablero","Filtrar el tablero",[29,753,754,760,771,782],{},[32,755,756,757,414],{},"Activa etiquetas en el panel Filtro o como ",[258,758,759],{},"chips bajo la barra de búsqueda",[32,761,762,763,766,767,770],{},"La coincidencia es ",[258,764,765],{},"OR",": un sonido sigue visible si tiene ",[258,768,769],{},"cualquiera"," de las etiquetas seleccionadas.",[32,772,773,774,777,778,781],{},"El campo ",[258,775,776],{},"Buscar"," combina con ",[258,779,780],{},"AND"," el filtro de etiquetas activo (texto + etiquetas juntos).",[32,783,784],{},"Apaga los chips (o limpia el filtro) para ver de nuevo toda la pestaña.",[14,786,787,788,414],{},"Los nombres de etiqueta en color pueden aparecer en los botones. Actívalos en ",[258,789,790],{},"Ajustes → Comportamiento → Mostrar badges de etiquetas",[24,792,794],{"id":793},"orden","Orden",[14,796,797],{},"Abre el panel de filtro y elige un modo:",[29,799,800,806],{},[32,801,802,805],{},[258,803,804],{},"Definido por el usuario"," — tu orden de pestaña, grupos visibles",[32,807,808,334,811,334,814,261,817,820,821],{},[258,809,810],{},"Nombre",[258,812,813],{},"Fecha de añadido",[258,815,816],{},"Tiempo de reproducción",[258,818,819],{},"Tamaño de archivo"," — lista plana ordenada; ",[258,822,823],{},"los grupos se ocultan",[14,825,826],{},"Ordenar por duración puede precargar los metadatos de duración la primera vez.",[24,828,830],{"id":829},"reordenar","Reordenar",[14,832,833,834,837,838,841,842,414],{},"Activa arrastrar y soltar en ",[258,835,836],{},"Ajustes → Comportamiento"," (",[258,839,840],{},"Permitir reordenar","). Luego arrastra sonidos y grupos a su sitio. Reordenar aplica en el orden ",[258,843,804],{},[24,845,847],{"id":846},"selección-múltiple","Selección múltiple",[14,849,850,851,853],{},"Activa ",[258,852,847],{}," en la barra de navegación, luego:",[29,855,856,859,865,872],{},[32,857,858],{},"Clic para alternar un sonido",[32,860,861,864],{},[258,862,863],{},"Mayús+clic"," para un rango desde el último ancla",[32,866,867,868,871],{},"Arrastra un ",[258,869,870],{},"marco"," en el espacio vacío del tablero",[32,873,874],{},"Clic en el tablero vacío (o fuera) para limpiar la selección",[14,876,877,878,334,881,334,884,887,888,414],{},"Una barra masiva muestra el recuento, más ",[258,879,880],{},"Color",[258,882,883],{},"Mover a pestaña…",[258,885,886],{},"Eliminar"," y ",[258,889,890],{},"Hecho",[14,892,893,894,897],{},"En selección múltiple, cada botón muestra un ",[258,895,896],{},"chip de ID de 8 caracteres",". Clic derecho en el chip para copiarlo.",[24,899,901],{"id":900},"volumen-por-sonido","Volumen por sonido",[14,903,904,905,908,909,912],{},"Clic derecho → ",[258,906,907],{},"Volumen",". Arrastra el control de 0 % a 100 %. ",[258,910,911],{},"Doble clic"," lo restablece a 100 %.",[14,914,915],{},"Se acumula con el volumen de salida maestro en Ajustes.",[24,917,919],{"id":918},"atajos-e-ids-de-sonido","Atajos e IDs de sonido",[14,921,922,923,926],{},"Cada sonido tiene un ID de 8 caracteres. Cópialo desde el menú contextual del botón (",[258,924,925],{},"Copiar ID",") o el chip de ID de la selección múltiple.",[14,928,471,929,932,933,936],{},[258,930,931],{},"Ajustes → Atajos"," para vincular una tecla a un ID de sonido. Los atajos globales son opcionales. ",[258,934,935],{},"Asignar atajo"," en el menú contextual salta allí con el ID rellenado.",[14,938,939,940,942],{},"El mismo ID es el que ",[78,941,81],{"href":80}," usa para disparar un clip.",[24,944,946],{"id":945},"imágenes-de-fondo-y-colores","Imágenes de fondo y colores",[14,948,949,950,954],{},"Clic derecho en un sonido para definir colores por botón o una imagen de fondo. Eso es independiente del ",[78,951,953],{"href":952},"\u002Fdocs\u002Ftheme-editor","Theme Creator",", que da estilo a todo el tablero.",[14,956,957,958,961],{},"El selector es un diálogo ",[258,959,960],{},"Imagen de fondo"," (PNG, JPEG, GIF, WebP):",[29,963,964,970],{},[32,965,966,969],{},[258,967,968],{},"Archivos locales"," — añade carpetas, elige un archivo, busca por nombre, previsualiza la cuadrícula o quita una carpeta de la biblioteca",[32,971,972,975,976,978],{},[258,973,974],{},"KLIPY"," — busca GIFs en línea. Pon tu propia clave API en ",[258,977,836],{},". La clave no se guarda en los archivos del proyecto.",[14,980,981],{},"Tras elegir, mueve y recorta la imagen en el botón.",{"title":128,"searchDepth":129,"depth":129,"links":983},[984,985,986,991,992,993,994,995,996],{"id":617,"depth":129,"text":618},{"id":655,"depth":129,"text":656},{"id":689,"depth":129,"text":690,"children":987},[988,989,990],{"id":704,"depth":596,"text":705},{"id":740,"depth":596,"text":741},{"id":750,"depth":596,"text":751},{"id":793,"depth":129,"text":794},{"id":829,"depth":129,"text":830},{"id":846,"depth":129,"text":847},{"id":900,"depth":129,"text":901},{"id":918,"depth":129,"text":919},{"id":945,"depth":129,"text":946},"Etiquetas, filtros, pestañas, grupos, orden, selección múltiple, volumen y atajos.",{},4,"\u002Forganizing-sounds",{"title":585,"description":997},"organizing-sounds","0TCdzxC5d9uOHlnFnD2ygCuD63pFk5yy3tK0Xgbpa7M",{"id":1005,"title":1006,"body":1007,"description":1132,"extension":136,"meta":1133,"navigation":138,"order":1134,"path":1135,"seo":1136,"stem":1137,"__hash__":1138},"content_es\u002Ftheme-editor.md","Editor de temas",{"type":7,"value":1008,"toc":1126},[1009,1012,1018,1022,1049,1052,1056,1070,1074,1100,1103,1107,1112],[10,1010,1006],{"id":1011},"editor-de-temas",[14,1013,1014,1015,414],{},"El Theme Creator es el editor visual completo de tu tablero. Ábrelo desde ",[258,1016,1017],{},"Ajustes → General → Theme Creator",[24,1019,1021],{"id":1020},"tres-pestañas","Tres pestañas",[107,1023,1024,1038,1044],{},[32,1025,1026,1029,1030,1033,1034,1037],{},[258,1027,1028],{},"General"," — nombre del tema, colores compartidos y carga de fuentes (",[321,1031,1032],{},".ttf"," \u002F ",[321,1035,1036],{},".otf",")",[32,1039,1040,1043],{},[258,1041,1042],{},"Botones"," — colores, tipo, diseño y overlay GIF de los botones de sonido",[32,1045,1046,1048],{},[258,1047,618],{}," — colores, tipo y grosor de borde de la barra de pestañas",[14,1050,1051],{},"Una vista previa en vivo muestra pestañas y botones mientras editas.",[24,1053,1055],{"id":1054},"qué-puedes-cambiar","Qué puedes cambiar",[29,1057,1058,1061,1064,1067],{},[32,1059,1060],{},"Colores primario y de acento, fondos, colores de botones, colores de pestañas",[32,1062,1063],{},"Familia y tamaño de fuente de botones y pestañas",[32,1065,1066],{},"Ancho, radio, borde, huecos y padding de los botones",[32,1068,1069],{},"Opacidad del overlay GIF (normal y hover)",[24,1071,1073],{"id":1072},"guardar-y-compartir","Guardar y compartir",[29,1075,1076,1082,1088,1094],{},[32,1077,1078,1081],{},[258,1079,1080],{},"Exportar .css"," — escribe un archivo de tema para respaldar o enviar a un amigo",[32,1083,1084,1087],{},[258,1085,1086],{},"Añadir a temas"," — guarda el archivo en tu carpeta Themes y aplícalo",[32,1089,1090,1093],{},[258,1091,1092],{},"Importar .css"," — carga un preset integrado o un tema guardado",[32,1095,1096,1099],{},[258,1097,1098],{},"Restablecer"," — vuelve a los valores por defecto de SoundNinja",[14,1101,1102],{},"Si cierras la ventana con cambios sin guardar, SoundNinja te pide que guardes primero.",[24,1104,1106],{"id":1105},"sin-el-editor-completo","Sin el editor completo",[14,1108,715,1109,1111],{},[258,1110,651],{}," aún puedes:",[29,1113,1114,1117,1123],{},[32,1115,1116],{},"Elegir un tema de la lista",[32,1118,1119,1120,1037],{},"Editar variables CSS en vivo (",[258,1121,1122],{},"CSS personalizado",[32,1124,1125],{},"Importar un archivo de tema a la carpeta Themes",{"title":128,"searchDepth":129,"depth":129,"links":1127},[1128,1129,1130,1131],{"id":1020,"depth":129,"text":1021},{"id":1054,"depth":129,"text":1055},{"id":1072,"depth":129,"text":1073},{"id":1105,"depth":129,"text":1106},"Diseña colores, fuentes, botones y pestañas en el Theme Creator.",{},5,"\u002Ftheme-editor",{"title":1006,"description":1132},"theme-editor","bPcJP7OLtBsnNMYJ-S1J6DmB6nngULo1_Q1hBJMNZAQ",{"id":1140,"title":1141,"body":1142,"description":1278,"extension":136,"meta":1279,"navigation":138,"order":1280,"path":1281,"seo":1282,"stem":1283,"__hash__":1284},"content_es\u002Frecording-editor.md","Editor de grabación",{"type":7,"value":1143,"toc":1272},[1144,1147,1153,1157,1163,1183,1186,1190,1215,1219,1233,1237,1251,1262],[10,1145,1141],{"id":1146},"editor-de-grabación",[14,1148,1149,1150,1152],{},"Graba un clip dentro de SoundNinja, recórtalo e impórtalo a una pestaña. Abre el editor con el botón ",[258,1151,535],{}," en la barra del reproductor.",[24,1154,1156],{"id":1155},"elegir-una-entrada","Elegir una entrada",[14,1158,715,1159,1162],{},[258,1160,1161],{},"Ajustes → Audio",":",[29,1164,1165,1171,1177],{},[32,1166,1167,1170],{},[258,1168,1169],{},"Dispositivos de entrada"," — micrófono",[32,1172,1173,1176],{},[258,1174,1175],{},"Dispositivos de salida (audio del PC)"," — loopback de lo que reproduce el PC",[32,1178,1179,1182],{},[258,1180,1181],{},"Volumen de entrada"," — ganancia de captura del 0 % al 200 %",[14,1184,1185],{},"El botón Grabar usa el dispositivo que eliges aquí.",[24,1187,1189],{"id":1188},"editar-la-toma","Editar la toma",[29,1191,1192,1195,1198,1206,1209,1212],{},[32,1193,1194],{},"Grabar y detener",[32,1196,1197],{},"Observar el medidor de nivel de entrada",[32,1199,1200,261,1203],{},[258,1201,1202],{},"Normalizar",[258,1204,1205],{},"Cancelación de ruido",[32,1207,1208],{},"Recortar todo el clip, recortar a una selección o borrar una selección",[32,1210,1211],{},"Deshacer \u002F rehacer",[32,1213,1214],{},"Acercar y alejar",[24,1216,1218],{"id":1217},"preparar-e-importar","Preparar e importar",[107,1220,1221,1224,1227],{},[32,1222,1223],{},"Añade la selección o la pista completa a la lista de staging.",[32,1225,1226],{},"La lista empieza vacía: graba, edita y luego añade un clip.",[32,1228,1229,261,1231,543],{},[258,1230,539],{},[258,1232,542],{},[24,1234,1236],{"id":1235},"separación-de-stems-opcional","Separación de stems (opcional)",[14,1238,1239,1240,1243,1244,261,1247,1250],{},"Las builds oficiales de Windows, macOS y Linux incluyen la función ",[258,1241,1242],{},"stems",". El Record Editor puede conservar ",[258,1245,1246],{},"voces",[258,1248,1249],{},"música"," con BS-RoFormer.",[14,1252,1253,1254,1257,1258,1261],{},"El modelo pesa unos 158 MB y ",[258,1255,1256],{},"no"," viene en el instalador. Descárgalo desde ",[258,1259,1260],{},"Ajustes → Separación de stems",", o acepta el aviso del primer arranque. El instalador de Windows también puede ofrecer descargar el modelo al primer inicio.",[14,1263,1264,1265,1033,1268,1271],{},"Las builds personalizadas desde código necesitan un flag extra (",[321,1266,1267],{},"tauri:serve:stems",[321,1269,1270],{},"tauri:build:stems",").",{"title":128,"searchDepth":129,"depth":129,"links":1273},[1274,1275,1276,1277],{"id":1155,"depth":129,"text":1156},{"id":1188,"depth":129,"text":1189},{"id":1217,"depth":129,"text":1218},{"id":1235,"depth":129,"text":1236},"Captura micrófono o audio del PC, edita el clip y suéltalo en tu tablero.",{},6,"\u002Frecording-editor",{"title":1141,"description":1278},"recording-editor","89aDSCp7hE8To2TNFwdWaImQVsHH2-xNcOyltCPP5IY",{"id":1286,"title":1287,"body":1288,"description":1500,"extension":136,"meta":1501,"navigation":138,"order":1502,"path":1503,"seo":1504,"stem":1505,"__hash__":1506},"content_es\u002Fremote-control.md","Control remoto",{"type":7,"value":1289,"toc":1493},[1290,1293,1296,1300,1329,1332,1335,1370,1374,1394,1397,1401,1433,1437,1443],[10,1291,1287],{"id":1292},"control-remoto",[14,1294,1295],{},"SoundNinja puede escuchar en tu red local para que Bitfocus Companion (o cualquier cliente HTTP\u002FWebSocket) reproduzca y detenga sonidos.",[24,1297,1299],{"id":1298},"activar-el-servidor-remoto","Activar el servidor remoto",[107,1301,1302,1307,1313,1319],{},[32,1303,471,1304,414],{},[258,1305,1306],{},"Ajustes → Remoto",[32,1308,1309,1310,414],{},"Activa el servidor remoto. El puerto por defecto es ",[258,1311,1312],{},"7331",[32,1314,1315,1316,414],{},"Opcional: define un token. Los clientes deben enviarlo como Bearer token o ",[321,1317,1318],{},"?token=",[32,1320,1321,1322,1325,1326,414],{},"Copia la URL ",[321,1323,1324],{},"http:\u002F\u002FIP:PORT",", o copia la IP del sistema desde ",[258,1327,1328],{},"Ajustes → Acerca de",[14,1330,1331],{},"Windows puede mostrar un aviso del firewall la primera vez que arranca el servidor. Permite el acceso a la red privada.",[24,1333,81],{"id":1334},"bitfocus-companion",[107,1336,1337,1344,1353,1363],{},[32,1338,1339,1340,414],{},"Instala ",[78,1341,81],{"href":1342,"rel":1343},"https:\u002F\u002Fbitfocus.io\u002Fcompanion",[99],[32,1345,1346,1347,1352],{},"Descarga ",[78,1348,1351],{"href":1349,"rel":1350},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002Fcompanion-module-soundninja\u002Freleases\u002Flatest",[99],"SoundNinja-Companion.tgz",". Aún no hay paquete en Companion Store.",[32,1354,1355,1356,1359,1360,414],{},"En Companion: ",[258,1357,1358],{},"Modules → Load module package"," y elige el ",[321,1361,1362],{},".tgz",[32,1364,1365,1366,1369],{},"Añade una conexión ",[258,1367,1368],{},"Sound Ninja",". Pega la IP del PC, el puerto y el token si definiste uno.",[24,1371,1373],{"id":1372},"acciones","Acciones",[29,1375,1376,1382,1388],{},[32,1377,1378,1381],{},[258,1379,1380],{},"Trigger Sound"," — elige en el menú desplegable en vivo, o escribe un ID de sonido de 8 caracteres (las variables de Companion funcionan)",[32,1383,1384,1387],{},[258,1385,1386],{},"Stop Sound"," — detiene un sonido en reproducción por ID",[32,1389,1390,1393],{},[258,1391,1392],{},"Stop All"," — detiene todos los sonidos en reproducción",[14,1395,1396],{},"Copia un ID de sonido en SoundNinja desde el menú contextual del botón o el chip de ID de la selección múltiple.",[24,1398,1400],{"id":1399},"feedbacks-y-variables","Feedbacks y variables",[29,1402,1403,1409,1421,1427],{},[32,1404,1405,1408],{},[258,1406,1407],{},"Sound Playing"," — verdadero mientras ese ID de sonido está activo (úsalo para el color del botón)",[32,1410,1411,1414,1415,1033,1418],{},[321,1412,1413],{},"$(soundninja:connected)"," — ",[321,1416,1417],{},"true",[321,1419,1420],{},"false",[32,1422,1423,1426],{},[321,1424,1425],{},"$(soundninja:playing_count)"," — cuántos sonidos suenan",[32,1428,1429,1432],{},[321,1430,1431],{},"$(soundninja:last_triggered)"," — último ID de sonido disparado",[24,1434,1436],{"id":1435},"api-http-avanzado","API HTTP (avanzado)",[14,1438,1439,1440],{},"Ruta base: ",[321,1441,1442],{},"\u002Fapi\u002Fv1",[29,1444,1445,1451,1457,1463,1473,1479,1487],{},[32,1446,1447,1450],{},[321,1448,1449],{},"GET \u002Finfo"," — nombre de la app, versión, protocolo, si se requiere un token",[32,1452,1453,1456],{},[321,1454,1455],{},"GET \u002Fsounds"," — lista de sonidos (id, name, tabs, active)",[32,1458,1459,1462],{},[321,1460,1461],{},"GET \u002Fstate"," — sonidos más IDs que suenan ahora",[32,1464,1465,1468,1469,1472],{},[321,1466,1467],{},"POST \u002Ftrigger"," con ",[321,1470,1471],{},"{ \"id\" }"," — reproducir un sonido",[32,1474,1475,1478],{},[321,1476,1477],{},"GET \u002Ftrigger\u002F:id"," — reproducir (fácil de probar en el navegador)",[32,1480,1481,1468,1484,1486],{},[321,1482,1483],{},"POST \u002Fstop",[321,1485,1471],{}," opcional — detener un sonido o todos",[32,1488,1489,1492],{},[321,1490,1491],{},"GET \u002Fws"," — estado en vivo; enviar comandos trigger\u002Fstop de entrada",{"title":128,"searchDepth":129,"depth":129,"links":1494},[1495,1496,1497,1498,1499],{"id":1298,"depth":129,"text":1299},{"id":1334,"depth":129,"text":81},{"id":1372,"depth":129,"text":1373},{"id":1399,"depth":129,"text":1400},{"id":1435,"depth":129,"text":1436},"Dispara SoundNinja desde Bitfocus Companion en la red local.",{},7,"\u002Fremote-control",{"title":1287,"description":1500},"remote-control","ph5vfcZDpw1R_Zj_L4KkovRHKYPdInfF4l4V_nT9tT4",{"id":1508,"title":1509,"body":1510,"description":1598,"extension":136,"meta":1599,"navigation":138,"order":1600,"path":1601,"seo":1602,"stem":1603,"__hash__":1604},"content_es\u002Fsupport.md","Soporte",{"type":7,"value":1511,"toc":1591},[1512,1515,1518,1522,1525,1532,1540,1544,1551,1553,1566,1570,1581,1585],[10,1513,1509],{"id":1514},"soporte",[14,1516,1517],{},"SoundNinja es un proyecto comunitario en beta temprana. La forma más rápida de pedir ayuda es GitHub.",[24,1519,1521],{"id":1520},"reportar-un-error-o-hacer-una-pregunta","Reportar un error o hacer una pregunta",[14,1523,1524],{},"Abre un issue en GitHub:",[14,1526,1527],{},[78,1528,1531],{"href":1529,"rel":1530},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fissues",[99],"github.com\u002Fmarcus-universe\u002FSoundNinja\u002Fissues",[14,1533,1534,1535,261,1537,1539],{},"Incluye tu SO, la versión de SoundNinja (",[258,1536,348],{},[258,1538,1328],{},") y los pasos para reproducirlo.",[24,1541,1543],{"id":1542},"correo","Correo",[14,1545,1546,1547],{},"Contacto del mantenedor: ",[78,1548,1550],{"href":1549},"mailto:contact@marcus-universe.de","contact@marcus-universe.de",[24,1552,342],{"id":341},[14,1554,1555,1556,1558,1559,1561,1562,414],{},"En la app, usa ",[258,1557,348],{},". Las builds nuevas también aparecen en la ",[78,1560,241],{"href":240}," y en ",[78,1563,247],{"href":1564,"rel":1565},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Freleases",[99],[24,1567,1569],{"id":1568},"contribuir","Contribuir",[14,1571,1572,1573,1577,1578,414],{},"Los pull requests son bienvenidos. El repo de la app es ",[78,1574,1576],{"href":359,"rel":1575},[99],"github.com\u002Fmarcus-universe\u002FSoundNinja",". El proyecto está bajo licencia ",[78,1579,100],{"href":97,"rel":1580},[99],[24,1582,1584],{"id":1583},"aviso-legal","Aviso legal",[14,1586,1587,1588,414],{},"Aviso legal y datos de contacto: ",[78,1589,1584],{"href":1590},"\u002Fimpressum",{"title":128,"searchDepth":129,"depth":129,"links":1592},[1593,1594,1595,1596,1597],{"id":1520,"depth":129,"text":1521},{"id":1542,"depth":129,"text":1543},{"id":341,"depth":129,"text":342},{"id":1568,"depth":129,"text":1569},{"id":1583,"depth":129,"text":1584},"Dónde pedir ayuda y reportar errores.",{},8,"\u002Fsupport",{"title":1509,"description":1598},"support","a00is-hTbQUOnHv2YiZDFMQVyUfDSKLK4GccVuiJQ9c",1789597755963]