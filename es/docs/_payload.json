[{"data":1,"prerenderedAt":1615},["ShallowReactive",2],{"docs-page-es-\u002Foverview":3,"docs-nav-es":144},{"id":4,"title":5,"body":6,"description":135,"extension":136,"meta":137,"navigation":138,"order":139,"path":140,"seo":141,"stem":142,"__hash__":143},"content_es\u002Foverview.md","Resumen",{"type":7,"value":8,"toc":127},"minimark",[9,13,17,20,23,28,44,48,88,92,102,106],[10,11,5],"h1",{"id":12},"resumen",[14,15,16],"p",{},"SoundNinja es un soundboard de código abierto para streaming en directo, charlas con amigos y grabación de podcasts. Está construido con Tauri v2 y Nuxt 4 para que sea ligero en RAM y disco.",[14,18,19],{},"El objetivo es simple: mantener una biblioteca enorme fácil de recorrer y reproducir el clip correcto en milisegundos. La interfaz también funciona bien como panel en VR.",[14,21,22],{},"SoundNinja sigue en desarrollo temprano. Las funciones marchan, pero no todas las plataformas están del todo probadas.",[24,25,27],"h2",{"id":26},"para-quién","Para quién",[29,30,31,35,38,41],"ul",{},[32,33,34],"li",{},"Streamers que necesitan cues de sonido al instante",[32,36,37],{},"Amigos que quieren un tablero compartido para el chat de voz",[32,39,40],{},"Podcasters que graban clips y los sueltan en un tablero",[32,42,43],{},"Quien quiera un soundboard personalizable y local-first",[24,45,47],{"id":46},"qué-puedes-hacer","Qué puedes hacer",[29,49,50,53,56,59,62,65,68,71,74,82,85],{},[32,51,52],{},"Montar un soundboard con tus propios archivos de audio",[32,54,55],{},"Organizar sonidos en pestañas de colores, grupos, etiquetas y búsqueda",[32,57,58],{},"Filtrar por etiquetas (OR) y ordenar por nombre, fecha, duración o tamaño",[32,60,61],{},"Selección múltiple con marco o rango Mayús, luego color, mover o borrar en lote",[32,63,64],{},"Ajustar el volumen por sonido desde el menú contextual",[32,66,67],{},"Diseñar el aspecto con el Theme Creator",[32,69,70],{},"Grabar audio del PC o un micrófono en el Record Editor",[32,72,73],{},"Asignar atajos a sonidos individuales",[32,75,76,77],{},"Disparar sonidos desde ",[78,79,81],"a",{"href":80},"\u002Fdocs\u002Fremote-control","Bitfocus Companion",[32,83,84],{},"Importar y exportar un soundboard completo para compartirlo",[32,86,87],{},"Usar GIFs o imágenes en los botones — biblioteca local de carpetas, GifSnap o KLIPY",[24,89,91],{"id":90},"licencia","Licencia",[14,93,94,95,101],{},"SoundNinja es software libre bajo ",[78,96,100],{"href":97,"rel":98},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fblob\u002Fmain\u002FLICENSE",[99],"nofollow","GPL-3.0",". Haz fork, cámbialo, compártelo.",[24,103,105],{"id":104},"siguientes-pasos","Siguientes pasos",[107,108,109,115,121],"ol",{},[32,110,111],{},[78,112,114],{"href":113},"\u002Fdocs\u002Finstallation","Instalar SoundNinja",[32,116,117],{},[78,118,120],{"href":119},"\u002Fdocs\u002Fadding-sounds","Añadir sonidos",[32,122,123],{},[78,124,126],{"href":125},"\u002Fdocs\u002Forganizing-sounds","Organizar tu tablero",{"title":128,"searchDepth":129,"depth":129,"links":130},"",2,[131,132,133,134],{"id":26,"depth":129,"text":27},{"id":46,"depth":129,"text":47},{"id":90,"depth":129,"text":91},{"id":104,"depth":129,"text":105},"Qué es SoundNinja y qué puedes hacer con él.","md",{},true,1,"\u002Foverview",{"title":5,"description":135},"overview","aVQIpArgBh8Yx660xBvwTxx-97ukf5Chr1A7jNPd3UE",[145,227,453,601,1014,1149,1295,1517],{"id":4,"title":5,"body":146,"description":135,"extension":136,"meta":225,"navigation":138,"order":139,"path":140,"seo":226,"stem":142,"__hash__":143},{"type":7,"value":147,"toc":219},[148,150,152,154,156,158,168,170,196,198,203,205],[10,149,5],{"id":12},[14,151,16],{},[14,153,19],{},[14,155,22],{},[24,157,27],{"id":26},[29,159,160,162,164,166],{},[32,161,34],{},[32,163,37],{},[32,165,40],{},[32,167,43],{},[24,169,47],{"id":46},[29,171,172,174,176,178,180,182,184,186,188,192,194],{},[32,173,52],{},[32,175,55],{},[32,177,58],{},[32,179,61],{},[32,181,64],{},[32,183,67],{},[32,185,70],{},[32,187,73],{},[32,189,76,190],{},[78,191,81],{"href":80},[32,193,84],{},[32,195,87],{},[24,197,91],{"id":90},[14,199,94,200,101],{},[78,201,100],{"href":97,"rel":202},[99],[24,204,105],{"id":104},[107,206,207,211,215],{},[32,208,209],{},[78,210,114],{"href":113},[32,212,213],{},[78,214,120],{"href":119},[32,216,217],{},[78,218,126],{"href":125},{"title":128,"searchDepth":129,"depth":129,"links":220},[221,222,223,224],{"id":26,"depth":129,"text":27},{"id":46,"depth":129,"text":47},{"id":90,"depth":129,"text":91},{"id":104,"depth":129,"text":105},{},{"title":5,"description":135},{"id":228,"title":229,"body":230,"description":447,"extension":136,"meta":448,"navigation":138,"order":129,"path":449,"seo":450,"stem":451,"__hash__":452},"content_es\u002Finstallation.md","Instalación",{"type":7,"value":231,"toc":440},[232,235,249,253,275,278,282,296,299,303,328,339,343,350,354,369,399,415,436],[10,233,229],{"id":234},"instalación",[14,236,237,238,242,243,248],{},"Consigue una build en la ",[78,239,241],{"href":240},"\u002Fdownload","página de descarga"," o en ",[78,244,247],{"href":245,"rel":246},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Freleases\u002Flatest",[99],"GitHub Releases",". SoundNinja está en desarrollo temprano, así que trata las builds como beta.",[24,250,252],{"id":251},"windows","Windows",[29,254,255,266,269,272],{},[32,256,257,261,262,265],{},[258,259,260],"strong",{},"Instalador (.exe)"," o ",[258,263,264],{},"MSI (.msi)"," para Windows de 64 bits",[32,267,268],{},"Objetivo de la landing: Windows 10 y posterior",[32,270,271],{},"El README de la app también lista Windows 8 y superior",[32,273,274],{},"El instalador NSIS usa tema oscuro. Elige idioma en el setup — SoundNinja lo recuerda en el siguiente arranque.",[14,276,277],{},"Ejecuta el instalador y luego abre SoundNinja desde el menú Inicio.",[24,279,281],{"id":280},"macos","macOS",[29,283,284,290,293],{},[32,285,286,289],{},[258,287,288],{},".dmg universal"," para Apple Silicon e Intel",[32,291,292],{},"Objetivo de la landing: macOS 10.14 y posterior",[32,294,295],{},"El README de la app lista macOS 10.15 y superior",[14,297,298],{},"Abre la imagen de disco y arrastra SoundNinja a Aplicaciones.",[24,300,302],{"id":301},"linux","Linux",[29,304,305,311,317,325],{},[32,306,307,310],{},[258,308,309],{},"Debian (.deb)"," para Ubuntu \u002F Debian",[32,312,313,316],{},[258,314,315],{},"AppImage"," para otras distros",[32,318,319,320,324],{},"Tras publicar una release, los usuarios de Arch pueden instalar ",[321,322,323],"code",{},"soundninja-bin"," desde el AUR",[32,326,327],{},"Probado en Ubuntu 20.04",[14,329,330,331,334,335,338],{},"Las builds de escritorio necesitan paquetes WebKit y GTK. En Debian\u002FUbuntu eso suele ser ",[321,332,333],{},"libwebkit2gtk",", ",[321,336,337],{},"libgtk-3-0"," y una biblioteca app-indicator.",[24,340,342],{"id":341},"actualizaciones","Actualizaciones",[14,344,345,346,349],{},"En la app, abre ",[258,347,348],{},"Ayuda → Buscar actualizaciones",". También puedes dejar que SoundNinja compruebe al arrancar en Ajustes.",[24,351,353],{"id":352},"compilar-desde-el-código","Compilar desde el código",[14,355,356,357,362,363,368],{},"¿Necesitas una build personalizada? Clona ",[78,358,361],{"href":359,"rel":360},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja",[99],"el repo",", instala los ",[78,364,367],{"href":365,"rel":366},"https:\u002F\u002Fv2.tauri.app\u002Fstart\u002Fprerequisites\u002F",[99],"requisitos de Tauri"," y luego:",[370,371,375],"pre",{"className":372,"code":373,"language":374,"meta":128,"style":128},"language-bash shiki shiki-themes github-light github-dark","bun install\nbun run tauri:serve\n","bash",[321,376,377,389],{"__ignoreMap":128},[378,379,381,385],"span",{"class":380,"line":139},"line",[378,382,384],{"class":383},"sScJk","bun",[378,386,388],{"class":387},"sZZnC"," install\n",[378,390,391,393,396],{"class":380,"line":129},[378,392,384],{"class":383},[378,394,395],{"class":387}," run",[378,397,398],{"class":387}," tauri:serve\n",[14,400,401,334,404,261,407,410,411,414],{},[321,402,403],{},"npm",[321,405,406],{},"pnpm",[321,408,409],{},"deno"," también sirven. Build de producción: ",[321,412,413],{},"bun run tauri:build",".",[14,416,417,420,421,426,427,430,431,414],{},[258,418,419],{},"Solo Windows:"," cada compile de Windows incluye ASIO con el ",[78,422,425],{"href":423,"rel":424},"https:\u002F\u002Fwww.steinberg.net\u002Fasiosdk",[99],"Steinberg ASIO SDK",". Ejecuta ",[321,428,429],{},"bun run setup:asio"," una vez (el SDK no está en git). Linux y macOS usan PipeWire \u002F Core Audio — omite ese paso. Detalles: ",[78,432,435],{"href":433,"rel":434},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fblob\u002Fmain\u002Fdocs\u002Fbuild-from-source.md",[99],"build-from-source.md",[437,438,439],"style",{},"html pre.shiki code .sScJk, html code.shiki .sScJk{--shiki-default:#6F42C1;--shiki-dark:#B392F0}html pre.shiki code .sZZnC, html code.shiki .sZZnC{--shiki-default:#032F62;--shiki-dark:#9ECBFF}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html.dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}",{"title":128,"searchDepth":129,"depth":129,"links":441},[442,443,444,445,446],{"id":251,"depth":129,"text":252},{"id":280,"depth":129,"text":281},{"id":301,"depth":129,"text":302},{"id":341,"depth":129,"text":342},{"id":352,"depth":129,"text":353},"Instala SoundNinja en Windows, macOS o Linux.",{},"\u002Finstallation",{"title":229,"description":447},"installation","6QKa3OcTs0sq8JVvjceX-ugwL8mdPc4h6O-JOoo1Qd8",{"id":454,"title":120,"body":455,"description":594,"extension":136,"meta":595,"navigation":138,"order":596,"path":597,"seo":598,"stem":599,"__hash__":600},"content_es\u002Fadding-sounds.md",{"type":7,"value":456,"toc":586},[457,460,463,467,486,490,521,525,544,548,562,565,569,576,580],[10,458,120],{"id":459},"añadir-sonidos",[14,461,462],{},"Un tablero está vacío hasta que añades clips. SoundNinja puede importar archivos, carpetas enteras, una grabación o un pack de soundboard compartido.",[24,464,466],{"id":465},"importar-archivos-de-audio","Importar archivos de audio",[107,468,469,480,483],{},[32,470,471,472,475,476,479],{},"Abre ",[258,473,474],{},"Archivo → Importar archivos de audio",", o usa ",[258,477,478],{},"Importar"," en la barra de navegación.",[32,481,482],{},"Elige uno o más archivos de audio.",[32,484,485],{},"Los sonidos llegan a la pestaña actual.",[24,487,489],{"id":488},"importar-carpetas","Importar carpetas",[107,491,492,501,504],{},[32,493,471,494,497,498,500],{},[258,495,496],{},"Archivo → Importar carpetas"," (o ",[258,499,489],{}," en la barra de navegación).",[32,502,503],{},"Añade una o más carpetas. Arrastra para reordenarlas antes de importar.",[32,505,506,507],{},"Elige cómo llegan:\n",[29,508,509,515],{},[32,510,511,514],{},[258,512,513],{},"Importar como pestañas"," — cada carpeta se convierte en su propia pestaña",[32,516,517,520],{},[258,518,519],{},"Importar a la pestaña actual"," — cada archivo va a la pestaña activa",[24,522,524],{"id":523},"grabar-un-clip","Grabar un clip",[14,526,527,528,532,533,536,537,261,540,543],{},"Abre el ",[78,529,531],{"href":530},"\u002Fdocs\u002Frecording-editor","Record Editor"," desde el botón ",[258,534,535],{},"Grabar"," en la barra del reproductor. Captura, recorta y luego ",[258,538,539],{},"Importar selección",[258,541,542],{},"Importar todo"," en la pestaña actual o en una pestaña que elijas.",[24,545,547],{"id":546},"importar-un-soundboard","Importar un soundboard",[14,549,550,553,554,557,558,561],{},[258,551,552],{},"Archivo → Importar soundboard"," carga un pack compartido. Los packs son un ",[321,555,556],{},".zip"," que contiene ",[321,559,560],{},"project.sninja"," más los archivos de sonido. Tras importar, abre el proyecto y reproduce.",[14,563,564],{},"También puedes tener varios proyectos (perfiles). Usa el selector de proyecto para cambiar de tablero.",[24,566,568],{"id":567},"reenlazar-archivos-faltantes","Reenlazar archivos faltantes",[14,570,571,572,575],{},"Si los archivos de audio se mueven en el disco, SoundNinja muestra ",[258,573,574],{},"Archivos de sonido faltantes",". Elige una carpeta para buscar y reenlazar los clips.",[24,577,579],{"id":578},"siguiente","Siguiente",[14,581,582,583,414],{},"Organiza pestañas, etiquetas, filtros y atajos en ",[78,584,585],{"href":125},"Organizar sonidos",{"title":128,"searchDepth":129,"depth":129,"links":587},[588,589,590,591,592,593],{"id":465,"depth":129,"text":466},{"id":488,"depth":129,"text":489},{"id":523,"depth":129,"text":524},{"id":546,"depth":129,"text":547},{"id":567,"depth":129,"text":568},{"id":578,"depth":129,"text":579},"Importa audio, carpetas, grabaciones y soundboards compartidos.",{},3,"\u002Fadding-sounds",{"title":120,"description":594},"adding-sounds","O5nOJGNq2FL6jafUxqoGYNKJDVbb2UrZRjfKpK21LlQ",{"id":602,"title":585,"body":603,"description":1007,"extension":136,"meta":1008,"navigation":138,"order":1009,"path":1010,"seo":1011,"stem":1012,"__hash__":1013},"content_es\u002Forganizing-sounds.md",{"type":7,"value":604,"toc":992},[605,608,615,619,646,653,657,660,674,681,687,691,701,706,738,742,748,752,785,791,795,798,824,827,831,844,848,854,875,891,898,902,913,916,920,927,937,943,947,955,962,989],[10,606,585],{"id":607},"organizar-sonidos",[14,609,610,611,614],{},"SoundNinja está hecho para bibliotecas grandes. ",[258,612,613],{},"Etiquetas y filtros",", pestañas, búsqueda, selección múltiple y atajos — el clip que necesitas está a un clic (o una tecla).",[24,616,618],{"id":617},"pestañas","Pestañas",[29,620,621,628,635],{},[32,622,623,624,627],{},"Añade una pestaña con ",[258,625,626],{},"Añadir pestaña",". Dale un color para escanear la barra rápido.",[32,629,630,631,634],{},"La vista ",[258,632,633],{},"Todos"," muestra cada sonido de todas las pestañas.",[32,636,637,638,641,642,645],{},"Un sonido puede pertenecer a ",[258,639,640],{},"una o más pestañas",". Clic derecho en un sonido y usa ",[258,643,644],{},"Mover a pestaña"," para asignarlo.",[14,647,648,649,652],{},"Las transiciones de pestaña están en ",[258,650,651],{},"Ajustes → General",": Slide, Fade, Botones uno a uno, o Ninguna.",[24,654,656],{"id":655},"grupos","Grupos",[14,658,659],{},"Desde la v0.5.3, los separadores pueden convertirse en grupos con nombre:",[29,661,662,665,668,671],{},[32,663,664],{},"Añadir, renombrar o quitar un grupo desde el menú contextual",[32,666,667],{},"Arrastra la cabecera del grupo — los hijos se mueven con ella",[32,669,670],{},"Suelta sonidos dentro o fuera de un grupo",[32,672,673],{},"Define color de borde, color del nombre y alineación de botones (o usa el valor por defecto de la pestaña)",[14,675,676,677,680],{},"Sigue pudiendo añadir un ",[258,678,679],{},"Separador"," simple si solo necesitas un corte visual.",[14,682,683,684,414],{},"Clic derecho en el espacio vacío del tablero para ",[258,685,686],{},"Añadir grupo",[24,688,690],{"id":689},"etiquetas-filtros","Etiquetas \u002F Filtros",[14,692,693,694,697,698,700],{},"Las etiquetas cruzan las pestañas. El panel ",[258,695,696],{},"Filtro"," (barra lateral ",[258,699,696],{},") es donde las creas y filtras el tablero.",[702,703,705],"h3",{"id":704},"crear-y-editar-etiquetas","Crear y editar etiquetas",[107,707,708,713,724,731],{},[32,709,471,710,712],{},[258,711,696],{}," en la barra lateral.",[32,714,715,716,719,720,723],{},"En ",[258,717,718],{},"Etiquetas",", usa ",[258,721,722],{},"Añadir etiqueta"," — nombre y color.",[32,725,726,727,730],{},"Renombra, recolorea o ",[258,728,729],{},"Eliminar etiqueta"," en la misma lista.",[32,732,733,734,737],{},"Si ves ",[258,735,736],{},"Aún no hay etiquetas",", crea una aquí antes de asignar.",[702,739,741],{"id":740},"asignar-etiquetas-a-sonidos","Asignar etiquetas a sonidos",[14,743,744,745,747],{},"Clic derecho en un sonido → ",[258,746,718],{}," (casillas). Un sonido puede tener varias. Si aún no hay ninguna, el menú te lleva al panel de filtro.",[702,749,751],{"id":750},"filtrar-el-tablero","Filtrar el tablero",[29,753,754,760,771,782],{},[32,755,756,757,414],{},"Activa etiquetas en el panel Filtro o como ",[258,758,759],{},"chips bajo la barra de búsqueda",[32,761,762,763,766,767,770],{},"La coincidencia es ",[258,764,765],{},"OR",": un sonido sigue visible si tiene ",[258,768,769],{},"cualquiera"," de las etiquetas seleccionadas.",[32,772,773,774,777,778,781],{},"El campo ",[258,775,776],{},"Buscar"," combina con ",[258,779,780],{},"AND"," el filtro de etiquetas activo (texto + etiquetas juntos).",[32,783,784],{},"Apaga los chips (o limpia el filtro) para ver de nuevo toda la pestaña.",[14,786,787,788,414],{},"Los nombres de etiqueta en color pueden aparecer en los botones. Actívalos en ",[258,789,790],{},"Ajustes → Comportamiento → Mostrar badges de etiquetas",[24,792,794],{"id":793},"orden","Orden",[14,796,797],{},"Abre el panel de filtro y elige un modo:",[29,799,800,806],{},[32,801,802,805],{},[258,803,804],{},"Definido por el usuario"," — tu orden de pestaña, grupos visibles",[32,807,808,334,811,334,814,261,817,820,821],{},[258,809,810],{},"Nombre",[258,812,813],{},"Fecha de añadido",[258,815,816],{},"Tiempo de reproducción",[258,818,819],{},"Tamaño de archivo"," — lista plana ordenada; ",[258,822,823],{},"los grupos se ocultan",[14,825,826],{},"Ordenar por duración puede precargar los metadatos de duración la primera vez.",[24,828,830],{"id":829},"reordenar","Reordenar",[14,832,833,834,837,838,841,842,414],{},"Activa arrastrar y soltar en ",[258,835,836],{},"Ajustes → Comportamiento"," (",[258,839,840],{},"Permitir reordenar","). Luego arrastra sonidos y grupos a su sitio. Reordenar aplica en el orden ",[258,843,804],{},[24,845,847],{"id":846},"selección-múltiple","Selección múltiple",[14,849,850,851,853],{},"Activa ",[258,852,847],{}," en la barra de navegación, luego:",[29,855,856,859,865,872],{},[32,857,858],{},"Clic para alternar un sonido",[32,860,861,864],{},[258,862,863],{},"Mayús+clic"," para un rango desde el último ancla",[32,866,867,868,871],{},"Arrastra un ",[258,869,870],{},"marco"," en el espacio vacío del tablero",[32,873,874],{},"Clic en el tablero vacío (o fuera) para limpiar la selección",[14,876,877,878,334,881,334,884,887,888,414],{},"Una barra masiva muestra el recuento, más ",[258,879,880],{},"Color",[258,882,883],{},"Mover a pestaña…",[258,885,886],{},"Eliminar"," y ",[258,889,890],{},"Hecho",[14,892,893,894,897],{},"En selección múltiple, cada botón muestra un ",[258,895,896],{},"chip de ID de 8 caracteres",". Clic derecho en el chip para copiarlo.",[24,899,901],{"id":900},"volumen-por-sonido","Volumen por sonido",[14,903,904,905,908,909,912],{},"Clic derecho → ",[258,906,907],{},"Volumen",". Arrastra el control de 0 % a 100 %. ",[258,910,911],{},"Doble clic"," lo restablece a 100 %.",[14,914,915],{},"Se acumula con el volumen de salida maestro en Ajustes.",[24,917,919],{"id":918},"atajos-e-ids-de-sonido","Atajos e IDs de sonido",[14,921,922,923,926],{},"Cada sonido tiene un ID de 8 caracteres. Cópialo desde el menú contextual del botón (",[258,924,925],{},"Copiar ID",") o el chip de ID de la selección múltiple.",[14,928,471,929,932,933,936],{},[258,930,931],{},"Ajustes → Atajos"," para vincular una tecla a un ID de sonido. Los atajos globales son opcionales. ",[258,934,935],{},"Asignar atajo"," en el menú contextual salta allí con el ID rellenado.",[14,938,939,940,942],{},"El mismo ID es el que ",[78,941,81],{"href":80}," usa para disparar un clip.",[24,944,946],{"id":945},"imágenes-de-fondo-y-colores","Imágenes de fondo y colores",[14,948,949,950,954],{},"Clic derecho en un sonido para definir colores por botón o una imagen de fondo. Eso es independiente del ",[78,951,953],{"href":952},"\u002Fdocs\u002Ftheme-editor","Theme Creator",", que da estilo a todo el tablero.",[14,956,957,958,961],{},"El selector es un diálogo ",[258,959,960],{},"Imagen de fondo"," (PNG, JPEG, GIF, WebP):",[29,963,964,970,980],{},[32,965,966,969],{},[258,967,968],{},"Archivos locales"," — añade carpetas, elige un archivo, busca por nombre, previsualiza la cuadrícula o quita una carpeta de la biblioteca",[32,971,972,975,976,414],{},[258,973,974],{},"GifSnap"," — busca GIFs en línea sin clave API. La primera visita pide aceptar las peticiones a GifSnap; los resultados se cachean para reducir tráfico. Ver ",[78,977,974],{"href":978,"rel":979},"https:\u002F\u002Fgifsnap.com",[99],[32,981,982,985,986,988],{},[258,983,984],{},"KLIPY"," — busca GIFs en línea. Pon tu propia clave API en ",[258,987,836],{},". La clave no se guarda en los archivos del proyecto.",[14,990,991],{},"Tras elegir, mueve y recorta la imagen en el botón.",{"title":128,"searchDepth":129,"depth":129,"links":993},[994,995,996,1001,1002,1003,1004,1005,1006],{"id":617,"depth":129,"text":618},{"id":655,"depth":129,"text":656},{"id":689,"depth":129,"text":690,"children":997},[998,999,1000],{"id":704,"depth":596,"text":705},{"id":740,"depth":596,"text":741},{"id":750,"depth":596,"text":751},{"id":793,"depth":129,"text":794},{"id":829,"depth":129,"text":830},{"id":846,"depth":129,"text":847},{"id":900,"depth":129,"text":901},{"id":918,"depth":129,"text":919},{"id":945,"depth":129,"text":946},"Etiquetas, filtros, pestañas, grupos, orden, selección múltiple, volumen y atajos.",{},4,"\u002Forganizing-sounds",{"title":585,"description":1007},"organizing-sounds","v2Vh-pefsaiWoUdwQrv4wMerfeXZbtLIa6iq8beVync",{"id":1015,"title":1016,"body":1017,"description":1142,"extension":136,"meta":1143,"navigation":138,"order":1144,"path":1145,"seo":1146,"stem":1147,"__hash__":1148},"content_es\u002Ftheme-editor.md","Editor de temas",{"type":7,"value":1018,"toc":1136},[1019,1022,1028,1032,1059,1062,1066,1080,1084,1110,1113,1117,1122],[10,1020,1016],{"id":1021},"editor-de-temas",[14,1023,1024,1025,414],{},"El Theme Creator es el editor visual completo de tu tablero. Ábrelo desde ",[258,1026,1027],{},"Ajustes → General → Theme Creator",[24,1029,1031],{"id":1030},"tres-pestañas","Tres pestañas",[107,1033,1034,1048,1054],{},[32,1035,1036,1039,1040,1043,1044,1047],{},[258,1037,1038],{},"General"," — nombre del tema, colores compartidos y carga de fuentes (",[321,1041,1042],{},".ttf"," \u002F ",[321,1045,1046],{},".otf",")",[32,1049,1050,1053],{},[258,1051,1052],{},"Botones"," — colores, tipo, diseño y overlay GIF de los botones de sonido",[32,1055,1056,1058],{},[258,1057,618],{}," — colores, tipo y grosor de borde de la barra de pestañas",[14,1060,1061],{},"Una vista previa en vivo muestra pestañas y botones mientras editas.",[24,1063,1065],{"id":1064},"qué-puedes-cambiar","Qué puedes cambiar",[29,1067,1068,1071,1074,1077],{},[32,1069,1070],{},"Colores primario y de acento, fondos, colores de botones, colores de pestañas",[32,1072,1073],{},"Familia y tamaño de fuente de botones y pestañas",[32,1075,1076],{},"Ancho, radio, borde, huecos y padding de los botones",[32,1078,1079],{},"Opacidad del overlay GIF (normal y hover)",[24,1081,1083],{"id":1082},"guardar-y-compartir","Guardar y compartir",[29,1085,1086,1092,1098,1104],{},[32,1087,1088,1091],{},[258,1089,1090],{},"Exportar .css"," — escribe un archivo de tema para respaldar o enviar a un amigo",[32,1093,1094,1097],{},[258,1095,1096],{},"Añadir a temas"," — guarda el archivo en tu carpeta Themes y aplícalo",[32,1099,1100,1103],{},[258,1101,1102],{},"Importar .css"," — carga un preset integrado o un tema guardado",[32,1105,1106,1109],{},[258,1107,1108],{},"Restablecer"," — vuelve a los valores por defecto de SoundNinja",[14,1111,1112],{},"Si cierras la ventana con cambios sin guardar, SoundNinja te pide que guardes primero.",[24,1114,1116],{"id":1115},"sin-el-editor-completo","Sin el editor completo",[14,1118,715,1119,1121],{},[258,1120,651],{}," aún puedes:",[29,1123,1124,1127,1133],{},[32,1125,1126],{},"Elegir un tema de la lista",[32,1128,1129,1130,1047],{},"Editar variables CSS en vivo (",[258,1131,1132],{},"CSS personalizado",[32,1134,1135],{},"Importar un archivo de tema a la carpeta Themes",{"title":128,"searchDepth":129,"depth":129,"links":1137},[1138,1139,1140,1141],{"id":1030,"depth":129,"text":1031},{"id":1064,"depth":129,"text":1065},{"id":1082,"depth":129,"text":1083},{"id":1115,"depth":129,"text":1116},"Diseña colores, fuentes, botones y pestañas en el Theme Creator.",{},5,"\u002Ftheme-editor",{"title":1016,"description":1142},"theme-editor","bPcJP7OLtBsnNMYJ-S1J6DmB6nngULo1_Q1hBJMNZAQ",{"id":1150,"title":1151,"body":1152,"description":1288,"extension":136,"meta":1289,"navigation":138,"order":1290,"path":1291,"seo":1292,"stem":1293,"__hash__":1294},"content_es\u002Frecording-editor.md","Editor de grabación",{"type":7,"value":1153,"toc":1282},[1154,1157,1163,1167,1173,1193,1196,1200,1225,1229,1243,1247,1261,1272],[10,1155,1151],{"id":1156},"editor-de-grabación",[14,1158,1159,1160,1162],{},"Graba un clip dentro de SoundNinja, recórtalo e impórtalo a una pestaña. Abre el editor con el botón ",[258,1161,535],{}," en la barra del reproductor.",[24,1164,1166],{"id":1165},"elegir-una-entrada","Elegir una entrada",[14,1168,715,1169,1172],{},[258,1170,1171],{},"Ajustes → Audio",":",[29,1174,1175,1181,1187],{},[32,1176,1177,1180],{},[258,1178,1179],{},"Dispositivos de entrada"," — micrófono",[32,1182,1183,1186],{},[258,1184,1185],{},"Dispositivos de salida (audio del PC)"," — loopback de lo que reproduce el PC",[32,1188,1189,1192],{},[258,1190,1191],{},"Volumen de entrada"," — ganancia de captura del 0 % al 200 %",[14,1194,1195],{},"El botón Grabar usa el dispositivo que eliges aquí.",[24,1197,1199],{"id":1198},"editar-la-toma","Editar la toma",[29,1201,1202,1205,1208,1216,1219,1222],{},[32,1203,1204],{},"Grabar y detener",[32,1206,1207],{},"Observar el medidor de nivel de entrada",[32,1209,1210,261,1213],{},[258,1211,1212],{},"Normalizar",[258,1214,1215],{},"Cancelación de ruido",[32,1217,1218],{},"Recortar todo el clip, recortar a una selección o borrar una selección",[32,1220,1221],{},"Deshacer \u002F rehacer",[32,1223,1224],{},"Acercar y alejar",[24,1226,1228],{"id":1227},"preparar-e-importar","Preparar e importar",[107,1230,1231,1234,1237],{},[32,1232,1233],{},"Añade la selección o la pista completa a la lista de staging.",[32,1235,1236],{},"La lista empieza vacía: graba, edita y luego añade un clip.",[32,1238,1239,261,1241,543],{},[258,1240,539],{},[258,1242,542],{},[24,1244,1246],{"id":1245},"separación-de-stems-opcional","Separación de stems (opcional)",[14,1248,1249,1250,1253,1254,261,1257,1260],{},"Las builds oficiales de Windows, macOS y Linux incluyen la función ",[258,1251,1252],{},"stems",". El Record Editor puede conservar ",[258,1255,1256],{},"voces",[258,1258,1259],{},"música"," con BS-RoFormer.",[14,1262,1263,1264,1267,1268,1271],{},"El modelo pesa unos 158 MB y ",[258,1265,1266],{},"no"," viene en el instalador. Descárgalo desde ",[258,1269,1270],{},"Ajustes → Separación de stems",", o acepta el aviso del primer arranque. El instalador de Windows también puede ofrecer descargar el modelo al primer inicio.",[14,1273,1274,1275,1043,1278,1281],{},"Las builds personalizadas desde código necesitan un flag extra (",[321,1276,1277],{},"tauri:serve:stems",[321,1279,1280],{},"tauri:build:stems",").",{"title":128,"searchDepth":129,"depth":129,"links":1283},[1284,1285,1286,1287],{"id":1165,"depth":129,"text":1166},{"id":1198,"depth":129,"text":1199},{"id":1227,"depth":129,"text":1228},{"id":1245,"depth":129,"text":1246},"Captura micrófono o audio del PC, edita el clip y suéltalo en tu tablero.",{},6,"\u002Frecording-editor",{"title":1151,"description":1288},"recording-editor","89aDSCp7hE8To2TNFwdWaImQVsHH2-xNcOyltCPP5IY",{"id":1296,"title":1297,"body":1298,"description":1510,"extension":136,"meta":1511,"navigation":138,"order":1512,"path":1513,"seo":1514,"stem":1515,"__hash__":1516},"content_es\u002Fremote-control.md","Control remoto",{"type":7,"value":1299,"toc":1503},[1300,1303,1306,1310,1339,1342,1345,1380,1384,1404,1407,1411,1443,1447,1453],[10,1301,1297],{"id":1302},"control-remoto",[14,1304,1305],{},"SoundNinja puede escuchar en tu red local para que Bitfocus Companion (o cualquier cliente HTTP\u002FWebSocket) reproduzca y detenga sonidos.",[24,1307,1309],{"id":1308},"activar-el-servidor-remoto","Activar el servidor remoto",[107,1311,1312,1317,1323,1329],{},[32,1313,471,1314,414],{},[258,1315,1316],{},"Ajustes → Remoto",[32,1318,1319,1320,414],{},"Activa el servidor remoto. El puerto por defecto es ",[258,1321,1322],{},"7331",[32,1324,1325,1326,414],{},"Opcional: define un token. Los clientes deben enviarlo como Bearer token o ",[321,1327,1328],{},"?token=",[32,1330,1331,1332,1335,1336,414],{},"Copia la URL ",[321,1333,1334],{},"http:\u002F\u002FIP:PORT",", o copia la IP del sistema desde ",[258,1337,1338],{},"Ajustes → Acerca de",[14,1340,1341],{},"Windows puede mostrar un aviso del firewall la primera vez que arranca el servidor. Permite el acceso a la red privada.",[24,1343,81],{"id":1344},"bitfocus-companion",[107,1346,1347,1354,1363,1373],{},[32,1348,1349,1350,414],{},"Instala ",[78,1351,81],{"href":1352,"rel":1353},"https:\u002F\u002Fbitfocus.io\u002Fcompanion",[99],[32,1355,1356,1357,1362],{},"Descarga ",[78,1358,1361],{"href":1359,"rel":1360},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002Fcompanion-module-soundninja\u002Freleases\u002Flatest",[99],"SoundNinja-Companion.tgz",". Aún no hay paquete en Companion Store.",[32,1364,1365,1366,1369,1370,414],{},"En Companion: ",[258,1367,1368],{},"Modules → Load module package"," y elige el ",[321,1371,1372],{},".tgz",[32,1374,1375,1376,1379],{},"Añade una conexión ",[258,1377,1378],{},"Sound Ninja",". Pega la IP del PC, el puerto y el token si definiste uno.",[24,1381,1383],{"id":1382},"acciones","Acciones",[29,1385,1386,1392,1398],{},[32,1387,1388,1391],{},[258,1389,1390],{},"Trigger Sound"," — elige en el menú desplegable en vivo, o escribe un ID de sonido de 8 caracteres (las variables de Companion funcionan)",[32,1393,1394,1397],{},[258,1395,1396],{},"Stop Sound"," — detiene un sonido en reproducción por ID",[32,1399,1400,1403],{},[258,1401,1402],{},"Stop All"," — detiene todos los sonidos en reproducción",[14,1405,1406],{},"Copia un ID de sonido en SoundNinja desde el menú contextual del botón o el chip de ID de la selección múltiple.",[24,1408,1410],{"id":1409},"feedbacks-y-variables","Feedbacks y variables",[29,1412,1413,1419,1431,1437],{},[32,1414,1415,1418],{},[258,1416,1417],{},"Sound Playing"," — verdadero mientras ese ID de sonido está activo (úsalo para el color del botón)",[32,1420,1421,1424,1425,1043,1428],{},[321,1422,1423],{},"$(soundninja:connected)"," — ",[321,1426,1427],{},"true",[321,1429,1430],{},"false",[32,1432,1433,1436],{},[321,1434,1435],{},"$(soundninja:playing_count)"," — cuántos sonidos suenan",[32,1438,1439,1442],{},[321,1440,1441],{},"$(soundninja:last_triggered)"," — último ID de sonido disparado",[24,1444,1446],{"id":1445},"api-http-avanzado","API HTTP (avanzado)",[14,1448,1449,1450],{},"Ruta base: ",[321,1451,1452],{},"\u002Fapi\u002Fv1",[29,1454,1455,1461,1467,1473,1483,1489,1497],{},[32,1456,1457,1460],{},[321,1458,1459],{},"GET \u002Finfo"," — nombre de la app, versión, protocolo, si se requiere un token",[32,1462,1463,1466],{},[321,1464,1465],{},"GET \