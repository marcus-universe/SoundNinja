[{"data":1,"prerenderedAt":1316},["ShallowReactive",2],{"docs-page-es-\u002Foverview":3,"docs-nav-es":135},{"id":4,"title":5,"body":6,"description":126,"extension":127,"meta":128,"navigation":129,"order":130,"path":131,"seo":132,"stem":133,"__hash__":134},"content_es\u002Foverview.md","Resumen",{"type":7,"value":8,"toc":118},"minimark",[9,13,17,20,23,28,44,48,79,83,93,97],[10,11,5],"h1",{"id":12},"resumen",[14,15,16],"p",{},"SoundNinja es un soundboard de código abierto para streaming en directo, charlas con amigos y grabación de podcasts. Está construido con Tauri v2 y Nuxt 4 para que sea ligero en RAM y disco.",[14,18,19],{},"El objetivo es simple: mantener una biblioteca enorme fácil de recorrer y reproducir el clip correcto en milisegundos. La interfaz también funciona bien como panel en VR.",[14,21,22],{},"SoundNinja sigue en desarrollo temprano. Las funciones marchan, pero no todas las plataformas están del todo probadas.",[24,25,27],"h2",{"id":26},"para-quién","Para quién",[29,30,31,35,38,41],"ul",{},[32,33,34],"li",{},"Streamers que necesitan cues de sonido al instante",[32,36,37],{},"Amigos que quieren un tablero compartido para el chat de voz",[32,39,40],{},"Podcasters que graban clips y los sueltan en un tablero",[32,42,43],{},"Quien quiera un soundboard personalizable y local-first",[24,45,47],{"id":46},"qué-puedes-hacer","Qué puedes hacer",[29,49,50,53,56,59,62,65,73,76],{},[32,51,52],{},"Montar un soundboard con tus propios archivos de audio",[32,54,55],{},"Organizar sonidos en pestañas de colores, grupos y búsqueda",[32,57,58],{},"Diseñar el aspecto con el Theme Creator",[32,60,61],{},"Grabar audio del PC o un micrófono en el Record Editor",[32,63,64],{},"Asignar atajos a sonidos individuales",[32,66,67,68],{},"Disparar sonidos desde ",[69,70,72],"a",{"href":71},"\u002Fdocs\u002Fremote-control","Bitfocus Companion",[32,74,75],{},"Importar y exportar un soundboard completo para compartirlo",[32,77,78],{},"Usar GIFs o imágenes en los botones de sonido",[24,80,82],{"id":81},"licencia","Licencia",[14,84,85,86,92],{},"SoundNinja es software libre bajo ",[69,87,91],{"href":88,"rel":89},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fblob\u002Fmain\u002FLICENSE",[90],"nofollow","GPL-3.0",". Haz fork, cámbialo, compártelo.",[24,94,96],{"id":95},"siguientes-pasos","Siguientes pasos",[98,99,100,106,112],"ol",{},[32,101,102],{},[69,103,105],{"href":104},"\u002Fdocs\u002Finstallation","Instalar SoundNinja",[32,107,108],{},[69,109,111],{"href":110},"\u002Fdocs\u002Fadding-sounds","Añadir sonidos",[32,113,114],{},[69,115,117],{"href":116},"\u002Fdocs\u002Forganizing-sounds","Organizar tu tablero",{"title":119,"searchDepth":120,"depth":120,"links":121},"",2,[122,123,124,125],{"id":26,"depth":120,"text":27},{"id":46,"depth":120,"text":47},{"id":81,"depth":120,"text":82},{"id":95,"depth":120,"text":96},"Qué es SoundNinja y qué puedes hacer con él.","md",{},true,1,"\u002Foverview",{"title":5,"description":126},"overview","_jbFAqK9Ea28XfzNs3a2S9mJrWOMez_Uxtm9qlYTevc",[136,212,414,562,718,854,996,1218],{"id":4,"title":5,"body":137,"description":126,"extension":127,"meta":210,"navigation":129,"order":130,"path":131,"seo":211,"stem":133,"__hash__":134},{"type":7,"value":138,"toc":204},[139,141,143,145,147,149,159,161,181,183,188,190],[10,140,5],{"id":12},[14,142,16],{},[14,144,19],{},[14,146,22],{},[24,148,27],{"id":26},[29,150,151,153,155,157],{},[32,152,34],{},[32,154,37],{},[32,156,40],{},[32,158,43],{},[24,160,47],{"id":46},[29,162,163,165,167,169,171,173,177,179],{},[32,164,52],{},[32,166,55],{},[32,168,58],{},[32,170,61],{},[32,172,64],{},[32,174,67,175],{},[69,176,72],{"href":71},[32,178,75],{},[32,180,78],{},[24,182,82],{"id":81},[14,184,85,185,92],{},[69,186,91],{"href":88,"rel":187},[90],[24,189,96],{"id":95},[98,191,192,196,200],{},[32,193,194],{},[69,195,105],{"href":104},[32,197,198],{},[69,199,111],{"href":110},[32,201,202],{},[69,203,117],{"href":116},{"title":119,"searchDepth":120,"depth":120,"links":205},[206,207,208,209],{"id":26,"depth":120,"text":27},{"id":46,"depth":120,"text":47},{"id":81,"depth":120,"text":82},{"id":95,"depth":120,"text":96},{},{"title":5,"description":126},{"id":213,"title":214,"body":215,"description":408,"extension":127,"meta":409,"navigation":129,"order":120,"path":410,"seo":411,"stem":412,"__hash__":413},"content_es\u002Finstallation.md","Instalación",{"type":7,"value":216,"toc":401},[217,220,234,238,257,260,264,278,281,285,310,321,325,332,336,351,381,397],[10,218,214],{"id":219},"instalación",[14,221,222,223,227,228,233],{},"Consigue una build en la ",[69,224,226],{"href":225},"\u002Fdownload","página de descarga"," o en ",[69,229,232],{"href":230,"rel":231},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Freleases\u002Flatest",[90],"GitHub Releases",". SoundNinja está en desarrollo temprano, así que trata las builds como beta.",[24,235,237],{"id":236},"windows","Windows",[29,239,240,251,254],{},[32,241,242,246,247,250],{},[243,244,245],"strong",{},"Instalador (.exe)"," o ",[243,248,249],{},"MSI (.msi)"," para Windows de 64 bits",[32,252,253],{},"Objetivo de la landing: Windows 10 y posterior",[32,255,256],{},"El README de la app también lista Windows 8 y superior",[14,258,259],{},"Ejecuta el instalador y luego abre SoundNinja desde el menú Inicio.",[24,261,263],{"id":262},"macos","macOS",[29,265,266,272,275],{},[32,267,268,271],{},[243,269,270],{},".dmg universal"," para Apple Silicon e Intel",[32,273,274],{},"Objetivo de la landing: macOS 10.14 y posterior",[32,276,277],{},"El README de la app lista macOS 10.15 y superior",[14,279,280],{},"Abre la imagen de disco y arrastra SoundNinja a Aplicaciones.",[24,282,284],{"id":283},"linux","Linux",[29,286,287,293,299,307],{},[32,288,289,292],{},[243,290,291],{},"Debian (.deb)"," para Ubuntu \u002F Debian",[32,294,295,298],{},[243,296,297],{},"AppImage"," para otras distros",[32,300,301,302,306],{},"Tras publicar una release, los usuarios de Arch pueden instalar ",[303,304,305],"code",{},"soundninja-bin"," desde el AUR",[32,308,309],{},"Probado en Ubuntu 20.04",[14,311,312,313,316,317,320],{},"Las builds de escritorio necesitan paquetes WebKit y GTK. En Debian\u002FUbuntu eso suele ser ",[303,314,315],{},"libwebkit2gtk",", ",[303,318,319],{},"libgtk-3-0"," y una biblioteca app-indicator.",[24,322,324],{"id":323},"actualizaciones","Actualizaciones",[14,326,327,328,331],{},"En la app, abre ",[243,329,330],{},"Ayuda → Buscar actualizaciones",". También puedes dejar que SoundNinja compruebe al arrancar en Ajustes.",[24,333,335],{"id":334},"compilar-desde-el-código","Compilar desde el código",[14,337,338,339,344,345,350],{},"¿Necesitas una build personalizada? Clona ",[69,340,343],{"href":341,"rel":342},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja",[90],"el repo",", instala los ",[69,346,349],{"href":347,"rel":348},"https:\u002F\u002Fv2.tauri.app\u002Fstart\u002Fprerequisites\u002F",[90],"requisitos de Tauri"," y luego:",[352,353,357],"pre",{"className":354,"code":355,"language":356,"meta":119,"style":119},"language-bash shiki shiki-themes github-light github-dark","bun install\nbun run tauri:serve\n","bash",[303,358,359,371],{"__ignoreMap":119},[360,361,363,367],"span",{"class":362,"line":130},"line",[360,364,366],{"class":365},"sScJk","bun",[360,368,370],{"class":369},"sZZnC"," install\n",[360,372,373,375,378],{"class":362,"line":120},[360,374,366],{"class":365},[360,376,377],{"class":369}," run",[360,379,380],{"class":369}," tauri:serve\n",[14,382,383,316,386,246,389,392,393,396],{},[303,384,385],{},"npm",[303,387,388],{},"pnpm",[303,390,391],{},"deno"," también sirven. Build de producción: ",[303,394,395],{},"bun run tauri:build",".",[398,399,400],"style",{},"html pre.shiki code .sScJk, html code.shiki .sScJk{--shiki-default:#6F42C1;--shiki-dark:#B392F0}html pre.shiki code .sZZnC, html code.shiki .sZZnC{--shiki-default:#032F62;--shiki-dark:#9ECBFF}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html.dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}",{"title":119,"searchDepth":120,"depth":120,"links":402},[403,404,405,406,407],{"id":236,"depth":120,"text":237},{"id":262,"depth":120,"text":263},{"id":283,"depth":120,"text":284},{"id":323,"depth":120,"text":324},{"id":334,"depth":120,"text":335},"Instala SoundNinja en Windows, macOS o Linux.",{},"\u002Finstallation",{"title":214,"description":408},"installation","DZ0nnkuNJ5bWc2nnZMQjtBcj72EEzzogekGEbJUmx80",{"id":415,"title":111,"body":416,"description":555,"extension":127,"meta":556,"navigation":129,"order":557,"path":558,"seo":559,"stem":560,"__hash__":561},"content_es\u002Fadding-sounds.md",{"type":7,"value":417,"toc":547},[418,421,424,428,447,451,482,486,505,509,523,526,530,537,541],[10,419,111],{"id":420},"añadir-sonidos",[14,422,423],{},"Un tablero está vacío hasta que añades clips. SoundNinja puede importar archivos, carpetas enteras, una grabación o un pack de soundboard compartido.",[24,425,427],{"id":426},"importar-archivos-de-audio","Importar archivos de audio",[98,429,430,441,444],{},[32,431,432,433,436,437,440],{},"Abre ",[243,434,435],{},"Archivo → Importar archivos de audio",", o usa ",[243,438,439],{},"Importar"," en la barra de navegación.",[32,442,443],{},"Elige uno o más archivos de audio.",[32,445,446],{},"Los sonidos llegan a la pestaña actual.",[24,448,450],{"id":449},"importar-carpetas","Importar carpetas",[98,452,453,462,465],{},[32,454,432,455,458,459,461],{},[243,456,457],{},"Archivo → Importar carpetas"," (o ",[243,460,450],{}," en la barra de navegación).",[32,463,464],{},"Añade una o más carpetas. Arrastra para reordenarlas antes de importar.",[32,466,467,468],{},"Elige cómo llegan:\n",[29,469,470,476],{},[32,471,472,475],{},[243,473,474],{},"Importar como pestañas"," — cada carpeta se convierte en su propia pestaña",[32,477,478,481],{},[243,479,480],{},"Importar a la pestaña actual"," — cada archivo va a la pestaña activa",[24,483,485],{"id":484},"grabar-un-clip","Grabar un clip",[14,487,488,489,493,494,497,498,246,501,504],{},"Abre el ",[69,490,492],{"href":491},"\u002Fdocs\u002Frecording-editor","Record Editor"," desde el botón ",[243,495,496],{},"Grabar"," en la barra del reproductor. Captura, recorta y luego ",[243,499,500],{},"Importar selección",[243,502,503],{},"Importar todo"," en la pestaña actual o en una pestaña que elijas.",[24,506,508],{"id":507},"importar-un-soundboard","Importar un soundboard",[14,510,511,514,515,518,519,522],{},[243,512,513],{},"Archivo → Importar soundboard"," carga un pack compartido. Los packs son un ",[303,516,517],{},".zip"," que contiene ",[303,520,521],{},"project.sninja"," más los archivos de sonido. Tras importar, abre el proyecto y reproduce.",[14,524,525],{},"También puedes tener varios proyectos (perfiles). Usa el selector de proyecto para cambiar de tablero.",[24,527,529],{"id":528},"reenlazar-archivos-faltantes","Reenlazar archivos faltantes",[14,531,532,533,536],{},"Si los archivos de audio se mueven en el disco, SoundNinja muestra ",[243,534,535],{},"Archivos de sonido faltantes",". Elige una carpeta para buscar y reenlazar los clips.",[24,538,540],{"id":539},"siguiente","Siguiente",[14,542,543,544,396],{},"Organiza pestañas, grupos y atajos en ",[69,545,546],{"href":116},"Organizar sonidos",{"title":119,"searchDepth":120,"depth":120,"links":548},[549,550,551,552,553,554],{"id":426,"depth":120,"text":427},{"id":449,"depth":120,"text":450},{"id":484,"depth":120,"text":485},{"id":507,"depth":120,"text":508},{"id":528,"depth":120,"text":529},{"id":539,"depth":120,"text":540},"Importa audio, carpetas, grabaciones y soundboards compartidos.",{},3,"\u002Fadding-sounds",{"title":111,"description":555},"adding-sounds","Pp2z7pkBymoeTp058Pu8gOujI6GqQLoQ-Go0ZA2L1F4",{"id":563,"title":546,"body":564,"description":711,"extension":127,"meta":712,"navigation":129,"order":713,"path":714,"seo":715,"stem":716,"__hash__":717},"content_es\u002Forganizing-sounds.md",{"type":7,"value":565,"toc":702},[566,569,572,576,603,610,614,617,631,638,642,649,653,664,668,671,675,678,684,690,694],[10,567,546],{"id":568},"organizar-sonidos",[14,570,571],{},"SoundNinja está hecho para bibliotecas grandes. Usa pestañas, grupos, búsqueda y atajos para que el clip que necesitas esté a un clic (o una tecla) de distancia.",[24,573,575],{"id":574},"pestañas","Pestañas",[29,577,578,585,592],{},[32,579,580,581,584],{},"Añade una pestaña con ",[243,582,583],{},"Añadir pestaña",". Dale un color para escanear la barra rápido.",[32,586,587,588,591],{},"La vista ",[243,589,590],{},"Todos"," muestra cada sonido de todas las pestañas.",[32,593,594,595,598,599,602],{},"Un sonido puede pertenecer a ",[243,596,597],{},"una o más pestañas",". Clic derecho en un sonido y usa ",[243,600,601],{},"Mover a pestaña"," para asignarlo.",[14,604,605,606,609],{},"Las transiciones de pestaña están en ",[243,607,608],{},"Ajustes → General",": Slide, Fade, Botones uno a uno, o Ninguna.",[24,611,613],{"id":612},"grupos","Grupos",[14,615,616],{},"Desde la v0.5.3, los separadores pueden convertirse en grupos con nombre:",[29,618,619,622,625,628],{},[32,620,621],{},"Añadir, renombrar o quitar un grupo desde el menú contextual",[32,623,624],{},"Arrastra la cabecera del grupo — los hijos se mueven con ella",[32,626,627],{},"Suelta sonidos dentro o fuera de un grupo",[32,629,630],{},"Define color de borde, color del nombre y alineación de botones (o usa el valor por defecto de la pestaña)",[14,632,633,634,637],{},"Sigue pudiendo añadir un ",[243,635,636],{},"Separador"," simple si solo necesitas un corte visual.",[24,639,641],{"id":640},"búsqueda","Búsqueda",[14,643,644,645,648],{},"Usa el campo ",[243,646,647],{},"Buscar"," en la barra de navegación. Los resultados se actualizan mientras escribes.",[24,650,652],{"id":651},"reordenar","Reordenar",[14,654,655,656,659,660,663],{},"Activa arrastrar y soltar en ",[243,657,658],{},"Ajustes → Comportamiento"," (",[243,661,662],{},"Permitir reordenar","). Luego arrastra sonidos y grupos a su sitio.",[24,665,667],{"id":666},"edición-masiva","Edición masiva",[14,669,670],{},"Selecciona varios sonidos y cambia el color, muévelos a una pestaña o elimínalos de una vez.",[24,672,674],{"id":673},"atajos-e-ids-de-sonido","Atajos e IDs de sonido",[14,676,677],{},"Cada sonido tiene un ID de 8 caracteres. Cópialo desde el menú contextual del botón o el chip de ID de la selección múltiple.",[14,679,432,680,683],{},[243,681,682],{},"Ajustes → Atajos"," para vincular una tecla a un ID de sonido. Los atajos globales son opcionales.",[14,685,686,687,689],{},"El mismo ID es el que ",[69,688,72],{"href":71}," usa para disparar un clip.",[24,691,693],{"id":692},"gifs-y-colores","GIFs y colores",[14,695,696,697,701],{},"Clic derecho en un sonido para definir colores por botón o un fondo GIF \u002F imagen. Eso es independiente del ",[69,698,700],{"href":699},"\u002Fdocs\u002Ftheme-editor","Theme Creator",", que da estilo a todo el tablero.",{"title":119,"searchDepth":120,"depth":120,"links":703},[704,705,706,707,708,709,710],{"id":574,"depth":120,"text":575},{"id":612,"depth":120,"text":613},{"id":640,"depth":120,"text":641},{"id":651,"depth":120,"text":652},{"id":666,"depth":120,"text":667},{"id":673,"depth":120,"text":674},{"id":692,"depth":120,"text":693},"Pestañas, grupos, búsqueda, edición masiva y atajos.",{},4,"\u002Forganizing-sounds",{"title":546,"description":711},"organizing-sounds","L2-ttc1gCTlJQIkJYckTzh-JzPPPTLU4m0uGjwPApXk",{"id":719,"title":720,"body":721,"description":847,"extension":127,"meta":848,"navigation":129,"order":849,"path":850,"seo":851,"stem":852,"__hash__":853},"content_es\u002Ftheme-editor.md","Editor de temas",{"type":7,"value":722,"toc":841},[723,726,732,736,763,766,770,784,788,814,817,821,827],[10,724,720],{"id":725},"editor-de-temas",[14,727,728,729,396],{},"El Theme Creator es el editor visual completo de tu tablero. Ábrelo desde ",[243,730,731],{},"Ajustes → General → Theme Creator",[24,733,735],{"id":734},"tres-pestañas","Tres pestañas",[98,737,738,752,758],{},[32,739,740,743,744,747,748,751],{},[243,741,742],{},"General"," — nombre del tema, colores compartidos y carga de fuentes (",[303,745,746],{},".ttf"," \u002F ",[303,749,750],{},".otf",")",[32,753,754,757],{},[243,755,756],{},"Botones"," — colores, tipo, diseño y overlay GIF de los botones de sonido",[32,759,760,762],{},[243,761,575],{}," — colores, tipo y grosor de borde de la barra de pestañas",[14,764,765],{},"Una vista previa en vivo muestra pestañas y botones mientras editas.",[24,767,769],{"id":768},"qué-puedes-cambiar","Qué puedes cambiar",[29,771,772,775,778,781],{},[32,773,774],{},"Colores primario y de acento, fondos, colores de botones, colores de pestañas",[32,776,777],{},"Familia y tamaño de fuente de botones y pestañas",[32,779,780],{},"Ancho, radio, borde, huecos y padding de los botones",[32,782,783],{},"Opacidad del overlay GIF (normal y hover)",[24,785,787],{"id":786},"guardar-y-compartir","Guardar y compartir",[29,789,790,796,802,808],{},[32,791,792,795],{},[243,793,794],{},"Exportar .css"," — escribe un archivo de tema para respaldar o enviar a un amigo",[32,797,798,801],{},[243,799,800],{},"Añadir a temas"," — guarda el archivo en tu carpeta Themes y aplícalo",[32,803,804,807],{},[243,805,806],{},"Importar .css"," — carga un preset integrado o un tema guardado",[32,809,810,813],{},[243,811,812],{},"Restablecer"," — vuelve a los valores por defecto de SoundNinja",[14,815,816],{},"Si cierras la ventana con cambios sin guardar, SoundNinja te pide que guardes primero.",[24,818,820],{"id":819},"sin-el-editor-completo","Sin el editor completo",[14,822,823,824,826],{},"En ",[243,825,608],{}," aún puedes:",[29,828,829,832,838],{},[32,830,831],{},"Elegir un tema de la lista",[32,833,834,835,751],{},"Editar variables CSS en vivo (",[243,836,837],{},"CSS personalizado",[32,839,840],{},"Importar un archivo de tema a la carpeta Themes",{"title":119,"searchDepth":120,"depth":120,"links":842},[843,844,845,846],{"id":734,"depth":120,"text":735},{"id":768,"depth":120,"text":769},{"id":786,"depth":120,"text":787},{"id":819,"depth":120,"text":820},"Diseña colores, fuentes, botones y pestañas en el Theme Creator.",{},5,"\u002Ftheme-editor",{"title":720,"description":847},"theme-editor","bPcJP7OLtBsnNMYJ-S1J6DmB6nngULo1_Q1hBJMNZAQ",{"id":855,"title":856,"body":857,"description":989,"extension":127,"meta":990,"navigation":129,"order":991,"path":992,"seo":993,"stem":994,"__hash__":995},"content_es\u002Frecording-editor.md","Editor de grabación",{"type":7,"value":858,"toc":983},[859,862,868,872,878,898,901,905,930,934,948,952,966,973],[10,860,856],{"id":861},"editor-de-grabación",[14,863,864,865,867],{},"Graba un clip dentro de SoundNinja, recórtalo e impórtalo a una pestaña. Abre el editor con el botón ",[243,866,496],{}," en la barra del reproductor.",[24,869,871],{"id":870},"elegir-una-entrada","Elegir una entrada",[14,873,823,874,877],{},[243,875,876],{},"Ajustes → Audio",":",[29,879,880,886,892],{},[32,881,882,885],{},[243,883,884],{},"Dispositivos de entrada"," — micrófono",[32,887,888,891],{},[243,889,890],{},"Dispositivos de salida (audio del PC)"," — loopback de lo que reproduce el PC",[32,893,894,897],{},[243,8