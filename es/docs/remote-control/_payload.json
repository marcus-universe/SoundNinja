[{"data":1,"prerenderedAt":1648},["ShallowReactive",2],{"docs-page-es-\u002Fremote-control":3,"docs-nav-es":244},{"id":4,"title":5,"body":6,"description":235,"extension":236,"meta":237,"navigation":238,"order":239,"path":240,"seo":241,"stem":242,"__hash__":243},"content_es\u002Fremote-control.md","Control remoto",{"type":7,"value":8,"toc":226},"minimark",[9,13,17,22,57,60,64,101,105,126,129,133,166,170,176],[10,11,5],"h1",{"id":12},"control-remoto",[14,15,16],"p",{},"SoundNinja puede escuchar en tu red local para que Bitfocus Companion (o cualquier cliente HTTP\u002FWebSocket) reproduzca y detenga sonidos.",[18,19,21],"h2",{"id":20},"activar-el-servidor-remoto","Activar el servidor remoto",[23,24,25,34,40,47],"ol",{},[26,27,28,29,33],"li",{},"Abre ",[30,31,32],"strong",{},"Ajustes → Remoto",".",[26,35,36,37,33],{},"Activa el servidor remoto. El puerto por defecto es ",[30,38,39],{},"7331",[26,41,42,43,33],{},"Opcional: define un token. Los clientes deben enviarlo como Bearer token o ",[44,45,46],"code",{},"?token=",[26,48,49,50,53,54,33],{},"Copia la URL ",[44,51,52],{},"http:\u002F\u002FIP:PORT",", o copia la IP del sistema desde ",[30,55,56],{},"Ajustes → Acerca de",[14,58,59],{},"Windows puede mostrar un aviso del firewall la primera vez que arranca el servidor. Permite el acceso a la red privada.",[18,61,63],{"id":62},"bitfocus-companion","Bitfocus Companion",[23,65,66,75,84,94],{},[26,67,68,69,33],{},"Instala ",[70,71,63],"a",{"href":72,"rel":73},"https:\u002F\u002Fbitfocus.io\u002Fcompanion",[74],"nofollow",[26,76,77,78,83],{},"Descarga ",[70,79,82],{"href":80,"rel":81},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Freleases\u002Flatest\u002Fdownload\u002FSoundNinja-Companion.tgz",[74],"SoundNinja-Companion.tgz",". Aún no hay paquete en Companion Store.",[26,85,86,87,90,91,33],{},"En Companion: ",[30,88,89],{},"Modules → Load module package"," y elige el ",[44,92,93],{},".tgz",[26,95,96,97,100],{},"Añade una conexión ",[30,98,99],{},"Sound Ninja",". Pega la IP del PC, el puerto y el token si definiste uno.",[18,102,104],{"id":103},"acciones","Acciones",[106,107,108,114,120],"ul",{},[26,109,110,113],{},[30,111,112],{},"Trigger Sound"," — elige en el menú desplegable en vivo, o escribe un ID de sonido de 8 caracteres (las variables de Companion funcionan)",[26,115,116,119],{},[30,117,118],{},"Stop Sound"," — detiene un sonido en reproducción por ID",[26,121,122,125],{},[30,123,124],{},"Stop All"," — detiene todos los sonidos en reproducción",[14,127,128],{},"Copia un ID de sonido en SoundNinja desde el menú contextual del botón o el chip de ID de la selección múltiple.",[18,130,132],{"id":131},"feedbacks-y-variables","Feedbacks y variables",[106,134,135,141,154,160],{},[26,136,137,140],{},[30,138,139],{},"Sound Playing"," — verdadero mientras ese ID de sonido está activo (úsalo para el color del botón)",[26,142,143,146,147,150,151],{},[44,144,145],{},"$(soundninja:connected)"," — ",[44,148,149],{},"true"," \u002F ",[44,152,153],{},"false",[26,155,156,159],{},[44,157,158],{},"$(soundninja:playing_count)"," — cuántos sonidos suenan",[26,161,162,165],{},[44,163,164],{},"$(soundninja:last_triggered)"," — último ID de sonido disparado",[18,167,169],{"id":168},"api-http-avanzado","API HTTP (avanzado)",[14,171,172,173],{},"Ruta base: ",[44,174,175],{},"\u002Fapi\u002Fv1",[106,177,178,184,190,196,206,212,220],{},[26,179,180,183],{},[44,181,182],{},"GET \u002Finfo"," — nombre de la app, versión, protocolo, si se requiere un token",[26,185,186,189],{},[44,187,188],{},"GET \u002Fsounds"," — lista de sonidos (id, name, tabs, active)",[26,191,192,195],{},[44,193,194],{},"GET \u002Fstate"," — sonidos más IDs que suenan ahora",[26,197,198,201,202,205],{},[44,199,200],{},"POST \u002Ftrigger"," con ",[44,203,204],{},"{ \"id\" }"," — reproducir un sonido",[26,207,208,211],{},[44,209,210],{},"GET \u002Ftrigger\u002F:id"," — reproducir (fácil de probar en el navegador)",[26,213,214,201,217,219],{},[44,215,216],{},"POST \u002Fstop",[44,218,204],{}," opcional — detener un sonido o todos",[26,221,222,225],{},[44,223,224],{},"GET \u002Fws"," — estado en vivo; enviar comandos trigger\u002Fstop de entrada",{"title":227,"searchDepth":228,"depth":228,"links":229},"",2,[230,231,232,233,234],{"id":20,"depth":228,"text":21},{"id":62,"depth":228,"text":63},{"id":103,"depth":228,"text":104},{"id":131,"depth":228,"text":132},{"id":168,"depth":228,"text":169},"Dispara SoundNinja desde Bitfocus Companion en la red local.","md",{},true,7,"\u002Fremote-control",{"title":5,"description":235},"remote-control","bTIIsplmKgFYFnJhA-Du-dpqsYQjLONQUNuBpkY2Usg",[245,372,574,721,1124,1258,1404,1550],{"id":246,"title":247,"body":248,"description":365,"extension":236,"meta":366,"navigation":238,"order":367,"path":368,"seo":369,"stem":370,"__hash__":371},"content_es\u002Foverview.md","Resumen",{"type":7,"value":249,"toc":359},[250,253,256,259,262,266,280,284,322,326,335,339],[10,251,247],{"id":252},"resumen",[14,254,255],{},"SoundNinja es un soundboard de código abierto para streaming en directo, charlas con amigos y grabación de podcasts. Está construido con Tauri v2 y Nuxt 4 para que sea ligero en RAM y disco.",[14,257,258],{},"El objetivo es simple: mantener una biblioteca enorme fácil de recorrer y reproducir el clip correcto en milisegundos. La interfaz también funciona bien como panel en VR.",[14,260,261],{},"SoundNinja sigue en desarrollo temprano. Las funciones marchan, pero no todas las plataformas están del todo probadas.",[18,263,265],{"id":264},"para-quién","Para quién",[106,267,268,271,274,277],{},[26,269,270],{},"Streamers que necesitan cues de sonido al instante",[26,272,273],{},"Amigos que quieren un tablero compartido para el chat de voz",[26,275,276],{},"Podcasters que graban clips y los sueltan en un tablero",[26,278,279],{},"Quien quiera un soundboard personalizable y local-first",[18,281,283],{"id":282},"qué-puedes-hacer","Qué puedes hacer",[106,285,286,289,292,295,298,301,304,307,310,316,319],{},[26,287,288],{},"Montar un soundboard con tus propios archivos de audio",[26,290,291],{},"Organizar sonidos en pestañas de colores, grupos, etiquetas y búsqueda",[26,293,294],{},"Filtrar por etiquetas (OR) y ordenar por nombre, fecha, duración o tamaño",[26,296,297],{},"Selección múltiple con marco o rango Mayús, luego color, mover o borrar en lote",[26,299,300],{},"Ajustar el volumen por sonido desde el menú contextual",[26,302,303],{},"Diseñar el aspecto con el Theme Creator",[26,305,306],{},"Grabar audio del PC o un micrófono en el Record Editor",[26,308,309],{},"Asignar atajos a sonidos individuales",[26,311,312,313],{},"Disparar sonidos desde ",[70,314,63],{"href":315},"\u002Fdocs\u002Fremote-control",[26,317,318],{},"Importar y exportar un soundboard completo para compartirlo",[26,320,321],{},"Usar GIFs o imágenes en los botones — biblioteca local de carpetas o KLIPY",[18,323,325],{"id":324},"licencia","Licencia",[14,327,328,329,334],{},"SoundNinja es software libre bajo ",[70,330,333],{"href":331,"rel":332},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fblob\u002Fmain\u002FLICENSE",[74],"GPL-3.0",". Haz fork, cámbialo, compártelo.",[18,336,338],{"id":337},"siguientes-pasos","Siguientes pasos",[23,340,341,347,353],{},[26,342,343],{},[70,344,346],{"href":345},"\u002Fdocs\u002Finstallation","Instalar SoundNinja",[26,348,349],{},[70,350,352],{"href":351},"\u002Fdocs\u002Fadding-sounds","Añadir sonidos",[26,354,355],{},[70,356,358],{"href":357},"\u002Fdocs\u002Forganizing-sounds","Organizar tu tablero",{"title":227,"searchDepth":228,"depth":228,"links":360},[361,362,363,364],{"id":264,"depth":228,"text":265},{"id":282,"depth":228,"text":283},{"id":324,"depth":228,"text":325},{"id":337,"depth":228,"text":338},"Qué es SoundNinja y qué puedes hacer con él.",{},1,"\u002Foverview",{"title":247,"description":365},"overview","XWpBFvtyid6BLXO3HByHppTxfsOo0i7DlSOMew5tq2g",{"id":373,"title":374,"body":375,"description":568,"extension":236,"meta":569,"navigation":238,"order":228,"path":570,"seo":571,"stem":572,"__hash__":573},"content_es\u002Finstallation.md","Instalación",{"type":7,"value":376,"toc":561},[377,380,394,398,419,422,426,440,443,447,471,482,486,493,497,512,542,557],[10,378,374],{"id":379},"instalación",[14,381,382,383,387,388,393],{},"Consigue una build en la ",[70,384,386],{"href":385},"\u002Fdownload","página de descarga"," o en ",[70,389,392],{"href":390,"rel":391},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Freleases\u002Flatest",[74],"GitHub Releases",". SoundNinja está en desarrollo temprano, así que trata las builds como beta.",[18,395,397],{"id":396},"windows","Windows",[106,399,400,410,413,416],{},[26,401,402,405,406,409],{},[30,403,404],{},"Instalador (.exe)"," o ",[30,407,408],{},"MSI (.msi)"," para Windows de 64 bits",[26,411,412],{},"Objetivo de la landing: Windows 10 y posterior",[26,414,415],{},"El README de la app también lista Windows 8 y superior",[26,417,418],{},"El instalador NSIS usa tema oscuro. Elige idioma en el setup — SoundNinja lo recuerda en el siguiente arranque.",[14,420,421],{},"Ejecuta el instalador y luego abre SoundNinja desde el menú Inicio.",[18,423,425],{"id":424},"macos","macOS",[106,427,428,434,437],{},[26,429,430,433],{},[30,431,432],{},".dmg universal"," para Apple Silicon e Intel",[26,435,436],{},"Objetivo de la landing: macOS 10.14 y posterior",[26,438,439],{},"El README de la app lista macOS 10.15 y superior",[14,441,442],{},"Abre la imagen de disco y arrastra SoundNinja a Aplicaciones.",[18,444,446],{"id":445},"linux","Linux",[106,448,449,455,461,468],{},[26,450,451,454],{},[30,452,453],{},"Debian (.deb)"," para Ubuntu \u002F Debian",[26,456,457,460],{},[30,458,459],{},"AppImage"," para otras distros",[26,462,463,464,467],{},"Tras publicar una release, los usuarios de Arch pueden instalar ",[44,465,466],{},"soundninja-bin"," desde el AUR",[26,469,470],{},"Probado en Ubuntu 20.04",[14,472,473,474,477,478,481],{},"Las builds de escritorio necesitan paquetes WebKit y GTK. En Debian\u002FUbuntu eso suele ser ",[44,475,476],{},"libwebkit2gtk",", ",[44,479,480],{},"libgtk-3-0"," y una biblioteca app-indicator.",[18,483,485],{"id":484},"actualizaciones","Actualizaciones",[14,487,488,489,492],{},"En la app, abre ",[30,490,491],{},"Ayuda → Buscar actualizaciones",". También puedes dejar que SoundNinja compruebe al arrancar en Ajustes.",[18,494,496],{"id":495},"compilar-desde-el-código","Compilar desde el código",[14,498,499,500,505,506,511],{},"¿Necesitas una build personalizada? Clona ",[70,501,504],{"href":502,"rel":503},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja",[74],"el repo",", instala los ",[70,507,510],{"href":508,"rel":509},"https:\u002F\u002Fv2.tauri.app\u002Fstart\u002Fprerequisites\u002F",[74],"requisitos de Tauri"," y luego:",[513,514,518],"pre",{"className":515,"code":516,"language":517,"meta":227,"style":227},"language-bash shiki shiki-themes github-light github-dark","bun install\nbun run tauri:serve\n","bash",[44,519,520,532],{"__ignoreMap":227},[521,522,524,528],"span",{"class":523,"line":367},"line",[521,525,527],{"class":526},"sScJk","bun",[521,529,531],{"class":530},"sZZnC"," install\n",[521,533,534,536,539],{"class":523,"line":228},[521,535,527],{"class":526},[521,537,538],{"class":530}," run",[521,540,541],{"class":530}," tauri:serve\n",[14,543,544,477,547,405,550,553,554,33],{},[44,545,546],{},"npm",[44,548,549],{},"pnpm",[44,551,552],{},"deno"," también sirven. Build de producción: ",[44,555,556],{},"bun run tauri:build",[558,559,560],"style",{},"html pre.shiki code .sScJk, html code.shiki .sScJk{--shiki-default:#6F42C1;--shiki-dark:#B392F0}html pre.shiki code .sZZnC, html code.shiki .sZZnC{--shiki-default:#032F62;--shiki-dark:#9ECBFF}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki