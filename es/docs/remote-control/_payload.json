[{"data":1,"prerenderedAt":1391},["ShallowReactive",2],{"docs-page-es-\u002Fremote-control":3,"docs-nav-es":247},{"id":4,"title":5,"body":6,"description":238,"extension":239,"meta":240,"navigation":241,"order":242,"path":243,"seo":244,"stem":245,"__hash__":246},"content_es\u002Fremote-control.md","Control remoto",{"type":7,"value":8,"toc":229},"minimark",[9,13,17,22,57,60,64,104,108,129,132,136,169,173,179],[10,11,5],"h1",{"id":12},"control-remoto",[14,15,16],"p",{},"SoundNinja puede escuchar en tu red local para que Bitfocus Companion (o cualquier cliente HTTP\u002FWebSocket) reproduzca y detenga sonidos.",[18,19,21],"h2",{"id":20},"activar-el-servidor-remoto","Activar el servidor remoto",[23,24,25,34,40,47],"ol",{},[26,27,28,29,33],"li",{},"Abre ",[30,31,32],"strong",{},"Ajustes → Remoto",".",[26,35,36,37,33],{},"Activa el servidor remoto. El puerto por defecto es ",[30,38,39],{},"7331",[26,41,42,43,33],{},"Opcional: define un token. Los clientes deben enviarlo como Bearer token o ",[44,45,46],"code",{},"?token=",[26,48,49,50,53,54,33],{},"Copia la URL ",[44,51,52],{},"http:\u002F\u002FIP:PORT",", o copia la IP del sistema desde ",[30,55,56],{},"Ajustes → Acerca de",[14,58,59],{},"Windows puede mostrar un aviso del firewall la primera vez que arranca el servidor. Permite el acceso a la red privada.",[18,61,63],{"id":62},"bitfocus-companion","Bitfocus Companion",[23,65,66,75,84,91,97],{},[26,67,68,69,33],{},"Instala ",[70,71,63],"a",{"href":72,"rel":73},"https:\u002F\u002Fbitfocus.io\u002Fcompanion",[74],"nofollow",[26,76,77,78,83],{},"Descarga el módulo SoundNinja desde la carpeta oficial: ",[70,79,82],{"href":80,"rel":81},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Ftree\u002Fmain\u002Fcompanion-module-soundninja",[74],"companion-module-soundninja",". Aún no hay paquete en Companion Store — esta carpeta es la descarga.",[26,85,86,87,90],{},"En Companion abre ",[30,88,89],{},"Developer → Modules",", o suelta la carpeta en la ruta de módulos personalizados de Companion.",[26,92,93,94,33],{},"En la carpeta del módulo ejecuta ",[44,95,96],{},"npm install",[26,98,99,100,103],{},"Añade una conexión ",[30,101,102],{},"Sound Ninja",". Pega la IP del PC, el puerto y el token si definiste uno.",[18,105,107],{"id":106},"acciones","Acciones",[109,110,111,117,123],"ul",{},[26,112,113,116],{},[30,114,115],{},"Trigger Sound"," — elige en el menú desplegable en vivo, o escribe un ID de sonido de 8 caracteres (las variables de Companion funcionan)",[26,118,119,122],{},[30,120,121],{},"Stop Sound"," — detiene un sonido en reproducción por ID",[26,124,125,128],{},[30,126,127],{},"Stop All"," — detiene todos los sonidos en reproducción",[14,130,131],{},"Copia un ID de sonido en SoundNinja desde el menú contextual del botón o el chip de ID de la selección múltiple.",[18,133,135],{"id":134},"feedbacks-y-variables","Feedbacks y variables",[109,137,138,144,157,163],{},[26,139,140,143],{},[30,141,142],{},"Sound Playing"," — verdadero mientras ese ID de sonido está activo (úsalo para el color del botón)",[26,145,146,149,150,153,154],{},[44,147,148],{},"$(soundninja:connected)"," — ",[44,151,152],{},"true"," \u002F ",[44,155,156],{},"false",[26,158,159,162],{},[44,160,161],{},"$(soundninja:playing_count)"," — cuántos sonidos suenan",[26,164,165,168],{},[44,166,167],{},"$(soundninja:last_triggered)"," — último ID de sonido disparado",[18,170,172],{"id":171},"api-http-avanzado","API HTTP (avanzado)",[14,174,175,176],{},"Ruta base: ",[44,177,178],{},"\u002Fapi\u002Fv1",[109,180,181,187,193,199,209,215,223],{},[26,182,183,186],{},[44,184,185],{},"GET \u002Finfo"," — nombre de la app, versión, protocolo, si se requiere un token",[26,188,189,192],{},[44,190,191],{},"GET \u002Fsounds"," — lista de sonidos (id, name, tabs, active)",[26,194,195,198],{},[44,196,197],{},"GET \u002Fstate"," — sonidos más IDs que suenan ahora",[26,200,201,204,205,208],{},[44,202,203],{},"POST \u002Ftrigger"," con ",[44,206,207],{},"{ \"id\" }"," — reproducir un sonido",[26,210,211,214],{},[44,212,213],{},"GET \u002Ftrigger\u002F:id"," — reproducir (fácil de probar en el navegador)",[26,216,217,204,220,222],{},[44,218,219],{},"POST \u002Fstop",[44,221,207],{}," opcional — detener un sonido o todos",[26,224,225,228],{},[44,226,227],{},"GET \u002Fws"," — estado en vivo; enviar comandos trigger\u002Fstop de entrada",{"title":230,"searchDepth":231,"depth":231,"links":232},"",2,[233,234,235,236,237],{"id":20,"depth":231,"text":21},{"id":62,"depth":231,"text":63},{"id":106,"depth":231,"text":107},{"id":134,"depth":231,"text":135},{"id":171,"depth":231,"text":172},"Dispara SoundNinja desde Bitfocus Companion en la red local.","md",{},true,7,"\u002Fremote-control",{"title":5,"description":238},"remote-control","80wDgQjcOFBZ-zEcEomn6KPqnTOOWEstkAVGy6tohhY",[248,366,565,712,868,1003,1145,1293],{"id":249,"title":250,"body":251,"description":359,"extension":239,"meta":360,"navigation":241,"order":361,"path":362,"seo":363,"stem":364,"__hash__":365},"content_es\u002Foverview.md","Resumen",{"type":7,"value":252,"toc":353},[253,256,259,262,265,269,283,287,316,320,329,333],[10,254,250],{"id":255},"resumen",[14,257,258],{},"SoundNinja es un soundboard de código abierto para streaming en directo, charlas con amigos y grabación de podcasts. Está construido con Tauri v2 y Nuxt 4 para que sea ligero en RAM y disco.",[14,260,261],{},"El objetivo es simple: mantener una biblioteca enorme fácil de recorrer y reproducir el clip correcto en milisegundos. La interfaz también funciona bien como panel en VR.",[14,263,264],{},"SoundNinja sigue en desarrollo temprano. Las funciones marchan, pero no todas las plataformas están del todo probadas.",[18,266,268],{"id":267},"para-quién","Para quién",[109,270,271,274,277,280],{},[26,272,273],{},"Streamers que necesitan cues de sonido al instante",[26,275,276],{},"Amigos que quieren un tablero compartido para el chat de voz",[26,278,279],{},"Podcasters que graban clips y los sueltan en un tablero",[26,281,282],{},"Quien quiera un soundboard personalizable y local-first",[18,284,286],{"id":285},"qué-puedes-hacer","Qué puedes hacer",[109,288,289,292,295,298,301,304,310,313],{},[26,290,291],{},"Montar un soundboard con tus propios archivos de audio",[26,293,294],{},"Organizar sonidos en pestañas de colores, grupos y búsqueda",[26,296,297],{},"Diseñar el aspecto con el Theme Creator",[26,299,300],{},"Grabar audio del PC o un micrófono en el Record Editor",[26,302,303],{},"Asignar atajos a sonidos individuales",[26,305,306,307],{},"Disparar sonidos desde ",[70,308,63],{"href":309},"\u002Fdocs\u002Fremote-control",[26,311,312],{},"Importar y exportar un soundboard completo para compartirlo",[26,314,315],{},"Usar GIFs o imágenes en los botones de sonido",[18,317,319],{"id":318},"licencia","Licencia",[14,321,322,323,328],{},"SoundNinja es software libre bajo ",[70,324,327],{"href":325,"rel":326},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fblob\u002Fmain\u002FLICENSE",[74],"GPL-3.0",". Haz fork, cámbialo, compártelo.",[18,330,332],{"id":331},"siguientes-pasos","Siguientes pasos",[23,334,335,341,347],{},[26,336,337],{},[70,338,340],{"href":339},"\u002Fdocs\u002Finstallation","Instalar SoundNinja",[26,342,343],{},[70,344,346],{"href":345},"\u002Fdocs\u002Fadding-sounds","Añadir sonidos",[26,348,349],{},[70,350,352],{"href":351},"\u002Fdocs\u002Forganizing-sounds","Organizar tu tablero",{"title":230,"searchDepth":231,"depth":231,"links":354},[355,356,357,358],{"id":267,"depth":231,"text":268},{"id":285,"depth":231,"text":286},{"id":318,"depth":231,"text":319},{"id":331,"depth":231,"text":332},"Qué es SoundNinja y qué puedes hacer con él.",{},1,"\u002Foverview",{"title":250,"description":359},"overview","_jbFAqK9Ea28XfzNs3a2S9mJrWOMez_Uxtm9qlYTevc",{"id":367,"title":368,"body":369,"description":559,"extension":239,"meta":560,"navigation":241,"order":231,"path":561,"seo":562,"stem":563,"__hash__":564},"content_es\u002Finstallation.md","Instalación",{"type":7,"value":370,"toc":552},[371,374,388,392,410,413,417,431,434,438,462,473,477,484,488,503,533,548],[10,372,368],{"id":373},"instalación",[14,375,376,377,381,382,387],{},"Consigue una build en la ",[70,378,380],{"href":379},"\u002Fdownload","página de descarga"," o en ",[70,383,386],{"href":384,"rel":385},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Freleases\u002Flatest",[74],"GitHub Releases",". SoundNinja está en desarrollo temprano, así que trata las builds como beta.",[18,389,391],{"id":390},"windows","Windows",[109,393,394,404,407],{},[26,395,396,399,400,403],{},[30,397,398],{},"Instalador (.exe)"," o ",[30,401,402],{},"MSI (.msi)"," para Windows de 64 bits",[26,405,406],{},"Objetivo de la landing: Windows 10 y posterior",[26,408,409],{},"El README de la app también lista Windows 8 y superior",[14,411,412],{},"Ejecuta el instalador y luego abre SoundNinja desde el menú Inicio.",[18,414,416],{"id":415},"macos","macOS",[109,418,419,425,428],{},[26,420,421,424],{},[30,422,423],{},".dmg universal"," para Apple Silicon e Intel",[26,426,427],{},"Objetivo de la landing: macOS 10.14 y posterior",[26,429,430],{},"El README de la app lista macOS 10.15 y superior",[14,432,433],{},"Abre la imagen de disco y arrastra SoundNinja a Aplicaciones.",[18,435,437],{"id":436},"linux","Linux",[109,439,440,446,452,459],{},[26,441,442,445],{},[30,443,444],{},"Debian (.deb)"," para Ubuntu \u002F Debian",[26,447,448,451],{},[30,449,450],{},"AppImage"," para otras distros",[26,453,454,455,458],{},"Tras publicar una release, los usuarios de Arch pueden instalar ",[44,456,457],{},"soundninja-bin"," desde el AUR",[26,460,461],{},"Probado en Ubuntu 20.04",[14,463,464,465,468,469,472],{},"Las builds de escritorio necesitan paquetes WebKit y GTK. En Debian\u002FUbuntu eso suele ser ",[44,466,467],{},"libwebkit2gtk",", ",[44,470,471],{},"libgtk-3-0"," y una biblioteca app-indicator.",[18,474,476],{"id":475},"actualizaciones","Actualizaciones",[14,478,479,480,483],{},"En la app, abre ",[30,481,482],{},"Ayuda → Buscar actualizaciones",". También puedes dejar que SoundNinja compruebe al arrancar en Ajustes.",[18,485,487],{"id":486},"compilar-desde-el-código","Compilar desde el código",[14,489,490,491,496,497,502],{},"¿Necesitas una build personalizada? Clona ",[70,492,495],{"href":493,"rel":494},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja",[74],"el repo",", instala los ",[70,498,501],{"href":499,"rel":500},"https:\u002F\u002Fv2.tauri.app\u002Fstart\u002Fprerequisites\u002F",[74],"requisitos de Tauri"," y luego:",[504,505,509],"pre",{"className":506,"code":507,"language":508,"meta":230,"style":230},"language-bash shiki shiki-themes github-light github-dark","bun install\nbun run tauri:serve\n","bash",[44,510,511,523],{"__ignoreMap":230},[512,513,515,519],"span",{"class":514,"line":361},"line",[512,516,518],{"class":517},"sScJk","bun",[512,520,522],{"class":521},"sZZnC"," install\n",[512,524,525,527,530],{"class":514,"line":231},[512,526,518],{"class":517},[512,528,529],{"class":521}," run",[512,531,532],{"class":521}," tauri:serve\n",[14,534,535,468,538,399,541,544,545,33],{},[44,536,537],{},"npm",[44,539,540],{},"pnpm",[44,542,543],{},"deno"," también sirven. Build de producción: ",[44,546,547],{},"bun run tauri:build",[549,550,551],"style",{},"html pre.shiki code .sScJk, html code.shiki .sScJk{--shiki-default:#6F42C1;--shiki-dark:#B392F0}html pre.shiki code .sZZnC, html code.shiki .sZZnC{--shiki-default:#032F62;--shiki-dark:#9ECBFF}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html.dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}",{"title":230,"searchDepth":231,"depth":231,"links":553},[554,555,556,557,558],{"id":390,"depth":231,"text":391},{"id":415,"depth":231,"text":416},{"id":436,"depth":231,"text":437},{"id":475,"depth":231,"text":476},{"id":486,"depth":231,"text":487},"Instala SoundNinja en Windows, macOS o Linux.",{},"\u002Finstallation",{"title":368,"description":559},"installation","DZ0nnkuNJ5bWc2nnZMQjtBcj72EEzzogekGEbJUmx80",{"id":566,"title":346,"body":567,"description":705,"extension":239,"meta":706,"navigation":241,"order":707,"path":708,"seo":709,"stem":710,"__hash__":711},"content_es\u002Fadding-sounds.md",{"type":7,"value":568,"toc":697},[569,572,575,579,597,601,632,636,655,659,673,676,680,687,691],[10,570,346],{"id":571},"añadir-sonidos",[14,573,574],{},"Un tablero está vacío hasta que añades clips. SoundNinja puede importar archivos, carpetas enteras, una grabación o un pack de soundboard compartido.",[18,576,578],{"id":577},"importar-archivos-de-audio","Importar archivos de audio",[23,580,581,591,594],{},[26,582,28,583,586,587,590],{},[30,584,585],{},"Archivo → Importar archivos de audio",", o usa ",[30,588,589],{},"Importar"," en la barra de navegación.",[26,592,593],{},"Elige uno o más archivos de audio.",[26,595,596],{},"Los sonidos llegan a la pestaña actual.",[18,598,600],{"id":599},"importar-carpetas","Importar carpetas",[23,602,603,612,615],{},[26,604,28,605,608,609,611],{},[30,606,607],{},"Archivo → Importar carpetas"," (o ",[30,610,600],{}," en la barra de navegación).",[26,613,614],{},"Añade una o más carpetas. Arrastra para reordenarlas antes de importar.",[26,616,617,618],{},"Elige cómo llegan:\n",[109,619,620,626],{},[26,621,622,625],{},[30,623,624],{},"Importar como pestañas"," — cada carpeta se convierte en su propia pestaña",[26,627,628,631],{},[30,629,630],{},"Importar a la pestaña actual"," — cada archivo va a la pestaña activa",[18,633,635],{"id":634},"grabar-un-clip","Grabar un clip",[14,637,638,639,643,644,647,648,399,651,654],{},"Abre el ",[70,640,642],{"href":641},"\u002Fdocs\u002Frecording-editor","Record Editor"," desde el botón ",[30,645,646],{},"Grabar"," en la barra del reproductor. Captura, recorta y luego ",[30,649,650],{},"Importar selección",[30,652,653],{},"Importar todo"," en la pestaña actual o en una pestaña que elijas.",[18,656,658],{"id":657},"importar-un-soundboard","Importar un soundboard",[14,660,661,664,665,668,669,672],{},[30,662,663],{},"Archivo → Importar soundboard"," carga un pack compartido. Los packs son un ",[44,666,667],{},".zip"," que contiene ",[44,670,671],{},"project.sninja"," más los archivos de sonido. Tras importar, abre el proyecto y reproduce.",[14,674,675],{},"También puedes tener varios proyectos (perfiles). Usa el selector de proyecto para cambiar de tablero.",[18,677,679],{"id":678},"reenlazar-archivos-faltantes","Reenlazar archivos faltantes",[14,681,682,683,686],{},"Si los archivos de audio se mueven en el disco, SoundNinja muestra ",[30,684,685],{},"Archivos de sonido faltantes",". Elige una carpeta para buscar y reenlazar los clips.",[18,688,690],{"id":689},"siguiente","Siguiente",[14,692,693,694,33],{},"Organiza pestañas, grupos y atajos en ",[70,695,696],{"href":351},"Organizar sonidos",{"title":230,"searchDepth":231,"depth":231,"links":698},[699,700,701,702,703,704],{"id":577,"depth":231,"text":578},{"id":599,"depth":231,"text":600},{"id":634,"depth":231,"text":635},{"id":657,"depth":231,"text":658},{"id":678,"depth":231,"text":679},{"id":689,"depth":231,"text":690},"Importa audio, carpetas, grabaciones y soundboards compartidos.",{},3,"\u002Fadding-sounds",{"title":346,"description":705},"adding-sounds","Pp2z7pkBymoeTp058Pu8gOujI6GqQLoQ-Go0ZA2L1F4",{"id":713,"title":696,"body":714,"description":861,"extension":239,"meta":862,"navigation":241,"order":863,"path":864,"seo":865,"stem":866,"__hash__":867},"content_es\u002Forganizing-sounds.md",{"type":7,"value":715,"toc":852},[716,719,722,726,753,760,764,767,781,788,792,799,803,814,818,821,825,828,834,840,844],[10,717,696],{"id":718},"organizar-sonidos",[14,720,721],{},"SoundNinja está hecho para bibliotecas grandes. Usa pestañas, grupos, búsqueda y atajos para que el clip que necesitas esté a un clic (o una tecla) de distancia.",[18,723,725],{"id":724},"pestañas","Pestañas",[109,727,728,735,742],{},[26,729,730,731,734],{},"Añade una pestaña con ",[30,732,733],{},"Añadir pestaña",". Dale un color para escanear la barra rápido.",[26,736,737,738,741],{},"La vista ",[30,739,740],{},"Todos"," muestra cada sonido de todas las pestañas.",[26,743,744,745,748,749,752],{},"Un sonido puede pertenecer a ",[30,746,747],{},"una o más pestañas",". Clic derecho en un sonido y usa ",[30,750,751],{},"Mover a pestaña"," para asignarlo.",[14,754,755,756,759],{},"Las transiciones de pestaña están en ",[30,757,758],{},"Ajustes → General",": Slide, Fade, Botones uno a uno, o Ninguna.",[18,761,763],{"id":762},"grupos","Grupos",[14,765,766],{},"Desde la v0.5.3, los separadores pueden convertirse en grupos con nombre:",[109,768,769,772,775,778],{},[26,770,771],{},"Añadir, renombrar o quitar un grupo desde el menú contextual",[26,773,774],{},"Arrastra la cabecera del grupo — los hijos se mueven con ella",[26,776,777],{},"Suelta sonidos dentro o fuera de un grupo",[26,779,780],{},"Define color de borde, color del nombre y alineación de botones (o usa el valor por defecto de la pestaña)",[14,782,783,784,787],{},"Sigue pudiendo añadir un ",[30,785,786],{},"Separador"," simple si solo necesitas un corte visual.",[18,789,791],{"id":790},"búsqueda","Búsqueda",[14,793,794,795,798],{},"Usa el campo ",[30,796,797],{},"Buscar"," en la barra de navegación. Los resultados se actualizan mientras escribes.",[18,800,802],{"id":801},"reordenar","Reordenar",[14,804,805,806,809,810,813],{},"Activa arrastrar y soltar en ",[30,807,808],{},"Ajustes → Comportamiento"," (",[30,811,812],{},"Permitir reordenar","). Luego arrastra sonidos y grupos a su sitio.",[18,815,817],{"id":816},"edición-masiva","Edición masiva",[14,819,820],{},"Selecciona varios sonidos y cambia el color, muévelos a una pestaña o elimínalos de una vez.",[18,822,824],{"id":823},"atajos-e-ids-de-sonido","Atajos e IDs de sonido",[14,826,827],{},"Cada sonido tiene un ID de 8 caracteres. Cópialo desde el menú contextual del botón o el chip de ID de la selección múltiple.",[14,829,28,830,833],{},[30,831,832],{},"Ajustes → Atajos"," para vincular una tecla a un ID de sonido. Los atajos globales son opcionales.",[14,835,836,837,839],{},"El mismo ID es el que ",[70,838,63],{"href":309}," usa para disparar un clip.",[18,841,843],{"id":842},"gifs-y-colores","GIFs y colores",[14,845,846,847,851],{},"Clic derecho en un sonido para definir colores por botón o un fondo GIF \u002F imagen. Eso es independiente del ",[70,848,850],{"href":849},"\u002Fdocs\u002Ftheme-editor","Theme Creator",", que da estilo a todo el tablero.",{"title":230,"searchDepth":231,"depth":231,"links":853},[854,855,856,857,858,859,860],{"id":724,"depth":231,"text":725},{"id":762,"depth":231,"text":763},{"id":790,"depth":231,"text":791},{"id":801,"depth":231,"text":802},{"id":816,"depth":231,"text":817},{"id":823,"depth":231,"text":824},{"id":842,"depth":231,"text":843},"Pestañas, grupos, búsqueda, edición masiva y atajos.",{},4,"\u002Forganizing-sounds",{"title":696,"description":861},"organizing-sounds","L2-ttc1gCTlJQIkJYckTzh-JzPPPTLU4m0uGjwPApXk",{"id":869,"title":870,"body":871,"description":996,"extension":239,"meta":997,"navigation":241,"order":998,"path":999,"seo":1000,"stem":1001,"__hash__":1002},"content_es\u002Ftheme-editor.md","Editor de temas",{"type":7,"value":872,"toc":990},[873,876,882,886,912,915,919,933,937,963,966,970,976],[10,874,870],{"id":875},"editor-de-temas",[14,877,878,879,33],{},"El Theme Creator es el editor visual completo de tu tablero. Ábrelo desde ",[30,880,881],{},"Ajustes → General → Theme Creator",[18,883,885],{"id":884},"tres-pestañas","Tres pestañas",[23,887,888,901,907],{},[26,889,890,893,894,153,897,900],{},[30,891,892],{},"General"," — nombre del tema, colores compartidos y carga de fuentes (",[44,895,896],{},".ttf",[44,898,899],{},".otf",")",[26,902,903,906],{},[30,904,905],{},"Botones"," — colores, tipo, diseño y overlay GIF de los botones de sonido",[26,908,909,911],{},[30,910,725],{}," — colores, tipo y grosor de borde de la barra de pestañas",[14,913,914],{},"Una vista previa en vivo muestra pestañas y botones mientras editas.",[18,916,918],{"id":917},"qué-puedes-cambiar","Qué puedes cambiar",[109,920,921,924,927,930],{},[26,922,923],{},"Colores primario y de acento, fondos, colores de botones, colores de pestañas",[26,925,926],{},"Familia y tamaño de fuente de botones y pestañas",[26,928,929],{},"Ancho, radio, borde, huecos y padding de los botones",[26,931,932],{},"Opacidad del overlay GIF (normal y hover)",[18,934,936],{"id":935},"guardar-y-compartir","Guardar y compartir",[109,938,939,945,951,957],{},[26,940,941,944],{},[30,942,943],{},"Exportar .css"," — escribe un archivo de tema para respaldar o enviar a un amigo",[26,946,947,950],{},[30,948,949],{},"Añadir a temas"," — guarda el archivo en tu carpeta Themes y aplícalo",[26,952,953,956],{},[30,954,955],{},"Importar .css"," — carga un preset integrado o un tema guardado",[26,958,959,962],{},[30,960,961],{},"Restablecer"," — vuelve a los valores por defecto de SoundNinja",[14,964,965],{},"Si cierras la ventana con cambios sin guardar, SoundNinja te pide que guardes primero.",[18,967,969],{"id":968},"sin-el-editor-completo","Sin el editor completo",[14,971,972,973,975],{},"En ",[30,974,758],{}," aún puedes:",[109,977,978,981,987],{},[26,979,980],{},"Elegir un tema de la lista",[26,982,983,984,900],{},"Editar variables CSS en vivo (",[30,985,986],{},"CSS personalizado",[26,988,989],{},"Importar un archivo de tema a la carpeta Themes",{"title":230,"searchDepth":231,"depth":231,"links":991},[992,993,994,995],{"id":884,"depth":231,"text":885},{"id":917,"depth":231,"text":918},{"id":935,"depth":231,"text":936},{"id":968,"depth":231,"text":969},"Diseña colores, fuentes, botones y pestañas en el Theme Creator.",{},5,"\u002Ftheme-editor",{"title":870,"description":996},"theme-editor","bPcJP7OLtBsnNMYJ-S1J6DmB6nngULo1_Q1hBJMNZAQ",{"id":1004,"title":1005,"body":1006,"description":1138,"extension":239,"meta":1139,"navigation":241,"order":1140,"path":1141,"seo":1142,"stem":1143,"__hash__":1144},"content_es\u002Frecording-editor.md","Editor de grabación",{"type":7,"value":1007,"toc":1132},[1008,1011,1017,1021,1027,1047,1050,1054,1079,1083,1097,1101,1115,1122],[10,1009,1005],{"id":1010},"editor-de-grabación",[14,1012,1013,1014,1016],{},"Graba un clip dentro de SoundNinja, recórtalo e impórtalo a una pestaña. Abre el editor con el botón ",[30,1015,646],{}," en la barra del reproductor.",[18,1018,1020],{"id":1019},"elegir-una-entrada","Elegir una entrada",[14,1022,972,1023,1026],{},[30,1024,1025],{},"Ajustes → Audio",":",[109,1028,1029,1035,1041],{},[26,1030,1031,1034],{},[30,1032,1033],{},"Dispositivos de entrada"," — micrófono",[26,1036,1037,1040],{},[30,1038,1039],{},"Dispositivos de salida (audio del PC)"," — loopback de lo que reproduce el PC",[26,1042,1043,1046],{},[30,1044,1045],{},"Volumen de entrada"," — ganancia de captura del 0 % al 200 %",[14,1048,1049],{},"El botón Grabar usa el dispositivo que eliges aquí.",[18,1051,1053],{"id":1052},"editar-la-toma","Editar la toma",[109,1055,1056,1059,1062,1070,1073,1076],{},[26,1057,1058],{},"Grabar y detener",[26,1060,1061],{},"Observar el medidor de nivel de entrada",[26,1063,1064,399,1067],{},[30,1065,1066],{},"Normalizar",[30,1068,1069],{},"Cancelación de ruido",[26,1071,1072],{},"Recortar todo el clip, recortar a una selección o borrar una selección",[26,1074,1075],{},"Deshacer \u002F rehacer",[26,1077,1078],{},"Acercar y alejar",[18,1080,1082],{"id":1081},"preparar-e-importar","Preparar e importar",[23,1084,1085,1088,1091],{},[26,1086,1087],{},"Añade la selección o la pista completa a la lista de staging.",[26,1089,1090],{},"La lista empieza vacía: graba, edita y luego añade un clip.",[26,1092,1093,399,1095,654],{},[30,1094,650],{},[30,1096,653],{},[18,1098,1100],{"id":1099},"separación-de-stems-opcional","Separación de stems (opcional)",[14,1102,1103,1104,399,1107,1110,1111,1114],{},"El Record Editor puede conservar ",[30,1105,1106],{},"voces",[30,1108,1109],{},"música"," con BS-RoFormer. El modelo pesa unos 158 MB y ",[30,1112,1113],{},"no"," viene incluido con la app.",[14,1116,1117,1118,1121],{},"Descárgalo desde ",[30,1119,1120],{},"Ajustes → Separación de stems",", o acepta el aviso del primer arranque. El instalador de Windows también puede ofrecer descargar el modelo al primer inicio.",[14,1123,1124,1125,153,1128,1131],{},"Las builds desde código con stems necesitan un flag extra (",[44,1126,1127],{},"tauri:serve:stems",[44,1129,1130],{},"tauri:build:stems",").",{"title":230,"searchDepth":231,"depth":231,"links":1133},[1134,1135,1136,1137],{"id":1019,"depth":231,"text":1020},{"id":1052,"depth":231,"text":1053},{"id":1081,"depth":231,"text":1082},{"id":1099,"depth":231,"text":1100},"Captura micrófono o audio del PC, edita el clip y suéltalo en tu tablero.",{},6,"\u002Frecording-editor",{"title":1005,"description":1138},"recording-editor","6kXc1zcNP9ffTeowsG3fPS8NGId-wyGEWWxVXslWkZE",{"id":4,"title":5,"body":1146,"description":238,"extension":239,"meta":1291,"navigation":241,"order":242,"path":243,"seo":1292,"stem":245,"__hash__":246},{"type":7,"value":1147,"toc":1284},[1148,1150,1152,1154,1174,1176,1178,1202,1204,1218,1220,1222,1244,1246,1250],[10,1149,5],{"id":12},[14,1151,16],{},[18,11