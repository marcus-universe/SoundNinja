ar-carpetas","Importar carpetas",[23,611,612,621,624],{},[26,613,28,614,617,618,620],{},[30,615,616],{},"Archivo → Importar carpetas"," (o ",[30,619,609],{}," en la barra de navegación).",[26,622,623],{},"Añade una o más carpetas. Arrastra para reordenarlas antes de importar.",[26,625,626,627],{},"Elige cómo llegan:\n",[106,628,629,635],{},[26,630,631,634],{},[30,632,633],{},"Importar como pestañas"," — cada carpeta se convierte en su propia pestaña",[26,636,637,640],{},[30,638,639],{},"Importar a la pestaña actual"," — cada archivo va a la pestaña activa",[18,642,644],{"id":643},"grabar-un-clip","Grabar un clip",[14,646,647,648,652,653,656,657,405,660,663],{},"Abre el ",[70,649,651],{"href":650},"\u002Fdocs\u002Frecording-editor","Record Editor"," desde el botón ",[30,654,655],{},"Grabar"," en la barra del reproductor. Captura, recorta y luego ",[30,658,659],{},"Importar selección",[30,661,662],{},"Importar todo"," en la pestaña actual o en una pestaña que elijas.",[18,665,667],{"id":666},"importar-un-soundboard","Importar un soundboard",[14,669,670,673,674,677,678,681],{},[30,671,672],{},"Archivo → Importar soundboard"," carga un pack compartido. Los packs son un ",[44,675,676],{},".zip"," que contiene ",[44,679,680],{},"project.sninja"," más los archivos de sonido. Tras importar, abre el proyecto y reproduce.",[14,683,684],{},"También puedes tener varios proyectos (perfiles). Usa el selector de proyecto para cambiar de tablero.",[18,686,688],{"id":687},"reenlazar-archivos-faltantes","Reenlazar archivos faltantes",[14,690,691,692,695],{},"Si los archivos de audio se mueven en el disco, SoundNinja muestra ",[30,693,694],{},"Archivos de sonido faltantes",". Elige una carpeta para buscar y reenlazar los clips.",[18,697,699],{"id":698},"siguiente","Siguiente",[14,701,702,703,33],{},"Organiza pestañas, etiquetas, filtros y atajos en ",[70,704,705],{"href":357},"Organizar sonidos",{"title":227,"searchDepth":228,"depth":228,"links":707},[708,709,710,711,712,713],{"id":586,"depth":228,"text":587},{"id":608,"depth":228,"text":609},{"id":643,"depth":228,"text":644},{"id":666,"depth":228,"text":667},{"id":687,"depth":228,"text":688},{"id":698,"depth":228,"text":699},"Importa audio, carpetas, grabaciones y soundboards compartidos.",{},3,"\u002Fadding-sounds",{"title":352,"description":714},"adding-sounds","O5nOJGNq2FL6jafUxqoGYNKJDVbb2UrZRjfKpK21LlQ",{"id":722,"title":705,"body":723,"description":1117,"extension":236,"meta":1118,"navigation":238,"order":1119,"path":1120,"seo":1121,"stem":1122,"__hash__":1123},"content_es\u002Forganizing-sounds.md",{"type":7,"value":724,"toc":1102},[725,728,735,739,766,773,777,780,794,801,807,811,821,826,858,862,868,872,905,911,915,918,944,947,951,964,968,974,995,1011,1018,1022,1033,1036,1040,1047,1057,1063,1067,1075,1082,1099],[10,726,705],{"id":727},"organizar-sonidos",[14,729,730,731,734],{},"SoundNinja está hecho para bibliotecas grandes. ",[30,732,733],{},"Etiquetas y filtros",", pestañas, búsqueda, selección múltiple y atajos — el clip que necesitas está a un clic (o una tecla).",[18,736,738],{"id":737},"pestañas","Pestañas",[106,740,741,748,755],{},[26,742,743,744,747],{},"Añade una pestaña con ",[30,745,746],{},"Añadir pestaña",". Dale un color para escanear la barra rápido.",[26,749,750,751,754],{},"La vista ",[30,752,753],{},"Todos"," muestra cada sonido de todas las pestañas.",[26,756,757,758,761,762,765],{},"Un sonido puede pertenecer a ",[30,759,760],{},"una o más pestañas",". Clic derecho en un sonido y usa ",[30,763,764],{},"Mover a pestaña"," para asignarlo.",[14,767,768,769,772],{},"Las transiciones de pestaña están en ",[30,770,771],{},"Ajustes → General",": Slide, Fade, Botones uno a uno, o Ninguna.",[18,774,776],{"id":775},"grupos","Grupos",[14,778,779],{},"Desde la v0.5.3, los separadores pueden convertirse en grupos con nombre:",[106,781,782,785,788,791],{},[26,783,784],{},"Añadir, renombrar o quitar un grupo desde el menú contextual",[26,786,787],{},"Arrastra la cabecera del grupo — los hijos se mueven con ella",[26,789,790],{},"Suelta sonidos dentro o fuera de un grupo",[26,792,793],{},"Define color de borde, color del nombre y alineación de botones (o usa el valor por defecto de la pestaña)",[14,795,796,797,800],{},"Sigue pudiendo añadir un ",[30,798,799],{},"Separador"," simple si solo necesitas un corte visual.",[14,802,803,804,33],{},"Clic derecho en el espacio vacío del tablero para ",[30,805,806],{},"Añadir grupo",[18,808,810],{"id":809},"etiquetas-filtros","Etiquetas \u002F Filtros",[14,812,813,814,817,818,820],{},"Las etiquetas cruzan las pestañas. El panel ",[30,815,816],{},"Filtro"," (barra lateral ",[30,819,816],{},") es donde las creas y filtras el tablero.",[822,823,825],"h3",{"id":824},"crear-y-editar-etiquetas","Crear y editar etiquetas",[23,827,828,833,844,851],{},[26,829,28,830,832],{},[30,831,816],{}," en la barra lateral.",[26,834,835,836,839,840,843],{},"En ",[30,837,838],{},"Etiquetas",", usa ",[30,841,842],{},"Añadir etiqueta"," — nombre y color.",[26,845,846,847,850],{},"Renombra, recolorea o ",[30,848,849],{},"Eliminar etiqueta"," en la misma lista.",[26,852,853,854,857],{},"Si ves ",[30,855,856],{},"Aún no hay etiquetas",", crea una aquí antes de asignar.",[822,859,861],{"id":860},"asignar-etiquetas-a-sonidos","Asignar etiquetas a sonidos",[14,863,864,865,867],{},"Clic derecho en un sonido → ",[30,866,838],{}," (casillas). Un sonido puede tener varias. Si aún no hay ninguna, el menú te lleva al panel de filtro.",[822,869,871],{"id":870},"filtrar-el-tablero","Filtrar el tablero",[106,873,874,880,891,902],{},[26,875,876,877,33],{},"Activa etiquetas en el panel Filtro o como ",[30,878,879],{},"chips bajo la barra de búsqueda",[26,881,882,883,886,887,890],{},"La coincidencia es ",[30,884,885],{},"OR",": un sonido sigue visible si tiene ",[30,888,889],{},"cualquiera"," de las etiquetas seleccionadas.",[26,892,893,894,897,898,901],{},"El campo ",[30,895,896],{},"Buscar"," combina con ",[30,899,900],{},"AND"," el filtro de etiquetas activo (texto + etiquetas juntos).",[26,903,904],{},"Apaga los chips (o limpia el filtro) para ver de nuevo toda la pestaña.",[14,906,907,908,33],{},"Los nombres de etiqueta en color pueden aparecer en los botones. Actívalos en ",[30,909,910],{},"Ajustes → Comportamiento → Mostrar badges de etiquetas",[18,912,914],{"id":913},"orden","Orden",[14,916,917],{},"Abre el panel de filtro y elige un modo:",[106,919,920,926],{},[26,921,922,925],{},[30,923,924],{},"Definido por el usuario"," — tu orden de pestaña, grupos visibles",[26,927,928,477,931,477,934,405,937,940,941],{},[30,929,930],{},"Nombre",[30,932,933],{},"Fecha de añadido",[30,935,936],{},"Tiempo de reproducción",[30,938,939],{},"Tamaño de archivo"," — lista plana ordenada; ",[30,942,943],{},"los grupos se ocultan",[14,945,946],{},"Ordenar por duración puede precargar los metadatos de duración la primera vez.",[18,948,950],{"id":949},"reordenar","Reordenar",[14,952,953,954,957,958,961,962,33],{},"Activa arrastrar y soltar en ",[30,955,956],{},"Ajustes → Comportamiento"," (",[30,959,960],{},"Permitir reordenar","). Luego arrastra sonidos y grupos a su sitio. Reordenar aplica en el orden ",[30,963,924],{},[18,965,967],{"id":966},"selección-múltiple","Selección múltiple",[14,969,970,971,973],{},"Activa ",[30,972,967],{}," en la barra de navegación, luego:",[106,975,976,979,985,992],{},[26,977,978],{},"Clic para alternar un sonido",[26,980,981,984],{},[30,982,983],{},"Mayús+clic"," para un rango desde el último ancla",[26,986,987,988,991],{},"Arrastra un ",[30,989,990],{},"marco"," en el espacio vacío del tablero",[26,993,994],{},"Clic en el tablero vacío (o fuera) para limpiar la selección",[14,996,997,998,477,1001,477,1004,1007,1008,33],{},"Una barra masiva muestra el recuento, más ",[30,999,1000],{},"Color",[30,1002,1003],{},"Mover a pestaña…",[30,1005,1006],{},"Eliminar"," y ",[30,1009,1010],{},"Hecho",[14,1012,1013,1014,1017],{},"En selección múltiple, cada botón muestra un ",[30,1015,1016],{},"chip de ID de 8 caracteres",". Clic derecho en el chip para copiarlo.",[18,1019,1021],{"id":1020},"volumen-por-sonido","Volumen por sonido",[14,1023,1024,1025,1028,1029,1032],{},"Clic derecho → ",[30,1026,1027],{},"Volumen",". Arrastra el control de 0 % a 100 %. ",[30,1030,1031],{},"Doble clic"," lo restablece a 100 %.",[14,1034,1035],{},"Se acumula con el volumen de salida maestro en Ajustes.",[18,1037,1039],{"id":1038},"atajos-e-ids-de-sonido","Atajos e IDs de sonido",[14,1041,1042,1043,1046],{},"Cada sonido tiene un ID de 8 caracteres. Cópialo desde el menú contextual del botón (",[30,1044,1045],{},"Copiar ID",") o el chip de ID de la selección múltiple.",[14,1048,28,1049,1052,1053,1056],{},[30,1050,1051],{},"Ajustes → Atajos"," para vincular una tecla a un ID de sonido. Los atajos globales son opcionales. ",[30,1054,1055],{},"Asignar atajo"," en el menú contextual salta allí con el ID rellenado.",[14,1058,1059,1060,1062],{},"El mismo ID es el que ",[70,1061,63],{"href":315}," usa para disparar un clip.",[18,1064,1066],{"id":1065},"imágenes-de-fondo-y-colores","Imágenes de fondo y colores",[14,1068,1069,1070,1074],{},"Clic derecho en un sonido para definir colores por botón o una imagen de fondo. Eso es independiente del ",[70,1071,1073],{"href":1072},"\u002Fdocs\u002Ftheme-editor","Theme Creator",", que da estilo a todo el tablero.",[14,1076,1077,1078,1081],{},"El selector es un diálogo ",[30,1079,1080],{},"Imagen de fondo"," (PNG, JPEG, GIF, WebP):",[106,1083,1084,1090],{},[26,1085,1086,1089],{},[30,1087,1088],{},"Archivos locales"," — añade carpetas, elige un archivo, busca por nombre, previsualiza la cuadrícula o quita una carpeta de la biblioteca",[26,1091,1092,1095,1096,1098],{},[30,1093,1094],{},"KLIPY"," — busca GIFs en línea. Pon tu propia clave API en ",[30,1097,956],{},". La clave no se guarda en los archivos del proyecto.",[14,1100,1101],{},"Tras elegir, mueve y recorta la imagen en el botón.",{"title":227,"searchDepth":228,"depth":228,"links":1103},[1104,1105,1106,1111,1112,1113,1114,1115,1116],{"id":737,"depth":228,"text":738},{"id":775,"depth":228,"text":776},{"id":809,"depth":228,"text":810,"children":1107},[1108,1109,1110],{"id":824,"depth":716,"text":825},{"id":860,"depth":716,"text":861},{"id":870,"depth":716,"text":871},{"id":913,"depth":228,"text":914},{"id":949,"depth":228,"text":950},{"id":966,"depth":228,"text":967},{"id":1020,"depth":228,"text":1021},{"id":1038,"depth":228,"text":1039},{"id":1065,"depth":228,"text":1066},"Etiquetas, filtros, pestañas, grupos, orden, selección múltiple, volumen y atajos.",{},4,"\u002Forganizing-sounds",{"title":705,"description":1117},"organizing-sounds","0TCdzxC5d9uOHlnFnD2ygCuD63pFk5yy3tK0Xgbpa7M",{"id":1125,"title":1126,"body":1127,"description":1251,"extension":236,"meta":1252,"navigation":238,"order":1253,"path":1254,"seo":1255,"stem":1256,"__hash__":1257},"content_es\u002Ftheme-editor.md","Editor de temas",{"type":7,"value":1128,"toc":1245},[1129,1132,1138,1142,1168,1171,1175,1189,1193,1219,1222,1226,1231],[10,1130,1126],{"id":1131},"editor-de-temas",[14,1133,1134,1135,33],{},"El Theme Creator es el editor visual completo de tu tablero. Ábrelo desde ",[30,1136,1137],{},"Ajustes → General → Theme Creator",[18,1139,1141],{"id":1140},"tres-pestañas","Tres pestañas",[23,1143,1144,1157,1163],{},[26,1145,1146,1149,1150,150,1153,1156],{},[30,1147,1148],{},"General"," — nombre del tema, colores compartidos y carga de fuentes (",[44,1151,1152],{},".ttf",[44,1154,1155],{},".otf",")",[26,1158,1159,1162],{},[30,1160,1161],{},"Botones"," — colores, tipo, diseño y overlay GIF de los botones de sonido",[26,1164,1165,1167],{},[30,1166,738],{}," — colores, tipo y grosor de borde de la barra de pestañas",[14,1169,1170],{},"Una vista previa en vivo muestra pestañas y botones mientras editas.",[18,1172,1174],{"id":1173},"qué-puedes-cambiar","Qué puedes cambiar",[106,1176,1177,1180,1183,1186],{},[26,1178,1179],{},"Colores primario y de acento, fondos, colores de botones, colores de pestañas",[26,1181,1182],{},"Familia y tamaño de fuente de botones y pestañas",[26,1184,1185],{},"Ancho, radio, borde, huecos y padding de los botones",[26,1187,1188],{},"Opacidad del overlay GIF (normal y hover)",[18,1190,1192],{"id":1191},"guardar-y-compartir","Guardar y compartir",[106,1194,1195,1201,1207,1213],{},[26,1196,1197,1200],{},[30,1198,1199],{},"Exportar .css"," — escribe un archivo de tema para respaldar o enviar a un amigo",[26,1202,1203,1206],{},[30,1204,1205],{},"Añadir a temas"," — guarda el archivo en tu carpeta Themes y aplícalo",[26,1208,1209,1212],{},[30,1210,1211],{},"Importar .css"," — carga un preset integrado o un tema guardado",[26,1214,1215,1218],{},[30,1216,1217],{},"Restablecer"," — vuelve a los valores por defecto de SoundNinja",[14,1220,1221],{},"Si cierras la ventana con cambios sin guardar, SoundNinja te pide que guardes primero.",[18,1223,1225],{"id":1224},"sin-el-editor-completo","Sin el editor completo",[14,1227,835,1228,1230],{},[30,1229,771],{}," aún puedes:",[106,1232,1233,1236,1242],{},[26,1234,1235],{},"Elegir un tema de la lista",[26,1237,1238,1239,1156],{},"Editar variables CSS en vivo (",[30,1240,1241],{},"CSS personalizado",[26,1243,1244],{},"Importar un archivo de tema a la carpeta Themes",{"title":227,"searchDepth":228,"depth":228,"links":1246},[1247,1248,1249,1250],{"id":1140,"depth":228,"text":1141},{"id":1173,"depth":228,"text":1174},{"id":1191,"depth":228,"text":1192},{"id":1224,"depth":228,"text":1225},"Diseña colores, fuentes, botones y pestañas en el Theme Creator.",{},5,"\u002Ftheme-editor",{"title":1126,"description":1251},"theme-editor","bPcJP7OLtBsnNMYJ-S1J6DmB6nngULo1_Q1hBJMNZAQ",{"id":1259,"title":1260,"body":1261,"description":1397,"extension":236,"meta":1398,"navigation":238,"order":1399,"path":1400,"seo":1401,"stem":1402,"__hash__":1403},"content_es\u002Frecording-editor.md","Editor de grabación",{"type":7,"value":1262,"toc":1391},[1263,1266,1272,1276,1282,1302,1305,1309,1334,1338,1352,1356,1370,1381],[10,1264,1260],{"id":1265},"editor-de-grabación",[14,1267,1268,1269,1271],{},"Graba un clip dentro de SoundNinja, recórtalo e impórtalo a una pestaña. Abre el editor con el botón ",[30,1270,655],{}," en la barra del reproductor.",[18,1273,1275],{"id":1274},"elegir-una-entrada","Elegir una entrada",[14,1277,835,1278,1281],{},[30,1279,1280],{},"Ajustes → Audio",":",[106,1283,1284,1290,1296],{},[26,1285,1286,1289],{},[30,1287,1288],{},"Dispositivos de entrada"," — micrófono",[26,1291,1292,1295],{},[30,1293,1294],{},"Dispositivos de salida (audio del PC)"," — loopback de lo que reproduce el PC",[26,1297,1298,1301],{},[30,1299,1300],{},"Volumen de entrada"," — ganancia de captura del 0 % al 200 %",[14,1303,1304],{},"El botón Grabar usa el dispositivo que eliges aquí.",[18,1306,1308],{"id":1307},"editar-la-toma","Editar la toma",[106,1310,1311,1314,1317,1325,1328,1331],{},[26,1312,1313],{},"Grabar y detener",[26,1315,1316],{},"Observar el medidor de nivel de entrada",[26,1318,1319,405,1322],{},[30,1320,1321],{},"Normalizar",[30,1323,1324],{},"Cancelación de ruido",[26,1326,1327],{},"Recortar todo el clip, recortar a una selección o borrar una selección",[26,1329,1330],{},"Deshacer \u002F rehacer",[26,1332,1333],{},"Acercar y alejar",[18,1335,1337],{"id":1336},"preparar-e-importar","Preparar e importar",[23,1339,1340,1343,1346],{},[26,1341,1342],{},"Añade la selección o la pista completa a la lista de staging.",[26,1344,1345],{},"La lista empieza vacía: graba, edita y luego añade un clip.",[26,1347,1348,405,1350,663],{},[30,1349,659],{},[30,1351,662],{},[18,1353,1355],{"id":1354},"separación-de-stems-opcional","Separación de stems (opcional)",[14,1357,1358,1359,1362,1363,405,1366,1369],{},"Las builds oficiales de Windows, macOS y Linux incluyen la función ",[30,1360,1361],{},"stems",". El Record Editor puede conservar ",[30,1364,1365],{},"voces",[30,1367,1368],{},"música"," con BS-RoFormer.",[14,1371,1372,1373,1376,1377,1380],{},"El modelo pesa unos 158 MB y ",[30,1374,1375],{},