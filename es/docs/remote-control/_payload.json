[{"data":1,"prerenderedAt":1386},["ShallowReactive",2],{"docs-page-es-\u002Fremote-control":3,"docs-nav-es":244},{"id":4,"title":5,"body":6,"description":235,"extension":236,"meta":237,"navigation":238,"order":239,"path":240,"seo":241,"stem":242,"__hash__":243},"content_es\u002Fremote-control.md","Control remoto",{"type":7,"value":8,"toc":226},"minimark",[9,13,17,22,57,60,64,101,105,126,129,133,166,170,176],[10,11,5],"h1",{"id":12},"control-remoto",[14,15,16],"p",{},"SoundNinja puede escuchar en tu red local para que Bitfocus Companion (o cualquier cliente HTTP\u002FWebSocket) reproduzca y detenga sonidos.",[18,19,21],"h2",{"id":20},"activar-el-servidor-remoto","Activar el servidor remoto",[23,24,25,34,40,47],"ol",{},[26,27,28,29,33],"li",{},"Abre ",[30,31,32],"strong",{},"Ajustes → Remoto",".",[26,35,36,37,33],{},"Activa el servidor remoto. El puerto por defecto es ",[30,38,39],{},"7331",[26,41,42,43,33],{},"Opcional: define un token. Los clientes deben enviarlo como Bearer token o ",[44,45,46],"code",{},"?token=",[26,48,49,50,53,54,33],{},"Copia la URL ",[44,51,52],{},"http:\u002F\u002FIP:PORT",", o copia la IP del sistema desde ",[30,55,56],{},"Ajustes → Acerca de",[14,58,59],{},"Windows puede mostrar un aviso del firewall la primera vez que arranca el servidor. Permite el acceso a la red privada.",[18,61,63],{"id":62},"bitfocus-companion","Bitfocus Companion",[23,65,66,75,84,94],{},[26,67,68,69,33],{},"Instala ",[70,71,63],"a",{"href":72,"rel":73},"https:\u002F\u002Fbitfocus.io\u002Fcompanion",[74],"nofollow",[26,76,77,78,83],{},"Descarga ",[70,79,82],{"href":80,"rel":81},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Freleases\u002Flatest\u002Fdownload\u002Fcompanion-module-soundninja.tgz",[74],"companion-module-soundninja.tgz",". Aún no hay paquete en Companion Store.",[26,85,86,87,90,91,33],{},"En Companion: ",[30,88,89],{},"Modules → Load module package"," y elige el ",[44,92,93],{},".tgz",[26,95,96,97,100],{},"Añade una conexión ",[30,98,99],{},"Sound Ninja",". Pega la IP del PC, el puerto y el token si definiste uno.",[18,102,104],{"id":103},"acciones","Acciones",[106,107,108,114,120],"ul",{},[26,109,110,113],{},[30,111,112],{},"Trigger Sound"," — elige en el menú desplegable en vivo, o escribe un ID de sonido de 8 caracteres (las variables de Companion funcionan)",[26,115,116,119],{},[30,117,118],{},"Stop Sound"," — detiene un sonido en reproducción por ID",[26,121,122,125],{},[30,123,124],{},"Stop All"," — detiene todos los sonidos en reproducción",[14,127,128],{},"Copia un ID de sonido en SoundNinja desde el menú contextual del botón o el chip de ID de la selección múltiple.",[18,130,132],{"id":131},"feedbacks-y-variables","Feedbacks y variables",[106,134,135,141,154,160],{},[26,136,137,140],{},[30,138,139],{},"Sound Playing"," — verdadero mientras ese ID de sonido está activo (úsalo para el color del botón)",[26,142,143,146,147,150,151],{},[44,144,145],{},"$(soundninja:connected)"," — ",[44,148,149],{},"true"," \u002F ",[44,152,153],{},"false",[26,155,156,159],{},[44,157,158],{},"$(soundninja:playing_count)"," — cuántos sonidos suenan",[26,161,162,165],{},[44,163,164],{},"$(soundninja:last_triggered)"," — último ID de sonido disparado",[18,167,169],{"id":168},"api-http-avanzado","API HTTP (avanzado)",[14,171,172,173],{},"Ruta base: ",[44,174,175],{},"\u002Fapi\u002Fv1",[106,177,178,184,190,196,206,212,220],{},[26,179,180,183],{},[44,181,182],{},"GET \u002Finfo"," — nombre de la app, versión, protocolo, si se requiere un token",[26,185,186,189],{},[44,187,188],{},"GET \u002Fsounds"," — lista de sonidos (id, name, tabs, active)",[26,191,192,195],{},[44,193,194],{},"GET \u002Fstate"," — sonidos más IDs que suenan ahora",[26,197,198,201,202,205],{},[44,199,200],{},"POST \u002Ftrigger"," con ",[44,203,204],{},"{ \"id\" }"," — reproducir un sonido",[26,207,208,211],{},[44,209,210],{},"GET \u002Ftrigger\u002F:id"," — reproducir (fácil de probar en el navegador)",[26,213,214,201,217,219],{},[44,215,216],{},"POST \u002Fstop",[44,218,204],{}," opcional — detener un sonido o todos",[26,221,222,225],{},[44,223,224],{},"GET \u002Fws"," — estado en vivo; enviar comandos trigger\u002Fstop de entrada",{"title":227,"searchDepth":228,"depth":228,"links":229},"",2,[230,231,232,233,234],{"id":20,"depth":228,"text":21},{"id":62,"depth":228,"text":63},{"id":103,"depth":228,"text":104},{"id":131,"depth":228,"text":132},{"id":168,"depth":228,"text":169},"Dispara SoundNinja desde Bitfocus Companion en la red local.","md",{},true,7,"\u002Fremote-control",{"title":5,"description":235},"remote-control","FXZNdlLVwqBTHCjLmpjNr2ZHY0S5NmW5TzHr5uUtI7U",[245,363,562,709,865,1000,1142,1288],{"id":246,"title":247,"body":248,"description":356,"extension":236,"meta":357,"navigation":238,"order":358,"path":359,"seo":360,"stem":361,"__hash__":362},"content_es\u002Foverview.md","Resumen",{"type":7,"value":249,"toc":350},[250,253,256,259,262,266,280,284,313,317,326,330],[10,251,247],{"id":252},"resumen",[14,254,255],{},"SoundNinja es un soundboard de código abierto para streaming en directo, charlas con amigos y grabación de podcasts. Está construido con Tauri v2 y Nuxt 4 para que sea ligero en RAM y disco.",[14,257,258],{},"El objetivo es simple: mantener una biblioteca enorme fácil de recorrer y reproducir el clip correcto en milisegundos. La interfaz también funciona bien como panel en VR.",[14,260,261],{},"SoundNinja sigue en desarrollo temprano. Las funciones marchan, pero no todas las plataformas están del todo probadas.",[18,263,265],{"id":264},"para-quién","Para quién",[106,267,268,271,274,277],{},[26,269,270],{},"Streamers que necesitan cues de sonido al instante",[26,272,273],{},"Amigos que quieren un tablero compartido para el chat de voz",[26,275,276],{},"Podcasters que graban clips y los sueltan en un tablero",[26,278,279],{},"Quien quiera un soundboard personalizable y local-first",[18,281,283],{"id":282},"qué-puedes-hacer","Qué puedes hacer",[106,285,286,289,292,295,298,301,307,310],{},[26,287,288],{},"Montar un soundboard con tus propios archivos de audio",[26,290,291],{},"Organizar sonidos en pestañas de colores, grupos y búsqueda",[26,293,294],{},"Diseñar el aspecto con el Theme Creator",[26,296,297],{},"Grabar audio del PC o un micrófono en el Record Editor",[26,299,300],{},"Asignar atajos a sonidos individuales",[26,302,303,304],{},"Disparar sonidos desde ",[70,305,63],{"href":306},"\u002Fdocs\u002Fremote-control",[26,308,309],{},"Importar y exportar un soundboard completo para compartirlo",[26,311,312],{},"Usar GIFs o imágenes en los botones de sonido",[18,314,316],{"id":315},"licencia","Licencia",[14,318,319,320,325],{},"SoundNinja es software libre bajo ",[70,321,324],{"href":322,"rel":323},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fblob\u002Fmain\u002FLICENSE",[74],"GPL-3.0",". Haz fork, cámbialo, compártelo.",[18,327,329],{"id":328},"siguientes-pasos","Siguientes pasos",[23,331,332,338,344],{},[26,333,334],{},[70,335,337],{"href":336},"\u002Fdocs\u002Finstallation","Instalar SoundNinja",[26,339,340],{},[70,341,343],{"href":342},"\u002Fdocs\u002Fadding-sounds","Añadir sonidos",[26,345,346],{},[70,347,349],{"href":348},"\u002Fdocs\u002Forganizing-sounds","Organizar tu tablero",{"title":227,"searchDepth":228,"depth":228,"links":351},[352,353,354,355],{"id":264,"depth":228,"text":265},{"id":282,"depth":228,"text":283},{"id":315,"depth":228,"text":316},{"id":328,"depth":228,"text":329},"Qué es SoundNinja y qué puedes hacer con él.",{},1,"\u002Foverview",{"title":247,"description":356},"overview","_jbFAqK9Ea28XfzNs3a2S9mJrWOMez_Uxtm9qlYTevc",{"id":364,"title":365,"body":366,"description":556,"extension":236,"meta":557,"navigation":238,"order":228,"path":558,"seo":559,"stem":560,"__hash__":561},"content_es\u002Finstallation.md","Instalación",{"type":7,"value":367,"toc":549},[368,371,385,389,407,410,414,428,431,435,459,470,474,481,485,500,530,545],[10,369,365],{"id":370},"instalación",[14,372,373,374,378,379,384],{},"Consigue una build en la ",[70,375,377],{"href":376},"\u002Fdownload","página de descarga"," o en ",[70,380,383],{"href":381,"rel":382},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Freleases\u002Flatest",[74],"GitHub Releases",". SoundNinja está en desarrollo temprano, así que trata las builds como beta.",[18,386,388],{"id":387},"windows","Windows",[106,390,391,401,404],{},[26,392,393,396,397,400],{},[30,394,395],{},"Instalador (.exe)"," o ",[30,398,399],{},"MSI (.msi)"," para Windows de 64 bits",[26,402,403],{},"Objetivo de la landing: Windows 10 y posterior",[26,405,406],{},"El README de la app también lista Windows 8 y superior",[14,408,409],{},"Ejecuta el instalador y luego abre SoundNinja desde el menú Inicio.",[18,411,413],{"id":412},"macos","macOS",[106,415,416,422,425],{},[26,417,418,421],{},[30,419,420],{},".dmg universal"," para Apple Silicon e Intel",[26,423,424],{},"Objetivo de la landing: macOS 10.14 y posterior",[26,426,427],{},"El README de la app lista macOS 10.15 y superior",[14,429,430],{},"Abre la imagen de disco y arrastra SoundNinja a Aplicaciones.",[18,432,434],{"id":433},"linux","Linux",[106,436,437,443,449,456],{},[26,438,439,442],{},[30,440,441],{},"Debian (.deb)"," para Ubuntu \u002F Debian",[26,444,445,448],{},[30,446,447],{},"AppImage"," para otras distros",[26,450,451,452,455],{},"Tras publicar una release, los usuarios de Arch pueden instalar ",[44,453,454],{},"soundninja-bin"," desde el AUR",[26,457,458],{},"Probado en Ubuntu 20.04",[14,460,461,462,465,466,469],{},"Las builds de escritorio necesitan paquetes WebKit y GTK. En Debian\u002FUbuntu eso suele ser ",[44,463,464],{},"libwebkit2gtk",", ",[44,467,468],{},"libgtk-3-0"," y una biblioteca app-indicator.",[18,471,473],{"id":472},"actualizaciones","Actualizaciones",[14,475,476,477,480],{},"En la app, abre ",[30,478,479],{},"Ayuda → Buscar actualizaciones",". También puedes dejar que SoundNinja compruebe al arrancar en Ajustes.",[18,482,484],{"id":483},"compilar-desde-el-código","Compilar desde el código",[14,486,487,488,493,494,499],{},"¿Necesitas una build personalizada? Clona ",[70,489,492],{"href":490,"rel":491},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja",[74],"el repo",", instala los ",[70,495,498],{"href":496,"rel":497},"https:\u002F\u002Fv2.tauri.app\u002Fstart\u002Fprerequisites\u002F",[74],"requisitos de Tauri"," y luego:",[501,502,506],"pre",{"className":503,"code":504,"language":505,"meta":227,"style":227},"language-bash shiki shiki-themes github-light github-dark","bun install\nbun run tauri:serve\n","bash",[44,507,508,520],{"__ignoreMap":227},[509,510,512,516],"span",{"class":511,"line":358},"line",[509,513,515],{"class":514},"sScJk","bun",[509,517,519],{"class":518},"sZZnC"," install\n",[509,521,522,524,527],{"class":511,"line":228},[509,523,515],{"class":514},[509,525,526],{"class":518}," run",[509,528,529],{"class":518}," tauri:serve\n",[14,531,532,465,535,396,538,541,542,33],{},[44,533,534],{},"npm",[44,536,537],{},"pnpm",[44,539,540],{},"deno"," también sirven. Build de producción: ",[44,543,544],{},"bun run tauri:build",[546,547,548],"style",{},"html pre.shiki code .sScJk, html code.shiki .sScJk{--shiki-default:#6F42C1;--shiki-dark:#B392F0}html pre.shiki code .sZZnC, html code.shiki .sZZnC{--shiki-default:#032F62;--shiki-dark:#9ECBFF}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html.dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}",{"title":227,"searchDepth":228,"depth":228,"links":550},[551,552,553,554,555],{"id":387,"depth":228,"text":388},{"id":412,"depth":228,"text":413},{"id":433,"depth":228,"text":434},{"id":472,"depth":228,"text":473},{"id":483,"depth":228,"text":484},"Instala SoundNinja en Windows, macOS o Linux.",{},"\u002Finstallation",{"title":365,"description":556},"installation","DZ0nnkuNJ5bWc2nnZMQjtBcj72EEzzogekGEbJUmx80",{"id":563,"title":343,"body":564,"description":702,"extension":236,"meta":703,"navigation":238,"order":704,"path":705,"seo":706,"stem":707,"__hash__":708},"content_es\u002Fadding-sounds.md",{"type":7,"value":565,"toc":694},[566,569,572,576,594,598,629,633,652,656,670,673,677,684,688],[10,567,343],{"id":568},"añadir-sonidos",[14,570,571],{},"Un tablero está vacío hasta que añades clips. SoundNinja puede importar archivos, carpetas enteras, una grabación o un pack de soundboard compartido.",[18,573,575],{"id":574},"importar-archivos-de-audio","Importar archivos de audio",[23,577,578,588,591],{},[26,579,28,580,583,584,587],{},[30,581,582],{},"Archivo → Importar archivos de audio",", o usa ",[30,585,586],{},"Importar"," en la barra de navegación.",[26,589,590],{},"Elige uno o más archivos de audio.",[26,592,593],{},"Los sonidos llegan a la pestaña actual.",[18,595,597],{"id":596},"importar-carpetas","Importar carpetas",[23,599,600,609,612],{},[26,601,28,602,605,606,608],{},[30,603,604],{},"Archivo → Importar carpetas"," (o ",[30,607,597],{}," en la barra de navegación).",[26,610,611],{},"Añade una o más carpetas. Arrastra para reordenarlas antes de importar.",[26,613,614,615],{},"Elige cómo llegan:\n",[106,616,617,623],{},[26,618,619,622],{},[30,620,621],{},"Importar como pestañas"," — cada carpeta se convierte en su propia pestaña",[26,624,625,628],{},[30,626,627],{},"Importar a la pestaña actual"," — cada archivo va a la pestaña activa",[18,630,632],{"id":631},"grabar-un-clip","Grabar un clip",[14,634,635,636,640,641,644,645,396,648,651],{},"Abre el ",[70,637,639],{"href":638},"\u002Fdocs\u002Frecording-editor","Record Editor"," desde el botón ",[30,642,643],{},"Grabar"," en la barra del reproductor. Captura, recorta y luego ",[30,646,647],{},"Importar selección",[30,649,650],{},"Importar todo"," en la pestaña actual o en una pestaña que elijas.",[18,653,655],{"id":654},"importar-un-soundboard","Importar un soundboard",[14,657,658,661,662,665,666,669],{},[30,659,660],{},"Archivo → Importar soundboard"," carga un pack compartido. Los packs son un ",[44,663,664],{},".zip"," que contiene ",[44,667,668],{},"project.sninja"," más los archivos de sonido. Tras importar, abre el proyecto y reproduce.",[14,671,672],{},"También puedes tener varios proyectos (perfiles). Usa el selector de proyecto para cambiar de tablero.",[18,674,676],{"id":675},"reenlazar-archivos-faltantes","Reenlazar archivos faltantes",[14,678,679,680,683],{},"Si los archivos de audio se mueven en el disco, SoundNinja muestra ",[30,681,682],{},"Archivos de sonido faltantes",". Elige una carpeta para buscar y reenlazar los clips.",[18,685,687],{"id":686},"siguiente","Siguiente",[14,689,690,691,33],{},"Organiza pestañas, grupos y atajos en ",[70,692,693],{"href":348},"Organizar sonidos",{"title":227,"searchDepth":228,"depth":228,"links":695},[696,697,698,699,700,701],{"id":574,"depth":228,"text":575},{"id":596,"depth":228,"text":597},{"id":631,"depth":228,"text":632},{"id":654,"depth":228,"text":655},{"id":675,"depth":228,"text":676},{"id":686,"depth":228,"text":687},"Importa audio, carpetas, grabaciones y soundboards compartidos.",{},3,"\u002Fadding-sounds",{"title":343,"description":702},"adding-sounds","Pp2z7pkBymoeTp058Pu8gOujI6GqQLoQ-Go0ZA2L1F4",{"id":710,"title":693,"body":711,"description":858,"extension":236,"meta":859,"navigation":238,"order":860,"path":861,"seo":862,"stem":863,"__hash__":864},"content_es\u002Forganizing-sounds.md",{"type":7,"value":712,"toc":849},[713,716,719,723,750,757,761,764,778,785,789,796,800,811,815,818,822,825,831,837,841],[10,714,693],{"id":715},"organizar-sonidos",[14,717,718],{},"SoundNinja está hecho para bibliotecas grandes. Usa pestañas, grupos, búsqueda y atajos para que el clip que necesitas esté a un clic (o una tecla) de distancia.",[18,720,722],{"id":721},"pestañas","Pestañas",[106,724,725,732,739],{},[26,726,727,728,731],{},"Añade una pestaña con ",[30,729,730],{},"Añadir pestaña",". Dale un color para escanear la barra rápido.",[26,733,734,735,738],{},"La vista ",[30,736,737],{},"Todos"," muestra cada sonido de todas las pestañas.",[26,740,741,742,745,746,749],{},"Un sonido puede pertenecer a ",[30,743,744],{},"una o más pestañas",". Clic derecho en un sonido y usa ",[30,747,748],{},"Mover a pestaña"," para asignarlo.",[14,751,752,753,756],{},"Las transiciones de pestaña están en ",[30,754,755],{},"Ajustes → General",": Slide, Fade, Botones uno a uno, o Ninguna.",[18,758,760],{"id":759},"grupos","Grupos",[14,762,763],{},"Desde la v0.5.3, los separadores pueden convertirse en grupos con nombre:",[106,765,766,769,772,775],{},[26,767,768],{},"Añadir, renombrar o quitar un grupo desde el menú contextual",[26,770,771],{},"Arrastra la cabecera del grupo — los hijos se mueven con ella",[26,773,774],{},"Suelta sonidos dentro o fuera de un grupo",[26,776,777],{},"Define color de borde, color del nombre y alineación de botones (o usa el valor por defecto de la pestaña)",[14,779,780,781,784],{},"Sigue pudiendo añadir un ",[30,782,783],{},"Separador"," simple si solo necesitas un corte visual.",[18,786,788],{"id":787},"búsqueda","Búsqueda",[14,790,791,792,795],{},"Usa el campo ",[30,793,794],{},"Buscar"," en la barra de navegación. Los resultados se actualizan mientras escribes.",[18,797,799],{"id":798},"reordenar","Reordenar",[14,801,802,803,806,807,810],{},"Activa arrastrar y soltar en ",[30,804,805],{},"Ajustes → Comportamiento"," (",[30,808,809],{},"Permitir reordenar","). Luego arrastra sonidos y grupos a su sitio.",[18,812,814],{"id":813},"edición-masiva","Edición masiva",[14,816,817],{},"Selecciona varios sonidos y cambia el color, muévelos a una pestaña o elimínalos de una vez.",[18,819,821],{"id":820},"atajos-e-ids-de-sonido","Atajos e IDs de sonido",[14,823,824],{},"Cada sonido tiene un ID de 8 caracteres. Cópialo desde el menú contextual del botón o el chip de ID de la selección múltiple.",[14,826,28,827,830],{},[30,828,829],{},"Ajustes → Atajos"," para vincular una tecla a un ID de sonido. Los atajos globales son opcionales.",[14,832,833,834,836],{},"El mismo ID es el que ",[70,835,63],{"href":306}," usa para disparar un clip.",[18,838,840],{"id":839},"gifs-y-colores","GIFs y colores",[14,842,843,844,848],{},"Clic derecho en un sonido para definir colores por botón o un fondo GIF \u002F imagen. Eso es independiente del ",[70,845,847],{"href":846},"\u002Fdocs\u002Ftheme-editor","Theme Creator",", que da estilo a todo el tablero.",{"title":227,"searchDepth":228,"depth":228,"links":850},[851,852,853,854,855,856,857],{"id":721,"depth":228,"text":722},{"id":759,"depth":228,"text":760},{"id":787,"depth":228,"text":788},{"id":798,"depth":228,"text":799},{"id":813,"depth":228,"text":814},{"id":820,"depth":228,"text":821},{"id":839,"depth":228,"text":840},"Pestañas, grupos, búsqueda, edición masiva y atajos.",{},4,"\u002Forganizing-sounds",{"title":693,"description":858},"organizing-sounds","L2-ttc1gCTlJQIkJYckTzh-JzPPPTLU4m0uGjwPApXk",{"id":866,"title":867,"body":868,"description":993,"extension":236,"meta":994,"navigation":238,"order":995,"path":996,"seo":997,"stem":998,"__hash__":999},"content_es\u002Ftheme-editor.md","Editor de temas",{"type":7,"value":869,"toc":987},[870,873,879,883,909,912,916,930,934,960,963,967,973],[10,871,867],{"id":872},"editor-de-temas",[14,874,875,876,33],{},"El Theme Creator es el editor visual completo de tu tablero. Ábrelo desde ",[30,877,878],{},"Ajustes → General → Theme Creator",[18,880,882],{"id":881},"tres-pestañas","Tres pestañas",[23,884,885,898,904],{},[26,886,887,890,891,150,894,897],{},[30,888,889],{},"General"," — nombre del tema, colores compartidos y carga de fuentes (",[44,892,893],{},".ttf",[44,895,896],{},".otf",")",[26,899,900,903],{},[30,901,902],{},"Botones"," — colores, tipo, diseño y overlay GIF de los botones de sonido",[26,905,906,908],{},[30,907,722],{}," — colores, tipo y grosor de borde de la barra de pestañas",[14,910,911],{},"Una vista previa en vivo muestra pestañas y botones mientras editas.",[18,913,915],{"id":914},"qué-puedes-cambiar","Qué puedes cambiar",[106,917,918,921,924,927],{},[26,919,920],{},"Colores primario y de acento, fondos, colores de botones, colores de pestañas",[26,922,923],{},"Familia y tamaño de fuente de botones y pestañas",[26,925,926],{},"Ancho, radio, borde, huecos y padding de los botones",[26,928,929],{},"Opacidad del overlay GIF (normal y hover)",[18,931,933],{"id":932},"guardar-y-compartir","Guardar y compartir",[106,935,936,942,948,954],{},[26,937,938,941],{},[30,939,940],{},"Exportar .css"," — escribe un archivo de tema para respaldar o enviar a un amigo",[26,943,944,947],{},[30,945,946],{},"Añadir a temas"," — guarda el archivo en tu carpeta Themes y aplícalo",[26,949,950,953],{},[30,951,952],{},"Importar .css"," — carga un preset integrado o un tema guardado",[26,955,956,959],{},[30,957,958],{},"Restablecer"," — vuelve a los valores por defecto de SoundNinja",[14,961,962],{},"Si cierras la ventana con cambios sin guardar, SoundNinja te pide que guardes primero.",[18,964,966],{"id":965},"sin-el-editor-completo","Sin el editor completo",[14,968,969,970,972],{},"En ",[30,971,755],{}," aún puedes:",[106,974,975,978,984],{},[26,976,977],{},"Elegir un tema de la lista",[26,979,980,981,897],{},"Editar variables CSS en vivo (",[30,982,983],{},"CSS personalizado",[26,985,986],{},"Importar un archivo de tema a la carpeta Themes",{"title":227,"searchDepth":228,"depth":228,"links":988},[989,990,991,992],{"id":881,"depth":228,"text":882},{"id":914,"depth":228,"text":915},{"id":932,"depth":228,"text":933},{"id":965,"depth":228,"text":966},"Diseña colores, fuentes, botones y pestañas en el Theme Creator.",{},5,"\u002Ftheme-editor",{"title":867,"description":993},"theme-editor","bPcJP7OLtBsnNMYJ-S1J6DmB6nngULo1_Q1hBJMNZAQ",{"id":1001,"title":1002,"body":1003,"description":1135,"extension":236,"meta":1136,"navigation":238,"order":1137,"path":1138,"seo":1139,"stem":1140,"__hash__":1141},"content_es\u002Frecording-editor.md","Editor de grabación",{"type":7,"value":1004,"toc":1129},[1005,1008,1014,1018,1024,1044,1047,1051,1076,1080,1094,1098,1112,1119],[10,1006,1002],{"id":1007},"editor-de-grabación",[14,1009,1010,1011,1013],{},"Graba un clip dentro de SoundNinja, recórtalo e impórtalo a una pestaña. Abre el editor con el botón ",[30,1012,643],{}," en la barra del reproductor.",[18,1015,1017],{"id":1016},"elegir-una-entrada","Elegir una entrada",[14,1019,969,1020,1023],{},[30,1021,1022],{},"Ajustes → Audio",":",[106,1025,1026,1032,1038],{},[26,1027,1028,1031],{},[30,1029,1030],{},"Dispositivos de entrada"," — micrófono",[26,1033,1034,1037],{},[30,1035,1036],{},"Dispositivos de salida (audio del PC)"," — loopback de lo que reproduce el PC",[26,1039,1040,1043],{},[30,1041,1042],{},"Volumen de entrada"," — ganancia de captura del 0 % al 200 %",[14,1045,1046],{},"El botón Grabar usa el dispositivo que eliges aquí.",[18,1048,1050],{"id":1049},"editar-la-toma","Editar la toma",[106,1052,1053,1056,1059,1067,1070,1073],{},[26,1054,1055],{},"Grabar y detener",[26,1057,1058],{},"Observar el medidor de nivel de entrada",[26,1060,1061,396,1064],{},[30,1062,1063],{},"Normalizar",[30,1065,1066],{},"Cancelación de ruido",[26,1068,1069],{},"Recortar todo el clip, recortar a una selección o borrar una selección",[26,1071,1072],{},"Deshacer \u002F rehacer",[26,1074,1075],{},"Acercar y alejar",[18,1077,1079],{"id":1078},"preparar-e-importar","Preparar e importar",[23,1081,1082,1085,1088],{},[26,1083,1084],{},"Añade la selección o la pista completa a la lista de staging.",[26,1086,1087],{},"La lista empieza vacía: graba, edita y luego añade un clip.",[26,1089,1090,396,1092,651],{},[30,1091,647],{},[30,1093,650],{},[18,1095,1097],{"id":1096},"separación-de-stems-opcional","Separación de stems (opcional)",[14,1099,1100,1101,396,1104,1107,1108,1111],{},"El Record Editor puede conservar ",[30,1102,1103],{},"voces",[30,1105,1106],{},"música"," con BS-RoFormer. El modelo pesa unos 158 MB y ",[30,1109,1110],{},"no"," viene incluido con la app.",[14,1113,1114,1115,1118],{},"Descárgalo desde ",[30,1116,1117],{},"Ajustes → Separación de stems",", o acepta el aviso del primer arranque. El instalador de Windows también puede ofrecer descargar el modelo al primer inicio.",[14,1120,1121,1122,150,1125,1128],{},"Las builds desde código con stems necesitan un flag extra (",[44,1123,1124],{},"tauri:serve:stems",[44,1126,1127],{},"tauri:build:stems",").",{"title":227,"searchDepth":228,"depth":228,"links":1130},[1131,1132,1133,1134],{"id":1016,"depth":228,"text":1017},{"id":1049,"depth":228,"text":1050},{"id":1078,"depth":228,"text":1079},{"id":1096,"depth":228,"text":1097},"Captura micrófono o audio del PC, edita el clip y suéltalo en tu tablero.",{},6,"\u002Frecording-editor",{"title":1002,"description":1135},"recording-editor","6kXc1zcNP9ffTeowsG3fPS8NGId-wyGEWWxVXslWkZE",{"id":4,"title":5,"body":1143,"description":235,"extension":236,"meta":1286,"navigation":238,"order":239,"path":240,"seo":1287,"stem":242,"__hash__":243},{"type":7,"value":1144,"toc":1279},[1145,1147,1149,1151,1171,1173,1175,1197,1199,1213,1215,1217,1239,1241,1245],[10,1146,5],{"id":12},[14,1148,16],{},[18,1150,21],{"id":20},[23,1152,1153,1157,1161,1165],{},[26,1154,28,1155,33],{},[30,1156,32],{},[26,1158,36,1159,33],{},[30,1160,39],{},[26,1162,42,1163,33],{},[44,1164,46],{}