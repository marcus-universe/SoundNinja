[{"data":1,"prerenderedAt":1679},["ShallowReactive",2],{"docs-page-es-\u002Fremote-control":3,"docs-nav-es":244},{"id":4,"title":5,"body":6,"description":235,"extension":236,"meta":237,"navigation":238,"order":239,"path":240,"seo":241,"stem":242,"__hash__":243},"content_es\u002Fremote-control.md","Control remoto",{"type":7,"value":8,"toc":226},"minimark",[9,13,17,22,57,60,64,101,105,126,129,133,166,170,176],[10,11,5],"h1",{"id":12},"control-remoto",[14,15,16],"p",{},"SoundNinja puede escuchar en tu red local para que Bitfocus Companion (o cualquier cliente HTTP\u002FWebSocket) reproduzca y detenga sonidos.",[18,19,21],"h2",{"id":20},"activar-el-servidor-remoto","Activar el servidor remoto",[23,24,25,34,40,47],"ol",{},[26,27,28,29,33],"li",{},"Abre ",[30,31,32],"strong",{},"Ajustes → Remoto",".",[26,35,36,37,33],{},"Activa el servidor remoto. El puerto por defecto es ",[30,38,39],{},"7331",[26,41,42,43,33],{},"Opcional: define un token. Los clientes deben enviarlo como Bearer token o ",[44,45,46],"code",{},"?token=",[26,48,49,50,53,54,33],{},"Copia la URL ",[44,51,52],{},"http:\u002F\u002FIP:PORT",", o copia la IP del sistema desde ",[30,55,56],{},"Ajustes → Acerca de",[14,58,59],{},"Windows puede mostrar un aviso del firewall la primera vez que arranca el servidor. Permite el acceso a la red privada.",[18,61,63],{"id":62},"bitfocus-companion","Bitfocus Companion",[23,65,66,75,84,94],{},[26,67,68,69,33],{},"Instala ",[70,71,63],"a",{"href":72,"rel":73},"https:\u002F\u002Fbitfocus.io\u002Fcompanion",[74],"nofollow",[26,76,77,78,83],{},"Descarga ",[70,79,82],{"href":80,"rel":81},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002Fcompanion-module-soundninja\u002Freleases\u002Flatest",[74],"SoundNinja-Companion.tgz",". Aún no hay paquete en Companion Store.",[26,85,86,87,90,91,33],{},"En Companion: ",[30,88,89],{},"Modules → Load module package"," y elige el ",[44,92,93],{},".tgz",[26,95,96,97,100],{},"Añade una conexión ",[30,98,99],{},"Sound Ninja",". Pega la IP del PC, el puerto y el token si definiste uno.",[18,102,104],{"id":103},"acciones","Acciones",[106,107,108,114,120],"ul",{},[26,109,110,113],{},[30,111,112],{},"Trigger Sound"," — elige en el menú desplegable en vivo, o escribe un ID de sonido de 8 caracteres (las variables de Companion funcionan)",[26,115,116,119],{},[30,117,118],{},"Stop Sound"," — detiene un sonido en reproducción por ID",[26,121,122,125],{},[30,123,124],{},"Stop All"," — detiene todos los sonidos en reproducción",[14,127,128],{},"Copia un ID de sonido en SoundNinja desde el menú contextual del botón o el chip de ID de la selección múltiple.",[18,130,132],{"id":131},"feedbacks-y-variables","Feedbacks y variables",[106,134,135,141,154,160],{},[26,136,137,140],{},[30,138,139],{},"Sound Playing"," — verdadero mientras ese ID de sonido está activo (úsalo para el color del botón)",[26,142,143,146,147,150,151],{},[44,144,145],{},"$(soundninja:connected)"," — ",[44,148,149],{},"true"," \u002F ",[44,152,153],{},"false",[26,155,156,159],{},[44,157,158],{},"$(soundninja:playing_count)"," — cuántos sonidos suenan",[26,161,162,165],{},[44,163,164],{},"$(soundninja:last_triggered)"," — último ID de sonido disparado",[18,167,169],{"id":168},"api-http-avanzado","API HTTP (avanzado)",[14,171,172,173],{},"Ruta base: ",[44,174,175],{},"\u002Fapi\u002Fv1",[106,177,178,184,190,196,206,212,220],{},[26,179,180,183],{},[44,181,182],{},"GET \u002Finfo"," — nombre de la app, versión, protocolo, si se requiere un token",[26,185,186,189],{},[44,187,188],{},"GET \u002Fsounds"," — lista de sonidos (id, name, tabs, active)",[26,191,192,195],{},[44,193,194],{},"GET \u002Fstate"," — sonidos más IDs que suenan ahora",[26,197,198,201,202,205],{},[44,199,200],{},"POST \u002Ftrigger"," con ",[44,203,204],{},"{ \"id\" }"," — reproducir un sonido",[26,207,208,211],{},[44,209,210],{},"GET \u002Ftrigger\u002F:id"," — reproducir (fácil de probar en el navegador)",[26,213,214,201,217,219],{},[44,215,216],{},"POST \u002Fstop",[44,218,204],{}," opcional — detener un sonido o todos",[26,221,222,225],{},[44,223,224],{},"GET \u002Fws"," — estado en vivo; enviar comandos trigger\u002Fstop de entrada",{"title":227,"searchDepth":228,"depth":228,"links":229},"",2,[230,231,232,233,234],{"id":20,"depth":228,"text":21},{"id":62,"depth":228,"text":63},{"id":103,"depth":228,"text":104},{"id":131,"depth":228,"text":132},{"id":168,"depth":228,"text":169},"Dispara SoundNinja desde Bitfocus Companion en la red local.","md",{},true,7,"\u002Fremote-control",{"title":5,"description":235},"remote-control","ph5vfcZDpw1R_Zj_L4KkovRHKYPdInfF4l4V_nT9tT4",[245,372,595,742,1155,1289,1435,1581],{"id":246,"title":247,"body":248,"description":365,"extension":236,"meta":366,"navigation":238,"order":367,"path":368,"seo":369,"stem":370,"__hash__":371},"content_es\u002Foverview.md","Resumen",{"type":7,"value":249,"toc":359},[250,253,256,259,262,266,280,284,322,326,335,339],[10,251,247],{"id":252},"resumen",[14,254,255],{},"SoundNinja es un soundboard de código abierto para streaming en directo, charlas con amigos y grabación de podcasts. Está construido con Tauri v2 y Nuxt 4 para que sea ligero en RAM y disco.",[14,257,258],{},"El objetivo es simple: mantener una biblioteca enorme fácil de recorrer y reproducir el clip correcto en milisegundos. La interfaz también funciona bien como panel en VR.",[14,260,261],{},"SoundNinja sigue en desarrollo temprano. Las funciones marchan, pero no todas las plataformas están del todo probadas.",[18,263,265],{"id":264},"para-quién","Para quién",[106,267,268,271,274,277],{},[26,269,270],{},"Streamers que necesitan cues de sonido al instante",[26,272,273],{},"Amigos que quieren un tablero compartido para el chat de voz",[26,275,276],{},"Podcasters que graban clips y los sueltan en un tablero",[26,278,279],{},"Quien quiera un soundboard personalizable y local-first",[18,281,283],{"id":282},"qué-puedes-hacer","Qué puedes hacer",[106,285,286,289,292,295,298,301,304,307,310,316,319],{},[26,287,288],{},"Montar un soundboard con tus propios archivos de audio",[26,290,291],{},"Organizar sonidos en pestañas de colores, grupos, etiquetas y búsqueda",[26,293,294],{},"Filtrar por etiquetas (OR) y ordenar por nombre, fecha, duración o tamaño",[26,296,297],{},"Selección múltiple con marco o rango Mayús, luego color, mover o borrar en lote",[26,299,300],{},"Ajustar el volumen por sonido desde el menú contextual",[26,302,303],{},"Diseñar el aspecto con el Theme Creator",[26,305,306],{},"Grabar audio del PC o un micrófono en el Record Editor",[26,308,309],{},"Asignar atajos a sonidos individuales",[26,311,312,313],{},"Disparar sonidos desde ",[70,314,63],{"href":315},"\u002Fdocs\u002Fremote-control",[26,317,318],{},"Importar y exportar un soundboard completo para compartirlo",[26,320,321],{},"Usar GIFs o imágenes en los botones — biblioteca local de carpetas, GifSnap o KLIPY",[18,323,325],{"id":324},"licencia","Licencia",[14,327,328,329,334],{},"SoundNinja es software libre bajo ",[70,330,333],{"href":331,"rel":332},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fblob\u002Fmain\u002FLICENSE",[74],"GPL-3.0",". Haz fork, cámbialo, compártelo.",[18,336,338],{"id":337},"siguientes-pasos","Siguientes pasos",[23,340,341,347,353],{},[26,342,343],{},[70,344,346],{"href":345},"\u002Fdocs\u002Finstallation","Instalar SoundNinja",[26,348,349],{},[70,350,352],{"href":351},"\u002Fdocs\u002Fadding-sounds","Añadir sonidos",[26,354,355],{},[70,356,358],{"href":357},"\u002Fdocs\u002Forganizing-sounds","Organizar tu tablero",{"title":227,"searchDepth":228,"depth":228,"links":360},[361,362,363,364],{"id":264,"depth":228,"text":265},{"id":282,"depth":228,"text":283},{"id":324,"depth":228,"text":325},{"id":337,"depth":228,"text":338},"Qué es SoundNinja y qué puedes hacer con él.",{},1,"\u002Foverview",{"title":247,"description":365},"overview","aVQIpArgBh8Yx660xBvwTxx-97ukf5Chr1A7jNPd3UE",{"id":373,"title":374,"body":375,"description":589,"extension":236,"meta":590,"navigation":238,"order":228,"path":591,"seo":592,"stem":593,"__hash__":594},"content_es\u002Finstallation.md","Instalación",{"type":7,"value":376,"toc":582},[377,380,394,398,419,422,426,440,443,447,471,482,486,493,497,512,542,557,578],[10,378,374],{"id":379},"instalación",[14,381,382,383,387,388,393],{},"Consigue una build en la ",[70,384,386],{"href":385},"\u002Fdownload","página de descarga"," o en ",[70,389,392],{"href":390,"rel":391},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Freleases\u002Flatest",[74],"GitHub Releases",". SoundNinja está en desarrollo temprano, así que trata las builds como beta.",[18,395,397],{"id":396},"windows","Windows",[106,399,400,410,413,416],{},[26,401,402,405,406,409],{},[30,403,404],{},"Instalador (.exe)"," o ",[30,407,408],{},"MSI (.msi)"," para Windows de 64 bits",[26,411,412],{},"Objetivo de la landing: Windows 10 y posterior",[26,414,415],{},"El README de la app también lista Windows 8 y superior",[26,417,418],{},"El instalador NSIS usa tema oscuro. Elige idioma en el setup — SoundNinja lo recuerda en el siguiente arranque.",[14,420,421],{},"Ejecuta el instalador y luego abre SoundNinja desde el menú Inicio.",[18,423,425],{"id":424},"macos","macOS",[106,427,428,434,437],{},[26,429,430,433],{},[30,431,432],{},".dmg universal"," para Apple Silicon e Intel",[26,435,436],{},"Objetivo de la landing: macOS 10.14 y posterior",[26,438,439],{},"El README de la app lista macOS 10.15 y superior",[14,441,442],{},"Abre la imagen de disco y arrastra SoundNinja a Aplicaciones.",[18,444,446],{"id":445},"linux","Linux",[106,448,449,455,461,468],{},[26,450,451,454],{},[30,452,453],{},"Debian (.deb)"," para Ubuntu \u002F Debian",[26,456,457,460],{},[30,458,459],{},"AppImage"," para otras distros",[26,462,463,464,467],{},"Tras publicar una release, los usuarios de Arch pueden instalar ",[44,465,466],{},"soundninja-bin"," desde el AUR",[26,469,470],{},"Probado en Ubuntu 20.04",[14,472,473,474,477,478,481],{},"Las builds de escritorio necesitan paquetes WebKit y GTK. En Debian\u002FUbuntu eso suele ser ",[44,475,476],{},"libwebkit2gtk",", ",[44,479,480],{},"libgtk-3-0"," y una biblioteca app-indicator.",[18,483,485],{"id":484},"actualizaciones","Actualizaciones",[14,487,488,489,492],{},"En la app, abre ",[30,490,491],{},"Ayuda → Buscar actualizaciones",". También puedes dejar que SoundNinja compruebe al arrancar en Ajustes.",[18,494,496],{"id":495},"compilar-desde-el-código","Compilar desde el código",[14,498,499,500,505,506,511],{},"¿Necesitas una build personalizada? Clona ",[70,501,504],{"href":502,"rel":503},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja",[74],"el repo",", instala los ",[70,507,510],{"href":508,"rel":509},"https:\u002F\u002Fv2.tauri.app\u002Fstart\u002Fprerequisites\u002F",[74],"requisitos de Tauri"," y luego:",[513,514,518],"pre",{"className":515,"code":516,"language":517,"meta":227,"style":227},"language-bash shiki shiki-themes github-light github-dark","bun install\nbun run tauri:serve\n","bash",[44,519,520,532],{"__ignoreMap":227},[521,522,524,528],"span",{"class":523,"line":367},"line",[521,525,527],{"class":526},"sScJk","bun",[521,529,531],{"class":530},"sZZnC"," install\n",[521,533,534,536,539],{"class":523,"line":228},[521,535,527],{"class":526},[521,537,538],{"class":530}," run",[521,540,541],{"class":530}," tauri:serve\n",[14,543,544,477,547,405,550,553,554,33],{},[44,545,546],{},"npm",[44,548,549],{},"pnpm",[44,551,552],{},"deno"," también sirven. Build de producción: ",[44,555,556],{},"bun run tauri:build",[14,558,559,562,563,568,569,572,573,33],{},[30,560,561],{},"Solo Windows:"," cada compile de Windows incluye ASIO con el ",[70,564,567],{"href":565,"rel":566},"https:\u002F\u002Fwww.steinberg.net\u002Fasiosdk",[74],"Steinberg ASIO SDK",". Ejecuta ",[44,570,571],{},"bun run setup:asio"," una vez (el SDK no está en git). Linux y macOS usan PipeWire \u002F Core Audio — omite ese paso. Detalles: ",[70,574,577],{"href":575,"rel":576},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fblob\u002Fmain\u002Fdocs\u002Fbuild-from-source.md",[74],"build-from-source.md",[579,580,581],"style",{},"html pre.shiki code .sScJk, html code.shiki .sScJk{--shiki-default:#6F42C1;--shiki-dark:#B392F0}html pre.shiki code .sZZnC, html code.shiki .sZZnC{--shiki-default:#032F62;--shiki-dark:#9ECBFF}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html.dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}",{"title":227,"searchDepth":228,"depth":228,"links":583},[584,585,586,587,588],{"id":396,"depth":228,"text":397},{"id":424,"depth":228,"text":425},{"id":445,"depth":228,"text":446},{"id":484,"depth":228,"text":485},{"id":495,"depth":228,"text":496},"Instala SoundNinja en Windows, macOS o Linux.",{},"\u002Finstallation",{"title":374,"description":589},"installation","6QKa3OcTs0sq8JVvjceX-ugwL8mdPc4h6O-JOoo1Qd8",{"id":596,"title":352,"body":597,"description":735,"extension":236,"meta":736,"navigation":238,"order":737,"path":738,"seo":739,"stem":740,"__hash__":741},"content_es\u002Fadding-sounds.md",{"type":7,"value":598,"toc":727},[599,602,605,609,627,631,662,666,685,689,703,706,710,717,721],[10,600,352],{"id":601},"añadir-sonidos",[14,603,604],{},"Un tablero está vacío hasta que añades clips. SoundNinja puede importar archivos, carpetas enteras, una grabación o un pack de soundboard compartido.",[18,606,608],{"id":607},"importar-archivos-de-audio","Importar archivos de audio",[23,610,611,621,624],{},[26,612,28,613,616,617,620],{},[30,614,615],{},"Archivo → Importar archivos de audio",", o usa ",[30,618,619],{},"Importar"," en la barra de navegación.",[26,622,623],{},"Elige uno o más archivos de audio.",[26,625,626],{},"Los sonidos llegan a la pestaña actual.",[18,628,630],{"id":629},"importar-carpetas","Importar carpetas",[23,632,633,642,645],{},[26,634,28,635,638,639,641],{},[30,636,637],{},"Archivo → Importar carpetas"," (o ",[30,640,630],{}," en la barra de navegación).",[26,643,644],{},"Añade una o más carpetas. Arrastra para reordenarlas antes de importar.",[26,646,647,648],{},"Elige cómo llegan:\n",[106,649,650,656],{},[26,651,652,655],{},[30,653,654],{},"Importar como pestañas"," — cada carpeta se convierte en su propia pestaña",[26,657,658,661],{},[30,659,660],{},"Importar a la pestaña actual"," — cada archivo va a la pestaña activa",[18,663,665],{"id":664},"grabar-un-clip","Grabar un clip",[14,667,668,669,673,674,677,678,405,681,684],{},"Abre el ",[70,670,672],{"href":671},"\u002Fdocs\u002Frecording-editor","Record Editor"," desde el botón ",[30,675,676],{},"Grabar"," en la barra del reproductor. Captura, recorta y luego ",[30,679,680],{},"Importar selección",[30,682,683],{},"Importar todo"," en la pestaña actual o en una pestaña que elijas.",[18,686,688],{"id":687},"importar-un-soundboard","Importar un soundboard",[14,690,691,694,695,698,699,702],{},[30,692,693],{},"Archivo → Importar soundboard"," carga un pack compartido. Los packs son un ",[44,696,697],{},".zip"," que contiene ",[44,700,701],{},"project.sninja"," más los archivos de sonido. Tras importar, abre el proyecto y reproduce.",[14,704,705],{},"También puedes tener varios proyectos (perfiles). Usa el selector de proyecto para cambiar de tablero.",[18,707,709],{"id":708},"reenlazar-archivos-faltantes","Reenlazar archivos faltantes",[14,711,712,713,716],{},"Si los archivos de audio se mueven en el disco, SoundNinja muestra ",[30,714,715],{},"Archivos de sonido faltantes",". Elige una carpeta para buscar y reenlazar los clips.",[18,718,720],{"id":719},"siguiente","Siguiente",[14,722,723,724,33],{},"Organiza pestañas, etiquetas, filtros y atajos en ",[70,725,726],{"href":357},"Organizar sonidos",{"title":227,"searchDepth":228,"depth":228,"links":728},[729,730,731,732,733,734],{"id":607,"depth":228,"text":608},{"id":629,"depth":228,"text":630},{"id":664,"depth":228,"text":665},{"id":687,"depth":228,"text":688},{"id":708,"depth":228,"text":709},{"id":719,"depth":228,"text":720},"Importa audio, carpetas, grabaciones y soundboards compartidos.",{},3,"\u002Fadding-sounds",{"title":352,"description":735},"adding-sounds","O5nOJGNq2FL6jafUxqoGYNKJDVbb2UrZRjfKpK21LlQ",{"id":743,"title":726,"body":744,"description":1148,"extension":236,"meta":1149,"navigation":238,"order":1150,"path":1151,"seo":1152,"stem":1153,"__hash__":1154},"content_es\u002Forganizing-sounds.md",{"type":7,"value":745,"toc":1133},[746,749,756,760,787,794,798,801,815,822,828,832,842,847,879,883,889,893,926,932,936,939,965,968,972,985,989,995,1016,1032,1039,1043,1054,1057,1061,1068,1078,1084,1088,1096,1103,1130],[10,747,726],{"id":748},"organizar-sonidos",[14,750,751,752,755],{},"SoundNinja está hecho para bibliotecas grandes. ",[30,753,754],{},"Etiquetas y filtros",", pestañas, búsqueda, selección múltiple y atajos — el clip que necesitas está a un clic (o una tecla).",[18,757,759],{"id":758},"pestañas","Pestañas",[106,761,762,769,776],{},[26,763,764,765,768],{},"Añade una pestaña con ",[30,766,767],{},"Añadir pestaña",". Dale un color para escanear la barra rápido.",[26,770,771,772,775],{},"La vista ",[30,773,774],{},"Todos"," muestra cada sonido de todas las pestañas.",[26,777,778,779,782,783,786],{},"Un sonido puede pertenecer a ",[30,780,781],{},"una o más pestañas",". Clic derecho en un sonido y usa ",[30,784,785],{},"Mover a pestaña"," para asignarlo.",[14,788,789,790,793],{},"Las transiciones de pestaña están en ",[30,791,792],{},"Ajustes → General",": Slide, Fade, Botones uno a uno, o Ninguna.",[18,795,797],{"id":796},"grupos","Grupos",[14,799,800],{},"Desde la v0.5.3, los separadores pueden convertirse en grupos con nombre:",[106,802,803,806,809,812],{},[26,804,805],{},"Añadir, renombrar o quitar un grupo desde el menú contextual",[26,807,808],{},"Arrastra la cabecera del grupo — los hijos se mueven con ella",[26,810,811],{},"Suelta sonidos dentro o fuera de un grupo",[26,813,814],{},"Define color de borde, color del nombre y alineación de botones (o usa el valor por defecto de la pestaña)",[14,816,817,818,821],{},"Sigue pudiendo añadir un ",[30,819,820],{},"Separador"," simple si solo necesitas un corte visual.",[14,823,824,825,33],{},"Clic derecho en el espacio vacío del tablero para ",[30,826,827],{},"Añadir grupo",[18,829,831],{"id":830},"etiquetas-filtros","Etiquetas \u002F Filtros",[14,833,834,835,838,839,841],{},"Las etiquetas cruzan las pestañas. El panel ",[30,836,837],{},"Filtro"," (barra lateral ",[30,840,837],{},") es donde las creas y filtras el tablero.",[843,844,846],"h3",{"id":845},"crear-y-editar-etiquetas","Crear y editar etiquetas",[23,848,849,854,865,872],{},[26,850,28,851,853],{},[30,852,837],{}," en la barra lateral.",[26,855,856,857,860,861,864],{},"En ",[30,858,859],{},"Etiquetas",", usa ",[30,862,863],{},"Añadir etiqueta"," — nombre y color.",[26,866,867,868,871],{},"Renombra, recolorea o ",[30,869,870],{},"Eliminar etiqueta"," en la misma lista.",[26,873,874,875,878],{},"Si ves ",[30,876,877],{},"Aún no hay etiquetas",", crea una aquí antes de asignar.",[843,880,882],{"id":881},"asignar-etiquetas-a-sonidos","Asignar etiquetas a sonidos",[14,884,885,886,888],{},"Clic derecho en un sonido → ",[30,887,859],{}," (casillas). Un sonido puede tener varias. Si aún no hay ninguna, el menú te lleva al panel de filtro.",[843,890,892],{"id":891},"filtrar-el-tablero","Filtrar el tablero",[106,894,895,901,912,923],{},[26,896,897,898,33],{},"Activa etiquetas en el panel Filtro o como ",[30,899,900],{},"chips bajo la barra de búsqueda",[26,902,903,904,907,908,911],{},"La coincidencia es ",[30,905,906],{},"OR",": un sonido sigue visible si tiene ",[30,909,910],{},"cualquiera"," de las etiquetas seleccionadas.",[26,913,914,915,918,919,922],{},"El campo ",[30,916,917],{},"Buscar"," combina con ",[30,920,921],{},"AND"," el filtro de etiquetas activo (texto + etiquetas juntos).",[26,924,925],{},"Apaga los chips (o limpia el filtro) para ver de nuevo toda la pestaña.",[14,927,928,929,33],{},"Los nombres de etiqueta en color pueden aparecer en los botones. Actívalos en ",[30,930,931],{},"Ajustes → Comportamiento → Mostrar badges de etiquetas",[18,933,935],{"id":934},"orden","Orden",[14,937,938],{},"Abre el panel de filtro y elige un modo:",[106,940,941,947],{},[26,942,943,946],{},[30,944,945],{},"Definido por el usuario"," — tu orden de pestaña, grupos visibles",[26,948,949,477,952,477,955,405,958,961,962],{},[30,950,951],{},"Nombre",[30,953,954],{},"Fecha de añadido",[30,956,957],{},"Tiempo de reproducción",[30,959,960],{},"Tamaño de archivo"," — lista plana ordenada; ",[30,963,964],{},"los grupos se ocultan",[14,966,967],{},"Ordenar por duración puede precargar los metadatos de duración la primera vez.",[18,969,971],{"id":970},"reordenar","Reordenar",[14,973,974,975,978,979,982,983,33],{},"Activa arrastrar y soltar en ",[30,976,977],{},"Ajustes → Comportamiento"," (",[30,980,981],{},"Permitir reordenar","). Luego arrastra sonidos y grupos a su sitio. Reordenar aplica en el orden ",[30,984,945],{},[18,986,988],{"id":987},"selección-múltiple","Selección múltiple",[14,990,991,992,994],{},"Activa ",[30,993,988],{}," en la barra de navegación, luego:",[106,996,997,1000,1006,1013],{},[26,998,999],{},"Clic para alternar un sonido",[26,1001,1002,1005],{},[30,1003,1004],{},"Mayús+clic"," para un rango desde el último ancla",[26,1007,1008,1009,1012],{},"Arrastra un ",[30,1010,1011],{},"marco"," en el espacio vacío del tablero",[26,1014,1015],{},"Clic en el tablero vacío (o fuera) para limpiar la selección",[14,1017,1018,1019,477,1022,477,1025,1028,1029,33],{},"Una barra masiva muestra el recuento, más ",[30,1020,1021],{},"Color",[30,1023,1024],{},"Mover a pestaña…",[30,1026,1027],{},"Eliminar"," y ",[30,1030,1031],{},"Hecho",[14,1033,1034,1035,1038],{},"En selección múltiple, cada botón muestra un ",[30,1036,1037],{},"chip de ID de 8 caracteres",". Clic derecho en el chip para copiarlo.",[18,1040,1042],{"id":1041},"volumen-por-sonido","Volumen por sonido",[14,1044,1045,1046,1049,1050,1053],{},"Clic derecho → ",[30,1047,1048],{},"Volumen",". Arrastra el control de 0 % a 100 %. ",[30,1051,1052],{},"Doble clic"," lo restablece a 100 %.",[14,1055,1056],{},"Se acumula con el volumen de salida maestro en Ajustes.",[18,1058,1060],{"id":1059},"atajos-e-ids-de-sonido","Atajos e IDs de sonido",[14,1062,1063,1064,1067],{},"Cada sonido tiene un ID de 8 caracteres. Cópialo desde el menú contextual del botón (",[30,1065,1066],{},"Copiar ID",") o el chip de ID de la selección múltiple.",[14,1069,28,1070,1073,1074,1077],{},[30,1071,1072],{},"Ajustes → Atajos"," para vincular una tecla a un ID de sonido. Los atajos globales son opcionales. ",[30,1075,1076],{},"Asignar atajo"," en el menú contextual salta allí con el ID rellenado.",[14,1079,1080,1081,1083],{},"El mismo ID es el que ",[70,1082,63],{"href":315}," usa para disparar un clip.",[18,1085,1087],{"id":1086},"imágenes-de-fondo-y-colores","Imágenes de fondo y colores",[14,1089,1090,1091,1095],{},"Clic derecho en un sonido para definir colores por botón o una imagen de fondo. Eso es independiente del ",[70,1092,1094],{"href":1093},"\u002Fdocs\u002Ftheme-editor","Theme Creator",", que da estilo a todo el tablero.",[14,1097,1098,1099,1102],{},"El selector es un diálogo ",[30,1100,1101],{},"Imagen de fondo"," (PNG, JPEG, GIF, WebP):",[106,1104,1105,1111,1121],{},[26,1106,1107,1110],{},[30,1108,1109],{},"Archivos locales"," — añade carpetas, elige un archivo, busca por nombre, previsualiza la cuadrícula o quita una carpeta de la biblioteca",[26,1112,1113,1116,1117,33],{},[30,1114,1115],{},"GifSnap"," — busca GIFs en línea sin clave API. La primera visita pide aceptar las peticiones a GifSnap; los resultados se cachean para reducir tráfico. Ver ",[70,1118,1115],{"href":1119,"rel":1120},"https:\u002F\u002Fgifsnap.com",[74],[26,1122,1123,1126,1127,1129],{},[30,1124,1125],{},"KLIPY"," — busca GIFs en línea. Pon tu propia clave API en ",[30,1128,977],{},". La clave no se guarda en los archivos del proyecto.",[14,1131,1132],{},"Tras elegir, mueve y recorta la imagen en el botón.",{"title":227,"searchDepth":228,"depth":228,"links":1134},[1135,1136,1137,1142,1143,1144,1145,1146,1147],{"id":758,"depth":228,"text":759},{"id":796,"depth":228,"text":797},{"id":830,"depth":228,"text":831,"children":1138},[1139,1140,1141],{"id":845,"depth":737,"text":846},{"id":881,"depth":737,"text":882},{"id":891,"depth":737,"text":892},{"id":934,"depth":228,"text":935},{"id":970,"depth":228,"text":971},{"id":987,"depth":228,"text":988},{"id":1041,"depth":228,"text":1042},{"id":1059,"depth":228,"text":1060},{"id":1086,"depth":228,"text":1087},"Etiquetas, filtros, pestañas, grupos, orden, selección múltiple, volumen y atajos.",{},4,"\u002Forganizing-sounds",{"title":726,"description":1148},"organizing-sounds","v2Vh-pefsaiWoUdwQrv4wMerfeXZbtLIa6iq8beVync",{"id":1156,"title":1157,"body":1158,"description":1282,"extension":236,"meta":1283,"navigation":238,"order":1284,"path":1285,"seo":1286,"stem":1287,"__hash__":1288},"content_es\u002Ftheme-editor.md","Editor de temas",{"type":7,"value":1159,"toc":1276},[1160,1163,1169,1173,1199,1202,1206,1220,1224,1250,1253,1257,1262],[10,1161,1157],{"id":1162},"editor-de-temas",[14,1164,1165,1166,33],{},"El Theme Creator es el editor visual completo de tu tablero. Ábrelo desde ",[30,1167,1168],{},"Ajustes → General → Theme Creator",[18,1170,1172],{"id":1171},"tres-pestañas","Tres pestañas",[23,1174,1175,1188,1194],{},[26,1176,1177,1180,1181,150,1184,1187],{},[30,1178,1179],{},"General"," — nombre del tema, colores compartidos y carga de fuentes (",[44,1182,1183],{},".ttf",[44,1185,1186],{},".otf",")",[26,1189,1190,1193],{},[30,1191,1192],{},"Botones"," — colores, tipo, diseño y overlay GIF de los botones de sonido",[26,1195,1196,1198],{},[30,1197,759],{}," — colores, tipo y grosor de borde de la barra de pestañas",[14,1200,1201],{},"Una vista previa en vivo muestra pestañas y botones mientras editas.",[18,1203,1205],{"id":1204},"qué-puedes-cambiar","Qué puedes cambiar",[106,1207,1208,1211,1214,1217],{},[26,1209,1210],{},"Colores primario y de acento, fondos, colores de botones, colores de pestañas",[26,1212,1213],{},"Familia y tamaño de fuente de botones y pestañas",[26,1215,1216],{},"Ancho, radio, borde, huecos y padding de los botones",[26,1218,1219],{},"Opacidad del overlay GIF (normal y hover)",[18,1221,1223],{"id":1222},"guardar-y-compartir","Guardar y compartir",[106,1225,1226,1232,1238,1244],{},[26,1227,1228,1231],{},[30,1229,1230],{},"Exportar .css"," — escribe un archivo de tema para respaldar o enviar a un amigo",[26,1233,1234,1237],{},[30,1235,1236],{},"Añadir a temas"," — guarda el archivo en tu carpeta Themes y aplícalo",[26,1239,1240,1243],{},[30,1241,1242],{},"Importar .css"," — carga un preset integrado o un tema guardado",[26,1245,1246,1249],{},[30,1247,1248],{},"Restablecer"," — vuelve a los valores por defecto de SoundNinja",[14,1251,1252],{},"Si cierras la ventana con cambios sin guardar, SoundNinja te pide que guardes primero.",[18,1254,1256],{"id":1255},"sin-el-editor-completo","Sin el editor completo",[14,1258,856,1259,1261],{},[30,1260,792],{}," aún puedes:",[106,1263,1264,1267,1273],{},[26,1265,1266],{},"Elegir un tema de la lista",[26,1268,1269,1270,1187],{},"Editar variables CSS en vivo (",[30,1271,1272],{},"CSS personalizado",[26,1274,1275],{},"Importar un archivo de tema a la carpeta Themes",{"title":227,"searchDepth":228,"depth":228,"links":1277},[1278,1279,1280,1281],{"id":1171,"depth":228,"text":1172},{"id":1204,"depth":228,"text":1205},{"id":1222,"depth":228,"text":1223},{"id":1255,"depth":228,"text":1256},"Diseña colores, fuentes, botones y pestañas en el Theme Creator.",{},5,"\u002Ftheme-editor",{"title":1157,"description":1282},"theme-editor","bPcJP7OLtBsnNMYJ-S1J6DmB6nngULo1_Q1hBJMNZAQ",{"id":1290,"title":1291,"body":1292,"description":1428,"extension":236,"meta":1429,"navigation":238,"order":1430,"path":1431,"seo":1432,"stem":1433,"__hash__":1434},"content_es\u002Frecording-editor.md","Editor de grabación",{"type":7,"value":1293,"toc":1422},[1294,1297,1303,1307,1313,1333,1336,1340,1365,1369,1383,1387,1401,1412],[10,1295,1291],{"id":1296},"editor-de-grabación",[14,1298,1299,1300,1302],{},"Graba un clip dentro de SoundNinja, recórtalo e impórtalo a una pestaña. Abre el editor con el botón ",[30,1301,676],{}," en la barra del reproductor.",[18,1304,1306],{"id":1305},"elegir-una-entrada","Elegir una entrada",[14,1308,856,1309,1312],{},[30,1310,1311],{},"Ajustes → Audio",":",[106,1314,1315,1321,1327],{},[26,1316,1317,1320],{},[30,1318,1319],{},"Dispositivos de entrada"," — micrófono",[26,1322,1323,1326],{},[30,1324,1325],{},"Dispositivos de salida (audio del PC)"," — loopback de lo que reproduce el PC",[26,1328,1329,1332],{},[30,1330,1331],{},"Volumen de entrada"," — ganancia de captura del 0 % al 200 %",[14,1334,1335],{},"El botón Grabar usa el dispositivo que eliges aquí.",[18,1337,1339],{"id":1338},"editar-la-toma","Editar la toma",[106,1341,1342,1345,1348,1356,1359,1362],{},[26,1343,1344],{},"Grabar y detener",[26,1346,1347],{},"Observar el medidor de nivel de entrada",[26,1349,1350,405,1353],{},[30,1351,1352],{},"Normalizar",[30,1354,1355],{},"Cancelación de ruido",[26,1357,1358],{},"Recortar todo el clip, recortar a una selección o borrar una selección",[26,1360,1361],{},"Deshacer \u002F rehacer",[26,1363,1364],{},"Acercar y alejar",[18,1366,1368],{"id":1367},"preparar-e-importar","Preparar e importar",[23,1370,1371,1374,1377],{},[26,1372,1373],{},"Añade la selección o la pista completa a la lista de staging.",[26,1375,1376],{},"La lista empieza vacía: graba, edita y luego añade un clip.",[26,1378,1379,405,1381,684],{},[30,1380,680],{},[30,1382,683],{},[18,1384,1386],{"id":1385},"separación-de-stems-opcional","Separación de stems (opcional)",[14,1388,1389,1390,1393,1394,405,1397,1400],{},"Las builds oficiales de Windows, macOS y Linux incluyen la función ",[30,1391,1392],{},"stems",". El Record Editor puede conservar ",[30,1395,1396],{},"voces",[30,1398,1399],{},"música"," con BS-RoFormer.",[14,1402,1403,1404,1407,1408,1411],{},"El modelo pesa unos 158 MB y ",[30,1405,1406],{},"no"," viene en el instalador. Descárgalo desde ",[30,1409,1410],{},"Ajustes → Separación de stems",", o acepta el aviso del primer arranque. El instalador de Windows también puede ofrecer descargar el modelo al primer inicio.",[14,1413,1414,1415,150,1418,1421],{},"Las builds personalizadas desde código necesitan un flag extra (",[44,1416,1417],{},"tauri:serve:stems",[44,1419,1420],{},"tauri:build:stems",").",{"title":227,"searchDepth":228,"depth":228,"links":1423},[1424,1425,1426,1427],{"id":1305,"depth":228,"text":1306},{"id":1338,"depth":228,"text":1339},{"id":1367,"depth":228,"text":1368},{"id":1385,"depth":228,"text":1386},"Captura micrófono o audio del PC, edita el clip y suéltalo en tu tablero.",{},6,"\u002Frecording-editor",{"title":1291,"description":1428},"recording-editor","89aDSCp7hE8To2TNFwdWaImQVsHH2-xNcOyltCPP5IY",{"id":4,"title":5,"body":1436,"description":235,"extension":236,"meta":1579,"navigation":238,"order":239,"path":240,"seo":1580,"stem":242,"__hash__":243},{"type":7,"value":1437,"toc":1572},[1438,1440,1442,1444,1464,1466,1468,1490,1492,1506,1508,1510,1532,1534,1538],[10,1439,5