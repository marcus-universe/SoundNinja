 und Token eintragen.",[18,102,104],{"id":103},"aktionen","Aktionen",[106,107,108,114,120],"ul",{},[26,109,110,113],{},[29,111,112],{},"Trigger Sound"," — aus dem Live-Dropdown wählen oder 8-stellige Sound-ID tippen (Companion-Variablen gehen)",[26,115,116,119],{},[29,117,118],{},"Stop Sound"," — einen spielenden Sound per ID stoppen",[26,121,122,125],{},[29,123,124],{},"Stop All"," — alle spielenden Sounds stoppen",[14,127,128],{},"Sound-ID in SoundNinja über das Button-Kontextmenü oder den Mehrfachauswahl-Chip kopieren.",[18,130,132],{"id":131},"feedbacks-und-variablen","Feedbacks und Variablen",[106,134,135,141,154,160],{},[26,136,137,140],{},[29,138,139],{},"Sound Playing"," — wahr, solange diese Sound-ID aktiv ist (für Button-Farbe)",[26,142,143,146,147,150,151],{},[44,144,145],{},"$(soundninja:connected)"," — ",[44,148,149],{},"true"," \u002F ",[44,152,153],{},"false",[26,155,156,159],{},[44,157,158],{},"$(soundninja:playing_count)"," — wie viele Sounds spielen",[26,161,162,165],{},[44,163,164],{},"$(soundninja:last_triggered)"," — zuletzt ausgelöste Sound-ID",[18,167,169],{"id":168},"http-api-fortgeschritten","HTTP-API (fortgeschritten)",[14,171,172,173],{},"Basispfad: ",[44,174,175],{},"\u002Fapi\u002Fv1",[106,177,178,184,190,196,206,212,221],{},[26,179,180,183],{},[44,181,182],{},"GET \u002Finfo"," — App-Name, Version, Protokoll, ob ein Token nötig ist",[26,185,186,189],{},[44,187,188],{},"GET \u002Fsounds"," — Soundliste (id, name, tabs, active)",[26,191,192,195],{},[44,193,194],{},"GET \u002Fstate"," — Sounds plus gerade spielende IDs",[26,197,198,201,202,205],{},[44,199,200],{},"POST \u002Ftrigger"," mit ",[44,203,204],{},"{ \"id\" }"," — Sound abspielen",[26,207,208,211],{},[44,209,210],{},"GET \u002Ftrigger\u002F:id"," — abspielen (einfach im Browser testen)",[26,213,214,217,218,220],{},[44,215,216],{},"POST \u002Fstop"," mit optionalem ",[44,219,204],{}," — einen Sound oder alle stoppen",[26,222,223,226],{},[44,224,225],{},"GET \u002Fws"," — Live-Status; Trigger\u002FStop eingehend senden",{"title":228,"searchDepth":229,"depth":229,"links":230},"",2,[231,232,233,234,235],{"id":20,"depth":229,"text":21},{"id":62,"depth":229,"text":63},{"id":103,"depth":229,"text":104},{"id":131,"depth":229,"text":132},{"id":168,"depth":229,"text":169},"SoundNinja über das lokale Netz mit Bitfocus Companion auslösen.","md",{},true,7,"\u002Fremote-control",{"title":5,"description":236},"remote-control","ddBO7GK-xb37noUEMrbJ5MCaxpRw-DZ6uuMn55KdClE",[246,365,562,707,860,994,1137,1283],{"id":247,"title":248,"body":249,"description":358,"extension":237,"meta":359,"navigation":239,"order":360,"path":361,"seo":362,"stem":363,"__hash__":364},"content_de\u002Foverview.md","Überblick",{"type":7,"value":250,"toc":352},[251,254,257,260,263,267,281,285,315,319,328,332],[10,252,248],{"id":253},"überblick",[14,255,256],{},"SoundNinja ist ein Open-Source-Soundboard für Livestreams, Chats mit Freunden und Podcast-Aufnahmen. Es läuft auf Tauri v2 und Nuxt 4 und bleibt dabei sparsam mit RAM und Speicherplatz.",[14,258,259],{},"Das Ziel: eine große Sound-Bibliothek schnell scannen und den richtigen Clip in Millisekunden abspielen. Die Oberfläche eignet sich auch als Dashboard in VR.",[14,261,262],{},"SoundNinja steckt noch in der frühen Entwicklung. Funktionen laufen, aber nicht jede Plattform ist vollständig getestet.",[18,264,266],{"id":265},"für-wen","Für wen",[106,268,269,272,275,278],{},[26,270,271],{},"Streamer, die sofortige Sound-Cues brauchen",[26,273,274],{},"Freunde, die ein gemeinsames Board für Voice-Chat wollen",[26,276,277],{},"Podcaster, die Clips aufnehmen und aufs Board legen",[26,279,280],{},"Alle, die ein anpassbares, lokales Soundboard wollen",[18,282,284],{"id":283},"was-du-tun-kannst","Was du tun kannst",[106,286,287,290,293,296,299,302,309,312],{},[26,288,289],{},"Ein Soundboard aus eigenen Audiodateien bauen",[26,291,292],{},"Sounds in farbigen Tabs, Gruppen und über die Suche sortieren",[26,294,295],{},"Das Aussehen mit dem Theme Creator gestalten",[26,297,298],{},"PC-Audio oder Mikrofon im Record Editor aufnehmen",[26,300,301],{},"Hotkeys einzelnen Sounds zuweisen",[26,303,304,305,308],{},"Sounds über ",[69,306,63],{"href":307},"\u002Fdocs\u002Fremote-control"," auslösen",[26,310,311],{},"Ein komplettes Soundboard importieren und exportieren",[26,313,314],{},"GIFs oder Bilder auf Sound-Buttons legen",[18,316,318],{"id":317},"lizenz","Lizenz",[14,320,321,322,327],{},"SoundNinja ist freie Software unter ",[69,323,326],{"href":324,"rel":325},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fblob\u002Fmain\u002FLICENSE",[73],"GPL-3.0",". Forken, ändern, teilen.",[18,329,331],{"id":330},"nächste-schritte","Nächste Schritte",[23,333,334,340,346],{},[26,335,336],{},[69,337,339],{"href":338},"\u002Fdocs\u002Finstallation","SoundNinja installieren",[26,341,342],{},[69,343,345],{"href":344},"\u002Fdocs\u002Fadding-sounds","Sounds hinzufügen",[26,347,348],{},[69,349,351],{"href":350},"\u002Fdocs\u002Forganizing-sounds","Board organisieren",{"title":228,"searchDepth":229,"depth":229,"links":353},[354,355,356,357],{"id":265,"depth":229,"text":266},{"id":283,"depth":229,"text":284},{"id":317,"depth":229,"text":318},{"id":330,"depth":229,"text":331},"Was SoundNinja ist und was du damit machen kannst.",{},1,"\u002Foverview",{"title":248,"description":358},"overview","k9vdLuByV0_2FJs4S1c2pJgDzzqDtddQcqK9KQYpZ8M",{"id":366,"title":367,"body":368,"description":557,"extension":237,"meta":558,"navigation":239,"order":229,"path":559,"seo":560,"stem":372,"__hash__":561},"content_de\u002Finstallation.md","Installation",{"type":7,"value":369,"toc":550},[370,373,387,391,409,412,416,430,433,437,461,472,476,483,487,501,531,546],[10,371,367],{"id":372},"installation",[14,374,375,376,380,381,386],{},"Hol dir einen Build von der ",[69,377,379],{"href":378},"\u002Fdownload","Download-Seite"," oder von ",[69,382,385],{"href":383,"rel":384},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002F