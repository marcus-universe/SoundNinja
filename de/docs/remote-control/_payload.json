6],{"id":389,"depth":229,"text":390},{"id":414,"depth":229,"text":415},{"id":435,"depth":229,"text":436},{"id":474,"depth":229,"text":475},{"id":485,"depth":229,"text":486},"SoundNinja unter Windows, macOS oder Linux installieren.",{},"\u002Finstallation",{"title":367,"description":557},"Djt_phX5yPzPpgqthAHl5cQnHy-U9ban07ufeARjtGI",{"id":563,"title":345,"body":564,"description":700,"extension":237,"meta":701,"navigation":239,"order":702,"path":703,"seo":704,"stem":705,"__hash__":706},"content_de\u002Fadding-sounds.md",{"type":7,"value":565,"toc":692},[566,569,572,576,593,597,628,632,651,655,668,671,675,682,686],[10,567,345],{"id":568},"sounds-hinzufügen",[14,570,571],{},"Ein Board bleibt leer, bis du Clips hinzufügst. SoundNinja importiert Dateien, ganze Ordner, eine Aufnahme oder ein geteiltes Soundboard-Paket.",[18,573,575],{"id":574},"audiodateien-importieren","Audiodateien importieren",[23,577,578,587,590],{},[26,579,580,398,583,586],{},[29,581,582],{},"Datei → Audiodateien importieren",[29,584,585],{},"Import"," in der Navbar.",[26,588,589],{},"Eine oder mehrere Audiodateien wählen.",[26,591,592],{},"Sounds landen im aktuellen Tab.",[18,594,596],{"id":595},"ordner-importieren","Ordner importieren",[23,598,599,608,611],{},[26,600,601,604,605,607],{},[29,602,603],{},"Datei → Ordner importieren"," (oder ",[29,606,596],{}," in der Navbar).",[26,609,610],{},"Einen oder mehrere Ordner hinzufügen. Vor dem Import per Drag neu sortieren.",[26,612,613,614],{},"Ziel wählen:\n",[106,615,616,622],{},[26,617,618,621],{},[29,619,620],{},"Als Tabs importieren"," — jeder Ordner wird ein eigener Tab",[26,623,624,627],{},[29,625,626],{},"In aktuellen Tab importieren"," — alle Dateien landen im aktiven Tab",[18,629,631],{"id":630},"clip-aufnehmen","Clip aufnehmen",[14,633,634,635,639,640,643,644,398,647,650],{},"Öffne den ",[69,636,638],{"href":637},"\u002Fdocs\u002Frecording-editor","Record Editor"," über ",[29,641,642],{},"Aufnahme"," in der Player-Leiste. Aufnehmen, zuschneiden, dann ",[29,645,646],{},"Auswahl importieren",[29,648,649],{},"Alle importieren"," in den aktuellen Tab oder einen gewählten Tab.",[18,652,654],{"id":653},"soundboard-importieren","Soundboard importieren",[14,656,657,660,661,201,664,667],{},[29,658,659],{},"Datei → Soundboard importieren"," lädt ein geteiltes Paket. Pakete sind ein ",[44,662,663],{},".zip",[44,665,666],{},"project.sninja"," plus Sounddateien. Danach Projekt öffnen und abspielen.",[14,669,670],{},"Du kannst mehrere Projekte (Profile) halten. Über den Projektwähler zwischen Boards wechseln.",[18,672,674],{"id":673},"fehlende-dateien-neu-verknüpfen","Fehlende Dateien neu verknüpfen",[14,676,677,678,681],{},"Wenn Audiodateien auf der Festplatte umziehen, zeigt SoundNinja ",[29,679,680],{},"Fehlende Sounddateien",". Einen Suchordner wählen und Clips neu verknüpfen.",[18,683,685],{"id":684},"weiter","Weiter",[14,687,688,689,39],{},"Tabs, Gruppen und Hotkeys: ",[69,690,691],{"href":350},"Sounds organisieren",{"title":228,"searchDepth":229,"depth":229,"links":693},[694,695,696,697,698,699],{"id":574,"depth":229,"text":575},{"id":595,"depth":229,"text":596},{"id":630,"depth":229,"text":631},{"id":653,"depth":229,"text":654},{"id":673,"depth":229,"text":674},{"id":684,"depth":229,"text":685},"Audio, Ordner, Aufnahmen und geteilte Soundboards importieren.",{},3,"\u002Fadding-sounds",{"title":345,"description":700},"adding-sounds","qhheWryk-vrNfEsQyZSumTndjdSmJPmEctxDG9Gyulk",{"id":708,"title":691,"body":709,"description":853,"extension":237,"meta":854,"navigation":239,"order":855,"path":856,"seo":857,"stem":858,"__hash__":859},"content_de\u002Forganizing-sounds.md",{"type":7,"value":710,"toc":844},[711,714,717,721,747,754,758,761,775,782,786,791,795,806,810,813,817,820,826,832,836],[10,712,691],{"id":713},"sounds-organisieren",[14,715,716],{},"SoundNinja ist für große Bibliotheken gebaut. Tabs, Gruppen, Suche und Hotkeys — der Clip ist einen Klick (oder eine Taste) entfernt.",[18,718,720],{"id":719},"tabs","Tabs",[106,722,723,730,737],{},[26,724,725,726,729],{},"Tab mit ",[29,727,728],{},"Tab hinzufügen"," anlegen. Farbe vergeben, damit die Leiste schnell scannbar bleibt.",[26,731,732,733,736],{},"Die Ansicht ",[29,734,735],{},"Alle"," zeigt jeden Sound über alle Tabs.",[26,738,739,740,743,744,39],{},"Ein Sound kann ",[29,741,742],{},"einem oder mehreren Tabs"," gehören. Rechtsklick → ",[29,745,746],{},"Zu Tab verschieben",[14,748,749,750,753],{},"Tab-Übergänge: ",[29,751,752],{},"Einstellungen → Allgemein"," — Slide, Fade, Buttons nacheinander oder Keine.",[18,755,757],{"id":756},"gruppen","Gruppen",[14,759,760],{},"Seit v0.5.3 können Trenner zu benannten Gruppen werden:",[106,762,763,766,769,772],{},[26,764,765],{},"Gruppe über das Kontextmenü hinzufügen, umbenennen oder entfernen",[26,767,768],{},"Gruppenkopf ziehen — Kinder kommen mit",[26,770,771],{},"Sounds in eine Gruppe legen oder herausnehmen",[26,773,774],{},"Rahmenfarbe, Namensfarbe und Button-Ausrichtung setzen (oder Tab-Standard nutzen)",[14,776,777,778,781],{},"Ein einfacher ",[29,779,780],{},"Trenner"," geht weiter, wenn du nur einen visuellen Bruch brauchst.",[18,783,785],{"id":784},"suche","Suche",[14,787,788,790],{},[29,789,785],{}," in der Navbar. Ergebnisse folgen der Eingabe.",[18,792,794],{"id":793},"neu-anordnen","Neu anordnen",[14,796,797,798,801,802,805],{},"Drag-and-Drop in ",[29,799,800],{},"Einstellungen → Verhalten"," einschalten (",[29,803,804],{},"Neu anordnen erlauben","). Dann Sounds und Gruppen ziehen.",[18,807,809],{"id":808},"sammelbearbeitung","Sammelbearbeitung",[14,811,812],{},"Mehrere Sounds markieren, dann Farbe ändern, in einen Tab schieben oder löschen.",[18,814,816],{"id":815},"hotkeys-und-sound-ids","Hotkeys und Sound-IDs",[14,818,819],{},"Jeder Sound hat eine 8-stellige ID. Kopieren über das Button-Kontextmenü oder den Mehrfachauswahl-Chip.",[14,821,822,825],{},[29,823,824],{},"Einstellungen → Hotkeys",": Taste an eine Sound-ID binden. Globale Hotkeys sind optional.",[14,827,828,829,831],{},"Dieselbe ID nutzt ",[69,830,63],{"href":307}," zum Auslösen.",[18,833,835],{"id":834},"gifs-und-farben","GIFs und Farben",[14,837,838,839,843],{},"Rechtsklick auf einen Sound: eigene Farben oder GIF-\u002FBildhintergrund. Das ist getrennt vom ",[69,840,842],{"href":841},"\u002Fdocs\u002Ftheme-editor","Theme Creator",", der das ganze Board gestaltet.",{"title":228,"searchDepth":229,"depth":229,"links":845},[846,847,848,849,850,851,852],{"id":719,"depth":229,"text":720},{"id":756,"depth":229,"text":757},{"id":784,"depth":229,"text":785},{"id":793,"depth":229,"text":794},{"id":808,"depth":229,"text":809},{"id":815,"depth":229,"text":816},{"id":834,"depth":229,"text":835},"Tabs, Gruppen, Suche, Sammelbearbeitung und Hotkeys.",{},4,"\u002Forganizing-sounds",{"title":691,"description":853},"organizing-sounds","tzbjT1L04eFyKK0nuKEVqrhA0oH5iyG-Pq9SkxEWh1w",{"id":861,"title":862,"body":863,"description":988,"extension":237,"meta":989,"navigation":239,"order":990,"path":991,"seo":992,"stem":867,"__hash__":993},"content_de\u002Ftheme-editor.md","Theme-Editor",{"type":7,"value":864,"toc":982},[865,868,874,878,904,907,911,925,929,955,958,962,968],[10,866,862],{"id":867},"theme-editor",[14,869,870,871,39],{},"Der Theme Creator ist der volle visuelle Editor für dein Board. Öffnen über ",[29,872,873],{},"Einstellungen → Allgemein → Theme Creator",[18,875,877],{"id":876},"drei-tabs","Drei Tabs",[23,879,880,893,899],{},[26,881,882,885,886,150,889,892],{},[29,883,884],{},"Allgemein"," — Theme-Name, gemeinsame Farben und Schrift-Uploads (",[44,887,888],{},".ttf",[44,890,891],{},".otf",")",[26,894,895,898],{},[29,896,897],{},"Buttons"," — Farben, Typo, Layout und GIF-Overlay der Sound-Buttons",[26,900,901,903],{},[29,902,720],{}," — Farben, Typo und Rahmenstärke der Tab-Leiste",[14,905,906],{},"Eine Live-Vorschau zeigt Tabs und Buttons beim Bearbeiten.",[18,908,910],{"id":909},"was-du-ändern-kannst","Was du ändern kannst",[106,912,913,916,919,922],{},[26,914,915],{},"P