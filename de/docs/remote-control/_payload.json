mportieren",[29,617,618],{},"Import"," in der Navbar.",[26,621,622],{},"Eine oder mehrere Audiodateien wählen.",[26,624,625],{},"Sounds landen im aktuellen Tab.",[18,627,629],{"id":628},"ordner-importieren","Ordner importieren",[23,631,632,641,644],{},[26,633,634,637,638,640],{},[29,635,636],{},"Datei → Ordner importieren"," (oder ",[29,639,629],{}," in der Navbar).",[26,642,643],{},"Einen oder mehrere Ordner hinzufügen. Vor dem Import per Drag neu sortieren.",[26,645,646,647],{},"Ziel wählen:\n",[106,648,649,655],{},[26,650,651,654],{},[29,652,653],{},"Als Tabs importieren"," — jeder Ordner wird ein eigener Tab",[26,656,657,660],{},[29,658,659],{},"In aktuellen Tab importieren"," — alle Dateien landen im aktiven Tab",[18,662,664],{"id":663},"clip-aufnehmen","Clip aufnehmen",[14,666,667,668,672,673,676,677,407,680,683],{},"Öffne den ",[69,669,671],{"href":670},"\u002Fdocs\u002Frecording-editor","Record Editor"," über ",[29,674,675],{},"Aufnahme"," in der Player-Leiste. Aufnehmen, zuschneiden, dann ",[29,678,679],{},"Auswahl importieren",[29,681,682],{},"Alle importieren"," in den aktuellen Tab oder einen gewählten Tab.",[18,685,687],{"id":686},"soundboard-importieren","Soundboard importieren",[14,689,690,693,694,201,697,700],{},[29,691,692],{},"Datei → Soundboard importieren"," lädt ein geteiltes Paket. Pakete sind ein ",[44,695,696],{},".zip",[44,698,699],{},"project.sninja"," plus Sounddateien. Danach Projekt öffnen und abspielen.",[14,702,703],{},"Du kannst mehrere Projekte (Profile) halten. Über den Projektwähler zwischen Boards wechseln.",[18,705,707],{"id":706},"fehlende-dateien-neu-verknüpfen","Fehlende Dateien neu verknüpfen",[14,709,710,711,714],{},"Wenn Audiodateien auf der Festplatte umziehen, zeigt SoundNinja ",[29,712,713],{},"Fehlende Sounddateien",". Einen Suchordner wählen und Clips neu verknüpfen.",[18,716,718],{"id":717},"weiter","Weiter",[14,720,721,722,39],{},"Tabs, Tags, Filter und Hotkeys: ",[69,723,724],{"href":359},"Sounds organisieren",{"title":228,"searchDepth":229,"depth":229,"links":726},[727,728,729,730,731,732],{"id":607,"depth":229,"text":608},{"id":628,"depth":229,"text":629},{"id":663,"depth":229,"text":664},{"id":686,"depth":229,"text":687},{"id":706,"depth":229,"text":707},{"id":717,"depth":229,"text":718},"Audio, Ordner, Aufnahmen und geteilte Soundboards importieren.",{},3,"\u002Fadding-sounds",{"title":354,"description":733},"adding-sounds","H_ls9_vOwDkgTWPkfe9bQz1A0XidUOmMFV4V2EJpYec",{"id":741,"title":724,"body":742,"description":1143,"extension":237,"meta":1144,"navigation":239,"order":1145,"path":1146,"seo":1147,"stem":1148,"__hash__":1149},"content_de\u002Forganizing-sounds.md",{"type":7,"value":743,"toc":1128},[744,747,754,758,784,791,795,798,812,819,825,829,839,844,875,879,885,889,923,929,933,936,962,965,969,982,986,991,1011,1027,1034,1038,1049,1052,1056,1063,1073,1079,1083,1091,1098,1125],[10,745,724],{"id":746},"sounds-organisieren",[14,748,749,750,753],{},"SoundNinja ist für große Bibliotheken gebaut. ",[29,751,752],{},"Tags und Filter",", Tabs, Suche, Mehrfachauswahl und Hotkeys — der Clip ist einen Klick (oder eine Taste) entfernt.",[18,755,757],{"id":756},"tabs","Tabs",[106,759,760,767,774],{},[26,761,762,763,766],{},"Tab mit ",[29,764,765],{},"Tab hinzufügen"," anlegen. Farbe vergeben, damit die Leiste schnell scannbar bleibt.",[26,768,769,770,773],{},"Die Ansicht ",[29,771,772],{},"Alle"," zeigt jeden Sound über alle Tabs.",[26,775,776,777,780,781,39],{},"Ein Sound kann ",[29,778,779],{},"einem oder mehreren Tabs"," gehören. Rechtsklick → ",[29,782,783],{},"Zu Tab verschieben",[14,785,786,787,790],{},"Tab-Übergänge: ",[29,788,789],{},"Einstellungen → Allgemein"," — Slide, Fade, Buttons nacheinander oder Keine.",[18,792,794],{"id":793},"gruppen","Gruppen",[14,796,797],{},"Seit v0.5.3 können Trenner zu benannten Gruppen werden:",[106,799,800,803,806,809],{},[26,801,802],{},"Gruppe über das Kontextmenü hinzufügen, umbenennen oder entfernen",[26,804,805],{},"Gruppenkopf ziehen — Kinder kommen mit",[26,807,808],{},"Sounds in eine Gruppe legen oder herausnehmen",[26,810,811],{},"Rahmenfarbe, Namensfarbe und Button-Ausrichtung setzen (oder Tab-Standard nutzen)",[14,813,814,815,818],{},"Ein einfacher ",[29,816,817],{},"Trenner"," geht weiter, wenn du nur einen visuellen Bruch brauchst.",[14,820,821,822,39],{},"Rechtsklick auf leeren Board-Bereich: ",[29,823,824],{},"Gruppe hinzufügen",[18,826,828],{"id":827},"tags-filter","Tags \u002F Filter",[14,830,831,832,835,836,838],{},"Tags gelten tabübergreifend. Das ausfahrbare ",[29,833,834],{},"Filter","-Panel (Sidebar ",[29,837,834],{},") ist der Ort zum Anlegen und zum Filtern des Boards.",[840,841,843],"h3",{"id":842},"tags-anlegen-und-bearbeiten","Tags anlegen und bearbeiten",[23,845,846,851,862,868],{},[26,847,848,850],{},[29,849,834],{}," in der Sidebar öffnen.",[26,852,853,854,857,858,861],{},"Unter ",[29,855,856],{},"Tags"," → ",[29,859,860],{},"Tag hinzufügen"," — Name und Farbe vergeben.",[26,863,864,865,39],{},"Im selben Panel umbenennen, umfärben oder ",[29,866,867],{},"Tag löschen",[26,869,870,871,874],{},"Steht da ",[29,872,873],{},"Noch keine Tags",", zuerst hier einen anlegen, bevor du zuweist.",[840,876,878],{"id":877},"tags-an-sounds-hängen","Tags an Sounds hängen",[14,880,881,882,884],{},"Rechtsklick auf einen Sound → ",[29,883,856],{}," (Checkboxen). Ein Sound darf mehrere Tags haben. Existieren noch keine, zeigt das Menü den Weg zum Filter-Panel.",[840,886,888],{"id":887},"board-filtern","Board filtern",[106,890,891,898,909,920],{},[26,892,893,894,897],{},"Tags im Filter-Panel oder als ",[29,895,896],{},"Chips unter der Suchleiste"," umschalten.",[26,899,900,901,904,905,908],{},"Abgleich ist ",[29,902,903],{},"ODER",": ein Sound bleibt sichtbar, wenn er ",[29,906,907],{},"irgendeinen"," gewählten Tag hat.",[26,910,911,912,915,916,919],{},"Das Feld ",[29,913,914],{},"Suche"," in der Navbar kombiniert per ",[29,917,918],{},"UND"," mit dem aktiven Tag-Filter (Tippen + Tags zusammen).",[26,921,922],{},"Chips aus (oder Filter leeren), um den ganzen Tab wieder zu sehen.",[14,924,925,926,39],{},"Farbige Tag-Namen können auf Buttons erscheinen. Schalter: ",[29,927,928],{},"Einstellungen → Verhalten → Tag-Badges anzeigen",[18,930,932],{"id":931},"sortierung","Sortierung",[14,934,935],{},"Im Filter-Panel eine Sortierung wählen:",[106,937,938,944],{},[26,939,940,943],{},[29,941,942],{},"Benutzerdefiniert"," — deine Tab-Reihenfolge, Gruppen sichtbar",[26,945,946,479,949,479,952,407,955,958,959],{},[29,947,948],{},"Name",[29,950,951],{},"Hinzugefügt",[29,953,954],{},"Spielzeit",[29,956,957],{},"Dateigröße"," — flache sortierte Liste; ",[29,960,961],{},"Gruppen sind ausgeblendet",[14,963,964],{},"Sortierung nach Dauer kann beim ersten Mal die Dauer-Metadaten vorwärmen.",[18,966,968],{"id":967},"neu-anordnen","Neu anordnen",[14,970,971,972,975,976,979,980,39],{},"Drag-and-Drop in ",[29,973,974],{},"Einstellungen → Verhalten"," einschalten (",[29,977,978],{},"Neu anordnen erlauben","). Dann Sounds und Gruppen ziehen. Neu anordnen gilt bei ",[29,981,942],{},[18,983,985],{"id":984},"mehrfachauswahl","Mehrfachauswahl",[14,987,988,990],{},[29,989,985],{}," in der Navbar einschalten, dann:",[106,992,993,996,1002,1008],{},[26,994,995],{},"Klick toggelt einen Sound",[26,997,998,1001],{},[29,999,1000],{},"Shift+Klick"," wählt einen Bereich ab dem letzten Anker",[26,1003,1004,1007],{},[29,1005,1006],{},"Rahmen"," auf leerem Board ziehen",[26,1009,1010],{},"Klick auf leeres Board (oder außerhalb) leert die Auswahl",[14,1012,1013,1014,479,1017,479,1020,1023,1024,39],{},"Eine Sammelleiste zeigt die Anzahl plus ",[29,1015,1016],{},"Farbe",[29,1018,1019],{},"Zu Tab verschieben…",[29,1021,1022],{},"Löschen"," und ",[29,1025,1026],{},"Fertig",[14,1028,1029,1030,1033],{},"In der Mehrfachauswahl zeigt jeder Button einen ",[29,1031,1032],{},"8-Zeichen-ID-Chip",". Rechtsklick auf den Chip kopiert die ID.",[18,1035,1037],{"id":1036},"lautstärke-pro-sound","Lautstärke pro Sound",[14,1039,1040,1041,1044,1045,1048],{},"Rechtsklick → ",[29,1042,1043],{},"Lautstärke",". Slider von 0 % bis 100 %. ",[29,1046,1047],{},"Doppelklick"," setzt auf 100 % zurück.",[14,1050,1051],{},"Das stapelt sich mit der Master-Ausgangslautstärke in den Einstellungen.",[18,1053,1055],{"id":1054},"hotkeys-und-sound-ids","Hotkeys und Sound-IDs",[14,1057,1058,1059,1062],{},"Jeder Sound hat eine 8-stellige ID. Kopieren über das Button-Kontextmenü (",[29,1060,1061],{},"ID kopieren",") oder den Mehrfachauswahl-Chip.",[14,1064,1065,1068,1069,1072],{},[29,1066,1067],{},"Einstellungen → Hotkeys",": Taste an eine Sound-ID binden. Globale Hotkeys sind optional. ",[29,1070,1071],{},"Hotkey zuweisen"," im Kontextmenü springt dorthin, ID vorausgefüllt.",[14,1074,1075,1076,1078],{},"Dieselbe ID nutzt ",[69,1077,63],{"href":316}," zum Auslösen.",[18,1080,1082],{"id":1081},"hintergrundbilder-und-farben","Hintergrundbilder und Farben",[14,1084,1085,1086,1090],{},"Rechtsklick auf einen Sound: eigene Farben oder ein Hintergrundbild. Das ist getrennt vom ",[69,1087,1089],{"href":1088},"\u002Fdocs\u002Ftheme-editor","Theme Creator",", der das ganze Board gestaltet.",[14,1092,1093,1094,1097],{},"Der Picker ist ein Dialog ",[29,1095,1096],{},"Hintergrundbild"," (PNG, JPEG, GIF, WebP):",[106,1099,1100,1106,1116],{},[26,1101,1102,1105],{},[29,1103,1104],{},"Lokale Dateien"," — Ordner hinzufügen, einzelne Datei wählen, Dateinamen suchen, Rastervorschau, Ordner aus der Bibliothek entfernen",[26,1107,1108,1111,1112,39],{},[29,1109,1110],{},"GifSnap"," — GIFs online suchen, ohne API-Key. Beim ersten Besuch musst du GifSnap-Anfragen akzeptieren; Suchergebnisse werden gecacht, um Traffic zu sparen. Siehe ",[69,1113,1110],{"href":1114,"rel":1115},"https:\u002F\u002Fgifsnap.com",[73],[26,1117,1118,1121,1122,1124],{},[29,1119,1120],{},"KLIPY"," — GIFs online suchen. Eigenen API-Key unter ",[29,1123,974],{},". Der Key landet nicht in Projektdateien.",[14,1126,1127],{},"Nach der Wahl Bild auf dem Button schieben und zuschneiden.",{"title":228,"searchDepth":229,"depth":229,"links":1129},[1130,1131,1132,1137,1138,1139,1140,1141,1142],{"id":756,"depth":229,"text":757},{"id":793,"depth":229,"text":794},{"id":827,"depth":229,"text":828,"children":1133},[1134,1135,1136],{"id":842,"depth":735,"text":843},{"id":877,"depth":735,"text":878},{"id":887,"depth":735,"text":888},{"id":931,"depth":229,"text":932},{"id":967,"depth":229,"text":968},{"id":984,"depth":229,"text":985},{"id":1036,"depth":229,"text":1037},{"id":1054,"depth":229,"text":1055},{"id":1081,"depth":229,"text":1082},"Tags, Filter, Tabs, Gruppen, Sortierung, Mehrfachauswahl, Lautstärke und Hotkeys.",{},4,"\u002Forganizing-sounds",{"title":724,"description":1143},"organizing-sounds","jIHdo3ArhbXIxbWQI561fKtutYzeQgCkElssurn8EGo",{"id":1151,"title":1152,"body":1153,"description":1277,"extension":237,"meta":1278,"navigation":239,"order":1279,"path":1280,"seo":1281,"stem":1157,"__hash__":1282},"content_de\u002Ftheme-editor.md","Theme-Editor",{"type":7,"value":1154,"toc":1271},[1155,1158,1164,1168,1194,1197,1201,1215,1219,1245,1248,1252,1257],[10,1156,1152],{"id":1157},"theme-editor",[14,1159,1160,1161,39],{},"Der Theme Creator ist der volle visuelle Editor für dein Board. Öffnen über ",[29,1162,1163],{},"Einstellungen → Allgemein → Theme Creator",[18,1165,1167],{"id":1166},"drei-tabs","Drei Tabs",[23,1169,1170,1183,1189],{},[26,1171,1172,1175,1176,150,1179,1182],{},[29,1173,1174],{},"Allgemein"," — Theme-Name, gemeinsame Farben und Schrift-Uploads (",[44,1177,1178],{},".ttf",[44,1180,1181],{},".otf",")",[26,1184,1185,1188],{},[29,1186,1187],{},"Buttons"," — Farben, Typo, Layout und GIF-Overlay der Sound-Buttons",[26,1190,1191,1193],{},[29,1192,757],{}," — Farben, Typo und Rahmenstärke der Tab-Leiste",[14,1195,1196],{},"Eine Live-Vorschau zeigt Tabs und Buttons beim Bearbeiten.",[18,1198,1200],{"id":1199},"was-du-ändern-kannst","Was du ändern kannst",[106,1202,1203,1206,1209,1212],{},[26,1204,1205],{},"Primär- und Akzentfarben, Hintergründe, Button- und Tab-Farben",[26,1207,1208],{},"Schriftfamilie und -größe für Buttons und Tabs",[26,1210,1211],{},"Button-Breite, Radius, Rahmen, Abstände und Innenabstand",[26,1213,1214],{},"GIF-Overlay-Deckkraft (normal und Hover)",[18,1216,1218],{"id":1217},"speichern-und-teilen","Speichern und teilen",[106,1220,1221,1227,1233,1239],{},[26,1222,1223,1226],{},[29,1224,1225],{},".css exportieren"," — Theme-Datei sichern oder weitergeben",[26,1228,1229,1232],{},[29,1230,1231],{},"Zu Themes hinzufügen"," — in den Themes-Ordner speichern und anwenden",[26,1234,1235,1238],{},[29,1236,1237],{},".css importieren"," — Preset oder gespeichertes Theme laden",[26,1240,1241,1244],{},[29,1242,1243],{},"Zurücksetzen"," — SoundNinja-Standard wiederherstellen",[14,1246,1247],{},"Beim Schließen mit ungespeicherten Änderungen fragt SoundNinja nach.",[18,1249,1251],{"id":1250},"ohne-vollen-editor","Ohne vollen Editor",[14,1253,853,1254,1256],{},[29,1255,789],{}," kannst du trotzdem:",[106,1258,1259,1262,1268],{},[26,1260,1261],{},"Ein Theme aus der Liste wählen",[26,1263,1264,1265,1182],{},"CSS-Variablen live bearbeiten (",[29,1266,1267],{},"Eigenes CSS",[26,1269,1270],{},"Eine Theme-Datei in den Themes-Ordner importieren",{"title":228,"searchDepth":229,"depth":229,"links":1272},[1273,1274,1275,1276],{"id":1166,"depth":229,"text":1167},{"id":1199,"depth":229,"text":1200},{"id":1217,"depth":229,"text":1218},{"id":1250,"depth":229,"text":1251},"Farben, Schriften, Buttons und Tabs im Theme Creator gestalten.",{},5,"\u002Ftheme-editor",{"title":1152,"description":1277},"h6Hta3TDDcThnouY3Pk_Omvjq8Eb8knx-HIAvf5YZd8",{"id":1284,"title":1285,"body":1286,"description":1423,"extension":237,"meta":1424,"navigation":239,"order":1425,"path":1426,"seo":1427,"stem":1428,"__hash__":1429},"content_de\u002Frecording-editor.md","Aufnahme-Editor",{"type":7,"value":1287,"toc":1417},[1288,1291,1297,1301,1307,1327,1330,1334,1359,1363,1378,1382,1396,1407],[10,1289,1285],{"id":1290},"aufnahme-editor",[14,1292,1293,1294,1296],{},"Nimm einen Clip in SoundNinja auf, schneide ihn zu und importiere ihn in einen Tab. Öffnen über ",[29,1295,675],{}," in der Player-Leiste.",[18,1298,1300],{"id":1299},"eingang-wählen","Eingang wählen",[14,1302,853,1303,1306],{},[29,1304,1305],{},"Einstellungen → Audio",":",[106,1308,1309,1315,1321],{},[26,1310,1311,1314],{},[29,1312,1313],{},"Eingabegeräte"," — Mikrofon",[26,1316,1317,1320],{},[29,1318,1319],{},"Ausgabegeräte (PC-Audio)"," — Loopback dessen, was der PC spielt",[26,1322,1323,1326],{},[29,1324,1325],{},"Eingangslautstärke"," — Aufnahme-Gain von 0 % bis 200 %",[14,1328,1329],{},"Der Aufnahme-Button nutzt das hier gewählte Gerät.",[18,1331,1333],{"id":1332},"take-bearbeiten","Take bearbeiten",[106,1335,1336,1339,1342,1350,1353,1356],{},[26,1337,1338],{},"Aufnehmen und stoppen",[26,1340,1341],{},"Pegelmesser beobachten",[26,1343,1344,407,1347],{},[29,1345,1346],{},"Normalisieren",[29,1348,1349],{},"Rauschunterdrückung",[26,1351,1352],{},"Ganzen Clip trimmen, auf Auswahl trimmen oder Auswahl löschen",[26,1354,1355],{},"Rückgängig \u002F Wiederholen",[26,1357,1358],{},"Rein- und rauszoomen",[18,1360,1362],{"id":1361},"stagen-und-importieren","Stagen und importieren",[23,1364,1365,1368,1371],{},[26,1366,1367],{},"Auswahl oder ganzen Track zur Staging-Liste hinzufügen.",[26,1369,1370],{},"Die Liste startet leer: aufnehmen, bearbeiten, dann Clip hinzufügen.",[26,1372,1373,407,1375,1377],{},[29,1374,679],{},[29,1376,682],{}," in den aktuellen oder einen gewählten Tab.",[18,1379,1381],{"id":1380},"stem-trennung-optional","Stem-Trennung (optional)",[14,1383,1384,1385,1388,1389,407,1392,1395],{},"Offizielle Windows-, macOS- und Linux-Release-Builds enthalten das ",[29,1386,1387],{},"Stems","-Feature. Der Aufnahme-Editor kann ",[29,1390,1391],{},"Gesang",[29,1393,1394],{},"Musik"," mit BS-RoFormer behalten.",[14,1397,1398,1399,1402,1403,1406],{},"Das Modell ist etwa 158 MB und ",[29,1400,1401],{},"nicht"," im Installer