[{"data":1,"prerenderedAt":1663},["ShallowReactive",2],{"docs-page-de-\u002Fremote-control":3,"docs-nav-de":245},{"id":4,"title":5,"body":6,"description":236,"extension":237,"meta":238,"navigation":239,"order":240,"path":241,"seo":242,"stem":243,"__hash__":244},"content_de\u002Fremote-control.md","Fernsteuerung",{"type":7,"value":8,"toc":227},"minimark",[9,13,17,22,57,60,64,101,105,126,129,133,166,170,176],[10,11,5],"h1",{"id":12},"fernsteuerung",[14,15,16],"p",{},"SoundNinja kann im lokalen Netz lauschen, damit Bitfocus Companion (oder jeder HTTP\u002FWebSocket-Client) Sounds spielt und stoppt.",[18,19,21],"h2",{"id":20},"remote-server-einschalten","Remote-Server einschalten",[23,24,25,33,40,47],"ol",{},[26,27,28,32],"li",{},[29,30,31],"strong",{},"Einstellungen → Remote"," öffnen.",[26,34,35,36,39],{},"Remote-Server aktivieren. Standardport ist ",[29,37,38],{},"7331",".",[26,41,42,43,39],{},"Optional: Token setzen. Clients senden ihn als Bearer-Token oder ",[44,45,46],"code",{},"?token=",[26,48,49,52,53,56],{},[44,50,51],{},"http:\u002F\u002FIP:PORT"," kopieren oder die System-IP unter ",[29,54,55],{},"Einstellungen → Über"," holen.",[14,58,59],{},"Windows kann beim ersten Start eine Firewall-Abfrage zeigen. Zugriff im privaten Netz erlauben.",[18,61,63],{"id":62},"bitfocus-companion","Bitfocus Companion",[23,65,66,75,83,94],{},[26,67,68,74],{},[69,70,63],"a",{"href":71,"rel":72},"https:\u002F\u002Fbitfocus.io\u002Fcompanion",[73],"nofollow"," installieren.",[26,76,77,82],{},[69,78,81],{"href":79,"rel":80},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002Fcompanion-module-soundninja\u002Freleases\u002Flatest",[73],"SoundNinja-Companion.tgz"," herunterladen. Es gibt noch kein Companion-Store-Paket.",[26,84,85,86,89,90,93],{},"In Companion: ",[29,87,88],{},"Modules → Load module package"," und die ",[44,91,92],{},".tgz"," wählen.",[26,95,96,97,100],{},"Eine ",[29,98,99],{},"Sound Ninja","-Verbindung anlegen. PC-IP, Port und Token eintragen.",[18,102,104],{"id":103},"aktionen","Aktionen",[106,107,108,114,120],"ul",{},[26,109,110,113],{},[29,111,112],{},"Trigger Sound"," — aus dem Live-Dropdown wählen oder 8-stellige Sound-ID tippen (Companion-Variablen gehen)",[26,115,116,119],{},[29,117,118],{},"Stop Sound"," — einen spielenden Sound per ID stoppen",[26,121,122,125],{},[29,123,124],{},"Stop All"," — alle spielenden Sounds stoppen",[14,127,128],{},"Sound-ID in SoundNinja über das Button-Kontextmenü oder den Mehrfachauswahl-Chip kopieren.",[18,130,132],{"id":131},"feedbacks-und-variablen","Feedbacks und Variablen",[106,134,135,141,154,160],{},[26,136,137,140],{},[29,138,139],{},"Sound Playing"," — wahr, solange diese Sound-ID aktiv ist (für Button-Farbe)",[26,142,143,146,147,150,151],{},[44,144,145],{},"$(soundninja:connected)"," — ",[44,148,149],{},"true"," \u002F ",[44,152,153],{},"false",[26,155,156,159],{},[44,157,158],{},"$(soundninja:playing_count)"," — wie viele Sounds spielen",[26,161,162,165],{},[44,163,164],{},"$(soundninja:last_triggered)"," — zuletzt ausgelöste Sound-ID",[18,167,169],{"id":168},"http-api-fortgeschritten","HTTP-API (fortgeschritten)",[14,171,172,173],{},"Basispfad: ",[44,174,175],{},"\u002Fapi\u002Fv1",[106,177,178,184,190,196,206,212,221],{},[26,179,180,183],{},[44,181,182],{},"GET \u002Finfo"," — App-Name, Version, Protokoll, ob ein Token nötig ist",[26,185,186,189],{},[44,187,188],{},"GET \u002Fsounds"," — Soundliste (id, name, tabs, active)",[26,191,192,195],{},[44,193,194],{},"GET \u002Fstate"," — Sounds plus gerade spielende IDs",[26,197,198,201,202,205],{},[44,199,200],{},"POST \u002Ftrigger"," mit ",[44,203,204],{},"{ \"id\" }"," — Sound abspielen",[26,207,208,211],{},[44,209,210],{},"GET \u002Ftrigger\u002F:id"," — abspielen (einfach im Browser testen)",[26,213,214,217,218,220],{},[44,215,216],{},"POST \u002Fstop"," mit optionalem ",[44,219,204],{}," — einen Sound oder alle stoppen",[26,222,223,226],{},[44,224,225],{},"GET \u002Fws"," — Live-Status; Trigger\u002FStop eingehend senden",{"title":228,"searchDepth":229,"depth":229,"links":230},"",2,[231,232,233,234,235],{"id":20,"depth":229,"text":21},{"id":62,"depth":229,"text":63},{"id":103,"depth":229,"text":104},{"id":131,"depth":229,"text":132},{"id":168,"depth":229,"text":169},"SoundNinja über das lokale Netz mit Bitfocus Companion auslösen.","md",{},true,7,"\u002Fremote-control",{"title":5,"description":236},"remote-control","pzsqq4CZS4ZlSf2WDcYK0UyO02dUISTU454C3gbbJFw",[246,374,595,740,1140,1273,1420,1566],{"id":247,"title":248,"body":249,"description":367,"extension":237,"meta":368,"navigation":239,"order":369,"path":370,"seo":371,"stem":372,"__hash__":373},"content_de\u002Foverview.md","Überblick",{"type":7,"value":250,"toc":361},[251,254,257,260,263,267,281,285,324,328,337,341],[10,252,248],{"id":253},"überblick",[14,255,256],{},"SoundNinja ist ein Open-Source-Soundboard für Livestreams, Chats mit Freunden und Podcast-Aufnahmen. Es läuft auf Tauri v2 und Nuxt 4 und bleibt dabei sparsam mit RAM und Speicherplatz.",[14,258,259],{},"Das Ziel: eine große Sound-Bibliothek schnell scannen und den richtigen Clip in Millisekunden abspielen. Die Oberfläche eignet sich auch als Dashboard in VR.",[14,261,262],{},"SoundNinja steckt noch in der frühen Entwicklung. Funktionen laufen, aber nicht jede Plattform ist vollständig getestet.",[18,264,266],{"id":265},"für-wen","Für wen",[106,268,269,272,275,278],{},[26,270,271],{},"Streamer, die sofortige Sound-Cues brauchen",[26,273,274],{},"Freunde, die ein gemeinsames Board für Voice-Chat wollen",[26,276,277],{},"Podcaster, die Clips aufnehmen und aufs Board legen",[26,279,280],{},"Alle, die ein anpassbares, lokales Soundboard wollen",[18,282,284],{"id":283},"was-du-tun-kannst","Was du tun kannst",[106,286,287,290,293,296,299,302,305,308,311,318,321],{},[26,288,289],{},"Ein Soundboard aus eigenen Audiodateien bauen",[26,291,292],{},"Sounds in farbigen Tabs, Gruppen, Tags und über die Suche sortieren",[26,294,295],{},"Nach Tags filtern (ODER) und nach Name, Datum, Dauer oder Größe sortieren",[26,297,298],{},"Mehrfachauswahl mit Rahmen oder Shift-Bereich, dann Farbe, Tab oder Löschen in einem Rutsch",[26,300,301],{},"Lautstärke pro Sound im Kontextmenü setzen",[26,303,304],{},"Das Aussehen mit dem Theme Creator gestalten",[26,306,307],{},"PC-Audio oder Mikrofon im Record Editor aufnehmen",[26,309,310],{},"Hotkeys einzelnen Sounds zuweisen",[26,312,313,314,317],{},"Sounds über ",[69,315,63],{"href":316},"\u002Fdocs\u002Fremote-control"," auslösen",[26,319,320],{},"Ein komplettes Soundboard importieren und exportieren",[26,322,323],{},"GIFs oder Bilder auf Sound-Buttons legen — aus lokaler Ordnerbibliothek oder KLIPY",[18,325,327],{"id":326},"lizenz","Lizenz",[14,329,330,331,336],{},"SoundNinja ist freie Software unter ",[69,332,335],{"href":333,"rel":334},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fblob\u002Fmain\u002FLICENSE",[73],"GPL-3.0",". Forken, ändern, teilen.",[18,338,340],{"id":339},"nächste-schritte","Nächste Schritte",[23,342,343,349,355],{},[26,344,345],{},[69,346,348],{"href":347},"\u002Fdocs\u002Finstallation","SoundNinja installieren",[26,350,351],{},[69,352,354],{"href":353},"\u002Fdocs\u002Fadding-sounds","Sounds hinzufügen",[26,356,357],{},[69,358,360],{"href":359},"\u002Fdocs\u002Forganizing-sounds","Board organisieren",{"title":228,"searchDepth":229,"depth":229,"links":362},[363,364,365,366],{"id":265,"depth":229,"text":266},{"id":283,"depth":229,"text":284},{"id":326,"depth":229,"text":327},{"id":339,"depth":229,"text":340},"Was SoundNinja ist und was du damit machen kannst.",{},1,"\u002Foverview",{"title":248,"description":367},"overview","hoyfMBw8UK5RuLBAbdnmSxP4gC163p8E8rvJgSihSXE",{"id":375,"title":376,"body":377,"description":590,"extension":237,"meta":591,"navigation":239,"order":229,"path":592,"seo":593,"stem":381,"__hash__":594},"content_de\u002Finstallation.md","Installation",{"type":7,"value":378,"toc":583},[379,382,396,400,421,424,428,442,445,449,473,484,488,495,499,513,543,558,579],[10,380,376],{"id":381},"installation",[14,383,384,385,389,390,395],{},"Hol dir einen Build von der ",[69,386,388],{"href":387},"\u002Fdownload","Download-Seite"," oder von ",[69,391,394],{"href":392,"rel":393},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Freleases\u002Flatest",[73],"GitHub Releases",". SoundNinja ist in früher Entwicklung — behandle Builds als Beta.",[18,397,399],{"id":398},"windows","Windows",[106,401,402,412,415,418],{},[26,403,404,407,408,411],{},[29,405,406],{},"Installer (.exe)"," oder ",[29,409,410],{},"MSI (.msi)"," für 64-Bit-Windows",[26,413,414],{},"Landing-Page-Ziel: Windows 10 und neuer",[26,416,417],{},"Die App-README nennt auch Windows 8 und höher",[26,419,420],{},"Der NSIS-Installer ist dunkel. Sprache beim Setup wählen — SoundNinja merkt sie beim nächsten Start.",[14,422,423],{},"Installer starten, dann SoundNinja über das Startmenü öffnen.",[18,425,427],{"id":426},"macos","macOS",[106,429,430,436,439],{},[26,431,432,435],{},[29,433,434],{},"Universelles .dmg"," für Apple Silicon und Intel",[26,437,438],{},"Landing-Page-Ziel: macOS 10.14 und neuer",[26,440,441],{},"Die App-README nennt macOS 10.15 und höher",[14,443,444],{},"Disk-Image öffnen und SoundNinja nach Programme ziehen.",[18,446,448],{"id":447},"linux","Linux",[106,450,451,457,463,470],{},[26,452,453,456],{},[29,454,455],{},"Debian (.deb)"," für Ubuntu \u002F Debian",[26,458,459,462],{},[29,460,461],{},"AppImage"," für andere Distros",[26,464,465,466,469],{},"Nach Veröffentlichung einer Release können Arch-Nutzer ",[44,467,468],{},"soundninja-bin"," aus dem AUR installieren",[26,471,472],{},"Getestet unter Ubuntu 20.04",[14,474,475,476,479,480,483],{},"Desktop-Builds brauchen WebKit- und GTK-Pakete. Unter Debian\u002FUbuntu meist ",[44,477,478],{},"libwebkit2gtk",", ",[44,481,482],{},"libgtk-3-0"," und eine App-Indicator-Bibliothek.",[18,485,487],{"id":486},"updates","Updates",[14,489,490,491,494],{},"In der App: ",[29,492,493],{},"Hilfe → Nach Updates suchen",". Optional prüft SoundNinja beim Start in den Einstellungen.",[18,496,498],{"id":497},"aus-dem-quellcode-bauen","Aus dem Quellcode bauen",[14,500,501,502,479,507,512],{},"Eigenen Build? ",[69,503,506],{"href":504,"rel":505},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja",[73],"Repo klonen",[69,508,511],{"href":509,"rel":510},"https:\u002F\u002Fv2.tauri.app\u002Fstart\u002Fprerequisites\u002F",[73],"Tauri-Voraussetzungen"," installieren, dann:",[514,515,519],"pre",{"className":516,"code":517,"language":518,"meta":228,"style":228},"language-bash shiki shiki-themes github-light github-dark","bun install\nbun run tauri:serve\n","bash",[44,520,521,533],{"__ignoreMap":228},[522,523,525,529],"span",{"class":524,"line":369},"line",[522,526,528],{"class":527},"sScJk","bun",[522,530,532],{"class":531},"sZZnC"," install\n",[522,534,535,537,540],{"class":524,"line":229},[522,536,528],{"class":527},[522,538,539],{"class":531}," run",[522,541,542],{"class":531}," tauri:serve\n",[14,544,545,479,548,407,551,554,555,39],{},[44,546,547],{},"npm",[44,549,550],{},"pnpm",[44,552,553],{},"deno"," gehen auch. Produktionsbuild: ",[44,556,557],{},"bun run tauri:build",[14,559,560,563,564,569,570,573,574,39],{},[29,561,562],{},"Nur Windows:"," jeder Windows-Compile enthält ASIO über das ",[69,565,568],{"href":566,"rel":567},"https:\u002F\u002Fwww.steinberg.net\u002Fasiosdk",[73],"Steinberg ASIO SDK",". Einmal ",[44,571,572],{},"bun run setup:asio"," (SDK nicht im Git). Linux und macOS nutzen PipeWire \u002F Core Audio — diesen Schritt überspringen. Details: ",[69,575,578],{"href":576,"rel":577},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fblob\u002Fmain\u002Fdocs\u002Fbuild-from-source.md",[73],"build-from-source.md",[580,581,582],"style",{},"html pre.shiki code .sScJk, html code.shiki .sScJk{--shiki-default:#6F42C1;--shiki-dark:#B392F0}html pre.shiki code .sZZnC, html code.shiki .sZZnC{--shiki-default:#032F62;--shiki-dark:#9ECBFF}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html.dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}",{"title":228,"searchDepth":229,"depth":229,"links":584},[585,586,587,588,589],{"id":398,"depth":229,"text":399},{"id":426,"depth":229,"text":427},{"id":447,"depth":229,"text":448},{"id":486,"depth":229,"text":487},{"id":497,"depth":229,"text":498},"SoundNinja unter Windows, macOS oder Linux installieren.",{},"\u002Finstallation",{"title":376,"description":590},"OPh-0WbR2ebU9niw-poNeR6zaGWqUJm2ONgxhb61JBU",{"id":596,"title":354,"body":597,"description":733,"extension":237,"meta":734,"navigation":239,"order":735,"path":736,"seo":737,"stem":738,"__hash__":739},"content_de\u002Fadding-sounds.md",{"type":7,"value":598,"toc":725},[599,602,605,609,626,630,661,665,684,688,701,704,708,715,719],[10,600,354],{"id":601},"sounds-hinzufügen",[14,603,604],{},"Ein Board bleibt leer, bis du Clips hinzufügst. SoundNinja importiert Dateien, ganze Ordner, eine Aufnahme oder ein geteiltes Soundboard-Paket.",[18,606,608],{"id":607},"audiodateien-importieren","Audiodateien importieren",[23,610,611,620,623],{},[26,612,613,407,616,619],{},[29,614,615],{},"Datei → Audiodateien importieren",[29,617,618],{},"Import"," in der Navbar.",[26,621,622],{},"Eine oder mehrere Audiodateien wählen.",[26,624,625],{},"Sounds landen im aktuellen Tab.",[18,627,629],{"id":628},"ordner-importieren","Ordner importieren",[23,631,632,641,644],{},[26,633,634,637,638,640],{},[29,635,636],{},"Datei → Ordner importieren"," (oder ",[29,639,629],{}," in der Navbar).",[26,642,643],{},"Einen oder mehrere Ordner hinzufügen. Vor dem Import per Drag neu sortieren.",[26,645,646,647],{},"Ziel wählen:\n",[106,648,649,655],{},[26,650,651,654],{},[29,652,653],{},"Als Tabs importieren"," — jeder Ordner wird ein eigener Tab",[26,656,657,660],{},[29,658,659],{},"In aktuellen Tab importieren"," — alle Dateien landen im aktiven Tab",[18,662,664],{"id":663},"clip-aufnehmen","Clip aufnehmen",[14,666,667,668,672,673,676,677,407,680,683],{},"Öffne den ",[69,669,671],{"href":670},"\u002Fdocs\u002Frecording-editor","Record Editor"," über ",[29,674,675],{},"Aufnahme"," in der Player-Leiste. Aufnehmen, zuschneiden, dann ",[29,678,679],{},"Auswahl importieren",[29,681,682],{},"Alle importieren"," in den aktuellen Tab oder einen gewählten Tab.",[18,685,687],{"id":686},"soundboard-importieren","Soundboard importieren",[14,689,690,693,694,201,697,700],{},[29,691,692],{},"Datei → Soundboard importieren"," lädt ein geteiltes Paket. Pakete sind ein ",[44,695,696],{},".zip",[44,698,699],{},"project.sninja"," plus Sounddateien. Danach Projekt öffnen und abspielen.",[14,702,703],{},"Du kannst mehrere Projekte (Profile) halten. Über den Projektwähler zwischen Boards wechseln.",[18,705,707],{"id":706},"fehlende-dateien-neu-verknüpfen","Fehlende Dateien neu verknüpfen",[14,709,710,711,714],{},"Wenn Audiodateien auf der Festplatte umziehen, zeigt SoundNinja ",[29,712,713],{},"Fehlende Sounddateien",". Einen Suchordner wählen und Clips neu verknüpfen.",[18,716,718],{"id":717},"weiter","Weiter",[14,720,721,722,39],{},"Tabs, Tags, Filter und Hotkeys: ",[69,723,724],{"href":359},"Sounds organisieren",{"title":228,"searchDepth":229,"depth":229,"links":726},[727,728,729,730,731,732],{"id":607,"depth":229,"text":608},{"id":628,"depth":229,"text":629},{"id":663,"depth":229,"text":664},{"id":686,"depth":229,"text":687},{"id":706,"depth":229,"text":707},{"id":717,"depth":229,"text":718},"Audio, Ordner, Aufnahmen und geteilte Soundboards importieren.",{},3,"\u002Fadding-sounds",{"title":354,"description":733},"adding-sounds","H_ls9_vOwDkgTWPkfe9bQz1A0XidUOmMFV4V2EJpYec",{"id":741,"title":724,"body":742,"description":1133,"extension":237,"meta":1134,"navigation":239,"order":1135,"path":1136,"seo":1137,"stem":1138,"__hash__":1139},"content_de\u002Forganizing-sounds.md",{"type":7,"value":743,"toc":1118},[744,747,754,758,784,791,795,798,812,819,825,829,839,844,875,879,885,889,923,929,933,936,962,965,969,982,986,991,1011,1027,1034,1038,1049,1052,1056,1063,1073,1079,1083,1091,1098,1115],[10,745,724],{"id":746},"sounds-organisieren",[14,748,749,750,753],{},"SoundNinja ist für große Bibliotheken gebaut. ",[29,751,752],{},"Tags und Filter",", Tabs, Suche, Mehrfachauswahl und Hotkeys — der Clip ist einen Klick (oder eine Taste) entfernt.",[18,755,757],{"id":756},"tabs","Tabs",[106,759,760,767,774],{},[26,761,762,763,766],{},"Tab mit ",[29,764,765],{},"Tab hinzufügen"," anlegen. Farbe vergeben, damit die Leiste schnell scannbar bleibt.",[26,768,769,770,773],{},"Die Ansicht ",[29,771,772],{},"Alle"," zeigt jeden Sound über alle Tabs.",[26,775,776,777,780,781,39],{},"Ein Sound kann ",[29,778,779],{},"einem oder mehreren Tabs"," gehören. Rechtsklick → ",[29,782,783],{},"Zu Tab verschieben",[14,785,786,787,790],{},"Tab-Übergänge: ",[29,788,789],{},"Einstellungen → Allgemein"," — Slide, Fade, Buttons nacheinander oder Keine.",[18,792,794],{"id":793},"gruppen","Gruppen",[14,796,797],{},"Seit v0.5.3 können Trenner zu benannten Gruppen werden:",[106,799,800,803,806,809],{},[26,801,802],{},"Gruppe über das Kontextmenü hinzufügen, umbenennen oder entfernen",[26,804,805],{},"Gruppenkopf ziehen — Kinder kommen mit",[26,807,808],{},"Sounds in eine Gruppe legen oder herausnehmen",[26,810,811],{},"Rahmenfarbe, Namensfarbe und Button-Ausrichtung setzen (oder Tab-Standard nutzen)",[14,813,814,815,818],{},"Ein einfacher ",[29,816,817],{},"Trenner"," geht weiter, wenn du nur einen visuellen Bruch brauchst.",[14,820,821,822,39],{},"Rechtsklick auf leeren Board-Bereich: ",[29,823,824],{},"Gruppe hinzufügen",[18,826,828],{"id":827},"tags-filter","Tags \u002F Filter",[14,830,831,832,835,836,838],{},"Tags gelten tabübergreifend. Das ausfahrbare ",[29,833,834],{},"Filter","-Panel (Sidebar ",[29,837,834],{},") ist der Ort zum Anlegen und zum Filtern des Boards.",[840,841,843],"h3",{"id":842},"tags-anlegen-und-bearbeiten","Tags anlegen und bearbeiten",[23,845,846,851,862,868],{},[26,847,848,850],{},[29,849,834],{}," in der Sidebar öffnen.",[26,852,853,854,857,858,861],{},"Unter ",[29,855,856],{},"Tags"," → ",[29,859,860],{},"Tag hinzufügen"," — Name und Farbe vergeben.",[26,863,864,865,39],{},"Im selben Panel umbenennen, umfärben oder ",[29,866,867],{},"Tag löschen",[26,869,870,871,874],{},"Steht da ",[29,872,873],{},"Noch keine Tags",", zuerst hier einen anlegen, bevor du zuweist.",[840,876,878],{"id":877},"tags-an-sounds-hängen","Tags an Sounds hängen",[14,880,881,882,884],{},"Rechtsklick auf einen Sound → ",[29,883,856],{}," (Checkboxen). Ein Sound darf mehrere Tags haben. Existieren noch keine, zeigt das Menü den Weg zum Filter-Panel.",[840,886,888],{"id":887},"board-filtern","Board filtern",[106,890,891,898,909,920],{},[26,892,893,894,897],{},"Tags im Filter-Panel oder als ",[29,895,896],{},"Chips unter der Suchleiste"," umschalten.",[26,899,900,901,904,905,908],{},"Abgleich ist ",[29,902,903],{},"ODER",": ein Sound bleibt sichtbar, wenn er ",[29,906,907],{},"irgendeinen"," gewählten Tag hat.",[26,910,911,912,915,916,919],{},"Das Feld ",[29,913,914],{},"Suche"," in der Navbar kombiniert per ",[29,917,918],{},"UND"," mit dem aktiven Tag-Filter (Tippen + Tags zusammen).",[26,921,922],{},"Chips aus (oder Filter leeren), um den ganzen Tab wieder zu sehen.",[14,924,925,926,39],{},"Farbige Tag-Namen können auf Buttons erscheinen. Schalter: ",[29,927,928],{},"Einstellungen → Verhalten → Tag-Badges anzeigen",[18,930,932],{"id":931},"sortierung","Sortierung",[14,934,935],{},"Im Filter-Panel eine Sortierung wählen:",[106,937,938,944],{},[26,939,940,943],{},[29,941,942],{},"Benutzerdefiniert"," — deine Tab-Reihenfolge, Gruppen sichtbar",[26,945,946,479,949,479,952,407,955,958,959],{},[29,947,948],{},"Name",[29,950,951],{},"Hinzugefügt",[29,953,954],{},"Spielzeit",[29,956,957],{},"Dateigröße"," — flache sortierte Liste; ",[29,960,961],{},"Gruppen sind ausgeblendet",[14,963,964],{},"Sortierung nach Dauer kann beim ersten Mal die Dauer-Metadaten vorwärmen.",[18,966,968],{"id":967},"neu-anordnen","Neu anordnen",[14,970,971,972,975,976,979,980,39],{},"Drag-and-Drop in ",[29,973,974],{},"Einstellungen → Verhalten"," einschalten (",[29,977,978],{},"Neu anordnen erlauben","). Dann Sounds und Gruppen ziehen. Neu anordnen gilt bei ",[29,981,942],{},[18,983,985],{"id":984},"mehrfachauswahl","Mehrfachauswahl",[14,987,988,990],{},[29,989,985],{}," in der Navbar einschalten, dann:",[106,992,993,996,1002,1008],{},[26,994,995],{},"Klick toggelt einen Sound",[26,997,998,1001],{},[29,999,1000],{},"Shift+Klick"," wählt einen Bereich ab dem letzten Anker",[26,1003,1004,1007],{},[29,1005,1006],{},"Rahmen"," auf leerem Board ziehen",[26,1009,1010],{},"Klick auf leeres Board (oder außerhalb) leert die Auswahl",[14,1012,1013,1014,479,1017,479,1020,1023,1024,39],{},"Eine Sammelleiste zeigt die Anzahl plus ",[29,1015,1016],{},"Farbe",[29,1018,1019],{},"Zu Tab verschieben…",[29,1021,1022],{},"Löschen"," und ",[29,1025,1026],{},"Fertig",[14,1028,1029,1030,1033],{},"In der Mehrfachauswahl zeigt jeder Button einen ",[29,1031,1032],{},"8-Zeichen-ID-Chip",". Rechtsklick auf den Chip kopiert die ID.",[18,1035,1037],{"id":1036},"lautstärke-pro-sound","Lautstärke pro Sound",[14,1039,1040,1041,1044,1045,1048],{},"Rechtsklick → ",[29,1042,1043],{},"Lautstärke",". Slider von 0 % bis 100 %. ",[29,1046,1047],{},"Doppelklick"," setzt auf 100 % zurück.",[14,1050,1051],{},"Das stapelt sich mit der Master-Ausgangslautstärke in den Einstellungen.",[18,1053,1055],{"id":1054},"hotkeys-und-sound-ids","Hotkeys und Sound-IDs",[14,1057,1058,1059,1062],{},"Jeder Sound hat eine 8-stellige ID. Kopieren über das Button-Kontextmenü (",[29,1060,1061],{},"ID kopieren",") oder den Mehrfachauswahl-Chip.",[14,1064,1065,1068,1069,1072],{},[29,1066,1067],{},"Einstellungen → Hotkeys",": Taste an eine Sound-ID binden. Globale Hotkeys sind optional. ",[29,1070,1071],{},"Hotkey zuweisen"," im Kontextmenü springt dorthin, ID vorausgefüllt.",[14,1074,1075,1076,1078],{},"Dieselbe ID nutzt ",[69,1077,63],{"href":316}," zum Auslösen.",[18,1080,1082],{"id":1081},"hintergrundbilder-und-farben","Hintergrundbilder und Farben",[14,1084,1085,1086,1090],{},"Rechtsklick auf einen Sound: eigene Farben oder ein Hintergrundbild. Das ist getrennt vom ",[69,1087,1089],{"href":1088},"\u002Fdocs\u002Ftheme-editor","Theme Creator",", der das ganze Board gestaltet.",[14,1092,1093,1094,1097],{},"Der Picker ist ein Dialog ",[29,1095,1096],{},"Hintergrundbild"," (PNG, JPEG, GIF, WebP):",[106,1099,1100,1106],{},[26,1101,1102,1105],{},[29,1103,1104],{},"Lokale Dateien"," — Ordner hinzufügen, einzelne Datei wählen, Dateinamen suchen, Rastervorschau, Ordner aus der Bibliothek entfernen",[26,1107,1108,1111,1112,1114],{},[29,1109,1110],{},"KLIPY"," — GIFs online suchen. Eigenen API-Key unter ",[29,1113,974],{},". Der Key landet nicht in Projektdateien.",[14,1116,1117],{},"Nach der Wahl Bild auf dem Button schieben und zuschneiden.",{"title":228,"searchDepth":229,"depth":229,"links":1119},[1120,1121,1122,1127,1128,1129,1130,1131,1132],{"id":756,"depth":229,"text":757},{"id":793,"depth":229,"text":794},{"id":827,"depth":229,"text":828,"children":1123},[1124,1125,1126],{"id":842,"depth":735,"text":843},{"id":877,"depth":735,"text":878},{"id":887,"depth":735,"text":888},{"id":931,"depth":229,"text":932},{"id":967,"depth":229,"text":968},{"id":984,"depth":229,"text":985},{"id":1036,"depth":229,"text":1037},{"id":1054,"depth":229,"text":1055},{"id":1081,"depth":229,"text":1082},"Tags, Filter, Tabs, Gruppen, Sortierung, Mehrfachauswahl, Lautstärke und Hotkeys.",{},4,"\u002Forganizing-sounds",{"title":724,"description":1133},"organizing-sounds","phia_N7HDS6LIgxhltoa9iRYViBzJ00ngFayO7YKdtQ",{"id":1141,"title":1142,"body":1143,"description":1267,"extension":237,"meta":1268,"navigation":239,"order":1269,"path":1270,"seo":1271,"stem":1147,"__hash__":1272},"content_de\u002Ftheme-editor.md","Theme-Editor",{"type":7,"value":1144,"toc":1261},[1145,1148,1154,1158,1184,1187,1191,1205,1209,1235,1238,1242,1247],[10,1146,1142],{"id":1147},"theme-editor",[14,1149,1150,1151,39],{},"Der Theme Creator ist der volle visuelle Editor für dein Board. Öffnen über ",[29,1152,1153],{},"Einstellungen → Allgemein → Theme Creator",[18,1155,1157],{"id":1156},"drei-tabs","Drei Tabs",[23,1159,1160,1173,1179],{},[26,1161,1162,1165,1166,150,1169,1172],{},[29,1163,1164],{},"Allgemein"," — Theme-Name, gemeinsame Farben und Schrift-Uploads (",[44,1167,1168],{},".ttf",[44,1170,1171],{},".otf",")",[26,1174,1175,1178],{},[29,1176,1177],{},"Buttons"," — Farben, Typo, Layout und GIF-Overlay der Sound-Buttons",[26,1180,1181,1183],{},[29,1182,757],{}," — Farben, Typo und Rahmenstärke der Tab-Leiste",[14,1185,1186],{},"Eine Live-Vorschau zeigt Tabs und Buttons beim Bearbeiten.",[18,1188,1190],{"id":1189},"was-du-ändern-kannst","Was du ändern kannst",[106,1192,1193,1196,1199,1202],{},[26,1194,1195],{},"Primär- und Akzentfarben, Hintergründe, Button- und Tab-Farben",[26,1197,1198],{},"Schriftfamilie und -größe für Buttons und Tabs",[26,1200,1201],{},"Button-Breite, Radius, Rahmen, Abstände und Innenabstand",[26,1203,1204],{},"GIF-Overlay-Deckkraft (normal und Hover)",[18,1206,1208],{"id":1207},"speichern-und-teilen","Speichern und teilen",[106,1210,1211,1217,1223,1229],{},[26,1212,1213,1216],{},[29,1214,1215],{},".css exportieren"," — Theme-Datei sichern oder weitergeben",[26,1218,1219,1222],{},[29,1220,1221],{},"Zu Themes hinzufügen"," — in den Themes-Ordner speichern und anwenden",[26,1224,1225,1228],{},[29,1226,1227],{},".css importieren"," — Preset oder gespeichertes Theme laden",[26,1230,1231,1234],{},[29,1232,1233],{},"Zurücksetzen"," — SoundNinja-Standard wiederherstellen",[14,1236,1237],{},"Beim Schließen mit ungespeicherten Änderungen fragt SoundNinja nach.",[18,1239,1241],{"id":1240},"ohne-vollen-editor","Ohne vollen Editor",[14,1243,853,1244,1246],{},[29,1245,789],{}," kannst du trotzdem:",[106,1248,1249,1252,1258],{},[26,1250,1251],{},"Ein Theme aus der Liste wählen",[26,1253,1254,1255,1172],{},"CSS-Variablen live bearbeiten (",[29,1256,1257],{},"Eigenes CSS",[26,1259,1260],{},"Eine Theme-Datei in den Themes-Ordner importieren",{"title":228,"searchDepth":229,"depth":229,"links":1262},[1263,1264,1265,1266],{"id":1156,"depth":229,"text":1157},{"id":1189,"depth":229,"text":1190},{"id":1207,"depth":229,"text":1208},{"id":1240,"depth":229,"text":1241},"Farben, Schriften, Buttons und Tabs im Theme Creator gestalten.",{},5,"\u002Ftheme-editor",{"title":1142,"description":1267},"h6Hta3TDDcThnouY3Pk_Omvjq8Eb8knx-HIAvf5YZd8",{"id":1274,"title":1275,"body":1276,"description":1413,"extension":237,"meta":1414,"navigation":239,"order":1415,"path":1416,"seo":1417,"stem":1418,"__hash__":1419},"content_de\u002Frecording-editor.md","Aufnahme-Editor",{"type":7,"value":1277,"toc":1407},[1278,1281,1287,1291,1297,1317,1320,1324,1349,1353,1368,1372,1386,1397],[10,1279,1275],{"id":1280},"aufnahme-editor",[14,1282,1283,1284,1286],{},"Nimm einen Clip in SoundNinja auf, schneide ihn zu und importiere ihn in einen Tab. Öffnen über ",[29,1285,675],{}," in der Player-Leiste.",[18,1288,1290],{"id":1289},"eingang-wählen","Eingang wählen",[14,1292,853,1293,1296],{},[29,1294,1295],{},"Einstellungen → Audio",":",[106,1298,1299,1305,1311],{},[26,1300,1301,1304],{},[29,1302,1303],{},"Eingabegeräte"," — Mikrofon",[26,1306,1307,1310],{},[29,1308,1309],{},"Ausgabegeräte (PC-Audio)"," — Loopback dessen, was der PC spielt",[26,1312,1313,1316],{},[29,1314,1315],{},"Eingangslautstärke"," — Aufnahme-Gain von 0 % bis 200 %",[14,1318,1319],{},"Der Aufnahme-Button nutzt das hier gewählte Gerät.",[18,1321,1323],{"id":1322},"take-bearbeiten","Take bearbeiten",[106,1325,1326,1329,1332,1340,1343,1346],{},[26,1327,1328],{},"Aufnehmen und stoppen",[26,1330,1331],{},"Pegelmesser beobachten",[26,1333,1334,407,1337],{},[29,1335,1336],{},"Normalisieren",[29,1338,1339],{},"Rauschunterdrückung",[26,1341,1342],{},"Ganzen Clip trimmen, auf Auswahl trimmen oder Auswahl löschen",[26,1344,1345],{},"Rückgängig \u002F Wiederholen",[26,1347,1348],{},"Rein- und rauszoomen",[18,1350,1352],{"id":1351},"stagen-und-importieren","Stagen und importieren",[23,1354,1355,1358,1361],{},[26,1356,1357],{},"Auswahl oder ganzen Track zur Staging-Liste hinzufügen.",[26,1359,1360],{},"Die Liste startet leer: aufnehmen, bearbeiten, dann Clip hinzufügen.",[26,1362,1363,407,1365,1367],{},[29,1364,679],{},[29,1366,682],{}," in den aktuellen oder einen gewählten Tab.",[18,1369,1371],{"id":1370},"stem-trennung-optional","Stem-Trennung (optional)",[14,1373,1374,1375,1378,1379,407,1382,1385],{},"Offizielle Windows-, macOS- und Linux-Release-Builds enthalten das ",[29,1376,1377],{},"Stems","-Feature. Der Aufnahme-Editor kann ",[29,1380,1381],{},"Gesang",[29,1383,1384],{},"Musik"," mit BS-RoFormer behalten.",[14,1387,1388,1389,1392,1393,1396],{},"Das Modell ist etwa 158 MB und ",[29,1390,1391],{},"nicht"," im Installer. Download unter ",[29,1394,1395],{},"Einstellungen → Stem-Trennung"," oder über den Erststart-Hinweis. Der Windows-Installer kann den Download beim ersten Start anbieten.",[14,1398,1399,1400,150,1403,1406],{},"Eigene Source-Builds brauchen extra Flags (",[44,1401,1402],{},"tauri:serve:stems",[44,1404,1405