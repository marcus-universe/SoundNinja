[{"data":1,"prerenderedAt":1673},["ShallowReactive",2],{"docs-page-de-\u002Fremote-control":3,"docs-nav-de":245},{"id":4,"title":5,"body":6,"description":236,"extension":237,"meta":238,"navigation":239,"order":240,"path":241,"seo":242,"stem":243,"__hash__":244},"content_de\u002Fremote-control.md","Fernsteuerung",{"type":7,"value":8,"toc":227},"minimark",[9,13,17,22,57,60,64,101,105,126,129,133,166,170,176],[10,11,5],"h1",{"id":12},"fernsteuerung",[14,15,16],"p",{},"SoundNinja kann im lokalen Netz lauschen, damit Bitfocus Companion (oder jeder HTTP\u002FWebSocket-Client) Sounds spielt und stoppt.",[18,19,21],"h2",{"id":20},"remote-server-einschalten","Remote-Server einschalten",[23,24,25,33,40,47],"ol",{},[26,27,28,32],"li",{},[29,30,31],"strong",{},"Einstellungen → Remote"," öffnen.",[26,34,35,36,39],{},"Remote-Server aktivieren. Standardport ist ",[29,37,38],{},"7331",".",[26,41,42,43,39],{},"Optional: Token setzen. Clients senden ihn als Bearer-Token oder ",[44,45,46],"code",{},"?token=",[26,48,49,52,53,56],{},[44,50,51],{},"http:\u002F\u002FIP:PORT"," kopieren oder die System-IP unter ",[29,54,55],{},"Einstellungen → Über"," holen.",[14,58,59],{},"Windows kann beim ersten Start eine Firewall-Abfrage zeigen. Zugriff im privaten Netz erlauben.",[18,61,63],{"id":62},"bitfocus-companion","Bitfocus Companion",[23,65,66,75,83,94],{},[26,67,68,74],{},[69,70,63],"a",{"href":71,"rel":72},"https:\u002F\u002Fbitfocus.io\u002Fcompanion",[73],"nofollow"," installieren.",[26,76,77,82],{},[69,78,81],{"href":79,"rel":80},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002Fcompanion-module-soundninja\u002Freleases\u002Flatest",[73],"SoundNinja-Companion.tgz"," herunterladen. Es gibt noch kein Companion-Store-Paket.",[26,84,85,86,89,90,93],{},"In Companion: ",[29,87,88],{},"Modules → Load module package"," und die ",[44,91,92],{},".tgz"," wählen.",[26,95,96,97,100],{},"Eine ",[29,98,99],{},"Sound Ninja","-Verbindung anlegen. PC-IP, Port und Token eintragen.",[18,102,104],{"id":103},"aktionen","Aktionen",[106,107,108,114,120],"ul",{},[26,109,110,113],{},[29,111,112],{},"Trigger Sound"," — aus dem Live-Dropdown wählen oder 8-stellige Sound-ID tippen (Companion-Variablen gehen)",[26,115,116,119],{},[29,117,118],{},"Stop Sound"," — einen spielenden Sound per ID stoppen",[26,121,122,125],{},[29,123,124],{},"Stop All"," — alle spielenden Sounds stoppen",[14,127,128],{},"Sound-ID in SoundNinja über das Button-Kontextmenü oder den Mehrfachauswahl-Chip kopieren.",[18,130,132],{"id":131},"feedbacks-und-variablen","Feedbacks und Variablen",[106,134,135,141,154,160],{},[26,136,137,140],{},[29,138,139],{},"Sound Playing"," — wahr, solange diese Sound-ID aktiv ist (für Button-Farbe)",[26,142,143,146,147,150,151],{},[44,144,145],{},"$(soundninja:connected)"," — ",[44,148,149],{},"true"," \u002F ",[44,152,153],{},"false",[26,155,156,159],{},[44,157,158],{},"$(soundninja:playing_count)"," — wie viele Sounds spielen",[26,161,162,165],{},[44,163,164],{},"$(soundninja:last_triggered)"," — zuletzt ausgelöste Sound-ID",[18,167,169],{"id":168},"http-api-fortgeschritten","HTTP-API (fortgeschritten)",[14,171,172,173],{},"Basispfad: ",[44,174,175],{},"\u002Fapi\u002Fv1",[106,177,178,184,190,196,206,212,221],{},[26,179,180,183],{},[44,181,182],{},"GET \u002Finfo"," — App-Name, Version, Protokoll, ob ein Token nötig ist",[26,185,186,189],{},[44,187,188],{},"GET \u002Fsounds"," — Soundliste (id, name, tabs, active)",[26,191,192,195],{},[44,193,194],{},"GET \u002Fstate"," — Sounds plus gerade spielende IDs",[26,197,198,201,202,205],{},[44,199,200],{},"POST \u002Ftrigger"," mit ",[44,203,204],{},"{ \"id\" }"," — Sound abspielen",[26,207,208,211],{},[44,209,210],{},"GET \u002Ftrigger\u002F:id"," — abspielen (einfach im Browser testen)",[26,213,214,217,218,220],{},[44,215,216],{},"POST \u002Fstop"," mit optionalem ",[44,219,204],{}," — einen Sound oder alle stoppen",[26,222,223,226],{},[44,224,225],{},"GET \u002Fws"," — Live-Status; Trigger\u002FStop eingehend senden",{"title":228,"searchDepth":229,"depth":229,"links":230},"",2,[231,232,233,234,235],{"id":20,"depth":229,"text":21},{"id":62,"depth":229,"text":63},{"id":103,"depth":229,"text":104},{"id":131,"depth":229,"text":132},{"id":168,"depth":229,"text":169},"SoundNinja über das lokale Netz mit Bitfocus Companion auslösen.","md",{},true,7,"\u002Fremote-control",{"title":5,"description":236},"remote-control","pzsqq4CZS4ZlSf2WDcYK0UyO02dUISTU454C3gbbJFw",[246,374,595,740,1150,1283,1430,1576],{"id":247,"title":248,"body":249,"description":367,"extension":237,"meta":368,"navigation":239,"order":369,"path":370,"seo":371,"stem":372,"__hash__":373},"content_de\u002Foverview.md","Überblick",{"type":7,"value":250,"toc":361},[251,254,257,260,263,267,281,285,324,328,337,341],[10,252,248],{"id":253},"überblick",[14,255,256],{},"SoundNinja ist ein Open-Source-Soundboard für Livestreams, Chats mit Freunden und Podcast-Aufnahmen. Es läuft auf Tauri v2 und Nuxt 4 und bleibt dabei sparsam mit RAM und Speicherplatz.",[14,258,259],{},"Das Ziel: eine große Sound-Bibliothek schnell scannen und den richtigen Clip in Millisekunden abspielen. Die Oberfläche eignet sich auch als Dashboard in VR.",[14,261,262],{},"SoundNinja steckt noch in der frühen Entwicklung. Funktionen laufen, aber nicht jede Plattform ist vollständig getestet.",[18,264,266],{"id":265},"für-wen","Für wen",[106,268,269,272,275,278],{},[26,270,271],{},"Streamer, die sofortige Sound-Cues brauchen",[26,273,274],{},"Freunde, die ein gemeinsames Board für Voice-Chat wollen",[26,276,277],{},"Podcaster, die Clips aufnehmen und aufs Board legen",[26,279,280],{},"Alle, die ein anpassbares, lokales Soundboard wollen",[18,282,284],{"id":283},"was-du-tun-kannst","Was du tun kannst",[106,286,287,290,293,296,299,302,305,308,311,318,321],{},[26,288,289],{},"Ein Soundboard aus eigenen Audiodateien bauen",[26,291,292],{},"Sounds in farbigen Tabs, Gruppen, Tags und über die Suche sortieren",[26,294,295],{},"Nach Tags filtern (ODER) und nach Name, Datum, Dauer oder Größe sortieren",[26,297,298],{},"Mehrfachauswahl mit Rahmen oder Shift-Bereich, dann Farbe, Tab oder Löschen in einem Rutsch",[26,300,301],{},"Lautstärke pro Sound im Kontextmenü setzen",[26,303,304],{},"Das Aussehen mit dem Theme Creator gestalten",[26,306,307],{},"PC-Audio oder Mikrofon im Record Editor aufnehmen",[26,309,310],{},"Hotkeys einzelnen Sounds zuweisen",[26,312,313,314,317],{},"Sounds über ",[69,315,63],{"href":316},"\u002Fdocs\u002Fremote-control"," auslösen",[26,319,320],{},"Ein komplettes Soundboard importieren und exportieren",[26,322,323],{},"GIFs oder Bilder auf Sound-Buttons legen — aus lokaler Ordnerbibliothek, GifSnap oder KLIPY",[18,325,327],{"id":326},"lizenz","Lizenz",[14,329,330,331,336],{},"SoundNinja ist freie Software unter ",[69,332,335],{"href":333,"rel":334},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fblob\u002Fmain\u002FLICENSE",[73],"GPL-3.0",". Forken, ändern, teilen.",[18,338,340],{"id":339},"nächste-schritte","Nächste Schritte",[23,342,343,349,355],{},[26,344,345],{},[69,346,348],{"href":347},"\u002Fdocs\u002Finstallation","SoundNinja installieren",[26,350,351],{},[69,352,354],{"href":353},"\u002Fdocs\u002Fadding-sounds","Sounds hinzufügen",[26,356,357],{},[69,358,360],{"href":359},"\u002Fdocs\u002Forganizing-sounds","Board organisieren",{"title":228,"searchDepth":229,"depth":229,"links":362},[363,364,365,366],{"id":265,"depth":229,"text":266},{"id":283,"depth":229,"text":284},{"id":326,"depth":229,"text":327},{"id":339,"depth":229,"text":340},"Was SoundNinja ist und was du damit machen kannst.",{},1,"\u002Foverview",{"title":248,"description":367},"overview","NKjfErgZuRFyQOJf6ppAsKHoUKCnyQ4MYR-evnuglSg",{"id":375,"title":376,"body":377,"description":590,"extension":237,"meta":591,"navigation":239,"order":229,"path":592,"seo":593,"stem":381,"__hash__":594},"content_de\u002Finstallation.md","Installation",{"type":7,"value":378,"toc":583},[379,382,396,400,421,424,428,442,445,449,473,484,488,495,499,513,543,558,579],[10,380,376],{"id":381},"installation",[14,383,384,385,389,390,395],{},"Hol dir einen Build von der ",[69,386,388],{"href":387},"\u002Fdownload","Download-Seite"," oder von ",[69,391,394],{"href":392,"rel":393},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Freleases\u002Flatest",[73],"GitHub Releases",". SoundNinja ist in früher Entwicklung — behandle Builds als Beta.",[18,397,399],{"id":398},"windows","Windows",[106,401,402,412,415,418],{},[26,403,404,407,408,411],{},[29,405,406],{},"Installer (.exe)"," oder ",[29,409,410],{},"MSI (.msi)"," für 64-Bit-Windows",[26,413,414],{},"Landing-Page-Ziel: Windows 10 und neuer",[26,416,417],{},"Die App-README nennt auch Windows 8 und höher",[26,419,420],{},"Der NSIS-Installer ist dunkel. Sprache beim Setup wählen — SoundNinja merkt sie beim nächsten Start.",[14,422,423],{},"Installer starten, dann SoundNinja über das Startmenü öffnen.",[18,425,427],{"id":426},"macos","macOS",[106,429,430,436,439],{},[26,431,432,435],{},[29,433,434],{},"Universelles .dmg"," für Apple Silicon und Intel",[26,437,438],{},"Landing-Page-Ziel: macOS 10.14 und neuer",[26,440,441],{},"Die App-README nennt macOS 10.15 und höher",[14,443,444],{},"Disk-Image öffnen und SoundNinja nach Programme ziehen.",[18,446,448],{"id":447},"linux","Linux",[106,450,451,457,463,470],{},[26,452,453,456],{},[29,454,455],{},"Debian (.deb)"," für Ubuntu \u002F Debian",[26,458,459,462],{},[29,460,461],{},"AppImage"," für andere Distros",[26,464,465,466,469],{},"Nach Veröffentlichung einer Release können Arch-Nutzer ",[44,467,468],{},"soundninja-bin"," aus dem AUR installieren",[26,471,472],{},"Getestet unter Ubuntu 20.04",[14,474,475,476,479,480,483],{},"Desktop-Builds brauchen WebKit- und GTK-Pakete. Unter Debian\u002FUbuntu meist ",[44,477,478],{},"libwebkit2gtk",", ",[44,481,482],{},"libgtk-3-0"," und eine App-Indicator-Bibliothek.",[18,485,487],{"id":486},"updates","Updates",[14,489,490,491,494],{},"In der App: ",[29,492,493],{},"Hilfe → Nach Updates suchen",". Optional prüft SoundNinja beim Start in den Einstellungen.",[18,496,498],{"id":497},"aus-dem-quellcode-bauen","Aus dem Quellcode bauen",[14,500,501,502,479,507,512],{},"Eigenen Build? ",[69,503,506],{"href":504,"rel":505},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja",[73],"Repo klonen",[69,508,511],{"href":509,"rel":510},"https:\u002F\u002Fv2.tauri.app\u002Fstart\u002Fprerequisites\u002F",[73],"Tauri-Voraussetzungen"," installieren, dann:",[514,515,519],"pre",{"className":516,"code":517,"language":518,"meta":228,"style":228},"language-bash shiki shiki-themes github-light github-dark","bun install\nbun run tauri:serve\n","bash",[44,520,521,533],{"__ignoreMap":228},[522,523,525,529],"span",{"class":524,"line":369},"line",[522,526,528],{"class":527},"sScJk","bun",[522,530,532],{"class":531},"sZZnC"," install\n",[522,534,535,537,540],{"class":524,"line":229},[522,536,528],{"class":527},[522,538,539],{"class":531}," run",[522,541,542],{"class":531}," tauri:serve\n",[14,544,545,479,548,407,551,554,555,39],{},[44,546,547],{},"npm",[44,549,550],{},"pnpm",[44,552,553],{},"deno"," gehen auch. Produktionsbuild: ",[44,556,557],{},"bun run tauri:build",[14,559,560,563,564,569,570,573,574,39],{},[29,561,562],{},"Nur Windows:"," jeder Windows-Compile enthält ASIO über das ",[69,565,568],{"href":566,"rel":567},"https:\u002F\u002Fwww.steinberg.net\u002Fasiosdk",[73],"Steinberg ASIO SDK",". Einmal ",[44,571,572],{},"bun run setup:asio"," (SDK nicht im Git). Linux und macOS nutzen PipeWire \u002F Core Audio — diesen Schritt überspringen. Details: ",[69,575,578],{"href":576,"rel":577},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fblob\u002Fmain\u002Fdocs\u002Fbuild-from-source.md",[73],"build-from-source.md",[580,581,582],"style",{},"html pre.shiki code .sScJk, html code.shiki .sScJk{--shiki-default:#6F42C1;--shiki-dark:#B392F0}html pre.shiki code .sZZnC, html code.shiki .sZZnC{--shiki-defaul