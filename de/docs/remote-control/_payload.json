ght);text-decoration: var(--shiki-dark-text-decoration);}",{"title":232,"searchDepth":233,"depth":233,"links":555},[556,557,558,559,560],{"id":393,"depth":233,"text":394},{"id":418,"depth":233,"text":419},{"id":439,"depth":233,"text":440},{"id":478,"depth":233,"text":479},{"id":489,"depth":233,"text":490},"SoundNinja unter Windows, macOS oder Linux installieren.",{},"\u002Finstallation",{"title":371,"description":561},"Djt_phX5yPzPpgqthAHl5cQnHy-U9ban07ufeARjtGI",{"id":567,"title":349,"body":568,"description":704,"extension":241,"meta":705,"navigation":243,"order":706,"path":707,"seo":708,"stem":709,"__hash__":710},"content_de\u002Fadding-sounds.md",{"type":7,"value":569,"toc":696},[570,573,576,580,597,601,632,636,655,659,672,675,679,686,690],[10,571,349],{"id":572},"sounds-hinzufügen",[14,574,575],{},"Ein Board bleibt leer, bis du Clips hinzufügst. SoundNinja importiert Dateien, ganze Ordner, eine Aufnahme oder ein geteiltes Soundboard-Paket.",[18,577,579],{"id":578},"audiodateien-importieren","Audiodateien importieren",[23,581,582,591,594],{},[26,583,584,402,587,590],{},[29,585,586],{},"Datei → Audiodateien importieren",[29,588,589],{},"Import"," in der Navbar.",[26,592,593],{},"Eine oder mehrere Audiodateien wählen.",[26,595,596],{},"Sounds landen im aktuellen Tab.",[18,598,600],{"id":599},"ordner-importieren","Ordner importieren",[23,602,603,612,615],{},[26,604,605,608,609,611],{},[29,606,607],{},"Datei → Ordner importieren"," (oder ",[29,610,600],{}," in der Navbar).",[26,613,614],{},"Einen oder mehrere Ordner hinzufügen. Vor dem Import per Drag neu sortieren.",[26,616,617,618],{},"Ziel wählen:\n",[110,619,620,626],{},[26,621,622,625],{},[29,623,624],{},"Als Tabs importieren"," — jeder Ordner wird ein eigener Tab",[26,627,628,631],{},[29,629,630],{},"In aktuellen Tab importieren"," — alle Dateien landen im aktiven Tab",[18,633,635],{"id":634},"clip-aufnehmen","Clip aufnehmen",[14,637,638,639,643,644,647,648,402,651,654],{},"Öffne den ",[69,640,642],{"href":641},"\u002Fdocs\u002Frecording-editor","Record Editor"," über ",[29,645,646],{},"Aufnahme"," in der Player-Leiste. Aufnehmen, zuschneiden, dann ",[29,649,650],{},"Auswahl importieren",[29,652,653],{},"Alle importieren"," in den aktuellen Tab oder einen gewählten Tab.",[18,656,658],{"id":657},"soundboard-importieren","Soundboard importieren",[14,660,661,664,665,205,668,671],{},[29,662,663],{},"Datei → Soundboard importieren"," lädt ein geteiltes Paket. Pakete sind ein ",[44,666,667],{},".zip",[44,669,670],{},"project.sninja"," plus Sounddateien. Danach Projekt öffnen und abspielen.",[14,673,674],{},"Du kannst mehrere Projekte (Profile) halten. Über den Projektwähler zwischen Boards wechseln.",[18,676,678],{"id":677},"fehlende-dateien-neu-verknüpfen","Fehlende Dateien neu verknüpfen",[14,680,681,682,685],{},"Wenn Audiodateien auf der Festplatte umziehen, zeigt SoundNinja ",[29,683,684],{},"Fehlende Sounddateien",". Einen Suchordner wählen und Clips neu verknüpfen.",[18,687,689],{"id":688},"weiter","Weiter",[14,691,692,693,39],{},"Tabs, Gruppen und Hotkeys: ",[69,694,695],{"href":354},"Sounds organisieren",{"title":232,"searchDepth":233,"depth":233,"links":697},[698,699,700,701,702,703],{"id":578,"depth":233,"text":579},{"id":599,"depth":233,"text":600},{"id":634,"depth":233,"text":635},{"id":657,"depth":233,"text":658},{"id":677,"depth":233,"text":678},{"id":688,"depth":233,"text":689},"Audio, Ordner, Aufnahmen und geteilte Soundboards importieren.",{},3,"\u002Fadding-sounds",{"title":349,"description":704},"adding-sounds","qhheWryk-vrNfEsQyZSumTndjdSmJPmEctxDG9Gyulk",{"id":712,"title":695,"body":713,"description":857,"extension":241,"meta":858,"navigation":243,"order":859,"path":860,"seo":861,"stem":862,"__hash__":863},"content_de\u002Forganizing-sounds.md",{"type":7,"value":714,"toc":848},[715,718,721,725,751,758,762,765,779,786,790,795,799,810,814,817,821,824,830,836,840],[10,716,695],{"id":717},"sounds-organisieren",[14,719,720],{},"SoundNinja ist für große Bibliotheken gebaut. Tabs, Gruppen, Suche und Hotkeys — der Clip ist einen Klick (oder eine Taste) entfernt.",[18,722,724],{"id":723},"tabs","Tabs",[110,726,727,734,741],{},[26,728,729,730,733],{},"Tab mit ",[29,731,732],{},"Tab hinzufügen"," anlegen. Farbe vergeben, damit die Leiste schnell scannbar bleibt.",[26,735,736,737,740],{},"Die Ansicht ",[29,738,739],{},"Alle"," zeigt jeden Sound über alle Tabs.",[26,742,743,744,747,748,39],{},"Ein Sound kann ",[29,745,746],{},"einem oder mehreren Tabs"," gehören. Rechtsklick → ",[29,749,750],{},"Zu Tab verschieben",[14,752,753,754,757],{},"Tab-Übergänge: ",[29,755,756],{},"Einstellungen → Allgemein"," — Slide, Fade, Buttons nacheinander oder Keine.",[18,759,761],{"id":760},"gruppen","Gruppen",[14,763,764],{},"Seit v0.5.3 können Trenner zu benannten Gruppen werden:",[110,766,767,770,773,776],{},[26,768,769],{},"Gruppe über das Kontextmenü hinzufügen, umbenennen oder entfernen",[26,771,772],{},"Gruppenkopf ziehen — Kinder kommen mit",[26,774,775],{},"Sounds in eine Gruppe legen oder herausnehmen",[26,777,778],{},"Rahmenfarbe, Namensfarbe und Button-Ausrichtung setzen (oder Tab-Standard nutzen)",[14,780,781,782,785],{},"Ein einfacher ",[29,783,784],{},"Trenner"," geht weiter, wenn du nur einen visuellen Bruch brauchst.",[18,787,789],{"id":788},"suche","Suche",[14,791,792,794],{},[29,793,789],{}," in der Navbar. Ergebnisse folgen der Eingabe.",[18,796,798],{"id":797},"neu-anordnen","Neu anordnen",[14,800,801,802,805,806,809],{},"Drag-and-Drop in ",[29,803,804],{},"Einstellungen → Verhalten"," einschalten (",[29,807,808],{},"Neu anordnen erlauben","). Dann Sounds und Gruppen ziehen.",[18,811,813],{"id":812},"sammelbearbeitung","Sammelbearbeitung",[14,815,816],{},"Mehrere Sounds markieren, dann Farbe ändern, in einen Tab schieben oder löschen.",[18,818,820],{"id":819},"hotkeys-und-sound-ids","Hotkeys und Sound-IDs",[14,822,823],{},"Jeder Sound hat eine 8-stellige ID. Kopieren über das Button-Kontextmenü oder den Mehrfachauswahl-Chip.",[14,825,826,829],{},[29,827,828],{},"Einstellungen → Hotkeys",": Taste an eine Sound-ID binden. Globale Hotkeys sind optional.",[14,831,832,833,835],{},"Dieselbe ID nutzt ",[69,834,63],{"href":311}," zum Auslösen.",[18,837,839],{"id":838},"gifs-und-farben","GIFs und Farben",[14,841,842,843,847],{},"Rechtsklick auf einen Sound: eigene Farben oder GIF-\u002FBildhintergrund. Das ist getrennt vom ",[69,844,846],{"href":845},"\u002Fdocs\u002Ftheme-editor","Theme Creator",", der das ganze Board gestaltet.",{"title":232,"searchDepth":233,"depth":233,"links":849},[850,851,852,853,854,855,856],{"id":723,"depth":233,"text":724},{"id":760,"depth":233,"text":761},{"id":788,"depth":233,"text":789},{"id":797,"depth":233,"text":798},{"id":812,"depth":233,"text":813},{"id":819,"depth":233,"text":820},{"id":838,"depth":233,"text":839},"Tabs, Gruppen, Suche, Sammelbearbeitung und Hotkeys.",{},4,"\u002Forganizing-sounds",{"title":695,"description":857},"organizing-sounds","tzbjT1L04eFyKK0nuKEVqrhA0oH5iyG-Pq9SkxEWh1w",{"id":865,"title":866,"body":867,"description":992,"extension":241,"meta":993,"navigation":243,"order":994,"path":995,"seo":996,"stem":871,"__hash__":997},"content_de\u002Ftheme-editor.md","Theme-Editor",{"type":7,"value":868,"toc":986},[869,872,878,882,908,911,915,929,933,959,962,966,972],[10,870,866],{"id":871},"theme-editor",[14,873,874,875,39],{},"Der Theme Creator ist der volle visuelle Editor für dein Board. Öffnen über ",[29,876,877],{},"Einstellungen → Allgemein → Theme Creator",[18,879,881],{"id":880},"drei-tabs","Drei Tabs",[23,883,884,897,903],{},[26,885,886,889,890,154,893,896],{},[29,887,888],{},"Allgemein"," — Theme-Name, gemeinsame Farben und Schrift-Uploads (",[44,891,892],{},".ttf",[44,894,895],{},".otf",")",[26,898,899,902],{},[29,900,901],{},"Buttons"," — Farben, Typo, Layout und GIF-Overlay der Sound-Buttons",[26,904,905,907],{},[29,906,724],{}," — Farben, Typo und Rahmenstärke der Tab-Leiste",[14,909,910],{},"Eine Live-Vorschau zeigt Tabs und Buttons b