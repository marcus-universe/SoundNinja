219},"ohne-vollen-editor","Ohne vollen Editor",[14,1222,832,1223,1225],{},[29,1224,768],{}," kannst du trotzdem:",[106,1227,1228,1231,1237],{},[26,1229,1230],{},"Ein Theme aus der Liste wählen",[26,1232,1233,1234,1151],{},"CSS-Variablen live bearbeiten (",[29,1235,1236],{},"Eigenes CSS",[26,1238,1239],{},"Eine Theme-Datei in den Themes-Ordner importieren",{"title":228,"searchDepth":229,"depth":229,"links":1241},[1242,1243,1244,1245],{"id":1135,"depth":229,"text":1136},{"id":1168,"depth":229,"text":1169},{"id":1186,"depth":229,"text":1187},{"id":1219,"depth":229,"text":1220},"Farben, Schriften, Buttons und Tabs im Theme Creator gestalten.",{},5,"\u002Ftheme-editor",{"title":1121,"description":1246},"h6Hta3TDDcThnouY3Pk_Omvjq8Eb8knx-HIAvf5YZd8",{"id":1253,"title":1254,"body":1255,"description":1392,"extension":237,"meta":1393,"navigation":239,"order":1394,"path":1395,"seo":1396,"stem":1397,"__hash__":1398},"content_de\u002Frecording-editor.md","Aufnahme-Editor",{"type":7,"value":1256,"toc":1386},[1257,1260,1266,1270,1276,1296,1299,1303,1328,1332,1347,1351,1365,1376],[10,1258,1254],{"id":1259},"aufnahme-editor",[14,1261,1262,1263,1265],{},"Nimm einen Clip in SoundNinja auf, schneide ihn zu und importiere ihn in einen Tab. Öffnen über ",[29,1264,654],{}," in der Player-Leiste.",[18,1267,1269],{"id":1268},"eingang-wählen","Eingang wählen",[14,1271,832,1272,1275],{},[29,1273,1274],{},"Einstellungen → Audio",":",[106,1277,1278,1284,1290],{},[26,1279,1280,1283],{},[29,1281,1282],{},"Eingabegeräte"," — Mikrofon",[26,1285,1286,1289],{},[29,1287,1288],{},"Ausgabegeräte (PC-Audio)"," — Loopback dessen, was der PC spielt",[26,1291,1292,1295],{},[29,1293,1294],{},"Eingangslautstärke"," — Aufnahme-Gain von 0 % bis 200 %",[14,1297,1298],{},"Der Aufnahme-Button nutzt das hier gewählte Gerät.",[18,1300,1302],{"id":1301},"take-bearbeiten","Take bearbeiten",[106,1304,1305,1308,1311,1319,1322,1325],{},[26,1306,1307],{},"Aufnehmen und stoppen",[26,1309,1310],{},"Pegelmesser beobachten",[26,1312,1313,407,1316],{},[29,1314,1315],{},"Normalisieren",[29,1317,1318],{},"Rauschunterdrückung",[26,1320,1321],{},"Ganzen Clip trimmen, auf Auswahl trimmen oder Auswahl löschen",[26,1323,1324],{},"Rückgängig \u002F Wiederholen",[26,1326,1327],{},"Rein- und rauszoomen",[18,1329,1331],{"id":1330},"stagen-und-importieren","Stagen und importieren",[23,1333,1334,1337,1340],{},[26,1335,1336],{},"Auswahl oder ganzen Track zur Staging-Liste hinzufügen.",[26,1338,1339],{},"Die Liste startet leer: aufnehmen, bearbeiten, dann Clip hinzufügen.",[26,1341,1342,407,1344,1346],{},[29,1343,658],{},[29,1345,661],{}," in den aktuellen oder einen gewählten Tab.",[18,1348,1350],{"id":1349},"stem-trennung-optional","Stem-Trennung (optional)",[14,1352,1353,1354,1357,1358,407,1361,1364],{},"Offizielle Windows-, macOS- und Linux-Release-Builds enthalten das ",[29,1355,1356],{},"Stems","-Feature. Der Aufnahme-Editor kann ",[29,1359,1360],{},"Gesang",[29,1362,1363],{},"Musik"," mit BS-RoFormer behalten.",[14,1366,1367,1368,1371,1372,1375],{},"Das Modell ist etwa 158 MB und ",[29,1369,1370],{},"nicht"," im Installer. Download unter ",[29,1373,1374],{},"Einstellungen → Stem-Trennung"," oder über den Erststart-Hinweis. Der Windows-Installer kann den Download beim ersten Start anbieten.",[14,1377,1378,1379,150,1382,1385],{},"Eigene Source-Builds brauchen extra Flags (",[44,1380,1381],{},"tauri:serve:stems",[44,1383,1384],{},"tauri:build:stems",").",{"title":228,"searchDepth":229,"depth":229,"links":1387},[1388,1389,1390,1391],{"id":1268,"depth":229,"text":1269},{"id":1301,"depth":229,"text":1302},{"id":1330,"depth":229,"text":1331},{"id":1349,"depth":229,"text":1350},"Mikrofon oder PC-Audio aufnehmen, den Clip bearbeiten und aufs Board legen.",{},6,"\u002Frecording-editor",{"title":1254,"description":1392},"recording-editor","mBUN6yUiwk-kNjhsf48NlWEXXhjw6cOuSAkybSa9wi0",{"id":4,"title":5,"body":1400,"description":236,"extension":237,"meta":1543,"navigation":239,"order":240,"path":241,"seo":15