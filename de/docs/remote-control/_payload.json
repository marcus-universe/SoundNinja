4,95,96],{},"npm install"," ausführen.",[26,99,100,101,104],{},"Eine ",[29,102,103],{},"Sound Ninja","-Verbindung anlegen. PC-IP, Port und Token eintragen.",[18,106,108],{"id":107},"aktionen","Aktionen",[110,111,112,118,124],"ul",{},[26,113,114,117],{},[29,115,116],{},"Trigger Sound"," — aus dem Live-Dropdown wählen oder 8-stellige Sound-ID tippen (Companion-Variablen gehen)",[26,119,120,123],{},[29,121,122],{},"Stop Sound"," — einen spielenden Sound per ID stoppen",[26,125,126,129],{},[29,127,128],{},"Stop All"," — alle spielenden Sounds stoppen",[14,131,132],{},"Sound-ID in SoundNinja über das Button-Kontextmenü oder den Mehrfachauswahl-Chip kopieren.",[18,134,136],{"id":135},"feedbacks-und-variablen","Feedbacks und Variablen",[110,138,139,145,158,164],{},[26,140,141,144],{},[29,142,143],{},"Sound Playing"," — wahr, solange diese Sound-ID aktiv ist (für Button-Farbe)",[26,146,147,150,151,154,155],{},[44,148,149],{},"$(soundninja:connected)"," — ",[44,152,153],{},"true"," \u002F ",[44,156,157],{},"false",[26,159,160,163],{},[44,161,162],{},"$(soundninja:playing_count)"," — wie viele Sounds spielen",[26,165,166,169],{},[44,167,168],{},"$(soundninja:last_triggered)"," — zuletzt ausgelöste Sound-ID",[18,171,173],{"id":172},"http-api-fortgeschritten","HTTP-API (fortgeschritten)",[14,175,176,177],{},"Basispfad: ",[44,178,179],{},"\u002Fapi\u002Fv1",[110,181,182,188,194,200,210,216,225],{},[26,183,184,187],{},[44,185,186],{},"GET \u002Finfo"," — App-Name, Version, Protokoll, ob ein Token nötig ist",[26,189,190,193],{},[44,191,192],{},"GET \u002Fsounds"," — Soundliste (id, name, tabs, active)",[26,195,196,199],{},[44,197,198],{},"GET \u002Fstate"," — Sounds plus gerade spielende IDs",[26,201,202,205,206,209],{},[44,203,204],{},"POST \u002Ftrigger"," mit ",[44,207,208],{},"{ \"id\" }"," — Sound abspielen",[26,211,212,215],{},[44,213,214],{},"GET \u002Ftrigger\u002F:id"," — abspielen (einfach im Browser testen)",[26,217,218,221,222,224],{},[44,219,220],{},"POST \u002Fstop"," mit optionalem ",[44,223,208],{}," — einen Sound oder alle stoppen",[26,226,227,230],{},[44,228,229],{},"GET \u002Fws"," — Live-Status; Trigger\u002FStop eingehend senden",{"title":232,"searchDepth":233,"depth":233,"links":234},"",2,[235,236,237,238,239],{"id":20,"depth":233,"text":21},{"id":62,"depth":233,"text":63},{"id":107,"depth":233,"text":108},{"id":135,"depth":233,"text":136},{"id":172,"depth":233,"text":173},"SoundNinja über das lokale Netz mit Bitfocus Companion auslösen.","md",{},true,7,"\u002Fremote-control",{"title":5,"description":240},"remote-control","6LFY6vR2lZ7MZcwAd2UKAIMoBTG1iGr5S43iiJswndo",[250,369,566,711,864,998,1141,1289],{"id":251,"title":252,"body":253,"description":362,"extension":241,"meta":363,"navigation":243,"order":364,"path":365,"seo":366,"stem":367,"__hash__":368},"content_de\u002Foverview.md","Überblick",{"type":7,"value":254,"toc":356},[255,258,261,264,267,271,285,289,319,323,332,336],[10,256,252],{"id":257},"überblick",[14,259,260],{},"SoundNinja ist ein Open-Source-Soundboard für Livestreams, Chats mit Freunden und Podcast-Aufnahmen. Es läuft auf Tauri v2 und Nuxt 4 und bleibt dabei sparsam mit RAM und Speicherplatz.",[14,262,263],{},"Das Ziel: eine große Sound-Bibliothek schnell scannen und den richtigen Clip in Millisekunden abspielen. Die Oberfläche eignet sich auch als Dashboard in VR.",[14,265,266],{},"SoundNinja steckt noch in der frühen Entwicklung. Funktionen laufen, aber nicht jede Plattform ist vollständig getestet.",[18,268,270],{"id":269},"für-wen","Für wen",[110,272,273,276,279,282],{},[26,274,275],{},"Streamer, die sofortige Sound-Cues brauchen",[26,277,278],{},"Freunde, die ein gemeinsames Board für Voice-Chat wollen",[26,280,281],{},"Podcaster, die Clips aufnehmen und aufs Board legen",[26,283,284],{},"Alle, die ein anpassbares, lokales Soundboard wollen",[18,286,288],{"id":287},"was-du-tun-kannst","Was du tun kannst",[110,290,291,294,297,300,303,306,313,316],{},[26,292,293],{},"Ein Soundboard aus eigenen Audiodateien bauen",[26,295,296],{},"Sounds in farbigen Tabs, Gruppen und über die Suche sortieren",[26,298,299],{},"Das Aussehen mit dem Theme Creator gestalten",[26,301,302],{},"PC-Audio oder Mikrofon im Record Editor aufnehmen",[26,304,305],{},"Hotkeys einzelnen Sounds zuweisen",[26,307,308,309,312],{},"Sounds über ",[69,310,63],{"href":311},"\u002Fdocs\u002Fremote-control"," auslösen",[26,314,315],{},"Ein komplettes Soundboard importieren und exportieren",[26,317,318],{},"GIFs oder Bilder auf Sound-Buttons legen",[18,320,322],{"id":321},"lizenz","Lizenz",[14,324,325,326,331],{},"SoundNinja ist freie Software unter ",[69,327,330],{"href":328,"rel":329},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fblob\u002Fmain\u002FLICENSE",[73],"GPL-3.0",". Forken, ändern, teilen.",[18,333,335],{"id":334},"nächste-schritte","Nächste Schritte",[23,337,338,344,350],{},[26,339,340],{},[69,341,343],{"href":342},"\u002Fdocs\u002Finstallation","SoundNinja installieren",[26,345,346],{},[69,347,349],{"href":348},"\u002Fdocs\u002Fadding-sounds","Sounds hinzufügen",[26,351,352],{},[69,353,355],{"href":354},"\u002Fdocs\u002Forganizing-sounds","Board organisieren",{"title":232,"searchDepth":233,"depth":233,"links":357},[358,359,360,361],{"id":269,"depth":233,"text":270},{"id":287,"depth":233,"text":288},{"id":321,"depth":233,"text":322},{"id":334,"depth":233,"text":335},"Was SoundNinja ist und was du damit machen kannst.",{},1,"\u002Foverview",{"title":252,"description":362},"overview","k9vdLuByV0_2FJs4S1c2pJgDzzqDtddQcqK9KQYpZ8M",{"id":370,"title":371,"body":372,"description":561,"extension":241,"meta":562,"navigation":243,"order":233,"path":563,"seo":564,"stem":376,"__hash__":565},"content_de\u002Finstallation.md","Installation",{"type":7,"value":373,"toc":554},[374,377,391,395,413,416,420,434,437,441,465,476,480,487,491,505,535,550],[10,375,371],{"id":376},"installation",[14,378,379,380,384,385,390],{},"Hol dir einen Build von der ",[69,381,383],{"href":382},"\u002Fdownload","Download-Seite"," oder von ",[69,386,389],{"href":387,"rel":388},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Freleases\u002Flatest",[73],"GitHub Releases",". SoundNinja ist in früher Entwicklung — behandle Builds als Beta.",[18,392,394],{"id":393},"windows","Windows",[110,396,397,407,410],{},[26,398,399,402,403,406],{},[29,400,401],{},"Installer (.exe)"," oder ",[29,404,405],{},"MSI (.msi)"," für 64-Bit-Windows",[26,408,409],{},"Landing-Page-Ziel: Windows 10 und neuer",[26,411,412],{},"Die App-README nennt auch Windows 8 und höher",[14,414,415],{},"Installer starten, dann SoundNinja über das Startmenü öffnen.",[18,417,419],{"id":418},"macos","macOS",[110,421,422,428,431],{},[26,423,424,427],{},[29,425,426],{},"Universelles .dmg"," für Apple Silicon und Intel",[26,429,430],{},"Landing-Page-Ziel: macOS 10.14 und neuer",[26,432,433],{},"Die App-README nennt macOS 10.15 und höher",[14,435,436],{},"Disk-Image öffnen und SoundNinja nach Programme ziehen.",[18,438,440],{"id":439},"linux","Linux",[110,442,443,449,455,462],{},[26,444,445,448],{},[29,446,447],{},"Debian (.deb)"," für Ubuntu \u002F Debian",[26,450,451,454],{},[29,452,453],{},"AppImage"," für andere Distros",[26,456,457,458,461],{},"Nach Veröffentlichung einer Release können Arch-Nutzer ",[44,459,460],{},"soundninja-bin"," aus dem AUR installieren",[26,463,464],{},"Getestet unter Ubuntu 20.04",[14,466,467,468,471,472,475],{},"Desktop-Builds brauchen WebKit- und GTK-Pakete. Unter Debian\u002FUbuntu meist ",[44,469,470],{},"libwebkit2gtk",", ",[44,473,474],{},"libgtk-3-0"," und eine App-Indicator-Bibliothek.",[18,477,479],{"id":478},"updates","Updates",[14,481,482,483,486],{},"In der App: ",[29,484,485],{},"Hilfe → Nach Updates suchen",". Optional prüft SoundNinja beim Start in den Einstellungen.",[18,488,490],{"id":489},"aus-dem-quellcode-bauen","Aus dem Quellcode bauen",[14,492,493,494,471,499,504],{},"Eigenen Build? ",[69,495,498],{"href":496,"rel":497},"https:\u002F\u00