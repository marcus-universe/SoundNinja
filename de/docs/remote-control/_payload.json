[{"data":1,"prerenderedAt":1642},["ShallowReactive",2],{"docs-page-de-\u002Fremote-control":3,"docs-nav-de":245},{"id":4,"title":5,"body":6,"description":236,"extension":237,"meta":238,"navigation":239,"order":240,"path":241,"seo":242,"stem":243,"__hash__":244},"content_de\u002Fremote-control.md","Fernsteuerung",{"type":7,"value":8,"toc":227},"minimark",[9,13,17,22,57,60,64,101,105,126,129,133,166,170,176],[10,11,5],"h1",{"id":12},"fernsteuerung",[14,15,16],"p",{},"SoundNinja kann im lokalen Netz lauschen, damit Bitfocus Companion (oder jeder HTTP\u002FWebSocket-Client) Sounds spielt und stoppt.",[18,19,21],"h2",{"id":20},"remote-server-einschalten","Remote-Server einschalten",[23,24,25,33,40,47],"ol",{},[26,27,28,32],"li",{},[29,30,31],"strong",{},"Einstellungen → Remote"," öffnen.",[26,34,35,36,39],{},"Remote-Server aktivieren. Standardport ist ",[29,37,38],{},"7331",".",[26,41,42,43,39],{},"Optional: Token setzen. Clients senden ihn als Bearer-Token oder ",[44,45,46],"code",{},"?token=",[26,48,49,52,53,56],{},[44,50,51],{},"http:\u002F\u002FIP:PORT"," kopieren oder die System-IP unter ",[29,54,55],{},"Einstellungen → Über"," holen.",[14,58,59],{},"Windows kann beim ersten Start eine Firewall-Abfrage zeigen. Zugriff im privaten Netz erlauben.",[18,61,63],{"id":62},"bitfocus-companion","Bitfocus Companion",[23,65,66,75,83,94],{},[26,67,68,74],{},[69,70,63],"a",{"href":71,"rel":72},"https:\u002F\u002Fbitfocus.io\u002Fcompanion",[73],"nofollow"," installieren.",[26,76,77,82],{},[69,78,81],{"href":79,"rel":80},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Freleases\u002Flatest\u002Fdownload\u002FSoundNinja-Companion.tgz",[73],"SoundNinja-Companion.tgz"," herunterladen. Es gibt noch kein Companion-Store-Paket.",[26,84,85,86,89,90,93],{},"In Companion: ",[29,87,88],{},"Modules → Load module package"," und die ",[44,91,92],{},".tgz"," wählen.",[26,95,96,97,100],{},"Eine ",[29,98,99],{},"Sound Ninja","-Verbindung anlegen. PC-IP, Port und Token eintragen.",[18,102,104],{"id":103},"aktionen","Aktionen",[106,107,108,114,120],"ul",{},[26,109,110,113],{},[29,111,112],{},"Trigger Sound"," — aus dem Live-Dropdown wählen oder 8-stellige Sound-ID tippen (Companion-Variablen gehen)",[26,115,116,119],{},[29,117,118],{},"Stop Sound"," — einen spielenden Sound per ID stoppen",[26,121,122,125],{},[29,123,124],{},"Stop All"," — alle spielenden Sounds stoppen",[14,127,128],{},"Sound-ID in SoundNinja über das Button-Kontextmenü oder den Mehrfachauswahl-Chip kopieren.",[18,130,132],{"id":131},"feedbacks-und-variablen","Feedbacks und Variablen",[106,134,135,141,154,160],{},[26,136,137,140],{},[29,138,139],{},"Sound Playing"," — wahr, solange diese Sound-ID aktiv ist (für Button-Farbe)",[26,142,143,146,147,150,151],{},[44,144,145],{},"$(soundninja:connected)"," — ",[44,148,149],{},"true"," \u002F ",[44,152,153],{},"false",[26,155,156,159],{},[44,157,158],{},"$(soundninja:playing_count)"," — wie viele Sounds spielen",[26,161,162,165],{},[44,163,164],{},"$(soundninja:last_triggered)"," — zuletzt ausgelöste Sound-ID",[18,167,169],{"id":168},"http-api-fortgeschritten","HTTP-API (fortgeschritten)",[14,171,172,173],{},"Basispfad: ",[44,174,175],{},"\u002Fapi\u002Fv1",[106,177,178,184,190,196,206,212,221],{},[26,179,180,183],{},[44,181,182],{},"GET \u002Finfo"," — App-Name, Version, Protokoll, ob ein Token nötig ist",[26,185,186,189],{},[44,187,188],{},"GET \u002Fsounds"," — Soundliste (id, name, tabs, active)",[26,191,192,195],{},[44,193,194],{},"GET \u002Fstate"," — Sounds plus gerade spielende IDs",[26,197,198,201,202,205],{},[44,199,200],{},"POST \u002Ftrigger"," mit ",[44,203,204],{},"{ \"id\" }"," — Sound abspielen",[26,207,208,211],{},[44,209,210],{},"GET \u002Ftrigger\u002F:id"," — abspielen (einfach im Browser testen)",[26,213,214,217,218,220],{},[44,215,216],{},"POST \u002Fstop"," mit optionalem ",[44,219,204],{}," — einen Sound oder alle stoppen",[26,222,223,226],{},[44,224,225],{},"GET \u002Fws"," — Live-Status; Trigger\u002FStop eingehend senden",{"title":228,"searchDepth":229,"depth":229,"links":230},"",2,[231,232,233,234,235],{"id":20,"depth":229,"text":21},{"id":62,"depth":229,"text":63},{"id":103,"depth":229,"text":104},{"id":131,"depth":229,"text":132},{"id":168,"depth":229,"text":169},"SoundNinja über das lokale Netz mit Bitfocus Companion auslösen.","md",{},true,7,"\u002Fremote-control",{"title":5,"description":236},"remote-control","aoJg0O55CqoN5KAAd3QZaQmimgi-sFVm0Nb0LUnjtKw",[246,374,574,719,1119,1252,1399,1545],{"id":247,"title":248,"body":249,"description":367,"extension":237,"meta":368,"navigation":239,"order":369,"path":370,"seo":371,"stem":372,"__hash__":373},"content_de\u002Foverview.md","Überblick",{"type":7,"value":250,"toc":361},[251,254,257,260,263,267,281,285,324,328,337,341],[10,252,248],{"id":253},"überblick",[14,255,256],{},"SoundNinja ist ein Open-Source-Soundboard für Livestreams, Chats mit Freunden und Podcast-Aufnahmen. Es läuft auf Tauri v2 und Nuxt 4 und bleibt dabei sparsam mit RAM und Speicherplatz.",[14,258,259],{},"Das Ziel: eine große Sound-Bibliothek schnell scannen und den richtigen Clip in Millisekunden abspielen. Die Oberfläche eignet sich auch als Dashboard in VR.",[14,261,262],{},"SoundNinja steckt noch in der frühen Entwicklung. Funktionen laufen, aber nicht jede Plattform ist vollständig getestet.",[18,264,266],{"id":265},"für-wen","Für wen",[106,268,269,272,275,278],{},[26,270,271],{},"Streamer, die sofortige Sound-Cues brauchen",[26,273,274],{},"Freunde, die ein gemeinsames Board für Voice-Chat wollen",[26,276,277],{},"Podcaster, die Clips aufnehmen und aufs Board legen",[26,279,280],{},"Alle, die ein anpassbares, lokales Soundboard wollen",[18,282,284],{"id":283},"was-du-tun-kannst","Was du tun kannst",[106,286,287,290,293,296,299,302,305,308,311,318,321],{},[26,288,289],{},"Ein Soundboard aus eigenen Audiodateien bauen",[26,291,292],{},"Sounds in farbigen Tabs, Gruppen, Tags und über die Suche sortieren",[26,294,295],{},"Nach Tags filtern (ODER) und nach Name, Datum, Dauer oder Größe sortieren",[26,297,298],{},"Mehrfachauswahl mit Rahmen oder Shift-Bereich, dann Farbe, Tab oder Löschen in einem Rutsch",[26,300,301],{},"Lautstärke pro Sound im Kontextmenü setzen",[26,303,304],{},"Das Aussehen mit dem Theme Creator gestalten",[26,306,307],{},"PC-Audio oder Mikrofon im Record Editor aufnehmen",[26,309,310],{},"Hotkeys einzelnen Sounds zuweisen",[26,312,313,314,317],{},"Sounds über ",[69,315,63],{"href":316},"\u002Fdocs\u002Fremote-control"," auslösen",[26,319,320],{},"Ein komplettes Soundboard importieren und exportieren",[26,322,323],{},"GIFs oder Bilder auf Sound-Buttons legen — aus lokaler Ordnerbibliothek oder KLIPY",[18,325,327],{"id":326},"lizenz","Lizenz",[14,329,330,331,336],{},"SoundNinja ist freie Software unter ",[69,332,335],{"href":333,"rel":334},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fblob\u002Fmain\u002FLICENSE",[73],"GPL-3.0",". Forken, ändern, teilen.",[18,338,340],{"id":339},"nächste-schritte","Nächste Schritte",[23,342,343,349,355],{},[26,344,345],{},[69,346,348],{"href":347},"\u002Fdocs\u002Finstallation","SoundNinja installieren",[26,350,351],{},[69,352,354],{"href":353},"\u002Fdocs\u002Fadding-sounds","Sounds hinzufügen",[26,356,357],{},[69,358,360],{"href":359},"\u002Fdocs\u002Forganizing-sounds","Board organisieren",{"title":228,"searchDepth":229,"depth":229,"links":362},[363,364,365,366],{"id":265,"depth":229,"text":266},{"id":283,"depth":229,"text":284},{"id":326,"depth":229,"text":327},{"id":339,"depth":229,"text":340},"Was SoundNinja ist und was du damit machen kannst.",{},1,"\u002Foverview",{"title":248,"description":367},"overview","hoyfMBw8UK5RuLBAbdnmSxP4gC163p8E8rvJgSihSXE",{"id":375,"title":376,"body":377,"description":569,"extension":237,"meta":570,"navigation":239,"order":229,"path":571,"seo":572,"stem":381,"__hash__":573},"content_de\u002Finstallation.md","Installation",{"type":7,"value":378,"toc":562},[379,382,396,400,421,424,428,442,445,449,473,484,488,495,499,513,543,558],[10,380,376],{"id":381},"installation",[14,383,384,385,389,390,395],{},"Hol dir einen Build von der ",[69,386,388],{"href":387},"\u002Fdownload","Download-Seite"," oder von ",[69,391,394],{"href":392,"rel":393},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Freleases\u002Flatest",[73],"GitHub Releases",". SoundNinja ist in früher Entwicklung — behandle Builds als Beta.",[18,397,399],{"id":398},"windows","Windows",[106,401,402,412,415,418],{},[26,403,404,407,408,411],{},[29,405,406],{},"Installer (.exe)"," oder ",[29,409,410],{},"MSI (.msi)"," für 64-Bit-Windows",[26,413,414],{},"Landing-Page-Ziel: Windows 10 und neuer",[26,416,417],{},"Die App-README nennt auch Windows 8 und höher",[26,419,420],{},"Der NSIS-Installer ist dunkel. Sprache beim Setup wählen — SoundNinja merkt sie beim nächsten Start.",[14,422,423],{},"Installer starten, dann SoundNinja über das Startmenü öffnen.",[18,425,427],{"id":426},"macos","macOS",[106,429,430,436,439],{},[26,431,432,435],{},[29,433,434],{},"Universelles .dmg"," für Apple Silicon und Intel",[26,437,438],{},"Landing-Page-Ziel: macOS 10.14 und neuer",[26,440,441],{},"Die App-README nennt macOS 10.15 und höher",[14,443,444],{},"Disk-Image öffnen und SoundNinja nach Programme ziehen.",[18,446,448],{"id":447},"linux","Linux",[106,450,451,457,463,470],{},[26,452,453,456],{},[29,454,455],{},"Debian (.deb)"," für Ubuntu \u002F Debian",[26,458,459,462],{},[29,460,461],{},"AppImage"," für andere Distros",[26,464,465,466,469],{},"Nach Veröffentlichung einer Release können Arch-Nutzer ",[44,467,468],{},"soundninja-bin"," aus dem AUR installieren",[26,471,472],{},"Getestet unter Ubuntu 20.04",[14,474,475,476,479,480,483],{},"Desktop-Builds brauchen WebKit- und GTK-Pakete. Unter Debian\u002FUbuntu meist ",[44,477,478],{},"libwebkit2gtk",", ",[44,481,482],{},"libgtk-3-0"," und eine App-Indicator-Bibliothek.",[18,485,487],{"id":486},"updates","Updates",[14,489,490,491,494],{},"In der App: ",[29,492,493],{},"Hilfe → Nach Updates suchen",". Optional prüft SoundNinja beim Start in den Einstellungen.",[18,496,498],{"id":497},"aus-dem-quellcode-bauen","Aus dem Quellcode bauen",[14,500,501,502,479,507,512],{},"Eigenen Build? ",[69,503,506],{"href":504,"rel":505},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja",[73],"Repo klonen",[69,508,511],{"href":509,"rel":510},"https:\u002F\u002Fv2.tauri.app\u002Fstart\u002Fprerequisites\u002F",[73],"Tauri-Voraussetzungen"," installieren, dann:",[514,515,519],"pre",{"className":516,"code":517,"language":518,"meta":228,"style":228},"language-bash shiki shiki-themes github-light github-dark","bun install\nbun run tauri:serve\n","bash",[44,520,521,533],{"__ignoreMap":228},[522,523,525,529],"span",{"class":524,"line":369},"line",[522,526,528],{"class":527},"sScJk","bun",[522,530,532],{"class":531},"sZZnC"," install\n",[522,534,535,537,540],{"class":524,"line":229},[522,536,528],{"class":527},[522,538,539],{"class":531}," run",[522,541,542],{"class":531}," tauri:serve\n",[14,544,545,479,548,407,551,554,555,39],{},[44,546,547],{},"npm",[44,549,550],{},"pnpm",[44,552,553],{},"deno"," gehen auch. Produktionsbuild: ",[44,556,557],{},"bun run tauri:build",[559,560,561],"style",{},"html pre.shiki code .sScJk, html code.shiki .sScJk{--shiki-default:#6F42C1;--shiki-dark:#B392F0}html pre.shiki code .sZZnC, html code.shiki .sZZnC{--shiki-default:#032F62;--shiki-dark:#9ECBFF}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html.dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}",{"title":228,"searchDepth":229,"depth":229,"links":563},[564,565,566,567,568],{"id":398,"depth":229,"text":399},{"id":426,"depth":229,"text":427},{"id":447,"depth":229,"text":448},{"id":486,"depth":229,"text":487},{"id":497,"depth":229,"text":498},"SoundNinja unter Windows, macOS oder Linux installieren.",{},"\u002Finstallation",{"title":376,"description":569},"r-3EUG7lGdfEJsGyve9-EQzSXP8-1Q3frBZ2lky4J_M",{"id":575,"title":354,"body":576,"description":712,"extension":237,"meta":713,"navigation":239,"order":714,"path":715,"seo":716,"stem":717,"__hash__":718},"content_de\u002Fadding-sounds.md",{"type":7,"value":577,"toc":704},[578,581,584,588,605,609,640,644,663,667,680,683,687,694,698],[10,579,354],{"id":580},"sounds-hinzufügen",[14,582,583],{},"Ein Board bleibt leer, bis du Clips hinzufügst. SoundNinja importiert Dateien, ganze Ordner, eine Aufnahme oder ein geteiltes Soundboard-Paket.",[18,585,587],{"id":586},"audiodateien-importieren","Audiodateien importieren",[23,589,590,599,602],{},[26,591,592,407,595,598],{},[29,593,594],{},"Datei → Audiodateien importieren",[29,596,597],{},"Import"," in der Navbar.",[26,600,601],{},"Eine oder mehrere Audiodateien wählen.",[26,603,604],{},"Sounds landen im aktuellen Tab.",[18,606,608],{"id":607},"ordner-importieren","Ordner importieren",[23,610,611,620,623],{},[26,612,613,616,617,619],{},[29,614,615],{},"Datei → Ordner importieren"," (oder ",[29,618,608],{}," in der Navbar).",[26,621,622],{},"Einen oder mehrere Ordner hinzufügen. Vor dem Import per Drag neu sortieren.",[26,624,625,626],{},"Ziel wählen:\n",[106,627,628,634],{},[26,629,630,633],{},[29,631,632],{},"Als Tabs importieren"," — jeder Ordner wird ein eigener Tab",[26,635,636,639],{},[29,637,638],{},"In aktuellen Tab importieren"," — alle Dateien landen im aktiven Tab",[18,641,643],{"id":642},"clip-aufnehmen","Clip aufnehmen",[14,645,646,647,651,652,655,656,407,659,662],{},"Öffne den ",[69,648,650],{"href":649},"\u002Fdocs\u002Frecording-editor","Record Editor"," über ",[29,653,654],{},"Aufnahme"," in der Player-Leiste. Aufnehmen, zuschneiden, dann ",[29,657,658],{},"Auswahl importieren",[29,660,661],{},"Alle importieren"," in den aktuellen Tab oder einen gewählten Tab.",[18,664,666],{"id":665},"soundboard-importieren","Soundboard importieren",[14,668,669,672,673,201,676,679],{},[29,670,671],{},"Datei → Soundboard importieren"," lädt ein geteiltes Paket. Pakete sind ein ",[44,674,675],{},".zip",[44,677,678],{},"project.sninja"," plus Sounddateien. Danach Projekt öffnen und abspielen.",[14,681,682],{},"Du kannst mehrere Projekte (Profile) halten. Über den Projektwähler zwischen Boards wechseln.",[18,684,686],{"id":685},"fehlende-dateien-neu-verknüpfen","Fehlende Dateien neu verknüpfen",[14,688,689,690,693],{},"Wenn Audiodateien auf der Festplatte umziehen, zeigt SoundNinja ",[29,691,692],{},"Fehlende Sounddateien",". Einen Suchordner wählen und Clips neu verknüpfen.",[18,695,697],{"id":696},"weiter","Weiter",[14,699,700,701,39],{},"Tabs, Tags, Filter und Hotkeys: ",[69,702,703],{"href":359},"Sounds organisieren",{"title":228,"searchDepth":229,"depth":229,"links":705},[706,707,708,709,710,711],{"id":586,"depth":229,"text":587},{"id":607,"depth":229,"text":608},{"id":642,"depth":229,"text":643},{"id":665,"depth":229,"text":666},{"id":685,"depth":229,"text":686},{"id":696,"depth":229,"text":697},"Audio, Ordner, Aufnahmen und geteilte Soundboards importieren.",{},3,"\u002Fadding-sounds",{"title":354,"description":712},"adding-sounds","H_ls9_vOwDkgTWPkfe9bQz1A0XidUOmMFV4V2EJpYec",{"id":720,"title":703,"body":721,"description":1112,"extension":237,"meta":1113,"navigation":239,"order":1114,"path":1115,"seo":1116,"stem":1117,"__hash__":1118},"content_de\u002Forganizing-sounds.md",{"type":7,"value":722,"toc":1097},[723,726,733,737,763,770,774,777,791,798,804,808,818,823,854,858,864,868,902,908,912,915,941,944,948,961,965,970,990,1006,1013,1017,1028,1031,1035,1042,1052,1058,1062,1070,1077,1094],[10,724,703],{"id":725},"sounds-organisieren",[14,727,728,729,732],{},"SoundNinja ist für große Bibliotheken gebaut. ",[29,730,731],{},"Tags und Filter",", Tabs, Suche, Mehrfachauswahl und Hotkeys — der Clip ist einen Klick (oder eine Taste) entfernt.",[18,734,736],{"id":735},"tabs","Tabs",[106,738,739,746,753],{},[26,740,741,742,745],{},"Tab mit ",[29,743,744],{},"Tab hinzufügen"," anlegen. Farbe vergeben, damit die Leiste schnell scannbar bleibt.",[26,747,748,749,752],{},"Die Ansicht ",[29,750,751],{},"Alle"," zeigt jeden Sound über alle Tabs.",[26,754,755,756,759,760,39],{},"Ein Sound kann ",[29,757,758],{},"einem oder mehreren Tabs"," gehören. Rechtsklick → ",[29,761,762],{},"Zu Tab verschieben",[14,764,765,766,769],{},"Tab-Übergänge: ",[29,767,768],{},"Einstellungen → Allgemein"," — Slide, Fade, Buttons nacheinander oder Keine.",[18,771,773],{"id":772},"gruppen","Gruppen",[14,775,776],{},"Seit v0.5.3 können Trenner zu benannten Gruppen werden:",[106,778,779,782,785,788],{},[26,780,781],{},"Gruppe über das Kontextmenü hinzufügen, umbenennen oder entfernen",[26,783,784],{},"Gruppenkopf ziehen — Kinder kommen mit",[26,786,787],{},"Sounds in eine Gruppe legen oder herausnehmen",[26,789,790],{},"Rahmenfarbe, Namensfarbe und Button-Ausrichtung setzen (oder Tab-Standard nutzen)",[14,792,793,794,797],{},"Ein einfacher ",[29,795,796],{},"Trenner"," geht weiter, wenn du nur einen visuellen Bruch brauchst.",[14,799,800,801,39],{},"Rechtsklick auf leeren Board-Bereich: ",[29,802,803],{},"Gruppe hinzufügen",[18,805,807],{"id":806},"tags-filter","Tags \u002F Filter",[14,809,810,811,814,815,817],{},"Tags gelten tabübergreifend. Das ausfahrbare ",[29,812,813],{},"Filter","-Panel (Sidebar ",[29,816,813],{},") ist der Ort zum Anlegen und zum Filtern des Boards.",[819,820,822],"h3",{"id":821},"tags-anlegen-und-bearbeiten","Tags anlegen und bearbeiten",[23,824,825,830,841,847],{},[26,826,827,829],{},[29,828,813],{}," in der Sidebar öffnen.",[26,831,832,833,836,837,840],{},"Unter ",[29,834,835],{},"Tags"," → ",[29,838,839],{},"Tag hinzufügen"," — Name und Farbe vergeben.",[26,842,843,844,39],{},"Im selben Panel umbenennen, umfärben oder ",[29,845,846],{},"Tag löschen",[26,848,849,850,853],{},"Steht da ",[29,851,852],{},"Noch keine Tags",", zuerst hier einen anlegen, bevor du zuweist.",[819,855,857],{"id":856},"tags-an-sounds-hängen","Tags an Sounds hängen",[14,859,860,861,863],{},"Rechtsklick auf einen Sound → ",[29,862,835],{}," (Checkboxen). Ein Sound darf mehrere Tags haben. Existieren noch keine, zeigt das Menü den Weg zum Filter-Panel.",[819,865,867],{"id":866},"board-filtern","Board filtern",[106,869,870,877,888,899],{},[26,871,872,873,876],{},"Tags im Filter-Panel oder als ",[29,874,875],{},"Chips unter der Suchleiste"," umschalten.",[26,878,879,880,883,884,887],{},"Abgleich ist ",[29,881,882],{},"ODER",": ein Sound bleibt sichtbar, wenn er ",[29,885,886],{},"irgendeinen"," gewählten Tag hat.",[26,889,890,891,894,895,898],{},"Das Feld ",[29,892,893],{},"Suche"," in der Navbar kombiniert per ",[29,896,897],{},"UND"," mit dem aktiven Tag-Filter (Tippen + Tags zusammen).",[26,900,901],{},"Chips aus (oder Filter leeren), um den ganzen Tab wieder zu sehen.",[14,903,904,905,39],{},"Farbige Tag-Namen können auf Buttons erscheinen. Schalter: ",[29,906,907],{},"Einstellungen → Verhalten → Tag-Badges anzeigen",[18,909,911],{"id":910},"sortierung","Sortierung",[14,913,914],{},"Im Filter-Panel eine Sortierung wählen:",[106,916,917,923],{},[26,918,919,922],{},[29,920,921],{},"Benutzerdefiniert"," — deine Tab-Reihenfolge, Gruppen sichtbar",[26,924,925,479,928,479,931,407,934,937,938],{},[29,926,927],{},"Name",[29,929,930],{},"Hinzugefügt",[29,932,933],{},"Spielzeit",[29,935,936],{},"Dateigröße"," — flache sortierte Liste; ",[29,939,940],{},"Gruppen sind ausgeblendet",[14,942,943],{},"Sortierung nach Dauer kann beim ersten Mal die Dauer-Metadaten vorwärmen.",[18,945,947],{"id":946},"neu-anordnen","Neu anordnen",[14,949,950,951,954,955,958,959,39],{},"Drag-and-Drop in ",[29,952,953],{},"Einstellungen → Verhalten"," einschalten (",[29,956,957],{},"Neu anordnen erlauben","). Dann Sounds und Gruppen ziehen. Neu anordnen gilt bei ",[29,960,921],{},[18,962,964],{"id":963},"mehrfachauswahl","Mehrfachauswahl",[14,966,967,969],{},[29,968,964],{}," in der Navbar einschalten, dann:",[106,971,972,975,981,987],{},[26,973,974],{},"Klick toggelt einen Sound",[26,976,977,980],{},[29,978,979],{},"Shift+Klick"," wählt einen Bereich ab dem letzten Anker",[26,982,983,986],{},[29,984,985],{},"Rahmen"," auf leerem Board ziehen",[26,988,989],{},"Klick auf leeres Board (oder außerhalb) leert die Auswahl",[14,991,992,993,479,996,479,999,1002,1003,39],{},"Eine Sammelleiste zeigt die Anzahl plus ",[29,994,995],{},"Farbe",[29,997,998],{},"Zu Tab verschieben…",[29,1000,1001],{},"Löschen"," und ",[29,1004,1005],{},"Fertig",[14,1007,1008,1009,1012],{},"In der Mehrfachauswahl zeigt jeder Button einen ",[29,1010,1011],{},"8-Zeichen-ID-Chip",". Rechtsklick auf den Chip kopiert die ID.",[18,1014,1016],{"id":1015},"lautstärke-pro-sound","Lautstärke pro Sound",[14,1018,1019,1020,1023,1024,1027],{},"Rechtsklick → ",[29,1021,1022],{},"Lautstärke",". Slider von 0 % bis 100 %. ",[29,1025,1026],{},"Doppelklick"," setzt auf 100 % zurück.",[14,1029,1030],{},"Das stapelt sich mit der Master-Ausgangslautstärke in den Einstellungen.",[18,1032,1034],{"id":1033},"hotkeys-und-sound-ids","Hotkeys und Sound-IDs",[14,1036,1037,1038,1041],{},"Jeder Sound hat eine 8-stellige ID. Kopieren über das Button-Kontextmenü (",[29,1039,1040],{},"ID kopieren",") oder den Mehrfachauswahl-Chip.",[14,1043,1044,1047,1048,1051],{},[29,1045,1046],{},"Einstellungen → Hotkeys",": Taste an eine Sound-ID binden. Globale Hotkeys sind optional. ",[29,1049,1050],{},"Hotkey zuweisen"," im Kontextmenü springt dorthin, ID vorausgefüllt.",[14,1053,1054,1055,1057],{},"Dieselbe ID nutzt ",[69,1056,63],{"href":316}," zum Auslösen.",[18,1059,1061],{"id":1060},"hintergrundbilder-und-farben","Hintergrundbilder und Farben",[14,1063,1064,1065,1069],{},"Rechtsklick auf einen Sound: eigene Farben oder ein Hintergrundbild. Das ist getrennt vom ",[69,1066,1068],{"href":1067},"\u002Fdocs\u002Ftheme-editor","Theme Creator",", der das ganze Board gestaltet.",[14,1071,1072,1073,1076],{},"Der Picker ist ein Dialog ",[29,1074,1075],{},"Hintergrundbild"," (PNG, JPEG, GIF, WebP):",[106,1078,1079,1085],{},[26,1080,1081,1084],{},[29,1082,1083],{},"Lokale Dateien"," — Ordner hinzufügen, einzelne Datei wählen, Dateinamen suchen, Rastervorschau, Ordner aus der Bibliothek entfernen",[26,1086,1087,1090,1091,1093],{},[29,1088,1089],{},"KLIPY"," — GIFs online suchen. Eigenen API-Key unter ",[29,1092,953],{},". Der Key landet nicht in Projektdateien.",[14,1095,1096],{},"Nach der Wahl Bild auf dem Button schieben und zuschneiden.",{"title":228,"searchDepth":229,"depth":229,"links":1098},[1099,1100,1101,1106,1107,1108,1109,1110,1111],{"id":735,"depth":229,"text":736},{"id":772,"depth":229,"text":773},{"id":806,"depth":229,"text":807,"children":1102},[1103,1104,1105],{"id":821,"depth":714,"text":822},{"id":856,"depth":714,"text":857},{"id":866,"depth":714,"text":867},{"id":910,"depth":229,"text":911},{"id":946,"depth":229,"text":947},{"id":963,"depth":229,"text":964},{"id":1015,"depth":229,"text":1016},{"id":1033,"depth":229,"text":1034},{"id":1060,"depth":229,"text":1061},"Tags, Filter, Tabs, Gruppen, Sortierung, Mehrfachauswahl, Lautstärke und Hotkeys.",{},4,"\u002Forganizing-sounds",{"title":703,"description":1112},"organizing-sounds","phia_N7HDS6LIgxhltoa9iRYViBzJ00ngFayO7YKdtQ",{"id":1120,"title":1121,"body":1122,"description":1246,"extension":237,"meta":1247,"navigation":