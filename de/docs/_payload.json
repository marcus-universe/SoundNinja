[{"data":1,"prerenderedAt":1310},["ShallowReactive",2],{"docs-page-de-\u002Foverview":3,"docs-nav-de":136},{"id":4,"title":5,"body":6,"description":127,"extension":128,"meta":129,"navigation":130,"order":131,"path":132,"seo":133,"stem":134,"__hash__":135},"content_de\u002Foverview.md","Überblick",{"type":7,"value":8,"toc":119},"minimark",[9,13,17,20,23,28,44,48,80,84,94,98],[10,11,5],"h1",{"id":12},"überblick",[14,15,16],"p",{},"SoundNinja ist ein Open-Source-Soundboard für Livestreams, Chats mit Freunden und Podcast-Aufnahmen. Es läuft auf Tauri v2 und Nuxt 4 und bleibt dabei sparsam mit RAM und Speicherplatz.",[14,18,19],{},"Das Ziel: eine große Sound-Bibliothek schnell scannen und den richtigen Clip in Millisekunden abspielen. Die Oberfläche eignet sich auch als Dashboard in VR.",[14,21,22],{},"SoundNinja steckt noch in der frühen Entwicklung. Funktionen laufen, aber nicht jede Plattform ist vollständig getestet.",[24,25,27],"h2",{"id":26},"für-wen","Für wen",[29,30,31,35,38,41],"ul",{},[32,33,34],"li",{},"Streamer, die sofortige Sound-Cues brauchen",[32,36,37],{},"Freunde, die ein gemeinsames Board für Voice-Chat wollen",[32,39,40],{},"Podcaster, die Clips aufnehmen und aufs Board legen",[32,42,43],{},"Alle, die ein anpassbares, lokales Soundboard wollen",[24,45,47],{"id":46},"was-du-tun-kannst","Was du tun kannst",[29,49,50,53,56,59,62,65,74,77],{},[32,51,52],{},"Ein Soundboard aus eigenen Audiodateien bauen",[32,54,55],{},"Sounds in farbigen Tabs, Gruppen und über die Suche sortieren",[32,57,58],{},"Das Aussehen mit dem Theme Creator gestalten",[32,60,61],{},"PC-Audio oder Mikrofon im Record Editor aufnehmen",[32,63,64],{},"Hotkeys einzelnen Sounds zuweisen",[32,66,67,68,73],{},"Sounds über ",[69,70,72],"a",{"href":71},"\u002Fdocs\u002Fremote-control","Bitfocus Companion"," auslösen",[32,75,76],{},"Ein komplettes Soundboard importieren und exportieren",[32,78,79],{},"GIFs oder Bilder auf Sound-Buttons legen",[24,81,83],{"id":82},"lizenz","Lizenz",[14,85,86,87,93],{},"SoundNinja ist freie Software unter ",[69,88,92],{"href":89,"rel":90},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fblob\u002Fmain\u002FLICENSE",[91],"nofollow","GPL-3.0",". Forken, ändern, teilen.",[24,95,97],{"id":96},"nächste-schritte","Nächste Schritte",[99,100,101,107,113],"ol",{},[32,102,103],{},[69,104,106],{"href":105},"\u002Fdocs\u002Finstallation","SoundNinja installieren",[32,108,109],{},[69,110,112],{"href":111},"\u002Fdocs\u002Fadding-sounds","Sounds hinzufügen",[32,114,115],{},[69,116,118],{"href":117},"\u002Fdocs\u002Forganizing-sounds","Board organisieren",{"title":120,"searchDepth":121,"depth":121,"links":122},"",2,[123,124,125,126],{"id":26,"depth":121,"text":27},{"id":46,"depth":121,"text":47},{"id":82,"depth":121,"text":83},{"id":96,"depth":121,"text":97},"Was SoundNinja ist und was du damit machen kannst.","md",{},true,1,"\u002Foverview",{"title":5,"description":127},"overview","k9vdLuByV0_2FJs4S1c2pJgDzzqDtddQcqK9KQYpZ8M",[137,213,413,559,712,847,990,1213],{"id":4,"title":5,"body":138,"description":127,"extension":128,"meta":211,"navigation":130,"order":131,"path":132,"seo":212,"stem":134,"__hash__":135},{"type":7,"value":139,"toc":205},[140,142,144,146,148,150,160,162,182,184,189,191],[10,141,5],{"id":12},[14,143,16],{},[14,145,19],{},[14,147,22],{},[24,149,27],{"id":26},[29,151,152,154,156,158],{},[32,153,34],{},[32,155,37],{},[32,157,40],{},[32,159,43],{},[24,161,47],{"id":46},[29,163,164,166,168,170,172,174,178,180],{},[32,165,52],{},[32,167,55],{},[32,169,58],{},[32,171,61],{},[32,173,64],{},[32,175,67,176,73],{},[69,177,72],{"href":71},[32,179,76],{},[32,181,79],{},[24,183,83],{"id":82},[14,185,86,186,93],{},[69,187,92],{"href":89,"rel":188},[91],[24,190,97],{"id":96},[99,192,193,197,201],{},[32,194,195],{},[69,196,106],{"href":105},[32,198,199],{},[69,200,112],{"href":111},[32,202,203],{},[69,204,118],{"href":117},{"title":120,"searchDepth":121,"depth":121,"links":206},[207,208,209,210],{"id":26,"depth":121,"text":27},{"id":46,"depth":121,"text":47},{"id":82,"depth":121,"text":83},{"id":96,"depth":121,"text":97},{},{"title":5,"description":127},{"id":214,"title":215,"body":216,"description":408,"extension":128,"meta":409,"navigation":130,"order":121,"path":410,"seo":411,"stem":220,"__hash__":412},"content_de\u002Finstallation.md","Installation",{"type":7,"value":217,"toc":401},[218,221,235,239,258,261,265,279,282,286,311,322,326,333,337,351,381,397],[10,219,215],{"id":220},"installation",[14,222,223,224,228,229,234],{},"Hol dir einen Build von der ",[69,225,227],{"href":226},"\u002Fdownload","Download-Seite"," oder von ",[69,230,233],{"href":231,"rel":232},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Freleases\u002Flatest",[91],"GitHub Releases",". SoundNinja ist in früher Entwicklung — behandle Builds als Beta.",[24,236,238],{"id":237},"windows","Windows",[29,240,241,252,255],{},[32,242,243,247,248,251],{},[244,245,246],"strong",{},"Installer (.exe)"," oder ",[244,249,250],{},"MSI (.msi)"," für 64-Bit-Windows",[32,253,254],{},"Landing-Page-Ziel: Windows 10 und neuer",[32,256,257],{},"Die App-README nennt auch Windows 8 und höher",[14,259,260],{},"Installer starten, dann SoundNinja über das Startmenü öffnen.",[24,262,264],{"id":263},"macos","macOS",[29,266,267,273,276],{},[32,268,269,272],{},[244,270,271],{},"Universelles .dmg"," für Apple Silicon und Intel",[32,274,275],{},"Landing-Page-Ziel: macOS 10.14 und neuer",[32,277,278],{},"Die App-README nennt macOS 10.15 und höher",[14,280,281],{},"Disk-Image öffnen und SoundNinja nach Programme ziehen.",[24,283,285],{"id":284},"linux","Linux",[29,287,288,294,300,308],{},[32,289,290,293],{},[244,291,292],{},"Debian (.deb)"," für Ubuntu \u002F Debian",[32,295,296,299],{},[244,297,298],{},"AppImage"," für andere Distros",[32,301,302,303,307],{},"Nach Veröffentlichung einer Release können Arch-Nutzer ",[304,305,306],"code",{},"soundninja-bin"," aus dem AUR installieren",[32,309,310],{},"Getestet unter Ubuntu 20.04",[14,312,313,314,317,318,321],{},"Desktop-Builds brauchen WebKit- und GTK-Pakete. Unter Debian\u002FUbuntu meist ",[304,315,316],{},"libwebkit2gtk",", ",[304,319,320],{},"libgtk-3-0"," und eine App-Indicator-Bibliothek.",[24,323,325],{"id":324},"updates","Updates",[14,327,328,329,332],{},"In der App: ",[244,330,331],{},"Hilfe → Nach Updates suchen",". Optional prüft SoundNinja beim Start in den Einstellungen.",[24,334,336],{"id":335},"aus-dem-quellcode-bauen","Aus dem Quellcode bauen",[14,338,339,340,317,345,350],{},"Eigenen Build? ",[69,341,344],{"href":342,"rel":343},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja",[91],"Repo klonen",[69,346,349],{"href":347,"rel":348},"https:\u002F\u002Fv2.tauri.app\u002Fstart\u002Fprerequisites\u002F",[91],"Tauri-Voraussetzungen"," installieren, dann:",[352,353,357],"pre",{"className":354,"code":355,"language":356,"meta":120,"style":120},"language-bash shiki shiki-themes github-light github-dark","bun install\nbun run tauri:serve\n","bash",[304,358,359,371],{"__ignoreMap":120},[360,361,363,367],"span",{"class":362,"line":131},"line",[360,364,366],{"class":365},"sScJk","bun",[360,368,370],{"class":369},"sZZnC"," install\n",[360,372,373,375,378],{"class":362,"line":121},[360,374,366],{"class":365},[360,376,377],{"class":369}," run",[360,379,380],{"class":369}," tauri:serve\n",[14,382,383,317,386,247,389,392,393,396],{},[304,384,385],{},"npm",[304,387,388],{},"pnpm",[304,390,391],{},"deno"," gehen auch. Produktionsbuild: ",[304,394,395],{},"bun run tauri:build",".",[398,399,400],"style",{},"html pre.shiki code .sScJk, html code.shiki .sScJk{--shiki-default:#6F42C1;--shiki-dark:#B392F0}html pre.shiki code .sZZnC, html code.shiki .sZZnC{--shiki-default:#032F62;--shiki-dark:#9ECBFF}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html.dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}",{"title":120,"searchDepth":121,"depth":121,"links":402},[403,404,405,406,407],{"id":237,"depth":121,"text":238},{"id":263,"depth":121,"text":264},{"id":284,"depth":121,"text":285},{"id":324,"depth":121,"text":325},{"id":335,"depth":121,"text":336},"SoundNinja unter Windows, macOS oder Linux installieren.",{},"\u002Finstallation",{"title":215,"description":408},"Djt_phX5yPzPpgqthAHl5cQnHy-U9ban07ufeARjtGI",{"id":414,"title":112,"body":415,"description":552,"extension":128,"meta":553,"navigation":130,"order":554,"path":555,"seo":556,"stem":557,"__hash__":558},"content_de\u002Fadding-sounds.md",{"type":7,"value":416,"toc":544},[417,420,423,427,444,448,479,483,502,506,520,523,527,534,538],[10,418,112],{"id":419},"sounds-hinzufügen",[14,421,422],{},"Ein Board bleibt leer, bis du Clips hinzufügst. SoundNinja importiert Dateien, ganze Ordner, eine Aufnahme oder ein geteiltes Soundboard-Paket.",[24,424,426],{"id":425},"audiodateien-importieren","Audiodateien importieren",[99,428,429,438,441],{},[32,430,431,247,434,437],{},[244,432,433],{},"Datei → Audiodateien importieren",[244,435,436],{},"Import"," in der Navbar.",[32,439,440],{},"Eine oder mehrere Audiodateien wählen.",[32,442,443],{},"Sounds landen im aktuellen Tab.",[24,445,447],{"id":446},"ordner-importieren","Ordner importieren",[99,449,450,459,462],{},[32,451,452,455,456,458],{},[244,453,454],{},"Datei → Ordner importieren"," (oder ",[244,457,447],{}," in der Navbar).",[32,460,461],{},"Einen oder mehrere Ordner hinzufügen. Vor dem Import per Drag neu sortieren.",[32,463,464,465],{},"Ziel wählen:\n",[29,466,467,473],{},[32,468,469,472],{},[244,470,471],{},"Als Tabs importieren"," — jeder Ordner wird ein eigener Tab",[32,474,475,478],{},[244,476,477],{},"In aktuellen Tab importieren"," — alle Dateien landen im aktiven Tab",[24,480,482],{"id":481},"clip-aufnehmen","Clip aufnehmen",[14,484,485,486,490,491,494,495,247,498,501],{},"Öffne den ",[69,487,489],{"href":488},"\u002Fdocs\u002Frecording-editor","Record Editor"," über ",[244,492,493],{},"Aufnahme"," in der Player-Leiste. Aufnehmen, zuschneiden, dann ",[244,496,497],{},"Auswahl importieren",[244,499,500],{},"Alle importieren"," in den aktuellen Tab oder einen gewählten Tab.",[24,503,505],{"id":504},"soundboard-importieren","Soundboard importieren",[14,507,508,511,512,515,516,519],{},[244,509,510],{},"Datei → Soundboard importieren"," lädt ein geteiltes Paket. Pakete sind ein ",[304,513,514],{},".zip"," mit ",[304,517,518],{},"project.sninja"," plus Sounddateien. Danach Projekt öffnen und abspielen.",[14,521,522],{},"Du kannst mehrere Projekte (Profile) halten. Über den Projektwähler zwischen Boards wechseln.",[24,524,526],{"id":525},"fehlende-dateien-neu-verknüpfen","Fehlende Dateien neu verknüpfen",[14,528,529,530,533],{},"Wenn Audiodateien auf der Festplatte umziehen, zeigt SoundNinja ",[244,531,532],{},"Fehlende Sounddateien",". Einen Suchordner wählen und Clips neu verknüpfen.",[24,535,537],{"id":536},"weiter","Weiter",[14,539,540,541,396],{},"Tabs, Gruppen und Hotkeys: ",[69,542,543],{"href":117},"Sounds organisieren",{"title":120,"searchDepth":121,"depth":121,"links":545},[546,547,548,549,550,551],{"id":425,"depth":121,"text":426},{"id":446,"depth":121,"text":447},{"id":481,"depth":121,"text":482},{"id":504,"depth":121,"text":505},{"id":525,"depth":121,"text":526},{"id":536,"depth":121,"text":537},"Audio, Ordner, Aufnahmen und geteilte Soundboards importieren.",{},3,"\u002Fadding-sounds",{"title":112,"description":552},"adding-sounds","qhheWryk-vrNfEsQyZSumTndjdSmJPmEctxDG9Gyulk",{"id":560,"title":543,"body":561,"description":705,"extension":128,"meta":706,"navigation":130,"order":707,"path":708,"seo":709,"stem":710,"__hash__":711},"content_de\u002Forganizing-sounds.md",{"type":7,"value":562,"toc":696},[563,566,569,573,599,606,610,613,627,634,638,643,647,658,662,665,669,672,678,684,688],[10,564,543],{"id":565},"sounds-organisieren",[14,567,568],{},"SoundNinja ist für große Bibliotheken gebaut. Tabs, Gruppen, Suche und Hotkeys — der Clip ist einen Klick (oder eine Taste) entfernt.",[24,570,572],{"id":571},"tabs","Tabs",[29,574,575,582,589],{},[32,576,577,578,581],{},"Tab mit ",[244,579,580],{},"Tab hinzufügen"," anlegen. Farbe vergeben, damit die Leiste schnell scannbar bleibt.",[32,583,584,585,588],{},"Die Ansicht ",[244,586,587],{},"Alle"," zeigt jeden Sound über alle Tabs.",[32,590,591,592,595,596,396],{},"Ein Sound kann ",[244,593,594],{},"einem oder mehreren Tabs"," gehören. Rechtsklick → ",[244,597,598],{},"Zu Tab verschieben",[14,600,601,602,605],{},"Tab-Übergänge: ",[244,603,604],{},"Einstellungen → Allgemein"," — Slide, Fade, Buttons nacheinander oder Keine.",[24,607,609],{"id":608},"gruppen","Gruppen",[14,611,612],{},"Seit v0.5.3 können Trenner zu benannten Gruppen werden:",[29,614,615,618,621,624],{},[32,616,617],{},"Gruppe über das Kontextmenü hinzufügen, umbenennen oder entfernen",[32,619,620],{},"Gruppenkopf ziehen — Kinder kommen mit",[32,622,623],{},"Sounds in eine Gruppe legen oder herausnehmen",[32,625,626],{},"Rahmenfarbe, Namensfarbe und Button-Ausrichtung setzen (oder Tab-Standard nutzen)",[14,628,629,630,633],{},"Ein einfacher ",[244,631,632],{},"Trenner"," geht weiter, wenn du nur einen visuellen Bruch brauchst.",[24,635,637],{"id":636},"suche","Suche",[14,639,640,642],{},[244,641,637],{}," in der Navbar. Ergebnisse folgen der Eingabe.",[24,644,646],{"id":645},"neu-anordnen","Neu anordnen",[14,648,649,650,653,654,657],{},"Drag-and-Drop in ",[244,651,652],{},"Einstellungen → Verhalten"," einschalten (",[244,655,656],{},"Neu anordnen erlauben","). Dann Sounds und Gruppen ziehen.",[24,659,661],{"id":660},"sammelbearbeitung","Sammelbearbeitung",[14,663,664],{},"Mehrere Sounds markieren, dann Farbe ändern, in einen Tab schieben oder löschen.",[24,666,668],{"id":667},"hotkeys-und-sound-ids","Hotkeys und Sound-IDs",[14,670,671],{},"Jeder Sound hat eine 8-stellige ID. Kopieren über das Button-Kontextmenü oder den Mehrfachauswahl-Chip.",[14,673,674,677],{},[244,675,676],{},"Einstellungen → Hotkeys",": Taste an eine Sound-ID binden. Globale Hotkeys sind optional.",[14,679,680,681,683],{},"Dieselbe ID nutzt ",[69,682,72],{"href":71}," zum Auslösen.",[24,685,687],{"id":686},"gifs-und-farben","GIFs und Farben",[14,689,690,691,695],{},"Rechtsklick auf einen Sound: eigene Farben oder GIF-\u002FBildhintergrund. Das ist getrennt vom ",[69,692,694],{"href":693},"\u002Fdocs\u002Ftheme-editor","Theme Creator",", der das ganze Board gestaltet.",{"title":120,"searchDepth":121,"depth":121,"links":697},[698,699,700,701,702,703,704],{"id":571,"depth":121,"text":572},{"id":608,"depth":121,"text":609},{"id":636,"depth":121,"text":637},{"id":645,"depth":121,"text":646},{"id":660,"depth":121,"text":661},{"id":667,"depth":121,"text":668},{"id":686,"depth":121,"text":687},"Tabs, Gruppen, Suche, Sammelbearbeitung und Hotkeys.",{},4,"\u002Forganizing-sounds",{"title":543,"description":705},"organizing-sounds","tzbjT1L04eFyKK0nuKEVqrhA0oH5iyG-Pq9SkxEWh1w",{"id":713,"title":714,"body":715,"description":841,"extension":128,"meta":842,"navigation":130,"order":843,"path":844,"seo":845,"stem":719,"__hash__":846},"content_de\u002Ftheme-editor.md","Theme-Editor",{"type":7,"value":716,"toc":835},[717,720,726,730,757,760,764,778,782,808,811,815,821],[10,718,714],{"id":719},"theme-editor",[14,721,