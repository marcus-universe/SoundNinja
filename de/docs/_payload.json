[{"data":1,"prerenderedAt":1599},["ShallowReactive",2],{"docs-page-de-\u002Foverview":3,"docs-nav-de":145},{"id":4,"title":5,"body":6,"description":136,"extension":137,"meta":138,"navigation":139,"order":140,"path":141,"seo":142,"stem":143,"__hash__":144},"content_de\u002Foverview.md","Überblick",{"type":7,"value":8,"toc":128},"minimark",[9,13,17,20,23,28,44,48,89,93,103,107],[10,11,5],"h1",{"id":12},"überblick",[14,15,16],"p",{},"SoundNinja ist ein Open-Source-Soundboard für Livestreams, Chats mit Freunden und Podcast-Aufnahmen. Es läuft auf Tauri v2 und Nuxt 4 und bleibt dabei sparsam mit RAM und Speicherplatz.",[14,18,19],{},"Das Ziel: eine große Sound-Bibliothek schnell scannen und den richtigen Clip in Millisekunden abspielen. Die Oberfläche eignet sich auch als Dashboard in VR.",[14,21,22],{},"SoundNinja steckt noch in der frühen Entwicklung. Funktionen laufen, aber nicht jede Plattform ist vollständig getestet.",[24,25,27],"h2",{"id":26},"für-wen","Für wen",[29,30,31,35,38,41],"ul",{},[32,33,34],"li",{},"Streamer, die sofortige Sound-Cues brauchen",[32,36,37],{},"Freunde, die ein gemeinsames Board für Voice-Chat wollen",[32,39,40],{},"Podcaster, die Clips aufnehmen und aufs Board legen",[32,42,43],{},"Alle, die ein anpassbares, lokales Soundboard wollen",[24,45,47],{"id":46},"was-du-tun-kannst","Was du tun kannst",[29,49,50,53,56,59,62,65,68,71,74,83,86],{},[32,51,52],{},"Ein Soundboard aus eigenen Audiodateien bauen",[32,54,55],{},"Sounds in farbigen Tabs, Gruppen, Tags und über die Suche sortieren",[32,57,58],{},"Nach Tags filtern (ODER) und nach Name, Datum, Dauer oder Größe sortieren",[32,60,61],{},"Mehrfachauswahl mit Rahmen oder Shift-Bereich, dann Farbe, Tab oder Löschen in einem Rutsch",[32,63,64],{},"Lautstärke pro Sound im Kontextmenü setzen",[32,66,67],{},"Das Aussehen mit dem Theme Creator gestalten",[32,69,70],{},"PC-Audio oder Mikrofon im Record Editor aufnehmen",[32,72,73],{},"Hotkeys einzelnen Sounds zuweisen",[32,75,76,77,82],{},"Sounds über ",[78,79,81],"a",{"href":80},"\u002Fdocs\u002Fremote-control","Bitfocus Companion"," auslösen",[32,84,85],{},"Ein komplettes Soundboard importieren und exportieren",[32,87,88],{},"GIFs oder Bilder auf Sound-Buttons legen — aus lokaler Ordnerbibliothek oder KLIPY",[24,90,92],{"id":91},"lizenz","Lizenz",[14,94,95,96,102],{},"SoundNinja ist freie Software unter ",[78,97,101],{"href":98,"rel":99},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fblob\u002Fmain\u002FLICENSE",[100],"nofollow","GPL-3.0",". Forken, ändern, teilen.",[24,104,106],{"id":105},"nächste-schritte","Nächste Schritte",[108,109,110,116,122],"ol",{},[32,111,112],{},[78,113,115],{"href":114},"\u002Fdocs\u002Finstallation","SoundNinja installieren",[32,117,118],{},[78,119,121],{"href":120},"\u002Fdocs\u002Fadding-sounds","Sounds hinzufügen",[32,123,124],{},[78,125,127],{"href":126},"\u002Fdocs\u002Forganizing-sounds","Board organisieren",{"title":129,"searchDepth":130,"depth":130,"links":131},"",2,[132,133,134,135],{"id":26,"depth":130,"text":27},{"id":46,"depth":130,"text":47},{"id":91,"depth":130,"text":92},{"id":105,"depth":130,"text":106},"Was SoundNinja ist und was du damit machen kannst.","md",{},true,1,"\u002Foverview",{"title":5,"description":136},"overview","hoyfMBw8UK5RuLBAbdnmSxP4gC163p8E8rvJgSihSXE",[146,228,452,598,998,1132,1279,1502],{"id":4,"title":5,"body":147,"description":136,"extension":137,"meta":226,"navigation":139,"order":140,"path":141,"seo":227,"stem":143,"__hash__":144},{"type":7,"value":148,"toc":220},[149,151,153,155,157,159,169,171,197,199,204,206],[10,150,5],{"id":12},[14,152,16],{},[14,154,19],{},[14,156,22],{},[24,158,27],{"id":26},[29,160,161,163,165,167],{},[32,162,34],{},[32,164,37],{},[32,166,40],{},[32,168,43],{},[24,170,47],{"id":46},[29,172,173,175,177,179,181,183,185,187,189,193,195],{},[32,174,52],{},[32,176,55],{},[32,178,58],{},[32,180,61],{},[32,182,64],{},[32,184,67],{},[32,186,70],{},[32,188,73],{},[32,190,76,191,82],{},[78,192,81],{"href":80},[32,194,85],{},[32,196,88],{},[24,198,92],{"id":91},[14,200,95,201,102],{},[78,202,101],{"href":98,"rel":203},[100],[24,205,106],{"id":105},[108,207,208,212,216],{},[32,209,210],{},[78,211,115],{"href":114},[32,213,214],{},[78,215,121],{"href":120},[32,217,218],{},[78,219,127],{"href":126},{"title":129,"searchDepth":130,"depth":130,"links":221},[222,223,224,225],{"id":26,"depth":130,"text":27},{"id":46,"depth":130,"text":47},{"id":91,"depth":130,"text":92},{"id":105,"depth":130,"text":106},{},{"title":5,"description":136},{"id":229,"title":230,"body":231,"description":447,"extension":137,"meta":448,"navigation":139,"order":130,"path":449,"seo":450,"stem":235,"__hash__":451},"content_de\u002Finstallation.md","Installation",{"type":7,"value":232,"toc":440},[233,236,250,254,276,279,283,297,300,304,329,340,344,351,355,369,399,415,436],[10,234,230],{"id":235},"installation",[14,237,238,239,243,244,249],{},"Hol dir einen Build von der ",[78,240,242],{"href":241},"\u002Fdownload","Download-Seite"," oder von ",[78,245,248],{"href":246,"rel":247},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Freleases\u002Flatest",[100],"GitHub Releases",". SoundNinja ist in früher Entwicklung — behandle Builds als Beta.",[24,251,253],{"id":252},"windows","Windows",[29,255,256,267,270,273],{},[32,257,258,262,263,266],{},[259,260,261],"strong",{},"Installer (.exe)"," oder ",[259,264,265],{},"MSI (.msi)"," für 64-Bit-Windows",[32,268,269],{},"Landing-Page-Ziel: Windows 10 und neuer",[32,271,272],{},"Die App-README nennt auch Windows 8 und höher",[32,274,275],{},"Der NSIS-Installer ist dunkel. Sprache beim Setup wählen — SoundNinja merkt sie beim nächsten Start.",[14,277,278],{},"Installer starten, dann SoundNinja über das Startmenü öffnen.",[24,280,282],{"id":281},"macos","macOS",[29,284,285,291,294],{},[32,286,287,290],{},[259,288,289],{},"Universelles .dmg"," für Apple Silicon und Intel",[32,292,293],{},"Landing-Page-Ziel: macOS 10.14 und neuer",[32,295,296],{},"Die App-README nennt macOS 10.15 und höher",[14,298,299],{},"Disk-Image öffnen und SoundNinja nach Programme ziehen.",[24,301,303],{"id":302},"linux","Linux",[29,305,306,312,318,326],{},[32,307,308,311],{},[259,309,310],{},"Debian (.deb)"," für Ubuntu \u002F Debian",[32,313,314,317],{},[259,315,316],{},"AppImage"," für andere Distros",[32,319,320,321,325],{},"Nach Veröffentlichung einer Release können Arch-Nutzer ",[322,323,324],"code",{},"soundninja-bin"," aus dem AUR installieren",[32,327,328],{},"Getestet unter Ubuntu 20.04",[14,330,331,332,335,336,339],{},"Desktop-Builds brauchen WebKit- und GTK-Pakete. Unter Debian\u002FUbuntu meist ",[322,333,334],{},"libwebkit2gtk",", ",[322,337,338],{},"libgtk-3-0"," und eine App-Indicator-Bibliothek.",[24,341,343],{"id":342},"updates","Updates",[14,345,346,347,350],{},"In der App: ",[259,348,349],{},"Hilfe → Nach Updates suchen",". Optional prüft SoundNinja beim Start in den Einstellungen.",[24,352,354],{"id":353},"aus-dem-quellcode-bauen","Aus dem Quellcode bauen",[14,356,357,358,335,363,368],{},"Eigenen Build? ",[78,359,362],{"href":360,"rel":361},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja",[100],"Repo klonen",[78,364,367],{"href":365,"rel":366},"https:\u002F\u002Fv2.tauri.app\u002Fstart\u002Fprerequisites\u002F",[100],"Tauri-Voraussetzungen"," installieren, dann:",[370,371,375],"pre",{"className":372,"code":373,"language":374,"meta":129,"style":129},"language-bash shiki shiki-themes github-light github-dark","bun install\nbun run tauri:serve\n","bash",[322,376,377,389],{"__ignoreMap":129},[378,379,381,385],"span",{"class":380,"line":140},"line",[378,382,384],{"class":383},"sScJk","bun",[378,386,388],{"class":387},"sZZnC"," install\n",[378,390,391,393,396],{"class":380,"line":130},[378,392,384],{"class":383},[378,394,395],{"class":387}," run",[378,397,398],{"class":387}," tauri:serve\n",[14,400,401,335,404,262,407,410,411,414],{},[322,402,403],{},"npm",[322,405,406],{},"pnpm",[322,408,409],{},"deno"," gehen auch. Produktionsbuild: ",[322,412,413],{},"bun run tauri:build",".",[14,416,417,420,421,426,427,430,431,414],{},[259,418,419],{},"Nur Windows:"," jeder Windows-Compile enthält ASIO über das ",[78,422,425],{"href":423,"rel":424},"https:\u002F\u002Fwww.steinberg.net\u002Fasiosdk",[100],"Steinberg ASIO SDK",". Einmal ",[322,428,429],{},"bun run setup:asio"," (SDK nicht im Git). Linux und macOS nutzen PipeWire \u002F Core Audio — diesen Schritt überspringen. Details: ",[78,432,435],{"href":433,"rel":434},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fblob\u002Fmain\u002Fdocs\u002Fbuild-from-source.md",[100],"build-from-source.md",[437,438,439],"style",{},"html pre.shiki code .sScJk, html code.shiki .sScJk{--shiki-default:#6F42C1;--shiki-dark:#B392F0}html pre.shiki code .sZZnC, html code.shiki .sZZnC{--shiki-default:#032F62;--shiki-dark:#9ECBFF}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html.dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}",{"title":129,"searchDepth":130,"depth":130,"links":441},[442,443,444,445,446],{"id":252,"depth":130,"text":253},{"id":281,"depth":130,"text":282},{"id":302,"depth":130,"text":303},{"id":342,"depth":130,"text":343},{"id":353,"depth":130,"text":354},"SoundNinja unter Windows, macOS oder Linux installieren.",{},"\u002Finstallation",{"title":230,"description":447},"OPh-0WbR2ebU9niw-poNeR6zaGWqUJm2ONgxhb61JBU",{"id":453,"title":121,"body":454,"description":591,"extension":137,"meta":592,"navigation":139,"order":593,"path":594,"seo":595,"stem":596,"__hash__":597},"content_de\u002Fadding-sounds.md",{"type":7,"value":455,"toc":583},[456,459,462,466,483,487,518,522,541,545,559,562,566,573,577],[10,457,121],{"id":458},"sounds-hinzufügen",[14,460,461],{},"Ein Board bleibt leer, bis du Clips hinzufügst. SoundNinja importiert Dateien, ganze Ordner, eine Aufnahme oder ein geteiltes Soundboard-Paket.",[24,463,465],{"id":464},"audiodateien-importieren","Audiodateien importieren",[108,467,468,477,480],{},[32,469,470,262,473,476],{},[259,471,472],{},"Datei → Audiodateien importieren",[259,474,475],{},"Import"," in der Navbar.",[32,478,479],{},"Eine oder mehrere Audiodateien wählen.",[32,481,482],{},"Sounds landen im aktuellen Tab.",[24,484,486],{"id":485},"ordner-importieren","Ordner importieren",[108,488,489,498,501],{},[32,490,491,494,495,497],{},[259,492,493],{},"Datei → Ordner importieren"," (oder ",[259,496,486],{}," in der Navbar).",[32,499,500],{},"Einen oder mehrere Ordner hinzufügen. Vor dem Import per Drag neu sortieren.",[32,502,503,504],{},"Ziel wählen:\n",[29,505,506,512],{},[32,507,508,511],{},[259,509,510],{},"Als Tabs importieren"," — jeder Ordner wird ein eigener Tab",[32,513,514,517],{},[259,515,516],{},"In aktuellen Tab importieren"," — alle Dateien landen im aktiven Tab",[24,519,521],{"id":520},"clip-aufnehmen","Clip aufnehmen",[14,523,524,525,529,530,533,534,262,537,540],{},"Öffne den ",[78,526,528],{"href":527},"\u002Fdocs\u002Frecording-editor","Record Editor"," über ",[259,531,532],{},"Aufnahme"," in der Player-Leiste. Aufnehmen, zuschneiden, dann ",[259,535,536],{},"Auswahl importieren",[259,538,539],{},"Alle importieren"," in den aktuellen Tab oder einen gewählten Tab.",[24,542,544],{"id":543},"soundboard-importieren","Soundboard importieren",[14,546,547,550,551,554,555,558],{},[259,548,549],{},"Datei → Soundboard importieren"," lädt ein geteiltes Paket. Pakete sind ein ",[322,552,553],{},".zip"," mit ",[322,556,557],{},"project.sninja"," plus Sounddateien. Danach Projekt öffnen und abspielen.",[14,560,561],{},"Du kannst mehrere Projekte (Profile) halten. Über den Projektwähler zwischen Boards wechseln.",[24,563,565],{"id":564},"fehlende-dateien-neu-verknüpfen","Fehlende Dateien neu verknüpfen",[14,567,568,569,572],{},"Wenn Audiodateien auf der Festplatte umziehen, zeigt SoundNinja ",[259,570,571],{},"Fehlende Sounddateien",". Einen Suchordner wählen und Clips neu verknüpfen.",[24,574,576],{"id":575},"weiter","Weiter",[14,578,579,580,414],{},"Tabs, Tags, Filter und Hotkeys: ",[78,581,582],{"href":126},"Sounds organisieren",{"title":129,"searchDepth":130,"depth":130,"links":584},[585,586,587,588,589,590],{"id":464,"depth":130,"text":465},{"id":485,"depth":130,"text":486},{"id":520,"depth":130,"text":521},{"id":543,"depth":130,"text":544},{"id":564,"depth":130,"text":565},{"id":575,"depth":130,"text":576},"Audio, Ordner, Aufnahmen und geteilte Soundboards importieren.",{},3,"\u002Fadding-sounds",{"title":121,"description":591},"adding-sounds","H_ls9_vOwDkgTWPkfe9bQz1A0XidUOmMFV4V2EJpYec",{"id":599,"title":582,"body":600,"description":991,"extension":137,"meta":992,"navigation":139,"order":993,"path":994,"seo":995,"stem":996,"__hash__":997},"content_de\u002Forganizing-sounds.md",{"type":7,"value":601,"toc":976},[602,605,612,616,642,649,653,656,670,677,683,687,697,702,733,737,743,747,781,787,791,794,820,823,827,840,844,849,869,885,892,896,907,910,914,921,931,937,941,949,956,973],[10,603,582],{"id":604},"sounds-organisieren",[14,606,607,608,611],{},"SoundNinja ist für große Bibliotheken gebaut. ",[259,609,610],{},"Tags und Filter",", Tabs, Suche, Mehrfachauswahl und Hotkeys — der Clip ist einen Klick (oder eine Taste) entfernt.",[24,613,615],{"id":614},"tabs","Tabs",[29,617,618,625,632],{},[32,619,620,621,624],{},"Tab mit ",[259,622,623],{},"Tab hinzufügen"," anlegen. Farbe vergeben, damit die Leiste schnell scannbar bleibt.",[32,626,627,628,631],{},"Die Ansicht ",[259,629,630],{},"Alle"," zeigt jeden Sound über alle Tabs.",[32,633,634,635,638,639,414],{},"Ein Sound kann ",[259,636,637],{},"einem oder mehreren Tabs"," gehören. Rechtsklick → ",[259,640,641],{},"Zu Tab verschieben",[14,643,644,645,648],{},"Tab-Übergänge: ",[259,646,647],{},"Einstellungen → Allgemein"," — Slide, Fade, Buttons nacheinander oder Keine.",[24,650,652],{"id":651},"gruppen","Gruppen",[14,654,655],{},"Seit v0.5.3 können Trenner zu benannten Gruppen werden:",[29,657,658,661,664,667],{},[32,659,660],{},"Gruppe über das Kontextmenü hinzufügen, umbenennen oder entfernen",[32,662,663],{},"Gruppenkopf ziehen — Kinder kommen mit",[32,665,666],{},"Sounds in eine Gruppe legen oder herausnehmen",[32,668,669],{},"Rahmenfarbe, Namensfarbe und Button-Ausrichtung setzen (oder Tab-Standard nutzen)",[14,671,672,673,676],{},"Ein einfacher ",[259,674,675],{},"Trenner"," geht weiter, wenn du nur einen visuellen Bruch brauchst.",[14,678,679,680,414],{},"Rechtsklick auf leeren Board-Bereich: ",[259,681,682],{},"Gruppe hinzufügen",[24,684,686],{"id":685},"tags-filter","Tags \u002F Filter",[14,688,689,690,693,694,696],{},"Tags gelten tabübergreifend. Das ausfahrbare ",[259,691,692],{},"Filter","-Panel (Sidebar ",[259,695,692],{},") ist der Ort zum Anlegen und zum Filtern des Boards.",[698,699,701],"h3",{"id":700},"tags-anlegen-und-bearbeiten","Tags anlegen und bearbeiten",[108,703,704,709,720,726],{},[32,705,706,708],{},[259,707,692],{}," in der Sidebar öffnen.",[32,710,711,712,715,716,719],{},"Unter ",[259,713,714],{},"Tags"," → ",[259,717,718],{},"Tag hinzufügen"," — Name und Farbe vergeben.",[32,721,722,723,414],{},"Im selben Panel umbenennen, umfärben oder ",[259,724,725],{},"Tag löschen",[32,727,728,729,732],{},"Steht da ",[259,730,731],{},"Noch keine Tags",", zuerst hier einen anlegen, bevor du zuweist.",[698,734,736],{"id":735},"tags-an-sounds-hängen","Tags an Sounds hängen",[14,738,739,740,742],{},"Rechtsklick auf einen Sound → ",[259,741,714],{}," (Checkboxen). Ein Sound darf mehrere Tags haben. Existieren noch keine, zeigt das Menü den Weg zum Filter-Panel.",[698,744,746],{"id":745},"board-filtern","Board filtern",[29,748,749,756,767,778],{},[32,750,751,752,755],{},"Tags im Filter-Panel oder als ",[259,753,754],{},"Chips unter der Suchleiste"," umschalten.",[32,757,758,759,762,763,766],{},"Abgleich ist ",[259,760,761],{},"ODER",": ein Sound bleibt sichtbar, wenn er ",[259,764,765],{},"irgendeinen"," gewählten Tag hat.",[32,768,769,770,773,774,777],{},"Das Feld ",[259,771,772],{},"Suche"," in der Navbar kombiniert per ",[259,775,776],{},"UND"," mit dem aktiven Tag-Filter (Tippen + Tags zusammen).",[32,779,780],{},"Chips aus (oder Filter leeren), um den ganzen Tab wieder zu sehen.",[14,782,783,784,414],{},"Farbige Tag-Namen können auf Buttons erscheinen. Schalter: ",[259,785,786],{},"Einstellungen → Verhalten → Tag-Badges anzeigen",[24,788,790],{"id":789},"sortierung","Sortierung",[14,792,793],{},"Im Filter-Panel eine Sortierung wählen:",[29,795,796,802],{},[32,797,798,801],{},[259,799,800],{},"Benutzerdefiniert"," — deine Tab-Reihenfolge, Gruppen sichtbar",[32,803,804,335,807,335,810,262,813,816,817],{},[259,805,806],{},"Name",[259,808,809],{},"Hinzugefügt",[259,811,812],{},"Spielzeit",[259,814,815],{},"Dateigröße"," — flache sortierte Liste; ",[259,818,819],{},"Gruppen sind ausgeblendet",[14,821,822],{},"Sortierung nach Dauer kann beim ersten Mal die Dauer-Metadaten vorwärmen.",[24,824,826],{"id":825},"neu-anordnen","Neu anordnen",[14,828,829,830,833,834,837,838,414],{},"Drag-and-Drop in ",[259,831,832],{},"Einstellungen → Verhalten"," einschalten (",[259,835,836],{},"Neu anordnen erlauben","). Dann Sounds und Gruppen ziehen. Neu anordnen gilt bei ",[259,839,800],{},[24,841,843],{"id":842},"mehrfachauswahl","Mehrfachauswahl",[14,845,846,848],{},[259,847,843],{}," in der Navbar einschalten, dann:",[29,850,851,854,860,866],{},[32,852,853],{},"Klick toggelt einen Sound",[32,855,856,859],{},[259,857,858],{},"Shift+Klick"," wählt einen Bereich ab dem letzten Anker",[32,861,862,865],{},[259,863,864],{},"Rahmen"," auf leerem Board ziehen",[32,867,868],{},"Klick auf leeres Board (oder außerhalb) leert die Auswahl",[14,870,871,872,335,875,335,878,881,882,414],{},"Eine Sammelleiste zeigt die Anzahl plus ",[259,873,874],{},"Farbe",[259,876,877],{},"Zu Tab verschieben…",[259,879,880],{},"Löschen"," und ",[259,883,884],{},"Fertig",[14,886,887,888,891],{},"In der Mehrfachauswahl zeigt jeder Button einen ",[259,889,890],{},"8-Zeichen-ID-Chip",". Rechtsklick auf den Chip kopiert die ID.",[24,893,895],{"id":894},"lautstärke-pro-sound","Lautstärke pro Sound",[14,897,898,899,902,903,906],{},"Rechtsklick → ",[259,900,901],{},"Lautstärke",". Slider von 0 % bis 100 %. ",[259,904,905],{},"Doppelklick"," setzt auf 100 % zurück.",[14,908,909],{},"Das stapelt sich mit der Master-Ausgangslautstärke in den Einstellungen.",[24,911,913],{"id":912},"hotkeys-und-sound-ids","Hotkeys und Sound-IDs",[14,915,916,917,920],{},"Jeder Sound hat eine 8-stellige ID. Kopieren über das Button-Kontextmenü (",[259,918,919],{},"ID kopieren",") oder den Mehrfachauswahl-Chip.",[14,922,923,926,927,930],{},[259,924,925],{},"Einstellungen → Hotkeys",": Taste an eine Sound-ID binden. Globale Hotkeys sind optional. ",[259,928,929],{},"Hotkey zuweisen"," im Kontextmenü springt dorthin, ID vorausgefüllt.",[14,932,933,934,936],{},"Dieselbe ID nutzt ",[78,935,81],{"href":80}," zum Auslösen.",[24,938,940],{"id":939},"hintergrundbilder-und-farben","Hintergrundbilder und Farben",[14,942,943,944,948],{},"Rechtsklick auf einen Sound: eigene Farben oder ein Hintergrundbild. Das ist getrennt vom ",[78,945,947],{"href":946},"\u002Fdocs\u002Ftheme-editor","Theme Creator",", der das ganze Board gestaltet.",[14,950,951,952,955],{},"Der Picker ist ein Dialog ",[259,953,954],{},"Hintergrundbild"," (PNG, JPEG, GIF, WebP):",[29,957,958,964],{},[32,959,960,963],{},[259,961,962],{},"Lokale Dateien"," — Ordner hinzufügen, einzelne Datei wählen, Dateinamen suchen, Rastervorschau, Ordner aus der Bibliothek entfernen",[32,965,966,969,970,972],{},[259,967,968],{},"KLIPY"," — GIFs online suchen. Eigenen API-Key unter ",[259,971,832],{},". Der Key landet nicht in Projektdateien.",[14,974,975],{},"Nach der Wahl Bild auf dem Button schieben und zuschneiden.",{"title":129,"searchDepth":130,"depth":130,"links":977},[978,979,980,985,986,987,988,989,990],{"id":614,"depth":130,"text":615},{"id":651,"depth":130,"text":652},{"id":685,"depth":130,"text":686,"children":981},[982,983,984],{"id":700,"depth":593,"text":701},{"id":735,"depth":593,"text":736},{"id":745,"depth":593,"text":746},{"id":789,"depth":130,"text":790},{"id":825,"depth":130,"text":826},{"id":842,"depth":130,"text":843},{"id":894,"depth":130,"text":895},{"id":912,"depth":130,"text":913},{"id":939,"depth":130,"text":940},"Tags, Filter, Tabs, Gruppen, Sortierung, Mehrfachauswahl, Lautstärke und Hotkeys.",{},4,"\u002Forganizing-sounds",{"title":582,"description":991},"organizing-sounds","phia_N7HDS6LIgxhltoa9iRYViBzJ00ngFayO7YKdtQ",{"id":999,"title":1000,"body":1001,"description":1126,"extension":137,"meta":1127,"navigation":139,"order":1128,"path":1129,"seo":1130,"stem":1005,"__hash__":1131},"content_de\u002Ftheme-editor.md","Theme-Editor",{"type":7,"value":1002,"toc":1120},[1003,1006,1012,1016,1043,1046,1050,1064,1068,1094,1097,1101,1106],[10,1004,1000],{"id":1005},"theme-editor",[14,1007,1008,1009,414],{},"Der Theme Creator ist der volle visuelle Editor für dein Board. Öffnen über ",[259,1010,1011],{},"Einstellungen → Allgemein → Theme Creator",[24,1013,1015],{"id":1014},"drei-tabs","Drei Tabs",[108,1017,1018,1032,1038],{},[32,1019,1020,1023,1024,1027,1028,1031],{},[259,1021,1022],{},"Allgemein"," — Theme-Name, gemeinsame Farben und 