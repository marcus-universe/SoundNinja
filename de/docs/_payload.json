[{"data":1,"prerenderedAt":1578},["ShallowReactive",2],{"docs-page-de-\u002Foverview":3,"docs-nav-de":145},{"id":4,"title":5,"body":6,"description":136,"extension":137,"meta":138,"navigation":139,"order":140,"path":141,"seo":142,"stem":143,"__hash__":144},"content_de\u002Foverview.md","Überblick",{"type":7,"value":8,"toc":128},"minimark",[9,13,17,20,23,28,44,48,89,93,103,107],[10,11,5],"h1",{"id":12},"überblick",[14,15,16],"p",{},"SoundNinja ist ein Open-Source-Soundboard für Livestreams, Chats mit Freunden und Podcast-Aufnahmen. Es läuft auf Tauri v2 und Nuxt 4 und bleibt dabei sparsam mit RAM und Speicherplatz.",[14,18,19],{},"Das Ziel: eine große Sound-Bibliothek schnell scannen und den richtigen Clip in Millisekunden abspielen. Die Oberfläche eignet sich auch als Dashboard in VR.",[14,21,22],{},"SoundNinja steckt noch in der frühen Entwicklung. Funktionen laufen, aber nicht jede Plattform ist vollständig getestet.",[24,25,27],"h2",{"id":26},"für-wen","Für wen",[29,30,31,35,38,41],"ul",{},[32,33,34],"li",{},"Streamer, die sofortige Sound-Cues brauchen",[32,36,37],{},"Freunde, die ein gemeinsames Board für Voice-Chat wollen",[32,39,40],{},"Podcaster, die Clips aufnehmen und aufs Board legen",[32,42,43],{},"Alle, die ein anpassbares, lokales Soundboard wollen",[24,45,47],{"id":46},"was-du-tun-kannst","Was du tun kannst",[29,49,50,53,56,59,62,65,68,71,74,83,86],{},[32,51,52],{},"Ein Soundboard aus eigenen Audiodateien bauen",[32,54,55],{},"Sounds in farbigen Tabs, Gruppen, Tags und über die Suche sortieren",[32,57,58],{},"Nach Tags filtern (ODER) und nach Name, Datum, Dauer oder Größe sortieren",[32,60,61],{},"Mehrfachauswahl mit Rahmen oder Shift-Bereich, dann Farbe, Tab oder Löschen in einem Rutsch",[32,63,64],{},"Lautstärke pro Sound im Kontextmenü setzen",[32,66,67],{},"Das Aussehen mit dem Theme Creator gestalten",[32,69,70],{},"PC-Audio oder Mikrofon im Record Editor aufnehmen",[32,72,73],{},"Hotkeys einzelnen Sounds zuweisen",[32,75,76,77,82],{},"Sounds über ",[78,79,81],"a",{"href":80},"\u002Fdocs\u002Fremote-control","Bitfocus Companion"," auslösen",[32,84,85],{},"Ein komplettes Soundboard importieren und exportieren",[32,87,88],{},"GIFs oder Bilder auf Sound-Buttons legen — aus lokaler Ordnerbibliothek oder KLIPY",[24,90,92],{"id":91},"lizenz","Lizenz",[14,94,95,96,102],{},"SoundNinja ist freie Software unter ",[78,97,101],{"href":98,"rel":99},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fblob\u002Fmain\u002FLICENSE",[100],"nofollow","GPL-3.0",". Forken, ändern, teilen.",[24,104,106],{"id":105},"nächste-schritte","Nächste Schritte",[108,109,110,116,122],"ol",{},[32,111,112],{},[78,113,115],{"href":114},"\u002Fdocs\u002Finstallation","SoundNinja installieren",[32,117,118],{},[78,119,121],{"href":120},"\u002Fdocs\u002Fadding-sounds","Sounds hinzufügen",[32,123,124],{},[78,125,127],{"href":126},"\u002Fdocs\u002Forganizing-sounds","Board organisieren",{"title":129,"searchDepth":130,"depth":130,"links":131},"",2,[132,133,134,135],{"id":26,"depth":130,"text":27},{"id":46,"depth":130,"text":47},{"id":91,"depth":130,"text":92},{"id":105,"depth":130,"text":106},"Was SoundNinja ist und was du damit machen kannst.","md",{},true,1,"\u002Foverview",{"title":5,"description":136},"overview","hoyfMBw8UK5RuLBAbdnmSxP4gC163p8E8rvJgSihSXE",[146,228,431,577,977,1111,1258,1481],{"id":4,"title":5,"body":147,"description":136,"extension":137,"meta":226,"navigation":139,"order":140,"path":141,"seo":227,"stem":143,"__hash__":144},{"type":7,"value":148,"toc":220},[149,151,153,155,157,159,169,171,197,199,204,206],[10,150,5],{"id":12},[14,152,16],{},[14,154,19],{},[14,156,22],{},[24,158,27],{"id":26},[29,160,161,163,165,167],{},[32,162,34],{},[32,164,37],{},[32,166,40],{},[32,168,43],{},[24,170,47],{"id":46},[29,172,173,175,177,179,181,183,185,187,189,193,195],{},[32,174,52],{},[32,176,55],{},[32,178,58],{},[32,180,61],{},[32,182,64],{},[32,184,67],{},[32,186,70],{},[32,188,73],{},[32,190,76,191,82],{},[78,192,81],{"href":80},[32,194,85],{},[32,196,88],{},[24,198,92],{"id":91},[14,200,95,201,102],{},[78,202,101],{"href":98,"rel":203},[100],[24,205,106],{"id":105},[108,207,208,212,216],{},[32,209,210],{},[78,211,115],{"href":114},[32,213,214],{},[78,215,121],{"href":120},[32,217,218],{},[78,219,127],{"href":126},{"title":129,"searchDepth":130,"depth":130,"links":221},[222,223,224,225],{"id":26,"depth":130,"text":27},{"id":46,"depth":130,"text":47},{"id":91,"depth":130,"text":92},{"id":105,"depth":130,"text":106},{},{"title":5,"description":136},{"id":229,"title":230,"body":231,"description":426,"extension":137,"meta":427,"navigation":139,"order":130,"path":428,"seo":429,"stem":235,"__hash__":430},"content_de\u002Finstallation.md","Installation",{"type":7,"value":232,"toc":419},[233,236,250,254,276,279,283,297,300,304,329,340,344,351,355,369,399,415],[10,234,230],{"id":235},"installation",[14,237,238,239,243,244,249],{},"Hol dir einen Build von der ",[78,240,242],{"href":241},"\u002Fdownload","Download-Seite"," oder von ",[78,245,248],{"href":246,"rel":247},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Freleases\u002Flatest",[100],"GitHub Releases",". SoundNinja ist in früher Entwicklung — behandle Builds als Beta.",[24,251,253],{"id":252},"windows","Windows",[29,255,256,267,270,273],{},[32,257,258,262,263,266],{},[259,260,261],"strong",{},"Installer (.exe)"," oder ",[259,264,265],{},"MSI (.msi)"," für 64-Bit-Windows",[32,268,269],{},"Landing-Page-Ziel: Windows 10 und neuer",[32,271,272],{},"Die App-README nennt auch Windows 8 und höher",[32,274,275],{},"Der NSIS-Installer ist dunkel. Sprache beim Setup wählen — SoundNinja merkt sie beim nächsten Start.",[14,277,278],{},"Installer starten, dann SoundNinja über das Startmenü öffnen.",[24,280,282],{"id":281},"macos","macOS",[29,284,285,291,294],{},[32,286,287,290],{},[259,288,289],{},"Universelles .dmg"," für Apple Silicon und Intel",[32,292,293],{},"Landing-Page-Ziel: macOS 10.14 und neuer",[32,295,296],{},"Die App-README nennt macOS 10.15 und höher",[14,298,299],{},"Disk-Image öffnen und SoundNinja nach Programme ziehen.",[24,301,303],{"id":302},"linux","Linux",[29,305,306,312,318,326],{},[32,307,308,311],{},[259,309,310],{},"Debian (.deb)"," für Ubuntu \u002F Debian",[32,313,314,317],{},[259,315,316],{},"AppImage"," für andere Distros",[32,319,320,321,325],{},"Nach Veröffentlichung einer Release können Arch-Nutzer ",[322,323,324],"code",{},"soundninja-bin"," aus dem AUR installieren",[32,327,328],{},"Getestet unter Ubuntu 20.04",[14,330,331,332,335,336,339],{},"Desktop-Builds brauchen WebKit- und GTK-Pakete. Unter Debian\u002FUbuntu meist ",[322,333,334],{},"libwebkit2gtk",", ",[322,337,338],{},"libgtk-3-0"," und eine App-Indicator-Bibliothek.",[24,341,343],{"id":342},"updates","Updates",[14,345,346,347,350],{},"In der App: ",[259,348,349],{},"Hilfe → Nach Updates suchen",". Optional prüft SoundNinja beim Start in den Einstellungen.",[24,352,354],{"id":353},"aus-dem-quellcode-bauen","Aus dem Quellcode bauen",[14,356,357,358,335,363,368],{},"Eigenen Build? ",[78,359,362],{"href":360,"rel":361},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja",[100],"Repo klonen",[78,364,367],{"href":365,"rel":366},"https:\u002F\u002Fv2.tauri.app\u002Fstart\u002Fprerequisites\u002F",[100],"Tauri-Voraussetzungen"," installieren, dann:",[370,371,375],"pre",{"className":372,"code":373,"language":374,"meta":129,"style":129},"language-bash shiki shiki-themes github-light github-dark","bun install\nbun run tauri:serve\n","bash",[322,376,377,389],{"__ignoreMap":129},[378,379,381,385],"span",{"class":380,"line":140},"line",[378,382,384],{"class":383},"sScJk","bun",[378,386,388],{"class":387},"sZZnC"," install\n",[378,390,391,393,396],{"class":380,"line":130},[378,392,384],{"class":383},[378,394,395],{"class":387}," run",[378,397,398],{"class":387}," tauri:serve\n",[14,400,401,335,404,262,407,410,411,414],{},[322,402,403],{},"npm",[322,405,406],{},"pnpm",[322,408,409],{},"deno"," gehen auch. Produktionsbuild: ",[322,412,413],{},"bun run tauri:build",".",[416,417,418],"style",{},"html pre.shiki code .sScJk, html code.shiki .sScJk{--shiki-default:#6F42C1;--shiki-dark:#B392F0}html pre.shiki code .sZZnC, html code.shiki .sZZnC{--shiki-default:#032F62;--shiki-dark:#9ECBFF}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html.dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}",{"title":129,"searchDepth":130,"depth":130,"links":420},[421,422,423,424,425],{"id":252,"depth":130,"text":253},{"id":281,"depth":130,"text":282},{"id":302,"depth":130,"text":303},{"id":342,"depth":130,"text":343},{"id":353,"depth":130,"text":354},"SoundNinja unter Windows, macOS oder Linux installieren.",{},"\u002Finstallation",{"title":230,"description":426},"r-3EUG7lGdfEJsGyve9-EQzSXP8-1Q3frBZ2lky4J_M",{"id":432,"title":121,"body":433,"description":570,"extension":137,"meta":571,"navigation":139,"order":572,"path":573,"seo":574,"stem":575,"__hash__":576},"content_de\u002Fadding-sounds.md",{"type":7,"value":434,"toc":562},[435,438,441,445,462,466,497,501,520,524,538,541,545,552,556],[10,436,121],{"id":437},"sounds-hinzufügen",[14,439,440],{},"Ein Board bleibt leer, bis du Clips hinzufügst. SoundNinja importiert Dateien, ganze Ordner, eine Aufnahme oder ein geteiltes Soundboard-Paket.",[24,442,444],{"id":443},"audiodateien-importieren","Audiodateien importieren",[108,446,447,456,459],{},[32,448,449,262,452,455],{},[259,450,451],{},"Datei → Audiodateien importieren",[259,453,454],{},"Import"," in der Navbar.",[32,457,458],{},"Eine oder mehrere Audiodateien wählen.",[32,460,461],{},"Sounds landen im aktuellen Tab.",[24,463,465],{"id":464},"ordner-importieren","Ordner importieren",[108,467,468,477,480],{},[32,469,470,473,474,476],{},[259,471,472],{},"Datei → Ordner importieren"," (oder ",[259,475,465],{}," in der Navbar).",[32,478,479],{},"Einen oder mehrere Ordner hinzufügen. Vor dem Import per Drag neu sortieren.",[32,481,482,483],{},"Ziel wählen:\n",[29,484,485,491],{},[32,486,487,490],{},[259,488,489],{},"Als Tabs importieren"," — jeder Ordner wird ein eigener Tab",[32,492,493,496],{},[259,494,495],{},"In aktuellen Tab importieren"," — alle Dateien landen im aktiven Tab",[24,498,500],{"id":499},"clip-aufnehmen","Clip aufnehmen",[14,502,503,504,508,509,512,513,262,516,519],{},"Öffne den ",[78,505,507],{"href":506},"\u002Fdocs\u002Frecording-editor","Record Editor"," über ",[259,510,511],{},"Aufnahme"," in der Player-Leiste. Aufnehmen, zuschneiden, dann ",[259,514,515],{},"Auswahl importieren",[259,517,518],{},"Alle importieren"," in den aktuellen Tab oder einen gewählten Tab.",[24,521,523],{"id":522},"soundboard-importieren","Soundboard importieren",[14,525,526,529,530,533,534,537],{},[259,527,528],{},"Datei → Soundboard importieren"," lädt ein geteiltes Paket. Pakete sind ein ",[322,531,532],{},".zip"," mit ",[322,535,536],{},"project.sninja"," plus Sounddateien. Danach Projekt öffnen und abspielen.",[14,539,540],{},"Du kannst mehrere Projekte (Profile) halten. Über den Projektwähler zwischen Boards wechseln.",[24,542,544],{"id":543},"fehlende-dateien-neu-verknüpfen","Fehlende Dateien neu verknüpfen",[14,546,547,548,551],{},"Wenn Audiodateien auf der Festplatte umziehen, zeigt SoundNinja ",[259,549,550],{},"Fehlende Sounddateien",". Einen Suchordner wählen und Clips neu verknüpfen.",[24,553,555],{"id":554},"weiter","Weiter",[14,557,558,559,414],{},"Tabs, Tags, Filter und Hotkeys: ",[78,560,561],{"href":126},"Sounds organisieren",{"title":129,"searchDepth":130,"depth":130,"links":563},[564,565,566,567,568,569],{"id":443,"depth":130,"text":444},{"id":464,"depth":130,"text":465},{"id":499,"depth":130,"text":500},{"id":522,"depth":130,"text":523},{"id":543,"depth":130,"text":544},{"id":554,"depth":130,"text":555},"Audio, Ordner, Aufnahmen und geteilte Soundboards importieren.",{},3,"\u002Fadding-sounds",{"title":121,"description":570},"adding-sounds","H_ls9_vOwDkgTWPkfe9bQz1A0XidUOmMFV4V2EJpYec",{"id":578,"title":561,"body":579,"description":970,"extension":137,"meta":971,"navigation":139,"order":972,"path":973,"seo":974,"stem":975,"__hash__":976},"content_de\u002Forganizing-sounds.md",{"type":7,"value":580,"toc":955},[581,584,591,595,621,628,632,635,649,656,662,666,676,681,712,716,722,726,760,766,770,773,799,802,806,819,823,828,848,864,871,875,886,889,893,900,910,916,920,928,935,952],[10,582,561],{"id":583},"sounds-organisieren",[14,585,586,587,590],{},"SoundNinja ist für große Bibliotheken gebaut. ",[259,588,589],{},"Tags und Filter",", Tabs, Suche, Mehrfachauswahl und Hotkeys — der Clip ist einen Klick (oder eine Taste) entfernt.",[24,592,594],{"id":593},"tabs","Tabs",[29,596,597,604,611],{},[32,598,599,600,603],{},"Tab mit ",[259,601,602],{},"Tab hinzufügen"," anlegen. Farbe vergeben, damit die Leiste schnell scannbar bleibt.",[32,605,606,607,610],{},"Die Ansicht ",[259,608,609],{},"Alle"," zeigt jeden Sound über alle Tabs.",[32,612,613,614,617,618,414],{},"Ein Sound kann ",[259,615,616],{},"einem oder mehreren Tabs"," gehören. Rechtsklick → ",[259,619,620],{},"Zu Tab verschieben",[14,622,623,624,627],{},"Tab-Übergänge: ",[259,625,626],{},"Einstellungen → Allgemein"," — Slide, Fade, Buttons nacheinander oder Keine.",[24,629,631],{"id":630},"gruppen","Gruppen",[14,633,634],{},"Seit v0.5.3 können Trenner zu benannten Gruppen werden:",[29,636,637,640,643,646],{},[32,638,639],{},"Gruppe über das Kontextmenü hinzufügen, umbenennen oder entfernen",[32,641,642],{},"Gruppenkopf ziehen — Kinder kommen mit",[32,644,645],{},"Sounds in eine Gruppe legen oder herausnehmen",[32,647,648],{},"Rahmenfarbe, Namensfarbe und Button-Ausrichtung setzen (oder Tab-Standard nutzen)",[14,650,651,652,655],{},"Ein einfacher ",[259,653,654],{},"Trenner"," geht weiter, wenn du nur einen visuellen Bruch brauchst.",[14,657,658,659,414],{},"Rechtsklick auf leeren Board-Bereich: ",[259,660,661],{},"Gruppe hinzufügen",[24,663,665],{"id":664},"tags-filter","Tags \u002F Filter",[14,667,668,669,672,673,675],{},"Tags gelten tabübergreifend. Das ausfahrbare ",[259,670,671],{},"Filter","-Panel (Sidebar ",[259,674,671],{},") ist der Ort zum Anlegen und zum Filtern des Boards.",[677,678,680],"h3",{"id":679},"tags-anlegen-und-bearbeiten","Tags anlegen und bearbeiten",[108,682,683,688,699,705],{},[32,684,685,687],{},[259,686,671],{}," in der Sidebar öffnen.",[32,689,690,691,694,695,698],{},"Unter ",[259,692,693],{},"Tags"," → ",[259,696,697],{},"Tag hinzufügen"," — Name und Farbe vergeben.",[32,700,701,702,414],{},"Im selben Panel umbenennen, umfärben oder ",[259,703,704],{},"Tag löschen",[32,706,707,708,711],{},"Steht da ",[259,709,710],{},"Noch keine Tags",", zuerst hier einen anlegen, bevor du zuweist.",[677,713,715],{"id":714},"tags-an-sounds-hängen","Tags an Sounds hängen",[14,717,718,719,721],{},"Rechtsklick auf einen Sound → ",[259,720,693],{}," (Checkboxen). Ein Sound darf mehrere Tags haben. Existieren noch keine, zeigt das Menü den Weg zum Filter-Panel.",[677,723,725],{"id":724},"board-filtern","Board filtern",[29,727,728,735,746,757],{},[32,729,730,731,734],{},"Tags im Filter-Panel oder als ",[259,732,733],{},"Chips unter der Suchleiste"," umschalten.",[32,736,737,738,741,742,745],{},"Abgleich ist ",[259,739,740],{},"ODER",": ein Sound bleibt sichtbar, wenn er ",[259,743,744],{},"irgendeinen"," gewählten Tag hat.",[32,747,748,749,752,753,756],{},"Das Feld ",[259,750,751],{},"Suche"," in der Navbar kombiniert per ",[259,754,755],{},"UND"," mit dem aktiven Tag-Filter (Tippen + Tags zusammen).",[32,758,759],{},"Chips aus (oder Filter leeren), um den ganzen Tab wieder zu sehen.",[14,761,762,763,414],{},"Farbige Tag-Namen können auf Buttons erscheinen. Schalter: ",[259,764,765],{},"Einstellungen → Verhalten → Tag-Badges anzeigen",[24,767,769],{"id":768},"sortierung","Sortierung",[14,771,772],{},"Im Filter-Panel eine Sortierung wählen:",[29,774,775,781],{},[32,776,777,780],{},[259,778,779],{},"Benutzerdefiniert"," — deine Tab-Reihenfolge, Gruppen sichtbar",[32,782,783,335,786,335,789,262,792,795,796],{},[259,784,785],{},"Name",[259,787,788],{},"Hinzugefügt",[259,790,791],{},"Spielzeit",[259,793,794],{},"Dateigröße"," — flache sortierte Liste; ",[259,797,798],{},"Gruppen sind ausgeblendet",[14,800,801],{},"Sortierung nach Dauer kann beim ersten Mal die Dauer-Metadaten vorwärmen.",[24,803,805],{"id":804},"neu-anordnen","Neu anordnen",[14,807,808,809,812,813,816,817,414],{},"Drag-and-Drop in ",[259,810,811],{},"Einstellungen → Verhalten"," einschalten (",[259,814,815],{},"Neu anordnen erlauben","). Dann Sounds und Gruppen ziehen. Neu anordnen gilt bei ",[259,818,779],{},[24,820,822],{"id":821},"mehrfachauswahl","Mehrfachauswahl",[14,824,825,827],{},[259,826,822],{}," in der Navbar einschalten, dann:",[29,829,830,833,839,845],{},[32,831,832],{},"Klick toggelt einen Sound",[32,834,835,838],{},[259,836,837],{},"Shift+Klick"," wählt einen Bereich ab dem letzten Anker",[32,840,841,844],{},[259,842,843],{},"Rahmen"," auf leerem Board ziehen",[32,846,847],{},"Klick auf leeres Board (oder außerhalb) leert die Auswahl",[14,849,850,851,335,854,335,857,860,861,414],{},"Eine Sammelleiste zeigt die Anzahl plus ",[259,852,853],{},"Farbe",[259,855,856],{},"Zu Tab verschieben…",[259,858,859],{},"Löschen"," und ",[259,862,863],{},"Fertig",[14,865,866,867,870],{},"In der Mehrfachauswahl zeigt jeder Button einen ",[259,868,869],{},"8-Zeichen-ID-Chip",". Rechtsklick auf den Chip kopiert die ID.",[24,872,874],{"id":873},"lautstärke-pro-sound","Lautstärke pro Sound",[14,876,877,878,881,882,885],{},"Rechtsklick → ",[259,879,880],{},"Lautstärke",". Slider von 0 % bis 100 %. ",[259,883,884],{},"Doppelklick"," setzt auf 100 % zurück.",[14,887,888],{},"Das stapelt sich mit der Master-Ausgangslautstärke in den Einstellungen.",[24,890,892],{"id":891},"hotkeys-und-sound-ids","Hotkeys und Sound-IDs",[14,894,895,896,899],{},"Jeder Sound hat eine 8-stellige ID. Kopieren über das Button-Kontextmenü (",[259,897,898],{},"ID kopieren",") oder den Mehrfachauswahl-Chip.",[14,901,902,905,906,909],{},[259,903,904],{},"Einstellungen → Hotkeys",": Taste an eine Sound-ID binden. Globale Hotkeys sind optional. ",[259,907,908],{},"Hotkey zuweisen"," im Kontextmenü springt dorthin, ID vorausgefüllt.",[14,911,912,913,915],{},"Dieselbe ID nutzt ",[78,914,81],{"href":80}," zum Auslösen.",[24,917,919],{"id":918},"hintergrundbilder-und-farben","Hintergrundbilder und Farben",[14,921,922,923,927],{},"Rechtsklick auf einen Sound: eigene Farben oder ein Hintergrundbild. Das ist getrennt vom ",[78,924,926],{"href":925},"\u002Fdocs\u002Ftheme-editor","Theme Creator",", der das ganze Board gestaltet.",[14,929,930,931,934],{},"Der Picker ist ein Dialog ",[259,932,933],{},"Hintergrundbild"," (PNG, JPEG, GIF, WebP):",[29,936,937,943],{},[32,938,939,942],{},[259,940,941],{},"Lokale Dateien"," — Ordner hinzufügen, einzelne Datei wählen, Dateinamen suchen, Rastervorschau, Ordner aus der Bibliothek entfernen",[32,944,945,948,949,951],{},[259,946,947],{},"KLIPY"," — GIFs online suchen. Eigenen API-Key unter ",[259,950,811],{},". Der Key landet nicht in Projektdateien.",[14,953,954],{},"Nach der Wahl Bild auf dem Button schieben und zuschneiden.",{"title":129,"searchDepth":130,"depth":130,"links":956},[