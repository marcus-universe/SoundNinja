259,1225,539],{}," in den aktuellen oder einen gewählten Tab.",[24,1228,1230],{"id":1229},"stem-trennung-optional","Stem-Trennung (optional)",[14,1232,1233,1234,1237,1238,262,1241,1244],{},"Offizielle Windows-, macOS- und Linux-Release-Builds enthalten das ",[259,1235,1236],{},"Stems","-Feature. Der Aufnahme-Editor kann ",[259,1239,1240],{},"Gesang",[259,1242,1243],{},"Musik"," mit BS-RoFormer behalten.",[14,1246,1247,1248,1251,1252,1255],{},"Das Modell ist etwa 158 MB und ",[259,1249,1250],{},"nicht"," im Installer. Download unter ",[259,1253,1254],{},"Einstellungen → Stem-Trennung"," oder über den Erststart-Hinweis. Der Windows-Installer kann den Download beim ersten Start anbieten.",[14,1257,1258,1259,1027,1262,1265],{},"Eigene Source-Builds brauchen extra Flags (",[322,1260,1261],{},"tauri:serve:stems",[322,1263,1264],{},"tauri:build:stems",").",{"title":129,"searchDepth":130,"depth":130,"links":1267},[1268,1269,1270,1271],{"id":1148,"depth":130,"text":1149},{"id":1181,"depth":130,"text":1182},{"id":1210,"depth":130,"text":1211},{"id":1229,"depth":130,"text":1230},"Mikrofon oder PC-Audio aufnehmen, den Clip bearbeiten und aufs Board legen.",{},6,"\u002Frecording-editor",{"title":1134,"description":1272},"recording-editor","mBUN6yUiwk-kNjhsf48NlWEXXhjw6cOuSAkybSa9wi0",{"id":1280,"title":1281,"body":1282,"description":1495,"extension":137,"meta":1496,"navigation":139,"order":1497,"path":1498,"seo":1499,"stem":1500,"__hash__":1501},"content_de\u002Fremote-control.md","Fernsteuerung",{"type":7,"value":1283,"toc":1488},[1284,1287,1290,1294,1324,1327,1330,1365,1369,1389,1392,1396,1428,1432,1438],[10,1285,1281],{"id":1286},"fernsteuerung",[14,1288,1289],{},"SoundNinja kann im lokalen Netz lauschen, damit Bitfocus Companion (oder jeder HTTP\u002FWebSocket-Client) Sounds spielt und stoppt.",[24,1291,1293],{"id":1292},"remote-server-einschalten","Remote-Server einschalten",[108,1295,1296,1302,1308,1314],{},[32,1297,1298,1301],{},[259,1299,1300],{},"Einstellungen → Remote"