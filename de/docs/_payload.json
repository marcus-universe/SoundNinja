2,1128,1129],{},"Eine Theme-Datei in den Themes-Ordner importieren",{"title":129,"searchDepth":130,"depth":130,"links":1131},[1132,1133,1134,1135],{"id":1024,"depth":130,"text":1025},{"id":1058,"depth":130,"text":1059},{"id":1076,"depth":130,"text":1077},{"id":1109,"depth":130,"text":1110},"Farben, Schriften, Buttons und Tabs im Theme Creator gestalten.",{},5,"\u002Ftheme-editor",{"title":1010,"description":1136},"h6Hta3TDDcThnouY3Pk_Omvjq8Eb8knx-HIAvf5YZd8",{"id":1143,"title":1144,"body":1145,"description":1282,"extension":137,"meta":1283,"navigation":139,"order":1284,"path":1285,"seo":1286,"stem":1287,"__hash__":1288},"content_de\u002Frecording-editor.md","Aufnahme-Editor",{"type":7,"value":1146,"toc":1276},[1147,1150,1156,1160,1166,1186,1189,1193,1218,1222,1237,1241,1255,1266],[10,1148,1144],{"id":1149},"aufnahme-editor",[14,1151,1152,1153,1155],{},"Nimm einen Clip in SoundNinja auf, schneide ihn zu und importiere ihn in einen Tab. Öffnen über ",[259,1154,532],{}," in der Player-Leiste.",[24,1157,1159],{"id":1158},"eingang-wählen","Eingang wählen",[14,1161,711,1162,1165],{},[259,1163,1164],{},"Einstellungen → Audio",":",[29,1167,1168,1174,1180],{},[32,1169,1170,1173],{},[259,1171,1172],{},"Eingabegeräte"," — Mikrofon",[32,1175,1176,1179],{},[259,1177,1178],{},"Ausgabegeräte (PC-Audio)"," — Loopback dessen, was der PC spielt",[32,1181,1182,1185],{},[259,1183,1184],{},"Eingangslautstärke"," — Aufnahme-Gain von 0 % bis 200 %",[14,1187,1188],{},"Der Aufnahme-Button nutzt das hier gewählte Gerät.",[24,1190,1192],{"id":1191},"take-bearbeiten","Take bearbeiten",[29,1194,1195,1198,1201,1209,1212,1215],{},[32,1196,1197],{},"Aufnehmen und stoppen",[32,1199,1200],{},"Pegelmesser beobachten",[32,1202,1203,262,1206],{},[259,1204,1205],{},"Normalisieren",[259,1207,1208],{},"Rauschunterdrückung",[32,1210,1211],{},"Ganzen Clip trimmen, auf Auswahl trimmen oder Auswahl löschen",[32,1213,1214],{},"Rückgängig \u002F Wiederholen",[32,1216,1217],{},"Rein- und rauszoomen",[24,1219,1221],{"id":1220},"stagen-und-importieren","Stagen und importieren",[108,1223,1224,1227,1230],{},[32,1225,1226],{},"Auswahl oder ganzen Track zur Staging-Liste hinzufügen.",[32,1228,1229],{},"Die Liste startet leer: aufnehmen, bearbeiten, dann Clip hinzufügen.",[32,1231,1232,262,1234,1236],{},[259,1233,536],{},[259,1235,539],{}," in den aktuellen oder einen gewählten Tab.",[24,1238,1240],{"id":1239},"stem-trennung-optional","Stem-Trennung (optional)",[14,1242,1243,1244,1247,1248,262,1251,1254],{},"Offizielle Windows-, macOS- und Linux-Release-Builds enthalten das ",[259,1245,1246],{},"Stems","-Feature. Der Aufnahme-Editor kann ",[259,1249,1250],{},"Gesang",[259,1252,1253],{},"Musik"," mit BS-RoFormer behalten.",[14,1256,1257,1258,1261,1262,1265],{},"Das Modell ist etwa 158 MB und ",[259,1259,1260],{},"nicht"," im Installer. Download unter ",[259,1263,1264],{},"Einstellungen → Stem-Trennung"," oder über den Erststart-Hinweis. Der Windows-Installer kann den Download beim ersten Start anbieten.",[14,1267,1268,1269,1037,1272,1275],{},"Eigene Source-Builds brauchen extra Flags (",[322,1270,1271],{},"tauri:serve:stems",[322,1273,1274],{},"tauri:build:stems",").",{"title":129,"searchDepth":130,"depth":130,"links":1277},[1278,1279,1280,1281],{"id":1158,"depth":130,"text":1159},{"id":1191,"depth":130,"text":1192},{"id":1220,"depth":130,"text":1221},{"id":1239,"depth":130,"text":1240},"Mikrofon oder PC-Audio aufnehmen, den Clip bearbeiten und aufs Board legen.",{},6,"\u002Frecording-editor",{"title":1144,"description":1282},"recording-editor","mBUN6yUiwk-kNjhsf48NlWEXXhjw6cOuSAkybSa9wi0",{"id":1290,"title":1291,"body":1292,"description":1505,"extension":137,"meta":1506,"navigation":139,"order":1507,"path":1508,"seo":1509,"stem":1510,"__hash__":1511},"content_de\u002Fremote-control.md","Fernsteuerung",{"type":7,"value":1293,"toc":1498},[1294,1297,1300,1304,1334,1337,1340,1375,1379,1399,1402,1406,1438,1442,1448],[10,1295,1291],{"id":1296},"fernsteuerung",[14,1298,1299],{},"SoundNi