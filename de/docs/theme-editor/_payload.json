[{"data":1,"prerenderedAt":1585},["ShallowReactive",2],{"docs-page-de-\u002Ftheme-editor":3,"docs-nav-de":154},{"id":4,"title":5,"body":6,"description":146,"extension":147,"meta":148,"navigation":149,"order":150,"path":151,"seo":152,"stem":12,"__hash__":153},"content_de\u002Ftheme-editor.md","Theme-Editor",{"type":7,"value":8,"toc":138},"minimark",[9,13,22,27,58,61,65,80,84,110,113,117,124],[10,11,5],"h1",{"id":12},"theme-editor",[14,15,16,17,21],"p",{},"Der Theme Creator ist der volle visuelle Editor für dein Board. Öffnen über ",[18,19,20],"strong",{},"Einstellungen → Allgemein → Theme Creator",".",[23,24,26],"h2",{"id":25},"drei-tabs","Drei Tabs",[28,29,30,46,52],"ol",{},[31,32,33,36,37,41,42,45],"li",{},[18,34,35],{},"Allgemein"," — Theme-Name, gemeinsame Farben und Schrift-Uploads (",[38,39,40],"code",{},".ttf"," \u002F ",[38,43,44],{},".otf",")",[31,47,48,51],{},[18,49,50],{},"Buttons"," — Farben, Typo, Layout und GIF-Overlay der Sound-Buttons",[31,53,54,57],{},[18,55,56],{},"Tabs"," — Farben, Typo und Rahmenstärke der Tab-Leiste",[14,59,60],{},"Eine Live-Vorschau zeigt Tabs und Buttons beim Bearbeiten.",[23,62,64],{"id":63},"was-du-ändern-kannst","Was du ändern kannst",[66,67,68,71,74,77],"ul",{},[31,69,70],{},"Primär- und Akzentfarben, Hintergründe, Button- und Tab-Farben",[31,72,73],{},"Schriftfamilie und -größe für Buttons und Tabs",[31,75,76],{},"Button-Breite, Radius, Rahmen, Abstände und Innenabstand",[31,78,79],{},"GIF-Overlay-Deckkraft (normal und Hover)",[23,81,83],{"id":82},"speichern-und-teilen","Speichern und teilen",[66,85,86,92,98,104],{},[31,87,88,91],{},[18,89,90],{},".css exportieren"," — Theme-Datei sichern oder weitergeben",[31,93,94,97],{},[18,95,96],{},"Zu Themes hinzufügen"," — in den Themes-Ordner speichern und anwenden",[31,99,100,103],{},[18,101,102],{},".css importieren"," — Preset oder gespeichertes Theme laden",[31,105,106,109],{},[18,107,108],{},"Zurücksetzen"," — SoundNinja-Standard wiederherstellen",[14,111,112],{},"Beim Schließen mit ungespeicherten Änderungen fragt SoundNinja nach.",[23,114,116],{"id":115},"ohne-vollen-editor","Ohne vollen Editor",[14,118,119,120,123],{},"Unter ",[18,121,122],{},"Einstellungen → Allgemein"," kannst du trotzdem:",[66,125,126,129,135],{},[31,127,128],{},"Ein Theme aus der Liste wählen",[31,130,131,132,45],{},"CSS-Variablen live bearbeiten (",[18,133,134],{},"Eigenes CSS",[31,136,137],{},"Eine Theme-Datei in den Themes-Ordner importieren",{"title":139,"searchDepth":140,"depth":140,"links":141},"",2,[142,143,144,145],{"id":25,"depth":140,"text":26},{"id":63,"depth":140,"text":64},{"id":82,"depth":140,"text":83},{"id":115,"depth":140,"text":116},"Farben, Schriften, Buttons und Tabs im Theme Creator gestalten.","md",{},true,5,"\u002Ftheme-editor",{"title":5,"description":146},"h6Hta3TDDcThnouY3Pk_Omvjq8Eb8knx-HIAvf5YZd8",[155,286,486,632,1029,1118,1265,1488],{"id":156,"title":157,"body":158,"description":279,"extension":147,"meta":280,"navigation":149,"order":281,"path":282,"seo":283,"stem":284,"__hash__":285},"content_de\u002Foverview.md","Überblick",{"type":7,"value":159,"toc":273},[160,163,166,169,172,176,190,194,235,239,249,253],[10,161,157],{"id":162},"überblick",[14,164,165],{},"SoundNinja ist ein Open-Source-Soundboard für Livestreams, Chats mit Freunden und Podcast-Aufnahmen. Es läuft auf Tauri v2 und Nuxt 4 und bleibt dabei sparsam mit RAM und Speicherplatz.",[14,167,168],{},"Das Ziel: eine große Sound-Bibliothek schnell scannen und den richtigen Clip in Millisekunden abspielen. Die Oberfläche eignet sich auch als Dashboard in VR.",[14,170,171],{},"SoundNinja steckt noch in der frühen Entwicklung. Funktionen laufen, aber nicht jede Plattform ist vollständig getestet.",[23,173,175],{"id":174},"für-wen","Für wen",[66,177,178,181,184,187],{},[31,179,180],{},"Streamer, die sofortige Sound-Cues brauchen",[31,182,183],{},"Freunde, die ein gemeinsames Board für Voice-Chat wollen",[31,185,186],{},"Podcaster, die Clips aufnehmen und aufs Board legen",[31,188,189],{},"Alle, die ein anpassbares, lokales Soundboard wollen",[23,191,193],{"id":192},"was-du-tun-kannst","Was du tun kannst",[66,195,196,199,202,205,208,211,214,217,220,229,232],{},[31,197,198],{},"Ein Soundboard aus eigenen Audiodateien bauen",[31,200,201],{},"Sounds in farbigen Tabs, Gruppen, Tags und über die Suche sortieren",[31,203,204],{},"Nach Tags filtern (ODER) und nach Name, Datum, Dauer oder Größe sortieren",[31,206,207],{},"Mehrfachauswahl mit Rahmen oder Shift-Bereich, dann Farbe, Tab oder Löschen in einem Rutsch",[31,209,210],{},"Lautstärke pro Sound im Kontextmenü setzen",[31,212,213],{},"Das Aussehen mit dem Theme Creator gestalten",[31,215,216],{},"PC-Audio oder Mikrofon im Record Editor aufnehmen",[31,218,219],{},"Hotkeys einzelnen Sounds zuweisen",[31,221,222,223,228],{},"Sounds über ",[224,225,227],"a",{"href":226},"\u002Fdocs\u002Fremote-control","Bitfocus Companion"," auslösen",[31,230,231],{},"Ein komplettes Soundboard importieren und exportieren",[31,233,234],{},"GIFs oder Bilder auf Sound-Buttons legen — aus lokaler Ordnerbibliothek oder KLIPY",[23,236,238],{"id":237},"lizenz","Lizenz",[14,240,241,242,248],{},"SoundNinja ist freie Software unter ",[224,243,247],{"href":244,"rel":245},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fblob\u002Fmain\u002FLICENSE",[246],"nofollow","GPL-3.0",". Forken, ändern, teilen.",[23,250,252],{"id":251},"nächste-schritte","Nächste Schritte",[28,254,255,261,267],{},[31,256,257],{},[224,258,260],{"href":259},"\u002Fdocs\u002Finstallation","SoundNinja installieren",[31,262,263],{},[224,264,266],{"href":265},"\u002Fdocs\u002Fadding-sounds","Sounds hinzufügen",[31,268,269],{},[224,270,272],{"href":271},"\u002Fdocs\u002Forganizing-sounds","Board organisieren",{"title":139,"searchDepth":140,"depth":140,"links":274},[275,276,277,278],{"id":174,"depth":140,"text":175},{"id":192,"depth":140,"text":193},{"id":237,"depth":140,"text":238},{"id":251,"depth":140,"text":252},"Was SoundNinja ist und was du damit machen kannst.",{},1,"\u002Foverview",{"title":157,"description":279},"overview","hoyfMBw8UK5RuLBAbdnmSxP4gC163p8E8rvJgSihSXE",{"id":287,"title":288,"body":289,"description":481,"extension":147,"meta":482,"navigation":149,"order":140,"path":483,"seo":484,"stem":293,"__hash__":485},"content_de\u002Finstallation.md","Installation",{"type":7,"value":290,"toc":474},[291,294,308,312,333,336,340,354,357,361,385,396,400,407,411,425,455,470],[10,292,288],{"id":293},"installation",[14,295,296,297,301,302,307],{},"Hol dir einen Build von der ",[224,298,300],{"href":299},"\u002Fdownload","Download-Seite"," oder von ",[224,303,306],{"href":304,"rel":305},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Freleases\u002Flatest",[246],"GitHub Releases",". SoundNinja ist in früher Entwicklung — behandle Builds als Beta.",[23,309,311],{"id":310},"windows","Windows",[66,313,314,324,327,330],{},[31,315,316,319,320,323],{},[18,317,318],{},"Installer (.exe)"," oder ",[18,321,322],{},"MSI (.msi)"," für 64-Bit-Windows",[31,325,326],{},"Landing-Page-Ziel: Windows 10 und neuer",[31,328,329],{},"Die App-README nennt auch Windows 8 und höher",[31,331,332],{},"Der NSIS-Installer ist dunkel. Sprache beim Setup wählen — SoundNinja merkt sie beim nächsten Start.",[14,334,335],{},"Installer starten, dann SoundNinja über das Startmenü öffnen.",[23,337,339],{"id":338},"macos","macOS",[66,341,342,348,351],{},[31,343,344,347],{},[18,345,346],{},"Universelles .dmg"," für Apple Silicon und Intel",[31,349,350],{},"Landing-Page-Ziel: macOS 10.14 und neuer",[31,352,353],{},"Die App-README nennt macOS 10.15 und höher",[14,355,356],{},"Disk-Image öffnen und SoundNinja nach Programme ziehen.",[23,358,360],{"id":359},"linux","Linux",[66,362,363,369,375,382],{},[31,364,365,368],{},[18,366,367],{},"Debian (.deb)"," für Ubuntu \u002F Debian",[31,370,371,374],{},[18,372,373],{},"AppImage"," für andere Distros",[31,376,377,378,381],{},"Nach Veröffentlichung einer Release können Arch-Nutzer ",[38,379,380],{},"soundninja-bin"," aus dem AUR installieren",[31,383,384],{},"Getestet unter Ubuntu 20.04",[14,386,387,388,391,392,395],{},"Desktop-Builds brauchen WebKit- und GTK-Pakete. Unter Debian\u002FUbuntu meist ",[38,389,390],{},"libwebkit2gtk",", ",[38,393,394],{},"libgtk-3-0"," und eine App-Indicator-Bibliothek.",[23,397,399],{"id":398},"updates","Updates",[14,401,402,403,406],{},"In der App: ",[18,404,405],{},"Hilfe → Nach Updates suchen",". Optional prüft SoundNinja beim Start in den Einstellungen.",[23,408,410],{"id":409},"aus-dem-quellcode-bauen","Aus dem Quellcode bauen",[14,412,413,414,391,419,424],{},"Eigenen Build? ",[224,415,418],{"href":416,"rel":417},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja",[246],"Repo klonen",[224,420,423],{"href":421,"rel":422},"https:\u002F\u002Fv2.tauri.app\u002Fstart\u002Fprerequisites\u002F",[246],"Tauri-Voraussetzungen"," installieren, dann:",[426,427,431],"pre",{"className":428,"code":429,"language":430,"meta":139,"style":139},"language-bash shiki shiki-themes github-light github-dark","bun install\nbun run tauri:serve\n","bash",[38,432,433,445],{"__ignoreMap":139},[434,435,437,441],"span",{"class":436,"line":281},"line",[434,438,440],{"class":439},"sScJk","bun",[434,442,444],{"class":443},"sZZnC"," install\n",[434,446,447,449,452],{"class":436,"line":140},[434,448,440],{"class":439},[434,450,451],{"class":443}," run",[434,453,454],{"class":443}," tauri:serve\n",[14,456,457,391,460,319,463,466,467,21],{},[38,458,459],{},"npm",[38,461,462],{},"pnpm",[38,464,465],{},"deno"," gehen auch. Produktionsbuild: ",[38,468,469],{},"bun run tauri:build",[471,472,473],"style",{},"html pre.shiki code .sScJk, html code.shiki .sScJk{--shiki-default:#6F42C1;--shiki-dark:#B392F0}html pre.shiki code .sZZnC, html code.shiki .sZZnC{--shiki-default:#032F62;--shiki-dark:#9ECBFF}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html.dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}",{"title":139,"searchDepth":140,"depth":140,"links":475},[476,477,478,479,480],{"id":310,"depth":140,"text":311},{"id":338,"depth":140,"text":339},{"id":359,"depth":140,"text":360},{"id":398,"depth":140,"text":399},{"id":409,"depth":140,"text":410},"SoundNinja unter Windows, macOS oder Linux installieren.",{},"\u002Finstallation",{"title":288,"description":481},"r-3EUG7lGdfEJsGyve9-EQzSXP8-1Q3frBZ2lky4J_M",{"id":487,"title":266,"body":488,"description":625,"extension":147,"meta":626,"navigation":149,"order":627,"path":628,"seo":629,"stem":630,"__hash__":631},"content_de\u002Fadding-sounds.md",{"type":7,"value":489,"toc":617},[490,493,496,500,517,521,552,556,575,579,593,596,600,607,611],[10,491,266],{"id":492},"sounds-hinzufügen",[14,494,495],{},"Ein Board bleibt leer, bis du Clips hinzufügst. SoundNinja importiert Dateien, ganze Ordner, eine Aufnahme oder ein geteiltes Soundboard-Paket.",[23,497,499],{"id":498},"audiodateien-importieren","Audiodateien importieren",[28,501,502,511,514],{},[31,503,504,319,507,510],{},[18,505,506],{},"Datei → Audiodateien importieren",[18,508,509],{},"Import"," in der Navbar.",[31,512,513],{},"Eine oder mehrere Audiodateien wählen.",[31,515,516],{},"Sounds landen im aktuellen Tab.",[23,518,520],{"id":519},"ordner-importieren","Ordner importieren",[28,522,523,532,535],{},[31,524,525,528,529,531],{},[18,526,527],{},"Datei → Ordner importieren"," (oder ",[18,530,520],{}," in der Navbar).",[31,533,534],{},"Einen oder mehrere Ordner hinzufügen. Vor dem Import per Drag neu sortieren.",[31,536,537,538],{},"Ziel wählen:\n",[66,539,540,546],{},[31,541,542,545],{},[18,543,544],{},"Als Tabs importieren"," — jeder Ordner wird ein eigener Tab",[31,547,548,551],{},[18,549,550],{},"In aktuellen Tab importieren"," — alle Dateien landen im aktiven Tab",[23,553,555],{"id":554},"clip-aufnehmen","Clip aufnehmen",[14,557,558,559,563,564,567,568,319,571,574],{},"Öffne den ",[224,560,562],{"href":561},"\u002Fdocs\u002Frecording-editor","Record Editor"," über ",[18,565,566],{},"Aufnahme"," in der Player-Leiste. Aufnehmen, zuschneiden, dann ",[18,569,570],{},"Auswahl importieren",[18,572,573],{},"Alle importieren"," in den aktuellen Tab oder einen gewählten Tab.",[23,576,578],{"id":577},"soundboard-importieren","Soundboard importieren",[14,580,581,584,585,588,589,592],{},[18,582,583],{},"Datei → Soundboard importieren"," lädt ein geteiltes Paket. Pakete sind ein ",[38,586,587],{},".zip"," mit ",[38,590,591],{},"project.sninja"," plus Sounddateien. Danach Projekt öffnen und abspielen.",[14,594,595],{},"Du kannst mehrere Projekte (Profile) halten. Über den Projektwähler zwischen Boards wechseln.",[23,597,599],{"id":598},"fehlende-dateien-neu-verknüpfen","Fehlende Dateien neu verknüpfen",[14,601,602,603,606],{},"Wenn Audiodateien auf der Festplatte umziehen, zeigt SoundNinja ",[18,604,605],{},"Fehlende Sounddateien",". Einen Suchordner wählen und Clips neu verknüpfen.",[23,608,610],{"id":609},"weiter","Weiter",[14,612,613,614,21],{},"Tabs, Tags, Filter und Hotkeys: ",[224,615,616],{"href":271},"Sounds organisieren",{"title":139,"searchDepth":140,"depth":140,"links":618},[619,620,621,622,623,624],{"id":498,"depth":140,"text":499},{"id":519,"depth":140,"text":520},{"id":554,"depth":140,"text":555},{"id":577,"depth":140,"text":578},{"id":598,"depth":140,"text":599},{"id":609,"depth":140,"text":610},"Audio, Ordner, Aufnahmen und geteilte Soundboards importieren.",{},3,"\u002Fadding-sounds",{"title":266,"description":625},"adding-sounds","H_ls9_vOwDkgTWPkfe9bQz1A0XidUOmMFV4V2EJpYec",{"id":633,"title":616,"body":634,"description":1022,"extension":147,"meta":1023,"navigation":149,"order":1024,"path":1025,"seo":1026,"stem":1027,"__hash__":1028},"content_de\u002Forganizing-sounds.md",{"type":7,"value":635,"toc":1007},[636,639,646,649,675,681,685,688,702,709,715,719,729,734,764,768,774,778,812,818,822,825,851,854,858,871,875,880,900,916,923,927,938,941,945,952,962,968,972,980,987,1004],[10,637,616],{"id":638},"sounds-organisieren",[14,640,641,642,645],{},"SoundNinja ist für große Bibliotheken gebaut. ",[18,643,644],{},"Tags und Filter",", Tabs, Suche, Mehrfachauswahl und Hotkeys — der Clip ist einen Klick (oder eine Taste) entfernt.",[23,647,56],{"id":648},"tabs",[66,650,651,658,665],{},[31,652,653,654,657],{},"Tab mit ",[18,655,656],{},"Tab hinzufügen"," anlegen. Farbe vergeben, damit die Leiste schnell scannbar bleibt.",[31,659,660,661,664],{},"Die Ansicht ",[18,662,663],{},"Alle"," zeigt jeden Sound über alle Tabs.",[31,666,667,668,671,672,21],{},"Ein Sound kann ",[18,669,670],{},"einem oder mehreren Tabs"," gehören. Rechtsklick → ",[18,673,674],{},"Zu Tab verschieben",[14,676,677,678,680],{},"Tab-Übergänge: ",[18,679,122],{}," — Slide, Fade, Buttons nacheinander oder Keine.",[23,682,684],{"id":683},"gruppen","Gruppen",[14,686,687],{},"Seit v0.5.3 können Trenner zu benannten Gruppen werden:",[66,689,690,693,696,699],{},[31,691,692],{},"Gruppe über das Kontextmenü hinzufügen, umbenennen oder entfernen",[31,694,695],{},"Gruppenkopf ziehen — Kinder kommen mit",[31,697,698],{},"Sounds in eine Gruppe legen oder herausnehmen",[31,700,701],{},"Rahmenfarbe, Namensfarbe und Button-Ausrichtung setzen (oder Tab-Standard nutzen)",[14,703,704,705,708],{},"Ein einfacher ",[18,706,707],{},"Trenner"," geht weiter, wenn du nur einen visuellen Bruch brauchst.",[14,710,711,712,21],{},"Rechtsklick auf leeren Board-Bereich: ",[18,713,714],{},"Gruppe hinzufügen",[23,716,718],{"id":717},"tags-filter","Tags \u002F Filter",[14,720,721,722,725,726,728],{},"Tags gelten tabübergreifend. Das ausfahrbare ",[18,723,724],{},"Filter","-Panel (Sidebar ",[18,727,724],{},") ist der Ort zum Anlegen und zum Filtern des Boards.",[730,731,733],"h3",{"id":732},"tags-anlegen-und-bearbeiten","Tags anlegen und bearbeiten",[28,735,736,741,751,757],{},[31,737,738,740],{},[18,739,724],{}," in der Sidebar öffnen.",[31,742,119,743,746,747,750],{},[18,744,745],{},"Tags"," → ",[18,748,749],{},"Tag hinzufügen"," — Name und Farbe vergeben.",[31,752,753,754,21],{},"Im selben Panel umbenennen, umfärben oder ",[18,755,756],{},"Tag löschen",[31,758,759,760,763],{},"Steht da ",[18,761,762],{},"Noch keine Tags",", zuerst hier einen anlegen, bevor du zuweist.",[730,765,767],{"id":766},"tags-an-sounds-hängen","Tags an Sounds hängen",[14,769,770,771,773],{},"Rechtsklick auf einen Sound → ",[18,772,745],{}," (Checkboxen). Ein Sound darf mehrere Tags haben. Existieren noch keine, zeigt das Menü den Weg zum Filter-Panel.",[730,775,777],{"id":776},"board-filtern","Board filtern",[66,779,780,787,798,809],{},[31,781,782,783,786],{},"Tags im Filter-Panel oder als ",[18,784,785],{},"Chips unter der Suchleiste"," umschalten.",[31,788,789,790,793,794,797],{},"Abgleich ist ",[18,791,792],{},"ODER",": ein Sound bleibt sichtbar, wenn er ",[18,795,796],{},"irgendeinen"," gewählten Tag hat.",[31,799,800,801,804,805,808],{},"Das Feld ",[18,802,803],{},"Suche"," in der Navbar kombiniert per ",[18,806,807],{},"UND"," mit dem aktiven Tag-Filter (Tippen + Tags zusammen).",[31,810,811],{},"Chips aus (oder Filter leeren), um den ganzen Tab wieder zu sehen.",[14,813,814,815,21],{},"Farbige Tag-Namen können auf Buttons erscheinen. Schalter: ",[18,816,817],{},"Einstellungen → Verhalten → Tag-Badges anzeigen",[23,819,821],{"id":820},"sortierung","Sortierung",[14,823,824],{},"Im Filter-Panel eine Sortierung wählen:",[66,826,827,833],{},[31,828,829,832],{},[18,830,831],{},"Benutzerdefiniert"," — deine Tab-Reihenfolge, Gruppen sichtbar",[31,834,835,391,838,391,841,319,844,847,848],{},[18,836,837],{},"Name",[18,839,840],{},"Hinzugefügt",[18,842,843],{},"Spielzeit",[18,845,846],{},"Dateigröße"," — flache sortierte Liste; ",[18,849,850],{},"Gruppen sind ausgeblendet",[14,852,853],{},"Sortierung nach Dauer kann beim ersten Mal die Dauer-Metadaten vorwärmen.",[23,855,857],{"id":856},"neu-anordnen","Neu anordnen",[14,859,860,861,864,865,868,869,21],{},"Drag-and-Drop in ",[18,862,863],{},"Einstellungen → Verhalten"," einschalten (",[18,866,867],{},"Neu anordnen erlauben","). Dann Sounds und Gruppen ziehen. Neu anordnen gilt bei ",[18,870,831],{},[23,872,874],{"id":873},"mehrfachauswahl","Mehrfachauswahl",[14,876,877,879],{},[18,878,874],{}," in der Navbar einschalten, dann:",[66,881,882,885,891,897],{},[31,883,884],{},"Klick toggelt einen Sound",[31,886,887,890],{},[18,888,889],{},"Shift+Klick"," wählt einen Bereich ab dem letzten Anker",[31,892,893,896],{},[18,894,895],{},"Rahmen"," auf leerem Board ziehen",[31,898,899],{},"Klick auf leeres Board (oder außerhalb) leert die Auswahl",[14,901,902,903,391,906,391,909,912,913,21],{},"Eine Sammelleiste zeigt die Anzahl plus ",[18,904,905],{},"Farbe",[18,907,908],{},"Zu Tab verschieben…",[18,910,911],{},"Löschen"," und ",[18,914,915],{},"Fertig",[14,917,918,919,922],{},"In der Mehrfachauswahl zeigt jeder Button einen ",[18,920,921],{},"8-Zeichen-ID-Chip",". Rechtsklick auf den Chip kopiert die ID.",[23,924,926],{"id":925},"lautstärke-pro-sound","Lautstärke pro Sound",[14,928,929,930,933,934,937],{},"Rechtsklick → ",[18,931,932],{},"Lautstärke",". Slider von 0 % bis 100 %. ",[18,935,936],{},"Doppelklick"," setzt auf 100 % zurück.",[14,939,940],{},"Das stapelt sich mit der Master-Ausgangslautstärke in den Einstellungen.",[23,942,944],{"id":943},"hotkeys-und-sound-ids","Hotkeys und Sound-IDs",[14,946,947,948,951],{},"Jeder Sound hat eine 8-stellige ID. Kopieren über das Button-Kontextmenü (",[18,949,950],{},"ID kopieren",") oder den Mehrfachauswahl-Chip.",[14,953,954,957,958,961],{},[18,955,956],{},"Einstellungen → Hotkeys",": Taste an eine Sound-ID binden. Globale Hotkeys sind optional. ",[18,959,960],{},"Hotkey zuweisen"," im Kontextmenü springt dorthin, ID vorausgefüllt.",[14,963,964,965,967],{},"Dieselbe ID nutzt ",[224,966,227],{"href":226}," zum Auslösen.",[23,969,971],{"id":970},"hintergrundbilder-und-farben","Hintergrundbilder und Farben",[14,973,974,975,979],{},"Rechtsklick auf einen Sound: eigene Farben oder ein Hintergrundbild. Das ist getrennt vom ",[224,976,978],{"href":977},"\u002Fdocs\u002Ftheme-editor","Theme Creator",", der das ganze Board gestaltet.",[14,981,982,983,986],{},"Der Picker ist ein Dialog ",[18,984,985],{},"Hintergrundbild"," (PNG, JPEG, GIF, WebP):",[66,988,989,995],{},[31,990,991,994],{},[18,992,993],{},"Lokale Dateien"," — Ordner hinzufügen, einzelne Datei wählen, Dateinamen suchen, Rastervorschau, Ordner aus der Bibliothek entfernen",[31,996,997,1000,1001,1003],{},[18,998,999],{},"KLIPY"," — GIFs online suchen. Eigenen API-Key unter ",[18,1002,863],{},". Der Key landet nicht in Projektdateien.",[14,1005,1006],{},"Nach der Wahl Bild auf dem Button schieben und zuschneiden.",{"title":139,"searchDepth":140,"depth":140,"links":1008},[1009,1010,1011,1016,1017,1018,1019,1020,1021],{"id":648,"depth":140,"text":56},{"id":683,"depth":140,"text":684},{"id":717,"depth":140,"text":718,"children":1012},[1013,1014,1015],{"id":732,"depth":627,"text":733},{"id":766,"depth":627,"text":767},{"id":776,"depth":627,"text":777},{"id":820,"depth":140,"text":821},{"id":856,"depth":140,"text":857},{"id":873,"depth":140,"text":874},{"id":925,"depth":140,"text":926},{"id":943,"depth":140,"text":944},{"id":970,"depth":140,"text":971},"Tags, Filter, Tabs, Gruppen, Sorti