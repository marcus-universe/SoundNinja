944],{},"Auswahl oder ganzen Track zur Staging-Liste hinzufügen.",[31,946,947],{},"Die Liste startet leer: aufnehmen, bearbeiten, dann Clip hinzufügen.",[31,949,950,310,952,954],{},[18,951,558],{},[18,953,561],{}," in den aktuellen oder einen gewählten Tab.",[23,956,958],{"id":957},"stem-trennung-optional","Stem-Trennung (optional)",[14,960,961,962,310,965,968,969,972],{},"Der Aufnahme-Editor kann ",[18,963,964],{},"Gesang",[18,966,967],{},"Musik"," mit BS-RoFormer behalten. Das Modell ist etwa 158 MB und ",[18,970,971],{},"nicht"," im App-Paket.",[14,974,975,976,979],{},"Download unter ",[18,977,978],{},"Einstellungen → Stem-Trennung"," oder über den Erststart-Hinweis. Der Windows-Installer kann den Download beim ersten Start anbieten.",[14,981,982,983,41,986,989],{},"Source-Builds mit Stems brauchen extra Flags (",[38,984,985],{},"tauri:serve:stems",[38,987,988],{},"tauri:build:stems",").",{"title":139,"searchDepth":140,"depth":140,"links":991},[992,993,994,995],{"id":876,"depth":140,"text":877},{"id":909,"depth":140,"text":910},{"id":938,"depth":140,"text":939},{"id":957,"depth":140,"text":958},"Mikrofon oder PC-Audio aufnehmen, den Clip bearbeiten und aufs Board legen.",{},6,"\u002Frecording-editor",{"title":862,"description":996},"recording-editor","WVCwz-omL8qKJNJ8MUyps_pAkR6JqyXAMaleiMXsCq0",{"id":1004,"title":1005,"body":1006,"description":1219,"extension":147,"meta":1220,"navigation":149,"order":1221,"path":1222,"seo":1223,"stem":1224,"__hash__":1225},"content_de\u002Fremote-control.md","Fernsteuerung",{"type":7,"value":1007,"toc":1212},[1008,1011,1014,1018,1048,1051,1054,1089,1093,1113,1116,1120,1152,1156,1162],[10,1009,1005],{"id":1010},"fernsteuerung",[14,1012,1013],{},"SoundNinja kann im lokalen Netz lauschen, damit Bitfocus Companion (oder jeder HTTP\u002FWebSocket-Client) Sounds spielt und stoppt.",[23,1015,1017],{"id":1016},"remote-server-einschalten","Remote-Server einschalten",[28,1019,1020,1026,1032,1038],{},[31,1021,1022,1025],{},[18,1023,1024],{},"Einstellungen → Remote"," öffnen.",[31,1027,1028,1029,21],{},"Remote-Server aktivieren. Standardport ist ",[18,1030,1031],{},"7331",[31,1033,1034,1035,21],{},"Optional: Token setzen. Clients senden ihn als Bearer-Token oder ",[38,1036,1037],{},"?token=",[31,1039,1040,1043,1044,1047],{},[38,1041,1042],{},"http:\u002F\u002FIP:PORT"," kopieren oder die System-IP unter ",[18,1045,1046],{},"Einstellungen → Über"," holen.",[14,1049,1050],{},"Windows kann beim ersten Start eine Firewall-Abfrage zeigen. Zugriff im privaten Netz erlauben.",[23,1052,218],{"id":1053},"bitfocus-companion",[28,1055,1056,1063,1071,1082],{},[31,1057,1058,1062],{},[215,1059,218],{"href":1060,"rel":1061},"https:\u002F\u002Fbitfocus.io\u002Fcompanion",[237]," installieren.",[31,1064,1065,1070],{},[215,1066,1069],{"href":1067,"rel":1068},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Freleases\u002Flatest\u002Fdownload\u002Fcompanion-module-soundninja.tgz",[237],"companion-module-soundninja.tgz"," herunterladen. Es gibt noch kein Companion-Store-Paket.",[31,1072,1073,1074,1077,1078,1081],{},"In Companion: ",[18,1075,1076],{},"Modules → Load module package"," und die ",[38,1079,1080],{},".tgz"," wählen.",[31,1083,1084,1085,1088],{},"Eine ",[18,1086,1087],{},"Sound Ninja","-Verbindung anlegen. PC-IP, Port und Token eintragen.",[23,1090,1092],{"id":1091},"aktionen","Aktionen",[66,1094,1095,1101,1107],{},[31,1096,1097,1100],{},[18,1098,1099],{},"Trigger Sound"," — aus dem Live-Dropdown wählen oder 8-stellige Sound-ID tippen (Companion-Variablen gehen)",[31,1102,1103,1106],{},[18,1104,1105],{},"Stop Sound"," — einen spielenden Sound per ID stoppen",[31,1108,1109,1112],{},[18,1110,1111],{},"Stop All"," — alle spielenden Sounds stoppen",[14,1114,1115],{},"Sound-ID in SoundNinja über das Button-Kontextmenü oder den Mehrfachauswahl-Chip kopieren.",[23,1117,1119],{"id":1118},"feedbacks-und-variablen","Feedbacks und Variablen",[66,1121,1122,1128,1140,1146],{},[31,1123,1124,1127],{},[18