[{"data":1,"prerenderedAt":1616},["ShallowReactive",2],{"docs-page-de-\u002Ftheme-editor":3,"docs-nav-de":154},{"id":4,"title":5,"body":6,"description":146,"extension":147,"meta":148,"navigation":149,"order":150,"path":151,"seo":152,"stem":12,"__hash__":153},"content_de\u002Ftheme-editor.md","Theme-Editor",{"type":7,"value":8,"toc":138},"minimark",[9,13,22,27,58,61,65,80,84,110,113,117,124],[10,11,5],"h1",{"id":12},"theme-editor",[14,15,16,17,21],"p",{},"Der Theme Creator ist der volle visuelle Editor für dein Board. Öffnen über ",[18,19,20],"strong",{},"Einstellungen → Allgemein → Theme Creator",".",[23,24,26],"h2",{"id":25},"drei-tabs","Drei Tabs",[28,29,30,46,52],"ol",{},[31,32,33,36,37,41,42,45],"li",{},[18,34,35],{},"Allgemein"," — Theme-Name, gemeinsame Farben und Schrift-Uploads (",[38,39,40],"code",{},".ttf"," \u002F ",[38,43,44],{},".otf",")",[31,47,48,51],{},[18,49,50],{},"Buttons"," — Farben, Typo, Layout und GIF-Overlay der Sound-Buttons",[31,53,54,57],{},[18,55,56],{},"Tabs"," — Farben, Typo und Rahmenstärke der Tab-Leiste",[14,59,60],{},"Eine Live-Vorschau zeigt Tabs und Buttons beim Bearbeiten.",[23,62,64],{"id":63},"was-du-ändern-kannst","Was du ändern kannst",[66,67,68,71,74,77],"ul",{},[31,69,70],{},"Primär- und Akzentfarben, Hintergründe, Button- und Tab-Farben",[31,72,73],{},"Schriftfamilie und -größe für Buttons und Tabs",[31,75,76],{},"Button-Breite, Radius, Rahmen, Abstände und Innenabstand",[31,78,79],{},"GIF-Overlay-Deckkraft (normal und Hover)",[23,81,83],{"id":82},"speichern-und-teilen","Speichern und teilen",[66,85,86,92,98,104],{},[31,87,88,91],{},[18,89,90],{},".css exportieren"," — Theme-Datei sichern oder weitergeben",[31,93,94,97],{},[18,95,96],{},"Zu Themes hinzufügen"," — in den Themes-Ordner speichern und anwenden",[31,99,100,103],{},[18,101,102],{},".css importieren"," — Preset oder gespeichertes Theme laden",[31,105,106,109],{},[18,107,108],{},"Zurücksetzen"," — SoundNinja-Standard wiederherstellen",[14,111,112],{},"Beim Schließen mit ungespeicherten Änderungen fragt SoundNinja nach.",[23,114,116],{"id":115},"ohne-vollen-editor","Ohne vollen Editor",[14,118,119,120,123],{},"Unter ",[18,121,122],{},"Einstellungen → Allgemein"," kannst du trotzdem:",[66,125,126,129,135],{},[31,127,128],{},"Ein Theme aus der Liste wählen",[31,130,131,132,45],{},"CSS-Variablen live bearbeiten (",[18,133,134],{},"Eigenes CSS",[31,136,137],{},"Eine Theme-Datei in den Themes-Ordner importieren",{"title":139,"searchDepth":140,"depth":140,"links":141},"",2,[142,143,144,145],{"id":25,"depth":140,"text":26},{"id":63,"depth":140,"text":64},{"id":82,"depth":140,"text":83},{"id":115,"depth":140,"text":116},"Farben, Schriften, Buttons und Tabs im Theme Creator gestalten.","md",{},true,5,"\u002Ftheme-editor",{"title":5,"description":146},"h6Hta3TDDcThnouY3Pk_Omvjq8Eb8knx-HIAvf5YZd8",[155,286,507,653,1060,1149,1296,1519],{"id":156,"title":157,"body":158,"description":279,"extension":147,"meta":280,"navigation":149,"order":281,"path":282,"seo":283,"stem":284,"__hash__":285},"content_de\u002Foverview.md","Überblick",{"type":7,"value":159,"toc":273},[160,163,166,169,172,176,190,194,235,239,249,253],[10,161,157],{"id":162},"überblick",[14,164,165],{},"SoundNinja ist ein Open-Source-Soundboard für Livestreams, Chats mit Freunden und Podcast-Aufnahmen. Es läuft auf Tauri v2 und Nuxt 4 und bleibt dabei sparsam mit RAM und Speicherplatz.",[14,167,168],{},"Das Ziel: eine große Sound-Bibliothek schnell scannen und den richtigen Clip in Millisekunden abspielen. Die Oberfläche eignet sich auch als Dashboard in VR.",[14,170,171],{},"SoundNinja steckt noch in der frühen Entwicklung. Funktionen laufen, aber nicht jede Plattform ist vollständig getestet.",[23,173,175],{"id":174},"für-wen","Für wen",[66,177,178,181,184,187],{},[31,179,180],{},"Streamer, die sofortige Sound-Cues brauchen",[31,182,183],{},"Freunde, die ein gemeinsames Board für Voice-Chat wollen",[31,185,186],{},"Podcaster, die Clips aufnehmen und aufs Board legen",[31,188,189],{},"Alle, die ein anpassbares, lokales Soundboard wollen",[23,191,193],{"id":192},"was-du-tun-kannst","Was du tun kannst",[66,195,196,199,202,205,208,211,214,217,220,229,232],{},[31,197,198],{},"Ein Soundboard aus eigenen Audiodateien bauen",[31,200,201],{},"Sounds in farbigen Tabs, Gruppen, Tags und über die Suche sortieren",[31,203,204],{},"Nach Tags filtern (ODER) und nach Name, Datum, Dauer oder Größe sortieren",[31,206,207],{},"Mehrfachauswahl mit Rahmen oder Shift-Bereich, dann Farbe, Tab oder Löschen in einem Rutsch",[31,209,210],{},"Lautstärke pro Sound im Kontextmenü setzen",[31,212,213],{},"Das Aussehen mit dem Theme Creator gestalten",[31,215,216],{},"PC-Audio oder Mikrofon im Record Editor aufnehmen",[31,218,219],{},"Hotkeys einzelnen Sounds zuweisen",[31,221,222,223,228],{},"Sounds über ",[224,225,227],"a",{"href":226},"\u002Fdocs\u002Fremote-control","Bitfocus Companion"," auslösen",[31,230,231],{},"Ein komplettes Soundboard importieren und exportieren",[31,233,234],{},"GIFs oder Bilder auf Sound-Buttons legen — aus lokaler Ordnerbibliothek, GifSnap oder KLIPY",[23,236,238],{"id":237},"lizenz","Lizenz",[14,240,241,242,248],{},"SoundNinja ist freie Software unter ",[224,243,247],{"href":244,"rel":245},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fblob\u002Fmain\u002FLICENSE",[246],"nofollow","GPL-3.0",". Forken, ändern, teilen.",[23,250,252],{"id":251},"nächste-schritte","Nächste Schritte",[28,254,255,261,267],{},[31,256,257],{},[224,258,260],{"href":259},"\u002Fdocs\u002Finstallation","SoundNinja installieren",[31,262,263],{},[224,264,266],{"href":265},"\u002Fdocs\u002Fadding-sounds","Sounds hinzufügen",[31,268,269],{},[224,270,272],{"href":271},"\u002Fdocs\u002Forganizing-sounds","Board organisieren",{"title":139,"searchDepth":140,"depth":140,"links":274},[275,276,277,278],{"id":174,"depth":140,"text":175},{"id":192,"depth":140,"text":193},{"id":237,"depth":140,"text":238},{"id":251,"depth":140,"text":252},"Was SoundNinja ist und was du damit machen kannst.",{},1,"\u002Foverview",{"title":157,"description":279},"overview","NKjfErgZuRFyQOJf6ppAsKHoUKCnyQ4MYR-evnuglSg",{"id":287,"title":288,"body":289,"description":502,"extension":147,"meta":503,"navigation":149,"order":140,"path":504,"seo":505,"stem":293,"__hash__":506},"content_de\u002Finstallation.md","Installation",{"type":7,"value":290,"toc":495},[291,294,308,312,333,336,340,354,357,361,385,396,400,407,411,425,455,470,491],[10,292,288],{"id":293},"installation",[14,295,296,297,301,302,307],{},"Hol dir einen Build von der ",[224,298,300],{"href":299},"\u002Fdownload","Download-Seite"," oder von ",[224,303,306],{"href":304,"rel":305},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Freleases\u002Flatest",[246],"GitHub Releases",". SoundNinja ist in früher Entwicklung — behandle Builds als Beta.",[23,309,311],{"id":310},"windows","Windows",[66,313,314,324,327,330],{},[31,315,316,319,320,323],{},[18,317,318],{},"Installer (.exe)"," oder ",[18,321,322],{},"MSI (.msi)"," für 64-Bit-Windows",[31,325,326],{},"Landing-Page-Ziel: Windows 10 und neuer",[31,328,329],{},"Die App-README nennt auch Windows 8 und höher",[31,331,332],{},"Der NSIS-Installer ist dunkel. Sprache beim Setup wählen — SoundNinja merkt sie beim nächsten Start.",[14,334,335],{},"Installer starten, dann SoundNinja über das Startmenü öffnen.",[23,337,339],{"id":338},"macos","macOS",[66,341,342,348,351],{},[31,343,344,347],{},[18,345,346],{},"Universelles .dmg"," für Apple Silicon und Intel",[31,349,350],{},"Landing-Page-Ziel: macOS 10.14 und neuer",[31,352,353],{},"Die App-README nennt macOS 10.15 und höher",[14,355,356],{},"Disk-Image öffnen und SoundNinja nach Programme ziehen.",[23,358,360],{"id":359},"linux","Linux",[66,362,363,369,375,382],{},[31,364,365,368],{},[18,366,367],{},"Debian (.deb)"," für Ubuntu \u002F Debian",[31,370,371,374],{},[18,372,373],{},"AppImage"," für andere Distros",[31,376,377,378,381],{},"Nach Veröffentlichung einer Release können Arch-Nutzer ",[38,379,380],{},"soundninja-bin"," aus dem AUR installieren",[31,383,384],{},"Getestet unter Ubuntu 20.04",[14,386,387,388,391,392,395],{},"Desktop-Builds brauchen WebKit- und GTK-Pakete. Unter Debian\u002FUbuntu meist ",[38,389,390],{},"libwebkit2gtk",", ",[38,393,394],{},"libgtk-3-0"," und eine App-Indicator-Bibliothek.",[23,397,399],{"id":398},"updates","Updates",[14,401,402,403,406],{},"In der App: ",[18,404,405],{},"Hilfe → Nach Updates suchen",". Optional prüft SoundNinja beim Start in den Einstellungen.",[23,408,410],{"id":409},"aus-dem-quellcode-bauen","Aus dem Quellcode bauen",[14,412,413,414,391,419,424],{},"Eigenen Build? ",[224,415,418],{"href":416,"rel":417},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja",[246],"Repo klonen",[224,420,423],{"href":421,"rel":422},"https:\u002F\u002Fv2.tauri.app\u002Fstart\u002Fprerequisites\u002F",[246],"Tauri-Voraussetzungen"," installieren, dann:",[426,427,431],"pre",{"className":428,"code":429,"language":430,"meta":139,"style":139},"language-bash shiki shiki-themes github-light github-dark","bun install\nbun run tauri:serve\n","bash",[38,432,433,445],{"__ignoreMap":139},[434,435,437,441],"span",{"class":436,"line":281},"line",[434,438,440],{"class":439},"sScJk","bun",[434,442,444],{"class":443},"sZZnC"," install\n",[434,446,447,449,452],{"class":436,"line":140},[434,448,440],{"class":439},[434,450,451],{"class":443}," run",[434,453,454],{"class":443}," tauri:serve\n",[14,456,457,391,460,319,463,466,467,21],{},[38,458,459],{},"npm",[38,461,462],{},"pnpm",[38,464,465],{},"deno"," gehen auch. Produktionsbuild: ",[38,468,469],{},"bun run tauri:build",[14,471,472,475,476,481,482,485,486,21],{},[18,473,474],{},"Nur Windows:"," jeder Windows-Compile enthält ASIO über das ",[224,477,480],{"href":478,"rel":479},"https:\u002F\u002Fwww.steinberg.net\u002Fasiosdk",[246],"Steinberg ASIO SDK",". Einmal ",[38,483,484],{},"bun run setup:asio"," (SDK nicht im Git). Linux und macOS nutzen PipeWire \u002F Core Audio — diesen Schritt überspringen. Details: ",[224,487,490],{"href":488,"rel":489},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fblob\u002Fmain\u002Fdocs\u002Fbuild-from-source.md",[246],"build-from-source.md",[492,493,494],"style",{},"html pre.shiki code .sScJk, html code.shiki .sScJk{--shiki-default:#6F42C1;--shiki-dark:#B392F0}html pre.shiki code .sZZnC, html code.shiki .sZZnC{--shiki-default:#032F62;--shiki-dark:#9ECBFF}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html.dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}",{"title":139,"searchDepth":140,"depth":140,"links":496},[497,498,499,500,501],{"id":310,"depth":140,"text":311},{"id":338,"depth":140,"text":339},{"id":359,"depth":140,"text":360},{"id":398,"depth":140,"text":399},{"id":409,"depth":140,"text":410},"SoundNinja unter Windows, macOS oder Linux installieren.",{},"\u002Finstallation",{"title":288,"description":502},"OPh-0WbR2ebU9niw-poNeR6zaGWqUJm2ONgxhb61JBU",{"id":508,"title":266,"body":509,"description":646,"extension":147,"meta":647,"navigation":149,"order":648,"path":649,"seo":650,"stem":651,"__hash__":652},"content_de\u002Fadding-sounds.md",{"type":7,"value":510,"toc":638},[511,514,517,521,538,542,573,577,596,600,614,617,621,628,632],[10,512,266],{"id":513},"sounds-hinzufügen",[14,515,516],{},"Ein Board bleibt leer, bis du Clips hinzufügst. SoundNinja importiert Dateien, ganze Ordner, eine Aufnahme oder ein geteiltes Soundboard-Paket.",[23,518,520],{"id":519},"audiodateien-importieren","Audiodateien importieren",[28,522,523,532,535],{},[31,524,525,319,528,531],{},[18,526,527],{},"Datei → Audiodateien importieren",[18,529,530],{},"Import"," in der Navbar.",[31,533,534],{},"Eine oder mehrere Audiodateien wählen.",[31,536,537],{},"Sounds landen im aktuellen Tab.",[23,539,541],{"id":540},"ordner-importieren","Ordner importieren",[28,543,544,553,556],{},[31,545,546,549,550,552],{},[18,547,548],{},"Datei → Ordner importieren"," (oder ",[18,551,541],{}," in der Navbar).",[31,554,555],{},"Einen oder mehrere Ordner hinzufügen. Vor dem Import per Drag neu sortieren.",[31,557,558,559],{},"Ziel wählen:\n",[66,560,561,567],{},[31,562,563,566],{},[18,564,565],{},"Als Tabs importieren"," — jeder Ordner wird ein eigener Tab",[31,568,569,572],{},[18,570,571],{},"In aktuellen Tab importieren"," — alle Dateien landen im aktiven Tab",[23,574,576],{"id":575},"clip-aufnehmen","Clip aufnehmen",[14,578,579,580,584,585,588,589,319,592,595],{},"Öffne den ",[224,581,583],{"href":582},"\u002Fdocs\u002Frecording-editor","Record Editor"," über ",[18,586,587],{},"Aufnahme"," in der Player-Leiste. Aufnehmen, zuschneiden, dann ",[18,590,591],{},"Auswahl importieren",[18,593,594],{},"Alle importieren"," in den aktuellen Tab oder einen gewählten Tab.",[23,597,599],{"id":598},"soundboard-importieren","Soundboard importieren",[14,601,602,605,606,609,610,613],{},[18,603,604],{},"Datei → Soundboard importieren"," lädt ein geteiltes Paket. Pakete sind ein ",[38,607,608],{},".zip"," mit ",[38,611,612],{},"project.sninja"," plus Sounddateien. Danach Projekt öffnen und abspielen.",[14,615,616],{},"Du kannst mehrere Projekte (Profile) halten. Über den Projektwähler zwischen Boards wechseln.",[23,618,620],{"id":619},"fehlende-dateien-neu-verknüpfen","Fehlende Dateien neu verknüpfen",[14,622,623,624,627],{},"Wenn Audiodateien auf der Festplatte umziehen, zeigt SoundNinja ",[18,625,626],{},"Fehlende Sounddateien",". Einen Suchordner wählen und Clips neu verknüpfen.",[23,629,631],{"id":630},"weiter","Weiter",[14,633,634,635,21],{},"Tabs, Tags, Filter und Hotkeys: ",[224,636,637],{"href":271},"Sounds organisieren",{"title":139,"searchDepth":140,"depth":140,"links":639},[640,641,642,643,644,645],{"id":519,"depth":140,"text":520},{"id":540,"depth":140,"text":541},{"id":575,"depth":140,"text":576},{"id":598,"depth":140,"text":599},{"id":619,"depth":140,"text":620},{"id":630,"depth":140,"text":631},"Audio, Ordner, Aufnahmen und geteilte Soundboards importieren.",{},3,"\u002Fadding-sounds",{"title":266,"description":646},"adding-sounds","H_ls9_vOwDkgTWPkfe9bQz1A0XidUOmMFV4V2EJpYec",{"id":654,"title":637,"body":655,"description":1053,"extension":147,"meta":1054,"navigation":149,"order":1055,"path":1056,"seo":1057,"stem":1058,"__hash__":1059},"content_de\u002Forganizing-sounds.md",{"type":7,"value":656,"toc":1038},[657,660,667,670,696,702,706,709,723,730,736,740,750,755,785,789,795,799,833,839,843,846,872,875,879,892,896,901,921,937,944,948,959,962,966,973,983,989,993,1001,1008,1035],[10,658,637],{"id":659},"sounds-organisieren",[14,661,662,663,666],{},"SoundNinja ist für große Bibliotheken gebaut. ",[18,664,665],{},"Tags und Filter",", Tabs, Suche, Mehrfachauswahl und Hotkeys — der Clip ist einen Klick (oder eine Taste) entfernt.",[23,668,56],{"id":669},"tabs",[66,671,672,679,686],{},[31,673,674,675,678],{},"Tab mit ",[18,676,677],{},"Tab hinzufügen"," anlegen. Farbe vergeben, damit die Leiste schnell scannbar bleibt.",[31,680,681,682,685],{},"Die Ansicht ",[18,683,684],{},"Alle"," zeigt jeden Sound über alle Tabs.",[31,687,688,689,692,693,21],{},"Ein Sound kann ",[18,690,691],{},"einem oder mehreren Tabs"," gehören. Rechtsklick → ",[18,694,695],{},"Zu Tab verschieben",[14,697,698,699,701],{},"Tab-Übergänge: ",[18,700,122],{}," — Slide, Fade, Buttons nacheinander oder Keine.",[23,703,705],{"id":704},"gruppen","Gruppen",[14,707,708],{},"Seit v0.5.3 können Trenner zu benannten Gruppen werden:",[66,710,711,714,717,720],{},[31,712,713],{},"Gruppe über das Kontextmenü hinzufügen, umbenennen oder entfernen",[31,715,716],{},"Gruppenkopf ziehen — Kinder kommen mit",[31,718,719],{},"Sounds in eine Gruppe legen oder herausnehmen",[31,721,722],{},"Rahmenfarbe, Namensfarbe und Button-Ausrichtung setzen (oder Tab-Standard nutzen)",[14,724,725,726,729],{},"Ein einfacher ",[18,727,728],{},"Trenner"," geht weiter, wenn du nur einen visuellen Bruch brauchst.",[14,731,732,733,21],{},"Rechtsklick auf leeren Board-Bereich: ",[18,734,735],{},"Gruppe hinzufügen",[23,737,739],{"id":738},"tags-filter","Tags \u002F Filter",[14,741,742,743,746,747,749],{},"Tags gelten tabübergreifend. Das ausfahrbare ",[18,744,745],{},"Filter","-Panel (Sidebar ",[18,748,745],{},") ist der Ort zum Anlegen und zum Filtern des Boards.",[751,752,754],"h3",{"id":753},"tags-anlegen-und-bearbeiten","Tags anlegen und bearbeiten",[28,756,757,762,772,778],{},[31,758,759,761],{},[18,760,745],{}," in der Sidebar öffnen.",[31,763,119,764,767,768,771],{},[18,765,766],{},"Tags"," → ",[18,769,770],{},"Tag hinzufügen"," — Name und Farbe vergeben.",[31,773,774,775,21],{},"Im selben Panel umbenennen, umfärben oder ",[18,776,777],{},"Tag löschen",[31,779,780,781,784],{},"Steht da ",[18,782,783],{},"Noch keine Tags",", zuerst hier einen anlegen, bevor du zuweist.",[751,786,788],{"id":787},"tags-an-sounds-hängen","Tags an Sounds hängen",[14,790,791,792,794],{},"Rechtsklick auf einen Sound → ",[18,793,766],{}," (Checkboxen). Ein Sound darf mehrere Tags haben. Existieren noch keine, zeigt das Menü den Weg zum Filter-Panel.",[751,796,798],{"id":797},"board-filtern","Board filtern",[66,800,801,808,819,830],{},[31,802,803,804,807],{},"Tags im Filter-Panel oder als ",[18,805,806],{},"Chips unter der Suchleiste"," umschalten.",[31,809,810,811,814,815,818],{},"Abgleich ist ",[18,812,813],{},"ODER",": ein Sound bleibt sichtbar, wenn er ",[18,816,817],{},"irgendeinen"," gewählten Tag hat.",[31,820,821,822,825,826,829],{},"Das Feld ",[18,823,824],{},"Suche"," in der Navbar kombiniert per ",[18,827,828],{},"UND"," mit dem aktiven Tag-Filter (Tippen + Tags zusammen).",[31,831,832],{},"Chips aus (oder Filter leeren), um den ganzen Tab wieder zu sehen.",[14,834,835,836,21],{},"Farbige Tag-Namen können auf Buttons erscheinen. Schalter: ",[18,837,838],{},"Einstellungen → Verhalten → Tag-Badges anzeigen",[23,840,842],{"id":841},"sortierung","Sortierung",[14,844,845],{},"Im Filter-Panel eine Sortierung wählen:",[66,847,848,854],{},[31,849,850,853],{},[18,851,852],{},"Benutzerdefiniert"," — deine Tab-Reihenfolge, Gruppen sichtbar",[31,855,856,391,859,391,862,319,865,868,869],{},[18,857,858],{},"Name",[18,860,861],{},"Hinzugefügt",[18,863,864],{},"Spielzeit",[18,866,867],{},"Dateigröße"," — flache sortierte Liste; ",[18,870,871],{},"Gruppen sind ausgeblendet",[14,873,874],{},"Sortierung nach Dauer kann beim ersten Mal die Dauer-Metadaten vorwärmen.",[23,876,878],{"id":877},"neu-anordnen","Neu anordnen",[14,880,881,882,885,886,889,890,21],{},"Drag-and-Drop in ",[18,883,884],{},"Einstellungen → Verhalten"," einschalten (",[18,887,888],{},"Neu anordnen erlauben","). Dann Sounds und Gruppen ziehen. Neu anordnen gilt bei ",[18,891,852],{},[23,893,895],{"id":894},"mehrfachauswahl","Mehrfachauswahl",[14,897,898,900],{},[18,899,895],{}," in der Navbar einschalten, dann:",[66,902,903,906,912,918],{},[31,904,905],{},"Klick toggelt einen Sound",[31,907,908,911],{},[18,909,910],{},"Shift+Klick"," wählt einen Bereich ab dem letzten Anker",[31,913,914,917],{},[18,915,916],{},"Rahmen"," auf leerem Board ziehen",[31,919,920],{},"Klick auf leeres Board (oder außerhalb) leert die Auswahl",[14,922,923,924,391,927,391,930,933,934,21],{},"Eine Sammelleiste zeigt die Anzahl plus ",[18,925,926],{},"Farbe",[18,928,929],{},"Zu Tab verschieben…",[18,931,932],{},"Löschen"," und ",[18,935,936],{},"Fertig",[14,938,939,940,943],{},"In der Mehrfachauswahl zeigt jeder Button einen ",[18,941,942],{},"8-Zeichen-ID-Chip",". Rechtsklick auf den Chip kopiert die ID.",[23,945,947],{"id":946},"lautstärke-pro-sound","Lautstärke pro Sound",[14,949,950,951,954,955,958],{},"Rechtsklick → ",[18,952,953],{},"Lautstärke",". Slider von 0 % bis 100 %. ",[18,956,957],{},"Doppelklick"," setzt auf 100 % zurück.",[14,960,961],{},"Das stapelt sich mit der Master-Ausgangslautstärke in den Einstellungen.",[23,963,965],{"id":964},"hotkeys-und-sound-ids","Hotkeys und Sound-IDs",[14,967,968,969,972],{},"Jeder Sound hat eine 8-stellige ID. Kopieren über das Button-Kontextmenü (",[18,970,971],{},"ID kopieren",") oder den Mehrfachauswahl-Chip.",[14,974,975,978,979,982],{},[18,976,977],{},"Einstellungen → Hotkeys",": Taste an eine Sound-ID binden. Globale Hotkeys sind optional. ",[18,980,981],{},"Hotkey zuweisen"," im Kontextmenü springt dorthin, ID vorausgefüllt.",[14,984,985,986,988],{},"Dieselbe ID nutzt ",[224,987,227],{"href":226}," zum Auslösen.",[23,990,992],{"id":991},"hintergrundbilder-und-farben","Hintergrundbilder und Farben",[14,994,995,996,1000],{},"Rechtsklick auf einen Sound: eigene Farben oder ein Hintergrundbild. Das ist getrennt vom ",[224,997,999],{"href":998},"\u002Fdocs\u002Ftheme-editor","Theme Creator",", der das ganze Board gestaltet.",[14,1002,1003,1004,1007],{},"Der Picker ist ein Dialog ",[18,1005,1006],{},"Hintergrundbild"," (PNG, JPEG, GIF, WebP):",[66,1009,1010,1016,1026],{},[31,1011,1012,1015],{},[18,1013,1014],{},"Lokale Dateien"," — Ordner hinzufügen, einzelne Datei wählen, Dateinamen suchen, Rastervorschau, Ordner aus der Bibliothek entfernen",[31,1017,1018,1021,1022,21],{},[18,1019,1020],{},"GifSnap"," — GIFs online suchen, ohne API-Key. Beim ersten Besuch musst du GifSnap-Anfragen akzeptieren; Suchergebnisse werden gecacht, um Traffic zu sparen. Siehe ",[224,1023,1020],{"href":1024,"rel":1025},"https:\u002F\u002Fgifsnap.com",[246],[31,1027,1028,1031,1032,1034],{},[18,1029,1030],{},"KLIPY"," — GIFs online suchen. Eigenen API-Key unter ",[18,1033,884],{},". Der Key landet nicht in Projektdateien.",[14,1036,1037],{},"Nach der Wahl Bild auf dem Button schieben und zuschneiden.",{"title":139,"searchDepth":140,"depth":140,"links":1039},[1040,1041,1042,1047,1048,1049,1050,1051,1052],{"id":669,"depth":140,"text":56},{"id":704,"depth":140,"text":705},{"id":738,"depth":140,"text":739,"children":1043},[1044,1045,1046],{"id":753,"depth":648,"text":754},{"id":787,"depth":648,"text":788},{"id":797,"depth":648,"text":798},{"id":841,"depth":140,"text":842},{"id":877,"depth":140,"text":878},{"id":894,"depth":140,"text":895},{"id":946,"depth":140,"text":947},{"id":964,"depth":140,"text":965},{"id":991,"depth":140,"text":992},"Tags, Filter, Tabs, Gruppen, Sortierung, Mehrfachauswahl, Lautstärke und Hotkeys.",{},4,"\u002Forganizing-sounds",{"title":637,"description":1053},"organizing-sounds","jIHdo3ArhbXIxbWQI561fKtutYzeQgCkElssurn8EGo",{"id":4,"title":5,"body":1061,"description":146,"extension":147,"meta":1147,"navigation":149,"order":150,"path":151,"seo":1148,"stem":12,"__hash__":153},{"type":7,"value":1062,"toc":1141},[1063,1065,1069,1071,1089,1091,1093,1103,1105,1123,1125,1127,1131],[10,1064,5],{"id":12},[14,1066,16,1067,21],{},[18,1068,20],{},[23,1070,26],{"id":25},[28,1072,1073,1081,1085],{},[31,1074,1075,36,1077,41,1079,45],{},[18,1076,35],{},[38,1078,40],{},[38,1080,44],{},[31,1082,1083,51],{},[18,1084,50],{},[31,1086,1087,57],{},[18,1088,56],{},[14,1090,60],{},[23,1092,64],{"id":63},[66,1094,1095,1097,1099,1101],{},[31,1096,70],{},[31,1098,73],{},[31,1100,76],{},[31,1102,79],{},[23,1104,83],{"id":82},[66,1106,1107,1111,1115,1119],{},[31,1108,1109,91],{},[18,1110,90],{},[31,1112,1113,97],{},[18,1114,96],{},[31,1116,1117,103],{},[18,1118,102],{},[31,1120,1121,109],{},[18,1122,108],{},[14,1124,112],{},[23,1126,116],{"id":115},[14,1128,119,1129,123],{},[18,1130,122],{},[66,1132,1133,1135,1139],{},[31,1134,128],{},[31,1136,131,1137,45],{},[18,1138,134],{},[31,1140,137],{},{"title":139,"searchDepth":140,"depth":140,"links":1142},[1143,1144,1145,1146],{"id":25,"depth":140,"text":26},{"id":63,"depth":140,"text":64},{"id":82,"depth":140,"text":83},{"id":115,"depth":140,"text":116},{},{"title":5,"description":146},{"id":1150,"title":1151,"body":1152,"description":1289,"extension":147,"meta":1290,"navigation":149,"order":1291,"path":1292,"seo":1293,"stem":1294,"__hash__":1295},"content_de\u002Frecording-editor.md","Aufnahme-Editor",{"type":7,"value":1153,"toc":1283},[1154,1157,1163,1167,1173,1193,1196,1200,1225,1229,1244,1248,1262,1273],[10,1155,1151],{"id":1156},"aufnahme-editor",[14,1158,1159,1160,1162],{},"Nimm einen Clip in SoundNinja auf, schneide ihn zu und importiere ihn in einen Tab. Öffnen über ",[18,1161,587],{}," in der Player-Leiste.",[23,1164,1166],{"id":1165},"eingang-wählen","Eingang wählen",[14,1168,119,1169,1172],{},[18,1170,1171],{},"Einstellungen → Audio",":",[66,1174,1175,1181,1187],{},[31,1176,1177,1180],{},[18,1178,1179],{},"Eingabegeräte"," — Mikrofon",[31,1182,1183,1186],{},[18,1184,1185],{},"Ausgabegeräte (PC-Audio)"," — Loopback dessen, was der PC spielt",[31,1188,1189,1192],{},[18,1190,1191],{},"Eingangslautstärke"," — Aufnahme-Gain von 0 % bis 200 %",[14,1194,1195],{},"Der Aufnahme-Button nutzt das hier gewählte Gerät.",[23,1197,1199],{"id":1198},"take-bearbeiten","Take bearbeiten",[66,1201,1202,1205,1208,1216,1219,1222],{},[31,1203,1204],{},"Aufnehmen und stoppen",[31,1206,1207],{},"Pegelmesser beobachten",[31,1209,1210,319,1213],{},[18,1211,1212],{},"Normalisieren",[18,1214,1215],{},"Rauschunterdrückung",[31,1217,1218],{},"Ganzen Clip trimmen, auf Auswahl trimmen oder Auswahl löschen",[31,1220,1221],{},"Rückgängig \u002F Wiederholen",[31,1223,1224],{},"Rein- und rauszoomen",[23,1226,1228],{"id":1227},"stagen-und-importieren","Stagen und importieren",[28,1230,1231,1234,1237],{},[31,1232,1233],{},"Auswahl oder ganzen Track zur Staging-Liste hinzufügen.",[31,1235,1236],{},"Die Liste startet leer: aufnehmen, bearbeiten, dann Clip hinzufügen.",[31,1238,1239,319,1241,1243],{},[18,1240,591],{},[18,1242,594],{}," in den aktuellen oder einen gewählten Tab.",[23,1245,1247],{"id":1246},"stem-trennung-optional","Stem-Trennung (optional)",[14,1249,1250,1251,1254,1255,319,1258,1261],{},"Offizielle Windows-, macOS- und Linux-Release-Builds enthalten das ",[18,1252,1253],{},"Stems","-Feature. Der Aufnahme-Editor kann ",[18,1256,1257],{},"Gesang",[18,1259,1260],{},"Musik"," mit BS-RoFormer behalten.",[14,1263,1264,1265,1268,1269,1272],{},"Das Modell ist etwa 158 MB und ",[18,1266,1267],{},"nicht"," im Installer. Download unter ",[18,1270,1271],{},"Einstellungen → Stem-Trennung"," oder über den Erststart-Hinweis. Der Windows-Installer kann den Download beim ersten Start anbieten.",[14,1274,1275,1276,41,1279,1282],{},"Eigene Source-Builds brauchen extra Flags (",[38,1277,1278],{},"tauri:serve:stems",[38,1280,1281],{},"tauri:build:stems",").",{"title":139,"searchDepth":140,"depth":140,"links":1284},[1285,1286,1287,1288],{"id":1165,"depth":140,"text":1166},{"id":1198,"depth":140,"text":1199},{"id":1227,"depth":140,"text":1228},{"id":1246,"depth":140,"text":1247},"Mikrofon oder PC-Audio aufnehmen, den Clip bearbeiten und aufs Board legen.",{},6,"\u002Frecording-editor",{"title":1151,"description":1289},"recording-editor","mBUN6yUiwk-kNjhsf48NlWEXXhjw6cOuSAkybSa9wi0",{"id":1297,"title":1298,"body":1299,"description":1512,"extension":147,"meta":1513,"navigation":149,"order":1514,"path":1515,"seo":1516,"stem":1517,"__hash__":1518},"content_de\u002Fremote-control.md","Fernsteuerung",{"type":7,"value":1300,"toc":1505},[1301,1304,1307,1311,1341,1344,1347,1382,1386,1406,1409,1413,1445,1449,1455],[10,1302,1298],{"id":1303},"fernsteuerung",[14,1305,1306],{},"SoundNinja kann im lokalen Netz lauschen, damit Bitfocus Companion (oder jeder HTTP\u002FWebSocket-Client) Sounds spielt und stoppt.",[23,1308,1310],{"id":1309},"remote-server-einschalten","Remote-Server einschalten",[28,1312,1313,1319,1325,1331],{},[31,1314,1315,1318],{},[18,1316,1317],{},"Einstellungen → Remote"," öffnen.",[31,1320,1321,1322,21],{},"Remote-Server aktivieren. Standardport ist ",[18,1323,1324],{},"7331",[31,1326,1327,1328,21],{},"Optional: Token setzen. Clients senden ihn als Bearer-Token oder ",[38,1329,1330],{},"?token=",[31,1332,1333,1336,1337,1340],{},[38,1334,1335],{},"http:\u002F\u002FIP:PORT"," kopieren oder die System-IP unter ",[18,1338,1339],{},"Einstellungen → Über"," holen.",[14,1342,1343],{},"Windows kann beim ersten Start eine Firewall-Abfrage zeigen. Zugriff im privaten Netz erlauben.",[23,1345,227],{"id":1346},"bitfocus-companion",[28,1348,1349,1356,1364,1375],{},[31,1350,1351,1355],{},[224,1352,227],{"href":1353,"rel":1354},"https:\u002F\u002Fbitfocus.io\u002Fcompanion",[246]," installieren.",[31,1357,1358,1363],{},[224,1359,1362],{"href":1360,"rel":1361},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002Fcompanion-module-soundninja\u002Freleases\u002Flatest",[246],"SoundNinja-Companion.tgz"," herunterladen. Es gibt noch kein Companion-Store-Paket.",[31,1365,1366,1367,1370,1371,1374],{},"In Companion: ",[18,1368,1369],{},"Modules → Load module package"," und die ",[38,1372,1373],{},".tgz"," wählen.",[31,1376,1377,1378,1381],{},"Eine ",[18,1379,1380],{},"Sound Ninja","-Verbindung anlegen. PC-IP, Port und Token eintragen.",[23,1383,1385],{"id":1384},"aktionen","Aktionen",[66,1387,1388,1394,1400],{},[31,1389,1390,1393],{},[18,1391,1392],{},"Trigger Sound"," — aus dem Live-Dropdown wählen oder 8-stellige Sound-ID tippen (Companion-Variablen gehen)",[31,1395,1396,1399],{},[18,1397,1398],{},"Stop Sound"," — einen spielenden Sound per ID stoppen",[31,1401,1402,1405],{},[18,1403,1404],{},"Stop All"," — alle spielenden Sounds stoppen",[14,1407,1408],{},"Sound-ID in SoundNinja über das Button-Kontextmenü oder den Mehrfachauswahl-Chip kopieren.",[23,1410,1412],{"id":1411},"feedbacks-und-variablen","Feedbacks und Variablen",[66,1414,1415,1421,1433,1439],{},[31,1416,1417,1420],{},[18,1418,1419],{},"Sound Playing"," — wahr, solange diese Sound-ID aktiv ist (für Button-Farbe)",[31,1422,1423,1426,1427,41,1430],{},[38,1424,1425],{},"$(soundninja:connected)"," — ",[38,1428,1429],{},"true",[38,1431,1432],{},"false",[31,1434,1435,1438],{},[38,1436,1437],{},"$(soundninja:playing_count)"," — wie viele Sounds spielen",[31,1440,1441,1444],{},[38,1442,1443],{},"$(soundninja:last_triggered)"," — zuletzt ausgelöste Sound-ID",[23,1446,1448],{"id":1447},"http-api-fortgeschritten","HTTP-API (fortgeschritten)",[14,1450,1451,1452],{},"Basispfad: ",[38,1453,1454],{},"\u002Fapi\u002Fv1",[66,1456,1457,1463,1469,1475,1484,1490,1499],{},[31,1458,1459,1462],{},[38,1460,1461],{},"GET \u002Finfo"," — App-Name, Version, Protokoll, ob ein Token nötig ist",[31,1464,1465,1468],{},[38,1466,1467],{},"GET \u002Fsounds"," — Soundliste (id, name, tabs, active)",[31,1470,1471,1474],{},[38,1472,1473],{},"GET \u002Fstate"," — Sounds plus gerade spielende IDs",[31,1476,1477,609,1480,1483],{},[38,1478,1479],{},"POST \u002Ftrigger",[38,1481,1482],{},"{ \"id\" }"," — Sound abspielen",[31,1485,1486,1489],{},[38,1487,1488],{},"GET \u002Ftrigger\u002F:id"," — abspielen (einfach im Browser testen)",[31,1491,1492,1495,1496,1498],{},[38,1493,1494],{},"POST \u002Fstop"," mit optionalem ",[38,1497,1482],{}," — einen Sound oder alle stoppen",[31,1500,1501,1504],{},[38,1502,1503],{},"GET \u002Fws"," — Live-Status; Trigger\u002FStop eingehend senden",{"title":139,"searchDepth":140,"depth":140,"links":1506},[1507,1508,1509,1510,1511],{"id":1309,"depth":140,"text":1310},{"id":1346,"depth":140,"text":227},{"id":1384,"depth":140,"text":1385},{"id":1411,"depth":140,"text":1412},{"id":1447,"depth":140,"text":1448},"SoundNinja über das lokale Netz mit Bitfocus Companion auslösen.",{},7,"\u002Fremote-control",{"title":1298,"description":1512},"remote-control","pzsqq4CZS4ZlSf2WDcYK0UyO02dUISTU454C3gbbJFw",{"id":1520,"title":1521,"body":1522,"description":1610,"extension":147,"meta":1611,"navigation":149,"order":1612,"path":1613,"seo":1614,"stem":1526,"__hash__":1615},"content_de\u002Fsupport.md","Support",{"type":7,"value":1523,"toc":1603},[1524,1527,1530,1534,1537,1544,1552,1556,1563,1565,1577,1581,1592,1596],[10,1525,1521],{"id":1526},"support",[14,1528,1529],{},"SoundNinja ist ein Community-Projekt in früher Beta. Der schnellste Weg zur Hilfe ist GitHub.",[23,1531,1533],{"id":1532},"fehler-melden-oder-frage-stellen","Fehler melden oder Frage stellen",[14,1535,1536],{},"Issue auf GitHub öffnen:",[14,1538,1539],{},[224,1540,1543],{"href":1541,"rel":1542},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fissues",[246],"github.com\u002Fmarcus-universe\u002FSoundNinja\u002Fissues",[14,1545,1546,1547,319,1549,1551],{},"OS, SoundNinja-Version (",[18,1548,405],{},[18,1550,1339],{},") und Schritte zum Nachstellen angeben.",[23,1553,1555],{"id":1554},"e-mail","E-Mail",[14,1557,1558,1559],{},"Maintainer: ",[224,1560,1562],{"href":1561},"mailto:contact@marcus-universe.de","contact@marcus-universe.de",[23,1564,399],{"id":398},[14,1566,402,1567,1569,1570,1572,1573,21],{},[18,1568,405],{},". Neue Builds stehen auch auf der ",[224,1571,300],{"href":299}," und bei ",[224,1574,306],{"href":1575,"rel":1576},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Freleases",[246],[23,1578,1580],{"id":1579},"mitmachen","Mitmachen",[14,1582,1583,1584,1588,1589,21],{},"Pull Requests sind willkommen. App-Repo: ",[224,1585,1587],{"href":416,"rel":1586},[246],"github.com\u002Fmarcus-universe\u002FSoundNinja",". Lizenz: ",[224,1590,247],{"href":244,"rel":1591},[246],[23,1593,1595],{"id":1594},"rechtliches","Rechtliches",[14,1597,1598,1599,21],{},"Impressum und Kontaktdaten: ",[224,1600,1602],{"href":1601},"\u002Fimpressum","Impressum",{"title":139,"searchDepth":140,"depth":140,"links":1604},[1