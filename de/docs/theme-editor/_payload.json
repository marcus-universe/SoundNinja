 Arch-Nutzer ",[38,379,380],{},"soundninja-bin"," aus dem AUR installieren",[31,383,384],{},"Getestet unter Ubuntu 20.04",[14,386,387,388,391,392,395],{},"Desktop-Builds brauchen WebKit- und GTK-Pakete. Unter Debian\u002FUbuntu meist ",[38,389,390],{},"libwebkit2gtk",", ",[38,393,394],{},"libgtk-3-0"," und eine App-Indicator-Bibliothek.",[23,397,399],{"id":398},"updates","Updates",[14,401,402,403,406],{},"In der App: ",[18,404,405],{},"Hilfe → Nach Updates suchen",". Optional prüft SoundNinja beim Start in den Einstellungen.",[23,408,410],{"id":409},"aus-dem-quellcode-bauen","Aus dem Quellcode bauen",[14,412,413,414,391,419,424],{},"Eigenen Build? ",[224,415,418],{"href":416,"rel":417},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja",[246],"Repo klonen",[224,420,423],{"href":421,"rel":422},"https:\u002F\u002Fv2.tauri.app\u002Fstart\u002Fprerequisites\u002F",[246],"Tauri-Voraussetzungen"," installieren, dann:",[426,427,431],"pre",{"className":428,"code":429,"language":430,"meta":139,"style":139},"language-bash shiki shiki-themes github-light github-dark","bun install\nbun run tauri:serve\n","bash",[38,432,433,445],{"__ignoreMap":139},[434,435,437,441],"span",{"class":436,"line":281},"line",[434,438,440],{"class":439},"sScJk","bun",[434,442,444],{"class":443},"sZZnC"," install\n",[434,446,447,449,452],{"class":436,"line":140},[434,448,440],{"class":439},[434,450,451],{"class":443}," run",[434,453,454],{"class":443}," tauri:serve\n",[14,456,457,391,460,319,463,466,467,21],{},[38,458,459],{},"npm",[38,461,462],{},"pnpm",[38,464,465],{},"deno"," gehen auch. Produktionsbuild: ",[38,468,469],{},"bun run tauri:build",[14,471,472,475,476,481,482,485,486,21],{},[18,473,474],{},"Nur Windows:"," jeder Windows-Compile enthält ASIO über das ",[224,477,480],{"href":478,"rel":479},"https:\u002F\u002Fwww.steinberg.net\u002Fasiosdk",[246],"Steinberg ASIO SDK",". Einmal ",[38,483,484],{},"bun run setup:asio"," (SDK nicht im Git). Linux und macOS nutzen PipeWire \u00