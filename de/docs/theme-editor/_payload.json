wechseln.",[23,618,620],{"id":619},"fehlende-dateien-neu-verknüpfen","Fehlende Dateien neu verknüpfen",[14,622,623,624,627],{},"Wenn Audiodateien auf der Festplatte umziehen, zeigt SoundNinja ",[18,625,626],{},"Fehlende Sounddateien",". Einen Suchordner wählen und Clips neu verknüpfen.",[23,629,631],{"id":630},"weiter","Weiter",[14,633,634,635,21],{},"Tabs, Tags, Filter und Hotkeys: ",[224,636,637],{"href":271},"Sounds organisieren",{"title":139,"searchDepth":140,"depth":140,"links":639},[640,641,642,643,644,645],{"id":519,"depth":140,"text":520},{"id":540,"depth":140,"text":541},{"id":575,"depth":140,"text":576},{"id":598,"depth":140,"text":599},{"id":619,"depth":140,"text":620},{"id":630,"depth":140,"text":631},"Audio, Ordner, Aufnahmen und geteilte Soundboards importieren.",{},3,"\u002Fadding-sounds",{"title":266,"description":646},"adding-sounds","H_ls9_vOwDkgTWPkfe9bQz1A0XidUOmMFV4V2EJpYec",{"id":654,"title":637,"body":655,"description":1043,"extension":147,"meta":1044,"navigation":149,"order":1045,"path":1046,"seo":1047,"stem":1048,"__hash__":1049},"content_de\u002Forganizing-sounds.md",{"type":7,"value":656,"toc":1028},[657,660,667,670,696,702,706,709,723,730,736,740,750,755,785,789,795,799,833,839,843,846,872,875,879,892,896,901,921,937,944,948,959,962,966,973,983,989,993,1001,1008,1025],[10,658,637],{"id":659},"sounds-organisieren",[14,661,662,663,666],{},"SoundNinja ist für große Bibliotheken gebaut. ",[18,664,665],{},"Tags und Filter",", Tabs, Suche, Mehrfachauswahl und Hotkeys — der Clip ist einen Klick (oder eine Taste) entfernt.",[23,668,56],{"id":669},"tabs",[66,671,672,679,686],{},[31,673,674,675,678],{},"Tab mit ",[18,676,677],{},"Tab hinzufügen"," anlegen. Farbe vergeben, damit die Leiste schnell scannbar bleibt.",[31,680,681,682,685],{},"Die Ansicht ",[18,683,684],{},"Alle"," zeigt jeden Sound über alle Tabs.",[31,687,688,689,692,693,21],{},"Ein Sound kann ",[18,690,691],{},"einem oder mehreren Tabs"," gehören. Rechtsklick → ",[18,694,695],{},"Zu Tab verschieben",[14,697,698,699,701],{},"Tab-Übergänge: ",[18,700,122],{}," — Slide, Fade, Buttons nacheinander oder Keine.",[23,703,705],{"id":704},"gruppen","Gruppen",[14,707,708],{},"Seit v0.5.3 können Trenner zu benannten Gruppen werden:",[66,710,711,714,717,720],{},[31,712,713],{},"Gruppe über das Kontextmenü hinzufügen, umbenennen oder entfernen",[31,715,716],{},"Gruppenkopf ziehen — Kinder kommen mit",[31,718,719],{},"Sounds in eine Gruppe legen oder herausnehmen",[31,721,722],{},"Rahmenfarbe, Namensfarbe und Button-Ausrichtung setzen (oder Tab-Standard nutzen)",[14,724,725,726,729],{},"Ein einfacher ",[18,727,728],{},"Trenner"," geht weiter, wenn du nur einen visuellen Bruch brauchst.",[14,731,732,733,21],{},"Rechtsklick auf leeren Board-Bereich: ",[18,734,735],{},"Gruppe hinzufügen",[23,737,739],{"id":738},"tags-filter","Tags \u002F Filter",[14,741,742,743,746,747,749],{},"Tags gelten tabübergreifend. Das ausfahrbare ",[18,744,745],{},"Filter","-Panel (Sidebar ",[18,748,745],{},") ist der Ort zum Anlegen und zum Filtern des Boards.",[751,752,754],"h3",{"id":753},"tags-anlegen-und-bearbeiten","Tags anlegen und bearbeiten",[28,756,757,762,772,778],{},[31,758,759,761],{},[18,760,745],{}," in der Sidebar öffnen.",[31,763,119,764,767,768,771],{},[18,765,766],{},"Tags"," → ",[18,769,770],{},"Tag hinzufügen"," — Name und Farbe vergeben.",[31,773,774,775,21],{},"Im selben Panel umbenennen, umfärben oder ",[18,776,777],{},"Tag löschen",[31,779,780,781,784],{},"Steht da ",[18,782,783],{},"Noch keine Tags",", zuerst hier einen anlegen, bevor du zuweist.",[751,786,788],{"id":787},"tags-an-sounds-hängen","Tags an Sounds hängen",[14,790,791,792,794],{},"Rechtsklick auf einen Sound → ",[18,793,766],{}," (Checkboxen). Ein Sound darf mehrere Tags haben. Existieren noch keine, zeigt das Menü den Weg zum Filter-Panel.",[751,796,798],{"id":797},"board-filtern","Board filtern",[66,800,801,808,819,830],{},[31,802,803,804,807],{},"Tags im Filter-Panel oder als ",[18,805,806],{},"Chips unter der Suchleiste"," umschalten.",[31,809,810,811,814,815,818],{},"Abgleich ist ",[18,812,813],{},"ODER",": ein Sound bleibt sichtbar, wenn er ",[18,816,817],{},"irgendeinen"," gewählten Tag hat.",[31,820,821,822,825,826,829],{},"Das Feld ",[18,823,824],{},"Suche"," in der Navbar kombiniert per ",[18,827,828],{},"UND"," mit dem aktiven Tag-Filter (Tippen + Tags zusammen).",[31,831,832],{},"Chips aus (oder Filter leeren), um den ganzen Tab wieder zu sehen.",[14,834,835,836,21],{},"Farbige Tag-Namen können auf Buttons erscheinen. Schalter: ",[18,837,838],{},"Einstellungen → Verhalten → Tag-Badges anzeigen",[23,840,842],{"id":841},"sortierung","Sortierung",[14,844,845],{},"Im Filter-Panel eine Sortierung wählen:",[66,847,848,854],{},[31,849,850,853],{},[18,851,852],{},"Benutzerdefiniert"," — deine Tab-Reihenfolge, Gruppen sichtbar",[31,855,856,391,859,391,862,319,865,868,869],{},[18,857,858],{},"Name",[18,860,861],{},"Hinzugefügt",[18,863,864],{},"Spielzeit",[18,866,867],{},"Dateigröße"," — flache sortierte Liste; ",[18,870,871],{},"Gruppen sind ausgeblendet",[14,873,874],{},"Sortierung nach Dauer kann beim ersten Mal die Dauer-Metadaten vorwärmen.",[23,876,878],{"id":877},"neu-anordnen","Neu anordnen",[14,880,881,882,885,886,889,890,21],{},"Drag-and-Drop in ",[18,883,884],{},"Einstellungen → Verhalten"," einschalten (",[18,887,888],{},"Neu anordnen erlauben","). Dann Sounds und Gruppen ziehen. Neu anordnen gilt bei ",[18,891,852],{},[23,893,895],{"id":894},"mehrfachauswahl","Mehrfachauswahl",[14,897,898,900],{},[18,899,895],{}," in der Navbar einschalten, dann:",[66,902,903,906,912,918],{},[31,904,905],{},"Klick toggelt einen Sound",[31,907,908,911],{},[18,909,910],{},"Shift+Klick"," wählt einen Bereich ab dem letzten Anker",[31,913,914,917],{},[18,915,916],{},"Rahmen"," auf leerem Board ziehen",[31,919,920],{},"Klick auf leeres Board (oder außerhalb) leert die Auswahl",[14,922,923,924,391,927,391,930,933,934,21],{},"Eine Sammelleiste zeigt die Anzahl plus ",[18,925,926],{},"Farbe",[18,928,929],{},"Zu Tab verschieben…",[18,931,932],{},"Löschen"," und ",[18,935,936],{},"Fertig",[14,938,939,940,943],{},"In der Mehrfachauswahl zeigt jeder Button einen ",[18,941,942],{},"8-Zeichen-ID-Chip",". Rechtsklick auf den Chip kopiert die ID.",[23,945,947],{"id":946},"lautstärke-pro-sound","Lautstärke pro Sound",[14,949,950,951,954,955,958],{},"Rechtsklick → ",[18,952,953],{},"Lautstärke",". Slider von 0 % bis 100 %. ",[18,956,957],{},"Doppelklick"," setzt auf 100 % zurück.",[14,960,961],{},"Das stapelt sich mit der Master-Ausgangslautstärke in den Einstellungen.",[23,963,965],{"id":964},"hotkeys-und-sound-ids","Hotkeys und Sound-IDs",[14,967,968,969,972],{},"Jeder Sound hat eine 8-stellige ID. Kopieren über das Button-Kontextmenü (",[18,970,971],{},"ID kopieren",") oder den Mehrfachauswahl-Chip.",[14,974,975,978,979,982],{},[18,976,977],{},"Einstellungen → Hotkeys",": Taste an eine Sound-ID binden. Globale Hotkeys sind optional. ",[18,980,981],{},"Hotkey zuweisen"," im Kontextmenü springt dorthin, ID vorausgefüllt.",[14,984,985,986,988],{},"Dieselbe ID nutzt ",[224,987,227],{"href":226}," zum Auslösen.",[23,990,992],{"id":991},"hintergrundbilder-und-farben","Hintergrundbilder und Farben",[14,994,995,996,1000],{},"Rechtsklick auf einen Sound: eigene Farben oder ein Hintergrundbild. Das ist getrennt vom ",[224,997,999],{"href":998},"\u002Fdocs\u002Ftheme-editor","Theme Creator",", der das ganze Board gestaltet.",[14,1002,1003,1004,1007],{},"Der Picker ist ein Dialog ",[18,1005,1006],{},"Hintergrundbild"," (PNG, JPEG, GIF, WebP):",[66,1009,1010,1016],{},[31,1011,1012,1015],{},[18,1013,1014],{},"Lokale Dateien"," — Ordner hinzufügen, einzelne Datei wählen, Dateinamen suchen, Rastervorschau, Ordner aus der Bibliothek entfernen",[31,1017,1018,1021,1022,1024],{},[18,1019,1020],{},"KLIPY"," — GIFs online suchen. Eigenen API-Key unter ",[18,1023,884],{},". Der Key landet nicht in Projektdateien.",[14,1026,1027],{},"Nach der Wahl Bild auf dem Button schieben und zuschneiden.",{"title":139,"searchDepth":140,"depth":140,"links":1029},[1030,1031,1032,1037,1038,1039,1040,1041,1042],{"id":669,"depth":140,"text":56},{"id":704,"depth":140,"text":705},{"id":738,"depth":140,"text":739,"children":1033},[1034,1035,1036],{"id":753,"depth":648,"text":754},{"id":787,"depth":648,"text":788},{"id":797,"depth":648,"text":798},{"id":841,"depth":140,"text":842},{"id":877,"depth":140,"text":878},{"id":894,"depth":140,"text":895},{"id":946,"depth":140,"text":947},{"id":964,"depth":140,"text":965},{"id":991,"depth":140,"text":992},"Tags, Filter, Tabs, Gruppen, Sortierung, Mehrfachauswahl, Lautstärke und Hotkeys.",{},4,"\u002Forganizing-sounds",{"title":637,"description":1043},"organizing-sounds","phia_N7HDS6LIgxhltoa9iRYViBzJ00ngFayO7YKdtQ",{"id":4,"title":5,"body":1051,"description":146,"extension":147,"meta":1137,"navigation":149,"order":150,"path":151,"seo":1138,"stem":12,"__hash__":153},{"type":7,"value":1052,"toc":1131},[1053,1055,1059,1061,1079,1081,1083,1093,1095,1113,1115,1117,1121],[10,1054,5],{"id":12},[14,1056,16,1057,21],{},[18,1058,20],{},[23,1060,26],{"id":25},[28,1062,1063,1071,1075],{},[31,1064,1065,36,1067,41,1069,45],{},[18,1066,35],{},[38,1068,40],{},[38,1070,44],{},[31,1072,1073,51],{},[18,1074,50],{},[31,1076,1077,57],{},[18,1078,56],{},[14,1080,60],{},[23,1082,64],{"id":63},[66,1084,1085,1087,1089,1091],{},[31,1086,70],{},[31,1088,73],{},[31,1090,76],{},[31,1092,79],{},[23,1094,83],{"id":82},[66,1096,1097,1101,1105,1109],{},[31,1098,1099,91],{},[18,1100,90],{},[31,1102,1103,97],{},[18,1104,96],{},[31,1106,1107,103],{},[18,1108,102],{},[31,1110,1111,109],{},[18,1112,108],{},[14,1114,112],{},[23,1116,116],{"id":115},[14,1118,119,1119,123],{},[18,1120,122],{},[66,1122,1123,1125,1129],{},[31,1124,128],{},[31,1126,131,1127,45],{},[18,1128,134],{},[31,1130,137],{},{"title":139,"searchDepth":140,"depth":140,"links":1132},[1133,1134,1135,1136],{"id":25,"depth":140,"text":26},{"id":63,"depth":140,"text":64},{"id":82,"depth":140,"text":83},{"id":115,"depth":140,"text":116},{},{"title":5,"description":146},{"id":1140,"title":1141,"body":1142,"description":1279,"extension":147,"meta":1280,"navigation":149,"order":1281,"path":1282,"seo":1283,"stem":1284,"__hash__":1285},"content_de\u002Frecording-editor.md","Aufnahme-Editor",{"type":7,"value":1143,"toc":1273},[1144,1147,1153,1157,1163,1183,1186,1190,1215,1219,1234,1238,1252,1263],[10,1145,1141],{"id":1146},"aufnahme-editor",[14,1148,1149,1150,1152],{},"Nimm einen Clip in SoundNinja auf, schneide ihn zu und importiere ihn in einen Tab. Öffnen über ",[18,1151,587],{}," in der Player-Leiste.",[23,1154,1156],{"id":1155},"eingang-wählen","Eingang wählen",[14,1158,119,1159,1162],{},[18,1160,1161],{},"Einstellungen → Audio",":",[66,1164,1165,1171,1177],{},[31,1166,1167,1170],{},[18,1168,1169],{},"Eingabegeräte"," — Mikrofon",[31,1172,1173,1176],{},[18,1174,1175],{},"Ausgabegeräte (PC-Audio)"," — Loopback dessen, was der PC spielt",[31,1178,1179,1182],{},[18,1180,1181],{},"Eingangslautstärke"," — Aufnahme-Gain von 0 % bis 200 %",[14,1184,1185],{},"Der Aufnahme-Button nutzt das hier gewählte Gerät.",[23,1187,1189],{"id":1188},"take-bearbeiten","Take bearbeiten",[66,1191,1192,1195,1198,1206,1209,1212],{},[31,1193,1194],{},"Aufnehmen und stoppen",[31,1196,1197],{},"Pegelmesser beobachten",[31,1199,1200,319,1203],{},[18,1201,1202],{},"Normalisieren",[18,1204,1205],{},"Rauschunterdrückung",[31,1207,1208],{},"Ganzen Clip trimmen, auf Auswahl trimmen oder Auswahl löschen",[31,1210,1211],{},"Rückgängig \u002F Wiederholen",[31,1213,1214],{},"Rein- und rauszoomen",[23,1216,1218],{"id":1217},"stagen-und-importieren","Stagen und importieren",[28,1220,1221,1224,1227],{},[31,1222,1223],{},"Auswahl oder ganzen Track zur Staging-Liste hinzufügen.",[31,1225,1226],{},"Die Liste startet leer: aufnehmen, bearbeiten, dann Clip hinzufügen.",[31,1228,1229,319,1231,1233],{},[18,1230,591],{},[18,1232,594],{}," in den aktuellen oder einen gewählten Tab.",[23,1235,1237],{"id":1236},"stem-trennung-optional","Stem-Trennung (optional)",[14,1239,1240,1241,1244,1245,319,1248,1251],{},"Offizielle Windows-, macOS- und Linux-Release-Builds enthalten das ",[18,1242,1243],{},"Stems","-Feature. Der Aufnahme-Editor kann ",[18,1246,1247],{},"Gesang",[18,1249,1250],{},"Musik"," mit BS-RoFormer behalten.",[14,1253,1254,1255,1258,1259,1262],{},"Das Modell ist etwa 158 MB und ",[18,1256,1257],{},"nicht"," im Installer. Download unter ",[18,1260,1261],{},"Einstellungen → Stem-Trennung"," oder über den Erststart-Hinweis. Der Windows-Installer kann den Download beim ersten Start anbieten.",[14,1264,1265,1266,41,1269,1272],{},"Eigene Source-Builds brauchen extra Flags (",[38,1267,1268],{},"tauri:serve:stems",[38,1270,1271],{},"tauri:build:stems",").",{"title":139,"searchDepth":140,"depth":140,"links":1274},[1275,1276,1277,1278],{"id":1155,"depth":140,"text":1156},{"id":1188,"depth":140,"text":1189},{"id":1217,"depth":140,"text":1218},{"id":1236,"depth":140,"text":1237},"Mikrofon oder PC-Audio aufnehmen, den Clip bearbeiten und aufs Board legen.",{},6,"\u002Frecording-editor",{"title":1141,"description":1279},"recording-editor","mBUN6yUiwk-kNjhsf48NlWEXXhjw6cOuSAkybSa9wi0",{"id":1287,"title":1288,"body":1289,"description":1502,"extension":147,"meta":1503,"navigation":149,"order":1504,"path":1505,"seo":1506,"stem":1507,"__hash__":1508},"content_de\u002Fremote-control.md","Fernsteuerung",{"type":7,"value":1290,"toc":1495},[1291,1294,1297,1301,1331,1334,1337,1372,1376,1396,1399,1403,1435,1439,1445],[10,1292,1288],{"id":1293},"fernsteuerung",[14,1295,1296],{},"SoundNinja kann im lokalen Netz lauschen, damit Bitfocus Companion (oder jeder HTTP\u002FWebSocket-Client) Sounds spielt und stoppt.",[23,1298,1300],{"id":1299},"remote-server-einschalten","Remote-Server einschalten",[28,1302,1303,1309,1315,1321],{},[31,1304,1305,1308],{},[18,1306,1307],{},"Einstellungen → Remote"," öffnen.",[31,1310,1311,1312,21],{},"Remote-Server aktivieren. Standardport ist ",[18,1313,1314],{},"7331",[31,1316,1317,1318,21],{},"Optional: Token setzen. Clients senden ihn als Bearer-Token oder ",[38,1319,1320],{},"?token=",[31,1322,1323,1326,1327,1330],{},[38,1324,1325],{},"http:\u002F\u002FIP:PORT"," kopieren oder die System-IP unter ",[18,1328,1329],{},"Einstellungen → Über"," holen.",[14,1332,1333],{},"Windows kann beim ersten Start eine Firewall-Abfrage zeigen. Zugriff im privaten Netz erlauben.",[23,1335,227],{"id":1336},"bitfocus-companion",[28,1338,1339,1346,1354,1365],{},[31,1340,1341,1345],{},[224,1342,227],{"href":1343,"rel":1344},"https:\u002F\u002Fbitfocus.io\u002Fcompanion",[246]," installieren.",[31,1347,1348,1353],{},[224,1349,1352],{"href":1350,"rel":1351},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002Fcompanion-module-soundninja\u002Freleases\u002Flatest",[246],"SoundNinja-Companion.tgz"," herunterladen. Es gibt noch kein Companion-Store-Paket.",[31,1355,1356,1357,1360,1361,1364],{},"In Companion: ",[18,1358,1359],{},"Modules → Load module package"," und die ",[38,1362,1363],{},".tgz"," wählen.",[31,1366,1367,1368,1371],{},"Eine ",[18,1369,1370],{},"Sound Ninja","-Verbindung anlegen. PC-IP, Port und Token eintragen.",[23,1373,1375],{"id":1374},"aktionen","Aktionen",[66,1377,1378,1384,1390],{},[31,1379,1380,1383],{},[18,1381,1382],{},"Trigger Sound"," — aus dem Live-Dropdown wählen oder 8-stellige Sound-ID tippen (Companion-Variablen gehen)",[31,1385,1386,1389],{},[18,1387,1388],{},"Stop Sound"," — einen spielenden Sound per ID stoppen",[31,1391,1392,1395],{},[18,1393,1394],{},"Stop All"," — alle spielenden Sounds stoppen",[14,1397,1398],{},"Sound-ID in SoundNinja über das Button-Kontextmenü oder den Mehrfachauswahl-Chip kopieren.",[23,1400,1402],{"id":1401},"feedbacks-und-variablen","Feedbacks und Variablen",[66,1404,1405,1411,1423,1429],{},[31,1406,1407,1410],{},[18,1408,1409],{},"Sound Playing"," — wahr, solange diese Sound-ID aktiv ist (für Button-Farbe)",[31,1412,1413,1416,1417,41,1420],{},[38,1414,1415],{},"$(soundninja:connected)"," — ",[38,1418,1419],{},"true",[38,1421,1422],{},"false",[31,1424,1425,1428],{},[38,1426,1427],{},"$(soundninja:playing_count)"," — wie viele Sounds spielen",[31,1430,1431,1434],{},[38,1432,1433],{},"$(soundninja:last_triggered)"," — zuletzt ausgelöste Sound-ID",[23,1436,1438],{"id":1437},"http-api-fortgeschritten","HTTP-API (fortgeschritten)",[14,1440,1441,1442],{},"Basispfad: ",[38,1443,1444],{},"\u002Fapi\u002Fv1",[66,1446,1447,1453,1459,1465,1474,1480,1489],{},[31,1448,1449,1452],{},[38,1450,1451],{},"GET \u002Finfo"," — App-Name, Version, Protokoll, ob ein Token nötig ist",[31,1454,1455,1458],{},[38,1456,1457],{},"GET \u002Fsounds"," — Soundliste (id, name, tabs, active)",[31,1460,1461,1464],{},[38,1462,1463],{},"GET \u002Fstate"," — Sounds plus gerade spielende IDs",[31,1466,1467,609,1470,1473],{},[38,1468,1469],{},"POST \u002Ftrigger",[38,1471,1472],{},"{ \"id\" }"," — Sound abspielen",[31,1475,1476,1479],{},[38,1477,1478],{},"GET \u002Ftrigger\u002F:id"," — abspielen (einfach im Browser testen)",[31,1481,1482,1485,1486,1488],{},[38,1483,1484],{},"POST \u002Fstop"," mit optionalem ",[38,1487,1472],{}," — einen Sound oder alle stoppen",[31,1490,1491,1494],{},[38,1492,1493],{},"GET \u002Fws"," — Live-Status; Trigger\u002FStop eingehend senden",{"title":139,"searchDepth":140,"depth":140,"links":1496},[1497,1498,1499,1500,1501],{"id":1299,"depth":140,"text":1300},{"id":1336,"depth":140,"text":227},{"id":1374,"depth":140,"text":1375},{"id":1401,"depth":140,"text":1402},{"id":1437,"depth":140,"text":1438},"SoundNinja über das lokale Netz mit Bitfocus Companion auslösen.",{},7,"\u002Fremote-control",{"title":1288,"description":1502},"remote-control","pzsqq4CZS4ZlSf2WDcYK0UyO02dUISTU454C3gbbJFw",{"id":1510,"title":1511,"body":1512,"description":1600,"extension":147,"meta":1601,"navigation":149,"order":1602,"path":1603,"seo":1604,"stem":1516,"__hash__":1605},"content_de\u002Fsupport.md","Support",{"type":7,"value":1513,"toc":1593},[1514,15