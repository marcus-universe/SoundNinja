[{"data":1,"prerenderedAt":1323},["ShallowReactive",2],{"docs-page-de-\u002Ftheme-editor":3,"docs-nav-de":154},{"id":4,"title":5,"body":6,"description":146,"extension":147,"meta":148,"navigation":149,"order":150,"path":151,"seo":152,"stem":12,"__hash__":153},"content_de\u002Ftheme-editor.md","Theme-Editor",{"type":7,"value":8,"toc":138},"minimark",[9,13,22,27,58,61,65,80,84,110,113,117,124],[10,11,5],"h1",{"id":12},"theme-editor",[14,15,16,17,21],"p",{},"Der Theme Creator ist der volle visuelle Editor für dein Board. Öffnen über ",[18,19,20],"strong",{},"Einstellungen → Allgemein → Theme Creator",".",[23,24,26],"h2",{"id":25},"drei-tabs","Drei Tabs",[28,29,30,46,52],"ol",{},[31,32,33,36,37,41,42,45],"li",{},[18,34,35],{},"Allgemein"," — Theme-Name, gemeinsame Farben und Schrift-Uploads (",[38,39,40],"code",{},".ttf"," \u002F ",[38,43,44],{},".otf",")",[31,47,48,51],{},[18,49,50],{},"Buttons"," — Farben, Typo, Layout und GIF-Overlay der Sound-Buttons",[31,53,54,57],{},[18,55,56],{},"Tabs"," — Farben, Typo und Rahmenstärke der Tab-Leiste",[14,59,60],{},"Eine Live-Vorschau zeigt Tabs und Buttons beim Bearbeiten.",[23,62,64],{"id":63},"was-du-ändern-kannst","Was du ändern kannst",[66,67,68,71,74,77],"ul",{},[31,69,70],{},"Primär- und Akzentfarben, Hintergründe, Button- und Tab-Farben",[31,72,73],{},"Schriftfamilie und -größe für Buttons und Tabs",[31,75,76],{},"Button-Breite, Radius, Rahmen, Abstände und Innenabstand",[31,78,79],{},"GIF-Overlay-Deckkraft (normal und Hover)",[23,81,83],{"id":82},"speichern-und-teilen","Speichern und teilen",[66,85,86,92,98,104],{},[31,87,88,91],{},[18,89,90],{},".css exportieren"," — Theme-Datei sichern oder weitergeben",[31,93,94,97],{},[18,95,96],{},"Zu Themes hinzufügen"," — in den Themes-Ordner speichern und anwenden",[31,99,100,103],{},[18,101,102],{},".css importieren"," — Preset oder gespeichertes Theme laden",[31,105,106,109],{},[18,107,108],{},"Zurücksetzen"," — SoundNinja-Standard wiederherstellen",[14,111,112],{},"Beim Schließen mit ungespeicherten Änderungen fragt SoundNinja nach.",[23,114,116],{"id":115},"ohne-vollen-editor","Ohne vollen Editor",[14,118,119,120,123],{},"Unter ",[18,121,122],{},"Einstellungen → Allgemein"," kannst du trotzdem:",[66,125,126,129,135],{},[31,127,128],{},"Ein Theme aus der Liste wählen",[31,130,131,132,45],{},"CSS-Variablen live bearbeiten (",[18,133,134],{},"Eigenes CSS",[31,136,137],{},"Eine Theme-Datei in den Themes-Ordner importieren",{"title":139,"searchDepth":140,"depth":140,"links":141},"",2,[142,143,144,145],{"id":25,"depth":140,"text":26},{"id":63,"depth":140,"text":64},{"id":82,"depth":140,"text":83},{"id":115,"depth":140,"text":116},"Farben, Schriften, Buttons und Tabs im Theme Creator gestalten.","md",{},true,5,"\u002Ftheme-editor",{"title":5,"description":146},"h6Hta3TDDcThnouY3Pk_Omvjq8Eb8knx-HIAvf5YZd8",[155,277,474,620,771,860,1003,1226],{"id":156,"title":157,"body":158,"description":270,"extension":147,"meta":271,"navigation":149,"order":272,"path":273,"seo":274,"stem":275,"__hash__":276},"content_de\u002Foverview.md","Überblick",{"type":7,"value":159,"toc":264},[160,163,166,169,172,176,190,194,226,230,240,244],[10,161,157],{"id":162},"überblick",[14,164,165],{},"SoundNinja ist ein Open-Source-Soundboard für Livestreams, Chats mit Freunden und Podcast-Aufnahmen. Es läuft auf Tauri v2 und Nuxt 4 und bleibt dabei sparsam mit RAM und Speicherplatz.",[14,167,168],{},"Das Ziel: eine große Sound-Bibliothek schnell scannen und den richtigen Clip in Millisekunden abspielen. Die Oberfläche eignet sich auch als Dashboard in VR.",[14,170,171],{},"SoundNinja steckt noch in der frühen Entwicklung. Funktionen laufen, aber nicht jede Plattform ist vollständig getestet.",[23,173,175],{"id":174},"für-wen","Für wen",[66,177,178,181,184,187],{},[31,179,180],{},"Streamer, die sofortige Sound-Cues brauchen",[31,182,183],{},"Freunde, die ein gemeinsames Board für Voice-Chat wollen",[31,185,186],{},"Podcaster, die Clips aufnehmen und aufs Board legen",[31,188,189],{},"Alle, die ein anpassbares, lokales Soundboard wollen",[23,191,193],{"id":192},"was-du-tun-kannst","Was du tun kannst",[66,195,196,199,202,205,208,211,220,223],{},[31,197,198],{},"Ein Soundboard aus eigenen Audiodateien bauen",[31,200,201],{},"Sounds in farbigen Tabs, Gruppen und über die Suche sortieren",[31,203,204],{},"Das Aussehen mit dem Theme Creator gestalten",[31,206,207],{},"PC-Audio oder Mikrofon im Record Editor aufnehmen",[31,209,210],{},"Hotkeys einzelnen Sounds zuweisen",[31,212,213,214,219],{},"Sounds über ",[215,216,218],"a",{"href":217},"\u002Fdocs\u002Fremote-control","Bitfocus Companion"," auslösen",[31,221,222],{},"Ein komplettes Soundboard importieren und exportieren",[31,224,225],{},"GIFs oder Bilder auf Sound-Buttons legen",[23,227,229],{"id":228},"lizenz","Lizenz",[14,231,232,233,239],{},"SoundNinja ist freie Software unter ",[215,234,238],{"href":235,"rel":236},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fblob\u002Fmain\u002FLICENSE",[237],"nofollow","GPL-3.0",". Forken, ändern, teilen.",[23,241,243],{"id":242},"nächste-schritte","Nächste Schritte",[28,245,246,252,258],{},[31,247,248],{},[215,249,251],{"href":250},"\u002Fdocs\u002Finstallation","SoundNinja installieren",[31,253,254],{},[215,255,257],{"href":256},"\u002Fdocs\u002Fadding-sounds","Sounds hinzufügen",[31,259,260],{},[215,261,263],{"href":262},"\u002Fdocs\u002Forganizing-sounds","Board organisieren",{"title":139,"searchDepth":140,"depth":140,"links":265},[266,267,268,269],{"id":174,"depth":140,"text":175},{"id":192,"depth":140,"text":193},{"id":228,"depth":140,"text":229},{"id":242,"depth":140,"text":243},"Was SoundNinja ist und was du damit machen kannst.",{},1,"\u002Foverview",{"title":157,"description":270},"overview","k9vdLuByV0_2FJs4S1c2pJgDzzqDtddQcqK9KQYpZ8M",{"id":278,"title":279,"body":280,"description":469,"extension":147,"meta":470,"navigation":149,"order":140,"path":471,"seo":472,"stem":284,"__hash__":473},"content_de\u002Finstallation.md","Installation",{"type":7,"value":281,"toc":462},[282,285,299,303,321,324,328,342,345,349,373,384,388,395,399,413,443,458],[10,283,279],{"id":284},"installation",[14,286,287,288,292,293,298],{},"Hol dir einen Build von der ",[215,289,291],{"href":290},"\u002Fdownload","Download-Seite"," oder von ",[215,294,297],{"href":295,"rel":296},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Freleases\u002Flatest",[237],"GitHub Releases",". SoundNinja ist in früher Entwicklung — behandle Builds als Beta.",[23,300,302],{"id":301},"windows","Windows",[66,304,305,315,318],{},[31,306,307,310,311,314],{},[18,308,309],{},"Installer (.exe)"," oder ",[18,312,313],{},"MSI (.msi)"," für 64-Bit-Windows",[31,316,317],{},"Landing-Page-Ziel: Windows 10 und neuer",[31,319,320],{},"Die App-README nennt auch Windows 8 und höher",[14,322,323],{},"Installer starten, dann SoundNinja über das Startmenü öffnen.",[23,325,327],{"id":326},"macos","macOS",[66,329,330,336,339],{},[31,331,332,335],{},[18,333,334],{},"Universelles .dmg"," für Apple Silicon und Intel",[31,337,338],{},"Landing-Page-Ziel: macOS 10.14 und neuer",[31,340,341],{},"Die App-README nennt macOS 10.15 und höher",[14,343,344],{},"Disk-Image öffnen und SoundNinja nach Programme ziehen.",[23,346,348],{"id":347},"linux","Linux",[66,350,351,357,363,370],{},[31,352,353,356],{},[18,354,355],{},"Debian (.deb)"," für Ubuntu \u002F Debian",[31,358,359,362],{},[18,360,361],{},"AppImage"," für andere Distros",[31,364,365,366,369],{},"Nach Veröffentlichung einer Release können Arch-Nutzer ",[38,367,368],{},"soundninja-bin"," aus dem AUR installieren",[31,371,372],{},"Getestet unter Ubuntu 20.04",[14,374,375,376,379,380,383],{},"Desktop-Builds brauchen WebKit- und GTK-Pakete. Unter Debian\u002FUbuntu meist ",[38,377,378],{},"libwebkit2gtk",", ",[38,381,382],{},"libgtk-3-0"," und eine App-Indicator-Bibliothek.",[23,385,387],{"id":386},"updates","Updates",[14,389,390,391,394],{},"In der App: ",[18,392,393],{},"Hilfe → Nach Updates suchen",". Optional prüft SoundNinja beim Start in den Einstellungen.",[23,396,398],{"id":397},"aus-dem-quellcode-bauen","Aus dem Quellcode bauen",[14,400,401,402,379,407,412],{},"Eigenen Build? ",[215,403,406],{"href":404,"rel":405},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja",[237],"Repo klonen",[215,408,411],{"href":409,"rel":410},"https:\u002F\u002Fv2.tauri.app\u002Fstart\u002Fprerequisites\u002F",[237],"Tauri-Voraussetzungen"," installieren, dann:",[414,415,419],"pre",{"className":416,"code":417,"language":418,"meta":139,"style":139},"language-bash shiki shiki-themes github-light github-dark","bun install\nbun run tauri:serve\n","bash",[38,420,421,433],{"__ignoreMap":139},[422,423,425,429],"span",{"class":424,"line":272},"line",[422,426,428],{"class":427},"sScJk","bun",[422,430,432],{"class":431},"sZZnC"," install\n",[422,434,435,437,440],{"class":424,"line":140},[422,436,428],{"class":427},[422,438,439],{"class":431}," run",[422,441,442],{"class":431}," tauri:serve\n",[14,444,445,379,448,310,451,454,455,21],{},[38,446,447],{},"npm",[38,449,450],{},"pnpm",[38,452,453],{},"deno"," gehen auch. Produktionsbuild: ",[38,456,457],{},"bun run tauri:build",[459,460,461],"style",{},"html pre.shiki code .sScJk, html code.shiki .sScJk{--shiki-default:#6F42C1;--shiki-dark:#B392F0}html pre.shiki code .sZZnC, html code.shiki .sZZnC{--shiki-default:#032F62;--shiki-dark:#9ECBFF}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html.dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}",{"title":139,"searchDepth":140,"depth":140,"links":463},[464,465,466,467,468],{"id":301,"depth":140,"text":302},{"id":326,"depth":140,"text":327},{"id":347,"depth":140,"text":348},{"id":386,"depth":140,"text":387},{"id":397,"depth":140,"text":398},"SoundNinja unter Windows, macOS oder Linux installieren.",{},"\u002Finstallation",{"title":279,"description":469},"Djt_phX5yPzPpgqthAHl5cQnHy-U9ban07ufeARjtGI",{"id":475,"title":257,"body":476,"description":613,"extension":147,"meta":614,"navigation":149,"order":615,"path":616,"seo":617,"stem":618,"__hash__":619},"content_de\u002Fadding-sounds.md",{"type":7,"value":477,"toc":605},[478,481,484,488,505,509,540,544,563,567,581,584,588,595,599],[10,479,257],{"id":480},"sounds-hinzufügen",[14,482,483],{},"Ein Board bleibt leer, bis du Clips hinzufügst. SoundNinja importiert Dateien, ganze Ordner, eine Aufnahme oder ein geteiltes Soundboard-Paket.",[23,485,487],{"id":486},"audiodateien-importieren","Audiodateien importieren",[28,489,490,499,502],{},[31,491,492,310,495,498],{},[18,493,494],{},"Datei → Audiodateien importieren",[18,496,497],{},"Import"," in der Navbar.",[31,500,501],{},"Eine oder mehrere Audiodateien wählen.",[31,503,504],{},"Sounds landen im aktuellen Tab.",[23,506,508],{"id":507},"ordner-importieren","Ordner importieren",[28,510,511,520,523],{},[31,512,513,516,517,519],{},[18,514,515],{},"Datei → Ordner importieren"," (oder ",[18,518,508],{}," in der Navbar).",[31,521,522],{},"Einen oder mehrere Ordner hinzufügen. Vor dem Import per Drag neu sortieren.",[31,524,525,526],{},"Ziel wählen:\n",[66,527,528,534],{},[31,529,530,533],{},[18,531,532],{},"Als Tabs importieren"," — jeder Ordner wird ein eigener Tab",[31,535,536,539],{},[18,537,538],{},"In aktuellen Tab importieren"," — alle Dateien landen im aktiven Tab",[23,541,543],{"id":542},"clip-aufnehmen","Clip aufnehmen",[14,545,546,547,551,552,555,556,310,559,562],{},"Öffne den ",[215,548,550],{"href":549},"\u002Fdocs\u002Frecording-editor","Record Editor"," über ",[18,553,554],{},"Aufnahme"," in der Player-Leiste. Aufnehmen, zuschneiden, dann ",[18,557,558],{},"Auswahl importieren",[18,560,561],{},"Alle importieren"," in den aktuellen Tab oder einen gewählten Tab.",[23,564,566],{"id":565},"soundboard-importieren","Soundboard importieren",[14,568,569,572,573,576,577,580],{},[18,570,571],{},"Datei → Soundboard importieren"," lädt ein geteiltes Paket. Pakete sind ein ",[38,574,575],{},".zip"," mit ",[38,578,579],{},"project.sninja"," plus Sounddateien. Danach Projekt öffnen und abspielen.",[14,582,583],{},"Du kannst mehrere Projekte (Profile) halten. Über den Projektwähler zwischen Boards wechseln.",[23,585,587],{"id":586},"fehlende-dateien-neu-verknüpfen","Fehlende Dateien neu verknüpfen",[14,589,590,591,594],{},"Wenn Audiodateien auf der Festplatte umziehen, zeigt SoundNinja ",[18,592,593],{},"Fehlende Sounddateien",". Einen Suchordner wählen und Clips neu verknüpfen.",[23,596,598],{"id":597},"weiter","Weiter",[14,600,601,602,21],{},"Tabs, Gruppen und Hotkeys: ",[215,603,604],{"href":262},"Sounds organisieren",{"title":139,"searchDepth":140,"depth":140,"links":606},[607,608,609,610,611,612],{"id":486,"depth":140,"text":487},{"id":507,"depth":140,"text":508},{"id":542,"depth":140,"text":543},{"id":565,"depth":140,"text":566},{"id":586,"depth":140,"text":587},{"id":597,"depth":140,"text":598},"Audio, Ordner, Aufnahmen und geteilte Soundboards importieren.",{},3,"\u002Fadding-sounds",{"title":257,"description":613},"adding-sounds","qhheWryk-vrNfEsQyZSumTndjdSmJPmEctxDG9Gyulk",{"id":621,"title":604,"body":622,"description":764,"extension":147,"meta":765,"navigation":149,"order":766,"path":767,"seo":768,"stem":769,"__hash__":770},"content_de\u002Forganizing-sounds.md",{"type":7,"value":623,"toc":755},[624,627,630,633,659,665,669,672,686,693,697,702,706,717,721,724,728,731,737,743,747],[10,625,604],{"id":626},"sounds-organisieren",[14,628,629],{},"SoundNinja ist für große Bibliotheken gebaut. Tabs, Gruppen, Suche und Hotkeys — der Clip ist einen Klick (oder eine Taste) entfernt.",[23,631,56],{"id":632},"tabs",[66,634,635,642,649],{},[31,636,637,638,641],{},"Tab mit ",[18,639,640],{},"Tab hinzufügen"," anlegen. Farbe vergeben, damit die Leiste schnell scannbar bleibt.",[31,643,644,645,648],{},"Die Ansicht ",[18,646,647],{},"Alle"," zeigt jeden Sound über alle Tabs.",[31,650,651,652,655,656,21],{},"Ein Sound kann ",[18,653,654],{},"einem oder mehreren Tabs"," gehören. Rechtsklick → ",[18,657,658],{},"Zu Tab verschieben",[14,660,661,662,664],{},"Tab-Übergänge: ",[18,663,122],{}," — Slide, Fade, Buttons nacheinander oder Keine.",[23,666,668],{"id":667},"gruppen","Gruppen",[14,670,671],{},"Seit v0.5.3 können Trenner zu benannten Gruppen werden:",[66,673,674,677,680,683],{},[31,675,676],{},"Gruppe über das Kontextmenü hinzufügen, umbenennen oder entfernen",[31,678,679],{},"Gruppenkopf ziehen — Kinder kommen mit",[31,681,682],{},"Sounds in eine Gruppe legen oder herausnehmen",[31,684,685],{},"Rahmenfarbe, Namensfarbe und Button-Ausrichtung setzen (oder Tab-Standard nutzen)",[14,687,688,689,692],{},"Ein einfacher ",[18,690,691],{},"Trenner"," geht weiter, wenn du nur einen visuellen Bruch brauchst.",[23,694,696],{"id":695},"suche","Suche",[14,698,699,701],{},[18,700,696],{}," in der Navbar. Ergebnisse folgen der Eingabe.",[23,703,705],{"id":704},"neu-anordnen","Neu anordnen",[14,707,708,709,712,713,716],{},"Drag-and-Drop in ",[18,710,711],{},"Einstellungen → Verhalten"," einschalten (",[18,714,715],{},"Neu anordnen erlauben","). Dann Sounds und Gruppen ziehen.",[23,718,720],{"id":719},"sammelbearbeitung","Sammelbearbeitung",[14,722,723],{},"Mehrere Sounds markieren, dann Farbe ändern, in einen Tab schieben oder löschen.",[23,725,727],{"id":726},"hotkeys-und-sound-ids","Hotkeys und Sound-IDs",[14,729,730],{},"Jeder Sound hat eine 8-stellige ID. Kopieren über das Button-Kontextmenü oder den Mehrfachauswahl-Chip.",[14,732,733,736],{},[18,734,735],{},"Einstellungen → Hotkeys",": Taste an eine Sound-ID binden. Globale Hotkeys sind optional.",[14,738,739,740,742],{},"Dieselbe ID nutzt ",[215,741,218],{"href":217}," zum Auslösen.",[23,744,746],{"id":745},"gifs-und-farben","GIFs und Farben",[14,748,749,750,754],{},"Rechtsklick auf einen Sound: eigene Farben oder GIF-\u002FBildhintergrund. Das ist getrennt vom ",[215,751,753],{"href":752},"\u002Fdocs\u002Ftheme-editor","Theme Creator",", der das ganze Board gestaltet.",{"title":139,"searchDepth":140,"depth":140,"links":756},[757,758,759,760,761,762,763],{"id":632,"depth":140,"text":56},{"id":667,"depth":140,"text":668},{"id":695,"depth":140,"text":696},{"id":704,"depth":140,"text":705},{"id":719,"depth":140,"text":720},{"id":726,"depth":140,"text":727},{"id":745,"depth":140,"text":746},"Tabs, Gruppen, Suche, Sammelbearbeitung und Hotkeys.",{},4,"\u002Forganizing-sounds",{"title":604,"description":764},"organizing-sounds","tzbjT1L04eFyKK0nuKEVqrhA0oH5iyG-Pq9SkxEWh1w",{"id":4,"title":5,"body":772,"description":146,"extension":147,"meta":858,"navigation":149,"order":150,"path":151,"seo":859,"stem":12,"__hash__":153},{"type":7,"value":773,"toc":852},[774,776,780,782,800,802,804,814,816,834,836,838,842],[10,775,5],{"id":12},[14,777,16,778,21],{},[18,779,20],{},[23,781,26],{"id":25},[28,783,784,792,796],{},[31,785,786,36,788,41,790,45],{},[18,787,35],{},[38,789,40],{},[38,791,44],{},[31,793,794,51],{},[18,795,50],{},[31,797,798,57],{},[18,799,56],{},[14,801,60],{},[23,803,64],{"id":63},[66,805,806,808,810,812],{},[31,807,70],{},[31,809,73],{},[31,811,76],{},[31,813,79],{},[23,815,83],{"id":82},[66,817,818,822,826,830],{},[31,819,820,91],{},[18,821,90],{},[31,823,824,97],{},[18,825,96],{},[31,827,828,103],{},[