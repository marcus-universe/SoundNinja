,1243,556],{},[42,1245,559],{}," in den aktuellen oder einen gewählten Tab.",[31,1248,1250],{"id":1249},"stem-trennung-optional","Stem-Trennung (optional)",[14,1252,1253,1254,1257,1258,45,1261,1264],{},"Offizielle Windows-, macOS- und Linux-Release-Builds enthalten das ",[42,1255,1256],{},"Stems","-Feature. Der Aufnahme-Editor kann ",[42,1259,1260],{},"Gesang",[42,1262,1263],{},"Musik"," mit BS-RoFormer behalten.",[14,1266,1267,1268,1271,1272,1275],{},"Das Modell ist etwa 158 MB und ",[42,1269,1270],{},"nicht"," im Installer. Download unter ",[42,1273,1274],{},"Einstellungen → Stem-Trennung"," oder über den Erststart-Hinweis. Der Windows-Installer kann den Download beim ersten Start anbieten.",[14,1277,1278,1279,1047,1282,1285],{},"Eigene Source-Builds brauchen extra Flags (",[105,1280,1281],{},"tauri:serve:stems",[105,1283,1284],{},"tauri:build:stems",").",{"title":158,"searchDepth":176,"depth":176,"links":1287},[1288,1289,1290,1291],{"id":1168,"depth":176,"text":1169},{"id":1201,"depth":176,"text":1202},{"id":1230,"depth":176,"text":1231},{"id":1249,"depth":176,"text":1250},"Mikrofon oder PC-Audio aufnehmen, den Clip bearbeiten und aufs Board legen.",{},6,"\u002Frecording-editor",{"title":1154,"description":1292},"recording-editor","mBUN6yUiwk-kNjhsf48NlWEXXhjw6cOuSAkybSa9wi0",{"id":1300,"title":1301,"body":1302,"description":1515,"extension":213,"meta":1516,"navigation":215,"order":1517,"path":1518,"seo":1519,"stem":1520,"__hash__":1521},"content_de\u002Fremote-control.md","Fernsteuerung",{"type":7,"value":1303,"toc":1508},[1304,1307,1310,1314,1344,1347,1350,1385,1389,1409,1412,1416,1448,1452,1458],[10,1305,1301],{"id":1306},"fernsteuerung",[14,1308,1309],{},"SoundNinja kann im lokalen Netz lauschen, damit Bitfocus Companion (oder jeder HTTP\u002FWebSocket-Client) Sounds spielt und stoppt.",[31,1311,1313],{"id":1312},"remote-server-einschalten","Remote-Server einschalten",[317,1315,1316,1322,1328,1334],{},[39,1317,1318,1321],{},[42,1319,1320],{},"Einstellungen → 