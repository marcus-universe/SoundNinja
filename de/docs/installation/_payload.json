type":7,"value":461,"toc":589},[462,465,468,472,489,493,524,528,547,551,565,568,572,579,583],[10,463,318],{"id":464},"sounds-hinzufügen",[14,466,467],{},"Ein Board bleibt leer, bis du Clips hinzufügst. SoundNinja importiert Dateien, ganze Ordner, eine Aufnahme oder ein geteiltes Soundboard-Paket.",[31,469,471],{"id":470},"audiodateien-importieren","Audiodateien importieren",[305,473,474,483,486],{},[39,475,476,45,479,482],{},[42,477,478],{},"Datei → Audiodateien importieren",[42,480,481],{},"Import"," in der Navbar.",[39,484,485],{},"Eine oder mehrere Audiodateien wählen.",[39,487,488],{},"Sounds landen im aktuellen Tab.",[31,490,492],{"id":491},"ordner-importieren","Ordner importieren",[305,494,495,504,507],{},[39,496,497,500,501,503],{},[42,498,499],{},"Datei → Ordner importieren"," (oder ",[42,502,492],{}," in der Navbar).",[39,505,506],{},"Einen oder mehrere Ordner hinzufügen. Vor dem Import per Drag neu sortieren.",[39,508,509,510],{},"Ziel wählen:\n",[36,511,512,518],{},[39,513,514,517],{},[42,515,516],{},"Als Tabs importieren"," — jeder Ordner wird ein eigener Tab",[39,519,520,523],{},[42,521,522],{},"In aktuellen Tab importieren"," — alle Dateien landen im aktiven Tab",[31,525,527],{"id":526},"clip-aufnehmen","Clip aufnehmen",[14,529,530,531,535,536,539,540,45,543,546],{},"Öffne den ",[18,532,534],{"href":533},"\u002Fdocs\u002Frecording-editor","Record Editor"," über ",[42,537,538],{},"Aufnahme"," in der Player-Leiste. Aufnehmen, zuschneiden, dann ",[42,541,542],{},"Auswahl importieren",[42,544,545],{},"Alle importieren"," in den aktuellen Tab oder einen gewählten Tab.",[31,548,550],{"id":549},"soundboard-importieren","Soundboard importieren",[14,552,553,556,557,560,561,564],{},[42,554,555],{},"Datei → Soundboard importieren"," lädt ein geteiltes Paket. Pakete sind ein ",[102,558,559],{},".zip"," mit ",[102,562,563],{},"project.sninja"," plus Sounddateien. Danach Projekt öffnen und abspielen.",[14,566,567],{},"Du kannst mehrere Projekte (Profile) halten. Über den Projektwähler zwischen Boards wechseln.",[31,569,571],{"id":570},"fehlende-dateien-neu-verknüpfen","Fehlende Dateien neu verknüpfen",[14,573,574,575,578],{},"Wenn Audiodateien auf der Festplatte umziehen, zeigt SoundNinja ",[42,576,577],{},"Fehlende Sounddateien",". Einen Suchordner wählen und Clips neu verknüpfen.",[31,580,582],{"id":581},"weiter","Weiter",[14,584,585,586,197],{},"Tabs, Gruppen und Hotkeys: ",[18,587,588],{"href":323},"Sounds organisieren",{"title":155,"searchDepth":173,"depth":173,"links":590},[591,592,593,594,595,596],{"id":470,"depth":173,"text":471},{"id":491,"depth":173,"text":492},{"id":526,"depth":173,"text":527},{"id":549,"depth":173,"text":550},{"id":570,"depth":173,"text":571},{"id":581,"depth":173,"text":582},"Audio, Ordner, Aufnahmen und geteilte Soundboards importieren.",{},3,"\u002Fadding-sounds",{"title":318,"description":597},"adding-sounds","qhheWryk-vrNfEsQyZSumTndjdSmJPmEctxDG9Gyulk",{"id":605,"title":588,"body":606,"description":750,"extension":210,"meta":751,"navigation":212,"order":752,"path":753,"seo":754,"stem":755,"__hash__":756},"content_de\u002Forganizing-sounds.md",{"type":7,"value":607,"toc":741},[608,611,614,618,644,651,655,658,672,679,683,688,692,703,707,710,714,717,723,729,733],[10,609,588],{"id":610},"sounds-organisieren",[14,612,613],{},"SoundNinja ist für große Bibliotheken gebaut. Tabs, Gruppen, Suche und Hotkeys — der Clip ist einen Klick (oder eine Taste) entfernt.",[31,615,617],{"id":616},"tabs","Tabs",[36,619,620,627,634],{},[39,621,622,623,626],{},"Tab mit ",[42,624,625],{},"Tab hinzufügen"," anlegen. Farbe vergeben, damit die Leiste schnell scannbar bleibt.",[39,628,629,630,633],{},"Die Ansicht ",[42,631,632],{},"Alle"," zeigt jeden Sound über alle Tabs.",[39,635,636,637,640,641,197],{},"Ein Sound kann ",[42,638,639],{},"einem oder mehreren Tabs"," gehören. Rechtsklick → ",[42,642,643],{},"Zu Tab verschieben",[14,645,646,647,650],{},"Tab-Übergänge: ",[42,648,649],{},"Einstellungen → Allgemein"," — Slide, Fade, Buttons nacheinander oder Keine.",[31,652,654],{"id":653},"gruppen","Gruppen",[14,656,657],{},"Seit v0.5.3 können Trenner zu benannten Gruppen werden:",[36,659,660,663,666,669],{},[39,661,662],{},"Gruppe über das Kontextmenü hinzufügen, umbenennen oder entfernen",[39,664,665],{},"Gruppenkopf ziehen — Kinder kommen mit",[39,667,668],{},"Sounds in eine Gruppe legen oder herausnehmen",[39,670,671],{},"Rahmenfarbe, Namensfarbe und Button-Ausrichtung setzen (oder Tab-Standard nutzen)",[14,673,674,675,678],{},"Ein einfacher ",[42,676,677],{},"Trenner"," geht weiter, wenn du nur einen visuellen Bruch brauchst.",[31,680,682],{"id":681},"suche","Suche",[14,684,685,687],{},[42,686,682],{}," in der Navbar. Ergebnisse folgen der Eingabe.",[31,689,691],{"id":690},"neu-anordnen","Neu anordnen",[14,693,694,695,698,699,702],{},"Drag-and-Drop in ",[42,696,697],{},"Einstellungen → Verhalten"," einschalten (",[42,700,701],{},"Neu anordnen erlauben","). Dann Sounds und Gruppen ziehen.",[31,704,706],{"id":705},"sammelbearbeitung","Sammelbearbeitung",[14,708,709],{},"Mehrere Sounds markieren, dann Farbe ändern, in einen Tab schieben oder löschen.",[31,711,713],{"id":712},"hotkeys-und-sound-ids","Hotkeys und Sound-IDs",[14,715,716],{},"Jeder Sound hat eine 8-stellige ID. Kopieren über das Button-Kontextmenü oder den Mehrfachauswahl-Chip.",[14,718,719,722],{},[42,720,721],{},"Einstellungen → Hotkeys",": Taste an eine Sound-ID binden. Globale Hotkeys sind optional.",[14,724,725,726,728],{},"Dieselbe ID nutzt ",[18,727,279],{"href":278}," zum Auslösen.",[31,730,732],{"id":731},"gifs-und-farben","GIFs und Farben",[14,734,735,736,740],{},"Rechtsklick auf einen Sound: eigene Farben oder GIF-\u002FBildhintergrund. Das ist getrennt vom ",[18,737,739],{"href":738},"\u002Fdocs\u002Ftheme-editor","Theme Creator",", der das ganze Board gestaltet.",{"title":155,"searchDepth":173,"depth":173,"links":742},[743,744,745,746,747,748,749],{"id":616,"depth":173,"text":617},{"id":653,"depth":173,"te