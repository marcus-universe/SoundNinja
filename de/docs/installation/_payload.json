[{"data":1,"prerenderedAt":1619},["ShallowReactive",2],{"docs-page-de-\u002Finstallation":3,"docs-nav-de":219},{"id":4,"title":5,"body":6,"description":212,"extension":213,"meta":214,"navigation":215,"order":176,"path":216,"seo":217,"stem":12,"__hash__":218},"content_de\u002Finstallation.md","Installation",{"type":7,"value":8,"toc":205},"minimark",[9,13,30,35,59,62,66,80,83,87,112,123,127,134,138,152,185,201],[10,11,5],"h1",{"id":12},"installation",[14,15,16,17,22,23,29],"p",{},"Hol dir einen Build von der ",[18,19,21],"a",{"href":20},"\u002Fdownload","Download-Seite"," oder von ",[18,24,28],{"href":25,"rel":26},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Freleases\u002Flatest",[27],"nofollow","GitHub Releases",". SoundNinja ist in früher Entwicklung — behandle Builds als Beta.",[31,32,34],"h2",{"id":33},"windows","Windows",[36,37,38,50,53,56],"ul",{},[39,40,41,45,46,49],"li",{},[42,43,44],"strong",{},"Installer (.exe)"," oder ",[42,47,48],{},"MSI (.msi)"," für 64-Bit-Windows",[39,51,52],{},"Landing-Page-Ziel: Windows 10 und neuer",[39,54,55],{},"Die App-README nennt auch Windows 8 und höher",[39,57,58],{},"Der NSIS-Installer ist dunkel. Sprache beim Setup wählen — SoundNinja merkt sie beim nächsten Start.",[14,60,61],{},"Installer starten, dann SoundNinja über das Startmenü öffnen.",[31,63,65],{"id":64},"macos","macOS",[36,67,68,74,77],{},[39,69,70,73],{},[42,71,72],{},"Universelles .dmg"," für Apple Silicon und Intel",[39,75,76],{},"Landing-Page-Ziel: macOS 10.14 und neuer",[39,78,79],{},"Die App-README nennt macOS 10.15 und höher",[14,81,82],{},"Disk-Image öffnen und SoundNinja nach Programme ziehen.",[31,84,86],{"id":85},"linux","Linux",[36,88,89,95,101,109],{},[39,90,91,94],{},[42,92,93],{},"Debian (.deb)"," für Ubuntu \u002F Debian",[39,96,97,100],{},[42,98,99],{},"AppImage"," für andere Distros",[39,102,103,104,108],{},"Nach Veröffentlichung einer Release können Arch-Nutzer ",[105,106,107],"code",{},"soundninja-bin"," aus dem AUR installieren",[39,110,111],{},"Getestet unter Ubuntu 20.04",[14,113,114,115,118,119,122],{},"Desktop-Builds brauchen WebKit- und GTK-Pakete. Unter Debian\u002FUbuntu meist ",[105,116,117],{},"libwebkit2gtk",", ",[105,120,121],{},"libgtk-3-0"," und eine App-Indicator-Bibliothek.",[31,124,126],{"id":125},"updates","Updates",[14,128,129,130,133],{},"In der App: ",[42,131,132],{},"Hilfe → Nach Updates suchen",". Optional prüft SoundNinja beim Start in den Einstellungen.",[31,135,137],{"id":136},"aus-dem-quellcode-bauen","Aus dem Quellcode bauen",[14,139,140,141,118,146,151],{},"Eigenen Build? ",[18,142,145],{"href":143,"rel":144},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja",[27],"Repo klonen",[18,147,150],{"href":148,"rel":149},"https:\u002F\u002Fv2.tauri.app\u002Fstart\u002Fprerequisites\u002F",[27],"Tauri-Voraussetzungen"," installieren, dann:",[153,154,159],"pre",{"className":155,"code":156,"language":157,"meta":158,"style":158},"language-bash shiki shiki-themes github-light github-dark","bun install\nbun run tauri:serve\n","bash","",[105,160,161,174],{"__ignoreMap":158},[162,163,166,170],"span",{"class":164,"line":165},"line",1,[162,167,169],{"class":168},"sScJk","bun",[162,171,173],{"class":172},"sZZnC"," install\n",[162,175,177,179,182],{"class":164,"line":176},2,[162,178,169],{"class":168},[162,180,181],{"class":172}," run",[162,183,184],{"class":172}," tauri:serve\n",[14,186,187,118,190,45,193,196,197,200],{},[105,188,189],{},"npm",[105,191,192],{},"pnpm",[105,194,195],{},"deno"," gehen auch. Produktionsbuild: ",[105,198,199],{},"bun run tauri:build",".",[202,203,204],"style",{},"html pre.shiki code .sScJk, html code.shiki .sScJk{--shiki-default:#6F42C1;--shiki-dark:#B392F0}html pre.shiki code .sZZnC, html code.shiki .sZZnC{--shiki-default:#032F62;--shiki-dark:#9ECBFF}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html.dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}",{"title":158,"searchDepth":176,"depth":176,"links":206},[207,208,209,210,211],{"id":33,"depth":176,"text":34},{"id":64,"depth":176,"text":65},{"id":85,"depth":176,"text":86},{"id":125,"depth":176,"text":126},{"id":136,"depth":176,"text":137},"SoundNinja unter Windows, macOS oder Linux installieren.","md",{},true,"\u002Finstallation",{"title":5,"description":212},"r-3EUG7lGdfEJsGyve9-EQzSXP8-1Q3frBZ2lky4J_M",[220,349,472,618,1018,1152,1299,1522],{"id":221,"title":222,"body":223,"description":343,"extension":213,"meta":344,"navigation":215,"order":165,"path":345,"seo":346,"stem":347,"__hash__":348},"content_de\u002Foverview.md","Überblick",{"type":7,"value":224,"toc":337},[225,228,231,234,237,241,255,259,299,303,312,316],[10,226,222],{"id":227},"überblick",[14,229,230],{},"SoundNinja ist ein Open-Source-Soundboard für Livestreams, Chats mit Freunden und Podcast-Aufnahmen. Es läuft auf Tauri v2 und Nuxt 4 und bleibt dabei sparsam mit RAM und Speicherplatz.",[14,232,233],{},"Das Ziel: eine große Sound-Bibliothek schnell scannen und den richtigen Clip in Millisekunden abspielen. Die Oberfläche eignet sich auch als Dashboard in VR.",[14,235,236],{},"SoundNinja steckt noch in der frühen Entwicklung. Funktionen laufen, aber nicht jede Plattform ist vollständig getestet.",[31,238,240],{"id":239},"für-wen","Für wen",[36,242,243,246,249,252],{},[39,244,245],{},"Streamer, die sofortige Sound-Cues brauchen",[39,247,248],{},"Freunde, die ein gemeinsames Board für Voice-Chat wollen",[39,250,251],{},"Podcaster, die Clips aufnehmen und aufs Board legen",[39,253,254],{},"Alle, die ein anpassbares, lokales Soundboard wollen",[31,256,258],{"id":257},"was-du-tun-kannst","Was du tun kannst",[36,260,261,264,267,270,273,276,279,282,285,293,296],{},[39,262,263],{},"Ein Soundboard aus eigenen Audiodateien bauen",[39,265,266],{},"Sounds in farbigen Tabs, Gruppen, Tags und über die Suche sortieren",[39,268,269],{},"Nach Tags filtern (ODER) und nach Name, Datum, Dauer oder Größe sortieren",[39,271,272],{},"Mehrfachauswahl mit Rahmen oder Shift-Bereich, dann Farbe, Tab oder Löschen in einem Rutsch",[39,274,275],{},"Lautstärke pro Sound im Kontextmenü setzen",[39,277,278],{},"Das Aussehen mit dem Theme Creator gestalten",[39,280,281],{},"PC-Audio oder Mikrofon im Record Editor aufnehmen",[39,283,284],{},"Hotkeys einzelnen Sounds zuweisen",[39,286,287,288,292],{},"Sounds über ",[18,289,291],{"href":290},"\u002Fdocs\u002Fremote-control","Bitfocus Companion"," auslösen",[39,294,295],{},"Ein komplettes Soundboard importieren und exportieren",[39,297,298],{},"GIFs oder Bilder auf Sound-Buttons legen — aus lokaler Ordnerbibliothek oder KLIPY",[31,300,302],{"id":301},"lizenz","Lizenz",[14,304,305,306,311],{},"SoundNinja ist freie Software unter ",[18,307,310],{"href":308,"rel":309},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fblob\u002Fmain\u002FLICENSE",[27],"GPL-3.0",". Forken, ändern, teilen.",[31,313,315],{"id":314},"nächste-schritte","Nächste Schritte",[317,318,319,325,331],"ol",{},[39,320,321],{},[18,322,324],{"href":323},"\u002Fdocs\u002Finstallation","SoundNinja installieren",[39,326,327],{},[18,328,330],{"href":329},"\u002Fdocs\u002Fadding-sounds","Sounds hinzufügen",[39,332,333],{},[18,334,336],{"href":335},"\u002Fdocs\u002Forganizing-sounds","Board organisieren",{"title":158,"searchDepth":176,"depth":176,"links":338},[339,340,341,342],{"id":239,"depth":176,"text":240},{"id":257,"depth":176,"text":258},{"id":301,"depth":176,"text":302},{"id":314,"depth":176,"text":315},"Was SoundNinja ist und was du damit machen kannst.",{},"\u002Foverview",{"title":222,"description":343},"overview","hoyfMBw8UK5RuLBAbdnmSxP4gC163p8E8rvJgSihSXE",{"id":4,"title":5,"body":350,"description":212,"extension":213,"meta":470,"navigation":215,"order":176,"path":216,"seo":471,"stem":12,"__hash__":218},{"type":7,"value":351,"toc":463},[352,354,361,363,377,379,381,391,393,395,411,417,419,423,425,433,451,461],[10,353,5],{"id":12},[14,355,16,356,22,358,29],{},[18,357,21],{"href":20},[18,359,28],{"href":25,"rel":360},[27],[31,362,34],{"id":33},[36,364,365,371,373,375],{},[39,366,367,45,369,49],{},[42,368,44],{},[42,370,48],{},[39,372,52],{},[39,374,55],{},[39,376,58],{},[14,378,61],{},[31,380,65],{"id":64},[36,382,383,387,389],{},[39,384,385,73],{},[42,386,72],{},[39,388,76],{},[39,390,79],{},[14,392,82],{},[31,394,86],{"id":85},[36,396,397,401,405,409],{},[39,398,399,94],{},[42,400,93],{},[39,402,403,100],{},[42,404,99],{},[39,406,103,407,108],{},[105,408,107],{},[39,410,111],{},[14,412,114,413,118,415,122],{},[105,414,117],{},[105,416,121],{},[31,418,126],{"id":125},[14,420,129,421,133],{},[42,422,132],{},[31,424,137],{"id":136},[14,426,140,427,118,430,151],{},[18,428,145],{"href":143,"rel":429},[27],[18,431,150],{"href":148,"rel":432},[27],[153,434,435],{"className":155,"code":156,"language":157,"meta":158,"style":158},[105,436,437,443],{"__ignoreMap":158},[162,438,439,441],{"class":164,"line":165},[162,440,169],{"class":168},[162,442,173],{"class":172},[162,444,445,447,449],{"class":164,"line":176},[162,446,169],{"class":168},[162,448,181],{"class":172},[162,450,184],{"class":172},[14,452,453,118,455,45,457,196,459,200],{},[105,454,189],{},[105,456,192],{},[105,458,195],{},[105,460,199],{},[202,462,204],{},{"title":158,"searchDepth":176,"depth":176,"links":464},[465,466,467,468,469],{"id":33,"depth":176,"text":34},{"id":64,"depth":176,"text":65},{"id":85,"depth":176,"text":86},{"id":125,"depth":176,"text":126},{"id":136,"depth":176,"text":137},{},{"title":5,"description":212},{"id":473,"title":330,"body":474,"description":611,"extension":213,"meta":612,"navigation":215,"order":613,"path":614,"seo":615,"stem":616,"__hash__":617},"content_de\u002Fadding-sounds.md",{"type":7,"value":475,"toc":603},[476,479,482,486,503,507,538,542,561,565,579,582,586,593,597],[10,477,330],{"id":478},"sounds-hinzufügen",[14,480,481],{},"Ein Board bleibt leer, bis du Clips hinzufügst. SoundNinja importiert Dateien, ganze Ordner, eine Aufnahme oder ein geteiltes Soundboard-Paket.",[31,483,485],{"id":484},"audiodateien-importieren","Audiodateien importieren",[317,487,488,497,500],{},[39,489,490,45,493,496],{},[42,491,492],{},"Datei → Audiodateien importieren",[42,494,495],{},"Import"," in der Navbar.",[39,498,499],{},"Eine oder mehrere Audiodateien wählen.",[39,501,502],{},"Sounds landen im aktuellen Tab.",[31,504,506],{"id":505},"ordner-importieren","Ordner importieren",[317,508,509,518,521],{},[39,510,511,514,515,517],{},[42,512,513],{},"Datei → Ordner importieren"," (oder ",[42,516,506],{}," in der Navbar).",[39,519,520],{},"Einen oder mehrere Ordner hinzufügen. Vor dem Import per Drag neu sortieren.",[39,522,523,524],{},"Ziel wählen:\n",[36,525,526,532],{},[39,527,528,531],{},[42,529,530],{},"Als Tabs importieren"," — jeder Ordner wird ein eigener Tab",[39,533,534,537],{},[42,535,536],{},"In aktuellen Tab importieren"," — alle Dateien landen im aktiven Tab",[31,539,541],{"id":540},"clip-aufnehmen","Clip aufnehmen",[14,543,544,545,549,550,553,554,45,557,560],{},"Öffne den ",[18,546,548],{"href":547},"\u002Fdocs\u002Frecording-editor","Record Editor"," über ",[42,551,552],{},"Aufnahme"," in der Player-Leiste. Aufnehmen, zuschneiden, dann ",[42,555,556],{},"Auswahl importieren",[42,558,559],{},"Alle importieren"," in den aktuellen Tab oder einen gewählten Tab.",[31,562,564],{"id":563},"soundboard-importieren","Soundboard importieren",[14,566,567,570,571,574,575,578],{},[42,568,569],{},"Datei → Soundboard importieren"," lädt ein geteiltes Paket. Pakete sind ein ",[105,572,573],{},".zip"," mit ",[105,576,577],{},"project.sninja"," plus Sounddateien. Danach Projekt öffnen und abspielen.",[14,580,581],{},"Du kannst mehrere Projekte (Profile) halten. Über den Projektwähler zwischen Boards wechseln.",[31,583,585],{"id":584},"fehlende-dateien-neu-verknüpfen","Fehlende Dateien neu verknüpfen",[14,587,588,589,592],{},"Wenn Audiodateien auf der Festplatte umziehen, zeigt SoundNinja ",[42,590,591],{},"Fehlende Sounddateien",". Einen Suchordner wählen und Clips neu verknüpfen.",[31,594,596],{"id":595},"weiter","Weiter",[14,598,599,600,200],{},"Tabs, Tags, Filter und Hotkeys: ",[18,601,602],{"href":335},"Sounds organisieren",{"title":158,"searchDepth":176,"depth":176,"links":604},[605,606,607,608,609,610],{"id":484,"depth":176,"text":485},{"id":505,"depth":176,"text":506},{"id":540,"depth":176,"text":541},{"id":563,"depth":176,"text":564},{"id":584,"depth":176,"text":585},{"id":595,"depth":176,"text":596},"Audio, Ordner, Aufnahmen und geteilte Soundboards importieren.",{},3,"\u002Fadding-sounds",{"title":330,"description":611},"adding-sounds","H_ls9_vOwDkgTWPkfe9bQz1A0XidUOmMFV4V2EJpYec",{"id":619,"title":602,"body":620,"description":1011,"extension":213,"meta":1012,"navigation":215,"order":1013,"path":1014,"seo":1015,"stem":1016,"__hash__":1017},"content_de\u002Forganizing-sounds.md",{"type":7,"value":621,"toc":996},[622,625,632,636,662,669,673,676,690,697,703,707,717,722,753,757,763,767,801,807,811,814,840,843,847,860,864,869,889,905,912,916,927,930,934,941,951,957,961,969,976,993],[10,623,602],{"id":624},"sounds-organisieren",[14,626,627,628,631],{},"SoundNinja ist für große Bibliotheken gebaut. ",[42,629,630],{},"Tags und Filter",", Tabs, Suche, Mehrfachauswahl und Hotkeys — der Clip ist einen Klick (oder eine Taste) entfernt.",[31,633,635],{"id":634},"tabs","Tabs",[36,637,638,645,652],{},[39,639,640,641,644],{},"Tab mit ",[42,642,643],{},"Tab hinzufügen"," anlegen. Farbe vergeben, damit die Leiste schnell scannbar bleibt.",[39,646,647,648,651],{},"Die Ansicht ",[42,649,650],{},"Alle"," zeigt jeden Sound über alle Tabs.",[39,653,654,655,658,659,200],{},"Ein Sound kann ",[42,656,657],{},"einem oder mehreren Tabs"," gehören. Rechtsklick → ",[42,660,661],{},"Zu Tab verschieben",[14,663,664,665,668],{},"Tab-Übergänge: ",[42,666,667],{},"Einstellungen → Allgemein"," — Slide, Fade, Buttons nacheinander oder Keine.",[31,670,672],{"id":671},"gruppen","Gruppen",[14,674,675],{},"Seit v0.5.3 können Trenner zu benannten Gruppen werden:",[36,677,678,681,684,687],{},[39,679,680],{},"Gruppe über das Kontextmenü hinzufügen, umbenennen oder entfernen",[39,682,683],{},"Gruppenkopf ziehen — Kinder kommen mit",[39,685,686],{},"Sounds in eine Gruppe legen oder herausnehmen",[39,688,689],{},"Rahmenfarbe, Namensfarbe und Button-Ausrichtung setzen (oder Tab-Standard nutzen)",[14,691,692,693,696],{},"Ein einfacher ",[42,694,695],{},"Trenner"," geht weiter, wenn du nur einen visuellen Bruch brauchst.",[14,698,699,700,200],{},"Rechtsklick auf leeren Board-Bereich: ",[42,701,702],{},"Gruppe hinzufügen",[31,704,706],{"id":705},"tags-filter","Tags \u002F Filter",[14,708,709,710,713,714,716],{},"Tags gelten tabübergreifend. Das ausfahrbare ",[42,711,712],{},"Filter","-Panel (Sidebar ",[42,715,712],{},") ist der Ort zum Anlegen und zum Filtern des Boards.",[718,719,721],"h3",{"id":720},"tags-anlegen-und-bearbeiten","Tags anlegen und bearbeiten",[317,723,724,729,740,746],{},[39,725,726,728],{},[42,727,712],{}," in der Sidebar öffnen.",[39,730,731,732,735,736,739],{},"Unter ",[42,733,734],{},"Tags"," → ",[42,737,738],{},"Tag hinzufügen"," — Name und Farbe vergeben.",[39,741,742,743,200],{},"Im selben Panel umbenennen, umfärben oder ",[42,744,745],{},"Tag löschen",[39,747,748,749,752],{},"Steht da ",[42,750,751],{},"Noch keine Tags",", zuerst hier einen anlegen, bevor du zuweist.",[718,754,756],{"id":755},"tags-an-sounds-hängen","Tags an Sounds hängen",[14,758,759,760,762],{},"Rechtsklick auf einen Sound → ",[42,761,734],{}," (Checkboxen). Ein Sound darf mehrere Tags haben. Existieren noch keine, zeigt das Menü den Weg zum Filter-Panel.",[718,764,766],{"id":765},"board-filtern","Board filtern",[36,768,769,776,787,798],{},[39,770,771,772,775],{},"Tags im Filter-Panel oder als ",[42,773,774],{},"Chips unter der Suchleiste"," umschalten.",[39,777,778,779,782,783,786],{},"Abgleich ist ",[42,780,781],{},"ODER",": ein Sound bleibt sichtbar, wenn er ",[42,784,785],{},"irgendeinen"," gewählten Tag hat.",[39,788,789,790,793,794,797],{},"Das Feld ",[42,791,792],{},"Suche"," in der Navbar kombiniert per ",[42,795,796],{},"UND"," mit dem aktiven Tag-Filter (Tippen + Tags zusammen).",[39,799,800],{},"Chips aus (oder Filter leeren), um den ganzen Tab wieder zu sehen.",[14,802,803,804,200],{},"Farbige Tag-Namen können auf Buttons erscheinen. Schalter: ",[42,805,806],{},"Einstellungen → Verhalten → Tag-Badges anzeigen",[31,808,810],{"id":809},"sortierung","Sortierung",[14,812,813],{},"Im Filter-Panel eine Sortierung wählen:",[36,815,816,822],{},[39,817,818,821],{},[42,819,820],{},"Benutzerdefiniert"," — deine Tab-Reihenfolge, Gruppen sichtbar",[39,823,824,118,827,118,830,45,833,836,837],{},[42,825,826],{},"Name",[42,828,829],{},"Hinzugefügt",[42,831,832],{},"Spielzeit",[42,834,835],{},"Dateigröße"," — flache sortierte Liste; ",[42,838,839],{},"Gruppen sind ausgeblendet",[14,841,842],{},"Sortierung nach Dauer kann beim ersten Mal die Dauer-Metadaten vorwärmen.",[31,844,846],{"id":845},"neu-anordnen","Neu anordnen",[14,848,849,850,853,854,857,858,200],{},"Drag-and-Drop in ",[42,851,852],{},"Einstellungen → Verhalten"," einschalten (",[42,855,856],{},"Neu anordnen erlauben","). Dann Sounds und Gruppen ziehen. Neu anordnen gilt bei ",[42,859,820],{},[31,861,863],{"id":862},"mehrfachauswahl","Mehrfachauswahl",[14,865,866,868],{},[42,867,863],{}," in der Navbar einschalten, dann:",[36,870,871,874,880,886],{},[39,872,873],{},"Klick toggelt einen Sound",[39,875,876,879],{},[42,877,878],{},"Shift+Klick"," wählt einen Bereich ab dem letzten Anker",[39,881,882,885],{},[42,883,884],{},"Rahmen"," auf leerem Board ziehen",[39,887,888],{},"Klick auf leeres Board (oder außerhalb) leert die Auswahl",[14,890,891,892,118,895,118,898,901,902,200],{},"Eine Sammelleiste zeigt die Anzahl plus ",[42,893,894],{},"Farbe",[42,896,897],{},"Zu Tab verschieben…",[42,899,900],{},"Löschen"," und ",[42,903,904],{},"Fertig",[14,906,907,908,911],{},"In der Mehrfachauswahl zeigt jeder Button einen ",[42,909,910],{},"8-Zeichen-ID-Chip",". Rechtsklick auf den Chip kopiert die ID.",[31,913,915],{"id":914},"lautstärke-pro-sound","Lautstärke pro Sound",[14,917,918,919,922,923,926],{},"Rechtsklick → ",[42,920,921],{},"Lautstärke",". Slider von 0 % bis 100 %. ",[42,924,925],{},"Doppelklick"," setzt auf 100 % zurück.",[14,928,929],{},"Das stapelt sich mit der Master-Ausgangslautstärke in den Einstellungen.",[31,931,933],{"id":932},"hotkeys-und-sound-ids","Hotkeys und Sound-IDs",[14,935,936,937,940],{},"Jeder Sound hat eine 8-stellige ID. Kopieren über das Button-Kontextmenü (",[42,938,939],{},"ID kopieren",") oder den Mehrfachauswahl-Chip.",[14,942,943,946,947,950],{},[42,944,945],{},"Einstellungen → Hotkeys",": Taste an eine Sound-ID binden. Globale Hotkeys sind optional. ",[42,948,949],{},"Hotkey zuweisen"," im Kontextmenü springt dorthin, ID vorausgefüllt.",[14,952,953,954,956],{},"Dieselbe ID nutzt ",[18,955,291],{"href":290}," zum Auslösen.",[31,958,960],{"id":959},"hintergrundbilder-und-farben","Hintergrundbilder und Farben",[14,962,963,964,968],{},"Rechtsklick auf einen Sound: eigene Farben oder ein Hintergrundbild. Das ist getrennt vom ",[18,965,967],{"href":966},"\u002Fdocs\u002Ftheme-editor","Theme Creator",", der das ganze Board gestaltet.",[14,970,971,972,975],{},"Der Picker ist ein Dialog ",[42,973,974],{},"Hintergrundbild"," (PNG, JPEG, GIF, WebP):",[36,977,978,984],{},[39,979,980,983],{},[42,981,982],{},"Lokale Dateien"," — Ordner hinzufügen, einzelne Datei wählen, Dateinamen suchen, Rastervorschau, Ordner aus der Bibliothek entfernen",[39,985,986,989,990,992],{},[42,987,988],{},"KLIPY"," — GIFs online suchen. Eigenen API-Key unter ",[42,991,852],{},". Der Key landet nicht in Projektdateien.",[14,994,995],{},"Nach der Wahl Bild auf dem Button schieben und zuschneiden.",{"title":158,"searchDepth":176,"depth":176,"links":997},[998,999,1000,1005,1006,1007,1008,1009,1010],{"id":634,"depth":176,"text":635},{"id":671,"depth":176,"text":672},{"id":705,"depth":176,"text":706,"children":1001},[1002,1003,1004],{"id":720,"depth":613,"text":721},{"id":755,"depth":613,"text":756},{"id":765,"depth":613,"text":766},{"id":809,"depth":176,"text":810},{"id":845,"depth":176,"text":846},{"id":862,"depth":176,"text":863},{"id":914,"depth":176,"text":915},{"id":932,"depth":176,"text":933},{"id":959,"depth":176,"text":960},"Tags, Filter, Tabs, Gruppen, Sortierung, Mehrfachauswahl, Lautstärke und Hotkeys.",{},4,"\u002Forganizing-sounds",{"title":602,"description":1011},"organizing-sounds","phia_N7HDS6LIgxhltoa9iRYViBzJ00ngFayO7YKdtQ",{"id":1019,"title":1020,"body":1021,"description":1146,"extension":213,"meta":1147,"navigation":215,"order":1148,"path":1149,"seo":1150,"stem":1025,"__hash__":1151},"content_de\u002Ftheme-editor.md","Theme-Editor",{"type":7,"value":1022,"toc":1140},[1023,1026,1032,1036,1063,1066,1070,1084,1088,1114,1117,1121,1126],[10,1024,1020],{"id":1025},"theme-editor",[14,1027,1028,1029,200],{},"Der Theme Creator ist der volle visuelle Editor für dein Board. Öffnen über ",[42,1030,1031],{},"Einstellungen → Allgemein → Theme Creator",[31,1033,1035],{"id":1034},"drei-tabs","Drei Tabs",[317,1037,1038,1052,1058],{},[39,1039,1040,1043,1044,1047,1048,1051],{},[42,1041,1042],{},"Allgemein"," — T