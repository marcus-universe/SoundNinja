[{"data":1,"prerenderedAt":1662},["ShallowReactive",2],{"docs-page-de-\u002Finstallation":3,"docs-nav-de":240},{"id":4,"title":5,"body":6,"description":233,"extension":234,"meta":235,"navigation":236,"order":176,"path":237,"seo":238,"stem":12,"__hash__":239},"content_de\u002Finstallation.md","Installation",{"type":7,"value":8,"toc":226},"minimark",[9,13,30,35,59,62,66,80,83,87,112,123,127,134,138,152,185,201,222],[10,11,5],"h1",{"id":12},"installation",[14,15,16,17,22,23,29],"p",{},"Hol dir einen Build von der ",[18,19,21],"a",{"href":20},"\u002Fdownload","Download-Seite"," oder von ",[18,24,28],{"href":25,"rel":26},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Freleases\u002Flatest",[27],"nofollow","GitHub Releases",". SoundNinja ist in früher Entwicklung — behandle Builds als Beta.",[31,32,34],"h2",{"id":33},"windows","Windows",[36,37,38,50,53,56],"ul",{},[39,40,41,45,46,49],"li",{},[42,43,44],"strong",{},"Installer (.exe)"," oder ",[42,47,48],{},"MSI (.msi)"," für 64-Bit-Windows",[39,51,52],{},"Landing-Page-Ziel: Windows 10 und neuer",[39,54,55],{},"Die App-README nennt auch Windows 8 und höher",[39,57,58],{},"Der NSIS-Installer ist dunkel. Sprache beim Setup wählen — SoundNinja merkt sie beim nächsten Start.",[14,60,61],{},"Installer starten, dann SoundNinja über das Startmenü öffnen.",[31,63,65],{"id":64},"macos","macOS",[36,67,68,74,77],{},[39,69,70,73],{},[42,71,72],{},"Universelles .dmg"," für Apple Silicon und Intel",[39,75,76],{},"Landing-Page-Ziel: macOS 10.14 und neuer",[39,78,79],{},"Die App-README nennt macOS 10.15 und höher",[14,81,82],{},"Disk-Image öffnen und SoundNinja nach Programme ziehen.",[31,84,86],{"id":85},"linux","Linux",[36,88,89,95,101,109],{},[39,90,91,94],{},[42,92,93],{},"Debian (.deb)"," für Ubuntu \u002F Debian",[39,96,97,100],{},[42,98,99],{},"AppImage"," für andere Distros",[39,102,103,104,108],{},"Nach Veröffentlichung einer Release können Arch-Nutzer ",[105,106,107],"code",{},"soundninja-bin"," aus dem AUR installieren",[39,110,111],{},"Getestet unter Ubuntu 20.04",[14,113,114,115,118,119,122],{},"Desktop-Builds brauchen WebKit- und GTK-Pakete. Unter Debian\u002FUbuntu meist ",[105,116,117],{},"libwebkit2gtk",", ",[105,120,121],{},"libgtk-3-0"," und eine App-Indicator-Bibliothek.",[31,124,126],{"id":125},"updates","Updates",[14,128,129,130,133],{},"In der App: ",[42,131,132],{},"Hilfe → Nach Updates suchen",". Optional prüft SoundNinja beim Start in den Einstellungen.",[31,135,137],{"id":136},"aus-dem-quellcode-bauen","Aus dem Quellcode bauen",[14,139,140,141,118,146,151],{},"Eigenen Build? ",[18,142,145],{"href":143,"rel":144},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja",[27],"Repo klonen",[18,147,150],{"href":148,"rel":149},"https:\u002F\u002Fv2.tauri.app\u002Fstart\u002Fprerequisites\u002F",[27],"Tauri-Voraussetzungen"," installieren, dann:",[153,154,159],"pre",{"className":155,"code":156,"language":157,"meta":158,"style":158},"language-bash shiki shiki-themes github-light github-dark","bun install\nbun run tauri:serve\n","bash","",[105,160,161,174],{"__ignoreMap":158},[162,163,166,170],"span",{"class":164,"line":165},"line",1,[162,167,169],{"class":168},"sScJk","bun",[162,171,173],{"class":172},"sZZnC"," install\n",[162,175,177,179,182],{"class":164,"line":176},2,[162,178,169],{"class":168},[162,180,181],{"class":172}," run",[162,183,184],{"class":172}," tauri:serve\n",[14,186,187,118,190,45,193,196,197,200],{},[105,188,189],{},"npm",[105,191,192],{},"pnpm",[105,194,195],{},"deno"," gehen auch. Produktionsbuild: ",[105,198,199],{},"bun run tauri:build",".",[14,202,203,206,207,212,213,216,217,200],{},[42,204,205],{},"Nur Windows:"," jeder Windows-Compile enthält ASIO über das ",[18,208,211],{"href":209,"rel":210},"https:\u002F\u002Fwww.steinberg.net\u002Fasiosdk",[27],"Steinberg ASIO SDK",". Einmal ",[105,214,215],{},"bun run setup:asio"," (SDK nicht im Git). Linux und macOS nutzen PipeWire \u002F Core Audio — diesen Schritt überspringen. Details: ",[18,218,221],{"href":219,"rel":220},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fblob\u002Fmain\u002Fdocs\u002Fbuild-from-source.md",[27],"build-from-source.md",[223,224,225],"style",{},"html pre.shiki code .sScJk, html code.shiki .sScJk{--shiki-default:#6F42C1;--shiki-dark:#B392F0}html pre.shiki code .sZZnC, html code.shiki .sZZnC{--shiki-default:#032F62;--shiki-dark:#9ECBFF}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html.dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}",{"title":158,"searchDepth":176,"depth":176,"links":227},[228,229,230,231,232],{"id":33,"depth":176,"text":34},{"id":64,"depth":176,"text":65},{"id":85,"depth":176,"text":86},{"id":125,"depth":176,"text":126},{"id":136,"depth":176,"text":137},"SoundNinja unter Windows, macOS oder Linux installieren.","md",{},true,"\u002Finstallation",{"title":5,"description":233},"OPh-0WbR2ebU9niw-poNeR6zaGWqUJm2ONgxhb61JBU",[241,370,505,651,1061,1195,1342,1565],{"id":242,"title":243,"body":244,"description":364,"extension":234,"meta":365,"navigation":236,"order":165,"path":366,"seo":367,"stem":368,"__hash__":369},"content_de\u002Foverview.md","Überblick",{"type":7,"value":245,"toc":358},[246,249,252,255,258,262,276,280,320,324,333,337],[10,247,243],{"id":248},"überblick",[14,250,251],{},"SoundNinja ist ein Open-Source-Soundboard für Livestreams, Chats mit Freunden und Podcast-Aufnahmen. Es läuft auf Tauri v2 und Nuxt 4 und bleibt dabei sparsam mit RAM und Speicherplatz.",[14,253,254],{},"Das Ziel: eine große Sound-Bibliothek schnell scannen und den richtigen Clip in Millisekunden abspielen. Die Oberfläche eignet sich auch als Dashboard in VR.",[14,256,257],{},"SoundNinja steckt noch in der frühen Entwicklung. Funktionen laufen, aber nicht jede Plattform ist vollständig getestet.",[31,259,261],{"id":260},"für-wen","Für wen",[36,263,264,267,270,273],{},[39,265,266],{},"Streamer, die sofortige Sound-Cues brauchen",[39,268,269],{},"Freunde, die ein gemeinsames Board für Voice-Chat wollen",[39,271,272],{},"Podcaster, die Clips aufnehmen und aufs Board legen",[39,274,275],{},"Alle, die ein anpassbares, lokales Soundboard wollen",[31,277,279],{"id":278},"was-du-tun-kannst","Was du tun kannst",[36,281,282,285,288,291,294,297,300,303,306,314,317],{},[39,283,284],{},"Ein Soundboard aus eigenen Audiodateien bauen",[39,286,287],{},"Sounds in farbigen Tabs, Gruppen, Tags und über die Suche sortieren",[39,289,290],{},"Nach Tags filtern (ODER) und nach Name, Datum, Dauer oder Größe sortieren",[39,292,293],{},"Mehrfachauswahl mit Rahmen oder Shift-Bereich, dann Farbe, Tab oder Löschen in einem Rutsch",[39,295,296],{},"Lautstärke pro Sound im Kontextmenü setzen",[39,298,299],{},"Das Aussehen mit dem Theme Creator gestalten",[39,301,302],{},"PC-Audio oder Mikrofon im Record Editor aufnehmen",[39,304,305],{},"Hotkeys einzelnen Sounds zuweisen",[39,307,308,309,313],{},"Sounds über ",[18,310,312],{"href":311},"\u002Fdocs\u002Fremote-control","Bitfocus Companion"," auslösen",[39,315,316],{},"Ein komplettes Soundboard importieren und exportieren",[39,318,319],{},"GIFs oder Bilder auf Sound-Buttons legen — aus lokaler Ordnerbibliothek, GifSnap oder KLIPY",[31,321,323],{"id":322},"lizenz","Lizenz",[14,325,326,327,332],{},"SoundNinja ist freie Software unter ",[18,328,331],{"href":329,"rel":330},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fblob\u002Fmain\u002FLICENSE",[27],"GPL-3.0",". Forken, ändern, teilen.",[31,334,336],{"id":335},"nächste-schritte","Nächste Schritte",[338,339,340,346,352],"ol",{},[39,341,342],{},[18,343,345],{"href":344},"\u002Fdocs\u002Finstallation","SoundNinja installieren",[39,347,348],{},[18,349,351],{"href":350},"\u002Fdocs\u002Fadding-sounds","Sounds hinzufügen",[39,353,354],{},[18,355,357],{"href":356},"\u002Fdocs\u002Forganizing-sounds","Board organisieren",{"title":158,"searchDepth":176,"depth":176,"links":359},[360,361,362,363],{"id":260,"depth":176,"text":261},{"id":278,"depth":176,"text":279},{"id":322,"depth":176,"text":323},{"id":335,"depth":176,"text":336},"Was SoundNinja ist und was du damit machen kannst.",{},"\u002Foverview",{"title":243,"description":364},"overview","NKjfErgZuRFyQOJf6ppAsKHoUKCnyQ4MYR-evnuglSg",{"id":4,"title":5,"body":371,"description":233,"extension":234,"meta":503,"navigation":236,"order":176,"path":237,"seo":504,"stem":12,"__hash__":239},{"type":7,"value":372,"toc":496},[373,375,382,384,398,400,402,412,414,416,432,438,440,444,446,454,472,482,494],[10,374,5],{"id":12},[14,376,16,377,22,379,29],{},[18,378,21],{"href":20},[18,380,28],{"href":25,"rel":381},[27],[31,383,34],{"id":33},[36,385,386,392,394,396],{},[39,387,388,45,390,49],{},[42,389,44],{},[42,391,48],{},[39,393,52],{},[39,395,55],{},[39,397,58],{},[14,399,61],{},[31,401,65],{"id":64},[36,403,404,408,410],{},[39,405,406,73],{},[42,407,72],{},[39,409,76],{},[39,411,79],{},[14,413,82],{},[31,415,86],{"id":85},[36,417,418,422,426,430],{},[39,419,420,94],{},[42,421,93],{},[39,423,424,100],{},[42,425,99],{},[39,427,103,428,108],{},[105,429,107],{},[39,431,111],{},[14,433,114,434,118,436,122],{},[105,435,117],{},[105,437,121],{},[31,439,126],{"id":125},[14,441,129,442,133],{},[42,443,132],{},[31,445,137],{"id":136},[14,447,140,448,118,451,151],{},[18,449,145],{"href":143,"rel":450},[27],[18,452,150],{"href":148,"rel":453},[27],[153,455,456],{"className":155,"code":156,"language":157,"meta":158,"style":158},[105,457,458,464],{"__ignoreMap":158},[162,459,460,462],{"class":164,"line":165},[162,461,169],{"class":168},[162,463,173],{"class":172},[162,465,466,468,470],{"class":164,"line":176},[162,467,169],{"class":168},[162,469,181],{"class":172},[162,471,184],{"class":172},[14,473,474,118,476,45,478,196,480,200],{},[105,475,189],{},[105,477,192],{},[105,479,195],{},[105,481,199],{},[14,483,484,206,486,212,489,216,491,200],{},[42,485,205],{},[18,487,211],{"href":209,"rel":488},[27],[105,490,215],{},[18,492,221],{"href":219,"rel":493},[27],[223,495,225],{},{"title":158,"searchDepth":176,"depth":176,"links":497},[498,499,500,501,502],{"id":33,"depth":176,"text":34},{"id":64,"depth":176,"text":65},{"id":85,"depth":176,"text":86},{"id":125,"depth":176,"text":126},{"id":136,"depth":176,"text":137},{},{"title":5,"description":233},{"id":506,"title":351,"body":507,"description":644,"extension":234,"meta":645,"navigation":236,"order":646,"path":647,"seo":648,"stem":649,"__hash__":650},"content_de\u002Fadding-sounds.md",{"type":7,"value":508,"toc":636},[509,512,515,519,536,540,571,575,594,598,612,615,619,626,630],[10,510,351],{"id":511},"sounds-hinzufügen",[14,513,514],{},"Ein Board bleibt leer, bis du Clips hinzufügst. SoundNinja importiert Dateien, ganze Ordner, eine Aufnahme oder ein geteiltes Soundboard-Paket.",[31,516,518],{"id":517},"audiodateien-importieren","Audiodateien importieren",[338,520,521,530,533],{},[39,522,523,45,526,529],{},[42,524,525],{},"Datei → Audiodateien importieren",[42,527,528],{},"Import"," in der Navbar.",[39,531,532],{},"Eine oder mehrere Audiodateien wählen.",[39,534,535],{},"Sounds landen im aktuellen Tab.",[31,537,539],{"id":538},"ordner-importieren","Ordner importieren",[338,541,542,551,554],{},[39,543,544,547,548,550],{},[42,545,546],{},"Datei → Ordner importieren"," (oder ",[42,549,539],{}," in der Navbar).",[39,552,553],{},"Einen oder mehrere Ordner hinzufügen. Vor dem Import per Drag neu sortieren.",[39,555,556,557],{},"Ziel wählen:\n",[36,558,559,565],{},[39,560,561,564],{},[42,562,563],{},"Als Tabs importieren"," — jeder Ordner wird ein eigener Tab",[39,566,567,570],{},[42,568,569],{},"In aktuellen Tab importieren"," — alle Dateien landen im aktiven Tab",[31,572,574],{"id":573},"clip-aufnehmen","Clip aufnehmen",[14,576,577,578,582,583,586,587,45,590,593],{},"Öffne den ",[18,579,581],{"href":580},"\u002Fdocs\u002Frecording-editor","Record Editor"," über ",[42,584,585],{},"Aufnahme"," in der Player-Leiste. Aufnehmen, zuschneiden, dann ",[42,588,589],{},"Auswahl importieren",[42,591,592],{},"Alle importieren"," in den aktuellen Tab oder einen gewählten Tab.",[31,595,597],{"id":596},"soundboard-importieren","Soundboard importieren",[14,599,600,603,604,607,608,611],{},[42,601,602],{},"Datei → Soundboard importieren"," lädt ein geteiltes Paket. Pakete sind ein ",[105,605,606],{},".zip"," mit ",[105,609,610],{},"project.sninja"," plus Sounddateien. Danach Projekt öffnen und abspielen.",[14,613,614],{},"Du kannst mehrere Projekte (Profile) halten. Über den Projektwähler zwischen Boards wechseln.",[31,616,618],{"id":617},"fehlende-dateien-neu-verknüpfen","Fehlende Dateien neu verknüpfen",[14,620,621,622,625],{},"Wenn Audiodateien auf der Festplatte umziehen, zeigt SoundNinja ",[42,623,624],{},"Fehlende Sounddateien",". Einen Suchordner wählen und Clips neu verknüpfen.",[31,627,629],{"id":628},"weiter","Weiter",[14,631,632,633,200],{},"Tabs, Tags, Filter und Hotkeys: ",[18,634,635],{"href":356},"Sounds organisieren",{"title":158,"searchDepth":176,"depth":176,"links":637},[638,639,640,641,642,643],{"id":517,"depth":176,"text":518},{"id":538,"depth":176,"text":539},{"id":573,"depth":176,"text":574},{"id":596,"depth":176,"text":597},{"id":617,"depth":176,"text":618},{"id":628,"depth":176,"text":629},"Audio, Ordner, Aufnahmen und geteilte Soundboards importieren.",{},3,"\u002Fadding-sounds",{"title":351,"description":644},"adding-sounds","H_ls9_vOwDkgTWPkfe9bQz1A0XidUOmMFV4V2EJpYec",{"id":652,"title":635,"body":653,"description":1054,"extension":234,"meta":1055,"navigation":236,"order":1056,"path":1057,"seo":1058,"stem":1059,"__hash__":1060},"content_de\u002Forganizing-sounds.md",{"type":7,"value":654,"toc":1039},[655,658,665,669,695,702,706,709,723,730,736,740,750,755,786,790,796,800,834,840,844,847,873,876,880,893,897,902,922,938,945,949,960,963,967,974,984,990,994,1002,1009,1036],[10,656,635],{"id":657},"sounds-organisieren",[14,659,660,661,664],{},"SoundNinja ist für große Bibliotheken gebaut. ",[42,662,663],{},"Tags und Filter",", Tabs, Suche, Mehrfachauswahl und Hotkeys — der Clip ist einen Klick (oder eine Taste) entfernt.",[31,666,668],{"id":667},"tabs","Tabs",[36,670,671,678,685],{},[39,672,673,674,677],{},"Tab mit ",[42,675,676],{},"Tab hinzufügen"," anlegen. Farbe vergeben, damit die Leiste schnell scannbar bleibt.",[39,679,680,681,684],{},"Die Ansicht ",[42,682,683],{},"Alle"," zeigt jeden Sound über alle Tabs.",[39,686,687,688,691,692,200],{},"Ein Sound kann ",[42,689,690],{},"einem oder mehreren Tabs"," gehören. Rechtsklick → ",[42,693,694],{},"Zu Tab verschieben",[14,696,697,698,701],{},"Tab-Übergänge: ",[42,699,700],{},"Einstellungen → Allgemein"," — Slide, Fade, Buttons nacheinander oder Keine.",[31,703,705],{"id":704},"gruppen","Gruppen",[14,707,708],{},"Seit v0.5.3 können Trenner zu benannten Gruppen werden:",[36,710,711,714,717,720],{},[39,712,713],{},"Gruppe über das Kontextmenü hinzufügen, umbenennen oder entfernen",[39,715,716],{},"Gruppenkopf ziehen — Kinder kommen mit",[39,718,719],{},"Sounds in eine Gruppe legen oder herausnehmen",[39,721,722],{},"Rahmenfarbe, Namensfarbe und Button-Ausrichtung setzen (oder Tab-Standard nutzen)",[14,724,725,726,729],{},"Ein einfacher ",[42,727,728],{},"Trenner"," geht weiter, wenn du nur einen visuellen Bruch brauchst.",[14,731,732,733,200],{},"Rechtsklick auf leeren Board-Bereich: ",[42,734,735],{},"Gruppe hinzufügen",[31,737,739],{"id":738},"tags-filter","Tags \u002F Filter",[14,741,742,743,746,747,749],{},"Tags gelten tabübergreifend. Das ausfahrbare ",[42,744,745],{},"Filter","-Panel (Sidebar ",[42,748,745],{},") ist der Ort zum Anlegen und zum Filtern des Boards.",[751,752,754],"h3",{"id":753},"tags-anlegen-und-bearbeiten","Tags anlegen und bearbeiten",[338,756,757,762,773,779],{},[39,758,759,761],{},[42,760,745],{}," in der Sidebar öffnen.",[39,763,764,765,768,769,772],{},"Unter ",[42,766,767],{},"Tags"," → ",[42,770,771],{},"Tag hinzufügen"," — Name und Farbe vergeben.",[39,774,775,776,200],{},"Im selben Panel umbenennen, umfärben oder ",[42,777,778],{},"Tag löschen",[39,780,781,782,785],{},"Steht da ",[42,783,784],{},"Noch keine Tags",", zuerst hier einen anlegen, bevor du zuweist.",[751,787,789],{"id":788},"tags-an-sounds-hängen","Tags an Sounds hängen",[14,791,792,793,795],{},"Rechtsklick auf einen Sound → ",[42,794,767],{}," (Checkboxen). Ein Sound darf mehrere Tags haben. Existieren noch keine, zeigt das Menü den Weg zum Filter-Panel.",[751,797,799],{"id":798},"board-filtern","Board filtern",[36,801,802,809,820,831],{},[39,803,804,805,808],{},"Tags im Filter-Panel oder als ",[42,806,807],{},"Chips unter der Suchleiste"," umschalten.",[39,810,811,812,815,816,819],{},"Abgleich ist ",[42,813,814],{},"ODER",": ein Sound bleibt sichtbar, wenn er ",[42,817,818],{},"irgendeinen"," gewählten Tag hat.",[39,821,822,823,826,827,830],{},"Das Feld ",[42,824,825],{},"Suche"," in der Navbar kombiniert per ",[42,828,829],{},"UND"," mit dem aktiven Tag-Filter (Tippen + Tags zusammen).",[39,832,833],{},"Chips aus (oder Filter leeren), um den ganzen Tab wieder zu sehen.",[14,835,836,837,200],{},"Farbige Tag-Namen können auf Buttons erscheinen. Schalter: ",[42,838,839],{},"Einstellungen → Verhalten → Tag-Badges anzeigen",[31,841,843],{"id":842},"sortierung","Sortierung",[14,845,846],{},"Im Filter-Panel eine Sortierung wählen:",[36,848,849,855],{},[39,850,851,854],{},[42,852,853],{},"Benutzerdefiniert"," — deine Tab-Reihenfolge, Gruppen sichtbar",[39,856,857,118,860,118,863,45,866,869,870],{},[42,858,859],{},"Name",[42,861,862],{},"Hinzugefügt",[42,864,865],{},"Spielzeit",[42,867,868],{},"Dateigröße"," — flache sortierte Liste; ",[42,871,872],{},"Gruppen sind ausgeblendet",[14,874,875],{},"Sortierung nach Dauer kann beim ersten Mal die Dauer-Metadaten vorwärmen.",[31,877,879],{"id":878},"neu-anordnen","Neu anordnen",[14,881,882,883,886,887,890,891,200],{},"Drag-and-Drop in ",[42,884,885],{},"Einstellungen → Verhalten"," einschalten (",[42,888,889],{},"Neu anordnen erlauben","). Dann Sounds und Gruppen ziehen. Neu anordnen gilt bei ",[42,892,853],{},[31,894,896],{"id":895},"mehrfachauswahl","Mehrfachauswahl",[14,898,899,901],{},[42,900,896],{}," in der Navbar einschalten, dann:",[36,903,904,907,913,919],{},[39,905,906],{},"Klick toggelt einen Sound",[39,908,909,912],{},[42,910,911],{},"Shift+Klick"," wählt einen Bereich ab dem letzten Anker",[39,914,915,918],{},[42,916,917],{},"Rahmen"," auf leerem Board ziehen",[39,920,921],{},"Klick auf leeres Board (oder außerhalb) leert die Auswahl",[14,923,924,925,118,928,118,931,934,935,200],{},"Eine Sammelleiste zeigt die Anzahl plus ",[42,926,927],{},"Farbe",[42,929,930],{},"Zu Tab verschieben…",[42,932,933],{},"Löschen"," und ",[42,936,937],{},"Fertig",[14,939,940,941,944],{},"In der Mehrfachauswahl zeigt jeder Button einen ",[42,942,943],{},"8-Zeichen-ID-Chip",". Rechtsklick auf den Chip kopiert die ID.",[31,946,948],{"id":947},"lautstärke-pro-sound","Lautstärke pro Sound",[14,950,951,952,955,956,959],{},"Rechtsklick → ",[42,953,954],{},"Lautstärke",". Slider von 0 % bis 100 %. ",[42,957,958],{},"Doppelklick"," setzt auf 100 % zurück.",[14,961,962],{},"Das stapelt sich mit der Master-Ausgangslautstärke in den Einstellungen.",[31,964,966],{"id":965},"hotkeys-und-sound-ids","Hotkeys und Sound-IDs",[14,968,969,970,973],{},"Jeder Sound hat eine 8-stellige ID. Kopieren über das Button-Kontextmenü (",[42,971,972],{},"ID kopieren",") oder den Mehrfachauswahl-Chip.",[14,975,976,979,980,983],{},[42,977,978],{},"Einstellungen → Hotkeys",": Taste an eine Sound-ID binden. Globale Hotkeys sind optional. ",[42,981,982],{},"Hotkey zuweisen"," im Kontextmenü springt dorthin, ID vorausgefüllt.",[14,985,986,987,989],{},"Dieselbe ID nutzt ",[18,988,312],{"href":311}," zum Auslösen.",[31,991,993],{"id":992},"hintergrundbilder-und-farben","Hintergrundbilder und Farben",[14,995,996,997,1001],{},"Rechtsklick auf einen Sound: eigene Farben oder ein Hintergrundbild. Das ist getrennt vom ",[18,998,1000],{"href":999},"\u002Fdocs\u002Ftheme-editor","Theme Creator",", der das ganze Board gestaltet.",[14,1003,1004,1005,1008],{},"Der Picker ist ein Dialog ",[42,1006,1007],{},"Hintergrundbild"," (PNG, JPEG, GIF, WebP):",[36,1010,1011,1017,1027],{},[39,1012,1013,1016],{},[42,1014,1015],{},"Lokale Dateien"," — Ordner hinzufügen, einzelne Datei wählen, Dateinamen suchen, Rastervorschau, Ordner aus der Bibliothek entfernen",[39,1018,1019,1022,1023,200],{},[42,1020,1021],{},"GifSnap"," — GIFs online suchen, ohne API-Key. Beim ersten Besuch musst du GifSnap-Anfragen akzeptieren; Suchergebnisse werden gecacht, um Traffic zu sparen. Siehe ",[18,1024,1021],{"href":1025,"rel":1026},"https:\u002F\u002Fgifsnap.com",[27],[39,1028,1029,1032,1033,1035],{},[42,1030,1031],{},"KLIPY"," — GIFs online suchen. Eigenen API-Key unter ",[42,1034,885],{},". Der Key landet nicht in Projektdateien.",[14,1037,1038],{},"Nach der Wahl Bild auf dem Button schieben und zuschneiden.",{"title":158,"searchDepth":176,"depth":176,"links":1040},[1041,1042,1043,1048,1049,1050,1051,1052,1053],{"id":667,"depth":176,"text":668},{"id":704,"depth":176,"text":705},{"id":738,"depth":176,"text":739,"children":1044},[1045,1046,1047],{"id":753,"depth":646,"text":754},{"id":788,"depth":646,"text":789},{"id":798,"depth":646,"text":799},{"id":