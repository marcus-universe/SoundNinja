und GTK-Pakete. Unter Debian\u002FUbuntu meist ",[102,113,114],{},"libwebkit2gtk",", ",[102,117,118],{},"libgtk-3-0"," und eine App-Indicator-Bibliothek.",[31,121,123],{"id":122},"updates","Updates",[14,125,126,127,130],{},"In der App: ",[42,128,129],{},"Hilfe → Nach Updates suchen",". Optional prüft SoundNinja beim Start in den Einstellungen.",[31,132,134],{"id":133},"aus-dem-quellcode-bauen","Aus dem Quellcode bauen",[14,136,137,138,115,143,148],{},"Eigenen Build? ",[18,139,142],{"href":140,"rel":141},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja",[27],"Repo klonen",[18,144,147],{"href":145,"rel":146},"https:\u002F\u002Fv2.tauri.app\u002Fstart\u002Fprerequisites\u002F",[27],"Tauri-Voraussetzungen"," installieren, dann:",[150,151,156],"pre",{"className":152,"code":153,"language":154,"meta":155,"style":155},"language-bash shiki shiki-themes github-light github-dark","bun install\nbun run tauri:serve\n","bash","",[102,157,158,171],{"__ignoreMap":155},[159,160,163,167],"span",{"class":161,"line":162},"line",1,[159,164,166],{"class":165},"sScJk","bun",[159,168,170],{"class":169},"sZZnC"," install\n",[159,172,174,176,179],{"class":161,"line":173},2,[159,175,166],{"class":165},[159,177,178],{"class":169}," run",[159,180,181],{"class":169}," tauri:serve\n",[14,183,184,115,187,45,190,193,194,197],{},[102,185,186],{},"npm",[102,188,189],{},"pnpm",[102,191,192],{},"deno"," gehen auch. Produktionsbuild: ",[102,195,196],{},"bun run tauri:build",".",[199,200,201],"style",{},"html pre.shiki code .sScJk, html code.shiki .sScJk{--shiki-default:#6F42C1;--shiki-dark:#B392F0}html pre.shiki code .sZZnC, html code.shiki .sZZnC{--shiki-default:#032F62;--shiki-dark:#9ECBFF}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html.dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}",{"title":155,"searchDepth":173,"depth":173,"links":203},[204,205,206,207,208],{"id":33,"depth":173,"text":34},{"id":61,"depth":173,"text":62},{"id":82,"depth":173,"text":83},{"id":122,"depth":173,"text":123},{"id":133,"depth":173,"text":134},"SoundNinja unter Windows, macOS oder Linux installieren.","md",{},true,"\u002Finstallation",{"title":5,"description":209},"Djt_phX5yPzPpgqthAHl5cQnHy-U9ban07ufeARjtGI",[217,337,458,604,757,892,1035,1258],{"id":218,"title":219,"body":220,"description":331,"extension":210,"meta":332,"navigation":212,"order":162,"path":333,"seo":334,"stem":335,"__hash__":336},"content_de\u002Foverview.md","Überblick",{"type":7,"value":221,"toc":325},[222,225,228,231,234,238,252,256,287,291,300,304],[10,223,219],{"id":224},"überblick",[14,226,227],{},"SoundNinja ist ein Open-Source-Soundboard für Livestreams, Chats mit Freunden und Podcast-Aufnahmen. Es läuft auf Tauri v2 und Nuxt 4 und bleibt dabei sparsam mit RAM und Speicherplatz.",[14,229,230],{},"Das Ziel: eine große Sound-Bibliothek schnell scannen und den richtigen Clip in Millisekunden abspielen. Die Oberfläche eignet sich auch als Dashboard in VR.",[14,232,233],{},"SoundNinja steckt noch in der frühen Entwicklung. Funktionen laufen, aber nicht jede Plattform ist vollständig getestet.",[31,235,237],{"id":236},"für-wen","Für wen",[36,239,240,243,246,249],{},[39,241,242],{},"Streamer, die sofortige Sound-Cues brauchen",[39,244,245],{},"Freunde, die ein gemeinsames Board für Voice-Chat wollen",[39,247,248],{},"Podcaster, die Clips aufnehmen und aufs Board legen",[39,250,251],{},"Alle, die ein anpassbares, lokales Soundboard wollen",[31,253,255],{"id":254},"was-du-tun-kannst","Was du tun kannst",[36,257,258,261,264,267,270,273,281,284],{},[39,259,260],{},"Ein Soundboard aus eigenen Audiodateien bauen",[39,262,263],{},"Sounds in farbigen Tabs, Gruppen und über die Suche sortieren",[39,265,266],{},"Das Aussehen mit dem Theme Creator gestalten",[39,268,269],{},"PC-Audio oder Mikrofon im Record Editor aufnehmen",[39,271,272],{},"Hotkeys einzelnen Sounds zuweisen",[39,274,275,276,280],{},"Sounds über ",[18,277,279],{"href":278},"\u002Fdocs\u002Fremote-control","Bitfocus Companion"," auslösen",[39,282,283],{},"Ein komplettes Soundboard importieren und exportieren",[39,285,286],{},"GIFs oder Bilder auf Sound-Buttons legen",[31,288,290],{"id":289},"lizenz","Lizenz",[14,292,293,294,299],{},"SoundNinja ist freie Software unter ",[18,295,298],{"href":296,"rel":297},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fblob\u002Fmain\u002FLICENSE",[27],"GPL-3.0",". Forken, ändern, teilen.",[31,301,303],{"id":302},"nächste-schritte","Nächste Schritte",[305,306,307,313,319],"ol",{},[39,308,309],{},[18,310,312],{"href":311},"\u002Fdocs\u002Finstallation","SoundNinja installieren",[39,314,315],{},[18,316,318],{"href":317},"\u002Fdocs\u002Fadding-sounds","Sounds hinzufügen",[39,320,321],{},[18,322,324],{"href":323},"\u002Fdocs\u002Forganizing-sounds","Board organisieren",{"title":155,"searchDepth":173,"depth":173,"links":326},[327,328,329,330],{"id":236,"depth":173,"text":237},{"id":254,"depth":173,"text":255},{"id":289,"depth":173,"text":290},{"id":302,"depth":173,"text":303},"Was SoundNinja ist und was du damit machen kannst.",{},"\u002Foverview",{"title":219,"description":331},"overview","k9vdLuByV0_2FJs4S1c2pJgDzzqDtddQcqK9KQYpZ8M",{"id":4,"title":5,"body":338,