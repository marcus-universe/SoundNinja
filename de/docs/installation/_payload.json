[{"data":1,"prerenderedAt":1652},["ShallowReactive",2],{"docs-page-de-\u002Finstallation":3,"docs-nav-de":240},{"id":4,"title":5,"body":6,"description":233,"extension":234,"meta":235,"navigation":236,"order":176,"path":237,"seo":238,"stem":12,"__hash__":239},"content_de\u002Finstallation.md","Installation",{"type":7,"value":8,"toc":226},"minimark",[9,13,30,35,59,62,66,80,83,87,112,123,127,134,138,152,185,201,222],[10,11,5],"h1",{"id":12},"installation",[14,15,16,17,22,23,29],"p",{},"Hol dir einen Build von der ",[18,19,21],"a",{"href":20},"\u002Fdownload","Download-Seite"," oder von ",[18,24,28],{"href":25,"rel":26},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Freleases\u002Flatest",[27],"nofollow","GitHub Releases",". SoundNinja ist in früher Entwicklung — behandle Builds als Beta.",[31,32,34],"h2",{"id":33},"windows","Windows",[36,37,38,50,53,56],"ul",{},[39,40,41,45,46,49],"li",{},[42,43,44],"strong",{},"Installer (.exe)"," oder ",[42,47,48],{},"MSI (.msi)"," für 64-Bit-Windows",[39,51,52],{},"Landing-Page-Ziel: Windows 10 und neuer",[39,54,55],{},"Die App-README nennt auch Windows 8 und höher",[39,57,58],{},"Der NSIS-Installer ist dunkel. Sprache beim Setup wählen — SoundNinja merkt sie beim nächsten Start.",[14,60,61],{},"Installer starten, dann SoundNinja über das Startmenü öffnen.",[31,63,65],{"id":64},"macos","macOS",[36,67,68,74,77],{},[39,69,70,73],{},[42,71,72],{},"Universelles .dmg"," für Apple Silicon und Intel",[39,75,76],{},"Landing-Page-Ziel: macOS 10.14 und neuer",[39,78,79],{},"Die App-README nennt macOS 10.15 und höher",[14,81,82],{},"Disk-Image öffnen und SoundNinja nach Programme ziehen.",[31,84,86],{"id":85},"linux","Linux",[36,88,89,95,101,109],{},[39,90,91,94],{},[42,92,93],{},"Debian (.deb)"," für Ubuntu \u002F Debian",[39,96,97,100],{},[42,98,99],{},"AppImage"," für andere Distros",[39,102,103,104,108],{},"Nach Veröffentlichung einer Release können Arch-Nutzer ",[105,106,107],"code",{},"soundninja-bin"," aus dem AUR installieren",[39,110,111],{},"Getestet unter Ubuntu 20.04",[14,113,114,115,118,119,122],{},"Desktop-Builds brauchen WebKit- und GTK-Pakete. Unter Debian\u002FUbuntu meist ",[105,116,117],{},"libwebkit2gtk",", ",[105,120,121],{},"libgtk-3-0"," und eine App-Indicator-Bibliothek.",[31,124,126],{"id":125},"updates","Updates",[14,128,129,130,133],{},"In der App: ",[42,131,132],{},"Hilfe → Nach Updates suchen",". Optional prüft SoundNinja beim Start in den Einstellungen.",[31,135,137],{"id":136},"aus-dem-quellcode-bauen","Aus dem Quellcode bauen",[14,139,140,141,118,146,151],{},"Eigenen Build? ",[18,142,145],{"href":143,"rel":144},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja",[27],"Repo klonen",[18,147,150],{"href":148,"rel":149},"https:\u002F\u002Fv2.tauri.app\u002Fstart\u002Fprerequisites\u002F",[27],"Tauri-Voraussetzungen"," installieren, dann:",[153,154,159],"pre",{"className":155,"code":156,"language":157,"meta":158,"style":158},"language-bash shiki shiki-themes github-light github-dark","bun install\nbun run tauri:serve\n","bash","",[105,160,161,174],{"__ignoreMap":158},[162,163,166,170],"span",{"class":164,"line":165},"line",1,[162,167,169],{"class":168},"sScJk","bun",[162,171,173],{"class":172},"sZZnC"," install\n",[162,175,177,179,182],{"class":164,"line":176},2,[162,178,169],{"class":168},[162,180,181],{"class":172}," run",[162,183,184],{"class":172}," tauri:serve\n",[14,186,187,118,190,45,193,196,197,200],{},[105,188,189],{},"npm",[105,191,192],{},"pnpm",[105,194,195],{},"deno"," gehen auch. Produktionsbuild: ",[105,198,199],{},"bun run tauri:build",".",[14,202,203,206,207,212,213,216,217,200],{},[42,204,205],{},"Nur Windows:"," jeder Windows-Compile enthält ASIO über das ",[18,208,211],{"href":209,"rel":210},"https:\u002F\u002Fwww.steinberg.net\u002Fasiosdk",[27],"Steinberg ASIO SDK",". Einmal ",[105,214,215],{},"bun run setup:asio"," (SDK nicht im Git). Linux und macOS nutzen PipeWire \u002F Core Audio — diesen Schritt überspringen. Details: ",[18,218,221],{"href":219,"rel":220},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fblob\u002Fmain\u002Fdocs\u002Fbuild-from-source.md",[27],"build-from-source.md",[223,224,225],"style",{},"html pre.shiki code .sScJk, html code.shiki .sScJk{--shiki-default:#6F42C1;--shiki-dark:#B392F0}html pre.shiki code .sZZnC, html code.shiki .sZZnC{--shiki-default:#032F62;--shiki-dark:#9ECBFF}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html.dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}",{"title":158,"searchDepth":176,"depth":176,"links":227},[228,229,230,231,232],{"id":33,"depth":176,"text":34},{"id":64,"depth":176,"text":65},{"id":85,"depth":176,"text":86},{"id":125,"depth":176,"text":126},{"id":136,"depth":176,"text":137},"SoundNinja unter Windows, macOS oder Linux installieren.","md",{},true,"\u002Finstallation",{"title":5,"description":233},"OPh-0WbR2ebU9niw-poNeR6zaGWqUJm2ONgxhb61JBU",[241,370,505,651,1051,1185,1332,1555],{"id":242,"title":243,"body":244,"description":364,"extension":234,"meta":365,"navigation":236,"order":165,"path":366,"seo":367,"stem":368,"__hash__":369},"content_de\u002Foverview.md","Überblick",{"type":7,"value":245,"toc":358},[246,249,252,255,258,262,276,280,320,324,333,337],[10,247,243],{"id":248},"überblick",[14,250,251],{},"SoundNinja ist ein Open-Source-Soundboard für Livestreams, Chats mit Freunden und Podcast-Aufnahmen. Es läuft auf Tauri v2 und Nuxt 4 und bleibt dabei sparsam mit RAM und Speicherplatz.",[14,253,254],{},"Das Ziel: eine große Sound-Bibliothek schnell scannen und den richtigen Clip in Millisekunden abspielen. Die Oberfläche eignet sich auch als Dashboard in VR.",[14,256,257],{},"SoundNinja steckt noch in der frühen Entwicklung. Funktionen laufen, aber nicht jede Plattform ist vollständig getestet.",[31,259,261],{"id":260},"für-wen","Für wen",[36,263,264,267,270,273],{},[39,265,266],{},"Streamer, die sofortige Sound-Cues brauchen",[39,268,269],{},"Freunde, die ein gemeinsames Board für Voice-Chat wollen",[39,271,272],{},"Podcaster, die Clips aufnehmen und aufs Board legen",[39,274,275],{},"Alle, die ein anpassbares, lokales Soundboard wollen",[31,277,279],{"id":278},"was-du-tun-kannst","Was du tun kannst",[36,281,282,285,288,291,294,297,300,303,306,314,317],{},[39,283,284],{},"Ein Soundboard aus eigenen Audiodateien bauen",[39,286,287],{},"Sounds in farbigen Tabs, Gruppen, Tags und über die Suche sortieren",[39,289,290],{},"Nach Tags filtern (ODER) und nach Name, Datum, Dauer oder Größe sortieren",[39,292,293],{},"Mehrfachauswahl mit Rahmen oder Shift-Bereich, dann Farbe, Tab oder Löschen in einem Rutsch",[39,295,296],{},"Lautstärke pro Sound im Kontextmenü setzen",[39,298,299],{},"Das Aussehen mit dem Theme Creator gestalten",[39,301,302],{},"PC-Audio oder Mikrofon im Record Editor aufnehmen",[39,304,305],{},"Hotkeys einzelnen Sounds zuweisen",[39,307,308,309,313],{},"Sounds über ",[18,310,312],{"href":311},"\u002Fdocs\u002Fremote-control","Bitfocus Companion"," auslösen",[39,315,316],{},"Ein komplettes Soundboard importieren und exportieren",[39,318,319],{},"GIFs oder Bilder auf Sound-Buttons legen — aus lokaler Ordnerbibliothek oder KLIPY",[31,321,323],{"id":322},"lizenz","Lizenz",[14,325,326,327,332],{},"SoundNinja ist freie Software unter ",[18,328,331],{"href":329,"rel":330},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fblob\u002Fmain\u002FLICENSE",[27],"GPL-3.0",". Forken, ändern, teilen.",[31,334,336],{"id":335},"nächste-schritte","Nächste Schritte",[338,339,340,346,352],"ol",{},[39,341,342],{},[18,343,345],{"href":344},"\u002Fdocs\u002Finstallation","SoundNinja installieren",[39,347,348],{},[18,349,351],{"href":350},"\u002Fdocs\u002Fadding-sounds","Sounds hinzufügen",[39,353,354],{},[18,355,357],{"href":356},"\u002Fdocs\u002Forganizing-sounds","Board organisieren",{"title":158,"searchDepth":176,"depth":176,"links":359},[360,361,362,363],{"id":260,"depth":176,"text":261},{"id":278,"depth":176,"text":279},{"id":322,"depth":176,"text":323},{"id":335,"depth":176,"text":336},"Was SoundNinja ist und was du damit machen kannst.",{},"\u002Foverview",{"title":243,"description":364},"overview","hoyfMBw8UK5RuLBAbdnmSxP4gC163p8E8rvJgSihSXE",{"id":4,"title":5,"body":371,"description":233,"extension":234,"meta":503,"navigation":236,"order":176,"path":237,"seo":504,"stem":12,"__hash__":239},{"type":7,"value":372,"toc":496},[373,375,382,384,398,400,402,412,414,416,432,438,440,444,446,454,472,482,494],[10,374,5],{"id":12},[14,376,16,377,22,379,29],{},[18,378,21],{"href":20},[18,380,28],{"href":25,"rel":381},[27],[31,383,34],{"id":33},[36,385,386,392,394,396],{},[39,387,388,45,390,49],{},[42,389,44],{},[42,391,48],{},[39,393,52],{},[39,395,55],{},[39,397,58],{},[14,399,61],{},[31,401,65],{"id":64},[36,403,404,408,410],{},[39,405,406,73],{},[42,407,72],{},[39,409,76],{},[39,411,79],{},[14,413,82],{},[31,415,86],{"id":85},[36,417,418,422,426,430],{},[39,419,420,94],{},[42,421,93],{},[39,423,424,100],{},[42,425,99],{},[39,427,103,428,108],{},[105,429,107],{},[39,431,111],{},[14,433,114,434,118,436,122],{},[105,435,117],{},[105,437,121],{},[31,439,126],{"id":125},[14,441,129,442,133],{},[42,443,132],{},[31,445,137],{"id":136},[14,447,140,448,118,451,151],{},[18,449,145],{"href":143,"rel":450},[27],[18,452,150],{"href":148,"rel":453},[27],[153,455,456],{"className":155,"code":156,"language":157,"meta":158,"style":158},[105,457,458,464],{"__ignoreMap":158},[162,459,460,462],{"class":164,"line":165},[162,461,169],{"class":168},[162,463,173],{"class":172},[162,465,466,468,470],{"class":164,"line":176},[162,467,169],{"class":168},[162,469,181],{"class":172},[162,471,184],{"class":172},[14,473,474,118,476,45,478,196,480,200],{},[105,475,189],{},[105,477,192],{},[105,479,195],{},[105,481,199],{},[14,483,484,206,486,212,489,216,491,200],{},[42,485,205],{},[18,487,211],{"href":209,"rel":488},[27],[105,490,215],{},[18,492,221],{"href":219,"rel":493},[27],[223,495,225],{},{"title":158,"searchDepth":176,"depth":176,"links":497},[498,499,500,501,502],{"id":33,"depth":176,"text":34},{"id":64,"depth":176,"text":65},{"id":85,"depth":176,"text":86},{"id":125,"depth":176,"text":126},{"id":136,"depth":176,"text":137},{},{"title":5,"description":233},{"id":506,"title":351,"body":507,"description":644,"extension":234,"meta":645,"navigation":236,"order":646,"path":647,"seo":648,"stem":649,"__hash__":650},"content_de\u002Fadding-sounds.md",{"type":7,"value":508,"toc":636},[509,512,515,519,536,540,571,575,594,598,612,615,619,626,630],[10,510,351],{"id":511},"sounds-hinzufügen",[14,513,514],{},"Ein Board bleibt leer, bis du Clips hinzufügst. SoundNinja importiert Dateien, ganze Ordner, eine Aufnahme oder ein geteiltes Soundboard-Paket.",[31,516,518],{"id":517},"audiodateien-importieren","Audiodateien importieren",[338,520,521,530,533],{},[39,522,523,45,526,529],{},[42,524,525],{},"Datei → Audiodateien importieren",[42,527,528],{},"Import"," in der Navbar.",[39,531,532],{},"Eine oder mehrere Audiodateien wählen.",[39,534,535],{},"Sounds landen im aktuellen Tab.",[31,537,539],{"id":538},"ordner-importieren","Ordner importieren",[338,541,542,551,554],{},[39,543,544,547,548,550],{},[42,545,546],{},"Datei → Ordner importieren"," (oder ",[42,549,539],{}," in der Navbar).",[39,552,553],{},"Einen oder mehrere Ordner hinzufügen. Vor dem Import per Drag neu sortieren.",[39,555,556,557],{},"Ziel wählen:\n",[36,558,559,565],{},[39,560,561,564],{},[42,562,563],{},"Als Tabs importieren"," — jeder Ordner wird ein eigener Tab",[39,566,567,570],{},[42,568,569],{},"In aktuellen Tab importieren"," — alle Dateien landen im aktiven Tab",[31,572,574],{"id":573},"clip-aufnehmen","Clip aufnehmen",[14,576,577,578,582,583,586,587,45,590,593],{},"Öffne den ",[18,579,581],{"href":580},"\u002Fdocs\u002Frecording-editor","Record Editor"," über ",[42,584,585],{},"Aufnahme"," in der Player-Leiste. Aufnehmen, zuschneiden, dann ",[42,588,589],{},"Auswahl importieren",[42,591,592],{},"Alle importieren"," in den aktuellen Tab oder einen gewählten Tab.",[31,595,597],{"id":596},"soundboard-importieren","Soundboard importieren",[14,599,600,603,604,607,608,611],{},[42,601,602],{},"Datei → Soundboard importieren"," lädt ein geteiltes Paket. Pakete sind ein ",[105,605,606],{},".zip"," mit ",[105,609,610],{},"project.sninja"," plus Sounddateien. Danach Projekt öffnen und abspielen.",[14,613,614],{},"Du kannst mehrere Projekte (Profile) halten. Über den Projektwähler zwischen Boards wechseln.",[31,616,618],{"id":617},"fehlende-dateien-neu-verknüpfen","Fehlende Dateien neu verknüpfen",[14,620,621,622,625],{},"Wenn Audiodateien auf der Festplatte umziehen, zeigt SoundNinja ",[42,623,624],{},"Fehlende Sounddateien",". Einen Suchordner wählen und Clips neu verknüpfen.",[31,627,629],{"id":628},"weiter","Weiter",[14,631,632,633,200],{},"Tabs, Tags, Filter und Hotkeys: ",[18,634,635],{"href":356},"Sounds organisieren",{"title":158,"searchDepth":176,"depth":176,"links":637},[638,639,640,641,642,643],{"id":517,"depth":176,"text":518},{"id":538,"depth":176,"text":539},{"id":573,"depth":176,"text":574},{"id":596,"depth":176,"text":597},{"id":617,"depth":176,"text":618},{"id":628,"depth":176,"text":629},"Audio, Ordner, Aufnahmen und geteilte Soundboards importieren.",{},3,"\u002Fadding-sounds",{"title":351,"description":644},"adding-sounds","H_ls9_vOwDkgTWPkfe9bQz1A0XidUOmMFV4V2EJpYec",{"id":652,"title":635,"body":653,"description":1044,"extension":234,"meta":1045,"navigation":236,"order":1046,"path":1047,"seo":1048,"stem":1049,"__hash__":1050},"content_de\u002Forganizing-sounds.md",{"type":7,"value":654,"toc":1029},[655,658,665,669,695,702,706,709,723,730,736,740,750,755,786,790,796,800,834,840,844,847,873,876,880,893,897,902,922,938,945,949,960,963,967,974,984,990,994,1002,1009,1026],[10,656,635],{"id":657},"sounds-organisieren",[14,659,660,661,664],{},"SoundNinja ist für große Bibliotheken gebaut. ",[42,662,663],{},"Tags und Filter",", Tabs, Suche, Mehrfachauswahl und Hotkeys — der Clip ist einen Klick (oder eine Taste) entfernt.",[31,666,668],{"id":667},"tabs","Tabs",[36,670,671,678,685],{},[39,672,673,674,677],{},"Tab mit ",[42,675,676],{},"Tab hinzufügen"," anlegen. Farbe vergeben, damit die Leiste schnell scannbar bleibt.",[39,679,680,681,684],{},"Die Ansicht ",[42,682,683],{},"Alle"," zeigt jeden Sound über alle Tabs.",[39,686,687,688,691,692,200],{},"Ein Sound kann ",[42,689,690],{},"einem oder mehreren Tabs"," gehören. Rechtsklick → ",[42,693,694],{},"Zu Tab verschieben",[14,696,697,698,701],{},"Tab-Übergänge: ",[42,699,700],{},"Einstellungen → Allgemein"," — Slide, Fade, Buttons nacheinander oder Keine.",[31,703,705],{"id":704},"gruppen","Gruppen",[14,707,708],{},"Seit v0.5.3 können Trenner zu benannten Gruppen werden:",[36,710,711,714,717,720],{},[39,712,713],{},"Gruppe über das Kontextmenü hinzufügen, umbenennen oder entfernen",[39,715,716],{},"Gruppenkopf ziehen — Kinder kommen mit",[39,718,719],{},"Sounds in eine Gruppe legen oder herausnehmen",[39,721,722],{},"Rahmenfarbe, Namensfarbe und Button-Ausrichtung setzen (oder Tab-Standard nutzen)",[14,724,725,726,729],{},"Ein einfacher ",[42,727,728],{},"Trenner"," geht weiter, wenn du nur einen visuellen Bruch brauchst.",[14,731,732,733,200],{},"Rechtsklick auf leeren Board-Bereich: ",[42,734,735],{},"Gruppe hinzufügen",[31,737,739],{"id":738},"tags-filter","Tags \u002F Filter",[14,741,742,743,746,747,749],{},"Tags gelten tabübergreifend. Das ausfahrbare ",[42,744,745],{},"Filter","-Panel (Sidebar ",[42,748,745],{},") ist der Ort zum Anlegen und zum Filtern des Boards.",[751,752,754],"h3",{"id":753},"tags-anlegen-und-bearbeiten","Tags anlegen und bearbeiten",[338,756,757,762,773,779],{},[39,758,759,761],{},[42,760,745],{}," in der Sidebar öffnen.",[39,763,764,765,768,769,772],{},"Unter ",[42,766,767],{},"Tags"," → ",[42,770,771],{},"Tag hinzufügen"," — Name und Farbe vergeben.",[39,774,775,776,200],{},"Im selben Panel umbenennen, umfärben oder ",[42,777,778],{},"Tag löschen",[39,780,781,782,785],{},"Steht da ",[42,783,784],{},"Noch keine Tags",", zuerst hier einen anlegen, bevor du zuweist.",[751,787,789],{"id":788},"tags-an-sounds-hängen","Tags an Sounds hängen",[14,791,792,793,795],{},"Rechtsklick auf einen Sound → ",[42,794,767],{}," (Checkboxen). Ein Sound darf mehrere Tags haben. Existieren noch keine, zeigt das Menü den Weg zum Filter-Panel.",[751,797,799],{"id":798},"board-filtern","Board filtern",[36,801,802,809,820,831],{},[39,803,804,805,808],{},"Tags im Filter-Panel oder als ",[42,806,807],{},"Chips unter der Suchleiste"," umschalten.",[39,810,811,812,815,816,819],{},"Abgleich ist ",[42,813,814],{},"ODER",": ein Sound bleibt sichtbar, wenn er ",[42,817,818],{},"irgendeinen"," gewählten Tag hat.",[39,821,822,823,826,827,830],{},"Das Feld ",[42,824,825],{},"Suche"," in der Navbar kombiniert per ",[42,828,829],{},"UND"," mit dem aktiven Tag-Filter (Tippen + Tags zusammen).",[39,832,833],{},"Chips aus (oder Filter leeren), um den ganzen Tab wieder zu sehen.",[14,835,836,837,200],{},"Farbige Tag-Namen können auf Buttons erscheinen. Schalter: ",[42,838,839],{},"Einstellungen → Verhalten → Tag-Badges anzeigen",[31,841,843],{"id":842},"sortierung","Sortierung",[14,845,846],{},"Im Filter-Panel eine Sortierung wählen:",[36,848,849,855],{},[39,850,851,854],{},[42,852,853],{},"Benutzerdefiniert"," — deine Tab-Reihenfolge, Gruppen sichtbar",[39,856,857,118,860,118,863,45,866,869,870],{},[42,858,859],{},"Name",[42,861,862],{},"Hinzugefügt",[42,864,865],{},"Spielzeit",[42,867,868],{},"Dateigröße"," — flache sortierte Liste; ",[42,871,872],{},"Gruppen sind ausgeblendet",[14,874,875],{},"Sortierung nach Dauer kann beim ersten Mal die Dauer-Metadaten vorwärmen.",[31,877,879],{"id":878},"neu-anordnen","Neu anordnen",[14,881,882,883,886,887,890,891,200],{},"Drag-and-Drop in ",[42,884,885],{},"Einstellungen → Verhalten"," einschalten (",[42,888,889],{},"Neu anordnen erlauben","). Dann Sounds und Gruppen ziehen. Neu anordnen gilt bei ",[42,892,853],{},[31,894,896],{"id":895},"mehrfachauswahl","Mehrfachauswahl",[14,898,899,901],{},[42,900,896],{}," in der Navbar einschalten, dann:",[36,903,904,907,913,919],{},[39,905,906],{},"Klick toggelt einen Sound",[39,908,909,912],{},[42,910,911],{},"Shift+Klick"," wählt einen Bereich ab dem letzten Anker",[39,914,915,918],{},[42,916,917],{},"Rahmen"," auf leerem Board ziehen",[39,920,921],{},"Klick auf leeres Board (oder außerhalb) leert die Auswahl",[14,923,924,925,118,928,118,931,934,935,200],{},"Eine Sammelleiste zeigt die Anzahl plus ",[42,926,927],{},"Farbe",[42,929,930],{},"Zu Tab verschieben…",[42,932,933],{},"Löschen"," und ",[42,936,937],{},"Fertig",[14,939,940,941,944],{},"In der Mehrfachauswahl zeigt jeder Button einen ",[42,942,943],{},"8-Zeichen-ID-Chip",". Rechtsklick auf den Chip kopiert die ID.",[31,946,948],{"id":947},"lautstärke-pro-sound","Lautstärke pro Sound",[14,950,951,952,955,956,959],{},"Rechtsklick → ",[42,953,954],{},"Lautstärke",". Slider von 0 % bis 100 %. ",[42,957,958],{},"Doppelklick"," setzt auf 100 % zurück.",[14,961,962],{},"Das stapelt sich mit der Master-Ausgangslautstärke in den Einstellungen.",[31,964,966],{"id":965},"hotkeys-und-sound-ids","Hotkeys und Sound-IDs",[14,968,969,970,973],{},"Jeder Sound hat eine 8-stellige ID. Kopieren über das Button-Kontextmenü (",[42,971,972],{},"ID kopieren",") oder den Mehrfachauswahl-Chip.",[14,975,976,979,980,983],{},[42,977,978],{},"Einstellungen → Hotkeys",": Taste an eine Sound-ID binden. Globale Hotkeys sind optional. ",[42,981,982],{},"Hotkey zuweisen"," im Kontextmenü springt dorthin, ID vorausgefüllt.",[14,985,986,987,989],{},"Dieselbe ID nutzt ",[18,988,312],{"href":311}," zum Auslösen.",[31,991,993],{"id":992},"hintergrundbilder-und-farben","Hintergrundbilder und Farben",[14,995,996,997,1001],{},"Rechtsklick auf einen Sound: eigene Farben oder ein Hintergrundbild. Das ist getrennt vom ",[18,998,1000],{"href":999},"\u002Fdocs\u002Ftheme-editor","Theme Creator",", der das ganze Board gestaltet.",[14,1003,1004,1005,1008],{},"Der Picker ist ein Dialog ",[42,1006,1007],{},"Hintergrundbild"," (PNG, JPEG, GIF, WebP):",[36,1010,1011,1017],{},[39,1012,1013,1016],{},[42,1014,1015],{},"Lokale Dateien"," — Ordner hinzufügen, einzelne Datei wählen, Dateinamen suchen, Rastervorschau, Ordner aus der Bibliothek entfernen",[39,1018,1019,1022,1023,1025],{},[42,1020,1021],{},"KLIPY"," — GIFs online suchen. Eigenen API-Key unter ",[42,1024,885],{},". Der Key landet nicht in Projektdateien.",[14,1027,1028],{},"Nach der Wahl Bild auf dem Button schieben und zuschneiden.",{"title":158,"searchDepth":176,"depth":176,"links":1030},[1031,1032,1033,1038,1039,1040,1041,1042,1043],{"id":667,"depth":176,"text":668},{"id":704,"depth":176,"text":705},{"id":738,"depth":176,"text":739,"children":1034},[1035,1036,1037],{"id":753,"depth":646,"text":754},{"id":788,"depth":646,"text":789},{"id":798,"depth":646,"text":799},{"id":842,"depth":176,"text":843},{"id":878,"depth":176,"text":879},{"id":895,"depth":176,"text":896},{"id":947,"depth":176,"text":948},{"id":965,"depth":176,"text":966},{"id":992,"depth":176,"text":993},"Tags, Filter, Tabs, Gruppen, Sortierung, Mehrfachauswahl, Lautstärke und Hotkeys.",{},4,"\u002Forganizing-sounds",{"title":635,"description":1044},"organizing-sounds","phia_N7HDS6LIgxhltoa9iRYViBzJ00ngFayO7YKdtQ",{"id":1052,"title":1053,"body":1054,"description":1179,"extension":234,"meta":1180,"navigation":236,"order":1181,"path":1182,"seo":1183,"stem":1058,"__hash__":1184},"content_de\u002Ftheme-editor.md","Theme-Editor",{"type":7,"value":1055,"toc":1173},[1056,1059,1065,1069,1096,1099,1103,1117,1121,1147,1150,1154,1159],[10,1057,1053],{"id":1058},"theme-editor",[14,1060,1061,1062,200],{},"Der Theme Creator ist der volle visuelle Editor für dein Board. Öffnen über ",[42,1063,1064],{},"Einstellungen → Allgemein → Theme Creator",[31,1066,1068],{"id":1067},"drei-tabs","Drei Tabs",[338,1070,1071,1085,1091],{},[39,1072,1073,1076,1077,1080,1081,1084],{},[42,1074,1075],{},"Allgemein"," — Theme-Name, gemeinsame Farben und Schrift-Uploads (",[105,1078,1079],{},".ttf"," \u002F ",[105,1082,1083],{},".otf",")",[39,1086,1087,1090],{},[42,1088,1089],{},"Buttons"," — Farben, Typo, Layout und GIF-Overlay der Sound-Buttons",[39,1092,1093,1095],{},[42,1094,668],{}," — Farben, Typo und Rahmenstärke der Tab-Leiste",[14,1097,1098],{},"Eine Live-Vorschau zeigt Tabs und Buttons beim Bearbeiten.",[31,1100,1102],{"id":1101},"was-du-ändern-kannst","Was du ändern kannst",[36,1104,1105,1108,1111,1114],{},[39,1106,1107],{},"Primär- und Akzentfarben, Hintergründe, Button- und Tab-Farben",[39,1109,1110],{},"Schriftfamilie und -größe für Buttons und Tabs",[39,1112,1113],{},"Button-Breite, Radius, Rahmen, Abstände und Innenabstand",[39,1115,1116],{},"GIF-Overlay-Deckkraft (normal und Hover)",[31,1118,1120],{"id":1119},"speichern-und-teilen","Speichern und teilen",[36,1122,1123,1129,1135,1141],{},[39,1124,1125,1128],{},[42,1126,1127],{},".css exportieren"," — Theme-Datei sichern oder weitergeben",[39,1130,1131,1134],{},[42,1132,1133],{},"Zu Themes hinzufügen"," — in den Themes-Ordner speichern und anwenden",[39,1136,1137,1140],{},[42,1138,1139],{},".css importieren"," — Preset oder gespeichertes Theme laden",[39,1142,1143,1146],{},[42,1144,1145],{},"Zurücksetzen"," — SoundNinja-Standard wiederherstellen",[14,1148,1149],{},"Beim Schließen mit ungespeicherten Änderungen fragt SoundNinja nach.",[31,1151,1153],{"id":1152},"ohne-vollen-editor","Ohne vollen Editor",[14,1155,764,1156,1158],{},[42,1157,700],{}," kannst du trotzdem:",[36,1160,1161,1164,1170],{},[39,1162,1163],{},"Ein Theme aus der Liste wählen",[39,1165,1166,1167,1084],{},"CSS-Variablen live bearbeiten (",[42,1168,1169],{},"Eigenes CSS",[39,1171,1172],{},"Eine Theme-Datei in den Themes-Ordner importieren",{"title":158,"searchDepth":176,"depth":176,"links":1174},[1175,1176,1177,1178],{"id":1067,"depth":176,"text":1068},{"id":1101,"depth":176,"text":1102},{"id":1119,"depth":176,"text":1120},{"id":1152,"depth":176,"text":1153},"Farben, Schriften, Buttons und Tabs im Theme Creator gestalten.",{},5,"\u002Ftheme-editor",{"title":1053,"description":1179},"h6Hta3TDDcThnouY3Pk_Omvjq8Eb8knx-HIAvf5YZd8",{"id":1186,"title":1187,"body":1188,"description":1325,"extension":234,"meta":1326,"navigation":236,"order":1327,"path":1328,"seo":1329,"stem":1330,"__hash__":1331},"content_de\u002Frecording-editor.md","Aufnahme-Editor",{"type":7,"value":1189,"toc":1319},[1190,1193,1199,1203,1209,1229,1232,1236,1261,1265,1280,1284,1298,1309],[10,1191,1187],{"id":1192},"aufnahme-editor",[14,1194,1195,1196,1198],{},"Nimm einen Clip in SoundNinja auf, schneide ihn zu und importiere ihn in einen Tab. Öffnen über ",[42,1197,585],{}," in der Player-Leiste.",[31,1200,1202],{"id":1201},"eingang-wählen","Eingang wählen",[14,1204,764,1205,1208],{},[42,1206,1207],{},"Einstellungen → Audio",":",[36,1210,1211,1217,1223],{},[39,1212,1213,1216],{},[42,1214,1215],{},"Eingabegeräte"," — Mikrofon",[39,1218,1219,1222],{},[42,1220,1221],{},"Ausgabegeräte (PC-Audio)"," — Loopback dessen, was der PC spielt",[39,1224,1225,1228],{},[42,1226,1227],{},"Eingangslautstärke"," — Aufnahme-Gain von 0 % bis 200 %",[14,1230,1231],{},"Der Aufnahme-Button nutzt das hier gewählte Gerät.",[31,1233,1235],{"id":1234},"take-bearbeiten","Take bearbeiten",[36,1237,1238,1241,1244,1252,1255,1258],{},[39,1239,1240],{},"Aufnehmen und stoppen",[39,1242,1243],{},"Pegelmesser beobachten",[39,1245,1246,45,1249],{},[42,1247,1248],{},"Normalisieren",[42,1250,1251],{},"Rauschunterdrückung",[39,1253,1254],{},"Ganzen Clip trimmen, auf Auswahl trimmen oder Auswahl löschen",[39,1256,1257],{},"Rückgängig \u002F Wiederholen",[39,1259,1260],{},"Rein- und rauszoomen",[31,1262,1264],{"id":1263},"stagen-und-importieren","Stagen und importieren",[338,1266,1267,1270,1273],{},[39,1268,1269],{},"Auswahl oder ganzen Track zur Staging-Liste hinzufügen.",[39,1271,1272],{},"Die Liste startet leer: aufnehmen, bearbeiten, dann Clip hinzufügen.",[39,1274,1275,45,1277,1279],{},[42,1276,589],{},[42,1278,592],{}," in den aktuellen oder einen gewählten Tab.",[31,1281,1283],{"id":1282},"stem-trennung-optional","Stem-Trennung (optional)",[14,1285,1286,1287,1290,1291,45,1294,1297],{},"Offizielle Windows-, macOS- und Linux-Release-Builds enthalten das ",[42,1288,1289],{},"Stems","-Feature. Der Aufnahme-Editor kann ",[42,1292,1293],{},"Gesang",[42,1295,1296],{},"Musik"," mit BS-RoFormer behalten.",[14,1299,1300,1301,1304,1305,1308],{},"Das Modell ist etwa 158 MB und ",[42,1302,1303],{},"nicht"," im Installer. Download unter ",[42,1306,1307],{},"Einstellungen → Stem-Trennung"," oder über den Erststart-Hinweis. Der Windows-Installer kann den Download beim ersten Start anbieten.",[14,1310,1311,1312,1080,1315,1318],{},"Eigene Source-Builds brauchen extra Flags (",[105,1313,1314],{},"tauri:serve:stems",[105,1316,1317],{},"tauri:build:stems",").",{"title":158,"searchDepth":176,"depth":176,"links":1320},[1321,1322,1323,1324],{"id":1201,"depth":176,"text":1202},{"id":1234,"depth":176,"text":1235},{"id":1263,"depth":176,"text":1264},{"id":1282,"depth":176,"text":1283},"Mikrofon oder PC-Audio aufnehmen, den Clip bearbeiten und aufs Board legen.",{},6,"\u002Frecording-editor",{"title":11