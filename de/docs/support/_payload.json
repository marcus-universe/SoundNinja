[{"data":1,"prerenderedAt":1560},["ShallowReactive",2],{"docs-page-de-\u002Fsupport":3,"docs-nav-de":124},{"id":4,"title":5,"body":6,"description":116,"extension":117,"meta":118,"navigation":119,"order":120,"path":121,"seo":122,"stem":12,"__hash__":123},"content_de\u002Fsupport.md","Support",{"type":7,"value":8,"toc":107},"minimark",[9,13,17,22,25,34,46,50,57,61,78,82,96,100],[10,11,5],"h1",{"id":12},"support",[14,15,16],"p",{},"SoundNinja ist ein Community-Projekt in früher Beta. Der schnellste Weg zur Hilfe ist GitHub.",[18,19,21],"h2",{"id":20},"fehler-melden-oder-frage-stellen","Fehler melden oder Frage stellen",[14,23,24],{},"Issue auf GitHub öffnen:",[14,26,27],{},[28,29,33],"a",{"href":30,"rel":31},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fissues",[32],"nofollow","github.com\u002Fmarcus-universe\u002FSoundNinja\u002Fissues",[14,35,36,37,41,42,45],{},"OS, SoundNinja-Version (",[38,39,40],"strong",{},"Hilfe → Nach Updates suchen"," oder ",[38,43,44],{},"Einstellungen → Über",") und Schritte zum Nachstellen angeben.",[18,47,49],{"id":48},"e-mail","E-Mail",[14,51,52,53],{},"Maintainer: ",[28,54,56],{"href":55},"mailto:contact@marcus-universe.de","contact@marcus-universe.de",[18,58,60],{"id":59},"updates","Updates",[14,62,63,64,66,67,71,72,77],{},"In der App: ",[38,65,40],{},". Neue Builds stehen auch auf der ",[28,68,70],{"href":69},"\u002Fdownload","Download-Seite"," und bei ",[28,73,76],{"href":74,"rel":75},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Freleases",[32],"GitHub Releases",".",[18,79,81],{"id":80},"mitmachen","Mitmachen",[14,83,84,85,90,91,77],{},"Pull Requests sind willkommen. App-Repo: ",[28,86,89],{"href":87,"rel":88},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja",[32],"github.com\u002Fmarcus-universe\u002FSoundNinja",". Lizenz: ",[28,92,95],{"href":93,"rel":94},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fblob\u002Fmain\u002FLICENSE",[32],"GPL-3.0",[18,97,99],{"id":98},"rechtliches","Rechtliches",[14,101,102,103,77],{},"Impressum und Kontaktdaten: ",[28,104,106],{"href":105},"\u002Fimpressum","Impressum",{"title":108,"searchDepth":109,"depth":109,"links":110},"",2,[111,112,113,114,115],{"id":20,"depth":109,"text":21},{"id":48,"depth":109,"text":49},{"id":59,"depth":109,"text":60},{"id":80,"depth":109,"text":81},{"id":98,"depth":109,"text":99},"Hilfe holen und Fehler melden.","md",{},true,8,"\u002Fsupport",{"title":5,"description":116},"qmZ7_9BNf5fpANXNPb6fUhg4rtoDFCqMYJ7xVG2xHIM",[125,255,447,593,993,1127,1274,1496],{"id":126,"title":127,"body":128,"description":248,"extension":117,"meta":249,"navigation":119,"order":250,"path":251,"seo":252,"stem":253,"__hash__":254},"content_de\u002Foverview.md","Überblick",{"type":7,"value":129,"toc":242},[130,133,136,139,142,146,162,166,206,210,217,221],[10,131,127],{"id":132},"überblick",[14,134,135],{},"SoundNinja ist ein Open-Source-Soundboard für Livestreams, Chats mit Freunden und Podcast-Aufnahmen. Es läuft auf Tauri v2 und Nuxt 4 und bleibt dabei sparsam mit RAM und Speicherplatz.",[14,137,138],{},"Das Ziel: eine große Sound-Bibliothek schnell scannen und den richtigen Clip in Millisekunden abspielen. Die Oberfläche eignet sich auch als Dashboard in VR.",[14,140,141],{},"SoundNinja steckt noch in der frühen Entwicklung. Funktionen laufen, aber nicht jede Plattform ist vollständig getestet.",[18,143,145],{"id":144},"für-wen","Für wen",[147,148,149,153,156,159],"ul",{},[150,151,152],"li",{},"Streamer, die sofortige Sound-Cues brauchen",[150,154,155],{},"Freunde, die ein gemeinsames Board für Voice-Chat wollen",[150,157,158],{},"Podcaster, die Clips aufnehmen und aufs Board legen",[150,160,161],{},"Alle, die ein anpassbares, lokales Soundboard wollen",[18,163,165],{"id":164},"was-du-tun-kannst","Was du tun kannst",[147,167,168,171,174,177,180,183,186,189,192,200,203],{},[150,169,170],{},"Ein Soundboard aus eigenen Audiodateien bauen",[150,172,173],{},"Sounds in farbigen Tabs, Gruppen, Tags und über die Suche sortieren",[150,175,176],{},"Nach Tags filtern (ODER) und nach Name, Datum, Dauer oder Größe sortieren",[150,178,179],{},"Mehrfachauswahl mit Rahmen oder Shift-Bereich, dann Farbe, Tab oder Löschen in einem Rutsch",[150,181,182],{},"Lautstärke pro Sound im Kontextmenü setzen",[150,184,185],{},"Das Aussehen mit dem Theme Creator gestalten",[150,187,188],{},"PC-Audio oder Mikrofon im Record Editor aufnehmen",[150,190,191],{},"Hotkeys einzelnen Sounds zuweisen",[150,193,194,195,199],{},"Sounds über ",[28,196,198],{"href":197},"\u002Fdocs\u002Fremote-control","Bitfocus Companion"," auslösen",[150,201,202],{},"Ein komplettes Soundboard importieren und exportieren",[150,204,205],{},"GIFs oder Bilder auf Sound-Buttons legen — aus lokaler Ordnerbibliothek oder KLIPY",[18,207,209],{"id":208},"lizenz","Lizenz",[14,211,212,213,216],{},"SoundNinja ist freie Software unter ",[28,214,95],{"href":93,"rel":215},[32],". Forken, ändern, teilen.",[18,218,220],{"id":219},"nächste-schritte","Nächste Schritte",[222,223,224,230,236],"ol",{},[150,225,226],{},[28,227,229],{"href":228},"\u002Fdocs\u002Finstallation","SoundNinja installieren",[150,231,232],{},[28,233,235],{"href":234},"\u002Fdocs\u002Fadding-sounds","Sounds hinzufügen",[150,237,238],{},[28,239,241],{"href":240},"\u002Fdocs\u002Forganizing-sounds","Board organisieren",{"title":108,"searchDepth":109,"depth":109,"links":243},[244,245,246,247],{"id":144,"depth":109,"text":145},{"id":164,"depth":109,"text":165},{"id":208,"depth":109,"text":209},{"id":219,"depth":109,"text":220},"Was SoundNinja ist und was du damit machen kannst.",{},1,"\u002Foverview",{"title":127,"description":248},"overview","hoyfMBw8UK5RuLBAbdnmSxP4gC163p8E8rvJgSihSXE",{"id":256,"title":257,"body":258,"description":442,"extension":117,"meta":443,"navigation":119,"order":109,"path":444,"seo":445,"stem":262,"__hash__":446},"content_de\u002Finstallation.md","Installation",{"type":7,"value":259,"toc":435},[260,263,274,278,298,301,305,319,322,326,351,362,364,369,373,386,416,431],[10,261,257],{"id":262},"installation",[14,264,265,266,268,269,273],{},"Hol dir einen Build von der ",[28,267,70],{"href":69}," oder von ",[28,270,76],{"href":271,"rel":272},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Freleases\u002Flatest",[32],". SoundNinja ist in früher Entwicklung — behandle Builds als Beta.",[18,275,277],{"id":276},"windows","Windows",[147,279,280,289,292,295],{},[150,281,282,41,285,288],{},[38,283,284],{},"Installer (.exe)",[38,286,287],{},"MSI (.msi)"," für 64-Bit-Windows",[150,290,291],{},"Landing-Page-Ziel: Windows 10 und neuer",[150,293,294],{},"Die App-README nennt auch Windows 8 und höher",[150,296,297],{},"Der NSIS-Installer ist dunkel. Sprache beim Setup wählen — SoundNinja merkt sie beim nächsten Start.",[14,299,300],{},"Installer starten, dann SoundNinja über das Startmenü öffnen.",[18,302,304],{"id":303},"macos","macOS",[147,306,307,313,316],{},[150,308,309,312],{},[38,310,311],{},"Universelles .dmg"," für Apple Silicon und Intel",[150,314,315],{},"Landing-Page-Ziel: macOS 10.14 und neuer",[150,317,318],{},"Die App-README nennt macOS 10.15 und höher",[14,320,321],{},"Disk-Image öffnen und SoundNinja nach Programme ziehen.",[18,323,325],{"id":324},"linux","Linux",[147,327,328,334,340,348],{},[150,329,330,333],{},[38,331,332],{},"Debian (.deb)"," für Ubuntu \u002F Debian",[150,335,336,339],{},[38,337,338],{},"AppImage"," für andere Distros",[150,341,342,343,347],{},"Nach Veröffentlichung einer Release können Arch-Nutzer ",[344,345,346],"code",{},"soundninja-bin"," aus dem AUR installieren",[150,349,350],{},"Getestet unter Ubuntu 20.04",[14,352,353,354,357,358,361],{},"Desktop-Builds brauchen WebKit- und GTK-Pakete. Unter Debian\u002FUbuntu meist ",[344,355,356],{},"libwebkit2gtk",", ",[344,359,360],{},"libgtk-3-0"," und eine App-Indicator-Bibliothek.",[18,363,60],{"id":59},[14,365,63,366,368],{},[38,367,40],{},". Optional prüft SoundNinja beim Start in den Einstellungen.",[18,370,372],{"id":371},"aus-dem-quellcode-bauen","Aus dem Quellcode bauen",[14,374,375,376,357,380,385],{},"Eigenen Build? ",[28,377,379],{"href":87,"rel":378},[32],"Repo klonen",[28,381,384],{"href":382,"rel":383},"https:\u002F\u002Fv2.tauri.app\u002Fstart\u002Fprerequisites\u002F",[32],"Tauri-Voraussetzungen"," installieren, dann:",[387,388,392],"pre",{"className":389,"code":390,"language":391,"meta":108,"style":108},"language-bash shiki shiki-themes github-light github-dark","bun install\nbun run tauri:serve\n","bash",[344,393,394,406],{"__ignoreMap":108},[395,396,398,402],"span",{"class":397,"line":250},"line",[395,399,401],{"class":400},"sScJk","bun",[395,403,405],{"class":404},"sZZnC"," install\n",[395,407,408,410,413],{"class":397,"line":109},[395,409,401],{"class":400},[395,411,412],{"class":404}," run",[395,414,415],{"class":404}," tauri:serve\n",[14,417,418,357,421,41,424,427,428,77],{},[344,419,420],{},"npm",[344,422,423],{},"pnpm",[344,425,426],{},"deno"," gehen auch. Produktionsbuild: ",[344,429,430],{},"bun run tauri:build",[432,433,434],"style",{},"html pre.shiki code .sScJk, html code.shiki .sScJk{--shiki-default:#6F42C1;--shiki-dark:#B392F0}html pre.shiki code .sZZnC, html code.shiki .sZZnC{--shiki-default:#032F62;--shiki-dark:#9ECBFF}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html.dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}",{"title":108,"searchDepth":109,"depth":109,"links":436},[437,438,439,440,441],{"id":276,"depth":109,"text":277},{"id":303,"depth":109,"text":304},{"id":324,"depth":109,"text":325},{"id":59,"depth":109,"text":60},{"id":371,"depth":109,"text":372},"SoundNinja unter Windows, macOS oder Linux installieren.",{},"\u002Finstallation",{"title":257,"description":442},"r-3EUG7lGdfEJsGyve9-EQzSXP8-1Q3frBZ2lky4J_M",{"id":448,"title":235,"body":449,"description":586,"extension":117,"meta":587,"navigation":119,"order":588,"path":589,"seo":590,"stem":591,"__hash__":592},"content_de\u002Fadding-sounds.md",{"type":7,"value":450,"toc":578},[451,454,457,461,478,482,513,517,536,540,554,557,561,568,572],[10,452,235],{"id":453},"sounds-hinzufügen",[14,455,456],{},"Ein Board bleibt leer, bis du Clips hinzufügst. SoundNinja importiert Dateien, ganze Ordner, eine Aufnahme oder ein geteiltes Soundboard-Paket.",[18,458,460],{"id":459},"audiodateien-importieren","Audiodateien importieren",[222,462,463,472,475],{},[150,464,465,41,468,471],{},[38,466,467],{},"Datei → Audiodateien importieren",[38,469,470],{},"Import"," in der Navbar.",[150,473,474],{},"Eine oder mehrere Audiodateien wählen.",[150,476,477],{},"Sounds landen im aktuellen Tab.",[18,479,481],{"id":480},"ordner-importieren","Ordner importieren",[222,483,484,493,496],{},[150,485,486,489,490,492],{},[38,487,488],{},"Datei → Ordner importieren"," (oder ",[38,491,481],{}," in der Navbar).",[150,494,495],{},"Einen oder mehrere Ordner hinzufügen. Vor dem Import per Drag neu sortieren.",[150,497,498,499],{},"Ziel wählen:\n",[147,500,501,507],{},[150,502,503,506],{},[38,504,505],{},"Als Tabs importieren"," — jeder Ordner wird ein eigener Tab",[150,508,509,512],{},[38,510,511],{},"In aktuellen Tab importieren"," — alle Dateien landen im aktiven Tab",[18,514,516],{"id":515},"clip-aufnehmen","Clip aufnehmen",[14,518,519,520,524,525,528,529,41,532,535],{},"Öffne den ",[28,521,523],{"href":522},"\u002Fdocs\u002Frecording-editor","Record Editor"," über ",[38,526,527],{},"Aufnahme"," in der Player-Leiste. Aufnehmen, zuschneiden, dann ",[38,530,531],{},"Auswahl importieren",[38,533,534],{},"Alle importieren"," in den aktuellen Tab oder einen gewählten Tab.",[18,537,539],{"id":538},"soundboard-importieren","Soundboard importieren",[14,541,542,545,546,549,550,553],{},[38,543,544],{},"Datei → Soundboard importieren"," lädt ein geteiltes Paket. Pakete sind ein ",[344,547,548],{},".zip"," mit ",[344,551,552],{},"project.sninja"," plus Sounddateien. Danach Projekt öffnen und abspielen.",[14,555,556],{},"Du kannst mehrere Projekte (Profile) halten. Über den Projektwähler zwischen Boards wechseln.",[18,558,560],{"id":559},"fehlende-dateien-neu-verknüpfen","Fehlende Dateien neu verknüpfen",[14,562,563,564,567],{},"Wenn Audiodateien auf der Festplatte umziehen, zeigt SoundNinja ",[38,565,566],{},"Fehlende Sounddateien",". Einen Suchordner wählen und Clips neu verknüpfen.",[18,569,571],{"id":570},"weiter","Weiter",[14,573,574,575,77],{},"Tabs, Tags, Filter und Hotkeys: ",[28,576,577],{"href":240},"Sounds organisieren",{"title":108,"searchDepth":109,"depth":109,"links":579},[580,581,582,583,584,585],{"id":459,"depth":109,"text":460},{"id":480,"depth":109,"text":481},{"id":515,"depth":109,"text":516},{"id":538,"depth":109,"text":539},{"id":559,"depth":109,"text":560},{"id":570,"depth":109,"text":571},"Audio, Ordner, Aufnahmen und geteilte Soundboards importieren.",{},3,"\u002Fadding-sounds",{"title":235,"description":586},"adding-sounds","H_ls9_vOwDkgTWPkfe9bQz1A0XidUOmMFV4V2EJpYec",{"id":594,"title":577,"body":595,"description":986,"extension":117,"meta":987,"navigation":119,"order":988,"path":989,"seo":990,"stem":991,"__hash__":992},"content_de\u002Forganizing-sounds.md",{"type":7,"value":596,"toc":971},[597,600,607,611,637,644,648,651,665,672,678,682,692,697,728,732,738,742,776,782,786,789,815,818,822,835,839,844,864,880,887,891,902,905,909,916,926,932,936,944,951,968],[10,598,577],{"id":599},"sounds-organisieren",[14,601,602,603,606],{},"SoundNinja ist für große Bibliotheken gebaut. ",[38,604,605],{},"Tags und Filter",", Tabs, Suche, Mehrfachauswahl und Hotkeys — der Clip ist einen Klick (oder eine Taste) entfernt.",[18,608,610],{"id":609},"tabs","Tabs",[147,612,613,620,627],{},[150,614,615,616,619],{},"Tab mit ",[38,617,618],{},"Tab hinzufügen"," anlegen. Farbe vergeben, damit die Leiste schnell scannbar bleibt.",[150,621,622,623,626],{},"Die Ansicht ",[38,624,625],{},"Alle"," zeigt jeden Sound über alle Tabs.",[150,628,629,630,633,634,77],{},"Ein Sound kann ",[38,631,632],{},"einem oder mehreren Tabs"," gehören. Rechtsklick → ",[38,635,636],{},"Zu Tab verschieben",[14,638,639,640,643],{},"Tab-Übergänge: ",[38,641,642],{},"Einstellungen → Allgemein"," — Slide, Fade, Buttons nacheinander oder Keine.",[18,645,647],{"id":646},"gruppen","Gruppen",[14,649,650],{},"Seit v0.5.3 können Trenner zu benannten Gruppen werden:",[147,652,653,656,659,662],{},[150,654,655],{},"Gruppe über das Kontextmenü hinzufügen, umbenennen oder entfernen",[150,657,658],{},"Gruppenkopf ziehen — Kinder kommen mit",[150,660,661],{},"Sounds in eine Gruppe legen oder herausnehmen",[150,663,664],{},"Rahmenfarbe, Namensfarbe und Button-Ausrichtung setzen (oder Tab-Standard nutzen)",[14,666,667,668,671],{},"Ein einfacher ",[38,669,670],{},"Trenner"," geht weiter, wenn du nur einen visuellen Bruch brauchst.",[14,673,674,675,77],{},"Rechtsklick auf leeren Board-Bereich: ",[38,676,677],{},"Gruppe hinzufügen",[18,679,681],{"id":680},"tags-filter","Tags \u002F Filter",[14,683,684,685,688,689,691],{},"Tags gelten tabübergreifend. Das ausfahrbare ",[38,686,687],{},"Filter","-Panel (Sidebar ",[38,690,687],{},") ist der Ort zum Anlegen und zum Filtern des Boards.",[693,694,696],"h3",{"id":695},"tags-anlegen-und-bearbeiten","Tags anlegen und bearbeiten",[222,698,699,704,715,721],{},[150,700,701,703],{},[38,702,687],{}," in der Sidebar öffnen.",[150,705,706,707,710,711,714],{},"Unter ",[38,708,709],{},"Tags"," → ",[38,712,713],{},"Tag hinzufügen"," — Name und Farbe vergeben.",[150,716,717,718,77],{},"Im selben Panel umbenennen, umfärben oder ",[38,719,720],{},"Tag löschen",[150,722,723,724,727],{},"Steht da ",[38,725,726],{},"Noch keine Tags",", zuerst hier einen anlegen, bevor du zuweist.",[693,729,731],{"id":730},"tags-an-sounds-hängen","Tags an Sounds hängen",[14,733,734,735,737],{},"Rechtsklick auf einen Sound → ",[38,736,709],{}," (Checkboxen). Ein Sound darf mehrere Tags haben. Existieren noch keine, zeigt das Menü den Weg zum Filter-Panel.",[693,739,741],{"id":740},"board-filtern","Board filtern",[147,743,744,751,762,773],{},[150,745,746,747,750],{},"Tags im Filter-Panel oder als ",[38,748,749],{},"Chips unter der Suchleiste"," umschalten.",[150,752,753,754,757,758,761],{},"Abgleich ist ",[38,755,756],{},"ODER",": ein Sound bleibt sichtbar, wenn er ",[38,759,760],{},"irgendeinen"," gewählten Tag hat.",[150,763,764,765,768,769,772],{},"Das Feld ",[38,766,767],{},"Suche"," in der Navbar kombiniert per ",[38,770,771],{},"UND"," mit dem aktiven Tag-Filter (Tippen + Tags zusammen).",[150,774,775],{},"Chips aus (oder Filter leeren), um den ganzen Tab wieder zu sehen.",[14,777,778,779,77],{},"Farbige Tag-Namen können auf Buttons erscheinen. Schalter: ",[38,780,781],{},"Einstellungen → Verhalten → Tag-Badges anzeigen",[18,783,785],{"id":784},"sortierung","Sortierung",[14,787,788],{},"Im Filter-Panel eine Sortierung wählen:",[147,790,791,797],{},[150,792,793,796],{},[38,794,795],{},"Benutzerdefiniert"," — deine Tab-Reihenfolge, Gruppen sichtbar",[150,798,799,357,802,357,805,41,808,811,812],{},[38,800,801],{},"Name",[38,803,804],{},"Hinzugefügt",[38,806,807],{},"Spielzeit",[38,809,810],{},"Dateigröße"," — flache sortierte Liste; ",[38,813,814],{},"Gruppen sind ausgeblendet",[14,816,817],{},"Sortierung nach Dauer kann beim ersten Mal die Dauer-Metadaten vorwärmen.",[18,819,821],{"id":820},"neu-anordnen","Neu anordnen",[14,823,824,825,828,829,832,833,77],{},"Drag-and-Drop in ",[38,826,827],{},"Einstellungen → Verhalten"," einschalten (",[38,830,831],{},"Neu anordnen erlauben","). Dann Sounds und Gruppen ziehen. Neu anordnen gilt bei ",[38,834,795],{},[18,836,838],{"id":837},"mehrfachauswahl","Mehrfachauswahl",[14,840,841,843],{},[38,842,838],{}," in der Navbar einschalten, dann:",[147,845,846,849,855,861],{},[150,847,848],{},"Klick toggelt einen Sound",[150,850,851,854],{},[38,852,853],{},"Shift+Klick"," wählt einen Bereich ab dem letzten Anker",[150,856,857,860],{},[38,858,859],{},"Rahmen"," auf leerem Board ziehen",[150,862,863],{},"Klick auf leeres Board (oder außerhalb) leert die Auswahl",[14,865,866,867,357,870,357,873,876,877,77],{},"Eine Sammelleiste zeigt die Anzahl plus ",[38,868,869],{},"Farbe",[38,871,872],{},"Zu Tab verschieben…",[38,874,875],{},"Löschen"," und ",[38,878,879],{},"Fertig",[14,881,882,883,886],{},"In der Mehrfachauswahl zeigt jeder Button einen ",[38,884,885],{},"8-Zeichen-ID-Chip",". Rechtsklick auf den Chip kopiert die ID.",[18,888,890],{"id":889},"lautstärke-pro-sound","Lautstärke pro Sound",[14,892,893,894,897,898,901],{},"Rechtsklick → ",[38,895,896],{},"Lautstärke",". Slider von 0 % bis 100 %. ",[38,899,900],{},"Doppelklick"," setzt auf 100 % zurück.",[14,903,904],{},"Das stapelt sich mit der Master-Ausgangslautstärke in den Einstellungen.",[18,906,908],{"id":907},"hotkeys-und-sound-ids","Hotkeys und Sound-IDs",[14,910,911,912,915],{},"Jeder Sound hat eine 8-stellige ID. Kopieren über das Button-Kontextmenü (",[38,913,914],{},"ID kopieren",") oder den Mehrfachauswahl-Chip.",[14,917,918,921,922,925],{},[38,919,920],{},"Einstellungen → Hotkeys",": Taste an eine Sound-ID binden. Globale Hotkeys sind optional. ",[38,923,924],{},"Hotkey zuweisen"," im Kontextmenü springt dorthin, ID vorausgefüllt.",[14,927,928,929,931],{},"Dieselbe ID nutzt ",[28,930,198],{"href":197}," zum Auslösen.",[18,933,935],{"id":934},"hintergrundbilder-und-farben","Hintergrundbilder und Farben",[14,937,938,939,943],{},"Rechtsklick auf einen Sound: eigene Farben oder ein Hintergrundbild. Das ist getrennt vom ",[28,940,942],{"href":941},"\u002Fdocs\u002Ftheme-editor","Theme Creator",", der das ganze Board gestaltet.",[14,945,946,947,950],{},"Der Picker ist ein Dialog ",[38,948,949],{},"Hintergrundbild"," (PNG, JPEG, GIF, WebP):",[147,952,953,959],{},[150,954,955,958],{},[38,956,957],{},"Lokale Dateien"," — Ordner hinzufügen, einzelne Datei wählen, Dateinamen suchen, Rastervorschau, Ordner aus der Bibliothek entfernen",[150,960,961,964,965,967],{},[38,962,963],{},"KLIPY"," — GIFs online suchen. Eigenen API-Key unter ",[38,966,827],{},". Der Key landet nicht in Projektdateien.",[14,969,970],{},"Nach der Wahl Bild auf dem Button schieben und zuschneiden.",{"title":108,"searchDepth":109,"depth":109,"links":972},[973,974,975,980,981,982,983,984,985],{"id":609,"depth":109,"text":610},{"id":646,"depth":109,"text":647},{"id":680,"depth":109,"text":681,"children":976},[977,978,979],{"id":695,"depth":588,"text":696},{"id":730,"depth":588,"text":731},{"id":740,"depth":588,"text":741},{"id":784,"depth":109,"text":785},{"id":820,"depth":109,"text":821},{"id":837,"depth":109,"text":838},{"id":889,"depth":109,"text":890},{"id":907,"depth":109,"text":908},{"id":934,"depth":109,"text":935},"Tags, Filter, Tabs, Gruppen, Sortierung, Mehrfachauswahl, Lautstärke und Hotkeys.",{},4,"\u002Forganizing-sounds",{"title":577,"description":986},"organizing-sounds","phia_N7HDS6LIgxhltoa9iRYViBzJ00ngFayO7YKdtQ",{"id":994,"title":995,"body":996,"description":1121,"extension":117,"meta":1122,"navigation":119,"order":1123,"path":1124,"seo":1125,"stem":1000,"__hash__":1126},"content_de\u002Ftheme-editor.md","Theme-Editor",{"type":7,"value":997,"toc":1115},[998,1001,1007,1011,1038,1041,1045,1059,1063,1089,1092,1096,1101],[10,999,995],{"id":1000},"theme-