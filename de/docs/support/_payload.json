[{"data":1,"prerenderedAt":1591},["ShallowReactive",2],{"docs-page-de-\u002Fsupport":3,"docs-nav-de":124},{"id":4,"title":5,"body":6,"description":116,"extension":117,"meta":118,"navigation":119,"order":120,"path":121,"seo":122,"stem":12,"__hash__":123},"content_de\u002Fsupport.md","Support",{"type":7,"value":8,"toc":107},"minimark",[9,13,17,22,25,34,46,50,57,61,78,82,96,100],[10,11,5],"h1",{"id":12},"support",[14,15,16],"p",{},"SoundNinja ist ein Community-Projekt in früher Beta. Der schnellste Weg zur Hilfe ist GitHub.",[18,19,21],"h2",{"id":20},"fehler-melden-oder-frage-stellen","Fehler melden oder Frage stellen",[14,23,24],{},"Issue auf GitHub öffnen:",[14,26,27],{},[28,29,33],"a",{"href":30,"rel":31},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fissues",[32],"nofollow","github.com\u002Fmarcus-universe\u002FSoundNinja\u002Fissues",[14,35,36,37,41,42,45],{},"OS, SoundNinja-Version (",[38,39,40],"strong",{},"Hilfe → Nach Updates suchen"," oder ",[38,43,44],{},"Einstellungen → Über",") und Schritte zum Nachstellen angeben.",[18,47,49],{"id":48},"e-mail","E-Mail",[14,51,52,53],{},"Maintainer: ",[28,54,56],{"href":55},"mailto:contact@marcus-universe.de","contact@marcus-universe.de",[18,58,60],{"id":59},"updates","Updates",[14,62,63,64,66,67,71,72,77],{},"In der App: ",[38,65,40],{},". Neue Builds stehen auch auf der ",[28,68,70],{"href":69},"\u002Fdownload","Download-Seite"," und bei ",[28,73,76],{"href":74,"rel":75},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Freleases",[32],"GitHub Releases",".",[18,79,81],{"id":80},"mitmachen","Mitmachen",[14,83,84,85,90,91,77],{},"Pull Requests sind willkommen. App-Repo: ",[28,86,89],{"href":87,"rel":88},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja",[32],"github.com\u002Fmarcus-universe\u002FSoundNinja",". Lizenz: ",[28,92,95],{"href":93,"rel":94},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fblob\u002Fmain\u002FLICENSE",[32],"GPL-3.0",[18,97,99],{"id":98},"rechtliches","Rechtliches",[14,101,102,103,77],{},"Impressum und Kontaktdaten: ",[28,104,106],{"href":105},"\u002Fimpressum","Impressum",{"title":108,"searchDepth":109,"depth":109,"links":110},"",2,[111,112,113,114,115],{"id":20,"depth":109,"text":21},{"id":48,"depth":109,"text":49},{"id":59,"depth":109,"text":60},{"id":80,"depth":109,"text":81},{"id":98,"depth":109,"text":99},"Hilfe holen und Fehler melden.","md",{},true,8,"\u002Fsupport",{"title":5,"description":116},"qmZ7_9BNf5fpANXNPb6fUhg4rtoDFCqMYJ7xVG2xHIM",[125,255,468,614,1024,1158,1305,1527],{"id":126,"title":127,"body":128,"description":248,"extension":117,"meta":249,"navigation":119,"order":250,"path":251,"seo":252,"stem":253,"__hash__":254},"content_de\u002Foverview.md","Überblick",{"type":7,"value":129,"toc":242},[130,133,136,139,142,146,162,166,206,210,217,221],[10,131,127],{"id":132},"überblick",[14,134,135],{},"SoundNinja ist ein Open-Source-Soundboard für Livestreams, Chats mit Freunden und Podcast-Aufnahmen. Es läuft auf Tauri v2 und Nuxt 4 und bleibt dabei sparsam mit RAM und Speicherplatz.",[14,137,138],{},"Das Ziel: eine große Sound-Bibliothek schnell scannen und den richtigen Clip in Millisekunden abspielen. Die Oberfläche eignet sich auch als Dashboard in VR.",[14,140,141],{},"SoundNinja steckt noch in der frühen Entwicklung. Funktionen laufen, aber nicht jede Plattform ist vollständig getestet.",[18,143,145],{"id":144},"für-wen","Für wen",[147,148,149,153,156,159],"ul",{},[150,151,152],"li",{},"Streamer, die sofortige Sound-Cues brauchen",[150,154,155],{},"Freunde, die ein gemeinsames Board für Voice-Chat wollen",[150,157,158],{},"Podcaster, die Clips aufnehmen und aufs Board legen",[150,160,161],{},"Alle, die ein anpassbares, lokales Soundboard wollen",[18,163,165],{"id":164},"was-du-tun-kannst","Was du tun kannst",[147,167,168,171,174,177,180,183,186,189,192,200,203],{},[150,169,170],{},"Ein Soundboard aus eigenen Audiodateien bauen",[150,172,173],{},"Sounds in farbigen Tabs, Gruppen, Tags und über die Suche sortieren",[150,175,176],{},"Nach Tags filtern (ODER) und nach Name, Datum, Dauer oder Größe sortieren",[150,178,179],{},"Mehrfachauswahl mit Rahmen oder Shift-Bereich, dann Farbe, Tab oder Löschen in einem Rutsch",[150,181,182],{},"Lautstärke pro Sound im Kontextmenü setzen",[150,184,185],{},"Das Aussehen mit dem Theme Creator gestalten",[150,187,188],{},"PC-Audio oder Mikrofon im Record Editor aufnehmen",[150,190,191],{},"Hotkeys einzelnen Sounds zuweisen",[150,193,194,195,199],{},"Sounds über ",[28,196,198],{"href":197},"\u002Fdocs\u002Fremote-control","Bitfocus Companion"," auslösen",[150,201,202],{},"Ein komplettes Soundboard importieren und exportieren",[150,204,205],{},"GIFs oder Bilder auf Sound-Buttons legen — aus lokaler Ordnerbibliothek, GifSnap oder KLIPY",[18,207,209],{"id":208},"lizenz","Lizenz",[14,211,212,213,216],{},"SoundNinja ist freie Software unter ",[28,214,95],{"href":93,"rel":215},[32],". Forken, ändern, teilen.",[18,218,220],{"id":219},"nächste-schritte","Nächste Schritte",[222,223,224,230,236],"ol",{},[150,225,226],{},[28,227,229],{"href":228},"\u002Fdocs\u002Finstallation","SoundNinja installieren",[150,231,232],{},[28,233,235],{"href":234},"\u002Fdocs\u002Fadding-sounds","Sounds hinzufügen",[150,237,238],{},[28,239,241],{"href":240},"\u002Fdocs\u002Forganizing-sounds","Board organisieren",{"title":108,"searchDepth":109,"depth":109,"links":243},[244,245,246,247],{"id":144,"depth":109,"text":145},{"id":164,"depth":109,"text":165},{"id":208,"depth":109,"text":209},{"id":219,"depth":109,"text":220},"Was SoundNinja ist und was du damit machen kannst.",{},1,"\u002Foverview",{"title":127,"description":248},"overview","NKjfErgZuRFyQOJf6ppAsKHoUKCnyQ4MYR-evnuglSg",{"id":256,"title":257,"body":258,"description":463,"extension":117,"meta":464,"navigation":119,"order":109,"path":465,"seo":466,"stem":262,"__hash__":467},"content_de\u002Finstallation.md","Installation",{"type":7,"value":259,"toc":456},[26