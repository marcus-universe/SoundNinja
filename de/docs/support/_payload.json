[{"data":1,"prerenderedAt":1581},["ShallowReactive",2],{"docs-page-de-\u002Fsupport":3,"docs-nav-de":124},{"id":4,"title":5,"body":6,"description":116,"extension":117,"meta":118,"navigation":119,"order":120,"path":121,"seo":122,"stem":12,"__hash__":123},"content_de\u002Fsupport.md","Support",{"type":7,"value":8,"toc":107},"minimark",[9,13,17,22,25,34,46,50,57,61,78,82,96,100],[10,11,5],"h1",{"id":12},"support",[14,15,16],"p",{},"SoundNinja ist ein Community-Projekt in früher Beta. Der schnellste Weg zur Hilfe ist GitHub.",[18,19,21],"h2",{"id":20},"fehler-melden-oder-frage-stellen","Fehler melden oder Frage stellen",[14,23,24],{},"Issue auf GitHub öffnen:",[14,26,27],{},[28,29,33],"a",{"href":30,"rel":31},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fissues",[32],"nofollow","github.com\u002Fmarcus-universe\u002FSoundNinja\u002Fissues",[14,35,36,37,41,42,45],{},"OS, SoundNinja-Version (",[38,39,40],"strong",{},"Hilfe → Nach Updates suchen"," oder ",[38,43,44],{},"Einstellungen → Über",") und Schritte zum Nachstellen angeben.",[18,47,49],{"id":48},"e-mail","E-Mail",[14,51,52,53],{},"Maintainer: ",[28,54,56],{"href":55},"mailto:contact@marcus-universe.de","contact@marcus-universe.de",[18,58,60],{"id":59},"updates","Updates",[14,62,63,64,66,67,71,72,77],{},"In der App: ",[38,65,40],{},". Neue Builds stehen auch auf der ",[28,68,70],{"href":69},"\u002Fdownload","Download-Seite"," und bei ",[28,73,76],{"href":74,"rel":75},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Freleases",[32],"GitHub Releases",".",[18,79,81],{"id":80},"mitmachen","Mitmachen",[14,83,84,85,90,91,77],{},"Pull Requests sind willkommen. App-Repo: ",[28,86,89],{"href":87,"rel":88},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja",[32],"github.com\u002Fmarcus-universe\u002FSoundNinja",". Lizenz: ",[28,92,95],{"href":93,"rel":94},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fblob\u002Fmain\u002FLICENSE",[32],"GPL-3.0",[18,97,99],{"id":98},"rechtliches","Rechtliches",[14,101,102,103,77],{},"Impressum und Kontaktdaten: ",[28,104,106],{"href":105},"\u002Fimpressum","Impressum",{"title":108,"searchDepth":109,"depth":109,"links":110},"",2,[111,112,113,114,115],{"id":20,"depth":109,"text":21},{"id":48,"depth":109,"text":49},{"id":59,"depth":109,"text":60},{"id":80,"depth":109,"text":81},{"id":98,"depth":109,"text":99},"Hilfe holen und Fehler melden.","md",{},true,8,"\u002Fsupport",{"title":5,"description":116},"qmZ7_9BNf5fpANXNPb6fUhg4rtoDFCqMYJ7xVG2xHIM",[125,255,468,614,1014,1148,1295,1517],{"id":126,"title":127,"body":128,"description":248,"extension":117,"meta":249,"navigation":119,"order":250,"path":251,"seo":252,"stem":253,"__hash__":254},"content_de\u002Foverview.md","Überblick",{"type":7,"value":129,"toc":242},[130,133,136,139,142,146,162,166,206,210,217,221],[10,131,127],{"id":132},"überblick",[14,134,135],{},"SoundNinja ist ein Open-Source-Soundboard für Livestreams, Chats mit Freunden und Podcast-Aufnahmen. Es läuft auf Tauri v2 und Nuxt 4 und bleibt dabei sparsam mit RAM und Speicherplatz.",[14,137,138],{},"Das Ziel: eine große Sound-Bibliothek schnell scannen und den richtigen Clip in Millisekunden abspielen. Die Oberfläche eignet sich auch als Dashboard in VR.",[14,140,141],{},"SoundNinja steckt noch in der frühen Entwicklung. Funktionen laufen, aber nicht jede Plattform ist vollständig getestet.",[18,143,145],{"id":144},"für-wen","Für wen",[147,148,149,153,156,159],"ul",{},[150,151,152],"li",{},"Streamer, die sofortige Sound-Cues brauchen",[150,154,155],{},"Freunde, die ein gemeinsames Board für Voice-Chat wollen",[150,157,158],{},"Podcaster, die Clips aufnehmen und aufs Board legen",[150,160,161],{},"Alle, die ein anpassbares, lokales Soundboard wollen",[18,163,165],{"id":164},"was-du-tun-kannst","Was du tun kannst",[147,167,168,171,174,177,180,183,186,189,192,200,203],{},[150,169,170],{},"Ein Soundboard aus eigenen Audiodateien bauen",[150,172,173],{},"Sounds in farbigen Tabs, Gruppen, Tags und über die Suche sortieren",[150,175,176],{},"Nach Tags filtern (ODER) und nach Name, Datum, Dauer oder Größe sortieren",[150,178,179],{},"Mehrfachauswahl mit Rahmen oder Shift-Bereich, dann Farbe, Tab oder Löschen in einem Rutsch",[150,181,182],{},"Lautstärke pro Sound im Kontextmenü setzen",[150,184,185],{},"Das Aussehen mit dem Theme Creator gestalten",[150,187,188],{},"PC-Audio oder Mikrofon im Record Editor aufnehmen",[150,190,191],{},"Hotkeys einzelnen Sounds zuweisen",[150,193,194,195,199],{},"Sounds über ",[28,196,198],{"href":197},"\u002Fdocs\u002Fremote-control","Bitfocus Companion"," auslösen",[150,201,202],{},"Ein komplettes Soundboard importieren und exportieren",[150,204,205],{},"GIFs oder Bilder auf Sound-Buttons legen — aus lokaler Ordnerbibliothek oder KLIPY",[18,207,209],{"id":208},"lizenz","Lizenz",[14,211,212,213,216],{},"SoundNinja ist freie Software unter ",[28,214,95],{"href":93,"rel":215},[32],". Forken, ändern, teilen.",[18,218,220],{"id":219},"nächste-schritte","Nächste Schritte",[222,223,224,230,236],"ol",{},[150,225,226],{},[28,227,229],{"href":228},"\u002Fdocs\u002Finstallation","SoundNinja installieren",[150,231,232],{},[28,233,235],{"href":234},"\u002Fdocs\u002Fadding-sounds","Sounds hinzufügen",[150,237,238],{},[28,239,241],{"href":240},"\u002Fdocs\u002Forganizing-sounds","Board organisieren",{"title":108,"searchDepth":109,"depth":109,"links":243},[244,245,246,247],{"id":144,"depth":109,"text":145},{"id":164,"depth":109,"text":165},{"id":208,"depth":109,"text":209},{"id":219,"depth":109,"text":220},"Was SoundNinja ist und was du damit machen kannst.",{},1,"\u002Foverview",{"title":127,"description":248},"overview","hoyfMBw8UK5RuLBAbdnmSxP4gC163p8E8rvJgSihSXE",{"id":256,"title":257,"body":258,"description":463,"extension":117,"meta":464,"navigation":119,"order":109,"path":465,"seo":466,"stem":262,"__hash__":467},"content_de\u002Finstallation.md","Installation",{"type":7,"value":259,"toc":456},[260,263,274,278,298,301,305,319,322,326,351,362,364,369,373,386,416,431,452],[10,261,257],{"id":262},"installation",[14,264,265,266,268,269,273],{},"Hol dir einen Build von der ",[28,267,70],{"href":69}," oder von ",[28,270,76],{"href":271,"rel":272},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Freleases\u002Flatest",[32],". SoundNinja ist in früher Entwicklung — behandle Builds als Beta.",[18,275,277],{"id":276},"windows","Windows",[147,279,280,289,292,295],{},[150,281,282,41,285,288],{},[38,283,284],{},"Installer (.exe)",[38,286,287],{},"MSI (.msi)"," für 64-Bit-Windows",[150,290,291],{},"Landing-Page-Ziel: Windows 10 und neuer",[150,293,294],{},"Die App-README nennt auch Windows 8 und höher",[150,296,297],{},"Der NSIS-Installer ist dunkel. Sprache beim Setup wählen — SoundNinja merkt sie beim nächsten Start.",[14,299,300],{},"Installer starten, dann SoundNinja über das Startmenü öffnen.",[18,302,304],{"id":303},"macos","macOS",[147,306,307,313,316],{},[150,308,309,312],{},[38,310,311],{},"Universelles .dmg"," für Apple Silicon und Intel",[150,314,315],{},"Landing-Page-Ziel: macOS 10.14 und neuer",[150,317,318],{},"Die App-README nennt macOS 10.15 und höher",[14,320,321],{},"Disk-Image öffnen und SoundNinja nach Programme ziehen.",[18,323,325],{"id":324},"linux","Linux",[147,327,328,334,340,348],{},[150,329,330,333],{},[38,331,332],{},"Debian (.deb)"," für Ubuntu \u002F Debian",[150,335,336,339],{},[38,337,338],{},"AppImage"," für andere Distros",[150,341,342,343,347],{},"Nach Veröffentlichung einer Release können Arch-Nutzer ",[344,345,346],"code",{},"soundninja-bin"," aus dem AUR installieren",[150,349,350],{},"Getestet unter Ubuntu 20.04",[14,352,353,354,357,358,361],{},"Desktop-Builds brauchen WebKit- und GTK-Pakete. Unter Debian\u002FUbuntu meist ",[344,355,356],{},"libwebkit2gtk",", ",[344,359,360],{},"libgtk-3-0"," und eine App-Indicator-Bibliothek.",[18,363,60],{"id":59},[14,365,63,366,368],{},[38,367,40],{},". Optional prüft SoundNinja beim Start in den Einstellungen.",[18,370,372],{"id":371},"aus-dem-quellcode-bauen","Aus dem Quellcode bauen",[14,374,375,376,357,380,385],{},"Eigenen Build? ",[28,377,379],{"href":87,"rel":378},[32],"Repo klonen",[28,381,384],{"href":382,"rel":383},"https:\u002F\u002Fv2.tauri.app\u002Fstart\u002Fprerequisites\u002F",[32],"Tauri-Voraussetzungen"," installieren, dann:",[387,388,392],"pre",{"className":389,"code":390,"language":391,"meta":108,"style":108},"language-bash shiki shiki-themes github-light github-dark","bun install\nbun run tauri:serve\n","bash",[344,393,394,406],{"__ignoreMap":108},[395,396,398,402],"span",{"class":397,"line":250},"line",[395,399,401],{"class":400},"sScJk","bun",[395,403,405],{"class":404},"sZZnC"," install\n",[395,407,408,410,413],{"class":397,"line":109},[395,409,401],{"class":400},[395,411,412],{"class":404}," run",[395,414,415],{"class":404}," tauri:serve\n",[14,417,418,357,421,41,424,427,428,77],{},[344,419,420],{},"npm",[344,422,423],{},"pnpm",[344,425,426],{},"deno"," gehen auch. Produktionsbuild: ",[344,429,430],{},"bun run tauri:build",[14,432,433,436,437,442,443,446,447,77],{},[38,434,435],{},"Nur Windows:"," jeder Windows-Compile enthält ASIO über das ",[28,438,441],{"href":439,"rel":440},"https:\u002F\u002Fwww.steinberg.net\u002Fasiosdk",[32],"Steinberg ASIO SDK",". Einmal ",[344,444,445],{},"bun run setup:asio"," (SDK nicht im Git). Linux und macOS nutzen PipeWire \u002F Core Audio — diesen Schritt überspringen. Details: ",[28,448,451],{"href":449,"rel":450},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fblob\u002Fmain\u002Fdocs\u002Fbuild-from-source.md",[32],"build-from-source.md",[453,454,455],"style",{},"html pre.shiki code .sScJk, html code.shiki .sScJk{--shiki-default:#6F42C1;--shiki-dark:#B392F0}html pre.shiki code .sZZnC, html code.shiki .sZZnC{--shiki-default:#032F62;--shiki-dark:#9ECBFF}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html.dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}",{"title":108,"searchDepth":109,"depth":109,"links":457},[458,459,460,461,462],{"id":276,"depth":109,"text":277},{"id":303,"depth":109,"text":304},{"id":324,"depth":109,"text":325},{"id":59,"depth":109,"text":60},{"id":371,"depth":109,"text":372},"SoundNinja unter Windows, macOS oder Linux installieren.",{},"\u002Finstallation",{"title":257,"description":463},"OPh-0WbR2ebU9niw-poNeR6zaGWqUJm2ONgxhb61JBU",{"id":469,"title":235,"body":470,"description":607,"extension":117,"meta":608,"navigation":119,"order":609,"path":610,"seo":611,"stem":612,"__hash__":613},"content_de\u002Fadding-sounds.md",{"type":7,"value":471,"toc":599},[472,475,478,482,499,503,534,538,557,561,575,578,582,589,593],[10,473,235],{"id":474},"sounds-hinzufügen",[14,476,477],{},"Ein Board bleibt leer, bis du Clips hinzufügst. SoundNinja importiert Dateien, ganze Ordner, eine Aufnahme oder ein geteiltes Soundboard-Paket.",[18,479,481],{"id":480},"audiodateien-importieren","Audiodateien importieren",[222,483,484,493,496],{},[150,485,486,41,489,492],{},[38,487,488],{},"Datei → Audiodateien importieren",[38,490,491],{},"Import"," in der Navbar.",[150,494,495],{},"Eine oder mehrere Audiodateien wählen.",[150,497,498],{},"Sounds landen im aktuellen Tab.",[18,500,502],{"id":501},"ordner-importieren","Ordner importieren",[222,504,505,514,517],{},[150,506,507,510,511,513],{},[38,508,509],{},"Datei → Ordner importieren"," (oder ",[38,512,502],{}," in der Navbar).",[150,515,516],{},"Einen oder mehrere Ordner hinzufügen. Vor dem Import per Drag neu sortieren.",[150,518,519,520],{},"Ziel wählen:\n",[147,521,522,528],{},[150,523,524,527],{},[38,525,526],{},"Als Tabs importieren"," — jeder Ordner wird ein eigener Tab",[150,529,530,533],{},[38,531,532],{},"In aktuellen Tab importieren"," — alle Dateien landen im aktiven Tab",[18,535,537],{"id":536},"clip-aufnehmen","Clip aufnehmen",[14,539,540,541,545,546,549,550,41,553,556],{},"Öffne den ",[28,542,544],{"href":543},"\u002Fdocs\u002Frecording-editor","Record Editor"," über ",[38,547,548],{},"Aufnahme"," in der Player-Leiste. Aufnehmen, zuschneiden, dann ",[38,551,552],{},"Auswahl importieren",[38,554,555],{},"Alle importieren"," in den aktuellen Tab oder einen gewählten Tab.",[18,558,560],{"id":559},"soundboard-importieren","Soundboard importieren",[14,562,563,566,567,570,571,574],{},[38,564,565],{},"Datei → Soundboard importieren"," lädt ein geteiltes Paket. Pakete sind ein ",[344,568,569],{},".zip"," mit ",[344,572,573],{},"project.sninja"," plus Sounddateien. Danach Projekt öffnen und abspielen.",[14,576,577],{},"Du kannst mehrere Projekte (Profile) halten. Über den Projektwähler zwischen Boards wechseln.",[18,579,581],{"id":580},"fehlende-dateien-neu-verknüpfen","Fehlende Dateien neu verknüpfen",[14,583,584,585,588],{},"Wenn Audiodateien auf der Festplatte umziehen, zeigt SoundNinja ",[38,586,587],{},"Fehlende Sounddateien",". Einen Suchordner wählen und Clips neu verknüpfen.",[18,590,592],{"id":591},"weiter","Weiter",[14,594,595,596,77],{},"Tabs, Tags, Filter und Hotkeys: ",[28,597,598],{"href":240},"Sounds organisieren",{"title":108,"searchDepth":109,"depth":109,"links":600},[601,602,603,604,605,606],{"id":480,"depth":109,"text":481},{"id":501,"depth":109,"text":502},{"id":536,"depth":109,"text":537},{"id":559,"depth":109,"text":560},{"id":580,"depth":109,"text":581},{"id":591,"depth":109,"text":592},"Audio, Ordner, Aufnahmen und geteilte Soundboards importieren.",{},3,"\u002Fadding-sounds",{"title":235,"description":607},"adding-sounds","H_ls9_vOwDkgTWPkfe9bQz1A0XidUOmMFV4V2EJpYec",{"id":615,"title":598,"body":616,"description":1007,"extension":117,"meta":1008,"navigation":119,"order":1009,"path":1010,"seo":1011,"stem":1012,"__hash__":1013},"content_de\u002Forganizing-sounds.md",{"type":7,"value":617,"toc":992},[618,621,628,632,658,665,669,672,686,693,699,703,713,718,749,753,759,763,797,803,807,810,836,839,843,856,860,865,885,901,908,912,923,926,930,937,947,953,957,965,972,989],[10,619,598],{"id":620},"sounds-organisieren",[14,622,623,624,627],{},"SoundNinja ist für große Bibliotheken gebaut. ",[38,625,626],{},"Tags und Filter",", Tabs, Suche, Mehrfachauswahl und Hotkeys — der Clip ist einen Klick (oder eine Taste) entfernt.",[18,629,631],{"id":630},"tabs","Tabs",[147,633,634,641,648],{},[150,635,636,637,640],{},"Tab mit ",[38,638,639],{},"Tab hinzufügen"," anlegen. Farbe vergeben, damit die Leiste schnell scannbar bleibt.",[150,642,643,644,647],{},"Die Ansicht ",[38,645,646],{},"Alle"," zeigt jeden Sound über alle Tabs.",[150,649,650,651,654,655,77],{},"Ein Sound kann ",[38,652,653],{},"einem oder mehreren Tabs"," gehören. Rechtsklick → ",[38,656,657],{},"Zu Tab verschieben",[14,659,660,661,664],{},"Tab-Übergänge: ",[38,662,663],{},"Einstellungen → Allgemein"," — Slide, Fade, Buttons nacheinander oder Keine.",[18,666,668],{"id":667},"gruppen","Gruppen",[14,670,671],{},"Seit v0.5.3 können Trenner zu benannten Gruppen werden:",[147,673,674,677,680,683],{},[150,675,676],{},"Gruppe über das Kontextmenü hinzufügen, umbenennen oder entfernen",[150,678,679],{},"Gruppenkopf ziehen — Kinder kommen mit",[150,681,682],{},"Sounds in eine Gruppe legen oder herausnehmen",[150,684,685],{},"Rahmenfarbe, Namensfarbe und Button-Ausrichtung setzen (oder Tab-Standard nutzen)",[14,687,688,689,692],{},"Ein einfacher ",[38,690,691],{},"Trenner"," geht weiter, wenn du nur einen visuellen Bruch brauchst.",[14,694,695,696,77],{},"Rechtsklick auf leeren Board-Bereich: ",[38,697,698],{},"Gruppe hinzufügen",[18,700,702],{"id":701},"tags-filter","Tags \u002F Filter",[14,704,705,706,709,710,712],{},"Tags gelten tabübergreifend. Das ausfahrbare ",[38,707,708],{},"Filter","-Panel (Sidebar ",[38,711,708],{},") ist der Ort zum Anlegen und zum Filtern des Boards.",[714,715,717],"h3",{"id":716},"tags-anlegen-und-bearbeiten","Tags anlegen und bearbeiten",[222,719,720,725,736,742],{},[150,721,722,724],{},[38,723,708],{}," in der Sidebar öffnen.",[150,726,727,728,731,732,735],{},"Unter ",[38,729,730],{},"Tags"," → ",[38,733,734],{},"Tag hinzufügen"," — Name und Farbe vergeben.",[150,737,738,739,77],{},"Im selben Panel umbenennen, umfärben oder ",[38,740,741],{},"Tag löschen",[150,743,744,745,748],{},"Steht da ",[38,746,747],{},"Noch keine Tags",", zuerst hier einen anlegen, bevor du zuweist.",[714,750,752],{"id":751},"tags-an-sounds-hängen","Tags an Sounds hängen",[14,754,755,756,758],{},"Rechtsklick auf einen Sound → ",[38,757,730],{}," (Checkboxen). Ein Sound darf mehrere Tags haben. Existieren noch keine, zeigt das Menü den Weg zum Filter-Panel.",[714,760,762],{"id":761},"board-filtern","Board filtern",[147,764,765,772,783,794],{},[150,766,767,768,771],{},"Tags im Filter-Panel oder als ",[38,769,770],{},"Chips unter der Suchleiste"," umschalten.",[150,773,774,775,778,779,782],{},"Abgleich ist ",[38,776,777],{},"ODER",": ein Sound bleibt sichtbar, wenn er ",[38,780,781],{},"irgendeinen"," gewählten Tag hat.",[150,784,785,786,789,790,793],{},"Das Feld ",[38,787,788],{},"Suche"," in der Navbar kombiniert per ",[38,791,792],{},"UND"," mit dem aktiven Tag-Filter (Tippen + Tags zusammen).",[150,795,796],{},"Chips aus (oder Filter leeren), um den ganzen Tab wieder zu sehen.",[14,798,799,800,77],{},"Farbige Tag-Namen können auf Buttons erscheinen. Schalter: ",[38,801,802],{},"Einstellungen → Verhalten → Tag-Badges anzeigen",[18,804,806],{"id":805},"sortierung","Sortierung",[14,808,809],{},"Im Filter-Panel eine Sortierung wählen:",[147,811,812,818],{},[150,813,814,817],{},[38,815,816],{},"Benutzerdefiniert"," — deine Tab-Reihenfolge, Gruppen sichtbar",[150,819,820,357,823,357,826,41,829,832,833],{},[38,821,822],{},"Name",[38,824,825],{},"Hinzugefügt",[38,827,828],{},"Spielzeit",[38,830,831],{},"Dateigröße"," — flache sortierte Liste; ",[38,834,835],{},"Gruppen sind ausgeblendet",[14,837,838],{},"Sortierung nach Dauer kann beim ersten Mal die Dauer-Metadaten vorwärmen.",[18,840,842],{"id":841},"neu-anordnen","Neu anordnen",[14,844,845,846,849,850,853,854,77],{},"Drag-and-Drop in ",[38,847,848],{},"Einstellungen → Verhalten"," einschalten (",[38,851,852],{},"Neu anordnen erlauben","). Dann Sounds und Gruppen ziehen. Neu anordnen gilt bei ",[38,855,816],{},[18,857,859],{"id":858},"mehrfachauswahl","Mehrfachauswahl",[14,861,862,864],{},[38,863,859],{}," in der Navbar einschalten, dann:",[147,866,867,870,876,882],{},[150,868,869],{},"Klick toggelt einen Sound",[150,871,872,875],{},[38,873,874],{},"Shift+Klick"," wählt einen Bereich ab dem letzten Anker",[150,877,878,881],{},[38,879,880],{},"Rahmen"," auf leerem Board ziehen",[150,883,884],{},"Klick auf leeres Board (oder außerhalb) leert die Auswahl",[14,886,887,888,357,891,357,894,897,898,77],{},"Eine Sammelleiste zeigt die Anzahl plus ",[38,889,890],{},"Farbe",[38,892,893],{},"Zu Tab verschieben…",[38,895,896],{},"Löschen"," und ",[38,899,900],{},"Fertig",[14,902,903,904,907],{},"In der Mehrfachauswahl zeigt jeder Button einen ",[38,905,906],{},"8-Zeichen-ID-Chip",". Rechtsklick auf den Chip kopiert die ID.",[18,909,911],{"id":910},"lautstärke-pro-sound","Lautstärke pro Sound",[14,913,914,915,918,919,922],{},"Rechtsklick → ",[38,916,917],{},"Lautstärke",". Slider von 0 % bis 100 %. ",[38,920,921],{},"Doppelklick"," setzt auf 100 % zurück.",[14,924,925],{},"Das stapelt sich mit der Master-Ausgangslautstärke in den Einstellungen.",[18,927,929],{"id":928},"hotkeys-und-sound-ids","Hotkeys und Sound-IDs",[14,931,932,933,936],{},"Jeder Sound hat eine 8-stellige ID. Kopieren über das Button-Kontextmenü (",[38,934,935],{},"ID kopieren",") oder den Mehrfachauswahl-Chip.",[14,938,939,942,943,946],{},[38,940,941],{},"Einstellungen → Hotkeys",": Taste an eine Sound-ID binden. Globale Hotkeys sind optional. ",[38,944,945],{},"Hotkey zuweisen"," im Kontextmenü springt dorthin, ID vorausgefüllt.",[14,948,949,950,952],{},"Dieselbe ID nutzt ",[28,951,198],{"href":197}," zum Auslösen.",[18,954,956],{"id":955},"hintergrundbilder-und-farben","Hintergrundbilder und Farben",[14,958,959,960,964],{},"Rechtsklick auf einen Sound: eigene Farben oder ein Hintergrundbild. Das ist getrennt vom ",[28,961,963],{"href":962},"\u002Fdocs\u002Ftheme-editor","Theme Creator",", der das ganze Board gestaltet.",[14,966,967,968,971],{},"Der Picker ist ein Dialog ",[38,969,970],{},"Hintergrundbild"," (PNG, JPEG, GIF, WebP):",[147,973,974,980],{},[150,975,976,979],{},[38,977,978],{},"Lokale Dateien"," — Ordner hinzufügen, einzelne Datei wählen, Dateinamen suchen, Rastervorschau, Ordner aus der Bibliothek entfernen",[150,981,982,985,986,988],{},[38,983,984],{},"KLIPY"," — GIFs online suchen. Eigenen API-Key unter ",[38,987,848],{},". Der Key landet nicht in Projektdateien.",[14,990,991],{},"Nach der Wahl Bild auf dem Button schieben und zuschneiden.",{"title":108,"searchDepth":109,"depth":109,"links":993},[994,995,996,1001,1002,1003,1004,1005,1006],{"id":630,"depth":109,"text":631},{"id":667,"depth":109,"text":668},{"id":701,"depth":109,"text":702,"children":997},[998,999,1000],{"id":716,"depth":609,"text":717},{"id":751,"depth":609,"text":752},{"id":761,"depth":609,"text":762},{"id":805,"depth":109,"text":806},{"id":841,"depth":109,"text":842},{"id":858,"depth":109,"text":859},{"id":910,"depth":109,"text":911},{"id":928,"depth":109,"text":929},{"id":955,"depth":109,"text":956},"Tags, Filter, Tabs, Gruppen, Sortierung, Mehrfachauswahl, Lautstärke und Hotkeys.",{},4,"\u002Forganizing-sounds",{"title":598,"description":1007},"organizing-sounds","phia_N7HDS6LIgxhltoa9iRYViBzJ00ngFayO7YKdtQ",{"id":1015,"title":1016,"body":1017,"description":1142,"extension":117,"meta":1143,"navigation":119,"order":1144,"path":1145,"seo":1146,"stem":1021,"__hash__":1147},"content_de\u002Ftheme-editor.md","Theme-Editor",{"type":7,"value":1018,"toc":1136},[1019,1022,1028,1032,1059,1062,1066,1080,1084,1110,1113,1117,1122],[10,1020,1016],{"id":1021},"theme-editor",[14,1023,1024,1025,77],{},"Der Theme Creator ist der volle visuelle Editor für dein Board. Öffnen über ",[38,1026,1027],{},"Einstellungen → Allgemein → Theme Creator",[18,1029,1031],{"id":1030},"drei-tabs","Drei Tabs",[222,1033,1034,1048,1054],{},[150,1035,1036,1039,1040,1043,1044,1047],{},[38,1037,1038],{},"Allgemein"," — Theme-Name, gemeinsame Farben und Schrift-Uploads (",[344,1041,1042],{},".ttf"," \u002F ",[344,1045,1046],{},".otf",")",[150,1049,1050,1053],{},[38,1051,1052],{},"Buttons"," — Farben, Typo, Layout und GIF-Overlay der Sound-Buttons",[150,1055,1056,1058],{},[38,1057,631],{}," — Farben, Typo und Rahmenstärke der Tab-Leiste",[14,1060,1061],{},"Eine Live-Vorschau zeigt Tabs und Buttons beim Bearbeiten.",[18,1063,1065],{"id":1064},"was-du-ändern-kannst","Was du ändern kannst",[147,1067,1068,1071,1074,1077],{},[150,1069,1070],{},"Primär- und Akzentfarben, Hintergründe, Button- und Tab-Farben",[150,1072,1073],{},"Schriftfamilie und -größe für Buttons und Tabs",[150,1075,1076],{},"Button-Breite, Radius, Rahmen, Abstände und Innenabstand",[150,1078,1079],{},"GIF-Overlay-Deckkraft (normal und Hover)",[18,1081,1083],{"id":1082},"speichern-und-teilen","Speichern und teilen",[147,1085,1086,1092,1098,1104],{},[150,1087,1088,1091],{},[38,1089,1090],{},".css exportieren"," — Theme-Datei sichern oder weitergeben",[150,1093,1094,1097],{},[38,1095,1096],{},"Zu Themes hinzufügen"," — in den Themes-Ordner speichern und anwenden",[150,1099,1100,1103],{},[38,1101,1102],{},".css importieren"," — Preset oder gespeichertes Theme laden",[150,1105,1106,1109],{},[38,1107,1108],{},"Zurücksetzen"," — SoundNinja-Standard wiederherstellen",[14,1111,1112],{},"Beim Schließen mit ungespeicherten Änderungen fragt SoundNinja nach.",[18,1114,1116],{"id":1115},"ohne-vollen-editor","Ohne vollen Editor",[14,1118,727,1119,1121],{},[38,1120,663],{}," kannst du trotzdem:",[147,1123,1124,1127,1133],{},[150,1125,1126],{},"Ein Theme aus der Liste wählen",[150,1128,1129,1130,1047],{},"CSS-Variablen live bearbeiten (",[38,1131,1132],{},"Eigenes CSS",[150,1134,1135],{},"Eine Theme-Datei in den Themes-Ordner importieren",{"title":108,"searchDepth":109,"depth":109,"links":1137},[1138,1139,1140,1141],{"id":1030,"depth":109,"text":1031},{"id":1064,"depth":109,"text":1065},{"id":1082,"depth":109,"text":1083},{"id":1115,"depth":109,"text":1116},"Farben, Schriften, Buttons und Tabs im Theme Creator gestalten.",{},5,"\u002Ftheme-editor",{"title":1016,"description":1142},"h6Hta3TDDcThnouY3Pk_Omvjq8Eb8knx-HIAvf5YZd8",{"id":1149,"title":1150,"body":1151,"description":1288,"extension":117,"meta":1289,"navigation":119,"order":1290,"path":1291,"seo":1292,"stem":1293,"__hash__":1294},"content_de\u002Frecording-editor.md","Aufnahme-Editor",{"type":7,"value":1152,"toc":1282},[1153,1156,1162,1166,1172,1192,1195,1199,1224,1228,1243,1247,1261,1272],[10,1154,1150],{"id":1155},"aufnahme-editor",[14,1157,1158,1159,1161],{},"Nimm einen Clip in SoundNinja auf, schneide ihn zu und importiere ihn in einen Tab. Öffnen über ",[38,1160,548],{}," in der Player-Leiste.",[18,1163,1165],{"id":1164},"eingang-wählen","Eingang wählen",[14,1167,727,1168,1171],{},[38,1169,1170],{},"Einstellungen → Audio",":",[147,1173,1174,1180,1186],{},[150,1175,1176,1179],{},[38,1177,1178],{},"Eingabegeräte"," — Mikrofon",[150,1181,1182,1185],{},[38,1183,1184],{},"Ausgabegeräte (PC-Audio)"," — Loopback dessen, was der PC spielt",[150,1187,1188,1191],{},[38,1189,1190],{},"Eingangslautstärke"," — Aufnahme-Gain von 0 % bis 200 %",[14,1193,1194],{},"Der Aufnahme-Button nutzt das hier gewählte Gerät.",[18,1196,1198],{"id":1197},"take-bearbeiten","Take bearbeiten",[147,1200,1201,1204,1207,1215,1218,1221],{},[150,1202,1203],{},"Aufnehmen und stoppen",[150,1205,1206],{},"Pegelmesser beobachten",[150,1208,1209,41,1212],{},[38,1210,1211],{},"Normalisieren",[38,1213,1214],{},"Rauschunterdrückung",[150,1216,1217],{},"Ganzen Clip trimmen, auf Auswahl trimmen oder Auswahl löschen",[150,1219,1220],{},"Rückgängig \u002F Wiederholen",[150,1222,1223],{},"Rein- und rauszoomen",[18,1225,1227],{"id":1226},"stagen-und-importieren","Stagen und importieren",[222,1229,1230,1233,1236],{},[150,1231,1232],{},"Auswahl oder ganzen Track zur Staging-Liste hinzufügen.",[150,1234,1235],{},"Die Liste startet leer: aufnehmen, bearbeiten, dann Clip hinzufügen.",[150,1237,1238,41,1240,1242],{},[38,1239,552],{},[38,1241,555],{}," in den aktuellen oder einen gewählten Tab.",[18,1244,1246],{"id":1245},"stem-trennung-optional","Stem-Trennung (optional)",[14,1248,1249,1250,1253,1254,41,1257,1260],{},"Offizielle Windows-, macOS- und Linux-Release-Builds enthalten das ",[38,1251,1252],{},"Stems","-Feature. Der Aufnahme-Editor kann ",[38,1255,1256],{},"Gesang",[38,1258,1259],{},"Musik"," mit BS-RoFormer behalten.",[14,1262,1263,1264,1267,1268,1271],{},"Das Modell ist etwa 158 MB und ",[38,1265,1266],{},"nicht"," im Installer. Download unter ",[38,1269,1270],{},"Einstellungen → Stem-Trennung"," oder über den Erststart-Hinweis. Der Windows-Installer kann den Download beim ersten Start anbieten.",[14,1273,1274,1275,1043,1278,1281],{},"Eigene Source-Builds brauchen extra Flags (",[344,1276,1277],{},"tauri:serve:stems",[344,1279,1280],{},"tauri:build:stems",").",{"title":108,"searchDepth":109,"depth":109,"links":1283},[1284,1285,1286,1287],{"id":1164,"depth":109,"text":1165},{"id":1197,"depth":109,"text":1198},{"id":1226,"depth":109,"text":1227},{"id":1245,"depth":109,"text":1246},"Mikrofon oder PC-Audio aufnehmen, den Clip bearbeiten und aufs Board legen.",{},6,"\u002Frecording-editor",{"title":1150,"description":1288},"recording-editor","mBUN6yUiwk-kNjhsf48NlWEXXhjw6cOuSAkybSa9wi0",{"id":1296,"title":1297,"body":1298,"description":1510,"extension":117,"meta":1511,"navigation":119,"order":1512,"path":1513,"seo":1514,"stem":1515,"__hash__":1516},"content_de\u002Fremote-control.md","Fernsteuerung",{"type":7,"value":1299,"toc":1503},[1300,1303,1306,1310,1339,1342,1345,1380,1384,1404,1407,1411,1443,1447,1453],[10,1301,1297],{"id":1302},"fernsteuerung",[14,1304,1305],{},"SoundNinja kann im lokalen Netz lauschen, damit Bitfocus Companion (oder jeder HTTP\u002FWebSocket-Client) Sounds spielt und stoppt.",[18,1307,1309],{"id":1308},"remote-server-einschalten","Remote-Server einschalten",[222,1311,1312,1318,1324,1330],{},[150,1313,1314,1317],{},[38,1315,1316],{},"Einstellungen → Remote"," öffnen.",[150,1319,1320,1321,77],{},"Remote-Server aktivieren. Standardport ist ",[38,1322,1323],{},"7331",[150,1325,1326,1327,77],{},"Optional: Token setzen. Clients senden ihn als Bearer-Token oder ",[344,1328,1329],{},"?token=",[150,1331,1332,1335,1336,1338],{},[344,1333,1334],{},"http:\u002F\u002FIP:PORT"," kopieren oder die System-IP unter ",[38,1337,44],{}," holen.",[14,1340,1341],{},"Windows kann beim ersten Start eine Firewall-Abfrage zeigen. Zugriff im privaten Netz erlauben.",[18,1343,198],{"id":1344},"bitfocus-companion",[222,1346,1347,1354,1362,1373],{},[150,1348,1349,1353],{},[28,1350,198],{"href":1351,"rel":1352},"https:\u002F\u002Fbitfocus.io\u002Fcompanion",[32]," installieren.",[150,1355,1356,1361],{},[28,1357,1360],{"href":1358,"rel":1359},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002Fcompanion-module-soundninja\u002Freleases\u002Flatest",[32],"SoundNinja-Companion.tgz"," herunterladen. Es gibt noch kein Companion-Store-Paket.",[150,1363,1364,1365,1368,1369,1372],{},"In Companion: ",[38,1366,1367],{},"Modules → Load module package"," und die ",[344,1370,1371],{},".tgz"," wählen.",[150,1374,1375,1376,1379],{},"Eine ",[38,1377,1378],{},"Sound Ninja","-Verbindung anlegen. PC-IP, Port und Token eintragen.",[18,1381,1383],{"id":1382},"aktionen","Aktionen",[147,1385,1386,1392,1398],{},[150,1387,1388,1391],{},[38,1389,1390],{},"Trigger Sound"," — aus dem Live-Dropdown wählen oder 8-stellige Sound-ID tippen (Companion-Variablen gehen)",[150,1393,1394,1397],{},[38,1395,1396],{},"Stop Sound"," — einen spielenden Sound per ID stoppen",[150,1399,1400,1403],{},[38,1401,1402],{},"Stop All"," — alle spielenden Sounds stoppen",[14,1405,1406],{},"Sound-ID in SoundNinja über das Button-Kontextmenü oder den Mehrfachauswahl-Chip kopieren.",[18,1408,1410],{"id":1409},"feedbacks-und-variablen","Feedbacks und Variablen",[147,1412,1413,1419,1431,1437],{},[150,1414,1415,1418],{},[38,1416,1417],{},"Sound Playing"," — wahr, solange diese Sound-ID aktiv ist (für Button-Farbe)",[150,1420,1421,1424,1425,1043,1428],{},[344,1422,1423],{},"$(soundninja:connected)"," — ",[344,1426,1427],{},"true",[344,1429,1430],{},"false",[150,1432,1433,1436],{},[344,1434,1435],{},"$(soundninja:playing_count)"," — wie viele Sounds spielen",[150,1438,1439,1442],{},[344,1440,1441],{},"$(soundninja:last_triggered)"," — zuletzt ausgelöste Sound-ID",[18,1444,1446],{"id":1445},"http-api-fortgeschritten","HTTP-API (fortgeschritten)",[14,1448,1449,1450],{},"Basispfad: ",[344,1451,1452],{},"\u002Fapi\u002Fv1",[147,1454,1455,1461,1467,1473,1482,1488,1497],{},[150,1456,1457,1460],{},[344,1458,1459],{},"GET \u002Finfo"," — App-Name, Version, Protokoll, ob ein Token nötig ist",[150,1462,1463,1466],{},[344,1464,1465],{},"GET \u002Fsounds"," — Soundliste (id, name, tabs, active)",[150,1468,1469,1472],{},[344,1470,1471],{},"GET \u002Fstate"," — Sounds plus gerade spielende IDs",[150,1474,1475,570,1478,1481],{},[344,1476,1477],{},"POST \u002Ftrigger",[344,1479,1480],{},"{ \"id\" }"," — Sound abs