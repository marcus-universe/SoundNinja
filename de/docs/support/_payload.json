-3.0",[18,97,99],{"id":98},"rechtliches","Rechtliches",[14,101,102,103,77],{},"Impressum und Kontaktdaten: ",[28,104,106],{"href":105},"\u002Fimpressum","Impressum",{"title":108,"searchDepth":109,"depth":109,"links":110},"",2,[111,112,113,114,115],{"id":20,"depth":109,"text":21},{"id":48,"depth":109,"text":49},{"id":59,"depth":109,"text":60},{"id":80,"depth":109,"text":81},{"id":98,"depth":109,"text":99},"Hilfe holen und Fehler melden.","md",{},true,8,"\u002Fsupport",{"title":5,"description":116},"qmZ7_9BNf5fpANXNPb6fUhg4rtoDFCqMYJ7xVG2xHIM",[125,246,435,581,734,869,1012,1234],{"id":126,"title":127,"body":128,"description":239,"extension":117,"meta":240,"navigation":119,"order":241,"path":242,"seo":243,"stem":244,"__hash__":245},"content_de\u002Foverview.md","Überblick",{"type":7,"value":129,"toc":233},[130,133,136,139,142,146,162,166,197,201,208,212],[10,131,127],{"id":132},"überblick",[14,134,135],{},"SoundNinja ist ein Open-Source-Soundboard für Livestreams, Chats mit Freunden und Podcast-Aufnahmen. Es läuft auf Tauri v2 und Nuxt 4 und bleibt dabei sparsam mit RAM und Speicherplatz.",[14,137,138],{},"Das Ziel: eine große Sound-Bibliothek schnell scannen und den richtigen Clip in Millisekunden abspielen. Die Oberfläche eignet sich auch als Dashboard in VR.",[14,140,141],{},"SoundNinja steckt noch in der frühen Entwicklung. Funktionen laufen, aber nicht jede Plattform ist vollständig getestet.",[18,143,145],{"id":144},"für-wen","Für wen",[147,148,149,153,156,159],"ul",{},[150,151,152],"li",{},"Streamer, die sofortige Sound-Cues brauchen",[150,154,155],{},"Freunde, die ein gemeinsames Board für Voice-Chat wollen",[150,157,158],{},"Podcaster, die Clips aufnehmen und aufs Board legen",[150,160,161],{},"Alle, die ein anpassbares, lokales Soundboard wollen",[18,163,165],{"id":164},"was-du-tun-kannst","Was du tun kannst",[147,167,168,171,174,177,180,183,191,194],{},[150,169,170],{},"Ein Soundboard aus eigenen Audiodateien bauen",[150,172,173],{},"Sounds in farbigen Tabs, Gruppen und über die Suche sortieren",[150,175,176],{},"Das Aussehen mit dem Theme Creator gestalten",[150,178,179],{},"PC-Audio oder Mikrofon im Record Editor aufnehmen",[150,181,182],{},"Hotkeys einzelnen Sounds zuweisen",[150,184,185,186,190],{},"Sounds über ",[28,187,189],{"href":188},"\u002Fdocs\u002Fremote-control","Bitfocus Companion"," auslösen",[150,192,193],{},"Ein komplettes Soundboard importieren und exportieren",[150,195,196],{},"GIFs oder Bilder auf Sound-Buttons legen",[18,198,200],{"id":199},"lizenz","Lizenz",[14,202,203,204,207],{},"SoundNinja ist freie Software unter ",[28,205,95],{"href":93,"rel":206},[32],". Forken, ändern, teilen.",[18,209,211],{"id":210},"nächste-schritte","Nächste Schritte",[213,214,215,221,227],"ol",{},[150,216,217],{},[28,218,220],{"href":219},"\u002Fdocs\u002Finstallation","SoundNinja installieren",[150,222,223],{},[28,224,226],{"href":225},"\u002Fdocs\u002Fadding-sounds","Sounds hinzufügen",[150,228,229],{},[28,230,232],{"href":231},"\u002Fdocs\u002Forganizing-sounds","Board organisieren",{"title":108,"searchDepth":109,"depth":109,"links":234},[235,236,237,238],{"id":144,"depth":109,"text":145},{"id":164,"depth":109,"text":165},{"id":199,"depth":109,"text":200},{"id":210,"depth":109,"text":211},"Was SoundNinja ist und was du damit machen kannst.",{},1,"\u002Foverview",{"title":127,"description":239},"overview","k9vdLuByV0_2FJs4S1c2pJgDzzqDtddQcqK9KQYpZ8M",{"id":247,"title":248,"body":249,"description":430,"extension":117,"meta":431,"navigation":119,"order":109,"path":432,"seo":433,"stem":253,"__hash__":434},"content_de\u002Finstallation.md","Installation",{"type":7,"value":250,"toc":423},[251,254,265,269,286,289,293,307,310,314,339,350,352,357,361,374,404,419],[10,252,248],{"id":253},"installation",[14,255,256,257,259,260,264],{},"Hol dir einen Build von der ",[28,258,70],{"href":69}," oder von ",[28,261,76],{"href":262,"rel":263},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Freleases\u002Flatest",[32],". SoundNinja ist in früher Entwicklung — behandle Builds als Beta.",[18,266,268],{"id":267},"windows","Windows",[147,270,271,280,283],{},[150,272,273,41,276,279],{},[38,274,275],{},"Installer (.exe)",[38,277,278],{},"MSI (.msi)"," für 64-Bit-Windows",[150,281,282],{},"Landing-Page-Ziel: Windows 10 und neuer",[150,284,285],{},"Die App-README nennt auch Windows 8 und höher",[14,287,288],{},"Installer starten, dann SoundNinja über das Startmenü öffnen.",[18,290,292],{"id":291},"macos","macOS",[147,294,295,301,304],{},[150,296,297,300],{},[38,298,299],{},"Universelles .dmg"," für Apple Silicon und Intel",[150,302,303],{},"Landing-Page-Ziel: macOS 10.14 und neuer",[150,305,306],{},"Die App-README nennt macOS 10.15 und höher",[14,308,309],{},"Disk-Image öffnen und SoundNinja nach Programme ziehen.",[18,311,313],{"id":312},"linux","Linux",[147,315,316,322,328,336],{},[150,317,318,321],{},[38,319,320],{},"Debian (.deb)"," für Ubuntu \u002F Debian",[150,323,324,327],{},[38,325,326],{},"AppImage"," für andere Distros",[150,329,330,331,335],{},"Nach Veröffentlichung einer Release können Arch-Nutzer ",[332,333,334],"code",{},"soundninja-bin"," aus dem AUR installieren",[150,337,338],{},"Getestet unter Ubuntu 20.04",[14,340,341,342,345,346,349],{},"Desktop-Builds brauchen WebKit- und GTK-Pakete. Unter Debian\u002FUbuntu meist ",[332,343,344],{},"libwebkit2gtk",", ",[332,347,348],{},"libgtk-3-0"," und eine App-Indicator-Bibliothek.",[18,351,60],{"id":59},[14,353,63,354,356],{},[38,355,40],{},". Optional prüft SoundNinja beim Start in den Einstellungen.",[18,358,360],{"id":359},"aus-dem-quellcode-bauen","Aus dem Quellcode bauen",[14,362,363,364,345,368,373],{},"Eigenen Build? ",[28,365,367],{"href":87,"rel":366},[32],"Repo klonen",[28,369,372],{"href":370,"rel":371},"https:\u002F\u002Fv2.tauri.app\u002Fstart\u002Fprerequisites\u002F",[32],"Tauri-Voraussetzungen"," installieren, dann:",[375,376,380],"pre",{"className":377,"code":378,"language":379,"meta":108,"style":108},"l