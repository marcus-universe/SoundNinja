20,526,528],{},[26,521,522,54,524,57],{},[29,523,53],{},[29,525,46],{},[26,527,60],{},[26,529,63,530],{},[65,531,532,536],{},[26,533,534,72],{},[29,535,71],{},[26,537,538,78],{},[29,539,77],{},[18,541,82],{"id":81},[14,543,85,544,91,546,95,548,32,550,102],{},[87,545,90],{"href":89},[29,547,94],{},[29,549,98],{},[29,551,101],{},[18,553,106],{"id":105},[14,555,556,112,558,117,560,121],{},[29,557,111],{},[114,559,116],{},[114,561,120],{},[14,563,124],{},[18,565,128],{"id":127},[14,567,131,568,135],{},[29,569,134],{},[18,571,139],{"id":138},[14,573,142,574,147],{},[87,575,146],{"href":145},{"title":149,"searchDepth":150,"depth":150,"links":577},[578,579,580,581,582,583],{"id":20,"depth":150,"text":21},{"id":45,"depth":150,"text":46},{"id":81,"depth":150,"text":82},{"id":105,"depth":150,"text":106},{"id":127,"depth":150,"text":128},{"id":138,"depth":150,"text":139},{},{"title":5,"description":158},{"id":587,"title":146,"body":588,"description":979,"extension":159,"meta":980,"navigation":161,"order":981,"path":982,"seo":983,"stem":984,"__hash__":985},"content_de\u002Forganizing-sounds.md",{"type":7,"value":589,"toc":964},[590,593,600,604,630,637,641,644,658,665,671,675,685,690,721,725,731,735,769,775,779,782,808,811,815,828,832,837,857,873,880,884,895,898,902,909,919,925,929,937,944,961],[10,591,146],{"id":592},"sounds-organisieren",[14,594,595,596,599],{},"SoundNinja ist für große Bibliotheken gebaut. ",[29,597,598],{},"Tags und Filter",", Tabs, Suche, Mehrfachauswahl und Hotkeys — der Clip ist einen Klick (oder eine Taste) entfernt.",[18,601,603],{"id":602},"tabs","Tabs",[65,605,606,613,620],{},[26,607,608,609,612],{},"Tab mit ",[29,610,611],{},"Tab hinzufügen"," anlegen. Farbe vergeben, damit die Leiste schnell scannbar bleibt.",[26,614,615,616,619],{},"Die Ansicht ",[29,617,618],{},"Alle"," zeigt jeden Sound über alle Tabs.",[26,621,622,623,626,627,147],{},"Ein Sound kann ",[29,624,625],{},"einem oder mehreren Tabs"," gehören. Rechtsklick → ",[29,628,629],{},"Zu Tab verschieben",[14,631,632,633,636],{},"Tab-Übergänge: ",[29,634,635],{},"Einstellungen → Allgemein"," — Slide, Fade, Buttons nacheinander oder Keine.",[18,638,640],{"id":639},"gruppen","Gruppen",[14,642,643],{},"Seit v0.5.3 können Trenner zu benannten Gruppen werden:",[65,645,646,649,652,655],{},[26,647,648],{},"Gruppe über das Kontextmenü hinzufügen, umbenennen oder entfernen",[26,650,651],{},"Gruppenkopf ziehen — Kinder kommen mit",[26,653,654],{},"Sounds in eine Gruppe legen oder herausnehmen",[26,656,657],{},"Rahmenfarbe, Namensfarbe und Button-Ausrichtung setzen (oder Tab-Standard nutzen)",[14,659,660,661,664],{},"Ein einfacher ",[29,662,663],{},"Trenner"," geht weiter, wenn du nur einen visuellen Bruch brauchst.",[14,666,667,668,147],{},"Rechtsklick auf leeren Board-Bereich: ",[29,669,670],{},"Gruppe hinzufügen",[18,672,674],{"id":673},"tags-filter","Tags \u002F Filter",[14,676,677,678,681,682,684],{},"Tags gelten tabübergreifend. Das ausfahrbare ",[29,679,680],{},"Filter","-Panel (Sidebar ",[29,683,680],{},") ist der Ort zum Anlegen und zum Filtern des Boards.",[686,687,689],"h3",{"id":688},"tags-anlegen-und-bearbeiten","Tags anlegen und bearbeiten",[23,691,692,697,708,714],{},[26,693,694,696],{},[29,695,680],{}," in der Sidebar öffnen.",[26,698,699,700,703,704,707],{},"Unter ",[29,701,702],{},"Tags"," → ",[29,705,706],{},"Tag hinzufügen"," — Name und Farbe vergeben.",[26,709,710,711,147],{},"Im selben Panel umbenennen, umfärben oder ",[29,712,713],{},"Tag löschen",[26,715,716,717,720],{},"Steht da ",[29,718,719],{},"Noch keine Tags",", zuerst hier einen anlegen, bevor du zuweist.",[686,722,724],{"id":723},"tags-an-sounds-hängen","Tags an Sounds hängen",[14,726,727,728,730],{},"Rechtsklick auf einen Sound → ",[29,729,702],{}," (Checkboxen). Ein Sound darf mehrere Tags haben. Existieren noch keine, zeigt das Menü den Weg zum Filter-Panel.",[686,732,734],{"id":733},"board-filtern","Board filtern",[65,736,737,744,755,766],{},[26,738,739,740,743],{},"Tags im Filter-Panel oder als ",[29,741,742],{},"Chips unter der Suchleiste"," umschalten.",[26,745,746,747,750,751,754],{},"Abgleich ist ",[29,748,749],{},"ODER",": ein Sound bleibt sichtbar, wenn er ",[29,752,753],{},"irgendeinen"," gewählten Tag hat.",[26,756,757,758,761,762,765],{},"Das Feld ",[29,759,760],{},"Suche"," in der Navbar kombiniert per ",[29,763,764],{},"UND"," mit dem aktiven Tag-Filter (Tippen + Tags zusammen).",[26,767,768],{},"Chips aus (oder Filter leeren), um den ganzen Tab wieder zu sehen.",[14,770,771,772,147],{},"Farbige Tag-Namen können auf Buttons erscheinen. Schalter: ",[29,773,774],{},"Einstellungen → Verhalten → Tag-Badges anzeigen",[18,776,778],{"id":777},"sortierung","Sortierung",[14,780,781],{},"Im Filter-Panel eine Sortierung wählen:",[65,783,784,790],{},[26,785,786,789],{},[29,787,788],{},"Benutzerdefiniert"," — deine Tab-Reihenfolge, Gruppen sichtbar",[26,791,792,400,795,400,798,32,801,804,805],{},[29,793,794],{},"Name",[29,796,797],{},"Hinzugefügt",[29,799,800],{},"Spielzeit",[29,802,803],{},"Dateigröße"," — flache sortierte Liste; ",[29,806,807],{},"Gruppen sind ausgeblendet",[14,809,810],{},"Sortierung nach Dauer kann beim ersten Mal die Dauer-Metadaten vorwärmen.",[18,812,814],{"id":813},"neu-anordnen","Neu anordnen",[14,816,817,818,821,822,825,826,147],{},"Drag-and-Drop in ",[29,819,820],{},"Einstellungen → Verhalten"," einschalten (",[29,823,824],{},"Neu anordnen erlauben","). Dann Sounds und Gruppen ziehen. Neu anordnen gilt bei ",[29,827,788],{},[18,829,831],{"id":830},"mehrfachauswahl","Mehrfachauswahl",[14,833,834,836],{},[29,835,831],{}," in der Navbar einschalten, dann:",[65,838,839,842,848,854],{},[26,840,841],{},"Klick toggelt einen Sound",[26,843,844,847],{},[29,845,846],{},"Shift+Klick"," wählt einen Bereich ab dem letzten Anker",[26,849,850,853],{},[29,851,852],{},"Rahmen"," auf leerem Board ziehen",[26,855,856],{},"Klick auf leeres Board (oder außerhalb) leert die Auswahl",[14,858,859,860,400,863,400,866,869,870,147],{},"Eine Sammelleiste zeigt die Anzahl plus ",[29,861,862],{},"Farbe",[29,864,865],{},"Zu Tab verschieben…",[29,867,868],{},"Löschen"," und ",[29,871,872],{},"Fertig",[14,874,875,876,879],{},"In der Mehrfachauswahl zeigt jeder Button einen ",[29,877,878],{},"8-Zeichen-ID-Chip",". Rechtsklick auf den Chip kopiert die ID.",[18,881,883],{"id":882},"lautstärke-pro-sound","Lautstärke pro Sound",[14,885,886,887,890,891,894],{},"Rechtsklick → ",[29,888,889],{},"Lautstärke",". Slider von 0 % bis 100 %. ",[29,892,893],{},"Doppelklick"," setzt auf 100 % zurück.",[14,896,897],{},"Das stapelt sich mit der Master-Ausgangslautstärke in den Einstellungen.",[18,899,901],{"id":900},"hotkeys-und-sound-ids","Hotkeys und Sound-IDs",[14,903,904,905,908],{},"Jeder Sound hat eine 8-stellige ID. Kopieren über das Button-Kontextmenü (",[29,906,907],{},"ID kopieren",") oder den Mehrfachauswahl-Chip.",[14,910,911,914,915,918],{},[29,912,913],{},"Einstellungen → Hotkeys",": Taste an eine Sound-ID binden. Globale Hotkeys sind optional. ",[29,916,917],{},"Hotkey zuweisen"," im Kontextmenü springt dorthin, ID vorausgefüllt.",[14,920,921,922,924],{},"Dieselbe ID nutzt ",[87,923,239],{"href":238}," zum Auslösen.",[18,926,928],{"id":927},"hintergrundbilder-und-farben","Hintergrundbilder und Farben",[14,930,931,932,936],{},"Rechtsklick auf einen Sound: eigene Farben oder ein Hintergrundbild. Das ist getrennt vom ",[87,933,935],{"href":934},"\u002Fdocs\u002Ftheme-editor","Theme Creator",", der das ganze Board gestaltet.",[14,938,939,940,943],{},"Der Picker ist ein Dialog ",[29,941,942],{},"Hintergrundbild"," (PNG, JPEG, GIF, WebP):",[65,945,946,952],{},[26,947,948,951],{},[29,949,950],{},"Lokale Dateien"," — Ordner hinzufügen, einzelne Datei wählen, Dateinamen suchen, Rastervorschau, Ordner aus der Bibliothek entfernen",[26,953,954,957,958,960],{},[29,955,956],{},"KLIPY"," — GIFs online suchen. Eigenen API-Key unter ",[29,959,820],{},". Der Key landet nicht in Projektdateien.",[14,962,963],{},"Nach der Wahl Bi