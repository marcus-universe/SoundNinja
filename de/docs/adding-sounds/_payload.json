[{"data":1,"prerenderedAt":1329},["ShallowReactive",2],{"docs-page-de-\u002Fadding-sounds":3,"docs-nav-de":167},{"id":4,"title":5,"body":6,"description":158,"extension":159,"meta":160,"navigation":161,"order":162,"path":163,"seo":164,"stem":165,"__hash__":166},"content_de\u002Fadding-sounds.md","Sounds hinzufügen",{"type":7,"value":8,"toc":148},"minimark",[9,13,17,22,43,47,79,83,103,107,122,125,129,136,140],[10,11,5],"h1",{"id":12},"sounds-hinzufügen",[14,15,16],"p",{},"Ein Board bleibt leer, bis du Clips hinzufügst. SoundNinja importiert Dateien, ganze Ordner, eine Aufnahme oder ein geteiltes Soundboard-Paket.",[18,19,21],"h2",{"id":20},"audiodateien-importieren","Audiodateien importieren",[23,24,25,37,40],"ol",{},[26,27,28,32,33,36],"li",{},[29,30,31],"strong",{},"Datei → Audiodateien importieren"," oder ",[29,34,35],{},"Import"," in der Navbar.",[26,38,39],{},"Eine oder mehrere Audiodateien wählen.",[26,41,42],{},"Sounds landen im aktuellen Tab.",[18,44,46],{"id":45},"ordner-importieren","Ordner importieren",[23,48,49,58,61],{},[26,50,51,54,55,57],{},[29,52,53],{},"Datei → Ordner importieren"," (oder ",[29,56,46],{}," in der Navbar).",[26,59,60],{},"Einen oder mehrere Ordner hinzufügen. Vor dem Import per Drag neu sortieren.",[26,62,63,64],{},"Ziel wählen:\n",[65,66,67,73],"ul",{},[26,68,69,72],{},[29,70,71],{},"Als Tabs importieren"," — jeder Ordner wird ein eigener Tab",[26,74,75,78],{},[29,76,77],{},"In aktuellen Tab importieren"," — alle Dateien landen im aktiven Tab",[18,80,82],{"id":81},"clip-aufnehmen","Clip aufnehmen",[14,84,85,86,91,92,95,96,32,99,102],{},"Öffne den ",[87,88,90],"a",{"href":89},"\u002Fdocs\u002Frecording-editor","Record Editor"," über ",[29,93,94],{},"Aufnahme"," in der Player-Leiste. Aufnehmen, zuschneiden, dann ",[29,97,98],{},"Auswahl importieren",[29,100,101],{},"Alle importieren"," in den aktuellen Tab oder einen gewählten Tab.",[18,104,106],{"id":105},"soundboard-importieren","Soundboard importieren",[14,108,109,112,113,117,118,121],{},[29,110,111],{},"Datei → Soundboard importieren"," lädt ein geteiltes Paket. Pakete sind ein ",[114,115,116],"code",{},".zip"," mit ",[114,119,120],{},"project.sninja"," plus Sounddateien. Danach Projekt öffnen und abspielen.",[14,123,124],{},"Du kannst mehrere Projekte (Profile) halten. Über den Projektwähler zwischen Boards wechseln.",[18,126,128],{"id":127},"fehlende-dateien-neu-verknüpfen","Fehlende Dateien neu verknüpfen",[14,130,131,132,135],{},"Wenn Audiodateien auf der Festplatte umziehen, zeigt SoundNinja ",[29,133,134],{},"Fehlende Sounddateien",". Einen Suchordner wählen und Clips neu verknüpfen.",[18,137,139],{"id":138},"weiter","Weiter",[14,141,142,143,147],{},"Tabs, Gruppen und Hotkeys: ",[87,144,146],{"href":145},"\u002Fdocs\u002Forganizing-sounds","Sounds organisieren",".",{"title":149,"searchDepth":150,"depth":150,"links":151},"",2,[152,153,154,155,156,157],{"id":20,"depth":150,"text":21},{"id":45,"depth":150,"text":46},{"id":81,"depth":150,"text":82},{"id":105,"depth":150,"text":106},{"id":127,"depth":150,"text":128},{"id":138,"depth":150,"text":139},"Audio, Ordner, Aufnahmen und geteilte Soundboards importieren.","md",{},true,3,"\u002Fadding-sounds",{"title":5,"description":158},"adding-sounds","qhheWryk-vrNfEsQyZSumTndjdSmJPmEctxDG9Gyulk",[168,287,483,574,727,862,1005,1232],{"id":169,"title":170,"body":171,"description":280,"extension":159,"meta":281,"navigation":161,"order":282,"path":283,"seo":284,"stem":285,"__hash__":286},"content_de\u002Foverview.md","Überblick",{"type":7,"value":172,"toc":274},[173,176,179,182,185,189,203,207,238,242,252,256],[10,174,170],{"id":175},"überblick",[14,177,178],{},"SoundNinja ist ein Open-Source-Soundboard für Livestreams, Chats mit Freunden und Podcast-Aufnahmen. Es läuft auf Tauri v2 und Nuxt 4 und bleibt dabei sparsam mit RAM und Speicherplatz.",[14,180,181],{},"Das Ziel: eine große Sound-Bibliothek schnell scannen und den richtigen Clip in Millisekunden abspielen. Die Oberfläche eignet sich auch als Dashboard in VR.",[14,183,184],{},"SoundNinja steckt noch in der frühen Entwicklung. Funktionen laufen, aber nicht jede Plattform ist vollständig getestet.",[18,186,188],{"id":187},"für-wen","Für wen",[65,190,191,194,197,200],{},[26,192,193],{},"Streamer, die sofortige Sound-Cues brauchen",[26,195,196],{},"Freunde, die ein gemeinsames Board für Voice-Chat wollen",[26,198,199],{},"Podcaster, die Clips aufnehmen und aufs Board legen",[26,201,202],{},"Alle, die ein anpassbares, lokales Soundboard wollen",[18,204,206],{"id":205},"was-du-tun-kannst","Was du tun kannst",[65,208,209,212,215,218,221,224,232,235],{},[26,210,211],{},"Ein Soundboard aus eigenen Audiodateien bauen",[26,213,214],{},"Sounds in farbigen Tabs, Gruppen und über die Suche sortieren",[26,216,217],{},"Das Aussehen mit dem Theme Creator gestalten",[26,219,220],{},"PC-Audio oder Mikrofon im Record Editor aufnehmen",[26,222,223],{},"Hotkeys einzelnen Sounds zuweisen",[26,225,226,227,231],{},"Sounds über ",[87,228,230],{"href":229},"\u002Fdocs\u002Fremote-control","Bitfocus Companion"," auslösen",[26,233,234],{},"Ein komplettes Soundboard importieren und exportieren",[26,236,237],{},"GIFs oder Bilder auf Sound-Buttons legen",[18,239,241],{"id":240},"lizenz","Lizenz",[14,243,244,245,251],{},"SoundNinja ist freie Software unter ",[87,246,250],{"href":247,"rel":248},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fblob\u002Fmain\u002FLICENSE",[249],"nofollow","GPL-3.0",". Forken, ändern, teilen.",[18,253,255],{"id":254},"nächste-schritte","Nächste Schritte",[23,257,258,264,269],{},[26,259,260],{},[87,261,263],{"href":262},"\u002Fdocs\u002Finstallation","SoundNinja installieren",[26,265,266],{},[87,267,5],{"href":268},"\u002Fdocs\u002Fadding-sounds",[26,270,271],{},[87,272,273],{"href":145},"Board organisieren",{"title":149,"searchDepth":150,"depth":150,"links":275},[276,277,278,279],{"id":187,"depth":150,"text":188},{"id":205,"depth":150,"text":206},{"id":240,"depth":150,"text":241},{"id"