[{"data":1,"prerenderedAt":1618},["ShallowReactive",2],{"docs-page-de-\u002Fadding-sounds":3,"docs-nav-de":167},{"id":4,"title":5,"body":6,"description":158,"extension":159,"meta":160,"navigation":161,"order":162,"path":163,"seo":164,"stem":165,"__hash__":166},"content_de\u002Fadding-sounds.md","Sounds hinzufügen",{"type":7,"value":8,"toc":148},"minimark",[9,13,17,22,43,47,79,83,103,107,122,125,129,136,140],[10,11,5],"h1",{"id":12},"sounds-hinzufügen",[14,15,16],"p",{},"Ein Board bleibt leer, bis du Clips hinzufügst. SoundNinja importiert Dateien, ganze Ordner, eine Aufnahme oder ein geteiltes Soundboard-Paket.",[18,19,21],"h2",{"id":20},"audiodateien-importieren","Audiodateien importieren",[23,24,25,37,40],"ol",{},[26,27,28,32,33,36],"li",{},[29,30,31],"strong",{},"Datei → Audiodateien importieren"," oder ",[29,34,35],{},"Import"," in der Navbar.",[26,38,39],{},"Eine oder mehrere Audiodateien wählen.",[26,41,42],{},"Sounds landen im aktuellen Tab.",[18,44,46],{"id":45},"ordner-importieren","Ordner importieren",[23,48,49,58,61],{},[26,50,51,54,55,57],{},[29,52,53],{},"Datei → Ordner importieren"," (oder ",[29,56,46],{}," in der Navbar).",[26,59,60],{},"Einen oder mehrere Ordner hinzufügen. Vor dem Import per Drag neu sortieren.",[26,62,63,64],{},"Ziel wählen:\n",[65,66,67,73],"ul",{},[26,68,69,72],{},[29,70,71],{},"Als Tabs importieren"," — jeder Ordner wird ein eigener Tab",[26,74,75,78],{},[29,76,77],{},"In aktuellen Tab importieren"," — alle Dateien landen im aktiven Tab",[18,80,82],{"id":81},"clip-aufnehmen","Clip aufnehmen",[14,84,85,86,91,92,95,96,32,99,102],{},"Öffne den ",[87,88,90],"a",{"href":89},"\u002Fdocs\u002Frecording-editor","Record Editor"," über ",[29,93,94],{},"Aufnahme"," in der Player-Leiste. Aufnehmen, zuschneiden, dann ",[29,97,98],{},"Auswahl importieren",[29,100,101],{},"Alle importieren"," in den aktuellen Tab oder einen gewählten Tab.",[18,104,106],{"id":105},"soundboard-importieren","Soundboard importieren",[14,108,109,112,113,117,118,121],{},[29,110,111],{},"Datei → Soundboard importieren"," lädt ein geteiltes Paket. Pakete sind ein ",[114,115,116],"code",{},".zip"," mit ",[114,119,120],{},"project.sninja"," plus Sounddateien. Danach Projekt öffnen und abspielen.",[14,123,124],{},"Du kannst mehrere Projekte (Profile) halten. Über den Projektwähler zwischen Boards wechseln.",[18,126,128],{"id":127},"fehlende-dateien-neu-verknüpfen","Fehlende Dateien neu verknüpfen",[14,130,131,132,135],{},"Wenn Audiodateien auf der Festplatte umziehen, zeigt SoundNinja ",[29,133,134],{},"Fehlende Sounddateien",". Einen Suchordner wählen und Clips neu verknüpfen.",[18,137,139],{"id":138},"weiter","Weiter",[14,141,142,143,147],{},"Tabs, Tags, Filter und Hotkeys: ",[87,144,146],{"href":145},"\u002Fdocs\u002Forganizing-sounds","Sounds organisieren",".",{"title":149,"searchDepth":150,"depth":150,"links":151},"",2,[152,153,154,155,156,157],{"id":20,"depth":150,"text":21},{"id":45,"depth":150,"text":46},{"id":81,"depth":150,"text":82},{"id":105,"depth":150,"text":106},{"id":127,"depth":150,"text":128},{"id":138,"depth":150,"text":139},"Audio, Ordner, Aufnahmen und geteilte Soundboards importieren.","md",{},true,3,"\u002Fadding-sounds",{"title":5,"description":158},"adding-sounds","H_ls9_vOwDkgTWPkfe9bQz1A0XidUOmMFV4V2EJpYec",[168,296,516,607,1017,1151,1298,1521],{"id":169,"title":170,"body":171,"description":289,"extension":159,"meta":290,"navigation":161,"order":291,"path":292,"seo":293,"stem":294,"__hash__":295},"content_de\u002Foverview.md","Überblick",{"type":7,"value":172,"toc":283},[173,176,179,182,185,189,203,207,247,251,261,265],[10,174,170],{"id":175},"überblick",[14,177,178],{},"SoundNinja ist ein Open-Source-Soundboard für Livestreams, Chats mit Freunden und Podcast-Aufnahmen. Es läuft auf Tauri v2 und Nuxt 4 und bleibt dabei sparsam mit RAM und Speicherplatz.",[14,180,181],{},"Das Ziel: eine große Sound-Bibliothek schnell scannen und den richtigen Clip in Millisekunden abspielen. Die Oberfläche eignet sich auch als Dashboard in VR.",[14,183,184],{},"SoundNinja steckt noch in der frühen Entwicklung. Funktionen laufen, aber nicht jede Plattform ist vollständig getestet.",[18,186,188],{"id":187},"für-wen","Für wen",[65,190,191,194,197,200],{},[26,192,193],{},"Streamer, die sofortige Sound-Cues brauchen",[26,195,196],{},"Freunde, die ein gemeinsames Board für Voice-Chat wollen",[26,198,199],{},"Podcaster, die Clips aufnehmen und aufs Board legen",[26,201,202],{},"Alle, die ein anpassbares, lokales Soundboard wollen",[18,204,206],{"id":205},"was-du-tun-kannst","Was du tun kannst",[65,208,209,212,215,218,221,224,227,230,233,241,244],{},[26,210,211],{},"Ein Soundboard aus eigenen Audiodateien bauen",[26,213,214],{},"Sounds in farbigen Tabs, Gruppen, Tags und über die Suche sortieren",[26,216,217],{},"Nach Tags filtern (ODER) und nach Name, Datum, Dauer oder Größe sortieren",[26,219,220],{},"Mehrfachauswahl mit Rahmen oder Shift-Bereich, dann Farbe, Tab oder Löschen in einem Rutsch",[26,222,223],{},"Lautstärke pro Sound im Kontextmenü setzen",[26,225,226],{},"Das Aussehen mit dem Theme Creator gestalten",[26,228,229],{},"PC-Audio oder Mikrofon im Record Editor aufnehmen",[26,231,232],{},"Hotkeys einzelnen Sounds zuweisen",[26,234,235,236,240],{},"Sounds über ",[87,237,239],{"href":238},"\u002Fdocs\u002Fremote-control","Bitfocus Companion"," auslösen",[26,242,243],{},"Ein komplettes Soundboard importieren und exportieren",[26,245,246],{},"GIFs oder Bilder auf Sound-Buttons legen — aus lokaler Ordnerbibliothek, GifSnap oder KLIPY",[18,248,250],{"id":249},"lizenz","Lizenz",[14,252,253,254,260],{},"SoundNinja ist freie Software unter ",[87,255,259],{"href":256,"rel":257},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fblob\u002Fmain\u002FLICENSE",[258],"nofollow","GPL-3.0",". Forken, ändern, teilen.",[18,262,264],{"id":263},"nächste-schritte","Nächste Schritte",[23,266,267,273,278],{},[26,268,269],{},[87,270,272],{"href":271},"\u002Fdocs\u002Finstallation","SoundNinja installieren",[26,274,275],{},[87,276,5],{"href":277},"\u002Fdocs\u002Fadding-sounds",[26,279,280],{},[87,281,282],{"href":145},"Board organisieren",{"title":149,"searchDepth":150,"depth":150,"links":284},[285,286,287,288],{"id":187,"depth":150,"text":188},{"id":205,"depth":150,"text":206},{"id":249,"depth":150,"text":250},{"id":263,"depth":150,"text":264},"Was SoundNinja ist und was du damit machen kannst.",{},1,"\u002Foverview",{"title":170,"description":289},"overview","NKjfErgZuRFyQOJf6ppAsKHoUKCnyQ4MYR-evnuglSg",{"id":297,"title":298,"body":299,"description":511,"extension":159,"meta":512,"navigation":161,"order":150,"path":513,"seo":514,"stem":303,"__hash__":515},"content_de\u002Finstallation.md","Installation",{"type":7,"value":300,"toc":504},[301,304,318,322,342,345,349,363,366,370,394,405,409,416,420,434,464,479,500],[10,302,298],{"id":303},"installation",[14,305,306,307,311,312,317],{},"Hol dir einen Build von der ",[87,308,310],{"href":309},"\u002Fdownload","Download-Seite"," oder von ",[87,313,316],{"href":314,"rel":315},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Freleases\u002Flatest",[258],"GitHub Releases",". SoundNinja ist in früher Entwicklung — behandle Builds als Beta.",[18,319,321],{"id":320},"windows","Windows",[65,323,324,333,336,339],{},[26,325,326,32,329,332],{},[29,327,328],{},"Installer (.exe)",[29,330,331],{},"MSI (.msi)"," für 64-Bit-Windows",[26,334,335],{},"Landing-Page-Ziel: Windows 10 und neuer",[26,337,338],{},"Die App-README nennt auch Windows 8 und höher",[26,340,341],{},"Der NSIS-Installer ist dunkel. Sprache beim Setup wählen — SoundNinja merkt sie beim nächsten Start.",[14,343,344],{},"Installer starten, dann SoundNinja über das Startmenü öffnen.",[18,346,348],{"id":347},"macos","macOS",[65,350,351,357,360],{},[26,352,353,356],{},[29,354,355],{},"Universelles .dmg"," für Apple Silicon und Intel",[26,358,359],{},"Landing-Page-Ziel: macOS 10.14 und neuer",[26,361,362],{},"Die App-README nennt macOS 10.15 und höher",[14,364,365],{},"Disk-Image öffnen und SoundNinja nach Programme ziehen.",[18,367,369],{"id":368},"linux","Linux",[65,371,372,378,384,391],{},[26,373,374,377],{},[29,375,376],{},"Debian (.deb)"," für Ubuntu \u002F Debian",[26,379,380,383],{},[29,381,382],{},"AppImage"," für andere Distros",[26,385,386,387,390],{},"Nach Veröffentlichung einer Release können Arch-Nutzer ",[114,388,389],{},"soundninja-bin"," aus dem AUR installieren",[26,392,393],{},"Getestet unter Ubuntu 20.04",[14,395,396,397,400,401,404],{},"Desktop-Builds brauchen WebKit- und GTK-Pakete. Unter Debian\u002FUbuntu meist ",[114,398,399],{},"libwebkit2gtk",", ",[114,402,403],{},"libgtk-3-0"," und eine App-Indicator-Bibliothek.",[18,406,408],{"id":407},"updates","Updates",[14,410,411,412,415],{},"In der App: ",[29,413,414],{},"Hilfe → Nach Updates suchen",". Optional prüft SoundNinja beim Start in den Einstellungen.",[18,417,419],{"id":418},"aus-dem-quellcode-bauen","Aus dem Quellcode bauen",[14,421,422,423,400,428,433],{},"Eigenen Build? ",[87,424,427],{"href":425,"rel":426},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja",[258],"Repo klonen",[87,429,432],{"href":430,"rel":431},"https:\u002F\u002Fv2.tauri.app\u002Fstart\u002Fprerequisites\u002F",[258],"Tauri-Voraussetzungen"," installieren, dann:",[435,436,440],"pre",{"className":437,"code":438,"language":439,"meta":149,"style":149},"language-bash shiki shiki-themes github-light github-dark","bun install\nbun run tauri:serve\n","bash",[114,441,442,454],{"__ignoreMap":149},[443,444,446,450],"span",{"class":445,"line":291},"line",[443,447,449],{"class":448},"sScJk","bun",[443,451,453],{"class":452},"sZZnC"," install\n",[443,455,456,458,461],{"class":445,"line":150},[443,457,449],{"class":448},[443,459,460],{"class":452}," run",[443,462,463],{"class":452}," tauri:serve\n",[14,465,466,400,469,32,472,475,476,147],{},[114,467,468],{},"npm",[114,470,471],{},"pnpm",[114,473,474],{},"deno"," gehen auch. Produktionsbuild: