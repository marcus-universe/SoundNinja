 unter Windows, macOS oder Linux installieren.",{},"\u002Finstallation",{"title":298,"description":511},"OPh-0WbR2ebU9niw-poNeR6zaGWqUJm2ONgxhb61JBU",{"id":4,"title":5,"body":517,"description":158,"extension":159,"meta":605,"navigation":161,"order":162,"path":163,"seo":606,"stem":165,"__hash__":166},{"type":7,"value":518,"toc":597},[519,521,523,525,537,539,561,563,573,575,583,585,587,591,593],[10,520,5],{"id":12},[14,522,16],{},[18,524,21],{"id":20},[23,526,527,533,535],{},[26,528,529,32,531,36],{},[29,530,31],{},[29,532,35],{},[26,534,39],{},[26,536,42],{},[18,538,46],{"id":45},[23,540,541,547,549],{},[26,542,543,54,545,57],{},[29,544,53],{},[29,546,46],{},[26,548,60],{},[26,550,63,551],{},[65,552,553,557],{},[26,554,555,72],{},[29,556,71],{},[26,558,559,78],{},[29,560,77],{},[18,562,82],{"id":81},[14,564,85,565,91,567,95,569,32,571,102],{},[87,566,90],{"href":89},[29,568,94],{},[29,570,98],{},[29,572,101],{},[18,574,106],{"id":105},[14,576,577,112,579,117,581,121],{},[29,578,111],{},[114,580,116],{},[114,582,120],{},[14,584,124],{},[18,586,128],{"id":127},[14,588,131,589,135],{},[29,590,134],{},[18,592,139],{"id":138},[14,594,142,595,147],{},[87,596,146],{"href":145},{"title":149,"searchDepth":150,"depth":150,"links":598},[599,600,601,602,603,604],{"id":20,"depth":150,"text":21},{"id":45,"depth":150,"text":46},{"id":81,"depth":150,"text":82},{"id":105,"depth":150,"text":106},{"id":127,"depth":150,"text":128},{"id":138,"depth":150,"text":139},{},{"title":5,"description":158},{"id":608,"title":146,"body":609,"description":1000,"extension":159,"meta":1001,"navigation":161,"order":1002,"path":1003,"seo":1004,"stem":1005,"__hash__":1006},"content_de\u002Forganizing-sounds.md",{"type":7,"value":610,"toc":985},[611,614,621,625,651,658,662,665,679,686,692,696,706,711,742,746,752,756,790,796,800,803,829,832,836,849,853,858,878,894,901,905,916,919,923,930,940,946,950,958,965,982],[10,612,146],{"id":613},"sounds-organisieren",[14,615,616,617,620],{},"SoundNinja ist für große Bibliotheken gebaut. ",[29,618,619],{},"Tags und Filter",", Tabs, Suche, Mehrfachauswahl und Hotkeys — der Clip ist einen Klick (oder eine Taste) entfernt.",[18,622,624],{"id":623},"tabs","Tabs",[65,626,627,634,641],{},[26,628,629,630,633],{},"Tab mit ",[29,631,632],{},"Tab hinzufügen"," anlegen. Farbe vergeben, damit die Leiste schnell scannbar bleibt.",[26,635,636,637,640],{},"Die Ansicht ",[29,638,639],{},"Alle"," zeigt jeden Sound über alle Tabs.",[26,642,643,644,647,648,147],{},"Ein Sound kann ",[29,645,646],{},"einem oder mehreren Tabs"," gehören. Rechtsklick → ",[29,649,650],{},"Zu Tab verschieben",[14,652,653,654,657],{},"Tab-Übergänge: ",[29,655,656],{},"Einstellungen → Allgemein"," — Slide, Fade, Buttons nacheinander oder Keine.",[18,659,661],{"id":660},"gruppen","Gruppen",[14,663,664],{},"Seit v0.5.3 können Trenner zu benannten Gruppen werden:",[65,666,667,670,673,676],{},[26,668,669],{},"Gruppe über das Kontextmenü hinzufügen, umbenennen oder entfernen",[26,671,672],{},"Gruppenkopf ziehen — Kinder kommen mit",[26,674,675],{},"Sounds in eine Gruppe legen oder herausnehmen",[26,677,678],{},"Rahmenfarbe, Namensfarbe und Button-Ausrichtung setzen (oder Tab-Standard nutzen)",[14,680,681,682,685],{},"Ein einfacher ",[29,683,684],{},"Trenner"," geht weiter, wenn du nur einen visuellen Bruch brauchst.",[14,687,688,689,147],{},"Rechtsklick auf leeren Board-Bereich: ",[29,690,691],{},"Gruppe hinzufügen",[18,693,695],{"id":694},"tags-filter","Tags \u002F Filter",[14,697,698,699,702,703,705],{},"Tags gelten tabübergreifend. Das ausfahrbare ",[29,700,701],{},"Filter","-Panel (Sidebar ",[29,704,701],{},") ist der Ort zum Anlegen und zum Filtern des Boards.",[707,708,710],"h3",{"id":709},"tags-anlegen-und-bearbeiten","Tags anlegen und bearbeiten",[23,712,713,718,729,735],{},[26,714,715,717],{},[29,716,701],{}," in der Sidebar öffnen.",[26,719,720,721,724,725,728],{},"Unter ",[29,722,723],{},"Tags"," → ",[29,726,727],{},"Tag hinzufügen"," — Name und Farbe vergeben.",[26,730,731,732,147],{},"Im selben Panel umbenennen, umfärben oder ",[29,733,734],{},"Tag löschen",[26,736,737,738,741],{},"Steht da ",[29,739,740],{},"Noch keine Tags",", zuerst hier einen anlegen, bevor du zuweist.",[707,743,745],{"id":744},"tags-an-sounds-hängen","Tags an Sounds hängen",[14,747,748,749,751],{},"Rechtsklick auf einen Sound → ",[29,750,723],{}," (Checkboxen). Ein Sound darf mehrere Tags haben. Existieren noch keine, zeigt das Menü den Weg zum Filter-Panel.",[707,753,755],{"id":754},"board-filtern","Board filtern",[65,757,758,765,776,787],{},[26,759,760,761,764],{},"Tags im Filter-Panel oder als ",[29,762,763],{},"Chips unter der Suchleiste"," umschalten.",[26,766,767,768,771,772,775],{},"Abgleich ist ",[29,769,770],{},"ODER",": ein Sound bleibt sichtbar, wenn er ",[29,773,774],{},"irgendeinen"," gewählten Tag hat.",[26,777,778,779,782,783,786],{},"Das Feld ",[29,780,781],{},"Suche"," in der Navbar kombiniert per ",[29,784,785],{},"UND"," mit dem aktiven Tag-Filter (Tippen + Tags zusammen).",[26,788,789],{},"Chips aus (oder Filter leeren), um den ganzen Tab wieder zu sehen.",[14,791,792,793,147],{},"Farbige Tag-Namen können auf Buttons erscheinen. Schalter: ",[29,794,795],{},"Einstellungen → Verhalten → Tag-Badges anzeigen",[18,797,799],{"id":798},"sortierung","Sortierung",[14,801,802],{},"Im Filter-Panel eine Sortierung wählen:",[65,804,805,811],{},[26,806,807,810],{},[29,808,809],{},"Benutzerdefiniert"," — deine Tab-Reihenfolge, Gruppen sichtbar",[26,812,813,400,816,400,819,32,822,825,826],{},[29,814,815],{},"Name",[29,817,818],{},"Hinzugefügt",[29,820,821],{},"Spielzeit",[29,823,824],{},"Dateigröße"," — flache sortierte Liste; ",[29,827,828],{},"Gruppen sind ausgeblendet",[14,830,831],{},"Sortierung nach Dauer kann beim ersten Mal die Dauer-Metadaten vorwärmen.",[18,833,835],{"id":834},"neu-anordnen","Neu anordnen",[14,837,838,839,842,843,846,847,147],{},"Drag-and-Drop in ",[29,840,841],{},"Einstellungen → Verhalten"," einschalten (",[29,844,845],{},"Neu anordnen erlauben","). Dann Sounds und Gruppen ziehen. Neu anordnen gilt bei ",[29,848,809],{},[18,850,852],{"id":851},"mehrfachauswahl","Mehrfachauswahl",[14,854,855,857],{},[29,856,852],{}," in der Navbar einschalten, dann:",[65,859,860,863,869,875],{},[26,861,862],{},"Klick toggelt einen Sound",[26,864,865,868],{},[29,866,867],{},"Shift+Klick"," wählt einen Bereich ab dem letzten Anker",[26,870,871,874],{},[29,872,873],{},"Rahmen"," auf leerem Board ziehen",[26,876,877],{},"Klick auf leeres Board (oder außerhalb) leert die Auswahl",[14,879,880,881,400,884,400,887,890,891,147],{},"Eine Sammelleiste zeigt die Anzahl plus ",[29,882,883],{},"Farbe",[29,885,886],{},"Zu Tab verschieben…",[29,888,889],{},"Löschen"," und ",[29,892,893],{},"Fertig",[14,895,896,897,900],{},"In der Mehrfachauswahl zeigt jeder Button einen ",[29,898,899],{},"8-Zeichen-ID-Chip",". Rechtsklick auf den Chip kopiert die ID.",[18,902,904],{"id":903},"lautstärke-pro-sound","Lautstärke pro Sound",[14,906,907,908,911,912,915],{},"Rechtsklick → ",[29,909,910],{},"Lautstärke",". Slider von 0 % bis 100 %. ",[29,913,914],{},"Doppelklick"," setzt auf 100 % zurück.",[14,917,918],{},"Das stapelt sich mit der Master-Ausgangslautstärke in den Einstellungen.",[18,920,922],{"id":921},"hotkeys-und-sound-ids","Hotkeys und Sound-IDs",[14,924,925,926,929],{},"Jeder Sound hat eine 8-stellige ID. Kopieren über das Button-Kontextmenü (",[29,927,928],{},"ID kopieren",") oder den Mehrfachauswahl-Chip.",[14,931,932,935,936,939],{},[29,933,934],{},"Einstellungen → Hotkeys",": Taste an eine Sound-ID binden. Globale Hotkeys sind optional. ",[29,937,938],{},"Hotkey zuweisen"," im Kontextmenü springt dorthin, ID vorausgefüllt.",[14,941,942,943,945],{},"Dieselbe ID nutzt ",[87,944,239],{"href":238}," zum Auslösen.",[18,947,949],{"id":948},"hintergrundbilder-und-farben","Hintergrundbilder und Farben",[14,951,952,953,957],{},"Rechtsklick auf einen Sound: eigene Farben oder ein Hintergrundbild. Das ist getrennt vom ",[87,954,956],{"href":955},"\u002Fdocs\u002Ftheme-editor","Theme Creator",", der das ganze Board gestaltet.",[14,959,960,961,964],{},"Der Picker ist ein Dialog ",[29,962,963],{},"Hintergrundbild"," (PNG, JPEG, GIF, WebP):",[65,966,967,973],{},[26,968,969,972],{},[29,970,971],{},"Lokale Dateien"," — Ordner hinzufügen, einzelne Datei wählen, Dateinamen suchen, Rastervorschau, Ordner aus der Bibliothek entfernen",[26,974,975,978,979,981],{},[29,976,977],{},"KLIPY"," — GIFs online suchen. Eigenen API-Key unter ",[29,980,841],{},". Der Key landet nicht in Projektdateien.",[14,983,984],{},"Nach der Wahl Bild auf dem Button schieben und zuschneiden.",{"title":149,"searchDepth":150,"depth":150,"links":986},[987,988,989,994,995,996,997,998,999],{"id":623,"depth":150,"text":624},{"id":660,"depth":150,"text":661},{"id":694,"depth":150,"text":695,"children":990},[991,992,993],{"id":709,"depth":162,"text":710},{"id":744,"depth":162,"text":745},{"id":754,"depth":162,"text":755},{"id":798,"depth":150,"text":799},{"id":834,"depth":150,"text":835},{"id":851,"depth":150,"text":852},{"id":903,"depth":150,"text":904},{"id":921,"depth":150,"text":922},{"id":948,"depth":150,"text":949},"Tags, Filter, Tabs, Gruppen, Sortierung, Mehrfachauswahl, Lautstärke und Hotkeys.",{},4,"\u002Forganizing-sounds",{"title":146,"description":1000},"organizing-sounds","phia_N7HDS6LIgxhltoa9iRYViBzJ00ngFayO7YKdtQ",{"id":1008,"title":1009,"body":1010,"description":1135,"extension":159,"meta":1136,"navigation":161,"order":1137,"path":1138,"seo":1139,"stem":1014,"__hash__":1140},"content_de\u002Ftheme-editor.md","Theme-Editor",{"type":7,"value":1011,"toc":1129},[1012,1015,1021,1025,1052,1055,1059,1073,1077,1103,1106,1110,1115],[10,1013,1009],{"id":1014},"theme-editor",[14,1016,1017,1018,147],{},"Der Theme Creator ist der volle visuelle Editor für dein Board. Öffnen über ",[29,1019,1020],{},"Einstellungen → Allgemein → Theme Creator",[18,1022,1024],{"id":1023},"drei-tabs","Drei Tabs",[23,1026,1027,1041,1047],{},[26,1028,1029,1032,1033,1036,1037,1040],{},[29,1030,1031],{},"Allgemein"," — Theme-Name, gemeinsame Farben und Schrift-Uploads (",[114,1034,1035],{},".ttf"," \u002F ",[114,1038,1039],{},".otf",")",[26,1042,1043,1046],{},[29,1044,1045],{},"Buttons"," — Farben, Typo, Layout und GIF-Overlay der Sound-Buttons",[26,1048,1049,1051],{},[29,1050,624],{}," — Farben, Typo und Rahmenstärke der Tab-Leiste",[14,1053,1054],{},"Eine Live-Vorschau zeigt Tabs und Buttons beim Bearbeiten.",[18,1056,1058],{"id":1057},"was-du-ändern-kannst","Was du ändern kannst",[65,1060,1061,1064,1067,1070],{},[26,1062,1063],{},"Primär- und Akzentfarben, Hintergründe, Button- und Tab-Farben",[26,1065,1066],{},"Schriftfamilie und -größe für Buttons und Tabs",[26,1068,1069],{},"Button-Breite, Radius, Rahmen, Abstände und Innenabstand",[26,1071,1072],{},"GIF-Overlay-Deckkraft (normal und Hover)",[18,1074,1076],{"id":1075},"speichern-und-teilen","Speichern und teilen",[65,1078,1079,1085,1091,1097],{},[26,1080,1081,1084],{},[29,1082,1083],{},".css exportieren"," — Theme-Datei sichern oder weitergeben",[26,1086,1087,1090],{},[29,1088,1089],{},"Zu Themes hinzufügen"," — in den Themes-Ordner speichern und anwenden",[26,1092,1093,1096],{},[29,1094,1095],{},".css importieren"," — Preset oder gespeichertes Theme laden",[26,1098,1099,1102],{},[29,1100,1101],{},"Zurücksetzen"," — SoundNinja-Standard wiederherstellen",[14,1104,1105],{},"Beim Schließen mit ungespeicherten Änderungen fragt SoundNinja nach.",[18,1107,1109],{"id":1108},"ohne-vollen-editor","Ohne vollen Editor",[14,1111,720,1112,1114],{},[29,1113,656],{}," kannst du trotzdem:",[65,1116,1117,1120,1126],{},[26,1118,1119],{},"Ein Theme aus der Liste wählen",[26,1121,1122,1123,1040],{},"CSS-Variablen live bearbeiten (",[29,1124,1125],{},"Eigenes CSS",[26,1127,1128],{},"Eine Theme-Datei in den Themes-Ordner importieren",{"title":149,"searchDepth":150,"depth":150,"links":1130},[1131,1132,1133,1134],{"id":1023,"depth":150,"text":1024},{"id":1057,"depth":150,"tex