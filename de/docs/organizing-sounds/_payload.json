wählen.",[31,811,812],{},"Sounds landen im aktuellen Tab.",[23,814,816],{"id":815},"ordner-importieren","Ordner importieren",[117,818,819,828,831],{},[31,820,821,824,825,827],{},[18,822,823],{},"Datei → Ordner importieren"," (oder ",[18,826,816],{}," in der Navbar).",[31,829,830],{},"Einen oder mehrere Ordner hinzufügen. Vor dem Import per Drag neu sortieren.",[31,832,833,834],{},"Ziel wählen:\n",[28,835,836,842],{},[31,837,838,841],{},[18,839,840],{},"Als Tabs importieren"," — jeder Ordner wird ein eigener Tab",[31,843,844,847],{},[18,845,846],{},"In aktuellen Tab importieren"," — alle Dateien landen im aktiven Tab",[23,849,851],{"id":850},"clip-aufnehmen","Clip aufnehmen",[14,853,854,855,859,860,863,864,229,867,870],{},"Öffne den ",[352,856,858],{"href":857},"\u002Fdocs\u002Frecording-editor","Record Editor"," über ",[18,861,862],{},"Aufnahme"," in der Player-Leiste. Aufnehmen, zuschneiden, dann ",[18,865,866],{},"Auswahl importieren",[18,868,869],{},"Alle importieren"," in den aktuellen Tab oder einen gewählten Tab.",[23,872,874],{"id":873},"soundboard-importieren","Soundboard importieren",[14,876,877,880,881,884,885,888],{},[18,878,879],{},"Datei → Soundboard importieren"," lädt ein geteiltes Paket. Pakete sind ein ",[654,882,883],{},".zip"," mit ",[654,886,887],{},"project.sninja"," plus Sounddateien. Danach Projekt öffnen und abspielen.",[14,890,891],{},"Du kannst mehrere Projekte (Profile) halten. Über den Projektwähler zwischen Boards wechseln.",[23,893,895],{"id":894},"fehlende-dateien-neu-verknüpfen","Fehlende Dateien neu verknüpfen",[14,897,898,899,902],{},"Wenn Audiodateien auf der Festplatte umziehen, zeigt SoundNinja ",[18,900,901],{},"Fehlende Sounddateien",". Einen Suchordner wählen und Clips neu verknüpfen.",[23,904,906],{"id":905},"weiter","Weiter",[14,908,909,910,55],{},"Tabs, Tags, Filter und Hotkeys: ",[352,911,5],{"href":547},{"title":408,"searchDepth":409,"depth":409,"links":913},[914,915,916,917,918,919],{"id":794,"depth":409,"text":795},{"id