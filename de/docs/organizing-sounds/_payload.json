[{"data":1,"prerenderedAt":1767},["ShallowReactive",2],{"docs-page-de-\u002Forganizing-sounds":3,"docs-nav-de":423},{"id":4,"title":5,"body":6,"description":414,"extension":415,"meta":416,"navigation":417,"order":418,"path":419,"seo":420,"stem":421,"__hash__":422},"content_de\u002Forganizing-sounds.md","Sounds organisieren",{"type":7,"value":8,"toc":396},"minimark",[9,13,22,27,56,63,67,70,84,91,97,101,111,116,148,152,158,162,196,202,206,209,237,240,244,257,261,266,286,302,309,313,324,327,331,338,348,357,361,369,376,393],[10,11,5],"h1",{"id":12},"sounds-organisieren",[14,15,16,17,21],"p",{},"SoundNinja ist für große Bibliotheken gebaut. ",[18,19,20],"strong",{},"Tags und Filter",", Tabs, Suche, Mehrfachauswahl und Hotkeys — der Clip ist einen Klick (oder eine Taste) entfernt.",[23,24,26],"h2",{"id":25},"tabs","Tabs",[28,29,30,38,45],"ul",{},[31,32,33,34,37],"li",{},"Tab mit ",[18,35,36],{},"Tab hinzufügen"," anlegen. Farbe vergeben, damit die Leiste schnell scannbar bleibt.",[31,39,40,41,44],{},"Die Ansicht ",[18,42,43],{},"Alle"," zeigt jeden Sound über alle Tabs.",[31,46,47,48,51,52,55],{},"Ein Sound kann ",[18,49,50],{},"einem oder mehreren Tabs"," gehören. Rechtsklick → ",[18,53,54],{},"Zu Tab verschieben",".",[14,57,58,59,62],{},"Tab-Übergänge: ",[18,60,61],{},"Einstellungen → Allgemein"," — Slide, Fade, Buttons nacheinander oder Keine.",[23,64,66],{"id":65},"gruppen","Gruppen",[14,68,69],{},"Seit v0.5.3 können Trenner zu benannten Gruppen werden:",[28,71,72,75,78,81],{},[31,73,74],{},"Gruppe über das Kontextmenü hinzufügen, umbenennen oder entfernen",[31,76,77],{},"Gruppenkopf ziehen — Kinder kommen mit",[31,79,80],{},"Sounds in eine Gruppe legen oder herausnehmen",[31,82,83],{},"Rahmenfarbe, Namensfarbe und Button-Ausrichtung setzen (oder Tab-Standard nutzen)",[14,85,86,87,90],{},"Ein einfacher ",[18,88,89],{},"Trenner"," geht weiter, wenn du nur einen visuellen Bruch brauchst.",[14,92,93,94,55],{},"Rechtsklick auf leeren Board-Bereich: ",[18,95,96],{},"Gruppe hinzufügen",[23,98,100],{"id":99},"tags-filter","Tags \u002F Filter",[14,102,103,104,107,108,110],{},"Tags gelten tabübergreifend. Das ausfahrbare ",[18,105,106],{},"Filter","-Panel (Sidebar ",[18,109,106],{},") ist der Ort zum Anlegen und zum Filtern des Boards.",[112,113,115],"h3",{"id":114},"tags-anlegen-und-bearbeiten","Tags anlegen und bearbeiten",[117,118,119,124,135,141],"ol",{},[31,120,121,123],{},[18,122,106],{}," in der Sidebar öffnen.",[31,125,126,127,130,131,134],{},"Unter ",[18,128,129],{},"Tags"," → ",[18,132,133],{},"Tag hinzufügen"," — Name und Farbe vergeben.",[31,136,137,138,55],{},"Im selben Panel umbenennen, umfärben oder ",[18,139,140],{},"Tag löschen",[31,142,143,144,147],{},"Steht da ",[18,145,146],{},"Noch keine Tags",", zuerst hier einen anlegen, bevor du zuweist.",[112,149,151],{"id":150},"tags-an-sounds-hängen","Tags an Sounds hängen",[14,153,154,155,157],{},"Rechtsklick auf einen Sound → ",[18,156,129],{}," (Checkboxen). Ein Sound darf mehrere Tags haben. Existieren noch keine, zeigt das Menü den Weg zum Filter-Panel.",[112,159,161],{"id":160},"board-filtern","Board filtern",[28,163,164,171,182,193],{},[31,165,166,167,170],{},"Tags im Filter-Panel oder als ",[18,168,169],{},"Chips unter der Suchleiste"," umschalten.",[31,172,173,174,177,178,181],{},"Abgleich ist ",[18,175,176],{},"ODER",": ein Sound bleibt sichtbar, wenn er ",[18,179,180],{},"irgendeinen"," gewählten Tag hat.",[31,183,184,185,188,189,192],{},"Das Feld ",[18,186,187],{},"Suche"," in der Navbar kombiniert per ",[18,190,191],{},"UND"," mit dem aktiven Tag-Filter (Tippen + Tags zusammen).",[31,194,195],{},"Chips aus (oder Filter leeren), um den ganzen Tab wieder zu sehen.",[14,197,198,199,55],{},"Farbige Tag-Namen können auf Buttons erscheinen. Schalter: ",[18,200,201],{},"Einstellungen → Verhalten → Tag-Badges anzeigen",[23,203,205],{"id":204},"sortierung","Sortierung",[14,207,208],{},"Im Filter-Panel eine Sortierung wählen:",[28,210,211,217],{},[31,212,213,216],{},[18,214,215],{},"Benutzerdefiniert"," — deine Tab-Reihenfolge, Gruppen sichtbar",[31,218,219,222,223,222,226,229,230,233,234],{},[18,220,221],{},"Name",", ",[18,224,225],{},"Hinzugefügt",[18,227,228],{},"Spielzeit"," oder ",[18,231,232],{},"Dateigröße"," — flache sortierte Liste; ",[18,235,236],{},"Gruppen sind ausgeblendet",[14,238,239],{},"Sortierung nach Dauer kann beim ersten Mal die Dauer-Metadaten vorwärmen.",[23,241,243],{"id":242},"neu-anordnen","Neu anordnen",[14,245,246,247,250,251,254,255,55],{},"Drag-and-Drop in ",[18,248,249],{},"Einstellungen → Verhalten"," einschalten (",[18,252,253],{},"Neu anordnen erlauben","). Dann Sounds und Gruppen ziehen. Neu anordnen gilt bei ",[18,256,215],{},[23,258,260],{"id":259},"mehrfachauswahl","Mehrfachauswahl",[14,262,263,265],{},[18,264,260],{}," in der Navbar einschalten, dann:",[28,267,268,271,277,283],{},[31,269,270],{},"Klick toggelt einen Sound",[31,272,273,276],{},[18,274,275],{},"Shift+Klick"," wählt einen Bereich ab dem letzten Anker",[31,278,279,282],{},[18,280,281],{},"Rahmen"," auf leerem Board ziehen",[31,284,285],{},"Klick auf leeres Board (oder außerhalb) leert die Auswahl",[14,287,288,289,222,292,222,295,298,299,55],{},"Eine Sammelleiste zeigt die Anzahl plus ",[18,290,291],{},"Farbe",[18,293,294],{},"Zu Tab verschieben…",[18,296,297],{},"Löschen"," und ",[18,300,301],{},"Fertig",[14,303,304,305,308],{},"In der Mehrfachauswahl zeigt jeder Button einen ",[18,306,307],{},"8-Zeichen-ID-Chip",". Rechtsklick auf den Chip kopiert die ID.",[23,310,312],{"id":311},"lautstärke-pro-sound","Lautstärke pro Sound",[14,314,315,316,319,320,323],{},"Rechtsklick → ",[18,317,318],{},"Lautstärke",". Slider von 0 % bis 100 %. ",[18,321,322],{},"Doppelklick"," setzt auf 100 % zurück.",[14,325,326],{},"Das stapelt sich mit der Master-Ausgangslautstärke in den Einstellungen.",[23,328,330],{"id":329},"hotkeys-und-sound-ids","Hotkeys und Sound-IDs",[14,332,333,334,337],{},"Jeder Sound hat eine 8-stellige ID. Kopieren über das Button-Kontextmenü (",[18,335,336],{},"ID kopieren",") oder den Mehrfachauswahl-Chip.",[14,339,340,343,344,347],{},[18,341,342],{},"Einstellungen → Hotkeys",": Taste an eine Sound-ID binden. Globale Hotkeys sind optional. ",[18,345,346],{},"Hotkey zuweisen"," im Kontextmenü springt dorthin, ID vorausgefüllt.",[14,349,350,351,356],{},"Dieselbe ID nutzt ",[352,353,355],"a",{"href":354},"\u002Fdocs\u002Fremote-control","Bitfocus Companion"," zum Auslösen.",[23,358,360],{"id":359},"hintergrundbilder-und-farben","Hintergrundbilder und Farben",[14,362,363,364,368],{},"Rechtsklick auf einen Sound: eigene Farben oder ein Hintergrundbild. Das ist getrennt vom ",[352,365,367],{"href":366},"\u002Fdocs\u002Ftheme-editor","Theme Creator",", der das ganze Board gestaltet.",[14,370,371,372,375],{},"Der Picker ist ein Dialog ",[18,373,374],{},"Hintergrundbild"," (PNG, JPEG, GIF, WebP):",[28,377,378,384],{},[31,379,380,383],{},[18,381,382],{},"Lokale Dateien"," — Ordner hinzufügen, einzelne Datei wählen, Dateinamen suchen, Rastervorschau, Ordner aus der Bibliothek entfernen",[31,385,386,389,390,392],{},[18,387,388],{},"KLIPY"," — GIFs online suchen. Eigenen API-Key unter ",[18,391,249],{},". Der Key landet nicht in Projektdateien.",[14,394,395],{},"Nach der Wahl Bild auf dem Button schieben und zuschneiden.",{"title":397,"searchDepth":398,"depth":398,"links":399},"",2,[400,401,402,408,409,410,411,412,413],{"id":25,"depth":398,"text":26},{"id":65,"depth":398,"text":66},{"id":99,"depth":398,"text":100,"children":403},[404,406,407],{"id":114,"depth":405,"text":115},3,{"id":150,"depth":405,"text":151},{"id":160,"depth":405,"text":161},{"id":204,"depth":398,"text":205},{"id":242,"depth":398,"text":243},{"id":259,"depth":398,"text":260},{"id":311,"depth":398,"text":312},{"id":329,"depth":398,"text":330},{"id":359,"depth":398,"text":360},"Tags, Filter, Tabs, Gruppen, Sortierung, Mehrfachauswahl, Lautstärke und Hotkeys.","md",{},true,4,"\u002Forganizing-sounds",{"title":5,"description":414},"organizing-sounds","phia_N7HDS6LIgxhltoa9iRYViBzJ00ngFayO7YKdtQ",[424,552,772,916,1166,1300,1447,1670],{"id":425,"title":426,"body":427,"description":545,"extension":415,"meta":546,"navigation":417,"order":547,"path":548,"seo":549,"stem":550,"__hash__":551},"content_de\u002Foverview.md","Überblick",{"type":7,"value":428,"toc":539},[429,432,435,438,441,445,459,463,501,505,515,519],[10,430,426],{"id":431},"überblick",[14,433,434],{},"SoundNinja ist ein Open-Source-Soundboard für Livestreams, Chats mit Freunden und Podcast-Aufnahmen. Es läuft auf Tauri v2 und Nuxt 4 und bleibt dabei sparsam mit RAM und Speicherplatz.",[14,436,437],{},"Das Ziel: eine große Sound-Bibliothek schnell scannen und den richtigen Clip in Millisekunden abspielen. Die Oberfläche eignet sich auch als Dashboard in VR.",[14,439,440],{},"SoundNinja steckt noch in der frühen Entwicklung. Funktionen laufen, aber nicht jede Plattform ist vollständig getestet.",[23,442,444],{"id":443},"für-wen","Für wen",[28,446,447,450,453,456],{},[31,448,449],{},"Streamer, die sofortige Sound-Cues brauchen",[31,451,452],{},"Freunde, die ein gemeinsames Board für Voice-Chat wollen",[31,454,455],{},"Podcaster, die Clips aufnehmen und aufs Board legen",[31,457,458],{},"Alle, die ein anpassbares, lokales Soundboard wollen",[23,460,462],{"id":461},"was-du-tun-kannst","Was du tun kannst",[28,464,465,468,471,474,477,480,483,486,489,495,498],{},[31,466,467],{},"Ein Soundboard aus eigenen Audiodateien bauen",[31,469,470],{},"Sounds in farbigen Tabs, Gruppen, Tags und über die Suche sortieren",[31,472,473],{},"Nach Tags filtern (ODER) und nach Name, Datum, Dauer oder Größe sortieren",[31,475,476],{},"Mehrfachauswahl mit Rahmen oder Shift-Bereich, dann Farbe, Tab oder Löschen in einem Rutsch",[31,478,479],{},"Lautstärke pro Sound im Kontextmenü setzen",[31,481,482],{},"Das Aussehen mit dem Theme Creator gestalten",[31,484,485],{},"PC-Audio oder Mikrofon im Record Editor aufnehmen",[31,487,488],{},"Hotkeys einzelnen Sounds zuweisen",[31,490,491,492,494],{},"Sounds über ",[352,493,355],{"href":354}," auslösen",[31,496,497],{},"Ein komplettes Soundboard importieren und exportieren",[31,499,500],{},"GIFs oder Bilder auf Sound-Buttons legen — aus lokaler Ordnerbibliothek oder KLIPY",[23,502,504],{"id":503},"lizenz","Lizenz",[14,506,507,508,514],{},"SoundNinja ist freie Software unter ",[352,509,513],{"href":510,"rel":511},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fblob\u002Fmain\u002FLICENSE",[512],"nofollow","GPL-3.0",". Forken, ändern, teilen.",[23,516,518],{"id":517},"nächste-schritte","Nächste Schritte",[117,520,521,527,533],{},[31,522,523],{},[352,524,526],{"href":525},"\u002Fdocs\u002Finstallation","SoundNinja installieren",[31,528,529],{},[352,530,532],{"href":531},"\u002Fdocs\u002Fadding-sounds","Sounds hinzufügen",[31,534,535],{},[352,536,538],{"href":537},"\u002Fdocs\u002Forganizing-sounds","Board organisieren",{"title":397,"searchDepth":398,"depth":398,"links":540},[541,542,543,544],{"id":443,"depth":398,"text":444},{"id":461,"depth":398,"text":462},{"id":503,"depth":398,"text":504},{"id":517,"depth":398,"text":518},"Was SoundNinja ist und was du damit machen kannst.",{},1,"\u002Foverview",{"title":426,"description":545},"overview","hoyfMBw8UK5RuLBAbdnmSxP4gC163p8E8rvJgSihSXE",{"id":553,"title":554,"body":555,"description":767,"extension":415,"meta":768,"navigation":417,"order":398,"path":769,"seo":770,"stem":559,"__hash__":771},"content_de\u002Finstallation.md","Installation",{"type":7,"value":556,"toc":760},[557,560,574,578,598,601,605,619,622,626,651,661,665,672,676,690,720,735,756],[10,558,554],{"id":559},"installation",[14,561,562,563,567,568,573],{},"Hol dir einen Build von der ",[352,564,566],{"href":565},"\u002Fdownload","Download-Seite"," oder von ",[352,569,572],{"href":570,"rel":571},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Freleases\u002Flatest",[512],"GitHub Releases",". SoundNinja ist in früher Entwicklung — behandle Builds als Beta.",[23,575,577],{"id":576},"windows","Windows",[28,579,580,589,592,595],{},[31,581,582,229,585,588],{},[18,583,584],{},"Installer (.exe)",[18,586,587],{},"MSI (.msi)"," für 64-Bit-Windows",[31,590,591],{},"Landing-Page-Ziel: Windows 10 und neuer",[31,593,594],{},"Die App-README nennt auch Windows 8 und höher",[31,596,597],{},"Der NSIS-Installer ist dunkel. Sprache beim Setup wählen — SoundNinja merkt sie beim nächsten Start.",[14,599,600],{},"Installer starten, dann SoundNinja über das Startmenü öffnen.",[23,602,604],{"id":603},"macos","macOS",[28,606,607,613,616],{},[31,608,609,612],{},[18,610,611],{},"Universelles .dmg"," für Apple Silicon und Intel",[31,614,615],{},"Landing-Page-Ziel: macOS 10.14 und neuer",[31,617,618],{},"Die App-README nennt macOS 10.15 und höher",[14,620,621],{},"Disk-Image öffnen und SoundNinja nach Programme ziehen.",[23,623,625],{"id":624},"linux","Linux",[28,627,628,634,640,648],{},[31,629,630,633],{},[18,631,632],{},"Debian (.deb)"," für Ubuntu \u002F Debian",[31,635,636,639],{},[18,637,638],{},"AppImage"," für andere Distros",[31,641,642,643,647],{},"Nach Veröffentlichung einer Release können Arch-Nutzer ",[644,645,646],"code",{},"soundninja-bin"," aus dem AUR installieren",[31,649,650],{},"Getestet unter Ubuntu 20.04",[14,652,653,654,222,657,660],{},"Desktop-Builds brauchen WebKit- und GTK-Pakete. Unter Debian\u002FUbuntu meist ",[644,655,656],{},"libwebkit2gtk",[644,658,659],{},"libgtk-3-0"," und eine App-Indicator-Bibliothek.",[23,662,664],{"id":663},"updates","Updates",[14,666,667,668,671],{},"In der App: ",[18,669,670],{},"Hilfe → Nach Updates suchen",". Optional prüft SoundNinja beim Start in den Einstellungen.",[23,673,675],{"id":674},"aus-dem-quellcode-bauen","Aus dem Quellcode bauen",[14,677,678,679,222,684,689],{},"Eigenen Build? ",[352,680,683],{"href":681,"rel":682},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja",[512],"Repo klonen",[352,685,688],{"href":686,"rel":687},"https:\u002F\u002Fv2.tauri.app\u002Fstart\u002Fprerequisites\u002F",[512],"Tauri-Voraussetzungen"," installieren, dann:",[691,692,696],"pre",{"className":693,"code":694,"language":695,"meta":397,"style":397},"language-bash shiki shiki-themes github-light github-dark","bun install\nbun run tauri:serve\n","bash",[644,697,698,710],{"__ignoreMap":397},[699,700,702,706],"span",{"class":701,"line":547},"line",[699,703,705],{"class":704},"sScJk","bun",[699,707,709],{"class":708},"sZZnC"," install\n",[699,711,712,714,717],{"class":701,"line":398},[699,713,705],{"class":704},[699,715,716],{"class":708}," run",[699,718,719],{"class":708}," tauri:serve\n",[14,721,722,222,725,229,728,731,732,55],{},[644,723,724],{},"npm",[644,726,727],{},"pnpm",[644,729,730],{},"deno"," gehen auch. Produktionsbuild: ",[644,733,734],{},"bun run tauri:build",[14,736,737,740,741,746,747,750,751,55],{},[18,738,739],{},"Nur Windows:"," jeder Windows-Compile enthält ASIO über das ",[352,742,745],{"href":743,"rel":744},"https:\u002F\u002Fwww.steinberg.net\u002Fasiosdk",[512],"Steinberg ASIO SDK",". Einmal ",[644,748,749],{},"bun run setup:asio"," (SDK nicht im Git). Linux und macOS nutzen PipeWire \u002F Core Audio — diesen Schritt überspringen. Details: ",[352,752,755],{"href":753,"rel":754},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fblob\u002Fmain\u002Fdocs\u002Fbuild-from-source.md",[512],"build-from-source.md",[757,758,759],"style",{},"html pre.shiki code .sScJk, html code.shiki .sScJk{--shiki-default:#6F42C1;--shiki-dark:#B392F0}html pre.shiki code .sZZnC, html code.shiki .sZZnC{--shiki-default:#032F62;--shiki-dark:#9ECBFF}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html.dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}",{"title":397,"searchDepth":398,"depth":398,"links":761},[762,763,764,765,766],{"id":576,"depth":398,"text":577},{"id":603,"depth":398,"text":604},{"id":624,"depth":398,"text":625},{"id":663,"depth":398,"text":664},{"id":674,"depth":398,"text":675},"SoundNinja unter Windows, macOS oder Linux installieren.",{},"\u002Finstallation",{"title":554,"description":767},"OPh-0WbR2ebU9niw-poNeR6zaGWqUJm2ONgxhb61JBU",{"id":773,"title":532,"body":774,"description":910,"extension":415,"meta":911,"navigation":417,"order":405,"path":912,"seo":913,"stem":914,"__hash__":915},"content_de\u002Fadding-sounds.md",{"type":7,"value":775,"toc":902},[776,779,782,786,803,807,838,842,861,865,879,882,886,893,897],[10,777,532],{"id":778},"sounds-hinzufügen",[14,780,781],{},"Ein Board bleibt leer, bis du Clips hinzufügst. SoundNinja importiert Dateien, ganze Ordner, eine Aufnahme oder ein geteiltes Soundboard-Paket.",[23,783,785],{"id":784},"audiodateien-importieren","Audiodateien importieren",[117,787,788,797,800],{},[31,789,790,229,793,796],{},[18,791,792],{},"Datei → Audiodateien importieren",[18,794,795],{},"Import"," in der Navbar.",[31,798,799],{},"Eine oder mehrere Audiodateien wählen.",[31,801,802],{},"Sounds landen im aktuellen Tab.",[23,804,806],{"id":805},"ordner-importieren","Ordner importieren",[117,808,809,818,821],{},[31,810,811,814,815,817],{},[18,812,813],{},"Datei → Ordner importieren"," (oder ",[18,816,806],{}," in der Navbar).",[31,819,820],{},"Einen oder mehrere Ordner hinzufügen. Vor dem Import per Drag neu sortieren.",[31,822,823,824],{},"Ziel wählen:\n",[28,825,826,832],{},[31,827,828,831],{},[18,829,830],{},"Als Tabs importieren"," — jeder Ordner wird ein eigener Tab",[31,833,834,837],{},[18,835,836],{},"In aktuellen Tab importieren"," — alle Dateien landen im aktiven Tab",[23,839,841],{"id":840},"clip-aufnehmen","Clip aufnehmen",[14,843,844,845,849,850,853,854,229,857,860],{},"Öffne den ",[352,846,848],{"href":847},"\u002Fdocs\u002Frecording-editor","Record Editor"," über ",[18,851,852],{},"Aufnahme"," in der Player-Leiste. Aufnehmen, zuschneiden, dann ",[18,855,856],{},"Auswahl importieren",[18,858,859],{},"Alle importieren"," in den aktuellen Tab oder einen gewählten Tab.",[23,862,864],{"id":863},"soundboard-importieren","Soundboard importieren",[14,866,867,870,871,874,875,878],{},[18,868,869],{},"Datei → Soundboard importieren"," lädt ein geteiltes Paket. Pakete sind ein ",[644,872,873],{},".zip"," mit ",[644,876,877],{},"project.sninja"," plus Sounddateien. Danach Projekt öffnen und abspielen.",[14,880,881],{},"Du kannst mehrere Projekte (Profile) halten. Über den Projektwähler zwischen Boards wechseln.",[23,883,885],{"id":884},"fehlende-dateien-neu-verknüpfen","Fehlende Dateien neu verknüpfen",[14,887,888,889,892],{},"Wenn Audiodateien auf der Festplatte umziehen, zeigt SoundNinja ",[18,890,891],{},"Fehlende Sounddateien",". Einen Suchordner wählen und Clips neu verknüpfen.",[23,894,896],{"id":895},"weiter","Weiter",[14,898,899,900,55],{},"Tabs, Tags, Filter und Hotkeys: ",[352,901,5],{"href":537},{"title":397,"searchDepth":398,"depth":398,"links":903},[904,905,906,907,908,909],{"id":784,"depth":398,"text":785},{"id":805,"depth":398,"text":806},{"id":840,"depth":398,"text":841},{"id":863,"depth":398,"text":864},{"id":884,"depth":398,"text":885},{"id":895,"depth":398,"text":896},"Audio, Ordner, Aufnahmen und geteilte Soundboards importieren.",{},"\u002Fadding-sounds",{"title":532,"description":910},"adding-so