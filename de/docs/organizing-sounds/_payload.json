[{"data":1,"prerenderedAt":1332},["ShallowReactive",2],{"docs-page-de-\u002Forganizing-sounds":3,"docs-nav-de":172},{"id":4,"title":5,"body":6,"description":163,"extension":164,"meta":165,"navigation":166,"order":167,"path":168,"seo":169,"stem":170,"__hash__":171},"content_de\u002Forganizing-sounds.md","Sounds organisieren",{"type":7,"value":8,"toc":152},"minimark",[9,13,17,22,52,59,63,66,80,87,91,96,100,111,115,118,122,125,131,140,144],[10,11,5],"h1",{"id":12},"sounds-organisieren",[14,15,16],"p",{},"SoundNinja ist für große Bibliotheken gebaut. Tabs, Gruppen, Suche und Hotkeys — der Clip ist einen Klick (oder eine Taste) entfernt.",[18,19,21],"h2",{"id":20},"tabs","Tabs",[23,24,25,34,41],"ul",{},[26,27,28,29,33],"li",{},"Tab mit ",[30,31,32],"strong",{},"Tab hinzufügen"," anlegen. Farbe vergeben, damit die Leiste schnell scannbar bleibt.",[26,35,36,37,40],{},"Die Ansicht ",[30,38,39],{},"Alle"," zeigt jeden Sound über alle Tabs.",[26,42,43,44,47,48,51],{},"Ein Sound kann ",[30,45,46],{},"einem oder mehreren Tabs"," gehören. Rechtsklick → ",[30,49,50],{},"Zu Tab verschieben",".",[14,53,54,55,58],{},"Tab-Übergänge: ",[30,56,57],{},"Einstellungen → Allgemein"," — Slide, Fade, Buttons nacheinander oder Keine.",[18,60,62],{"id":61},"gruppen","Gruppen",[14,64,65],{},"Seit v0.5.3 können Trenner zu benannten Gruppen werden:",[23,67,68,71,74,77],{},[26,69,70],{},"Gruppe über das Kontextmenü hinzufügen, umbenennen oder entfernen",[26,72,73],{},"Gruppenkopf ziehen — Kinder kommen mit",[26,75,76],{},"Sounds in eine Gruppe legen oder herausnehmen",[26,78,79],{},"Rahmenfarbe, Namensfarbe und Button-Ausrichtung setzen (oder Tab-Standard nutzen)",[14,81,82,83,86],{},"Ein einfacher ",[30,84,85],{},"Trenner"," geht weiter, wenn du nur einen visuellen Bruch brauchst.",[18,88,90],{"id":89},"suche","Suche",[14,92,93,95],{},[30,94,90],{}," in der Navbar. Ergebnisse folgen der Eingabe.",[18,97,99],{"id":98},"neu-anordnen","Neu anordnen",[14,101,102,103,106,107,110],{},"Drag-and-Drop in ",[30,104,105],{},"Einstellungen → Verhalten"," einschalten (",[30,108,109],{},"Neu anordnen erlauben","). Dann Sounds und Gruppen ziehen.",[18,112,114],{"id":113},"sammelbearbeitung","Sammelbearbeitung",[14,116,117],{},"Mehrere Sounds markieren, dann Farbe ändern, in einen Tab schieben oder löschen.",[18,119,121],{"id":120},"hotkeys-und-sound-ids","Hotkeys und Sound-IDs",[14,123,124],{},"Jeder Sound hat eine 8-stellige ID. Kopieren über das Button-Kontextmenü oder den Mehrfachauswahl-Chip.",[14,126,127,130],{},[30,128,129],{},"Einstellungen → Hotkeys",": Taste an eine Sound-ID binden. Globale Hotkeys sind optional.",[14,132,133,134,139],{},"Dieselbe ID nutzt ",[135,136,138],"a",{"href":137},"\u002Fdocs\u002Fremote-control","Bitfocus Companion"," zum Auslösen.",[18,141,143],{"id":142},"gifs-und-farben","GIFs und Farben",[14,145,146,147,151],{},"Rechtsklick auf einen Sound: eigene Farben oder GIF-\u002FBildhintergrund. Das ist getrennt vom ",[135,148,150],{"href":149},"\u002Fdocs\u002Ftheme-editor","Theme Creator",", der das ganze Board gestaltet.",{"title":153,"searchDepth":154,"depth":154,"links":155},"",2,[156,157,158,159,160,161,162],{"id":20,"depth":154,"text":21},{"id":61,"depth":154,"text":62},{"id":89,"depth":154,"text":90},{"id":98,"depth":154,"text":99},{"id":113,"depth":154,"text":114},{"id":120,"depth":154,"text":121},{"id":142,"depth":154,"text":143},"Tabs, Gruppen, Suche, Sammelbearbeitung und Hotkeys.","md",{},true,4,"\u002Forganizing-sounds",{"title":5,"description":163},"organizing-sounds","tzbjT1L04eFyKK0nuKEVqrhA0oH5iyG-Pq9SkxEWh1w",[173,293,491,636,730,865,1008,1235],{"id":174,"title":175,"body":176,"description":286,"extension":164,"meta":287,"navigation":166,"order":288,"path":289,"seo":290,"stem":291,"__hash__":292},"content_de\u002Foverview.md","Überblick",{"type":7,"value":177,"toc":280},[178,181,184,187,190,194,208,212,241,245,255,259],[10,179,175],{"id":180},"überblick",[14,182,183],{},"SoundNinja ist ein Open-Source-Soundboard für Livestreams, Chats mit Freunden und Podcast-Aufnahmen. Es läuft auf Tauri v2 und Nuxt 4 und bleibt dabei sparsam mit RAM und Speicherplatz.",[14,185,186],{},"Das Ziel: eine große Sound-Bibliothek schnell scannen und den richtigen Clip in Millisekunden abspielen. Die Oberfläche eignet sich auch als Dashboard in VR.",[14,188,189],{},"SoundNinja steckt noch in der frühen Entwicklung. Funktionen laufen, aber nicht jede Plattform ist vollständig getestet.",[18,191,193],{"id":192},"für-wen","Für wen",[23,195,196,199,202,205],{},[26,197,198],{},"Streamer, die sofortige Sound-Cues brauchen",[26,200,201],{},"Freunde, die ein gemeinsames Board für Voice-Chat wollen",[26,203,204],{},"Podcaster, die Clips aufnehmen und aufs Board legen",[26,206,207],{},"Alle, die ein anpassbares, lokales Soundboard wollen",[18,209,211],{"id":210},"was-du-tun-kannst","Was du tun kannst",[23,213,214,217,220,223,226,229,235,238],{},[26,215,216],{},"Ein Soundboard aus eigenen Audiodateien bauen",[26,218,219],{},"Sounds in farbigen Tabs, Gruppen und über die Suche sortieren",[26,221,222],{},"Das Aussehen mit dem Theme Creator gestalten",[26,224,225],{},"PC-Audio oder Mikrofon im Record Editor aufnehmen",[26,227,228],{},"Hotkeys einzelnen Sounds zuweisen",[26,230,231,232,234],{},"Sounds über ",[135,233,138],{"href":137}," auslösen",[26,236,237],{},"Ein komplettes Soundboard importieren und exportieren",[26,239,240],{},"GIFs oder Bilder auf Sound-Buttons legen",[18,242,244],{"id":243},"lizenz","Lizenz",[14,246,247,248,254],{},"SoundNinja ist freie Software unter ",[135,249,253],{"href":250,"rel":251},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fblob\u002Fmain\u002FLICENSE",[252],"nofollow","GPL-3.0",". Forken, ändern, teilen.",[18,256,258],{"id":257},"nächste-schritte","Nächste Schritte",[260,261,262,268,274],"ol",{},[26,263,264],{},[135,265,267],{"href":266},"\u002Fdocs\u002Finstallation","SoundNinja installieren",[26,269,270],{},[135,271,273],{"href":272},"\u002Fdocs\u002Fadding-s