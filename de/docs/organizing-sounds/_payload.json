[{"data":1,"prerenderedAt":1784},["ShallowReactive",2],{"docs-page-de-\u002Forganizing-sounds":3,"docs-nav-de":434},{"id":4,"title":5,"body":6,"description":425,"extension":426,"meta":427,"navigation":428,"order":429,"path":430,"seo":431,"stem":432,"__hash__":433},"content_de\u002Forganizing-sounds.md","Sounds organisieren",{"type":7,"value":8,"toc":407},"minimark",[9,13,22,27,56,63,67,70,84,91,97,101,111,116,148,152,158,162,196,202,206,209,237,240,244,257,261,266,286,302,309,313,324,327,331,338,348,357,361,369,376,404],[10,11,5],"h1",{"id":12},"sounds-organisieren",[14,15,16,17,21],"p",{},"SoundNinja ist für große Bibliotheken gebaut. ",[18,19,20],"strong",{},"Tags und Filter",", Tabs, Suche, Mehrfachauswahl und Hotkeys — der Clip ist einen Klick (oder eine Taste) entfernt.",[23,24,26],"h2",{"id":25},"tabs","Tabs",[28,29,30,38,45],"ul",{},[31,32,33,34,37],"li",{},"Tab mit ",[18,35,36],{},"Tab hinzufügen"," anlegen. Farbe vergeben, damit die Leiste schnell scannbar bleibt.",[31,39,40,41,44],{},"Die Ansicht ",[18,42,43],{},"Alle"," zeigt jeden Sound über alle Tabs.",[31,46,47,48,51,52,55],{},"Ein Sound kann ",[18,49,50],{},"einem oder mehreren Tabs"," gehören. Rechtsklick → ",[18,53,54],{},"Zu Tab verschieben",".",[14,57,58,59,62],{},"Tab-Übergänge: ",[18,60,61],{},"Einstellungen → Allgemein"," — Slide, Fade, Buttons nacheinander oder Keine.",[23,64,66],{"id":65},"gruppen","Gruppen",[14,68,69],{},"Seit v0.5.3 können Trenner zu benannten Gruppen werden:",[28,71,72,75,78,81],{},[31,73,74],{},"Gruppe über das Kontextmenü hinzufügen, umbenennen oder entfernen",[31,76,77],{},"Gruppenkopf ziehen — Kinder kommen mit",[31,79,80],{},"Sounds in eine Gruppe legen oder herausnehmen",[31,82,83],{},"Rahmenfarbe, Namensfarbe und Button-Ausrichtung setzen (oder Tab-Standard nutzen)",[14,85,86,87,90],{},"Ein einfacher ",[18,88,89],{},"Trenner"," geht weiter, wenn du nur einen visuellen Bruch brauchst.",[14,92,93,94,55],{},"Rechtsklick auf leeren Board-Bereich: ",[18,95,96],{},"Gruppe hinzufügen",[23,98,100],{"id":99},"tags-filter","Tags \u002F Filter",[14,102,103,104,107,108,110],{},"Tags gelten tabübergreifend. Das ausfahrbare ",[18,105,106],{},"Filter","-Panel (Sidebar ",[18,109,106],{},") ist der Ort zum Anlegen und zum Filtern des Boards.",[112,113,115],"h3",{"id":114},"tags-anlegen-und-bearbeiten","Tags anlegen und bearbeiten",[117,118,119,124,135,141],"ol",{},[31,120,121,123],{},[18,122,106],{}," in der Sidebar öffnen.",[31,125,126,127,130,131,134],{},"Unter ",[18,128,129],{},"Tags"," → ",[18,132,133],{},"Tag hinzufügen"," — Name und Farbe vergeben.",[31,136,137,138,55],{},"Im selben Panel umbenennen, umfärben oder ",[18,139,140],{},"Tag löschen",[31,142,143,144,147],{},"Steht da ",[18,145,146],{},"Noch keine Tags",", zuerst hier einen anlegen, bevor du zuweist.",[112,149,151],{"id":150},"tags-an-sounds-hängen","Tags an Sounds hängen",[14,153,154,155,157],{},"Rechtsklick auf einen Sound → ",[18,156,129],{}," (Checkboxen). Ein Sound darf mehrere Tags haben. Existieren noch keine, zeigt das Menü den Weg zum Filter-Panel.",[112,159,161],{"id":160},"board-filtern","Board filtern",[28,163,164,171,182,193],{},[31,165,166,167,170],{},"Tags im Filter-Panel oder als ",[18,168,169],{},"Chips unter der Suchleiste"," umschalten.",[31,172,173,174,177,178,181],{},"Abgleich ist ",[18,175,176],{},"ODER",": ein Sound bleibt sichtbar, wenn er ",[18,179,180],{},"irgendeinen"," gewählten Tag hat.",[31,183,184,185,188,189,192],{},"Das Feld ",[18,186,187],{},"Suche"," in der Navbar kombiniert per ",[18,190,191],{},"UND"," mit dem aktiven Tag-Filter (Tippen + Tags zusammen).",[31,194,195],{},"Chips aus (oder Filter leeren), um den ganzen Tab wieder zu sehen.",[14,197,198,199,55],{},"Farbige Tag-Namen können auf Buttons erscheinen. Schalter: ",[18,200,201],{},"Einstellungen → Verhalten → Tag-Badges anzeigen",[23,203,205],{"id":204},"sortierung","Sortierung",[14,207,208],{},"Im Filter-Panel eine Sortierung wählen:",[28,210,211,217],{},[31,212,213,216],{},[18,214,215],{},"Benutzerdefiniert"," — deine Tab-Reihenfolge, Gruppen sichtbar",[31,218,219,222,223,222,226,229,230,233,234],{},[18,220,221],{},"Name",", ",[18,224,225],{},"Hinzugefügt",[18,227,228],{},"Spielzeit"," oder ",[18,231,232],{},"Dateigröße"," — flache sortierte Liste; ",[18,235,236],{},"Gruppen sind ausgeblendet",[14,238,239],{},"Sortierung nach Dauer kann beim ersten Mal die Dauer-Metadaten vorwärmen.",[23,241,243],{"id":242},"neu-anordnen","Neu anordnen",[14,245,246,247,250,251,254,255,55],{},"Drag-and-Drop in ",[18,248,249],{},"Einstellungen → Verhalten"," einschalten (",[18,252,253],{},"Neu anordnen erlauben","). Dann Sounds und Gruppen ziehen. Neu anordnen gilt bei ",[18,256,215],{},[23,258,260],{"id":259},"mehrfachauswahl","Mehrfachauswahl",[14,262,263,265],{},[18,264,260],{}," in der Navbar einschalten, dann:",[28,267,268,271,277,283],{},[31,269,270],{},"Klick toggelt einen Sound",[31,272,273,276],{},[18,274,275],{},"Shift+Klick"," wählt einen Bereich ab dem letzten Anker",[31,278,279,282],{},[18,280,281],{},"Rahmen"," auf leerem Board ziehen",[31,284,285],{},"Klick auf leeres Board (oder außerhalb) leert die Auswahl",[14,287,288,289,222,292,222,295,298,299,55],{},"Eine Sammelleiste zeigt die Anzahl plus ",[18,290,291],{},"Farbe",[18,293,294],{},"Zu Tab verschieben…",[18,296,297],{},"Löschen"," und ",[18,300,301],{},"Fertig",[14,303,304,305,308],{},"In der Mehrfachauswahl zeigt jeder Button einen ",[18,306,307],{},"8-Zeichen-ID-Chip",". Rechtsklick auf den Chip kopiert die ID.",[23,310,312],{"id":311},"lautstärke-pro-sound","Lautstärke pro Sound",[14,314,315,316,319,320,323],{},"Rechtsklick → ",[18,317,318],{},"Lautstärke",". Slider von 0 % bis 100 %. ",[18,321,322],{},"Doppelklick"," setzt auf 100 % zurück.",[14,325,326],{},"Das stapelt sich mit der Master-Ausgangslautstärke in den Einstellungen.",[23,328,330],{"id":329},"hotkeys-und-sound-ids","Hotkeys und Sound-IDs",[14,332,333,334,337],{},"Jeder Sound hat eine 8-stellige ID. Kopieren über das Button-Kontextmenü (",[18,335,336],{},"ID kopieren",") oder den Mehrfachauswahl-Chip.",[14,339,340,343,344,347],{},[18,341,342],{},"Einstellungen → Hotkeys",": Taste an eine Sound-ID binden. Globale Hotkeys sind optional. ",[18,345,346],{},"Hotkey zuweisen"," im Kontextmenü springt dorthin, ID vorausgefüllt.",[14,349,350,351,356],{},"Dieselbe ID nutzt ",[352,353,355],"a",{"href":354},"\u002Fdocs\u002Fremote-control","Bitfocus Companion"," zum Auslösen.",[23,358,360],{"id":359},"hintergrundbilder-und-farben","Hintergrundbilder und Farben",[14,362,363,364,368],{},"Rechtsklick auf einen Sound: eigene Farben oder ein Hintergrundbild. Das ist getrennt vom ",[352,365,367],{"href":366},"\u002Fdocs\u002Ftheme-editor","Theme Creator",", der das ganze Board gestaltet.",[14,370,371,372,375],{},"Der Picker ist ein Dialog ",[18,373,374],{},"Hintergrundbild"," (PNG, JPEG, GIF, WebP):",[28,377,378,384,395],{},[31,379,380,383],{},[18,381,382],{},"Lokale Dateien"," — Ordner hinzufügen, einzelne Datei wählen, Dateinamen suchen, Rastervorschau, Ordner aus der Bibliothek entfernen",[31,385,386,389,390,55],{},[18,387,388],{},"GifSnap"," — GIFs online suchen, ohne API-Key. Beim ersten Besuch musst du GifSnap-Anfragen akzeptieren; Suchergebnisse werden gecacht, um Traffic zu sparen. Siehe ",[352,391,388],{"href":392,"rel":393},"https:\u002F\u002Fgifsnap.com",[394],"nofollow",[31,396,397,400,401,403],{},[18,398,399],{},"KLIPY"," — GIFs online suchen. Eigenen API-Key unter ",[18,402,249],{},". Der Key landet nicht in Projektdateien.",[14,405,406],{},"Nach der Wahl Bild auf dem Button schieben und zuschneiden.",{"title":408,"searchDepth":409,"depth":409,"links":410},"",2,[411,412,413,419,420,421,422,423,424],{"id":25,"depth":409,"text":26},{"id":65,"depth":409,"text":66},{"id":99,"depth":409,"text":100,"children":414},[415,417,418],{"id":114,"depth":416,"text":115},3,{"id":150,"depth":416,"text":151},{"id":160,"depth":416,"text":161},{"id":204,"depth":409,"text":205},{"id":242,"depth":409,"text":243},{"id":259,"depth":409,"text":260},{"id":311,"depth":409,"text":312},{"id":329,"depth":409,"text":330},{"id":359,"depth":409,"text":360},"Tags, Filter, Tabs, Gruppen, Sortierung, Mehrfachauswahl, Lautstärke und Hotkeys.","md",{},true,4,"\u002Forganizing-sounds",{"title":5,"description":425},"organizing-sounds","jIHdo3ArhbXIxbWQI561fKtutYzeQgCkElssurn8EGo",[435,562,782,926,1183,1317,1464,1687],{"id":436,"title":437,"body":438,"description":555,"extension":426,"meta":556,"navigation":428,"order":557,"path":558,"seo":559,"stem":560,"__hash__":561},"content_de\u002Foverview.md","Überblick",{"type":7,"value":439,"toc":549},[440,443,446,449,452,456,470,474,512,516,525,529],[10,441,437],{"id":442},"überblick",[14,444,445],{},"SoundNinja ist ein Open-Source-Soundboard für Livestreams, Chats mit Freunden und Podcast-Aufnahmen. Es läuft auf Tauri v2 und Nuxt 4 und bleibt dabei sparsam mit RAM und Speicherplatz.",[14,447,448],{},"Das Ziel: eine große Sound-Bibliothek schnell scannen und den richtigen Clip in Millisekunden abspielen. Die Oberfläche eignet sich auch als Dashboard in VR.",[14,450,451],{},"SoundNinja steckt noch in der frühen Entwicklung. Funktionen laufen, aber nicht jede Plattform ist vollständig getestet.",[23,453,455],{"id":454},"für-wen","Für wen",[28,457,458,461,464,467],{},[31,459,460],{},"Streamer, die sofortige Sound-Cues brauchen",[31,462,463],{},"Freunde, die ein gemeinsames Board für Voice-Chat wollen",[31,465,466],{},"Podcaster, die Clips aufnehmen und aufs Board legen",[31,468,469],{},"Alle, die ein anpassbares, lokales Soundboard wollen",[23,471,473],{"id":472},"was-du-tun-kannst","Was du tun kannst",[28,475,476,479,482,485,488,491,494,497,500,506,509],{},[31,477,478],{},"Ein Soundboard aus eigenen Audiodateien bauen",[31,480,481],{},"Sounds in farbigen Tabs, Gruppen, Tags und über die Suche sortieren",[31,483,484],{},"Nach Tags filtern (ODER) und nach Name, Datum, Dauer oder Größe sortieren",[31,486,487],{},"Mehrfachauswahl mit Rahmen oder Shift-Bereich, dann Farbe, Tab oder Löschen in einem Rutsch",[31,489,490],{},"Lautstärke pro Sound im Kontextmenü setzen",[31,492,493],{},"Das Aussehen mit dem Theme Creator gestalten",[31,495,496],{},"PC-Audio oder Mikrofon im Record Editor aufnehmen",[31,498,499],{},"Hotkeys einzelnen Sounds zuweisen",[31,501,502,503,505],{},"Sounds über ",[352,504,355],{"href":354}," auslösen",[31,507,508],{},"Ein komplettes Soundboard importieren und exportieren",[31,510,511],{},"GIFs oder Bilder auf Sound-Buttons legen — aus lokaler Ordnerbibliothek, GifSnap oder KLIPY",[23,513,515],{"id":514},"lizenz","Lizenz",[14,517,518,519,524],{},"SoundNinja ist freie Software unter ",[352,520,523],{"href":521,"rel":522},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fblob\u002Fmain\u002FLICENSE",[394],"GPL-3.0",". Forken, ändern, teilen.",[23,526,528],{"id":527},"nächste-schritte","Nächste Schritte",[117,530,531,537,543],{},[31,532,533],{},[352,534,536],{"href":535},"\u002Fdocs\u002Finstallation","SoundNinja installieren",[31,538,539],{},[352,540,542],{"href":541},"\u002Fdocs\u002Fadding-sounds","Sounds hinzufügen",[31,544,545],{},[352,546,548],{"href":547},"\u002Fdocs\u002Forganizing-sounds","Board organisieren",{"title":408,"searchDepth":409,"depth":409,"links":550},[551,552,553,554],{"id":454,"depth":409,"text":455},{"id":472,"depth":409,"text":473},{"id":514,"depth":409,"text":515},{"id":527,"depth":409,"text":528},"Was SoundNinja ist und was du damit machen kannst.",{},1,"\u002Foverview",{"title":437,"description":555},"overview","NKjfErgZuRFyQOJf6ppAsKHoUKCnyQ4MYR-evnuglSg",{"id":563,"title":564,"body":565,"description":777,"extension":426,"meta":778,"navigation":428,"order":409,"path":779,"seo":780,"stem":569,"__hash__":781},"content_de\u002Finstallation.md","Installation",{"type":7,"value":566,"toc":770},[567,570,584,588,608,611,615,629,632,636,661,671,675,682,686,700,730,745,766],[10,568,564],{"id":569},"installation",[14,571,572,573,577,578,583],{},"Hol dir einen Build von der ",[352,574,576],{"href":575},"\u002Fdownload","Download-Seite"," oder von ",[352,579,582],{"href":580,"rel":581},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Freleases\u002Flatest",[394],"GitHub Releases",". SoundNinja ist in früher Entwicklung — behandle Builds als Beta.",[23,585,587],{"id":586},"windows","Windows",[28,589,590,599,602,605],{},[31,591,592,229,595,598],{},[18,593,594],{},"Installer (.exe)",[18,596,597],{},"MSI (.msi)"," für 64-Bit-Windows",[31,600,601],{},"Landing-Page-Ziel: Windows 10 und neuer",[31,603,604],{},"Die App-README nennt auch Windows 8 und höher",[31,606,607],{},"Der NSIS-Installer ist dunkel. Sprache beim Setup wählen — SoundNinja merkt sie beim nächsten Start.",[14,609,610],{},"Installer starten, dann SoundNinja über das Startmenü öffnen.",[23,612,614],{"id":613},"macos","macOS",[28,616,617,623,626],{},[31,618,619,622],{},[18,620,621],{},"Universelles .dmg"," für Apple Silicon und Intel",[31,624,625],{},"Landing-Page-Ziel: macOS 10.14 und neuer",[31,627,628],{},"Die App-README nennt macOS 10.15 und höher",[14,630,631],{},"Disk-Image öffnen und SoundNinja nach Programme ziehen.",[23,633,635],{"id":634},"linux","Linux",[28,637,638,644,650,658],{},[31,639,640,643],{},[18,641,642],{},"Debian (.deb)"," für Ubuntu \u002F Debian",[31,645,646,649],{},[18,647,648],{},"AppImage"," für andere Distros",[31,651,652,653,657],{},"Nach Veröffentlichung einer Release können Arch-Nutzer ",[654,655,656],"code",{},"soundninja-bin"," aus dem AUR installieren",[31,659,660],{},"Getestet unter Ubuntu 20.04",[14,662,663,664,222,667,670],{},"Desktop-Builds brauchen WebKit- und GTK-Pakete. Unter Debian\u002FUbuntu meist ",[654,665,666],{},"libwebkit2gtk",[654,668,669],{},"libgtk-3-0"," und eine App-Indicator-Bibliothek.",[23,672,674],{"id":673},"updates","Updates",[14,676,677,678,681],{},"In der App: ",[18,679,680],{},"Hilfe → Nach Updates suchen",". Optional prüft SoundNinja beim Start in den Einstellungen.",[23,683,685],{"id":684},"aus-dem-quellcode-bauen","Aus dem Quellcode bauen",[14,687,688,689,222,694,699],{},"Eigenen Build? ",[352,690,693],{"href":691,"rel":692},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja",[394],"Repo klonen",[352,695,698],{"href":696,"rel":697},"https:\u002F\u002Fv2.tauri.app\u002Fstart\u002Fprerequisites\u002F",[394],"Tauri-Voraussetzungen"," installieren, dann:",[701,702,706],"pre",{"className":703,"code":704,"language":705,"meta":408,"style":408},"language-bash shiki shiki-themes github-light github-dark","bun install\nbun run tauri:serve\n","bash",[654,707,708,720],{"__ignoreMap":408},[709,710,712,716],"span",{"class":711,"line":557},"line",[709,713,715],{"class":714},"sScJk","bun",[709,717,719],{"class":718},"sZZnC"," install\n",[709,721,722,724,727],{"class":711,"line":409},[709,723,715],{"class":714},[709,725,726],{"class":718}," run",[709,728,729],{"class":718}," tauri:serve\n",[14,731,732,222,735,229,738,741,742,55],{},[654,733,734],{},"npm",[654,736,737],{},"pnpm",[654,739,740],{},"deno"," gehen auch. Produktionsbuild: ",[654,743,744],{},"bun run tauri:build",[14,746,747,750,751,756,757,760,761,55],{},[18,748,749],{},"Nur Windows:"," jeder Windows-Compile enthält ASIO über das ",[352,752,755],{"href":753,"rel":754},"https:\u002F\u002Fwww.steinberg.net\u002Fasiosdk",[394],"Steinberg ASIO SDK",". Einmal ",[654,758,759],{},"bun run setup:asio"," (SDK nicht im Git). Linux und macOS nutzen PipeWire \u002F Core Audio — diesen Schritt überspringen. Details: ",[352,762,765],{"href":763,"rel":764},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fblob\u002Fmain\u002Fdocs\u002Fbuild-from-source.md",[394],"build-from-source.md",[767,768,769],"style",{},"html pre.shiki code .sScJk, html code.shiki .sScJk{--shiki-default:#6F42C1;--shiki-dark:#B392F0}html pre.shiki code .sZZnC, html code.shiki .sZZnC{--shiki-default:#032F62;--shiki-dark:#9ECBFF}html .default .shiki span {color: var(--shiki-default);background: var(--