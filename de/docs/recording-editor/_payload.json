1331,1339,1350],{},[38,1325,1326,1330],{},[239,1327,242],{"href":1328,"rel":1329},"https:\u002F\u002Fbitfocus.io\u002Fcompanion",[261]," installieren.",[38,1332,1333,1338],{},[239,1334,1337],{"href":1335,"rel":1336},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Freleases\u002Flatest\u002Fdownload\u002FSoundNinja-Companion.tgz",[261],"SoundNinja-Companion.tgz"," herunterladen. Es gibt noch kein Companion-Store-Paket.",[38,1340,1341,1342,1345,1346,1349],{},"In Companion: ",[18,1343,1344],{},"Modules → Load module package"," und die ",[144,1347,1348],{},".tgz"," wählen.",[38,1351,1352,1353,1356],{},"Eine ",[18,1354,1355],{},"Sound Ninja","-Verbindung anlegen. PC-IP, Port und Token eintragen.",[23,1358,1360],{"id":1359},"aktionen","Aktionen",[35,1362,1363,1369,1375],{},[38,1364,1365,1368],{},[18,1366,1367],{},"Trigger Sound"," — aus dem Live-Dropdown wählen oder 8-stellige Sound-ID tippen (Companion-Variablen gehen)",[38,1370,1371,1374],{},[18,1372,1373],{},"Stop Sound"," — einen spielenden Sound per ID stoppen",[38,1376,1377,1380],{},[18,1378,1379],{},"Stop All"," — alle spielenden Sounds stoppen",[14,1382,1383],{},"Sound-ID in SoundNinja über das Button-Kontextmenü oder den Mehrfachauswahl-Chip kopieren.",[23,1385,1387],{"id":1386},"feedbacks-und-variablen","Feedbacks und Variablen",[35,1389,1390,1396,1408,1414],{},[38,1391,1392,1395],{},[18,1393,1394],{},"Sound Playing"," — wahr, solange diese Sound-ID aktiv ist (für Button-Farbe)",[38,1397,1398,1401,1402,147,1405],{},[144,1399,1400],{},"$(soundninja:connected)"," — ",[144,1403,1404],{},"true",[144,1406,1407],{},"false",[38,1409,1410,1413],{},[144,1411,1412],{},"$(soundninja:playing_count)"," — wie viele Sounds spielen",[38,1415,1416,1419],{},[144,1417,1418],{},"$(soundninja:last_triggered)"," — zuletzt ausgelöste Sound-ID",[23,1421,1423],{"id":1422},"http-api-fortgeschritten","HTTP-API (fortgeschritten)",[14,1425,1426,1427],{},"Basispfad: ",[144,1428,1429],{},"\u002Fapi\u002Fv1",[35,1431,143