 dem Import per Drag neu sortieren.",[38,535,536,537],{},"Ziel wählen:\n",[35,538,539,545],{},[38,540,541,544],{},[18,542,543],{},"Als Tabs importieren"," — jeder Ordner wird ein eigener Tab",[38,546,547,550],{},[18,548,549],{},"In aktuellen Tab importieren"," — alle Dateien landen im aktiven Tab",[23,552,554],{"id":553},"clip-aufnehmen","Clip aufnehmen",[14,556,557,558,562,563,565,566,76,568,570],{},"Öffne den ",[226,559,561],{"href":560},"\u002Fdocs\u002Frecording-editor","Record Editor"," über ",[18,564,20],{}," in der Player-Leiste. Aufnehmen, zuschneiden, dann ",[18,567,106],{},[18,569,109],{}," in den aktuellen Tab oder einen gewählten Tab.",[23,572,574],{"id":573},"soundboard-importieren","Soundboard importieren",[14,576,577,580,581,584,585,588],{},[18,578,579],{},"Datei → Soundboard importieren"," lädt ein geteiltes Paket. Pakete sind ein ",[140,582,583],{},".zip"," mit ",[140,586,587],{},"project.sninja"," plus Sounddateien. Danach Projekt öffnen und abspielen.",[14,590,591],{},"Du kannst mehrere Projekte (Profile) halten. Über den Projektwähler zwischen Boards wechseln.",[23,593,595],{"id":594},"fehlende-dateien-neu-verknüpfen","Fehlende Dateien neu verknüpfen",[14,597,598,599,602],{},"Wenn Audiodateien auf der Festplatte umziehen, zeigt SoundNinja ",[18,600,601],{},"Fehlende Sounddateien",". Einen Suchordner wählen und Clips neu verknüpfen.",[23,604,606],{"id":605},"weiter","Weiter",[14,608,609,610,468],{},"Tabs, Gruppen und Hotkeys: ",[226,611,612],{"href":273},"Sounds organisieren",{"title":149,"searchDepth":150,"depth":150,"links":614},[615,616,617,618,619,620],{"id":497,"depth":150,"text":498},{"id":518,"depth":150,"text":519},{"id":553,"depth":150,"text":554},{"id":573,"depth":150,"text":574},{"id":594,"depth":150,"text":595},{"id":605,"depth":150,"text":606},"Audio, Ordner, Aufnahmen und geteilte Soundboards importieren.",{},3,"\u002Fadding-sounds",{"title":268,"description":621},"adding-sounds","qhheWryk-vrNfEsQyZSumTndjdSmJPmEctxDG9Gyulk",{"id":629,"title":612,"body":630,"description":774,"extension":157,"meta":775,"navigation":159,"order":776,"path":777,"seo":778,"stem":779,"__hash__":780},"content_de\u002Forganizing-sounds.md",{"type":7,"value":631,"toc":765},[632,635,638,642,668,675,679,682,696,703,707,712,716,727,731,734,738,741,747,753,757],[10,633,612],{"id":634},"sounds-organisieren",[14,636,637],{},"SoundNinja ist für große Bibliotheken gebaut. Tabs, Gruppen, Suche und Hotkeys — der Clip ist einen Klick (oder eine Taste) entfernt.",[23,639,641],{"id":640},"tabs","Tabs",[35,643,644,651,658],{},[38,645,646,647,650],{},"Tab mit ",[18,648,649],{},"Tab hinzufügen"," anlegen. Farbe vergeben, damit die Leiste schnell scannbar bleibt.",[38,652,653,654,657],{},"Die Ansicht ",[18,655,656],{},"Alle"," zeigt jeden Sound über alle Tabs.",[38,659,660,661,664,665,468],{},"Ein Sound kann ",[18,662,663],{},"einem oder mehreren Tabs"," gehören. Rechtsklick → ",[18,666,667],{},"Zu Tab verschieben",[14,669,670,671,674],{},"Tab-Übergänge: ",[18,672,673],{},"Einstellungen → Allgemein"," — Slide, Fade, Buttons nacheinander oder Keine.",[23,676,678],{"id":677},"gruppen","Gruppen",[14,680,681],{},"Seit v0.5.3 können Trenner zu benannten Gruppen werden:",[35,683,684,687,690,693],{},[38,685,686],{},"Gruppe über das Kontextmenü hinzufügen, umbenennen oder entfernen",[38,688,689],{},"Gruppenkopf ziehen — Kinder kommen mit",[38,691,692],{},"Sounds in eine Gruppe legen oder herausnehmen",[38,694,695],{},"Rahmenfarbe, Namensfarbe und Button-Ausrichtung setzen (oder Tab-Standard nutzen)",[14,697,698,699,702],{},"Ein einfacher ",[18,700,701],{},"Trenner"," geht weiter, wenn du nur einen visuellen Bruch brauchst.",[23,704,706],{"id":705},"suche","Suche",[14,708,709,711],{},[18,710,706],{}," in der Navbar. Ergebnisse folgen der Eingabe.",[23,713,715],{"id":714},"neu-anordnen","Neu anordnen",[14,717,718,719,722,723,726],{},"Drag-and-Drop in ",[18,720,721],{},"Einstellungen → Verhalten"," einschalten (",[18,724,725],{},"Neu anordnen erlauben","). Dann Sounds und Gruppen ziehen.",[23,728,730],{"id":729},"sammelbearbeitung","Sammelbearbeitung",[14,732,733],{},"Mehrere Sounds markieren, dann Farbe ändern, in einen Tab schieben oder löschen.",[23,735,737],{"id":736},"hotkeys-und-sound-ids","Hotkeys und Sound-IDs",[14,739,740],{},"Jeder Sound hat eine 8-stellige ID. Kopieren über das Button-Kontextmenü oder den Mehrfachauswahl-Chip.",[14,742,743,746],{},[18,744,745],{},"Einstellungen → Hotkeys",": Taste an eine Sound-ID binden. Globale Hotkeys sind optional.",[14,748,749,750,752],{},"Dieselbe ID nutzt ",[226,751,229],{"href":228}," zum Auslösen.",[23,754,756],{"id":755},"gifs-und-farben","GIFs und Farben",[14,758,759,760,764],{},"Rechtsklick auf einen Sound: eigene Farben oder GIF-\u002FBildhintergrund. Das ist getrennt vom ",[226,761,763],{"href":762},"\u002Fdocs\u002Ftheme-editor","Theme Creator",", der das ganze Board gestaltet.",{"title":149,"searchDepth":150,"depth":150,"links":766},[767,768,769,770,771,772,773],{"id":640,"depth":150,"text":641},{"id":677,"depth":150,"text":678},{"id":705,"depth":150,"text":706},{"id":714,"depth":150,"text":715},{"id":729,"depth":150,"text":730},{"id":736,"depth":150,"text":737},{"id":755,"depth":150,"text":756},"Tabs, Gruppen, Suche, Sammelbearbeitung und Hotkeys.",{},4,"\u002Forganizing-sounds",{"title":612,"description":774},"organizing-sounds","tzbjT1L04eFyKK0nuKEVqrhA0oH5iyG-Pq9SkxEWh1w",{"id":782,"title":783,"body":784,"description":908,"extension":157,"meta":909,"navigation":159,"order":910,"path":911,"seo":912,"stem":788,"__hash__":913},"content_de\u002Ftheme-editor.md","Theme-Editor",{"type":7,"value":785,"toc":902},[786,789,795,799,825,828,832,846,850,876,879,883,888],[10,787,783],{"id":788},"theme-editor",[14,790,791,792,468],{},"Der Theme Creator ist der volle visuelle Editor für dein Board. Öffnen über ",[18,793,794],{},"Einstellungen → Allgemein → Theme Creator",[23,796,798],{"id":797},"drei-tabs","Drei Tabs",[94,800,801,814,820],{},[38,802,803,806,80