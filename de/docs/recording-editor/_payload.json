itle":303,"description":517},"OPh-0WbR2ebU9niw-poNeR6zaGWqUJm2ONgxhb61JBU",{"id":523,"title":281,"body":524,"description":658,"extension":161,"meta":659,"navigation":163,"order":660,"path":661,"seo":662,"stem":663,"__hash__":664},"content_de\u002Fadding-sounds.md",{"type":7,"value":525,"toc":650},[526,529,532,536,553,557,588,592,608,612,626,629,633,640,644],[10,527,281],{"id":528},"sounds-hinzufügen",[14,530,531],{},"Ein Board bleibt leer, bis du Clips hinzufügst. SoundNinja importiert Dateien, ganze Ordner, eine Aufnahme oder ein geteiltes Soundboard-Paket.",[23,533,535],{"id":534},"audiodateien-importieren","Audiodateien importieren",[94,537,538,547,550],{},[38,539,540,76,543,546],{},[18,541,542],{},"Datei → Audiodateien importieren",[18,544,545],{},"Import"," in der Navbar.",[38,548,549],{},"Eine oder mehrere Audiodateien wählen.",[38,551,552],{},"Sounds landen im aktuellen Tab.",[23,554,556],{"id":555},"ordner-importieren","Ordner importieren",[94,558,559,568,571],{},[38,560,561,564,565,567],{},[18,562,563],{},"Datei → Ordner importieren"," (oder ",[18,566,556],{}," in der Navbar).",[38,569,570],{},"Einen oder mehrere Ordner hinzufügen. Vor dem Import per Drag neu sortieren.",[38,572,573,574],{},"Ziel wählen:\n",[35,575,576,582],{},[38,577,578,581],{},[18,579,580],{},"Als Tabs importieren"," — jeder Ordner wird ein eigener Tab",[38,583,584,587],{},[18,585,586],{},"In aktuellen Tab importieren"," — alle Dateien landen im aktiven Tab",[23,589,591],{"id":590},"clip-aufnehmen","Clip aufnehmen",[14,593,594,595,599,600,602,603,76,605,607],{},"Öffne den ",[239,596,598],{"href":597},"\u002Fdocs\u002Frecording-editor","Record Editor"," über ",[18,601,20],{}," in der Player-Leiste. Aufnehmen, zuschneiden, dann ",[18,604,106],{},[18,606,109],{}," in den aktuellen Tab oder einen gewählten Tab.",[23,609,611],{"id":610},"soundboard-importieren","Soundboard importieren",[14,613,614,617,618,621,622,625],{},[18,615,616],{},"Datei → Soundboard importieren"," lädt ein geteiltes Paket. Pakete sind ein ",[144,619,620],{},".zip"," mit ",[144,623,624],{},"project.sninja"," plus Sounddateien. Danach Projekt öffnen und abspielen.",[14,627,628],{},"Du kannst mehrere Projekte (Profile) halten. Über den Projektwähler zwischen Boards wechseln.",[23,630,632],{"id":631},"fehlende-dateien-neu-verknüpfen","Fehlende Dateien neu verknüpfen",[14,634,635,636,639],{},"Wenn Audiodateien auf der Festplatte umziehen, zeigt SoundNinja ",[18,637,638],{},"Fehlende Sounddateien",". Einen Suchordner wählen und Clips neu verknüpfen.",[23,641,643],{"id":642},"weiter","Weiter",[14,645,646,647,484],{},"Tabs, Tags, Filter und Hotkeys: ",[239,648,649],{"href":286},"Sounds organisieren",{"title":153,"searchDepth":154,"depth":154,"links":651},[652,653,654,655,656,657],{"id":534,"depth":154,"text":535},{"id":555,"depth":154,"text":556},{"id":590,"depth":154,"text":591},{"id":610,"depth":154,"text":611},{"id":631,"depth":154,"text":632},{"id":642,"depth":154,"text":643},"Audio, Ordner, Aufnahmen und geteilte Soundboards importieren.",{},3,"\u002Fadding-sounds",{"title":281,"description":658},"adding-sounds","H_ls9_vOwDkgTWPkfe9bQz1A0XidUOmMFV4V2EJpYec",{"id":666,"title":649,"body":667,"description":1067,"extension":161,"meta":1068,"navigation":163,"order":1069,"path":1070,"seo":1071,"stem":1072,"__hash__":1073},"content_de\u002Forganizing-sounds.md",{"type":7,"value":668,"toc":1052},[669,672,679,683,709,716,720,723,737,744,750,754,764,769,799,803,809,813,847,853,857,860,886,889,893,906,910,915,935,951,958,962,973,976,980,987,997,1003,1007,1015,1022,1049],[10,670,649],{"id":671},"sounds-organisieren",[14,673,674,675,678],{},"SoundNinja ist für große Bibliotheken gebaut. ",[18,676,677],{},"Tags und Filter",", Tabs, Suche, Mehrfachauswahl und Hotkeys — der Clip ist einen Klick (oder eine Taste) entfernt.",[23,680,682],{"id":681},"tabs","Tabs",[35,684,685,692,699],{},[38,686,687,688,691],{},"Tab mit ",[18,689,690],{},"Tab hinzufügen"," anlegen. Farbe vergeben, damit die Leiste schnell scannbar bleibt.",[38,693,694,695,698],{},"Die Ansicht ",[18,696,697],{},"Alle"," zeigt jeden Sound über alle Tabs.",[38,700,701,702,705,706,484],{},"Ein Sound kann ",[18,703,704],{},"einem oder mehreren Tabs"," gehören. Rechtsklick → ",[18,707,708],{},"Zu Tab verschieben",[14,710,711,712,715],{},"Tab-Übergänge: ",[18,713,714],{},"Einstellungen → Allgemein"," — Slide, Fade, Buttons nacheinander oder Keine.",[23,717,719],{"id":718},"gruppen","Gruppen",[14,721,722],{},"Seit v0.5.3 können Trenner zu benannten Gruppen werden:",[35,724,725,728,731,734],{},[38,726,727],{},"Gruppe über das Kontextmenü hinzufügen, umbenennen oder entfernen",[38,729,730],{},"Gruppenkopf ziehen — Kinder kommen mit",[38,732,733],{},"Sounds in eine Gruppe legen oder herausnehmen",[38,735,736],{},"Rahmenfarbe, Namensfarbe und Button-Ausrichtung setzen (oder Tab-Standard nutzen)",[14,738,739,740,743],{},"Ein einfacher ",[18,741,742],{},"Trenner"," geht weiter, wenn du nur einen visuellen Bruch brauchst.",[14,745,746,747,484],{},"Rechtsklick auf leeren Board-Bereich: ",[18,748,749],{},"Gruppe hinzufügen",[23,751,753],{"id":752},"tags-filter","Tags \u002F Filter",[14,755,756,757,760,761,763],{},"Tags gelten tabübergreifend. Das ausfahrbare ",[18,758,759],{},"Filter","-Panel (Sidebar ",[18,762,759],{},") ist der Ort zum Anlegen und zum Filtern des Boards.",[765,766,768],"h3",{"id":767},"tags-anlegen-und-bearbeiten","Tags anlegen und bearbeiten",[94,770,771,776,786,792],{},[38,772,773,775],{},[18,774,759],{}," in der Sidebar öffnen.",[38,777,29,778,781,782,785],{},[18,779,780],{},"Tags"," → ",[18,783,784],{},"Tag hinzufügen"," — Name und Farbe vergeben.",[38,787,788,789,484],{},"Im selben Panel umbenennen, umfärben oder ",[18,790,791],{},"Tag löschen",[38,793,794,795,798],{},"Steht da ",[18,796,797],{},"Noch keine Tags",", zuerst hier einen anlegen, bevor du zuweist.",[765,800,802],{"id":801},"tags-an-sounds-hängen","Tags an Sounds hängen",[14,804,805,806,808],{},"Rechtsklick auf einen Sound → ",[18,807,780],{}," (Checkboxen). Ein Sound darf mehrere Tags haben. Existieren noch keine, zeigt das Menü den Weg zum Filter-Panel.",[765,810,812],{"id":811},"board-filtern","Board filtern",[35,814,815,822,833,844],{},[38,816,817,818,821],{},"Tags im Filter-Panel oder als ",[18,819,820],{},"Chips unter der Suchleiste"," umschalten.",[38,823,824,825,828,829,832],{},"Abgleich ist ",[18,826,827],{},"ODER",": ein Sound bleibt sichtbar, wenn er ",[18,830,831],{},"irgendeinen"," gewählten Tag hat.",[38,834,835,836,839,840,843],{},"Das Feld ",[18,837,838],{},"Suche"," in der Navbar kombiniert per ",[18,841,842],{},"UND"," mit dem aktiven Tag-Filter (Tippen + Tags zusammen).",[38,845,846],{},"Chips aus (oder Filter leeren), um den ganzen Tab wieder zu sehen.",[14,848,849,850,484],{},"Farbige Tag-Namen können auf Buttons erscheinen. Schalter: ",[18,851,852],{},"Einstellungen → Verhalten → Tag-Badges anzeigen",[23,854,856],{"id":855},"sortierung","Sortierung",[14,858,859],{},"Im Filter-Panel eine Sortierung wählen:",[35,861,862,868],{},[38,863,864,867],{},[18,865,866],{},"Benutzerdefiniert"," — deine Tab-Reihenfolge, Gruppen sichtbar",[38,869,870,405,873,405,876,76,879,882,883],{},[18,871,872],{},"Name",[18,874,875],{},"Hinzugefügt",[18,877,878],{},"Spielzeit",[18,880,881],{},"Dateigröße"," — flache sortierte Liste; ",[18,884,885],{},"Gruppen sind ausgeblendet",[14,887,888],{},"Sortierung nach Dauer kann beim ersten Mal die Dauer-Metadaten vorwärmen.",[23,890,892],{"id":891},"neu-anordnen","Neu anordnen",[14,894,895,896,899,900,903,904,484],{},"Drag-and-Drop in ",[18,897,898],{},"Einstellungen → Verhalten"," einschalten (",[18,901,902],{},"Neu anordnen erlauben","). Dann Sounds und Gruppen ziehen. Neu anordnen gilt bei ",[18,905,866],{},[23,907,909],{"id":908},"mehrfachauswahl","Mehrfachauswahl",[14,911,912,914],{},[18,913,909],{}," in der Navbar einschalten, dann:",[35,916,917,920,926,932],{},[38,918,919],{},"Klick toggelt einen Sound",[38,921,922,925],{},[18,923,924],{},"Shift+Klick"," wählt einen Bereich ab dem letzten Anker",[38,927,928,931],{},[18,929,930],{},"Rahmen"," auf leerem Board ziehen",[38,933,934],{},"Klick auf leeres Board (oder außerhalb) leert die Auswahl",[14,936,937,938,405,941,405,944,947,948,484],{},"Eine Sammelleiste zeigt die Anzahl plus ",[18,939,940],{},"Farbe",[18,942,943],{},"Zu Tab verschieben…",[18,945,946],{},"Löschen"," und ",[18,949,950],{},"Fertig",[14,952,953,954,957],{},"In der Mehrfachauswahl zeigt jeder Button einen ",[18,955,956],{},"8-Zeichen-ID-Chip",". Rechtsklick auf den Chip kopiert die ID.",[23,959,961],{"id":960},"lautstärke-pro-sound","Lautstärke pro Sound",[14,963,964,965,968,969,972],{},"Rechtsklick → ",[18,966,967],{},"Lautstärke",". Slider von 0 % bis 100 %. ",[18,970,971],{},"Doppelklick"," setzt auf 100 % zurück.",[14,974,975],{},"Das stapelt sich mit der Master-Ausgangslautstärke in den Einstellungen.",[23,977,979],{"id":978},"hotkeys-und-sound-ids","Hotkeys und Sound-IDs",[14,981,982,983,986],{},"Jeder Sound hat eine 8-stellige ID. Kopieren über das Button-Kontextmenü (",[18,984,985],{},"ID kopieren",") oder den Mehrfachauswahl-Chip.",[14,988,989,992,993,996],{},[18,990,991],{},"Einstellungen → Hotkeys",": Taste an eine Sound-ID binden. Globale Hotkeys sind optional. ",[18,994,995],{},"Hotkey zuweisen"," im Kontextmenü springt dorthin, ID vorausgefüllt.",[14,998,999,1000,1002],{},"Dieselbe ID nutzt ",[239,1001,242],{"href":241}," zum Auslösen.",[23,1004,1006],{"id":1005},"hintergrundbilder-und-farben","Hintergrundbilder und Farben",[14,1008,1009,1010,1014],{},"Rechtsklick auf einen Sound: eigene Farben oder ein Hintergrundbild. Das ist getrennt vom ",[239,1011,1013],{"href":1012},"\u002Fdocs\u002Ftheme-editor","Theme Creator",", der das ganze Board gestaltet.",[14,1016,1017,1018,1021],{},"Der Picker ist ein Dialog ",[18,1019,1020],{},"Hintergrundbild"," (PNG, JPEG, GIF, WebP):",[35,1023,1024,1030,1040],{},[38,1025,1026,1029],{},[18,1027,1028],{},"Lokale Dateien"," — Ordner hinzufügen, einzelne Datei wählen, Dateinamen suchen, Rastervorschau, Ordner aus der Bibliothek entfernen",[38,1031,1032,1035,1036,484],{},[18,1033,1034],{},"GifSnap"," — GIFs online suchen, ohne API-Key. Beim ersten Besuch musst du GifSnap-Anfragen akzeptieren; Suchergebnisse werden gecacht, um Traffic zu sparen. Siehe ",[239,1037,1034],{"href":1038,"rel":1039},"https:\u002F\u002Fgifsnap.com",[261],[38,1041,1042,1045,1046,1048],{},[18,1043,1044],{},"KLIPY"," — GIFs online suchen. Eigenen API-Key unter ",[18,1047,898],{},". Der Key landet nicht in Projektdateien.",[14,1050,1051],{},"Nach der Wahl Bild auf dem Button schieben und zuschneiden.",{"title":153,"searchDepth":154,"depth":154,"links":1053},[1054,1055,1056,1061,1062,1063,1064,1065,1066],{"id":681,"depth":154,"text":682},{"id":718,"depth":154,"text":719},{"id":752,"depth":154,"text":753,"children":1057},[1058,1059,1060],{"id":767,"depth":660,"text":768},{"id":801,"depth":660,"text":802},{"id":811,"depth":660,"text":812},{"id":855,"depth":154,"text":856},{"id":891,"depth":154,"text":892},{"id":908,"depth":154,"text":909},{"id":960,"depth":154,"text":961},{"id":978,"depth":154,"text":979},{"id":1005,"depth":154,"text":1006},"Tags, Filter, Tabs, Gruppen, Sortierung, Mehrfachauswahl, Lautstärke und Hotkeys.",{},4,"\u002Forganizing-sounds",{"title":649,"description":1067},"organizing-sounds","jIHdo3ArhbXIxbWQI561fKtutYzeQgCkElssurn8EGo",{"id":1075,"title":1076,"body":1077,"description":1201,"extension":161,"meta":1202,"navigation":163,"order":1203,"path":1204,"seo":1205,"stem":1081,"__hash__":1206},"content_de\u002Ftheme-editor.md","Theme-Editor",{"type":7,"value":1078,"toc":1195},[1079,1082,1088,1092,1118,1121,1125,1139,1143,1169,1172,1176,1181],[10,1080,1076],{"id":1081},"theme-editor",[14,1083,1084,1085,484],{},"Der Theme Creator ist der volle visuelle Editor für dein Board. Öffnen über ",[18,1086,1087],{},"Einstellungen → Allgemein → Theme Creator",[23,1089,1091],{"id":1090},"drei-tabs","Drei Tabs",[94,1093,1094,1107,1113],{},[38,1095,1096,1099,1100,147,1103,1106],{},[18,1097,1098],{},"Allgemein"," — Theme-Name, gemeinsame Farben und Schrift-Uploads (",[144,1101,1102],{},".ttf",[144,1104,1105],{},".otf",")",[38,1108,1109,1112],{},[18,1110,1111],{},"Buttons"," — Farben, Typo, Layout und GIF-Overlay der Sound-Buttons",[38,1114,1115,1117],{},[18,1116,682],{}," — Farben, Typo und Rahmenstärke der Tab-Leiste",[14,1119,1120],{},"Eine Live-Vorschau zeigt Tabs und Buttons beim Bearbeiten.",[23,1122,1124],{"id":1123},"was-du-ändern-kannst","Was du ändern kannst",[35,1126,1127,1130,1133,1136],{},[38,1128,1129],{},"Primär- und Akzentfarben, Hintergründe, Button- und Tab-Farben",[38,1131,1132],{},"Schriftfamilie und -größe für Buttons und Tabs",[38,1134,1135],{},"Button-Breite, Radius, Rahmen, Abstände und Innenabstand",[38,1137,1138],{},"GIF-Overlay-Deckkraft (normal und Hover)",[23,1140,1142],{"id":1141},"speichern-und-teilen","Speichern und teilen",[35,1144,1145,1151,1157,1163],{},[38,1146,1147,1150],{},[18,1148,1149],{},".css exportieren"," — Theme-Datei sichern oder weitergeben",[38,1152,1153,1156],{},[18,1154,1155],{},"Zu Themes hinzufügen"," — in den Themes-Ordner speichern und anwenden",[38,1158,1159,1162],{},[18,1160,1161],{},".css importieren"," — Preset oder gespeichertes Theme laden",[38,1164,1165,1168],{},[18,1166,1167],{},"Zurücksetzen"," — SoundNinja-Standard wiederherstellen",[14,1170,1171],{},"Beim Schließen mit ungespeicherten Änderungen fragt SoundNinja nach.",[23,1173,1175],{"id":1174},"ohne-vollen-editor","Ohne vollen Editor",[14,1177,29,1178,1180],{},[18,1179,714],{}," kannst du trotzdem:",[35,1182,1183,1186,1192],{},[38,1184,1185],{},"Ein Theme aus der Liste wählen",[38,1187,1188,1189,1106],{},"CSS-Variablen live bearbeiten (",[18,1190,1191],{},"Eigenes CSS",[38,1193,1194],{},"Eine Theme-Datei in den Themes-Ordner importieren",{"title":153,"searchDepth":154,"depth":154,"links":1196},[1197,1198,1199,1200],{"id":1090,"depth":154,"text":1091},{"id":1123,"depth":154,"text":