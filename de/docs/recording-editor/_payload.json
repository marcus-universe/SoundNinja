mportieren","Audiodateien importieren",[94,516,517,526,529],{},[38,518,519,76,522,525],{},[18,520,521],{},"Datei → Audiodateien importieren",[18,523,524],{},"Import"," in der Navbar.",[38,527,528],{},"Eine oder mehrere Audiodateien wählen.",[38,530,531],{},"Sounds landen im aktuellen Tab.",[23,533,535],{"id":534},"ordner-importieren","Ordner importieren",[94,537,538,547,550],{},[38,539,540,543,544,546],{},[18,541,542],{},"Datei → Ordner importieren"," (oder ",[18,545,535],{}," in der Navbar).",[38,548,549],{},"Einen oder mehrere Ordner hinzufügen. Vor dem Import per Drag neu sortieren.",[38,551,552,553],{},"Ziel wählen:\n",[35,554,555,561],{},[38,556,557,560],{},[18,558,559],{},"Als Tabs importieren"," — jeder Ordner wird ein eigener Tab",[38,562,563,566],{},[18,564,565],{},"In aktuellen Tab importieren"," — alle Dateien landen im aktiven Tab",[23,568,570],{"id":569},"clip-aufnehmen","Clip aufnehmen",[14,572,573,574,578,579,581,582,76,584,586],{},"Öffne den ",[239,575,577],{"href":576},"\u002Fdocs\u002Frecording-editor","Record Editor"," über ",[18,580,20],{}," in der Player-Leiste. Aufnehmen, zuschneiden, dann ",[18,583,106],{},[18,585,109],{}," in den aktuellen Tab oder einen gewählten Tab.",[23,588,590],{"id":589},"soundboard-importieren","Soundboard importieren",[14,592,593,596,597,600,601,604],{},[18,594,595],{},"Datei → Soundboard importieren"," lädt ein geteiltes Paket. Pakete sind ein ",[144,598,599],{},".zip"," mit ",[144,602,603],{},"project.sninja"," plus Sounddateien. Danach Projekt öffnen und abspielen.",[14,606,607],{},"Du kannst mehrere Projekte (Profile) halten. Über den Projektwähler zwischen Boards wechseln.",[23,609,611],{"id":610},"fehlende-dateien-neu-verknüpfen","Fehlende Dateien neu verknüpfen",[14,613,614,615,618],{},"Wenn Audiodateien auf der Festplatte umziehen, zeigt SoundNinja ",[18,616,617],{},"Fehlende Sounddateien",". Einen Suchordner wählen und Clips neu verknüpfen.",[23,620,622],{"id":621},"weiter","Weiter",[14,624,625,626,484],{},"Tabs, Tags, Filter und Hotkeys: ",[239,627,628],{"href":286},"Sounds organisieren",{"title":153,"searchDepth":154,"depth":154,"links":630},[631,632,633,634,635,636],{"id":513,"depth":154,"text":514},{"id":534,"depth":154,"text":535},{"id":569,"depth":154,"text":570},{"id":589,"depth":154,"text":590},{"id":610,"depth":154,"text":611},{"id":621,"depth":154,"text":622},"Audio, Ordner, Aufnahmen und geteilte Soundboards importieren.",{},3,"\u002Fadding-sounds",{"title":281,"description":637},"adding-sounds","H_ls9_vOwDkgTWPkfe9bQz1A0XidUOmMFV4V2EJpYec",{"id":645,"title":628,"body":646,"description":1036,"extension":161,"meta":1037,"navigation":163,"order":1038,"path":1039,"seo":1040,"stem":1041,"__hash__":1042},"content_de\u002Forganizing-sounds.md",{"type":7,"value":647,"toc":1021},[648,651,658,662,688,695,699,702,716,723,729,733,743,748,778,782,788,792,826,832,836,839,865,868,872,885,889,894,914,930,937,941,952,955,959,966,976,982,986,994,1001,1018],[10,649,628],{"id":650},"sounds-organisieren",[14,652,653,654,657],{},"SoundNinja ist für große Bibliotheken gebaut. ",[18,655,656],{},"Tags und Filter",", Tabs, Suche, Mehrfachauswahl und Hotkeys — der Clip ist einen Klick (oder eine Taste) entfernt.",[23,659,661],{"id":660},"tabs","Tabs",[35,663,664,671,678],{},[38,665,666,667,670],{},"Tab mit ",[18,668,669],{},"Tab hinzufügen"," anlegen. Farbe vergeben, damit die Leiste schnell scannbar bleibt.",[38,672,673,674,677],{},"Die Ansicht ",[18,675,676],{},"Alle"," zeigt jeden Sound über alle Tabs.",[38,679,680,681,684,685,484],{},"Ein Sound kann ",[18,682,683],{},"einem oder mehreren Tabs"," gehören. Rechtsklick → ",[18,686,687],{},"Zu Tab verschieben",[14,689,690,691,694],{},"Tab-Übergänge: ",[18,692,693],{},"Einstellungen → Allgemein"," — Slide, Fade, Buttons nacheinander oder Keine.",[23,696,698],{"id":697},"gruppen","Gruppen",[14,700,701],{},"Seit v0.5.3 können Trenner zu benannten Gruppen werden:",[35,703,704,707,710,713],{},[38,705,706],{},"Gruppe über das Kontextmenü hinzufügen, umbenennen oder entfernen",[38,708,709],{},"Gruppenkopf ziehen — Kinder kommen mit",[38,711,712],{},"Sounds in eine Gruppe legen oder herausnehmen",[38,714,715],{},"Rahmenfarbe, Namensfarbe und Button-Ausrichtung setzen (oder Tab-Standard nutzen)",[14,717,718,719,722],{},"Ein einfacher ",[18,720,721],{},"Trenner"," geht weiter, wenn du nur einen visuellen Bruch brauchst.",[14,724,725,726,484],{},"Rechtsklick auf leeren Board-Bereich: ",[18,727,728],{},"Gruppe hinzufügen",[23,730,732],{"id":731},"tags-filter","Tags \u002F Filter",[14,734,735,736,739,740,742],{},"Tags gelten tabübergreifend. Das ausfahrbare ",[18,737,738],{},"Filter","-Panel (Sidebar ",[18,741,738],{},") ist der Ort zum Anlegen und zum Filtern des Boards.",[744,745,747],"h3",{"id":746},"tags-anlegen-und-bearbeiten","Tags anlegen und bearbeiten",[94,749,750,755,765,771],{},[38,751,752,754],{},[18,753,738],{}," in der Sidebar öffnen.",[38,756,29,757,760,761,764],{},[18,758,759],{},"Tags"," → ",[18,762,763],{},"Tag hinzufügen"," — Name und Farbe vergeben.",[38,766,767,768,484],{},"Im selben Panel umbenennen, umfärben oder ",[18,769,770],{},"Tag löschen",[38,772,773,774,777],{},"Steht da ",[18,775,776],{},"Noch keine Tags",", zuerst hier einen anlegen, bevor du zuweist.",[744,779,781],{"id":780},"tags-an-sounds-hängen","Tags an Sounds hängen",[14,783,784,785,787],{},"Rechtsklick auf einen Sound → ",[18,786,759],{}," (Checkboxen). Ein Sound darf mehrere Tags haben. Existieren noch keine, zeigt das Menü den Weg zum Filter-Panel.",[744,789,791],{"id":790},"board-filtern","Board filtern",[35,793,794,801,812,823],{},[38,795,796,797,800],{},"Tags im Filter-Panel oder als ",[18,798,799],{},"Chips unter der Suchleiste"," umschalten.",[38,802,803,804,807,808,811],{},"Abgleich ist ",[18,805,806],{},"ODER",": ein Sound bleibt sichtbar, wenn er ",[18,809,810],{},"irgendeinen"," gewählten Tag hat.",[38,813,814,815,818,819,822],{},"Das Feld ",[18,816,817],{},"Suche"," in der Navbar kombiniert per ",[18,820,821],{},"UND"," mit dem aktiven Tag-Filter (Tippen + Tags zusammen).",[38,824,825],{},"Chips aus (oder Filter leeren), um den ganzen Tab wieder zu sehen.",[14,827,828,829,484],{},"Farbige Tag-Namen können auf Buttons erscheinen. Schalter: ",[18,830,831],{},"Einstellungen → Verhalten → Tag-Badges anzeigen",[23,833,835],{"id":834},"sortierung","Sortierung",[14,837,838],{},"Im Filter-Panel eine Sortierung wählen:",[35,840,841,847],{},[38,842,843,846],{},[18,844,845],{},"Benutzerdefiniert"," — deine Tab-Reihenfolge, Gruppen sichtbar",[38,848,849,405,852,405,855,76,858,861,862],{},[18,850,851],{},"Name",[18,853,854],{},"Hinzugefügt",[18,856,857],{},"Spielzeit",[18,859,860],{},"Dateigröße"," — flache sortierte Liste; ",[18,863,864],{},"Gruppen sind ausgeblendet",[14,866,867],{},"Sortierung nach Dauer kann beim ersten Mal die Dauer-Metadaten vorwärmen.",[23,869,871],{"id":870},"neu-anordnen","Neu anordnen",[14,873,874,875,878,879,882,883,484],{},"Drag-and-Drop in ",[18,876,877],{},"Einstellungen → Verhalten"," einschalten (",[18,880,881],{},"Neu anordnen erlauben","). Dann Sounds und Gruppen ziehen. Neu anordnen gilt bei ",[18,884,845],{},[23,886,888],{"id":887},"mehrfachauswahl","Mehrfachauswahl",[14,890,891,893],{},[18,892,888],{}," in der Navbar einschalten, dann:",[35,895,896,899,905,911],{},[38,897,898],{},"Klick toggelt einen Sound",[38,900,901,904],{},[18,902,903],{},"Shift+Klick"," wählt einen Bereich ab dem letzten Anker",[38,906,907,910],{},[18,908,909],{},"Rahmen"," auf leerem Board ziehen",[38,912,913],{},"Klick auf leeres Board (oder außerhalb) leert die Auswahl",[14,915,916,917,405,920,405,923,926,927,484],{},"Eine Sammelleiste zeigt die Anzahl plus ",[18,918,919],{},"Farbe",[18,921,922],{},"Zu Tab verschieben…",[18,924,925],{},"Löschen"," und ",[18,928,929],{},"Fertig",[14,931,932,933,936],{},"In der Mehrfachauswahl zeigt jeder Button einen ",[18,934,935],{},"8-Zeichen-ID-Chip",". Rechtsklick auf den Chip kopiert die ID.",[23,938,940],{"id":939},"lautstärke-pro-sound","Lautstärke pro Sound",[14,942,943,944,947,948,951],{},"Rechtsklick → ",[18,945,946],{},"Lautstärke",". Slider von 0 % bis 100 %. ",[18,949,950],{},"Doppelklick"," setzt auf 100 % zurück.",[14,953,954],{},"Das stapelt sich mit der Master-Ausgangslautstärke in den Einstellungen.",[23,956,958],{"id":957},"hotkeys-und-sound-ids","Hotkeys und Sound-IDs",[14,960,961,962,965],{},"Jeder Sound hat eine 8-stellige ID. Kopieren über das Button-Kontextmenü (",[18,963,964],{},"ID kopieren",") oder den Mehrfachauswahl-Chip.",[14,967,968,971,972,975],{},[18,969,970],{},"Einstellungen → Hotkeys",": Taste an eine Sound-ID binden. Globale Hotkeys sind optional. ",[18,973,974],{},"Hotkey zuweisen"," im Kontextmenü springt dorthin, ID vorausgefüllt.",[14,977,978,979,981],{},"Dieselbe ID nutzt ",[239,980,242],{"href":241}," zum Auslösen.",[23,983,985],{"id":984},"hintergrundbilder-und-farben","Hintergrundbilder und Farben",[14,987,988,989,993],{},"Rechtsklick auf einen Sound: eigene Farben oder ein Hintergrundbild. Das ist getrennt vom ",[239,990,992],{"href":991},"\u002Fdocs\u002Ftheme-editor","Theme Creator",", der das ganze Board gestaltet.",[14,995,996,997,1000],{},"Der Picker ist ein Dialog ",[18,998,999],{},"Hintergrundbild"," (PNG, JPEG, GIF, WebP):",[35,1002,1003,1009],{},[38,1004,1005,1008],{},[18,1006,1007],{},"Lokale Dateien"," — Ordner hinzufügen, einzelne Datei wählen, Dateinamen suchen, Rastervorschau, Ordner aus der Bibliothek entfernen",[38,1010,1011,1014,1015,1017],{},[18,1012,1013],{},"KLIPY"," — GIFs online suchen. Eigenen API-Key unter ",[18,1016,877],{},". Der Key landet nicht in Projektdateien.",[14,1019,1020],{},"Nach der Wahl Bild auf dem Button schieben und zuschneiden.",{"title":153,"searchDepth":154,"depth":154,"links":1022},[1023,1024,1025,1030,1031,1032,1033,1034,1035],{"id":660,"depth":154,"text":661},{"id":697,"depth":154,"text":698},{"id":731,"depth":154,"text":732,"children":1026},[1027,1028,1029],{"id":746,"depth":639,"text":747},{"id":780,"de