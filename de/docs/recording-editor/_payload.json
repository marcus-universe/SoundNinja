[{"data":1,"prerenderedAt":1327},["ShallowReactive",2],{"docs-page-de-\u002Frecording-editor":3,"docs-nav-de":165},{"id":4,"title":5,"body":6,"description":156,"extension":157,"meta":158,"navigation":159,"order":160,"path":161,"seo":162,"stem":163,"__hash__":164},"content_de\u002Frecording-editor.md","Aufnahme-Editor",{"type":7,"value":8,"toc":148},"minimark",[9,13,22,27,34,56,59,63,89,93,111,115,129,136],[10,11,5],"h1",{"id":12},"aufnahme-editor",[14,15,16,17,21],"p",{},"Nimm einen Clip in SoundNinja auf, schneide ihn zu und importiere ihn in einen Tab. Öffnen über ",[18,19,20],"strong",{},"Aufnahme"," in der Player-Leiste.",[23,24,26],"h2",{"id":25},"eingang-wählen","Eingang wählen",[14,28,29,30,33],{},"Unter ",[18,31,32],{},"Einstellungen → Audio",":",[35,36,37,44,50],"ul",{},[38,39,40,43],"li",{},[18,41,42],{},"Eingabegeräte"," — Mikrofon",[38,45,46,49],{},[18,47,48],{},"Ausgabegeräte (PC-Audio)"," — Loopback dessen, was der PC spielt",[38,51,52,55],{},[18,53,54],{},"Eingangslautstärke"," — Aufnahme-Gain von 0 % bis 200 %",[14,57,58],{},"Der Aufnahme-Button nutzt das hier gewählte Gerät.",[23,60,62],{"id":61},"take-bearbeiten","Take bearbeiten",[35,64,65,68,71,80,83,86],{},[38,66,67],{},"Aufnehmen und stoppen",[38,69,70],{},"Pegelmesser beobachten",[38,72,73,76,77],{},[18,74,75],{},"Normalisieren"," oder ",[18,78,79],{},"Rauschunterdrückung",[38,81,82],{},"Ganzen Clip trimmen, auf Auswahl trimmen oder Auswahl löschen",[38,84,85],{},"Rückgängig \u002F Wiederholen",[38,87,88],{},"Rein- und rauszoomen",[23,90,92],{"id":91},"stagen-und-importieren","Stagen und importieren",[94,95,96,99,102],"ol",{},[38,97,98],{},"Auswahl oder ganzen Track zur Staging-Liste hinzufügen.",[38,100,101],{},"Die Liste startet leer: aufnehmen, bearbeiten, dann Clip hinzufügen.",[38,103,104,76,107,110],{},[18,105,106],{},"Auswahl importieren",[18,108,109],{},"Alle importieren"," in den aktuellen oder einen gewählten Tab.",[23,112,114],{"id":113},"stem-trennung-optional","Stem-Trennung (optional)",[14,116,117,118,76,121,124,125,128],{},"Der Aufnahme-Editor kann ",[18,119,120],{},"Gesang",[18,122,123],{},"Musik"," mit BS-RoFormer behalten. Das Modell ist etwa 158 MB und ",[18,126,127],{},"nicht"," im App-Paket.",[14,130,131,132,135],{},"Download unter ",[18,133,134],{},"Einstellungen → Stem-Trennung"," oder über den Erststart-Hinweis. Der Windows-Installer kann den Download beim ersten Start anbieten.",[14,137,138,139,143,144,147],{},"Source-Builds mit Stems brauchen extra Flags (",[140,141,142],"code",{},"tauri:serve:stems"," \u002F ",[140,145,146],{},"tauri:build:stems",").",{"title":149,"searchDepth":150,"depth":150,"links":151},"",2,[152,153,154,155],{"id":25,"depth":150,"text":26},{"id":61,"depth":150,"text":62},{"id":91,"depth":150,"text":92},{"id":113,"depth":150,"text":114},"Mikrofon oder PC-Audio aufnehmen, den Clip bearbeiten und aufs Board legen.","md",{},true,6,"\u002Frecording-editor",{"title":5,"description":156},"recording-editor","WVCwz-omL8qKJNJ8MUyps_pAkR6JqyXAMaleiMXsCq0",[166,288,485,628,781,914,1007,1230],{"id":167,"title":168,"body":169,"description":281,"extension":157,"meta":282,"navigation":159,"order":283,"path":284,"seo":285,"stem":286,"__hash__":287},"content_de\u002Foverview.md","Überblick",{"type":7,"value":170,"toc":275},[171,174,177,180,183,187,201,205,237,241,251,255],[10,172,168],{"id":173},"überblick",[14,175,176],{},"SoundNinja ist ein Open-Source-Soundboard für Livestreams, Chats mit Freunden und Podcast-Aufnahmen. Es läuft auf Tauri v2 und Nuxt 4 und bleibt dabei sparsam mit RAM und Speicherplatz.",[14,178,179],{},"Das Ziel: eine große Sound-Bibliothek schnell scannen und den richtigen Clip in Millisekunden abspielen. Die Oberfläche eignet sich auch als Dashboard in VR.",[14,181,182],{},"SoundNinja steckt noch in der frühen Entwicklung. Funktionen laufen, aber nicht jede Plattform ist vollständig getestet.",[23,184,186],{"id":185},"für-wen","Für wen",[35,188,189,192,195,198],{},[38,190,191],{},"Streamer, die sofortige Sound-Cues brauchen",[38,193,194],{},"Freunde, die ein gemeinsames Board für Voice-Chat wollen",[38,196,197],{},"Podcaster, die Clips aufnehmen und aufs Board legen",[38,199,200],{},"Alle, die ein anpassbares, lokales Soundboard wollen",[23,202,204],{"id":203},"was-du-tun-kannst","Was du tun kannst",[35,206,207,210,213,216,219,222,231,234],{},[38,208,209],{},"Ein Soundboard aus eigenen Audiodateien bauen",[38,211,212],{},"Sounds in farbigen Tabs, Gruppen und über die Suche sortieren",[38,214,215],{},"Das Aussehen mit dem Theme Creator gestalten",[38,217,218],{},"PC-Audio oder Mikrofon im Record Editor aufnehmen",[38,220,221],{},"Hotkeys einzelnen Sounds zuweisen",[38,223,224,225,230],{},"Sounds über ",[226,227,229],"a",{"href":228},"\u002Fdocs\u002Fremote-control","Bitfocus Companion"," auslösen",[38,232,233],{},"Ein komplettes Soundboard importieren und exportieren",[38,235,236],{},"GIFs oder Bilder auf Sound-Buttons legen",[23,238,240],{"id":239},"lizenz","Lizenz",[14,242,243,244,250],{},"SoundNinja ist freie Software unter ",[226,245,249],{"href":246,"rel":247},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fblob\u002Fmain\u002FLICENSE",[248],"nofollow","GPL-3.0",". Forken, ändern, teilen.",[23,252,254],{"id":253},"nächste-schritte","Nächste Schritte",[94,256,257,263,269],{},[38,258,259],{},[226,260,262],{"href":261},"\u002Fdocs\u002Finstallation","SoundNinja installieren",[38,264,265],{},[226,266,268],{"href":267},"\u002Fdocs\u002Fadding-sounds","Sounds hinzufügen",[38,270,271],{},[226,272,274],{"href":273},"\u002Fdocs\u002Forganizing-sounds","Board organisieren",{"title":149,"searchDepth":150,"depth":150,"links":276},[277,278,279,280],{"id":185,"depth":150,"text":186},{"id":203,"depth":150,"text":204},{"id":239,"depth":150,"text":240},{"id":253,"depth":150,"text":254},"Was SoundNinja ist und was du damit machen kannst.",{},1,"\u002Foverview",{"title":168,"description":281},"overview","k9vdLuByV0_2FJs4S1c2pJgDzzqDtddQcqK9KQYpZ8M",{"id"