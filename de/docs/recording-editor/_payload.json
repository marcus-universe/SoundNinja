8,1312,1313],{},"Einstellungen → Remote"," öffnen.",[38,1316,1317,1318,484],{},"Remote-Server aktivieren. Standardport ist ",[18,1319,1320],{},"7331",[38,1322,1323,1324,484],{},"Optional: Token setzen. Clients senden ihn als Bearer-Token oder ",[144,1325,1326],{},"?token=",[38,1328,1329,1332,1333,1336],{},[144,1330,1331],{},"http:\u002F\u002FIP:PORT"," kopieren oder die System-IP unter ",[18,1334,1335],{},"Einstellungen → Über"," holen.",[14,1338,1339],{},"Windows kann beim ersten Start eine Firewall-Abfrage zeigen. Zugriff im privaten Netz erlauben.",[23,1341,242],{"id":1342},"bitfocus-companion",[94,1344,1345,1352,1360,1371],{},[38,1346,1347,1351],{},[239,1348,242],{"href":1349,"rel":1350},"https:\u002F\u002Fbitfocus.io\u002Fcompanion",[261]," installieren.",[38,1353,1354,1359],{},[239,1355,1358],{"href":1356,"rel":1357},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002Fcompanion-module-soundninja\u002Freleases\u002Flatest",[261],"SoundNinja-Companion.tgz"," herunterladen. Es gibt noch kein Companion-Store-Paket.",[38,1361,1362,1363,1366,1367,1370],{},"In Companion: ",[18,1364,1365],{},"Modules → Load module package"," und die ",[144,1368,1369],{},".tgz"," wählen.",[38,1372,1373,1374,1377],{},"Eine ",[18,1375,1376],{},"Sound Ninja","-Verbindung anlegen. PC-IP, Port und Token eintragen.",[23,1379,1381],{"id":1380},"aktionen","Aktionen",[35,1383,1384,1390,1396],{},[38,1385,1386,1389],{},[18,1387,1388],{},"Trigger Sound"," — aus dem Live-Dropdown wählen oder 8-stellige Sound-ID tippen (Companion-Variablen gehen)",[38,1391,1392,1395],{},[18,1393,1394],{},"Stop Sound"," — einen spielenden Sound per ID stoppen",[38,1397,1398,1401],{},[18,1399,1400],{},"Stop All"," — alle spielenden Sounds stoppen",[14,1403,1404],{},"Sound-ID in SoundNinja über das Button-Kontextmenü oder den Mehrfachauswahl-Chip kopieren.",[23,1406,1408],{"id":1407},"feedbacks-und-variablen","Feedbacks und Variablen",[35,1410,1411,1417,1429,1435],{},[38,1412,1413,1416],{},[18,1414,1415],{},"Sound Playing"," — wahr, solange diese Sound-ID aktiv ist (für Button-Farbe)",[38,1418,1419,1422,1423,147,1426],{},[144,1420,1421],{},"$(soundninja:connected)"," — ",[144,1424,1425],{},"true",[144,1427,1428],{},"false",[38,1430,1431,1434],{},[144,1432,1433],{},"$(soundninja:playing_count)"," — wie viele Sounds spielen",[38,1436,1437,1440],{},[144,1438,1439],{},"$(soundninja:last_triggered)"," — zuletzt ausgelöste Sound-ID",[23,1442,1444],{"id":1443},"http-api-fortgeschritten","HTTP-API (fortgeschritten)",[14,1446,1447,1448],{},"Basispfad: ",[144,1449,1450],{},"\u002Fapi\u002Fv1",[35,1452,1453,1459,1465,1471,1480,1486,1495],{},[38,1454,1455,1458],{},[144,1456,1457],{},"GET \u002Finfo"," — App-Name, Version, Protokoll, ob ein Token nötig ist",[38,1460,1461,1464],{},[144,1462,1463],{},"GET \u002Fsounds"," — Soundliste (id, name, tabs, active)",[38,1466,1467,1470],{},[144,1468,1469],{},"GET \u002Fstate"," — Sounds plus gerade spielende IDs",[38,1472,1473,621,1476,1479],{},[144,1474,1475],{},"POST \u002Ftrigger",[144,1477,1478],{},"{ \"id\" }"," — Sound abspielen",[38,1481,1482,1485],{},[144,1483,1484],{},"GET \u002Ftrigger\u002F:id"," — abspielen (einfach im Browser testen)",[38,1487,1488,1491,1492,1494],{},[144,1489,1490],{},"POST \u002Fstop"," mit optionalem ",[144,1493,1478],{}," — einen Sound oder alle stoppen",[38,1496,1497,1500],{},[144,1498,1499],{},"GET \u002Fws"," — Live-Status; Trigger\u002FStop eingehend senden",{"title":153,"searchDepth":154,"depth":154,"links":1502},[1503,1504,1505,1506,1507],{"id":1305,"depth":154,"text":1306},{"id":1342,"depth":154,"text":242},{"id":1380,"depth":154,"text":1381},{"id":1407,"depth":154,"text":1408},{"id":1443,"depth":154,"text":1444},"SoundNinja über das lokale Netz mit Bitfocus Companion auslösen.",{},7,"\u002Fremote-control",{"title":1294,"description":1508},"remote-control","pzsqq4CZS4ZlSf2WDcYK0UyO02dUISTU454C3gbbJFw",{"id":1516,"title":1517,"body":1518,"description":1606,"extension":161,"meta":1607,"navigation":163,"order":