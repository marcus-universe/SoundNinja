onal)",[14,116,117,118,121,122,76,125,128],{},"Offizielle Windows-, macOS- und Linux-Release-Builds enthalten das ",[18,119,120],{},"Stems","-Feature. Der Aufnahme-Editor kann ",[18,123,124],{},"Gesang",[18,126,127],{},"Musik"," mit BS-RoFormer behalten.",[14,130,131,132,135,136,139],{},"Das Modell ist etwa 158 MB und ",[18,133,134],{},"nicht"," im Installer. Download unter ",[18,137,138],{},"Einstellungen → Stem-Trennung"," oder über den Erststart-Hinweis. Der Windows-Installer kann den Download beim ersten Start anbieten.",[14,141,142,143,147,148,151],{},"Eigene Source-Builds brauchen extra Flags (",[144,145,146],"code",{},"tauri:serve:stems"," \u002F ",[144,149,150],{},"tauri:build:stems",").",{"title":153,"searchDepth":154,"depth":154,"links":155},"",2,[156,157,158,159],{"id":25,"depth":154,"text":26},{"id":61,"depth":154,"text":62},{"id":91,"depth":154,"text":92},{"id":113,"depth":154,"text":114},"Mikrofon oder PC-Audio aufnehmen, den Clip bearbeiten und aufs Board legen.","md",{},true,6,"\u002Frecording-editor",{"title":5,"description":160},"recording-editor","mBUN6yUiwk-kNjhsf48NlWEXXhjw6cOuSAkybSa9wi0",[170,301,522,665,1074,1207,1302,1525],{"id":171,"title":172,"body":173,"description":294,"extension":161,"meta":295,"navigation":163,"order":296,"path":297,"seo":298,"stem":299,"__hash__":300},"content_de\u002Foverview.md","Überblick",{"type":7,"value":174,"toc":288},[175,178,181,184,187,191,205,209,250,254,264,268],[10,176,172],{"id":177},"überblick",[14,179,180],{},"SoundNinja ist ein Open-Source-Soundboard für Livestreams, Chats mit Freunden und Podcast-Aufnahmen. Es läuft auf Tauri v2 und Nuxt 4 und bleibt dabei sparsam mit RAM und Speicherplatz.",[14,182,183],{},"Das Ziel: eine große Sound-Bibliothek schnell scannen und den richtigen Clip in Millisekunden abspielen. Die Oberfläche eignet sich auch als Dashboard in VR.",[14,185,186],{},"SoundNinja steckt noch in der frühen Entwicklung. Funktionen laufen, aber nicht jede Plattform ist vollständig getestet.",[23,188,190],{"id":189},"für-wen","Für wen",[35,192,193,196,199,202],{},[38,194,195],{},"Streamer, die sofortige Sound-Cues brauchen",[38,197,198],{},"Freunde, die ein gemeinsames Board für Voice-Chat wollen",[38,200,201],{},"Podcaster, die Clips aufnehmen und aufs Board legen",[38,203,204],{},"Alle, die ein anpassbares, lokales Soundboard wollen",[23,206,208],{"id":207},"was-du-tun-kannst","Was du tun kannst",[35,210,211,214,217,220,223,226,229,232,235,244,247],{},[38,212,213],{},"Ein Soundboard aus eigenen Audiodateien bauen",[38,215,216],{},"Sounds in farbigen Tabs, Gruppen, Tags und über die Suche sortieren",[38,218,219],{},"Nach Tags filtern (ODER) und nach Name, Datum, Dauer oder Größe sortieren",[38,221,222],{},"Mehrfachauswahl mit Rahmen oder Shift-Bereich, dann Farbe, Tab oder Löschen in einem Rutsch",[38,224,225],{},"Lautstärke pro Sound im Kontextmenü setzen",[38,227,228],{},"Das Aussehen mit dem Theme Creator gestalten",[38,230,231],{},"PC-Audio oder Mikrofon im Record Editor aufnehmen",[38,233,234],{},"Hotkeys einzelnen Sounds zuweisen",[38,236,237,238,243],{},"Sounds über ",[239,240,242],"a",{"href":241},"\u002Fdocs\u002Fremote-control","Bitfocus Companion"," auslösen",[38,245,246],{},"Ein komplettes Soundboard importieren und exportieren",[38,248,249],{},"GIFs oder Bilder auf Sound-Buttons legen — aus lokaler Ordnerbibliothek, GifSnap oder KLIPY",[23,251,253],{"id":252},"lizenz","Lizenz",[14,255,256,257,263],{},"SoundNinja ist freie Software unter ",[239,258,262],{"href":259,"rel":260},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Fblob\u002Fmain\u002FLICENSE",[261],"nofollow","GPL-3.0",". Forken, ändern, teilen.",[23,265,267],{"id":266},"nächste-schritte","Nächste Schritte",[94,269,270,276,282],{},[38,271,272],{},[239,273,275],{"href":274},"\u002Fdocs\u002Finstallation","SoundNinja installieren",[38,277,278],{},[239,279,281],{"href":280},"\u002Fdocs\u002Fadding-sounds","Sounds hinzufügen",[38,283,284],{},[239,285,287],{"href":286},"\u002Fdocs\u002Forganizing-sounds","Board organisieren",{"title":153,"searchDepth":154,"depth":154,"links":289},[290,291,292,293],{"id":189,"depth":154,"text":190},{"id":207,"depth":154,"text":208},{"id":252,"depth":154,"text":253},{"id":266,"depth":154,"text":267},"Was SoundNinja ist und was du damit machen kannst.",{},1,"\u002Foverview",{"title":172,"description":294},"overview","NKjfErgZuRFyQOJf6ppAsKHoUKCnyQ4MYR-evnuglSg",{"id":302,"title":303,"body":304,"description":517,"extension":161,"meta":518,"navigation":163,"order":154,"path":519,"seo":520,"stem":308,"__hash__":521},"content_de\u002Finstallation.md","Installation",{"type":7,"value":305,"toc":510},[306,309,323,327,347,350,354,368,371,375,399,410,414,421,425,439,469,485,506],[10,307,303],{"id":308},"installation",[14,310,311,312,316,317,322],{},"Hol dir einen Build von der ",[239,313,315],{"href":314},"\u002Fdownload","Download-Seite"," oder von ",[239,318,321],{"href":319,"rel":320},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja\u002Freleases\u002Flatest",[261],"GitHub Releases",". SoundNinja ist in früher Entwicklung — behandle Builds als Beta.",[23,324,326],{"id":325},"windows","Windows",[35,328,329,338,341,344],{},[38,330,331,76,334,337],{},[18,332,333],{},"Installer (.exe)",[18,335,336],{},"MSI (.msi)"," für 64-Bit-Windows",[38,339,340],{},"Landing-Page-Ziel: Windows 10 und neuer",[38,342,343],{},"Die App-README nennt auch Windows 8 und höher",[38,345,346],{},"Der NSIS-Installer ist dunkel. Sprache beim Setup wählen — SoundNinja merkt sie beim nächsten Start.",[14,348,349],{},"Installer starten, dann SoundNinja über das Startmenü öffnen.",[23,351,353],{"id":352},"macos","macOS",[35,355,356,362,365],{},[38,357,358,361],{},[18,359,360],{},"Universelles .dmg"," für Apple Silicon und Intel",[38,363,364],{},"Landing-Page-Ziel: macOS 10.14 und neuer",[38,366,367],{},"Die App-README nennt macOS 10.15 und höher",[14,369,370],{},"Disk-Image öffnen und SoundNinja nach Programme ziehen.",[23,372,374],{"id":373},"linux","Linux",[35,376,377,383,389,396],{},[38,378,379,382],{},[18,380,381],{},"Debian (.deb)"," für Ubuntu \u002F Debian",[38,384,385,388],{},[18,386,387],{},"AppImage"," für andere Distros",[38,390,391,392,395],{},"Nach Veröffentlichung einer Release können Arch-Nutzer ",[144,393,394],{},"soundninja-bin"," aus dem AUR installieren",[38,397,398],{},"Getestet unter Ubuntu 20.04",[14,400,401,402,405,406,409],{},"Desktop-Builds brauchen WebKit- und GTK-Pakete. Unter Debian\u002FUbuntu meist ",[144,403,404],{},"libwebkit2gtk",", ",[144,407,408],{},"libgtk-3-0"," und eine App-Indicator-Bibliothek.",[23,411,413],{"id":412},"updates","Updates",[14,415,416,417,420],{},"In der App: ",[18,418,419],{},"Hilfe → Nach Updates suchen",". Optional prüft SoundNinja beim Start in den Einstellungen.",[23,422,424],{"id":423},"aus-dem-quellcode-bauen","Aus dem Quellcode bauen",[14,426,427,428,405,433,438],{},"Eigenen Build? ",[239,429,432],{"href":430,"rel":431},"https:\u002F\u002Fgithub.com\u002Fmarcus-universe\u002FSoundNinja",[261],"Repo klonen",[239,434,437],{"href":435,"rel":436},"https:\u002F\u002Fv2.tauri.app\u002Fstart\u002Fprerequisites\u002F",[261],"Tauri-Voraussetzungen"," installieren, dann:",[440,441,445],"pre",{"className":442,"code":443,"language":444,"meta":153,"style":153},"language-bash shiki shiki-themes github-light github-dark","bun install\nbun run tauri:serve\n","bash",[144,446,447,459],{"__ignoreMap":153},[448,449,451,455],"span",{"class":450,"line":296},"line",[448,452,454],{"class":453},"sScJk","bun",[448,456,458],{"class":457},"sZZnC"," install\n",[448,460,461,463,466],{"class":450,"line":154},[448,462,454],{"class":453},[448,464,465],{"class":457}," run",[448,467,468],{"class":457}," tauri:serve\n",[14,470,471,405,474,76,477,480,481,484],{},[144,472,473],{},"npm",[144,475,476],{},"pnpm",[144,478,479],{},"deno"," gehen auch. Produktionsbuild: ",[144,482,483],{},"bun run tauri:build",".",[14,486,487,490,491,496,497,500,501,484],{},