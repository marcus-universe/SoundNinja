{
  "productName": "soundninja",
  "version": "0.6.0",
  "identifier": "com.soundninja.dev",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run generate",
    "devUrl": "http://127.0.0.1:3000",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "fullscreen": false,
        "height": 600,
        "resizable": true,
        "title": "Sound Ninja",
        "width": 800,
        "minHeight": 600,
        "minWidth": 650,
        "decorations": false,
        "dragDropEnabled": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,MsEdgeSidebar,EdgeCollections,TranslateUI,StorageServiceOutOfProcess --enable-features=NetworkServiceInProcess,NetworkServiceInProcess2 --process-per-site --renderer-process-limit=1 --enable-gpu-rasterization --enable-zero-copy --ignore-gpu-blocklist --disable-background-timer-throttling --disable-renderer-backgrounding"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: asset: http://asset.localhost https://asset.localhost; media-src 'self' asset: http://asset.localhost https://asset.localhost; connect-src 'self' ipc: http://ipc.localhost https: ws: wss:",
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": ["$APPCACHE/gif-cache/**"]
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "targets": [
      "nsis",
      "deb",
      "appimage",
      "dmg"
    ],
    "category": "DeveloperTool",
    "copyright": "",
    "externalBin": [],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "longDescription": "",
    "macOS": {
      "entitlements": null,
      "exceptionDomain": "",
      "frameworks": [],
      "providerShortName": null,
      "signingIdentity": null
    },
    "resources": [],
    "shortDescription": "",
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "nsis": {
        "template": "installer/installer.nsi"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgyMkUyMzI1MUQ5NkMwRgpSV1FQYk5sUk11SWlDT1ZNUStRMks0Nkx2Sk04OXo1VUswUmsxV0FCSC9DVXdxUG5MaTFPL0lzMAo=",
      "endpoints": [
        "https://github.com/marcus-universe/SoundNinja/releases/latest/download/latest.json"
      ]
    }
  }
}
